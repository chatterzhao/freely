def _handoff_extract_local(args):
    """handoff.extract is pure local parsing — no daemon call needed."""
    from handoff_parser import extract_handoff_json
    reply_text = args.get("reply_text", "")
    if not reply_text:
        reply_text = sys.stdin.read()
    result = extract_handoff_json(reply_text)
    if result["ok"]:
        print(json.dumps({"action": result["exit_kind"], "fields": result["fields"]}))
    else:
        print(json.dumps({"action": "repair", "errors": result["errors"]}))
        sys.exit(1)


