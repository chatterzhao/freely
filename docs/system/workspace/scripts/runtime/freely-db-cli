#!/usr/bin/env python3
"""freely-db-cli — Thin socket client for freely_db_manager daemon.

Replaces direct calls to chat-inbox.py, session-store.py, and inline sqlite3.
Sends JSON-RPC over Unix socket, formats responses for bash consumption.

Usage:
  freely-db-cli --project <path> <table>.<action> [--flag value ...]

Examples:
  freely-db-cli --project /path chat add --type new-issue --message "hello"
  freely-db-cli --project /path session get-active --role manager
  freely-db-cli --project /path db ping
"""

import argparse
import hashlib
import json
import os
import socket
import sys


def _short_hash(project: str) -> str:
    return hashlib.sha256(os.path.abspath(project).encode()).hexdigest()[:16]


def _socket_path(project: str) -> str:
    return f"/tmp/freely-db-{_short_hash(project)}.sock"


# ── Socket transport ──────────────────────────────────────────────────────

def _call(project: str, method: str, params: dict, timeout: float = 30.0) -> dict:
    socket_path = _socket_path(project)
    if not os.path.exists(socket_path):
        print(f"ERROR: freely-db daemon not running (socket {socket_path} not found)", file=sys.stderr)
        sys.exit(1)

    request = {"jsonrpc": "2.0", "id": 1, "method": method, "params": params}
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    try:
        sock.connect(socket_path)
        sock.sendall((json.dumps(request, default=str) + "\n").encode())
        sock.shutdown(socket.SHUT_WR)
        data = b""
        while True:
            chunk = sock.recv(4096)
            if not chunk:
                break
            data += chunk
    finally:
        sock.close()

    response = json.loads(data.decode())
    if "error" in response:
        err = response["error"]
        print(f"ERROR: {err.get('message', str(err))}", file=sys.stderr)
        sys.exit(1)
    return response.get("result", {})


# ── Output formatters ─────────────────────────────────────────────────────

def _out_raw(val):        print(val)
def _out_ok(val):         print("OK" if val else "NOT_FOUND")
def _out_changed(d):      print("OK" if d.get("changed") else "NOT_FOUND")
def _out_bool(d, key):    print("true" if d.get(key) else "false")
def _out_count(d):        print(d.get("count", 0))
def _out_json(d):         print(json.dumps(d))
def _out_json_rows(d):    print(json.dumps(d.get("rows", [])))
def _out_dict(d, key):    print(d.get(key, "") or "")
def _out_record_json(d):  print(json.dumps(d.get("record") or {}))
def _out_rows_tab(d, *cols):
    for r in d.get("rows", []):
        print("\t".join(str(r.get(c, "")) for c in cols))
def _out_rows_tab_msg(d):
    for r in d.get("rows", []):
        print(f"{r.get('id','')}\t{r.get('chat_type','')}\t{r.get('issue_id','')}\t{r.get('message','')[:80]}")
def _out_rows_tab_sessions(d):
    for r in d.get("rows", []):
        print(f"{r.get('session_id','')}\t{r.get('role','')}\t{r.get('launch_kind','')}\t{r.get('status','')}\t{r.get('updated_at','')}")


def _chat_show_output(result):
    if result.get("found"):
        for k, v in result["chat"].items():
            print(f"{k}: {v}")
    else:
        print("NOT_FOUND")
        sys.exit(1)


def _session_get_active_output(result):
    sid = result.get("session_id")
    if sid:
        print(sid)
    else:
        print("")
        sys.exit(1)


def _session_get_parent_output(result):
    pid = result.get("parent_session_id")
    if pid:
        print(pid)
    else:
        print("")
        sys.exit(1)


def _session_show_output(result):
    if result.get("found"):
        for k, v in result["session"].items():
            print(f"{k}: {v}")
    else:
        print("NOT_FOUND")
        sys.exit(1)


def _tool_switch_read_output(result):
    if result.get("found") and result.get("record"):
        rec = result["record"]
        print("|".join(str(rec.get(k, '')) for k in [
            'trigger_error', 'old_tool', 'old_session_id', 'old_jsonl_path',
            'old_cycle_log', 'new_tool', 'new_session_id', 'cross_tool'
        ]))


def _handoff_parse_output(result):
    if not result.get("ok"):
        print(json.dumps({"action": "repair", "errors": result.get("errors", [])}))
        sys.exit(1)
    print(json.dumps({"action": result.get("exit_kind", ""),
                      "handoff_id": result.get("handoff_id", "")}))


def _task_mode_read_scan_output(result):
    print(f'{result.get("mode", "wait")}|{result.get("task_scan_id", "")}')


