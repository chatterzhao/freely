# ── CLI ───────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(description="freely-db-cli: thin socket client for freely_db_manager")
    parser.add_argument("--project", required=True, help="Project root path")
    parser.add_argument("--timeout", type=float, default=30.0, help="Socket timeout seconds")

    known, unknown = parser.parse_known_args()
    if not unknown:
        parser.print_help()
        sys.exit(1)

    method = unknown[0]
    args = {}
    i = 1
    while i < len(unknown):
        if unknown[i].startswith("--"):
            key = unknown[i][2:].replace("-", "_")
            if i + 1 < len(unknown) and not unknown[i + 1].startswith("--"):
                args[key] = unknown[i + 1]
                i += 2
            else:
                args[key] = "true"
                i += 1
        else:
            i += 1

    # handoff.extract is handled locally (no daemon needed)
    if method == "handoff.extract":
        _handoff_extract_local(args)
        return

    entry = METHODS.get(method)
    if entry is None:
        print(f"ERROR: unknown method '{method}'", file=sys.stderr)
        sys.exit(1)

    rpc_method, formatter, param_builder = entry
    params = param_builder(args)
    result = _call(known.project, rpc_method, params, known.timeout)
    formatter(result)


if __name__ == "__main__":
    main()
