#!/usr/bin/env bash
set -euo pipefail

SELF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"

usage() {
  cat <<'EOF'
Usage:
  signal-intent-handler --project <abs_path> --intake-id <id>
EOF
}

abs_path_or_fail() {
  local p="$1"
  [[ "$p" == /* ]] || {
    echo "[ERROR] path must be absolute: $p" >&2
    exit 1
  }
  printf '%s\n' "$p"
}

project=""
intake_id=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
    --intake-id) intake_id="${2:-}"; shift 2 ;;
    *) usage; exit 1 ;;
  esac
done

[[ -n "$project" && -n "$intake_id" ]] || {
  usage
  exit 1
}

meta_file="$project/.freely/intake/$intake_id/meta.env"
message_file="$project/.freely/intake/$intake_id/message.txt"
[[ -f "$meta_file" && -f "$message_file" ]] || exit 1
message="$(cat "$message_file")"

config_file="$project/.freely/config.env"
[[ -f "$config_file" ]] || exit 1
# shellcheck disable=SC1090
source "$config_file"

model="${AI_MODEL:-gpt-5.4}"
reasoning_effort="${AI_REASONING_EFFORT:-medium}"
prompt_file="$(mktemp /tmp/freely-signal-intent-prompt.XXXXXX)"
trap 'rm -f "$prompt_file"' EXIT

cat >"$prompt_file" <<EOF
你现在承担 Freely 的 signal intent understanding。

目标：
- 不做最终 routing，不直接决定具体 worker。
- 先把这条 signal 的最小意图结构收敛出来，帮助主管继续判断。
- 不要发明大量场景类型；只输出最少字段。

只输出以下 KEY=VALUE 行，不要输出任何额外文本：
INTENT_KIND=<clarify|audit|propose|fix|continue|recover>
NEEDS_LIVE_INSPECTION=<true|false>
NEEDS_EXECUTION=<true|false>
SCOPE=<manager-only|current-issue|fleet|runtime|project>
COMPLEXITY=<direct|multi-step>
CURRENT_CONTEXT=<单行中文摘要，最多 60 字>

signal:
$message
EOF

codex exec --skip-git-repo-check -C "$project" -m "$model" -c "model_reasoning_effort=\"$reasoning_effort\"" --dangerously-bypass-approvals-and-sandbox - <"$prompt_file" \
  | awk '/^(INTENT_KIND|NEEDS_LIVE_INSPECTION|NEEDS_EXECUTION|SCOPE|COMPLEXITY|CURRENT_CONTEXT)=/' \
  | head -n 6
