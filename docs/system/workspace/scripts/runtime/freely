path_relative_to_project_for_trace() {
  local project="$1" value="$2"
  local canonical_project="$project" canonical_value="$value"
  [[ -n "$value" && "$value" == /* ]] || {
    printf '%s\n' "$value"
    return 0
  }
  canonical_project="$(cd "$project" 2>/dev/null && pwd -P || printf '%s\n' "$project")"
  case "$value" in
    "$project")
      printf '.\n'
      return 0
      ;;
    "$project"/*)
      printf '.%s\n' "${value#"$project"}"
      return 0
      ;;
  esac
  if [[ -e "$value" ]]; then
    canonical_value="$(cd "$(dirname "$value")" 2>/dev/null && pwd -P)/$(basename "$value")"
  fi
  case "$canonical_value" in
    "$canonical_project")
      printf '.\n'
      ;;
    "$canonical_project"/*)
      printf '.%s\n' "${canonical_value#"$canonical_project"}"
      ;;
    "$HOME")
      printf '~\n'
      ;;
    "$HOME"/*)
      printf '~%s\n' "${canonical_value#"$HOME"}"
      ;;
    *)
      printf '%s\n' "$canonical_value"
      ;;
  esac
}

compact_trace_identifier() {
  local value="${1:-}"
  local len="${#value}"
  if (( len <= 16 )); then
    printf '%s\n' "$value"
    return 0
  fi
  printf '%s..%s\n' "${value:0:8}" "${value:len-6:6}"
}

sanitize_lifecycle_trace_kv() {
