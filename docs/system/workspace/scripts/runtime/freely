manager_runtime_handle_exit_contract_after_ai_cycle() {
  local project="$1" exit_reason="${2:-}" missing_csv="" kind="" worker_prompts_csv="" stop_reason="" unresolved_workers="" cleanup_followthrough_intake_id="" cleanup_followthrough_output="" cleanup_followthrough_detail=""
  local parse_result parse_ok raw_key cycle_log
  [[ "$(effective_runtime_role_for_project "$project")" == "manager" ]] || {
    printf 'continue\n'
    return 0
  }
  case "$exit_reason" in
    ai_exit_rc_0)
      # ── New path: parse ```json (handoff 内容) JSON from AI reply ──
      cycle_log="${LAST_CYCLE_LOG:-}"
      raw_key="manager-patrol"
      parse_result="$(parse_a2a_task_json_reply "$project" "$cycle_log" "manager" "$raw_key" "" 2>/dev/null || true)"
      parse_ok="${parse_result%%:*}"
      if [[ "$parse_ok" == "ok" ]]; then
        kind="${parse_result#ok:}"
        append_runtime_event "$project" "manager_handoff_json_parsed" "exit_kind=$kind"
      else
        # Fallback: old validation path for backward compat
        if ! missing_csv="$(validate_manager_exit_contract_for_project "$project")"; then
          if ! manager_cycle_has_effective_output_evidence "$project"; then
            write_manager_exit_contract_repair_handoff "$project" "manager_empty_success_cycle" "${missing_csv:-missing_file};effective_output_evidence=absent"
            write_workcell_state "$project" "running" "up" "down" "manager_empty_success_cycle"
            append_runtime_event "$project" "manager_empty_success_cycle_detected" \
              "details=${missing_csv:-missing_file}" \
              "jsonl_path=$(meta_env_value "$(session_state_file "$project")" "LAST_TOOL_JSONL_PATH")" \
              "resume_target=${LAST_TOOL_RESUME_TARGET:-unavailable}"
            printf 'resume_invalid\n'
            return 0
          fi
          if autofill_manager_exit_contract_for_cleanup_delegate_workers_if_possible "$project" "${missing_csv:-missing_file}"; then
            append_runtime_event "$project" "manager_exit_contract_delegate_workers_autofilled" \
              "details=${missing_csv:-missing_file}"
            printf 'delegate_workers\n'
            return 0
          fi
          if autofill_manager_exit_contract_for_continuity_resume_if_possible "$project" "${missing_csv:-missing_file}"; then
            append_runtime_event "$project" "manager_exit_contract_resume_autofilled" \
              "details=${missing_csv:-missing_file}"
          else
            write_manager_exit_contract_repair_handoff "$project" "manager_exit_contract_invalid" "${missing_csv:-missing_file}"
            write_workcell_state "$project" "running" "up" "down" "manager_exit_contract_invalid"
            append_runtime_event "$project" "manager_exit_contract_invalid" \
              "details=${missing_csv:-missing_file}" \
              "resume_target=${LAST_TOOL_RESUME_TARGET:-unavailable}"
            printf 'resume_invalid\n'
            return 0
          fi
        fi
        kind="$(manager_exit_contract_kind "$project" || true)"
      fi
      ;;
    execution_network_transient|execution_network_persistent|proxy_config_invalid)
      manager_exit_contract_kind "$project" >/dev/null 2>&1 || {
        printf 'continue\n'
        return 0
      }
      if ! missing_csv="$(validate_manager_exit_contract_for_project "$project")"; then
        printf 'continue\n'
        return 0
      fi
      append_runtime_event "$project" "manager_exit_contract_consumed_after_runtime_failure" \
        "failure_reason=$exit_reason"
      ;;
    *)
      printf 'continue\n'
      return 0
      ;;
  esac
  [[ -n "$kind" ]] || kind="$(manager_exit_contract_kind "$project" || true)"
  stop_reason="$(_db_exit_contract_field "$project" manager reason)"

  # ── Universal auto→listen gate: in auto mode, if the scan has no ready
  # items, switch to listen regardless of the exit kind. This prevents
  # restart loops when the AI exits with non-stop_ai reasons
  # (e.g. tool_unproductive) and there is no work to do.
  # stop_ai below still has its own retry/override logic.
  local _gate_mode
  _gate_mode="$(read_task_mode "$project")"
  if [[ "$_gate_mode" == "auto" ]]; then
    local _scan_json_path _ready_count
    _scan_json_path="$(task_source_scan_json_path_for_project "$project")"
    _ready_count=0
    if [[ -f "$_scan_json_path" && -s "$_scan_json_path" ]]; then
      _ready_count="$(python3 -c "
import json
with open('$_scan_json_path') as f: data=json.load(f)
items=data if isinstance(data,list) else data.get('items',[])
ready=sum(1 for i in items if i.get('ready'))
print(ready)
" 2>/dev/null || echo 0)"
    fi
    if [[ "$_ready_count" -eq 0 ]]; then
      write_task_mode "$project" "listen"
      append_runtime_event "$project" "task_mode_auto_to_listen_universal" \
        "gate_mode=auto" \
        "ready_count=$_ready_count" \
        "exit_kind=${kind:-unknown}" \
        "action=switch_to_listen"
      printf 'continue\n'
      return 0
    fi
  fi

  case "$kind" in
    stop_ai)
      if manager_has_unresolved_expected_running_workers "$project"; then
        unresolved_workers="$(manager_unresolved_expected_running_worker_count "$project")"
        write_manager_exit_contract_repair_handoff \
          "$project" \
          "manager_exit_contract_stop_ai_blocked_expected_running_worker" \
          "stop_reason=${stop_reason:-missing};blocking_workers=${unresolved_workers:-0}"
        write_workcell_state "$project" "running" "up" "down" "manager_exit_contract_stop_ai_blocked_expected_running_worker"
        append_runtime_event "$project" "manager_exit_contract_stop_ai_blocked_expected_running_worker" \
          "stop_reason=${stop_reason:-missing}" \
          "blocking_workers=${unresolved_workers:-0}"
        printf 'resume_invalid\n'
        return 0
      fi
      # Task-mode gate: check mode before deciding to stop
      local _gate_mode _poll_interval
      _gate_mode="$(read_task_mode "$project")"
      _poll_interval="${CHECK_INTERVAL:-10}"
      [[ "$_poll_interval" =~ ^[0-9]+$ ]] || _poll_interval=10
      case "$_gate_mode" in
        auto)
          local _override_count _override_file _max_retries _scan_json_path _ready_count _hint_file
          _override_file="$project/.freely/run/auto-stop-ai-override-count"
          _hint_file="$project/.freely/run/auto-retry-hint.txt"
          _max_retries=2
          # Check scan for ready items
          _scan_json_path="$(task_source_scan_json_path_for_project "$project")"
          _ready_count=0
          if [[ -f "$_scan_json_path" && -s "$_scan_json_path" ]]; then
            _ready_count="$(python3 -c "
import json
with open('$_scan_json_path') as f: data=json.load(f)
items=data if isinstance(data,list) else data.get('items',[])
ready=sum(1 for i in items if i.get('ready'))
print(ready)
" 2>/dev/null || echo 0)"
          fi
          if [[ "$_ready_count" -eq 0 ]]; then
            # No ready items — legitimate stop_ai, switch to listen mode
            write_task_mode "$project" "listen"
            append_runtime_event "$project" "task_mode_gate_stop_ai_to_listen" \
              "gate_mode=auto" \
              "ready_count=$_ready_count" \
              "action=switch_to_listen"
            rm -f "$_override_file"
            rm -f "$_hint_file"
            printf 'continue\n'
            return 0
          fi
          # Scan has ready items — unexpected stop_ai, retry with hints
          _override_count=0
          if [[ -f "$_override_file" ]]; then
            _override_count=$(cat "$_override_file" 2>/dev/null || echo 0)
          fi
          _override_count=$((_override_count + 1))
          if [[ $_override_count -gt $_max_retries ]]; then
            write_task_mode "$project" "wait"
            append_runtime_event "$project" "task_mode_gate_auto_degraded_to_wait" \
              "gate_mode=auto" \
              "override_count=$_override_count" \
              "max_retries=$_max_retries" \
              "ready_count=$_ready_count" \
              "action=switch_to_wait"
            rm -f "$_override_file"
            rm -f "$_hint_file"
            log_warn "auto mode: stop_ai returned ${_override_count} times with ${_ready_count} ready scan items; degraded to wait"
            sleep "$_poll_interval"
            printf 'continue\n'
            return 0
          fi
          printf '%d\n' "$_override_count" > "$_override_file"
          # Write enrichment hint
          if [[ "$_override_count" -eq 1 ]]; then
            cat > "$_hint_file" <<HINTEOF
[AUTO-MODE RETRY] Previous cycle returned stop_ai but scan has ${_ready_count} actionable items.

Your job is to delegate workers for these items. How to decide:
- Each item's next_action tells you what to do ([manager]=wt-create, [worker]=delegate)
- Worktree isolation means items on different branches/worktrees CAN run in parallel
- Assess dependencies: items touching the same files/branches should be sequential
- Delegate a reasonable batch (3-5 workers if independent, fewer if dependent)
- After delegating, exit with manager_working (not stop_ai) while workers run
- Only stop_ai when zero ready items remain AND no workers are running
HINTEOF
          else
            cat > "$_hint_file" <<HINTEOF
[AUTO-MODE RETRY #2 - FINAL WARNING] Second stop_ai with ${_ready_count} ready items.

You have work to do. Pick at least ONE ready item right now:
- If next_action starts with [manager]: run wt-create, then delegate the worker
- If next_action starts with [worker]: create the worker prompt and delegate it
- Do NOT try to process everything at once. Start with ONE. Then exit with manager_working.
- scan items are isolated by worktree — you can run multiple workers concurrently on different branches.

Returning stop_ai again degrades to wait mode (human intervention required).
HINTEOF
          fi
          append_runtime_event "$project" "task_mode_gate_override_stop_ai" \
            "gate_mode=$_gate_mode" \
            "override_count=$_override_count" \
            "max_retries=$_max_retries" \
            "ready_count=$_ready_count" \
            "stop_reason=${stop_reason:-missing}" \
            "action=continue_instead_of_stop"
          sleep "$_poll_interval"
          printf 'continue\n'
          return 0
          ;;
        wait)
          append_runtime_event "$project" "task_mode_gate_wait_poll" \
            "gate_mode=$_gate_mode" \
            "poll_interval=$_poll_interval"
          sleep "$_poll_interval"
          printf 'continue\n'
          return 0
          ;;
        id:*)
          local _scan_id="${_gate_mode#id:}"
          write_task_mode "$project" "wait"
          append_runtime_event "$project" "task_mode_gate_id_completed" \
            "scan_id=$_scan_id" \
            "next_mode=wait"
          ;;
      esac
      : >"$(stop_marker_file "$project")"
      append_runtime_event "$project" "manager_exit_contract_stop_ai" \
        "stop_reason=${stop_reason}"
      printf 'stop_ai\n'
      ;;
    resume_manager)
      cleanup_followthrough_intake_id="$(manager_exit_contract_cleanup_followthrough_intake_id "$project" || true)"
      if [[ -n "$cleanup_followthrough_intake_id" ]]; then
        append_runtime_event "$project" "manager_exit_contract_cleanup_followthrough_begin" \
          "intake_id=$cleanup_followthrough_intake_id"
        if ! cleanup_followthrough_output="$({ run_cleanup_followthrough "$project" "$cleanup_followthrough_intake_id" "control" "followup" "" ""; } 2>&1)"; then
          cleanup_followthrough_detail="$(printf '%s\n' "$cleanup_followthrough_output" | tr '\n' ';' | sed 's/;*$//' | sed 's/[[:space:]]\+/ /g')"
          write_manager_exit_contract_repair_handoff \
            "$project" \
            "manager_exit_contract_cleanup_followthrough_failed" \
            "intake_id=$cleanup_followthrough_intake_id;details=${cleanup_followthrough_detail:-unknown}"
          write_workcell_state "$project" "running" "up" "down" "manager_exit_contract_cleanup_followthrough_failed"
          append_runtime_event "$project" "manager_exit_contract_cleanup_followthrough_failed" \
            "intake_id=$cleanup_followthrough_intake_id" \
            "details=${cleanup_followthrough_detail:-unknown}"
          printf 'resume_invalid\n'
          return 0
        fi
        append_runtime_event "$project" "manager_exit_contract_cleanup_followthrough" \
          "intake_id=$cleanup_followthrough_intake_id" \
          "details=$(printf '%s\n' "$cleanup_followthrough_output" | tr '\n' ';' | sed 's/;*$//' | sed 's/[[:space:]]\+/ /g' | sed 's/^$/none/')"
        clear_manager_worker_launch_state_for_fresh_restart "$project"
      fi
      write_manager_resume_handoff \
        "$project" \
        "manager_exit_contract_resume" \
        "restart_point=$(_db_exit_contract_field "$project" manager restart_point);next_action=$(_db_exit_contract_field "$project" manager next_action)"
      append_runtime_event "$project" "manager_exit_contract_resume" \
        "restart_point=$(_db_exit_contract_field "$project" manager restart_point)"
      printf 'resume_manager\n'
      ;;
    delegate_workers)
      worker_prompts_csv="$(_db_exit_contract_field "$project" manager worker_prompts_csv)"

      append_runtime_event "$project" "manager_exit_contract_delegate_workers" \
        "worker_prompts_csv=${worker_prompts_csv:-none}"
      printf 'delegate_workers\n'
      ;;
    *)
      write_manager_exit_contract_repair_handoff "$project" "manager_exit_contract_invalid" "invalid_exit_kind"
      write_workcell_state "$project" "running" "up" "down" "manager_exit_contract_invalid"
      printf 'resume_invalid\n'
      ;;
  esac
}

worker_runtime_handle_exit_contract_after_ai_cycle() {
  local project="$1" exit_reason="${2:-}" missing_csv="" kind="" contract_file=""
  [[ "$(effective_runtime_role_for_project "$project")" == "worker" ]] || {
    printf 'continue\n'
    return 0
  }
  contract_file="$(worker_exit_contract_file "$project")"
  case "$exit_reason" in
    ai_exit_rc_0)
      # ── New path: parse ```json (handoff 内容) JSON from worker AI reply ──
      local _w_cycle_log _w_raw_key _w_parse_result _w_parse_ok
      _w_cycle_log="${LAST_CYCLE_LOG:-}"
      _w_raw_key="$(_db_exit_contract_field "$project" worker raw_key 2>/dev/null || echo "")"
      _w_parse_result="$(parse_a2a_task_json_reply "$project" "$_w_cycle_log" "worker" "$_w_raw_key" "" 2>/dev/null || true)"
      _w_parse_ok="${_w_parse_result%%:*}"
      if [[ "$_w_parse_ok" == "ok" ]]; then
        kind="${_w_parse_result#ok:}"
        append_runtime_event "$project" "worker_handoff_json_parsed" "exit_kind=$kind"
      else
        # Fallback: old validation
        if ! missing_csv="$(validate_worker_exit_contract_for_project "$project")"; then
          write_worker_exit_contract_repair_handoff "$project" "worker_exit_contract_invalid" "${missing_csv:-missing_file}"
          write_workcell_state "$project" "running" "up" "down" "worker_exit_contract_invalid"
          append_runtime_event "$project" "worker_exit_contract_invalid" \
            "details=${missing_csv:-missing_file}" \
            "resume_target=${LAST_TOOL_RESUME_TARGET:-unavailable}"
          printf 'resume_invalid\n'
          return 0
        fi
        kind="$(worker_exit_contract_kind "$project" || true)"
      fi
      ;;
    execution_network_transient|execution_network_persistent|proxy_config_invalid)
      [[ -f "$contract_file" ]] || {
        printf 'continue\n'
        return 0
      }
      if ! missing_csv="$(validate_worker_exit_contract_for_project "$project")"; then
        printf 'continue\n'
        return 0
      fi
      append_runtime_event "$project" "worker_exit_contract_consumed_after_runtime_failure" \
        "failure_reason=$exit_reason"
      ;;
    *)
      printf 'continue\n'
      return 0
      ;;
  esac
  kind="$(worker_exit_contract_kind "$project" || true)"
  case "$kind" in
    worker_done)
      if worker_exit_contract_done_is_repair_only_cleanup_escape "$project"; then
        write_worker_exit_contract_repair_handoff "$project" "worker_exit_contract_repair_done_without_bounded_cleanup" "repair_only_worker_done"
        write_workcell_state "$project" "running" "up" "down" "worker_exit_contract_invalid"
        append_runtime_event "$project" "worker_exit_contract_invalid" \
          "details=repair_only_worker_done" \
          "summary=$(_db_exit_contract_field "$project" worker completion_summary)"
        printf 'resume_invalid\n'
        return 0
      fi
      : >"$(stop_marker_file "$project")"
      write_workcell_state "$project" "stopped" "down" "down" "worker_exit_contract_done"
      append_runtime_event "$project" "worker_exit_contract_done" \
        "summary=$(_db_exit_contract_field "$project" worker completion_summary)"
      printf 'stop_ai\n'
      ;;
    worker_blocked)
      : >"$(stop_marker_file "$project")"
      write_workcell_state "$project" "stopped" "down" "down" "worker_exit_contract_blocked"
      append_runtime_event "$project" "worker_exit_contract_blocked" \
        "blocked_reason=$(_db_exit_contract_field "$project" worker reason)"
      printf 'stop_ai\n'
      ;;
    worker_handoff_needed)
      : >"$(stop_marker_file "$project")"
      write_workcell_state "$project" "stopped" "down" "down" "worker_exit_contract_handoff_needed"
      append_runtime_event "$project" "worker_exit_contract_handoff_needed" \
        "handoff_reason=$(_db_exit_contract_field "$project" worker reason)"
      printf 'stop_ai\n'
      ;;
    *)
      write_worker_exit_contract_repair_handoff "$project" "worker_exit_contract_invalid" "invalid_exit_kind"
      write_workcell_state "$project" "running" "up" "down" "worker_exit_contract_invalid"
      printf 'resume_invalid\n'
      ;;
  esac
}

project_runtime_handle_exit_contract_after_ai_cycle() {
  local project="$1" exit_reason="${2:-}"
  case "$(effective_runtime_role_for_project "$project")" in
    manager) manager_runtime_handle_exit_contract_after_ai_cycle "$project" "$exit_reason" ;;
    worker) worker_runtime_handle_exit_contract_after_ai_cycle "$project" "$exit_reason" ;;
    *) printf 'continue\n' ;;
  esac
}

