runtime_tool_auth_dir() {
  printf '%s\n' "$HOME/.ai-auth"
}

runtime_tool_active_slot_file() {
  local tool="$1"
  printf '%s\n' "$(runtime_tool_auth_dir)/.${tool}-current-slot"
}

runtime_codex_legacy_active_slot_file() {
  printf '%s\n' "$HOME/.codex/active-slot"
}

runtime_read_tool_current_slot() {
  local project="$1" tool="$2" file
  file="$(runtime_tool_active_slot_file "$tool")"
  if [[ -f "$file" ]]; then
    tr -d '\n' <"$file"
    return 0
  fi
  if [[ "$tool" == "codex" ]]; then
    file="$(runtime_codex_legacy_active_slot_file)"
    [[ -f "$file" ]] || return 0
    tr -d '\n' <"$file"
  fi
}

runtime_write_tool_current_slot() {
  local tool="$1" slot="$2" file
  file="$(runtime_tool_active_slot_file "$tool")"
  mkdir -p "$(dirname "$file")"
  printf '%s\n' "$slot" >"$file"
  if [[ "$tool" == "codex" ]]; then
    mkdir -p "$(dirname "$(runtime_codex_legacy_active_slot_file)")"
    printf '%s\n' "$slot" >"$(runtime_codex_legacy_active_slot_file)"
  fi
}

runtime_tool_slot_dir() {
  local tool="$1" slot="$2"
  printf '%s\n' "$(runtime_tool_auth_dir)/${tool}-${slot}"
}

runtime_list_tool_slots() {
  local tool="$1" auth_dir prefix
  auth_dir="$(runtime_tool_auth_dir)"
  prefix="${tool}-"
  [[ -d "$auth_dir" ]] || return 0
  ls -1 "$auth_dir" 2>/dev/null | grep "^${prefix}" | sed "s/^${prefix}//" || true
}

runtime_default_singleton_slot_for_tool() {
  printf 'default-1\n'
}

runtime_ensure_tool_singleton_slot_dir() {
  local tool="$1" slot dir
  slot="$(runtime_default_singleton_slot_for_tool)"
  dir="$(runtime_tool_slot_dir "$tool" "$slot")"
  mkdir -p "$dir"
  printf '%s\n' "$slot"
}

runtime_first_tool_slot_or_singleton() {
  local tool="$1" first_slot
  first_slot="$(runtime_list_tool_slots "$tool" | head -n 1)"
  if [[ -n "$first_slot" ]]; then
    printf '%s\n' "$first_slot"
    return 0
  fi
  runtime_ensure_tool_singleton_slot_dir "$tool"
}

runtime_current_or_first_tool_slot() {
  local project="$1" tool="$2" current_slot candidate
  current_slot="$(runtime_read_tool_current_slot "$project" "$tool")"
  if [[ -n "$current_slot" ]]; then
    while IFS= read -r candidate; do
      [[ "$candidate" == "$current_slot" ]] && { printf '%s\n' "$candidate"; return 0; }
    done < <(runtime_list_tool_slots "$tool")
  fi
  runtime_first_tool_slot_or_singleton "$tool"
}

runtime_next_tool_slot_after_current() {
  local project="$1" tool="$2" current_slot seen_current=0 candidate first_slot=""
  current_slot="$(runtime_read_tool_current_slot "$project" "$tool")"
  [[ -n "$current_slot" ]] || return 1
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    [[ -n "$first_slot" ]] || first_slot="$candidate"
    if [[ "$seen_current" == "1" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
    [[ "$candidate" == "$current_slot" ]] && seen_current=1
  done < <(runtime_list_tool_slots "$tool")
  return 1
}

tool_supports_auto_same_tool_slot_recovery() {
  local tool="$1"
  case "$tool" in
    codex|kiro-cli|iflow|cc|cc-use-codex-cli|opencode) return 0 ;;
    *) return 1 ;;
  esac
}

tool_command_name_for_auto_recovery() {
