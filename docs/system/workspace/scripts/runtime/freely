}

manager_operator_stop_boundary_epoch_for_project() {
  local project="$1" boundary_file
  boundary_file="$(manager_operator_stop_boundary_file "$project")"
  [[ -f "$boundary_file" ]] || return 0
  # shellcheck disable=SC1090
  source "$boundary_file"
  if [[ "${OPERATOR_STOP_BOUNDARY_EPOCH:-}" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "${OPERATOR_STOP_BOUNDARY_EPOCH:-}"
  fi
}

clear_manager_worker_launch_state_for_fresh_restart() {
  local project="$1"
  rm -f "$(manager_worker_launch_state_file "$project")"
}

csv_contains_exact_item() {
  local csv="$1" needle="$2"
  [[ -n "$csv" && -n "$needle" ]] || return 1
  local item
  IFS=',' read -r -a __csv_items <<<"$csv"
  for item in "${__csv_items[@]}"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

csv_append_unique_item() {
  local csv="$1" needle="$2"
  if csv_contains_exact_item "$csv" "$needle"; then
    printf '%s\n' "$csv"
  elif [[ -n "$csv" ]]; then
    printf '%s,%s\n' "$csv" "$needle"
  else
    printf '%s\n' "$needle"
  fi
}

csv_remove_exact_item() {
  local csv="$1" needle="$2" item result=""
  [[ -n "$csv" && -n "$needle" ]] || {
    printf '%s\n' "$csv"
    return 0
  }
  IFS=',' read -r -a __csv_remove_items <<<"$csv"
  for item in "${__csv_remove_items[@]}"; do
    [[ -n "$item" && "$item" == "$needle" ]] && continue
    if [[ -n "$item" ]]; then
      result="$(csv_append_unique_item "$result" "$item")"
    fi
  done
  printf '%s\n' "$result"
}

csv_retain_exact_items() {
  local csv="$1" allowed_csv="$2" item result=""
  [[ -n "$csv" && -n "$allowed_csv" ]] || {
    printf '\n'
    return 0
  }
  IFS=',' read -r -a __csv_retain_items <<<"$csv"
  for item in "${__csv_retain_items[@]}"; do
    [[ -n "$item" ]] || continue
    csv_contains_exact_item "$allowed_csv" "$item" || continue
    result="$(csv_append_unique_item "$result" "$item")"
  done
  printf '%s\n' "$result"
}

manager_worker_launch_state_reconcile_same_continuity_prompts() {
  local project="$1" continuity_file="$2"
  local state_file prompt_generated_csv launched_csv normalized_launched_csv queued_csv max_parallel_workers active_running_workers available_new_slots queued_prompt_blockers
  state_file="$(manager_worker_launch_state_file "$project")"
  [[ -f "$state_file" && -n "$continuity_file" && -f "$continuity_file" ]] || return 1
  # shellcheck disable=SC1090
  source "$state_file"
  [[ -n "${LAST_MANAGER_CONTINUITY_CONSUMED:-}" && "${LAST_MANAGER_CONTINUITY_CONSUMED:-}" == "$continuity_file" ]] || return 1

  prompt_generated_csv="$(latest_manager_worker_prompt_csv_from_continuity "$continuity_file")"
  launched_csv="${LAST_MANAGER_WORKER_PROMPTS_CONSUMED:-${LAUNCHED_WORKER_PROMPTS:-}}"
  normalized_launched_csv="$(csv_retain_exact_items "$launched_csv" "$prompt_generated_csv")"

  if [[ "$normalized_launched_csv" != "$launched_csv" || "${LAST_MANAGER_WORKER_PROMPTS_GENERATED:-}" != "$prompt_generated_csv" ]]; then
    queued_csv="${QUEUED_WORKER_PROMPTS:-}"
    queued_prompt_blockers="${QUEUED_WORKER_PROMPT_BLOCKERS:-}"
    max_parallel_workers="${MAX_PARALLEL_WORKERS:-}"
    active_running_workers="${ACTIVE_RUNNING_WORKER_COUNT:-}"
    available_new_slots="${AVAILABLE_NEW_WORKER_SLOTS:-}"
    write_manager_worker_launch_state \
      "$project" \
      "${LAST_MANAGER_CONTINUITY_GENERATED:-$continuity_file}" \
      "$prompt_generated_csv" \
      "${LAST_MANAGER_CONTINUITY_CONSUMED:-$continuity_file}" \
      "$normalized_launched_csv" \
      "$queued_csv" \
      "$max_parallel_workers" \
      "$active_running_workers" \
      "$available_new_slots" \
      "$queued_prompt_blockers"
  fi

  printf '%s\n' "$normalized_launched_csv"
  return 0
}

manager_worker_launch_state_refresh_for_status() {
  local project="$1" continuity_file="" state_file
  local max_parallel_workers active_running_workers available_new_slots
  local generated_continuity generated_prompts consumed_continuity consumed_prompts queued_prompts queued_prompt_blockers
  local latest_generated_continuity latest_generated_prompts_csv
  local latest_launchable_continuity latest_launchable_prompts_csv launch_tracking_continuity launch_tracking_prompts latest_generated_written_by
  local needs_writeback="0"
  state_file="$(manager_worker_launch_state_file "$project")"
  [[ -n "$project" && -f "$state_file" ]] || return 0
  continuity_file="$(latest_patrol_authoritative_manager_continuity_file_for_project "$project")"
  [[ -n "$continuity_file" && -f "$continuity_file" ]] || return 0
  manager_worker_launch_state_reconcile_same_continuity_prompts "$project" "$continuity_file" >/dev/null 2>&1 || true
  manager_worker_launch_state_reconcile_prompt_liveness "$project" "$continuity_file" >/dev/null 2>&1 || true

  # Refresh runtime capacity truth on read so live-status reflects running worker lanes
  # even when the latest continuity did not itself enqueue or consume a prompt.
  # shellcheck disable=SC1090
  source "$state_file"
  generated_continuity="${LAST_MANAGER_CONTINUITY_GENERATED:-$continuity_file}"
  generated_prompts="${LAST_MANAGER_WORKER_PROMPTS_GENERATED:-}"
  consumed_continuity="${LAST_MANAGER_CONTINUITY_CONSUMED:-$continuity_file}"
  consumed_prompts="${LAST_MANAGER_WORKER_PROMPTS_CONSUMED:-${LAUNCHED_WORKER_PROMPTS:-}}"
  queued_prompts="${QUEUED_WORKER_PROMPTS:-}"
  queued_prompt_blockers="${QUEUED_WORKER_PROMPT_BLOCKERS:-}"
  latest_generated_continuity="$continuity_file"
  latest_generated_prompts_csv="$(latest_manager_worker_prompt_csv_from_continuity "$latest_generated_continuity" || true)"
  [[ -n "$latest_generated_prompts_csv" ]] || latest_generated_prompts_csv="none"
  latest_generated_written_by="$(manager_continuity_written_by_from_file "$latest_generated_continuity" || true)"

  launch_tracking_continuity="$latest_generated_continuity"
  launch_tracking_prompts="$latest_generated_prompts_csv"
  latest_launchable_continuity="$(latest_launchable_manager_worker_prompt_continuity_file_for_project "$project" || true)"
  if [[ -n "$latest_launchable_continuity" && -f "$latest_launchable_continuity" ]]; then
    latest_launchable_prompts_csv="$(latest_manager_worker_prompt_csv_from_continuity "$latest_launchable_continuity" || true)"
    [[ -n "$latest_launchable_prompts_csv" ]] || latest_launchable_prompts_csv="none"
    if { [[ "$latest_generated_written_by" == "freely-runtime-startup-stub" ]] || [[ "$latest_generated_written_by" == "freely-runtime-fallback" ]]; } \
      && { [[ "$launch_tracking_prompts" == "none" ]] || [[ "$launch_tracking_continuity" != "$latest_launchable_continuity" ]]; }; then
      launch_tracking_continuity="$latest_launchable_continuity"
      launch_tracking_prompts="$latest_launchable_prompts_csv"
    fi
  fi

  if [[ "$generated_continuity" == "unavailable" || "$generated_continuity" != "$launch_tracking_continuity" ]]; then
    generated_continuity="$launch_tracking_continuity"
    generated_prompts="$launch_tracking_prompts"
    needs_writeback="1"
  fi
  if [[ -n "$consumed_continuity" && "$consumed_continuity" != "unavailable" ]]; then
    if [[ ! -f "$consumed_continuity" ]] || manager_continuity_has_stale_runtime_worktree_refs "$project" "$consumed_continuity"; then
      consumed_continuity="$launch_tracking_continuity"
      consumed_prompts="$(csv_retain_exact_items "${consumed_prompts:-}" "$launch_tracking_prompts" || true)"
      [[ -n "$consumed_prompts" ]] || consumed_prompts="none"
      needs_writeback="1"
    fi
  fi
  if [[ "$latest_generated_prompts_csv" == "none" ]] \
    && [[ "$latest_generated_written_by" != "freely-runtime-startup-stub" ]] \
    && [[ "$latest_generated_written_by" != "freely-runtime-fallback" ]]; then
    consumed_continuity="$latest_generated_continuity"
    consumed_prompts="none"
    queued_prompts=""
    queued_prompt_blockers="none"
    needs_writeback="1"
  fi
  max_parallel_workers="$(manager_max_parallel_workers || true)"
  # Parse max:warn format (e.g., "10:7")
  local _mw_max="${max_parallel_workers%%:*}"
  [[ "$_mw_max" =~ ^[0-9]+$ ]] || _mw_max="10"
  active_running_workers="$(manager_semantic_loop_active_worker_count_for_project "$project" || true)"
  if ! [[ "$active_running_workers" =~ ^[0-9]+$ ]]; then
    active_running_workers="0"
  fi
  if (( active_running_workers >= _mw_max )); then
    available_new_slots="0"
  else
    available_new_slots="$((_mw_max - active_running_workers))"
  fi

  if [[ "$needs_writeback" == "1" \
    || "${LAST_MANAGER_CONTINUITY_GENERATED:-}" != "$generated_continuity" \
    || "${LAST_MANAGER_WORKER_PROMPTS_GENERATED:-}" != "$generated_prompts" \
    || "${LAST_MANAGER_CONTINUITY_CONSUMED:-}" != "$consumed_continuity" \
    || "${LAST_MANAGER_WORKER_PROMPTS_CONSUMED:-${LAUNCHED_WORKER_PROMPTS:-}}" != "$consumed_prompts" \
    || "${MAX_PARALLEL_WORKERS:-}" != "$max_parallel_workers" \
    || "${ACTIVE_RUNNING_WORKER_COUNT:-}" != "$active_running_workers" \
    || "${AVAILABLE_NEW_WORKER_SLOTS:-}" != "$available_new_slots" ]]; then
    write_manager_worker_launch_state \
      "$project" \
      "$generated_continuity" \
      "$generated_prompts" \
      "$consumed_continuity" \
      "$consumed_prompts" \
      "$queued_prompts" \
      "$max_parallel_workers" \
      "$active_running_workers" \
      "$available_new_slots" \
      "$queued_prompt_blockers"
  fi
  return 0
}

csv_conflicts_with_item() {
  local csv="$1" needle="$2" item
  [[ -n "$csv" && -n "$needle" ]] || return 1
  IFS=',' read -r -a __csv_conflict_items <<<"$csv"
  for item in "${__csv_conflict_items[@]}"; do
    [[ -n "$item" && "$item" == "$needle" ]] && return 0
  done
  return 1
}

request_local_continuation_reentry() {
  local project="$1" intake_id="$2"
  local ai_pid waited=0
  ai_pid="$(runtime_ai_pid_hint_for_project "$project")"
  [[ -n "$ai_pid" ]] || return 0
  if ! kill -0 "$ai_pid" 2>/dev/null; then
    return 0
  fi

  kill "$ai_pid" 2>/dev/null || true
  while kill -0 "$ai_pid" 2>/dev/null; do
    if (( waited >= 30 )); then
      kill -9 "$ai_pid" 2>/dev/null || true
      write_preemption_state "$project" "hard_kill_fallback" "local_continuation_reentry" "$intake_id" "$ai_pid"
      log_warn "forced hard-kill fallback for local continuation re-entry: intake=$intake_id pid=$ai_pid"
      return 0
    fi
    sleep 0.1
    waited=$((waited + 1))
  done

  write_preemption_state "$project" "graceful_term" "local_continuation_reentry" "$intake_id" "$ai_pid"
  log_info "triggered graceful local continuation re-entry for intake: $intake_id (ai pid=$ai_pid)"
}

request_local_runtime_handoff_stop() {
  local project="$1" intake_id="$2"
  local current_pid supervisor_pid ai_pid run_dir stop_file
  local state_settled="0"
  current_pid="${BASHPID:-$$}"
  run_dir="$(run_dir_for_project "$project")"
  stop_file="$(stop_marker_file "$project")"
  mkdir -p "$run_dir"
  : >"$stop_file"
  append_runtime_event "$project" "delegated_runtime_handoff_stop_requested" \
    "intake_id=$intake_id" \
    "request_pid=$current_pid"

  supervisor_pid="$(manager_supervisor_pid_for_project "$project")"
  ai_pid="$(runtime_ai_pid_hint_for_project "$project")"
  if [[ -n "$ai_pid" && "$ai_pid" != "$current_pid" ]]; then
    terminate_pid_with_graceful_wait "$ai_pid" "delegated runtime handoff ai stop"
  fi

  if [[ -z "$(manager_supervisor_pid_for_project "$project")" && -z "$(runtime_ai_pid_hint_for_project "$project")" ]]; then
    rm -f "$run_dir/supervisor.pid" "$run_dir/ai.pid" "$(session_state_file "$project")" "$(exit_contract_file "$project")" "$stop_file"
    write_workcell_state "$project" "stopped" "down" "down" "delegated_runtime_handoff"
    state_settled="1"
  fi

  append_runtime_event "$project" "delegated_runtime_handoff_stop_applied" \
    "intake_id=$intake_id" \
    "state_settled=$state_settled" \
    "supervisor_pid=${supervisor_pid:-none}" \
    "ai_pid=${ai_pid:-none}"
  log_info "applied local runtime handoff stop for intake: $intake_id"
}

reconcile_delegated_runtime_handoff_state_if_needed() {
  local project="$1"
  local state_file resolution_file meta_file project_real delegated_real
  local desired_state last_exit_reason run_dir
  local supervisor_pid ai_pid dispatcher_pid watchdog_pid unverified_roles
  state_file="$(workcell_state_file "$project")"
  [[ -f "$state_file" ]] || return 1

  unset DESIRED_RUNTIME_STATE LAST_EXIT_REASON
  # shellcheck disable=SC1090
  source "$state_file"
  desired_state="${DESIRED_RUNTIME_STATE:-unknown}"
  last_exit_reason="${LAST_EXIT_REASON:-unknown}"
  [[ "$desired_state" == "running" ]] || return 1
  [[ "$last_exit_reason" != "delegated_runtime_handoff" ]] || return 1

  supervisor_pid="$(manager_supervisor_pid_for_project "$project")"
  ai_pid="$(runtime_ai_pid_hint_for_project "$project")"
  dispatcher_pid="$(interruption_dispatcher_pid_for_project "$project")"
  watchdog_pid="$(manager_watchdog_pid_for_project "$project")"
  sse_watchdog_pid="$(sse_watchdog_pid_for_project "$project")"
  [[ -z "$supervisor_pid" && -z "$ai_pid" && -z "$dispatcher_pid" && -z "$watchdog_pid" && -z "$sse_watchdog_pid" ]] || return 1
  unverified_roles="$(runtime_unverified_pid_roles_for_project "$project")"
  [[ -z "$unverified_roles" ]] || return 1

  resolution_file="$(latest_interruption_resolution_file_for_project "$project")"
  [[ -n "$resolution_file" && -f "$resolution_file" ]] || return 1
  meta_file="$(dirname "$resolution_file")/meta.env"
  [[ -f "$meta_file" ]] || return 1
  load_meta_env_snapshot "$meta_file"
  [[ "$LOADED_META_STATUS" == "delegated" ]] || return 1
  [[ "$LOADED_META_ABSORPTION_TARGET" == "handoff://runtime" ]] || return 1
  project_real="$(cd "$project" && pwd -P)"
  delegated_real=""
  if [[ -n "${LOADED_META_DELEGATED_WORKTREE:-}" ]]; then
    delegated_real="$(cd "${LOADED_META_DELEGATED_WORKTREE}" 2>/dev/null && pwd -P || true)"
  fi
  [[ -z "$delegated_real" || "$delegated_real" == "$project_real" ]] || return 1

  run_dir="$(run_dir_for_project "$project")"
  rm -f "$run_dir/supervisor.pid" "$run_dir/ai.pid" "$(interruption_dispatcher_pid_file "$project")" "$(ensure_manager_watchdog_pid_file "$project")" "$(session_state_file "$project")" "$(exit_contract_file "$project")" "$(stop_marker_file "$project")"
  write_workcell_state "$project" "stopped" "down" "down" "delegated_runtime_handoff"
  append_runtime_event "$project" "delegated_runtime_handoff_state_reconciled" \
    "resolution_file=$resolution_file" \
    "previous_exit_reason=${last_exit_reason:-unknown}"
  return 0
}

terminate_pid_with_graceful_wait() {
  local pid="$1" label="$2"
  local waited=0
  [[ -n "$pid" ]] || return 0
  kill -0 "$pid" 2>/dev/null || return 0

  kill "$pid" 2>/dev/null || true
  while kill -0 "$pid" 2>/dev/null; do
    if (( waited >= 50 )); then
      kill -9 "$pid" 2>/dev/null || true
      log_warn "forced hard-kill fallback while repairing ${label}: pid=$pid"
      return 0
    fi
    sleep 0.1
    waited=$((waited + 1))
  done
  return 0
}

latest_manager_continuity_file_for_project() {
  local project="$1" continuity_file
  while IFS= read -r continuity_file; do
    [[ -f "$continuity_file" ]] || continue
    if manager_continuity_is_launchable_for_project "$project" "$continuity_file"; then
      printf '%s\n' "$continuity_file"
      return 0
    fi
  done < <(manager_continuity_files_desc_for_project "$project")
  return 0
}

latest_patrol_authoritative_manager_continuity_file_for_project() {
  local project="$1" continuity_file
  while IFS= read -r continuity_file; do
    [[ -f "$continuity_file" ]] || continue
    if manager_continuity_precedes_operator_stop_boundary "$project" "$continuity_file"; then
      # Once the newest continuity predates the latest explicit operator stop,
      # older continuity files are stale history too and must not be reused as
      # current patrol truth.
      return 0
    fi
    manager_continuity_has_stale_runtime_worktree_refs "$project" "$continuity_file" && continue
    manager_continuity_is_launchable_for_project "$project" "$continuity_file" || continue
    printf '%s\n' "$continuity_file"
    return 0
  done < <(manager_continuity_files_desc_for_project "$project")
  return 0
}

latest_cycle_log_for_project() {
  local project="$1" logs_dir
  logs_dir="$(logs_dir_for_project "$project")"
  [[ -d "$logs_dir" ]] || return 0
  find "$logs_dir" -maxdepth 1 -type f -name 'cycle-*.log' | sort | tail -n 1
}

file_mtime_epoch() {
  local path="$1"
  [[ -f "$path" ]] || return 1
  stat -f '%m' "$path" 2>/dev/null || stat -c '%Y' "$path" 2>/dev/null || return 1
}

timestamp_epoch_or_zero() {
  local value="${1:-}" epoch=""
  [[ -n "$value" ]] || {
    printf '0\n'
    return 0
  }
  epoch="$(codex_timestamp_to_epoch "$value" 2>/dev/null || true)"
  printf '%s\n' "${epoch:-0}"
}

max_epoch_value() {
  local best="0" candidate
  for candidate in "$@"; do
    [[ -n "$candidate" && "$candidate" =~ ^[0-9]+$ ]] || continue
    if (( candidate > best )); then
      best="$candidate"
    fi
  done
  printf '%s\n' "$best"
}

recorded_worker_has_resume_evidence() {
  local project="$1"
  local state_file
  state_file="$(session_state_file "$project")"
  [[ -f "$state_file" ]] || return 1
  # shellcheck disable=SC1090
  source "$state_file"
  [[ -n "${LAST_TOOL_JSONL_PATH:-}" && "${LAST_TOOL_JSONL_PATH:-}" != "unavailable" ]] && codex_jsonl_has_verified_resume_evidence "${LAST_TOOL_JSONL_PATH:-}" && return 0
  [[ -n "${LAST_CLAUDE_JSONL_PATH:-}" && "${LAST_CLAUDE_JSONL_PATH:-}" != "unavailable" && -f "${LAST_CLAUDE_JSONL_PATH:-}" ]] && return 0
  [[ -n "${LAST_CODEX_MCP_JSONL_PATH:-}" && "${LAST_CODEX_MCP_JSONL_PATH:-}" != "unavailable" && -f "${LAST_CODEX_MCP_JSONL_PATH:-}" ]] && return 0
  [[ -n "${LAST_TOOL_SESSION_ID:-}" && "${LAST_TOOL_SESSION_ID:-}" != "unavailable" ]] && return 0
  [[ -n "${LAST_TOOL_RESUME_TARGET:-}" && "${LAST_TOOL_RESUME_TARGET:-}" != "unavailable" ]] && return 0
  return 1
}

recorded_worker_latest_runtime_evidence_epoch() {
  local project="$1"
  local prompt_file session_file workcell_file prompt_epoch="0" session_epoch="0" workcell_epoch="0" state_updated_epoch="0"
  local tool_jsonl_epoch="0" claude_jsonl_epoch="0" codex_mcp_jsonl_epoch="0"
  prompt_file="$(latest_prompt_file_for_project "$project")"
  session_file="$(session_state_file "$project")"
  workcell_file="$(workcell_state_file "$project")"
  prompt_epoch="$(file_mtime_epoch "$prompt_file" 2>/dev/null || true)"
  session_epoch="$(file_mtime_epoch "$session_file" 2>/dev/null || true)"
  workcell_epoch="$(file_mtime_epoch "$workcell_file" 2>/dev/null || true)"
  if [[ -f "$workcell_file" ]]; then
    # shellcheck disable=SC1090
    source "$workcell_file"
    state_updated_epoch="$(timestamp_epoch_or_zero "${LAST_STATE_UPDATED_AT:-}")"
  fi
  if [[ -f "$session_file" ]]; then
    # shellcheck disable=SC1090
    source "$session_file"
    [[ -n "${LAST_TOOL_JSONL_PATH:-}" && -f "${LAST_TOOL_JSONL_PATH:-}" ]] && tool_jsonl_epoch="$(file_mtime_epoch "${LAST_TOOL_JSONL_PATH:-}" 2>/dev/null || true)"
    [[ -n "${LAST_CLAUDE_JSONL_PATH:-}" && -f "${LAST_CLAUDE_JSONL_PATH:-}" ]] && claude_jsonl_epoch="$(file_mtime_epoch "${LAST_CLAUDE_JSONL_PATH:-}" 2>/dev/null || true)"
    [[ -n "${LAST_CODEX_MCP_JSONL_PATH:-}" && -f "${LAST_CODEX_MCP_JSONL_PATH:-}" ]] && codex_mcp_jsonl_epoch="$(file_mtime_epoch "${LAST_CODEX_MCP_JSONL_PATH:-}" 2>/dev/null || true)"
  fi
  max_epoch_value "${prompt_epoch:-0}" "${session_epoch:-0}" "${workcell_epoch:-0}" "${state_updated_epoch:-0}" "${tool_jsonl_epoch:-0}" "${claude_jsonl_epoch:-0}" "${codex_mcp_jsonl_epoch:-0}"
}

recorded_worker_ownership_status() {
  local project="$1"
  local latest_evidence_epoch now_epoch hard_threshold
  if recorded_worker_has_resume_evidence "$project"; then
    printf 'soft_stale\n'
    return 0
  fi
  latest_evidence_epoch="$(recorded_worker_latest_runtime_evidence_epoch "$project")"
  [[ "$latest_evidence_epoch" =~ ^[0-9]+$ ]] || latest_evidence_epoch=0
  (( latest_evidence_epoch > 0 )) || {
    printf 'hard_stale\n'
    return 0
  }
  now_epoch="$(date +%s)"
  hard_threshold="${FREELY_OWNERSHIP_HARD_STALE_SECS:-${OWNERSHIP_HARD_STALE_THRESHOLD_SECS:-21600}}"
  [[ "$hard_threshold" =~ ^[0-9]+$ ]] || hard_threshold=21600
  if (( now_epoch - latest_evidence_epoch >= hard_threshold )); then
    printf 'hard_stale\n'
  else
    printf 'soft_stale\n'
  fi
}

all_manager_worker_prompt_paths_from_continuity() {
  local continuity_file="$1"
  [[ -f "$continuity_file" ]] || return 0
  rg -o '/[^` ]+/.freely/run/worker-prompts/[^` ]+\.txt' "$continuity_file" | sort -u
}

fleet_worktree_paths_for_project() {
  local project="$1"
  project_worktree_list_porcelain_cached "$project" | awk '/^worktree / {print substr($0, 10)}'
}

fleet_normalized_worktree_paths_for_project() {
  local project="$1" worktree_path normalized_path result=""
  if [[ "${FREELY_CACHED_NORMALIZED_WORKTREE_PATHS_PROJECT:-}" == "$project" && "${FREELY_CACHED_NORMALIZED_WORKTREE_PATHS_READY:-0}" == "1" ]]; then
    printf '%s\n' "${FREELY_CACHED_NORMALIZED_WORKTREE_PATHS:-}"
    return 0
  fi
  while IFS= read -r worktree_path; do
    [[ -n "$worktree_path" ]] || continue
    normalized_path="$(normalize_runtime_worktree_path "$worktree_path")"
    [[ -n "$normalized_path" ]] || continue
    result+="${normalized_path}"$'\n'
  done < <(fleet_worktree_paths_for_project "$project")
  FREELY_CACHED_NORMALIZED_WORKTREE_PATHS_PROJECT="$project"
  FREELY_CACHED_NORMALIZED_WORKTREE_PATHS_READY="1"
  FREELY_CACHED_NORMALIZED_WORKTREE_PATHS="${result%$'\n'}"
  printf '%s\n' "${FREELY_CACHED_NORMALIZED_WORKTREE_PATHS:-}"
}

project_has_authoritative_worktree_path() {
  local project="$1" target_path="$2"
  local normalized_target normalized_candidate
  [[ -n "$target_path" ]] || return 1
  normalized_target="$(normalize_runtime_worktree_path "$target_path")"
  while IFS= read -r normalized_candidate; do
    [[ -n "$normalized_candidate" ]] || continue
    normalized_candidate="$(normalize_runtime_worktree_path "$normalized_candidate")"
    [[ "$normalized_candidate" == "$normalized_target" ]] && return 0
  done < <(fleet_worktree_paths_for_project "$project")
  return 1
}

global_restart_project_paths() {
  local project="$1"
  {
    fleet_worktree_paths_for_project "$project"
    registered_projects
  } | awk 'NF > 0 && !seen[$0]++ { print $0 }'
}

normalize_runtime_worktree_path() {
  local target_path="$1"
  [[ -n "$target_path" ]] || return 0
  if [[ -d "$target_path" ]]; then
    (
      cd "$target_path" 2>/dev/null && pwd -P
    ) || printf '%s\n' "$target_path"
  else
    printf '%s\n' "$target_path"
  fi
}

fleet_worktree_branch_rows_for_project() {
  local project="$1"
  project_worktree_list_porcelain_cached "$project" | awk '
    BEGIN { wt=""; br="(detached)" }
    /^worktree / { wt=substr($0, 10); br="(detached)" }
    /^branch / { br=$2; sub(/^refs\/heads\//, "", br) }
    /^$/ {
      if (wt != "") {
        print wt "|" br
        wt=""
        br="(detached)"
      }
    }
    END {
      if (wt != "") {
        print wt "|" br
      }
    }
  '
}

manager_continuity_worktree_paths_from_runtime_sections() {
  local continuity_file="$1"
  [[ -f "$continuity_file" ]] || return 0
  awk '
    function extract_backtick_path(line, value, start_idx, remainder, end_idx) {
      start_idx=index(line, "`")
      if (start_idx == 0) {
        return
      }
      remainder=substr(line, start_idx + 1)
      end_idx=index(remainder, "`")
      if (end_idx == 0) {
        return
      }
      value=substr(remainder, 1, end_idx - 1)
      if (value ~ /^\/.*$/) {
        print value
      }
    }
    /^## / {
      section=tolower(substr($0, 4))
      gsub(/[`[:space:]]+$/, "", section)
      gsub(/[[:space:]]+\/[[:space:]]+/, "|", section)
      next
    }
    /^# / {
      section=""
      next
    }
    section == "fleet inventory" && $0 ~ /^[[:space:]]*-[[:space:]]*path:[[:space:]]*`\/.*`[[:space:]]*$/ {
      extract_backtick_path($0)
      next
    }
    (section == "queue" || section == "frozen queue" || section == "cleanup queue" || section == "queue|frozen|cleanup") && $0 ~ /^[[:space:]]*-[[:space:]]*target_worktree:[[:space:]]*`\/.*`[[:space:]]*$/ {
      extract_backtick_path($0)
      next
    }
  ' "$continuity_file" | sort -u
}

project_has_worktree_path() {
  local project="$1" target_path="$2" normalized_target normalized_worktree
  [[ -n "$target_path" ]] || return 1
  normalized_target="$(normalize_runtime_worktree_path "$target_path")"
  fleet_normalized_worktree_paths_for_project "$project" >/dev/null
  while IFS= read -r normalized_worktree; do
    [[ -n "$normalized_worktree" ]] || continue
    if [[ "$normalized_worktree" == "$normalized_target" ]]; then
      return 0
    fi
  done <<<"${FREELY_CACHED_NORMALIZED_WORKTREE_PATHS:-}"
  return 1
}

manager_continuity_has_stale_runtime_worktree_refs() {
  local project="$1" continuity_file="$2" target_path
  [[ -n "$project" && -f "$continuity_file" ]] || return 1
  while IFS= read -r target_path; do
    [[ -n "$target_path" ]] || continue
    project_has_worktree_path "$project" "$target_path" || return 0
  done < <(manager_continuity_worktree_paths_from_runtime_sections "$continuity_file")
  return 1
}

manager_continuity_precedes_operator_stop_boundary() {
  local project="$1" continuity_file="$2"
  local boundary_epoch continuity_epoch
  [[ -n "$project" && -f "$continuity_file" ]] || return 1
  boundary_epoch="$(manager_operator_stop_boundary_epoch_for_project "$project")"
  [[ "$boundary_epoch" =~ ^[0-9]+$ ]] || return 1
  continuity_epoch="$(file_mtime_epoch "$continuity_file" 2>/dev/null || true)"
  [[ "$continuity_epoch" =~ ^[0-9]+$ ]] || return 1
  (( continuity_epoch <= boundary_epoch ))
}

manager_continuity_missing_runtime_worktree_refs() {
  local project="$1" continuity_file="$2" target_path
  [[ -n "$project" && -f "$continuity_file" ]] || return 0
  while IFS= read -r target_path; do
    [[ -n "$target_path" ]] || continue
    project_has_worktree_path "$project" "$target_path" && continue
    printf '%s\n' "$target_path"
  done < <(manager_continuity_worktree_paths_from_runtime_sections "$continuity_file")
}

manager_prompt_fleet_truth_markdown_for_project() {
  local project="$1"
  local latest_generated_continuity latest_launchable_continuity generated_stale generated_pre_stop missing_refs wt_path wt_branch wt_state
  latest_generated_continuity="$(latest_generated_manager_continuity_file_for_project "$project")"
  latest_launchable_continuity="$(latest_patrol_authoritative_manager_continuity_file_for_project "$project")"
  generated_stale="false"
  generated_pre_stop="false"
  missing_refs=""

  if [[ -n "$latest_generated_continuity" && -f "$latest_generated_continuity" ]]; then
    if manager_continuity_precedes_operator_stop_boundary "$project" "$latest_generated_continuity"; then
      generated_stale="true"
      generated_pre_stop="true"
    fi
    if manager_continuity_has_stale_runtime_worktree_refs "$project" "$latest_generated_continuity"; then
      generated_stale="true"
      missing_refs="$(manager_continuity_missing_runtime_worktree_refs "$project" "$latest_generated_continuity")"
    fi
  fi

  cat <<EOF
项目级工位真相：
- authoritative_source: \`git worktree list --porcelain\`
- latest_generated_manager_continuity: \`${latest_generated_continuity:-none}\`
- latest_launchable_manager_continuity: \`${latest_launchable_continuity:-none}\`
- latest_generated_manager_continuity_stale: \`${generated_stale}\`
- latest_generated_manager_continuity_precedes_operator_stop: \`${generated_pre_stop}\`

## Current Worktree Inventory
EOF

  while IFS='|' read -r wt_path wt_branch; do
    [[ -n "$wt_path" ]] || continue
    if [[ -n "$(git_status_porcelain_with_runtime_hygiene "$wt_path")" ]]; then
      wt_state="DIRTY"
    else
      wt_state="CLEAN"
    fi
    cat <<EOF
- path: \`$wt_path\`
  - branch: \`${wt_branch:-unknown}\`
  - clean_state: \`${wt_state}\`
EOF
  done < <(fleet_worktree_branch_rows_for_project "$project")

  if [[ -n "$missing_refs" ]]; then
    cat <<EOF

## Stale Runtime Refs
EOF
    while IFS= read -r wt_path; do
      [[ -n "$wt_path" ]] || continue
      printf -- '- missing_worktree: `%s`\n' "$wt_path"
    done <<<"$missing_refs"
  fi

  cat <<'EOF'

Manager continuity truth guard:
- Treat `Current Worktree Inventory` as the authoritative active fleet for this round.
- If a continuity was generated before the latest explicit operator stop boundary, treat it as stale history for fresh startup patrol, not as the current continuity anchor.
- If any continuity references a path absent from that inventory, treat it as stale history, not as current queue/fleet truth.
- Before writing a new manager continuity, rebuild fleet inventory / queue / cleanup sections from the current worktree inventory rather than copying stale historical paths.
EOF
}

manager_worker_prompt_paths_from_continuity_by_mode() {
