attempt_runtime_proxy_self_heal_after_network_failure() {
  local project="$1" tool="$2" failure_reason="${3:-}"
  local original_mode candidate probe_result attempted_any=0
  case "$failure_reason" in
    execution_network_transient|execution_network_persistent|proxy_config_invalid) ;;
    *) return 1 ;;
  esac
  load_config "$project"
  config_bool_enabled "${AUTO_SETUP_FREELY_PROXY:-true}" || return 1
  case "$tool" in
    codex) ;;
    *) return 1 ;;
  esac

  freely_network_proxy_resolve_config "$project"
  original_mode="$(freely_network_proxy_mode)"
  [[ -n "$original_mode" ]] || original_mode="inherit"

  append_runtime_event "$project" "proxy_self_heal_started" \
    "tool=$tool" \
    "reason=$failure_reason" \
    "original_mode=$original_mode"

  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    attempted_any=1
    upsert_config_key "$project" "FREELY_NETWORK_PROXY_MODE" "$candidate"
    load_config "$project"
    probe_result="$(runtime_capture_or_empty runtime_proxy_self_heal_probe_result "$project" "$tool")"
    append_runtime_event "$project" "proxy_self_heal_probe" \
      "tool=$tool" \
      "reason=$failure_reason" \
      "candidate_mode=$candidate" \
      "probe_result=${probe_result:-empty}"
    if [[ "$probe_result" == "usable" ]]; then
      clear_execution_network_state "$project"
      log_warn "proxy self-heal switched $tool to proxy mode=$candidate after $failure_reason and verified with a hi probe"
      append_runtime_event "$project" "proxy_self_heal_succeeded" \
        "tool=$tool" \
        "reason=$failure_reason" \
        "selected_mode=$candidate"
      return 0
    fi
  done < <(runtime_proxy_self_heal_candidate_modes "$project")

  if [[ "$attempted_any" == "1" ]]; then
    upsert_config_key "$project" "FREELY_NETWORK_PROXY_MODE" "$original_mode"
    load_config "$project"
  fi
  append_runtime_event "$project" "proxy_self_heal_exhausted" \
    "tool=$tool" \
    "reason=$failure_reason" \
    "restored_mode=$original_mode"
  return 1
}

emit_runtime_failure_guidance() {
  local project="$1" tool="$2" slot_switch_reason="${3:-}" network_failure_reason="${4:-}" log_file="${5:-}"
  local effective_reason="${network_failure_reason:-$slot_switch_reason}"

  case "$effective_reason" in
    auth_failure|kiro_monthly_request_limit|kiro_subscription_status_service_error)
      log_warn "diagnose provider access: check login/API key state, balance/quota/subscription, and whether the relay/base_url expects a different credential"
      return 0
      ;;
    proxy_config_invalid)
      log_warn "diagnose proxy config: check the selected proxy mode and ensure the required FREELY_* proxy variables are populated"
      log_warn "$(runtime_proxy_mode_summary_for_logs "$project")"
      log_warn "set FREELY_NETWORK_PROXY_MODE=\"disabled\" to force direct access, keep \"inherit\" to use shell proxy env, or use \"explicit\" with FREELY_NETWORK_PROXY_URL/FREELY_ALL_PROXY/FREELY_HTTP_PROXY/FREELY_HTTPS_PROXY/FREELY_NO_PROXY"
      return 0
      ;;
    execution_network_transient|execution_network_persistent)
      log_warn "diagnose network path: check direct network reachability, relay/base_url health, TLS/certificate trust, and whether the current proxy mode matches this environment"
      log_warn "$(runtime_proxy_mode_summary_for_logs "$project")"
      log_warn "if the transport path looks healthy but reconnects continue, also verify provider quota/subscription because some relays surface billing failures as reconnects"
      return 0
      ;;
  esac

  [[ -f "$log_file" ]] || return 0

  if log_has_proxy_config_invalid "$log_file"; then
    emit_runtime_failure_guidance "$project" "$tool" "proxy_config_invalid" "" "$log_file"
    return 0
  fi
  if log_has_auth_failure "$log_file"; then
    emit_runtime_failure_guidance "$project" "$tool" "auth_failure" "" "$log_file"
    return 0
  fi
  if log_has_execution_network_failure "$log_file"; then
    emit_runtime_failure_guidance "$project" "$tool" "" "execution_network_transient" "$log_file"
    return 0
  fi
  if [[ "$tool" == "kiro-cli" ]] && log_has_kiro_subscription_status_service_error "$log_file"; then
    emit_runtime_failure_guidance "$project" "$tool" "kiro_subscription_status_service_error" "" "$log_file"
    return 0
  fi
  if [[ "$tool" == "kiro-cli" ]] && log_has_kiro_monthly_request_limit "$log_file"; then
    emit_runtime_failure_guidance "$project" "$tool" "kiro_monthly_request_limit" "" "$log_file"
    return 0
  fi
}

