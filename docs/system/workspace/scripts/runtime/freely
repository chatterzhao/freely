cmd_task_mode() {
  local action="" project="" mode="" force="0"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      set) action="set"; shift ;;
      get) action="get"; shift ;;
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
