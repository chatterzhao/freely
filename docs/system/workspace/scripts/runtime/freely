    pre_tests_path="$(worker_prompt_pre_tests_path "$prompt_file")"
    artifact_dir="$(worker_prompt_verification_artifact_dir "$prompt_file")"
  fi
  if [[ -z "$owner_issue" && -f "$contract_file" ]]; then
    owner_issue="$(meta_env_value "$contract_file" "OWNER_ISSUE")"
