freely_execution_boundary_audit_summary_for_loaded_config() {
  local project="$1"
  local consent_required consent_status expected_approval codex_cfg actual_approval
  local warnings=()
  local failures=()

  consent_required="$(freely_activation_consent_required_for_mode "${AI_MODE:-}")"
  consent_status="$(freely_activation_consent_status_for_loaded_config)"
  if [[ "$consent_required" == "true" && "$consent_status" != "accepted" ]]; then
    failures+=("activation_consent_status=${consent_status}")
  fi

  if tool_requires_project_codex_config "${AI_TOOL:-}" "${AI_TOOL_CAPABILITIES:-}"; then
    codex_cfg="$(project_codex_config_file "$project")"
    if [[ ! -f "$codex_cfg" ]]; then
      failures+=("missing_project_codex_config")
    else
      expected_approval="on-request"
      [[ "${AI_MODE:-}" == "auto" ]] && expected_approval="never"
      actual_approval="$(project_codex_config_value "$project" "approval_policy" || true)"
      if [[ "$actual_approval" != "$expected_approval" ]]; then
        failures+=("codex_approval_policy=${actual_approval:-missing} expected=${expected_approval}")
      fi
      if [[ "$(project_codex_config_value "$project" "sandbox_mode" || true)" != "workspace-write" ]]; then
        warnings+=("codex_sandbox_mode_drift")
      fi
      if [[ "$(project_codex_config_value "$project" "network_access" || true)" != "false" ]]; then
        warnings+=("codex_network_access_drift")
      fi
    fi
  fi

  if [[ "${#failures[@]}" -gt 0 ]]; then
    printf 'fail %s\n' "$(IFS='; '; echo "${failures[*]}")"
    return 0
  fi
  if [[ "${#warnings[@]}" -gt 0 ]]; then
    printf 'warn %s\n' "$(IFS='; '; echo "${warnings[*]}")"
    return 0
  fi
  printf 'pass aligned\n'
}

