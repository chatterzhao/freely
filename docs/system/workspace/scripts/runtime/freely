task_source_scan_status_summary_for_project() {
  local project="$1" scan_json_path
  scan_json_path="$(task_source_scan_json_path_for_project "$project")"
  [[ -f "$scan_json_path" ]] || return 0
  python3 - "$scan_json_path" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    payload = json.load(f)

generated_at = payload.get("generated_at") or "unknown"
scan_reason = payload.get("scan_reason") or "unknown"
surfaces = payload.get("surfaces") or []
active_parts = []
summary_lines = []
for surface in surfaces:
    name = surface.get("surface") or "unknown"
    count = surface.get("active_count")
    if isinstance(count, int):
        active_parts.append(f"{name}={count}")
    lines = surface.get("summary_lines") or []
    trimmed = [line for line in lines if isinstance(line, str) and line.strip()]
    if trimmed:
        summary_lines.append(f"{name}: {trimmed[0]}")

active_csv = ",".join(active_parts) if active_parts else "none"
top_refs = " || ".join(summary_lines[:3]) if summary_lines else "none"
print(f"present|{generated_at}|{scan_reason}|{active_csv}|{top_refs}")
PY
}

cmd_task_source_scan() {
  local project="" emit_json="0" latest_file scan_dir
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --json) emit_json="1"; shift ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project" 1)"
  [[ -f "$TASK_SOURCE_SCAN_SCRIPT" ]] || {
    log_error "missing task source scan script: $TASK_SOURCE_SCAN_SCRIPT"
    exit 1
  }
  scan_dir="$(task_source_scan_dir_for_project "$project")"
  latest_file="$(task_source_scan_latest_file_for_project "$project")"
  mkdir -p "$scan_dir"
  python3 "$TASK_SOURCE_SCAN_SCRIPT" --project "$project" >"$latest_file"
  if [[ "$emit_json" == "1" ]]; then
    cat "$latest_file"
  else
    echo "project: $project"
    echo "task_source_scan: $latest_file"
    echo "recommended_skill: freely-auto-loop-orchestrator"
    echo "routing_skill: freely-context-source-skill"
    python3 - "$latest_file" <<'PY'
import json
import sys

path = sys.argv[1]
payload = json.load(open(path, encoding="utf-8"))
providers = payload.get("providers", {}).get("external_issue", {})
for name in ("github", "gitee"):
    provider = providers.get(name, {})
    hint = provider.get("availability_hint")
    if not hint:
        continue
    print(f"provider_hint_{name}: {hint}")
PY
  fi
}

