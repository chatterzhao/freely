  cat >"$(exit_contract_file "$project")" <<EOF
# Session Handoff

- rotation_reason: worker_exit_contract_repair
- previous_launch_kind: resume
- previous_tool_resume_target: ${resume_target:-unavailable}
- worktree_path: $project

## Repair Contract
- reason: ${reason:-worker_exit_contract_invalid}
- contract_file: $contract_file
- details: ${details:-missing}

## What To Handle First
- Stay inside the current worker issue boundary.
- Reuse the same worker context and produce a valid worker exit contract before claiming completion or requesting reschedule.
- The missing/invalid contract is the blocking defect from the previous round.
EOF
  if [[ -n "$prompt_file" && -f "$prompt_file" ]]; then
    cat >>"$(exit_contract_file "$project")" <<EOF

## Original Worker Boundary
- source_prompt_file: ${prompt_file}
- intent_kind: ${intent_kind:-unknown}
- owner_issue: ${owner_issue:-unknown}
- verification_artifact_dir: ${artifact_dir:-unknown}
