# Ensure freely-db daemon is running for this project.
# The daemon owns the single SQLite connection; all DB ops go through it.
ensure_freely_db() {
  local project="$1"
  local cli="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli"
  local daemon_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely_db_manager.py"
  local freely_db=""$project/.freely/freely.db""

  # Quick health check
  if python3 "$cli" --project "$project" db.ping >/dev/null 2>&1; then
    return 0
  fi

  # Start daemon in foreground mode, background it
  log_info "starting freely-db daemon for $project"
  _rotate_log "$project/.freely/run/db-daemon.log"

  python3 "$daemon_py" start --project "$project" --foreground </dev/null >>"$project/.freely/run/db-daemon.log" 2>&1 &
  local daemon_pid=$!
  disown "$daemon_pid"

  # Wait for socket to appear
  local waited=0
  while [[ $waited -lt 50 ]]; do
    if python3 "$cli" --project "$project" db.ping >/dev/null 2>&1; then
      log_info "freely-db daemon ready (PID $daemon_pid)"
      ensure_a2a_server_running "$project"
      return 0
    fi
    sleep 0.1
    ((waited++))
  done
  log_error "freely-db daemon failed to start"
  return 1
}

# ── A2A Server (Agent-to-Agent protocol) ──────────────────


# ── Log rotation: prevent unbounded growth for long-running daemon ──
_rotate_log() {
  local _log="$1" _max_size="${2:-10485760}" _max_keep="${3:-3}"
  [[ -f "$_log" ]] || return 0
  local _sz; _sz=$(stat -f%z "$_log" 2>/dev/null || stat -c%s "$_log" 2>/dev/null || echo 0)
  [[ "$_sz" -gt "$_max_size" ]] || return 0
  rm -f "$_log.$_max_keep" 2>/dev/null || true
  local _i=$((_max_keep - 1))
  while [[ $_i -ge 0 ]]; do
    [[ -f "$_log.$_i" ]] && mv "$_log.$_i" "$_log.$((_i + 1))" 2>/dev/null || true
    _i=$((_i - 1))
  done
  mv "$_log" "$_log.0" 2>/dev/null || true
  : > "$_log"
}

ensure_a2a_server_running() {
  local project="$1"
  local a2a_server_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/a2a/a2a_server.py"
  local a2a_socket a2a_pid a2a_cached_pid_file a2a_pid_file
  a2a_socket="$(_a2a_socket_path "$project")"
  a2a_cached_pid_file="$(run_dir_for_project "$project")/a2a-server.pid"
  # Temp PID file path (same hashing as a2a_server.py)
  a2a_pid_file="/tmp/freely-a2a-$(python3 -c "
import hashlib,os
h=hashlib.sha256(os.path.abspath('$project').encode()).hexdigest()[:16]
print(h)" 2>/dev/null || true).pid"
  [[ -f "$a2a_server_py" ]] || return 0

  # ── Kill any existing A2A server processes for this project ──────────
  # Prevents zombie accumulation from daemon restarts without clean stop.
  local _a2a_old_pid
  # Read from temp PID file (written by a2a_server.py itself)
  if [[ -f "$a2a_pid_file" ]]; then
    _a2a_old_pid="$(cat "$a2a_pid_file" 2>/dev/null || true)"
    if [[ -n "$_a2a_old_pid" ]]; then
      terminate_pid_with_graceful_wait "$_a2a_old_pid" "stale a2a server ($a2a_pid_file)"
    fi
  fi
  # Also check cached PID file from previous start
  if [[ -f "$a2a_cached_pid_file" ]]; then
    _a2a_old_pid="$(cat "$a2a_cached_pid_file" 2>/dev/null || true)"
    if [[ -n "$_a2a_old_pid" ]]; then
      terminate_pid_with_graceful_wait "$_a2a_old_pid" "stale a2a server ($a2a_cached_pid_file)"
    fi
    rm -f "$a2a_cached_pid_file"
  fi
  # Belt-and-suspenders: kill any remaining a2a_server.py processes for this project
  pkill -f "python3.*a2a_server\.py.*--project.*${project}.*--start" 2>/dev/null || true
  # Clean stale socket
  rm -f "$a2a_socket" 2>/dev/null || true

  # ── Start A2A Server ────────────────────────────────────────────────
  # Supports local (Unix socket) and remote (TCP)
  # Config: A2A_LISTEN_MODE=unix|tcp|both  A2A_TCP_HOST=0.0.0.0  A2A_TCP_PORT=19100
  log_info "starting A2A server for $project (mode=${A2A_LISTEN_MODE:-unix})"
  _rotate_log "$project/.freely/run/a2a-server.log"
  : > "$project/.freely/run/a2a-server.log"

  python3 "$a2a_server_py" --project "$project" --start \
    --listen-mode "${A2A_LISTEN_MODE:-unix}" \
    --tcp-host "${A2A_TCP_HOST:-}" --tcp-port "${A2A_TCP_PORT:-0}" \
    </dev/null >>"$project/.freely/run/a2a-server.log" 2>&1 &
  a2a_pid=$!
  disown "$a2a_pid"
  # Write PID to cached file for robust stop detection
  mkdir -p "$(run_dir_for_project "$project")"
  printf '%s\n' "$a2a_pid" > "$a2a_cached_pid_file"

  # ── Wait for A2A Server: poll process log for uvicorn ready message ──
  # The A2A log writes "Uvicorn running on unix socket ..." once bound.
  # This is more reliable than polling the socket file directly.
  local _health_waited=0 _health_ok=0 _health_max=15
  local _a2a_log="$project/.freely/run/a2a-server.log"
  while [[ $_health_waited -lt $_health_max ]]; do
    if ! kill -0 "$a2a_pid" 2>/dev/null; then
      log_warn "A2A server process (PID $a2a_pid) died during startup"
      break
    fi
    if grep -q "Uvicorn running on unix socket" "$_a2a_log" 2>/dev/null; then
      _health_ok=1
      break
    fi
    sleep 1
    _health_waited=$((_health_waited + 1))
  done
  if [[ "$_health_ok" == "1" ]]; then
    log_info "A2A server ready (PID $a2a_pid) on $a2a_socket (uvicorn running)"
  else
    log_warn "A2A server start timed out after ${_health_max}s (check A2A log, DB size, or zombie PIDs)"
  fi
  return 0
}

_a2a_socket_path() {
  local project="$1" hash
  hash="$(python3 -c "import hashlib,os; print(hashlib.sha256(os.path.abspath('$project').encode()).hexdigest()[:16])" 2>/dev/null || true)"
  echo "/tmp/freely-a2a-${hash}.sock"
}

