  # shellcheck disable=SC1090
  source "$state_file"
  [[ -n "${LAST_TOOL_JSONL_PATH:-}" && "${LAST_TOOL_JSONL_PATH:-}" != "unavailable" && -f "${LAST_TOOL_JSONL_PATH:-}" ]] && return 0
  [[ -n "${LAST_CLAUDE_JSONL_PATH:-}" && "${LAST_CLAUDE_JSONL_PATH:-}" != "unavailable" && -f "${LAST_CLAUDE_JSONL_PATH:-}" ]] && return 0
  [[ -n "${LAST_CODEX_MCP_JSONL_PATH:-}" && "${LAST_CODEX_MCP_JSONL_PATH:-}" != "unavailable" && -f "${LAST_CODEX_MCP_JSONL_PATH:-}" ]] && return 0
  [[ -n "${LAST_TOOL_SESSION_ID:-}" && "${LAST_TOOL_SESSION_ID:-}" != "unavailable" ]] && return 0
  [[ -n "${LAST_TOOL_RESUME_TARGET:-}" && "${LAST_TOOL_RESUME_TARGET:-}" != "unavailable" ]] && return 0
  return 1
}

recorded_worker_latest_runtime_evidence_epoch() {
  local project="$1"
  local prompt_file session_file workcell_file prompt_epoch="0" session_epoch="0" workcell_epoch="0" state_updated_epoch="0"
  local tool_jsonl_epoch="0" claude_jsonl_epoch="0" codex_mcp_jsonl_epoch="0"
  prompt_file="$(latest_prompt_file_for_project "$project")"
  session_file="$(session_state_file "$project")"
  workcell_file="$(workcell_state_file "$project")"
  prompt_epoch="$(file_mtime_epoch "$prompt_file" 2>/dev/null || true)"
  session_epoch="$(file_mtime_epoch "$session_file" 2>/dev/null || true)"
  workcell_epoch="$(file_mtime_epoch "$workcell_file" 2>/dev/null || true)"
  if [[ -f "$workcell_file" ]]; then
    # shellcheck disable=SC1090
    source "$workcell_file"
    state_updated_epoch="$(timestamp_epoch_or_zero "${LAST_STATE_UPDATED_AT:-}")"
  fi
  if [[ -f "$session_file" ]]; then
    # shellcheck disable=SC1090
    source "$session_file"
    [[ -n "${LAST_TOOL_JSONL_PATH:-}" && -f "${LAST_TOOL_JSONL_PATH:-}" ]] && tool_jsonl_epoch="$(file_mtime_epoch "${LAST_TOOL_JSONL_PATH:-}" 2>/dev/null || true)"
    [[ -n "${LAST_CLAUDE_JSONL_PATH:-}" && -f "${LAST_CLAUDE_JSONL_PATH:-}" ]] && claude_jsonl_epoch="$(file_mtime_epoch "${LAST_CLAUDE_JSONL_PATH:-}" 2>/dev/null || true)"
    [[ -n "${LAST_CODEX_MCP_JSONL_PATH:-}" && -f "${LAST_CODEX_MCP_JSONL_PATH:-}" ]] && codex_mcp_jsonl_epoch="$(file_mtime_epoch "${LAST_CODEX_MCP_JSONL_PATH:-}" 2>/dev/null || true)"
  fi
  max_epoch_value "${prompt_epoch:-0}" "${session_epoch:-0}" "${workcell_epoch:-0}" "${state_updated_epoch:-0}" "${tool_jsonl_epoch:-0}" "${claude_jsonl_epoch:-0}" "${codex_mcp_jsonl_epoch:-0}"
}

recorded_worker_ownership_status() {
  local project="$1"
  local latest_evidence_epoch now_epoch hard_threshold
  if recorded_worker_has_resume_evidence "$project"; then
    printf 'soft_stale\n'
    return 0
  fi
  latest_evidence_epoch="$(recorded_worker_latest_runtime_evidence_epoch "$project")"
  [[ "$latest_evidence_epoch" =~ ^[0-9]+$ ]] || latest_evidence_epoch=0
  (( latest_evidence_epoch > 0 )) || {
    printf 'hard_stale\n'
    return 0
  }
  now_epoch="$(date +%s)"
  hard_threshold="${FREELY_OWNERSHIP_HARD_STALE_SECS:-${OWNERSHIP_HARD_STALE_THRESHOLD_SECS:-21600}}"
  [[ "$hard_threshold" =~ ^[0-9]+$ ]] || hard_threshold=21600
  if (( now_epoch - latest_evidence_epoch >= hard_threshold )); then
    printf 'hard_stale\n'
  else
    printf 'soft_stale\n'
  fi
}

all_manager_worker_prompt_paths_from_continuity() {
