  }
  git -C "$project" status --porcelain 2>/dev/null | wc -l | tr -d ' '
}

worktree_summary_for_project() {
  local project="$1"
  local entries total dirty wt_path
  git -C "$project" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    printf '0|0\n'
    return 0
  }
  entries="$(git -C "$project" worktree list --porcelain 2>/dev/null || true)"
  [[ -n "$entries" ]] || {
    printf '0|0\n'
    return 0
  }

  total=0
  dirty=0
  while IFS= read -r wt_path; do
    [[ -n "$wt_path" ]] || continue
    total=$((total + 1))
    if [[ -n "$(git -C "$wt_path" status --porcelain 2>/dev/null)" ]]; then
      dirty=$((dirty + 1))
    fi
  done < <(printf '%s\n' "$entries" | awk '/^worktree / {print substr($0, 10)}')
  printf '%s|%s\n' "$total" "$dirty"
}

