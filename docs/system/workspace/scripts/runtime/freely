runtime_proxy_self_heal_probe_result() {
  local project="$1" tool="$2"
  case "$tool" in
    codex)
      codex_probe_current_slot_now "$project" "freely_proxy_self_heal" "freely proxy self-heal"
      ;;
    *)
      printf 'unsupported_tool\n'
      return 1
      ;;
