    --ai "${AI_TOOL}:${AI_MODEL:-}:${AI_MODE}" \
    --workspace-root "$workspace_root" \
    --reasoning-effort "${AI_REASONING_EFFORT:-}"
  append_context_warning_if_needed
  append_checkpoint_governance_if_needed
  append_checkpoint_intervention_if_needed
  append_fleet_supervision_if_needed
  append_manager_supervision_alert_if_needed
  append_manager_hygiene_alert_if_needed
  append_route_only_recovery_if_needed
  append_handoff_prompt_if_present "$PROJECT_ROOT"
}

cmd_init() {
  local project="" intent="" constitution="" ai_spec="" reasoning_effort=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --intent) intent="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --constitution) constitution="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --ai) ai_spec="${2:-}"; shift 2 ;;
      --reasoning-effort) reasoning_effort="${2:-}"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done

  [[ -n "$project" && -n "$intent" && -n "$constitution" && -n "$ai_spec" ]] || {
    usage
    exit 1
  }
  [[ -d "$project" ]] || { log_error "project not found: $project"; exit 1; }
  [[ -f "$intent" ]] || { log_error "intent file not found: $intent"; exit 1; }
  [[ -f "$constitution" ]] || { log_error "constitution file not found: $constitution"; exit 1; }

  local parsed tool model mode
  parsed="$(parse_ai_spec "$ai_spec")"
  IFS='|' read -r tool model mode <<<"$parsed"
  if [[ "$tool" == "codex" ]]; then
    [[ -n "$model" ]] || model="gpt-5.4"
    [[ -n "$reasoning_effort" ]] || reasoning_effort="medium"
  fi

  write_config "$project" "$intent" "$constitution" "$tool" "$model" "$mode" "$reasoning_effort"
  rm -f "$(session_state_file "$project")" "$(handoff_file "$project")"
  write_workcell_state "$project" "stopped" "down" "down" "initialized"
  log_info "initialized: $(config_file "$project")"
}

cmd_start() {
  local project=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  [[ -n "$project" ]] || { usage; exit 1; }
  load_config "$project"
  check_doc_gate_or_fail "$project" || {
    log_error "start blocked by doc gate"
    exit 1
  }

  local sdir run_dir logs_dir sup_pid_file child_pid_file loop_log
  local stop_requested=0
  local LAST_WORKCELL_EXIT_REASON="supervisor_exit"
  local DESIRED_RUNTIME_STATE_VALUE="running"
  sdir="$(state_dir "$project")"
  run_dir="$(run_dir_for_project "$project")"
  logs_dir="$(logs_dir_for_project "$project")"
  sup_pid_file="$run_dir/supervisor.pid"
  child_pid_file="$run_dir/ai.pid"
  loop_log="$logs_dir/loop.log"
  mkdir -p "$run_dir" "$logs_dir"
  rm -f "$(stop_marker_file "$project")"

  if [[ -f "$sup_pid_file" ]]; then
    local old_pid
    old_pid="$(cat "$sup_pid_file" 2>/dev/null || true)"
    if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
      log_error "already running (supervisor pid=$old_pid)"
      exit 1
    fi
  fi

  request_stop() {
    stop_requested=1
    LAST_WORKCELL_EXIT_REASON="operator_stop"
    DESIRED_RUNTIME_STATE_VALUE="stopped"
    : >"$(stop_marker_file "$project")"
    if [[ -f "$child_pid_file" ]]; then
      local active_child
      active_child="$(cat "$child_pid_file" 2>/dev/null || true)"
      [[ -n "$active_child" ]] && kill "$active_child" 2>/dev/null || true
    fi
  }

  cleanup_supervisor() {
    rm -f "$sup_pid_file" "$child_pid_file" "$(stop_marker_file "$project")"
    write_workcell_state "$project" "${DESIRED_RUNTIME_STATE_VALUE:-stopped}" "down" "down" "${LAST_WORKCELL_EXIT_REASON:-supervisor_exit}"
  }

  echo "$$" >"$sup_pid_file"
  write_workcell_state "$project" "running" "up" "down" "starting"
  trap cleanup_supervisor EXIT
  trap request_stop INT TERM

  local restart_count=0
  local FIRST_ROUND=true
  local LAUNCH_KIND_SELECTED="" LAUNCH_ROTATION_REASON=""
  load_session_state_or_defaults "$project"
  while true; do
    local ts prompt_file cycle_log mode_name watchdog_script workspace_root
    ts="$(date '+%Y%m%d-%H%M%S')"
    prompt_file="$run_dir/prompt-$ts.txt"
    cycle_log="$logs_dir/cycle-$ts.log"
    workspace_root="$(workspace_root_for_project "$PROJECT_ROOT")"
    local recovered_workers
    watchdog_script="$workspace_root/scripts/runtime/manager-watchdog.sh"
    if [[ -x "$watchdog_script" ]]; then
      recovered_workers="$(bash "$watchdog_script" --project "$PROJECT_ROOT" --recover-expected-workers 2>/dev/null || true)"
    else
      recovered_workers="$(manager_runtime_recover_workers_if_needed "$PROJECT_ROOT")"
    fi
    if [[ "${recovered_workers:-0}" =~ ^[0-9]+$ ]] && (( recovered_workers > 0 )); then
      log_info "manager runtime auto-recovered $recovered_workers expected-running worker(s) before prompt build"
      sleep "${RESTART_DELAY:-2}"
    fi
    select_launch_kind
    mode_name="$LAUNCH_KIND_SELECTED"

    if [[ "$mode_name" == "fresh_with_handoff" ]]; then
      write_session_handoff "$PROJECT_ROOT" "$LAUNCH_ROTATION_REASON"
      log_info "rotating session via fresh_with_handoff (reason=$LAUNCH_ROTATION_REASON)"
    fi
    build_prompt >"$prompt_file"
    if [[ "$mode_name" == "fresh" || "$mode_name" == "fresh_with_handoff" ]]; then
      rm -f "$(handoff_file "$PROJECT_ROOT")"
    fi

    log_info "launching $AI_TOOL ($mode_name mode, ai_mode=$AI_MODE)"
    set +e
    {
      echo "===== $(date '+%F %T') mode=$mode_name tool=$AI_TOOL ai_mode=$AI_MODE rotation_reason=${LAUNCH_ROTATION_REASON:-none} ====="
      local workspace_root
      workspace_root="$(workspace_root_for_project "$PROJECT_ROOT")"
      bash "$workspace_root/scripts/monitor-ai-cli.sh" \
        --project "$PROJECT_ROOT" \
        --tool "$AI_TOOL" \
        --model "${AI_MODEL:-}" \
        --reasoning-effort "${AI_REASONING_EFFORT:-}" \
        --mode "$AI_MODE" \
        --prompt-file "$prompt_file" \
        --pid-file "$child_pid_file" \
        --log-file "$cycle_log" \
        --launch-kind "$mode_name"
    } >>"$loop_log" 2>&1
    local rc=$?
    set -e
    local child_pid tool_session_id tool_jsonl_path context_compacted context_ratio route_only_handoff checkpoint_json checkpoint_required
    local primary_rate_limit_used_percent primary_rate_limit_resets_at secondary_rate_limit_used_percent secondary_rate_limit_resets_at next_restart_delay
    local active_account account_switch_reason
    local rate_limit_reason rate_limit_reset_at
    local dirty_entries worktree_total worktree_dirty summary
    child_pid="$(cat "$child_pid_file" 2>/dev/null || true)"
    tool_session_id="$(extract_tool_session_id_from_log "$AI_TOOL" "$cycle_log")"
    tool_jsonl_path=""
    context_ratio=""
    primary_rate_limit_used_percent=""
    primary_rate_limit_resets_at=""
    secondary_rate_limit_used_percent=""
    secondary_rate_limit_resets_at=""
    active_account=""
    account_switch_reason=""
    rate_limit_reason=""
    rate_limit_reset_at=""
    dirty_entries="0"
    worktree_total="0"
    worktree_dirty="0"
    next_restart_delay="${RESTART_DELAY:-2}"
    if [[ "$AI_TOOL" == "codex" && -n "$tool_session_id" ]]; then
      tool_jsonl_path="$(find_codex_jsonl_path_for_session "$tool_session_id")"
      context_ratio="$(extract_latest_codex_context_ratio_from_jsonl "$tool_jsonl_path")"
      primary_rate_limit_used_percent="$(extract_latest_codex_primary_rate_limit_used_percent_from_jsonl "$tool_jsonl_path")"
      primary_rate_limit_resets_at="$(extract_latest_codex_primary_rate_limit_reset_at_from_jsonl "$tool_jsonl_path")"
      secondary_rate_limit_used_percent="$(extract_latest_codex_secondary_rate_limit_used_percent_from_jsonl "$tool_jsonl_path")"
      secondary_rate_limit_resets_at="$(extract_latest_codex_secondary_rate_limit_reset_at_from_jsonl "$tool_jsonl_path")"
    fi
    if [[ "$AI_TOOL" == "codex" ]]; then
      active_account="$(codex_current_account "$PROJECT_ROOT")"
    fi
    dirty_entries="$(project_dirty_entries "$PROJECT_ROOT")"
    summary="$(worktree_summary_for_project "$PROJECT_ROOT")"
    worktree_total="${summary%%|*}"
    worktree_dirty="${summary##*|}"
    context_compacted="0"
    if log_has_context_compacted "$cycle_log"; then
      context_compacted="1"
    fi
    route_only_handoff="0"
    if log_has_same_tool_route_only_handoff "$cycle_log" "$AI_TOOL"; then
      route_only_handoff="1"
    fi
    LAST_TOOL_SESSION_ID="$tool_session_id"
    LAST_TOOL_JSONL_PATH="$tool_jsonl_path"
    LAST_LAUNCH_KIND="$mode_name"
    LAST_ROTATION_REASON="$LAUNCH_ROTATION_REASON"
    LAST_CYCLE_LOG="$cycle_log"
    LAST_CONTEXT_COMPACTED="$context_compacted"
    LAST_CONTEXT_RATIO="$context_ratio"
    LAST_PRIMARY_RATE_LIMIT_USED_PERCENT="$primary_rate_limit_used_percent"
    LAST_PRIMARY_RATE_LIMIT_RESETS_AT="$primary_rate_limit_resets_at"
    LAST_SECONDARY_RATE_LIMIT_USED_PERCENT="$secondary_rate_limit_used_percent"
    LAST_SECONDARY_RATE_LIMIT_RESETS_AT="$secondary_rate_limit_resets_at"
    LAST_ROUTE_ONLY_HANDOFF="$route_only_handoff"
    LAST_ACTIVE_ACCOUNT="$active_account"
    LAST_ACCOUNT_SWITCH_REASON=""
    LAST_ACCOUNT_SWITCH_AT=""
    LAST_PROJECT_DIRTY_ENTRIES="$dirty_entries"
    LAST_WORKTREE_SUMMARY_TOTAL="$worktree_total"
    LAST_WORKTREE_SUMMARY_DIRTY="$worktree_dirty"
    checkpoint_json="$(checkpoint_guard_json_for_project "$PROJECT_ROOT")"
    checkpoint_required="$(checkpoint_guard_value "$checkpoint_json" checkpoint_required)"
    if [[ "$checkpoint_required" == "true" || "$dirty_entries" =~ ^[0-9]+$ && "$dirty_entries" -ge "${CHECKPOINT_WARN_DIRTY_ENTRIES:-40}" ]]; then
      CHECKPOINT_DRIFT_STREAK_CURRENT=$(( ${CHECKPOINT_DRIFT_STREAK_CURRENT:-0} + 1 ))
    else
      CHECKPOINT_DRIFT_STREAK_CURRENT=0
    fi

    if [[ "$stop_requested" -eq 1 || -f "$(stop_marker_file "$project")" ]]; then
      LAST_WORKCELL_EXIT_REASON="operator_stop"
      DESIRED_RUNTIME_STATE_VALUE="stopped"
      rm -f "$child_pid_file" "$(session_state_file "$project")" "$(handoff_file "$project")"
      log_info "received stop signal, exiting supervisor"
      exit 0
    fi

    if [[ "$mode_name" == "resume" ]]; then
      RESUME_STREAK_CURRENT=$((RESUME_STREAK_CURRENT + 1))
    else
      RESUME_STREAK_CURRENT=0
    fi
    if [[ "$route_only_handoff" == "1" ]]; then
      ROUTE_ONLY_STREAK_CURRENT=$((ROUTE_ONLY_STREAK_CURRENT + 1))
    else
      ROUTE_ONLY_STREAK_CURRENT=0
    fi
    if [[ "$AI_TOOL" == "codex" ]]; then
      rate_limit_reason="$(codex_rate_limit_reason_from_usage "${primary_rate_limit_used_percent:-}" "${secondary_rate_limit_used_percent:-}")"
      rate_limit_reset_at="$(codex_rate_limit_reset_at_for_reason "${rate_limit_reason:-}" "${primary_rate_limit_resets_at:-}" "${secondary_rate_limit_resets_at:-}")"
      if [[ -n "$rate_limit_reason" ]]; then
        account_switch_reason="$rate_limit_reason"
        codex_record_account_cooldown "$PROJECT_ROOT" "$active_account" "${rate_limit_reset_at:-}"
      elif log_has_auth_failure "$cycle_log"; then
        account_switch_reason="auth_failure"
      fi
      if [[ -n "$account_switch_reason" ]]; then
        LAST_ACCOUNT_SWITCH_REASON="$account_switch_reason"
        LAST_ACCOUNT_SWITCH_AT="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
      fi
    fi

    write_session_state "$project" "$LAST_TOOL_SESSION_ID" "$LAST_TOOL_JSONL_PATH" "$LAST_LAUNCH_KIND" "$LAST_ROTATION_REASON" "$LAST_CYCLE_LOG" "$LAST_CONTEXT_COMPACTED" "$LAST_CONTEXT_RATIO" "$LAST_PRIMARY_RATE_LIMIT_USED_PERCENT" "$LAST_PRIMARY_RATE_LIMIT_RESETS_AT" "$LAST_SECONDARY_RATE_LIMIT_USED_PERCENT" "$LAST_SECONDARY_RATE_LIMIT_RESETS_AT" "$LAST_ROUTE_ONLY_HANDOFF" "$ROUTE_ONLY_STREAK_CURRENT" "$RESUME_STREAK_CURRENT" "$LAST_ACTIVE_ACCOUNT" "$LAST_ACCOUNT_SWITCH_REASON" "$LAST_ACCOUNT_SWITCH_AT" "$LAST_PROJECT_DIRTY_ENTRIES" "$LAST_WORKTREE_SUMMARY_TOTAL" "$LAST_WORKTREE_SUMMARY_DIRTY" "$CHECKPOINT_DRIFT_STREAK_CURRENT"
    LAST_WORKCELL_EXIT_REASON="${account_switch_reason:-${rate_limit_reason:-ai_exit_rc_${rc}}}"
    write_workcell_state "$project" "running" "up" "down" "$LAST_WORKCELL_EXIT_REASON"

    log_warn "ai process exited rc=$rc (pid=${child_pid:-unknown}, session_id=${tool_session_id:-unavailable}, context_compacted=$context_compacted, context_ratio=${context_ratio:-unavailable}, jsonl_path=${tool_jsonl_path:-unavailable}, primary_rate_limit_used_percent=${primary_rate_limit_used_percent:-unavailable}, primary_rate_limit_resets_at=${primary_rate_limit_resets_at:-unavailable}, secondary_rate_limit_used_percent=${secondary_rate_limit_used_percent:-unavailable}, secondary_rate_limit_resets_at=${secondary_rate_limit_resets_at:-unavailable}, route_only_handoff=${route_only_handoff})"
    rm -f "$child_pid_file"

    FIRST_ROUND=false
    restart_count=$((restart_count + 1))
    if [[ "${MAX_RESTARTS:-0}" -gt 0 && "$restart_count" -gt "${MAX_RESTARTS:-0}" ]]; then
      log_error "reached MAX_RESTARTS=${MAX_RESTARTS}, stopping"
      exit 1
    fi
    if [[ -n "$account_switch_reason" ]]; then
      log_warn "${account_switch_reason} detected for this workcell; local runtime is deferring global account recovery to the global watchdog / manager control plane and will now stop"
      exit 0
    fi
    sleep_with_rate_limit_recheck "$PROJECT_ROOT" "$next_restart_delay"
  done
}

cmd_ensure_manager() {
  local project="" branch="" watch_mode="0" watch_interval="5"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --watch) watch_mode="1"; shift ;;
      --interval) watch_interval="${2:-}"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  [[ -n "$project" ]] || { usage; exit 1; }
  [[ "$watch_interval" =~ ^[0-9]+$ ]] || { log_error "ensure-manager --interval must be a positive integer"; exit 1; }
  load_config "$project"
  check_doc_gate_or_fail "$project" || {
    log_error "ensure-manager blocked by doc gate"
    exit 1
  }

  branch="$(git -C "$project" branch --show-current 2>/dev/null || true)"
  if [[ "$branch" != "develop" ]]; then
    log_error "ensure-manager only supports the develop manager worktree (current branch: ${branch:-unknown})"
    exit 1
  fi

  if [[ "$watch_mode" == "1" ]]; then
    cmd_ensure_manager_watch "$project" "$watch_interval"
    return 0
  fi

  ensure_manager_once "$project"
}

