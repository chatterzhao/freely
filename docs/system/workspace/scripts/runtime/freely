ratio_meets_threshold() {
  local ratio="$1" threshold="$2"
  [[ -n "$ratio" && -n "$threshold" ]] || return 1
  awk -v ratio="$ratio" -v threshold="$threshold" 'BEGIN { exit !(ratio >= threshold) }'
}

rate_limit_exhausted() {
  local used_percent="$1"
  [[ -n "$used_percent" ]] || return 1
  awk -v used_percent="$used_percent" 'BEGIN { exit !(used_percent >= 100) }'
}

codex_rate_limit_reason_from_usage() {
  local primary_used_percent="$1" secondary_used_percent="$2"
  if rate_limit_exhausted "$secondary_used_percent"; then
    printf 'secondary_rate_limit_exhausted\n'
    return 0
  fi
  if rate_limit_exhausted "$primary_used_percent"; then
    printf 'primary_rate_limit_exhausted\n'
    return 0
  fi
}

codex_rate_limit_reset_at_for_reason() {
  local reason="$1" primary_resets_at="$2" secondary_resets_at="$3"
  case "$reason" in
    secondary_rate_limit_exhausted) printf '%s\n' "$secondary_resets_at" ;;
    primary_rate_limit_exhausted) printf '%s\n' "$primary_resets_at" ;;
  esac
}

seconds_until_epoch() {
  local target_epoch="$1"
  local now
  [[ -n "$target_epoch" ]] || return 0
  now="$(date +%s)"
  awk -v target="$target_epoch" -v now="$now" 'BEGIN { d=target-now; if (d < 0) d=0; print d }'
}

context_summary_target_hint_for_role() {
  local role="${1:-worker}"
  case "$role" in
    manager)
      cat <<'EOF'
phase-appropriate continuity artifact:
- manager continuity: update project-level continuity first
- include expected-running worktrees, blocked/frozen list, merge/cleanup queue, and next supervision priority
- if runtime-owned recovery already happened, record what manager should inspect next instead of redoing script recovery
EOF
      ;;
    *)
      cat <<'EOF'
phase-appropriate continuity artifact:
- dev-loop: update progress first
- doc-loop: update current issue / IBM / pre-brainstorm artifact first
- recovery: update recovery or allowed equivalent recovery evidence first
EOF
      ;;
  esac
}

