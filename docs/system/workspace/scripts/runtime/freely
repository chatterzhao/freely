  fi
  if [[ -d "$right" ]]; then
    right_real="$(cd "$right" 2>/dev/null && pwd -P || true)"
  fi
  [[ -n "$left_real" && -n "$right_real" && "$left_real" == "$right_real" ]] && return 0
