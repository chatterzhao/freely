        if (worker_prompts_subsection == "authoritative" && $0 ~ /^[[:space:]]*-[[:space:]]*`?\/[^` ]+\/\.freely\/run\/worker-prompts\/[^` ]+\.txt`?[[:space:]]*$/) {
          if (mode != "frozen") {
            emit_prompt_paths($0)
          }
          next
