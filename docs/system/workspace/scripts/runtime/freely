  lock_dir="${CURRENT_PROJECT_START_LOCK_PATH:-$(project_start_lock_dir_for_runtime "$project")}"
  rm -rf "$lock_dir"
  project_start_lock_snapshot_for_runtime "$project"
}

release_project_start_lock_for_runtime() {
  local project="$1" lock_dir state_file owner_pid=""
  lock_dir="$(project_start_lock_dir_for_runtime "$project")"
  state_file="$(project_start_lock_state_file_for_runtime "$project")"
  [[ -d "$lock_dir" ]] || return 0
  if [[ -f "$state_file" ]]; then
    owner_pid="$(awk -F= '/^owner_pid=/ {print $2; exit}' "$state_file" 2>/dev/null || true)"
    owner_pid="$(strip_simple_shell_quotes "$owner_pid")"
  fi
  [[ -n "$owner_pid" ]] || owner_pid="none"
  if [[ "$owner_pid" != "$$" ]]; then
    return 0
  fi
  rm -rf "$lock_dir"
}

acquire_project_start_lock_or_wait() {
  local project="$1" reason="${2:-freely_start}"
  local timeout_secs="${FREELY_PROJECT_START_LOCK_WAIT_SECS:-30}"
  local stale_secs="${FREELY_PROJECT_START_LOCK_STALE_SECS:-90}"
  local interval_secs="${FREELY_PROJECT_START_LOCK_WAIT_INTERVAL_SECS:-1}"
  local start_ts now waiting_logged="0" lock_dir state_file lock_parent
  local lock_started_epoch="" lock_age_secs=""
  [[ "$timeout_secs" =~ ^[0-9]+$ ]] || timeout_secs=30
  [[ "$stale_secs" =~ ^[0-9]+$ ]] || stale_secs=90
  [[ "$interval_secs" =~ ^[0-9]+$ ]] || interval_secs=1
  start_ts="$(date +%s)"
  lock_dir="$(project_start_lock_dir_for_runtime "$project")"
  state_file="$(project_start_lock_state_file_for_runtime "$project")"
  lock_parent="$(dirname "$lock_dir")"

  mkdir -p "$lock_parent"

  while true; do
    if mkdir "$lock_dir" 2>/dev/null; then
      cat >"$state_file" <<EOF
owner_pid="$$"
started_at="$(current_timestamp_utc_for_machine)"
reason="$reason"
EOF
      append_runtime_event "$project" "project_start_lock_acquired" \
        "owner_pid=$$" \
        "reason=$reason" \
        "lock_path=$lock_dir"
      return 0
    fi

    project_start_lock_snapshot_for_runtime "$project"
    case "${CURRENT_PROJECT_START_LOCK_STATE:-unknown}" in
      active)
        if [[ "${CURRENT_PROJECT_START_LOCK_OWNER_PID:-none}" == "$$" ]]; then
          return 0
        fi
        if [[ "${CURRENT_PROJECT_START_LOCK_STATE:-unknown}" == "active" ]]; then
          lock_started_epoch="$(codex_timestamp_to_epoch "${CURRENT_PROJECT_START_LOCK_STARTED_AT:-}" 2>/dev/null || true)"
          if [[ -n "$lock_started_epoch" && "$lock_started_epoch" =~ ^[0-9]+$ ]]; then
            now="$(date +%s)"
            lock_age_secs=$(( now - lock_started_epoch ))
            if (( lock_age_secs >= stale_secs )) && ! project_has_active_runtime_processes "$project"; then
              log_warn "removing active-but-stalled project start lock before freely start (owner_pid=${CURRENT_PROJECT_START_LOCK_OWNER_PID:-none} age_secs=$lock_age_secs path=${CURRENT_PROJECT_START_LOCK_PATH:-unknown})"
              append_runtime_event "$project" "project_start_lock_active_stale_cleanup" \
                "lock_state=${CURRENT_PROJECT_START_LOCK_STATE:-active}" \
                "lock_detail=${CURRENT_PROJECT_START_LOCK_DETAIL:-unknown}" \
                "lock_owner_pid=${CURRENT_PROJECT_START_LOCK_OWNER_PID:-none}" \
                "lock_started_at=${CURRENT_PROJECT_START_LOCK_STARTED_AT:-none}" \
                "lock_reason=${CURRENT_PROJECT_START_LOCK_REASON:-none}" \
                "lock_path=${CURRENT_PROJECT_START_LOCK_PATH:-unknown}" \
                "lock_age_secs=$lock_age_secs" \
                "stale_secs=$stale_secs"
              rm -rf "$lock_dir"
              continue
            fi
          fi
        fi
        if [[ "$waiting_logged" == "0" ]]; then
          log_warn "project start already in progress; waiting for same-project startup serialization (detail=${CURRENT_PROJECT_START_LOCK_DETAIL:-unknown} owner_pid=${CURRENT_PROJECT_START_LOCK_OWNER_PID:-none} path=${CURRENT_PROJECT_START_LOCK_PATH:-unknown})"
          append_runtime_event "$project" "project_start_lock_waiting" \
            "lock_state=${CURRENT_PROJECT_START_LOCK_STATE:-active}" \
            "lock_detail=${CURRENT_PROJECT_START_LOCK_DETAIL:-unknown}" \
            "lock_owner_pid=${CURRENT_PROJECT_START_LOCK_OWNER_PID:-none}" \
            "lock_started_at=${CURRENT_PROJECT_START_LOCK_STARTED_AT:-none}" \
            "lock_reason=${CURRENT_PROJECT_START_LOCK_REASON:-none}" \
            "lock_path=${CURRENT_PROJECT_START_LOCK_PATH:-unknown}" \
            "timeout_secs=$timeout_secs" \
            "interval_secs=$interval_secs"
          waiting_logged="1"
        fi
        now="$(date +%s)"
        if (( now - start_ts >= timeout_secs )); then
          log_error "timed out waiting for project start lock before freely start (detail=${CURRENT_PROJECT_START_LOCK_DETAIL:-unknown} owner_pid=${CURRENT_PROJECT_START_LOCK_OWNER_PID:-none} path=${CURRENT_PROJECT_START_LOCK_PATH:-unknown})"
          append_runtime_event "$project" "project_start_lock_timeout" \
            "lock_state=${CURRENT_PROJECT_START_LOCK_STATE:-active}" \
            "lock_detail=${CURRENT_PROJECT_START_LOCK_DETAIL:-unknown}" \
            "lock_owner_pid=${CURRENT_PROJECT_START_LOCK_OWNER_PID:-none}" \
            "lock_started_at=${CURRENT_PROJECT_START_LOCK_STARTED_AT:-none}" \
            "lock_reason=${CURRENT_PROJECT_START_LOCK_REASON:-none}" \
            "lock_path=${CURRENT_PROJECT_START_LOCK_PATH:-unknown}" \
            "timeout_secs=$timeout_secs"
          return 1
        fi
        sleep "$interval_secs"
        ;;
      stale)
        log_warn "removing stale project start lock before freely start (detail=${CURRENT_PROJECT_START_LOCK_DETAIL:-unknown} owner_pid=${CURRENT_PROJECT_START_LOCK_OWNER_PID:-none} path=${CURRENT_PROJECT_START_LOCK_PATH:-unknown})"
        append_runtime_event "$project" "project_start_lock_stale_cleanup" \
          "lock_state=${CURRENT_PROJECT_START_LOCK_STATE:-stale}" \
          "lock_detail=${CURRENT_PROJECT_START_LOCK_DETAIL:-unknown}" \
          "lock_owner_pid=${CURRENT_PROJECT_START_LOCK_OWNER_PID:-none}" \
          "lock_started_at=${CURRENT_PROJECT_START_LOCK_STARTED_AT:-none}" \
          "lock_reason=${CURRENT_PROJECT_START_LOCK_REASON:-none}" \
          "lock_path=${CURRENT_PROJECT_START_LOCK_PATH:-unknown}"
        cleanup_project_start_lock_if_stale_for_runtime "$project"
        continue
        ;;
      ambiguous)
        if [[ "${CURRENT_PROJECT_START_LOCK_DETAIL:-unknown}" == "state_file_missing" ]] && ! project_has_active_runtime_processes "$project"; then
          log_warn "removing ambiguous project start lock before freely start (detail=${CURRENT_PROJECT_START_LOCK_DETAIL:-unknown} owner_pid=${CURRENT_PROJECT_START_LOCK_OWNER_PID:-none} path=${CURRENT_PROJECT_START_LOCK_PATH:-unknown})"
          append_runtime_event "$project" "project_start_lock_ambiguous_cleanup" \
            "lock_state=${CURRENT_PROJECT_START_LOCK_STATE:-unknown}" \
            "lock_detail=${CURRENT_PROJECT_START_LOCK_DETAIL:-unknown}" \
            "lock_owner_pid=${CURRENT_PROJECT_START_LOCK_OWNER_PID:-none}" \
            "lock_started_at=${CURRENT_PROJECT_START_LOCK_STARTED_AT:-none}" \
            "lock_reason=${CURRENT_PROJECT_START_LOCK_REASON:-none}" \
            "lock_path=${CURRENT_PROJECT_START_LOCK_PATH:-unknown}"
          rm -rf "$lock_dir"
          continue
        fi
        if [[ "$waiting_logged" == "0" ]]; then
          log_warn "project start already in progress; waiting for same-project startup serialization (detail=${CURRENT_PROJECT_START_LOCK_DETAIL:-unknown} owner_pid=${CURRENT_PROJECT_START_LOCK_OWNER_PID:-none} path=${CURRENT_PROJECT_START_LOCK_PATH:-unknown})"
          append_runtime_event "$project" "project_start_lock_waiting" \
            "lock_state=${CURRENT_PROJECT_START_LOCK_STATE:-unknown}" \
            "lock_detail=${CURRENT_PROJECT_START_LOCK_DETAIL:-unknown}" \
            "lock_owner_pid=${CURRENT_PROJECT_START_LOCK_OWNER_PID:-none}" \
            "lock_started_at=${CURRENT_PROJECT_START_LOCK_STARTED_AT:-none}" \
            "lock_reason=${CURRENT_PROJECT_START_LOCK_REASON:-none}" \
            "lock_path=${CURRENT_PROJECT_START_LOCK_PATH:-unknown}" \
            "timeout_secs=$timeout_secs" \
            "interval_secs=$interval_secs"
          waiting_logged="1"
        fi
        now="$(date +%s)"
        if (( now - start_ts >= timeout_secs )); then
          log_error "timed out waiting for project start lock before freely start (detail=${CURRENT_PROJECT_START_LOCK_DETAIL:-unknown} owner_pid=${CURRENT_PROJECT_START_LOCK_OWNER_PID:-none} path=${CURRENT_PROJECT_START_LOCK_PATH:-unknown})"
          append_runtime_event "$project" "project_start_lock_timeout" \
            "lock_state=${CURRENT_PROJECT_START_LOCK_STATE:-unknown}" \
            "lock_detail=${CURRENT_PROJECT_START_LOCK_DETAIL:-unknown}" \
            "lock_owner_pid=${CURRENT_PROJECT_START_LOCK_OWNER_PID:-none}" \
            "lock_started_at=${CURRENT_PROJECT_START_LOCK_STARTED_AT:-none}" \
            "lock_reason=${CURRENT_PROJECT_START_LOCK_REASON:-none}" \
            "lock_path=${CURRENT_PROJECT_START_LOCK_PATH:-unknown}" \
            "timeout_secs=$timeout_secs"
          return 1
        fi
        sleep "$interval_secs"
        ;;
      *)
        sleep "$interval_secs"
        ;;
    esac
  done
}

codex_slot_switch_lock_snapshot_for_runtime() {
  local lock_dir state_file owner_pid="" started_at="" reason="" detail="" state=""
  local line key raw_value value owner_alive="0"
  lock_dir="$(codex_slot_switch_lock_dir_for_runtime)"
  state_file="$(codex_slot_switch_lock_state_file_for_runtime)"

  CURRENT_SLOT_SWITCH_LOCK_STATE="idle"
  CURRENT_SLOT_SWITCH_LOCK_DETAIL="lock_dir_absent"
  CURRENT_SLOT_SWITCH_LOCK_OWNER_PID="none"
  CURRENT_SLOT_SWITCH_LOCK_STARTED_AT="none"
  CURRENT_SLOT_SWITCH_LOCK_REASON="none"
  CURRENT_SLOT_SWITCH_LOCK_PATH="$lock_dir"

  if [[ ! -d "$lock_dir" ]]; then
    return 0
  fi

  if [[ ! -f "$state_file" ]]; then
    CURRENT_SLOT_SWITCH_LOCK_STATE="ambiguous"
    CURRENT_SLOT_SWITCH_LOCK_DETAIL="state_file_missing"
    return 0
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"
    raw_value="${line#*=}"
    value="$(strip_simple_shell_quotes "$raw_value")"
    case "$key" in
      owner_pid) owner_pid="$value" ;;
      started_at) started_at="$value" ;;
      reason) reason="$value" ;;
    esac
  done <"$state_file"

  [[ -n "$owner_pid" ]] || owner_pid="none"
  [[ -n "$started_at" ]] || started_at="none"
  [[ -n "$reason" ]] || reason="none"
  CURRENT_SLOT_SWITCH_LOCK_OWNER_PID="$owner_pid"
  CURRENT_SLOT_SWITCH_LOCK_STARTED_AT="$started_at"
  CURRENT_SLOT_SWITCH_LOCK_REASON="$reason"

  if [[ "$owner_pid" == "none" ]]; then
    CURRENT_SLOT_SWITCH_LOCK_STATE="stale"
    CURRENT_SLOT_SWITCH_LOCK_DETAIL="owner_pid_missing"
    return 0
  fi

  if [[ ! "$owner_pid" =~ ^[0-9]+$ ]]; then
    CURRENT_SLOT_SWITCH_LOCK_STATE="ambiguous"
    CURRENT_SLOT_SWITCH_LOCK_DETAIL="owner_pid_malformed"
    return 0
  fi

  if kill -0 "$owner_pid" 2>/dev/null; then
    owner_alive="1"
  fi
  if [[ "$owner_alive" == "1" ]]; then
    CURRENT_SLOT_SWITCH_LOCK_STATE="active"
    CURRENT_SLOT_SWITCH_LOCK_DETAIL="owner_pid_alive"
    return 0
  fi

  CURRENT_SLOT_SWITCH_LOCK_STATE="stale"
  CURRENT_SLOT_SWITCH_LOCK_DETAIL="owner_pid_dead"
}

codex_slot_switch_lock_cleanup_if_stale_for_runtime() {
  local lock_dir
  codex_slot_switch_lock_snapshot_for_runtime
  [[ "${CURRENT_SLOT_SWITCH_LOCK_STATE:-idle}" == "stale" ]] || return 0
  lock_dir="${CURRENT_SLOT_SWITCH_LOCK_PATH:-$(codex_slot_switch_lock_dir_for_runtime)}"
  rm -rf "$lock_dir"
  codex_slot_switch_lock_snapshot_for_runtime
}

