log_has_same_tool_route_only_handoff() {
  local log_file="$1" current_tool="$2"
  [[ -f "$log_file" && -n "$current_tool" ]] || return 1
  rg -q "selected_tool = ${current_tool}" "$log_file" && rg -q '`next_prompt`' "$log_file"
}

extract_route_only_next_prompt_from_log() {
  local log_file="$1"
  [[ -f "$log_file" ]] || return 0
  awk '
    /`next_prompt`/ { seen=1; next }
    seen && /^```/ { inblock=1; next }
    inblock && /^```/ { exit }
    inblock { print }
  ' "$log_file"
}

