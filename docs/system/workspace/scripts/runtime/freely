manager_continuity_resume_focus_route_kind() {
  local continuity_file="$1"
  [[ -f "$continuity_file" ]] || return 1
  awk '
    /^## Ownership And Restart Point$/ { in_section=1; next }
    /^## / && in_section { exit }
    in_section && /route_kind:/ {
      if (match($0, /`[^`]+`/)) {
        value=substr($0, RSTART + 1, RLENGTH - 2)
        print value
        exit
      }
    }
  ' "$continuity_file"
}

append_manager_consumed_continuity_resume_focus_if_needed() {
  local project="$1"
  local state_file continuity_file latest_generated route_kind
  local queue_excerpt ownership_excerpt

  [[ "$(role_hint_for_project "$project")" == "manager" ]] || return 0
  [[ "${LAUNCH_KIND_SELECTED:-}" == "resume" ]] || return 0
  [[ ! -f "$(handoff_file "$project")" ]] || return 0
  [[ "${LAST_DELEGATED_CONTINUATION_PENDING_COUNT:-0}" == "0" ]] || return 0

  state_file="$(manager_worker_launch_state_file "$project")"
  continuity_file="${LAST_MANAGER_CONTINUITY_CONSUMED:-}"
  if [[ -z "$continuity_file" && -f "$state_file" ]]; then
    # shellcheck disable=SC1090
    source "$state_file"
    continuity_file="${LAST_MANAGER_CONTINUITY_CONSUMED:-}"
  fi
  [[ -n "$continuity_file" && -f "$continuity_file" ]] || return 0

  latest_generated="$(latest_generated_manager_continuity_file_for_project "$project")"
  [[ -n "$latest_generated" && "$continuity_file" == "$latest_generated" ]] || return 0

  route_kind="$(manager_continuity_resume_focus_route_kind "$continuity_file" || true)"
  case "$route_kind" in
    completion_verification|cleanup_governance) ;;
    *) return 0 ;;
  esac

  queue_excerpt="$(awk '
    /^## Queue And Dispatch$/ { in_section=1; print; next }
    /^## / && in_section { exit }
    in_section { print }
  ' "$continuity_file")"
  ownership_excerpt="$(awk '
    /^## Ownership And Restart Point$/ { in_section=1; print; next }
    /^## / && in_section { exit }
    in_section { print }
  ' "$continuity_file")"
  [[ -n "$queue_excerpt" || -n "$ownership_excerpt" ]] || return 0

  printf '\n已消费 manager continuity 续接：\n'
  printf -- '- 当前轮次是同一 manager lane 的 `resume`，且 runtime 已消费最近一份 continuity：\n'
  printf -- '  - `%s`\n' "$continuity_file"
  printf -- '- 不要默认重做完整的主管首跳 patrol / 里程碑全扫描。\n'
  printf -- '- 先严格承接这份 continuity 的 `active_lane / restart_point / next_action / next_supervision_priority`。\n'
  printf -- '- 只有出现以下情况时，才允许扩回全量巡检：\n'
  printf -- '  - 有新的 delegated continuation / fresh intake\n'
  printf -- '  - 当前 authoritative fleet truth 与该 continuity 明显冲突\n'
  printf -- '  - 该 continuity 指定的 restart point 已被你本轮明确关闭，并且你正在写下一份 manager continuity 来推进 owner / phase judgement\n\n'
  [[ -n "$queue_excerpt" ]] && printf '%s\n' "$queue_excerpt"
  [[ -n "$ownership_excerpt" ]] && printf '%s\n' "$ownership_excerpt"
}

