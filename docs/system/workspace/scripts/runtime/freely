worker_prompt_target_branch() {
  local prompt_file="$1"
  [[ -f "$prompt_file" ]] || return 0
  awk '
    /^You are the [^`]*worker for `/ && / in `\// {
      value=$0
      sub(/^You are the [^`]*worker for `/, "", value)
      split(value, parts, "` in `")
      print parts[1]
      exit
    }
    /^- branch: / {
      value=$0
      sub(/^- branch: `/, "", value)
      sub(/`$/, "", value)
      print value
      exit
    }
    /^Branch:$/ { capture=1; next }
    capture && /^- / {
      value=$0
      sub(/^- /, "", value)
      gsub(/`/, "", value)
      print value
      exit
    }
  ' "$prompt_file"
}

worktree_path_for_branch() {
  local project="$1" target_branch="$2"
  [[ -n "$target_branch" ]] || return 0
  git -C "$project" worktree list --porcelain 2>/dev/null | awk -v target="refs/heads/$target_branch" '
    /^worktree / { wt=substr($0, 10); next }
    /^branch / {
      if ($2 == target) {
        print wt
        exit
      }
    }
  '
}

worker_prompt_resolved_worktree() {
  local manager_project="$1" prompt_file="$2"
  local target_worktree target_branch
  target_worktree="$(worker_prompt_target_worktree "$prompt_file")"
  if [[ -n "$target_worktree" && -d "$target_worktree" ]]; then
    normalize_runtime_worktree_path "$target_worktree"
    return 0
  fi
  target_branch="$(worker_prompt_target_branch "$prompt_file")"
  if [[ -n "$target_branch" ]]; then
    worktree_path_for_branch "$manager_project" "$target_branch"
  fi
}

worker_worktree_has_runtime_history() {
  local worktree_path="$1"
  [[ -n "$worktree_path" && -d "$worktree_path" ]] || return 1
  [[ -f "$(config_file "$worktree_path")" ]] || return 1
}

branch_is_merged_into_develop() {
  local project="$1" target_branch="$2"
  [[ -n "$target_branch" ]] || return 1
  [[ "$target_branch" != "develop" ]] || return 1
  git -C "$project" show-ref --verify --quiet "refs/heads/$target_branch" 2>/dev/null || return 1
  git -C "$project" show-ref --verify --quiet "refs/heads/develop" 2>/dev/null || return 1
  git -C "$project" merge-base --is-ancestor "refs/heads/$target_branch" "refs/heads/develop" 2>/dev/null
}

worker_prompt_targets_retire_ready_merged_worktree() {
  local manager_project="$1" prompt_file="$2"
  local resolved_worktree target_branch dirty_entries
  resolved_worktree="$(worker_prompt_resolved_worktree "$manager_project" "$prompt_file")"
  [[ -n "$resolved_worktree" && -d "$resolved_worktree" ]] || return 1
  worker_worktree_has_runtime_history "$resolved_worktree" || return 1
  target_branch="$(worker_prompt_target_branch "$prompt_file")"
  [[ -n "$target_branch" ]] || return 1
  branch_is_merged_into_develop "$manager_project" "$target_branch" || return 1
  dirty_entries="$(project_dirty_entries "$resolved_worktree")"
  [[ "$dirty_entries" =~ ^[0-9]+$ ]] || return 1
  (( dirty_entries == 0 ))
}

worker_prompt_launchable_for_manager_project() {
  local manager_project="$1" prompt_file="$2" resolved_worktree
  resolved_worktree="$(worker_prompt_resolved_worktree "$manager_project" "$prompt_file")"
  [[ -n "$resolved_worktree" && -d "$resolved_worktree" ]] || return 1
  if worker_prompt_targets_retire_ready_merged_worktree "$manager_project" "$prompt_file"; then
    return 1
  fi
  return 0
}

manager_continuity_has_worker_prompts() {
  local continuity_file="$1"
  [[ -n "$(latest_manager_worker_prompt_csv_from_continuity "$continuity_file")" ]]
}

manager_continuity_has_unconsumed_launchable_worker_prompt() {
  local project="$1" continuity_file="$2"
  local prompt_file prompt_generated_csv launched_csv=""
  [[ -f "$continuity_file" ]] || return 1
  prompt_generated_csv="$(latest_manager_worker_prompt_csv_from_continuity "$continuity_file")"
  if [[ -f "$(manager_worker_launch_state_file "$project")" ]]; then
    # shellcheck disable=SC1090
    source "$(manager_worker_launch_state_file "$project")"
    launched_csv="${LAST_MANAGER_WORKER_PROMPTS_CONSUMED:-${LAUNCHED_WORKER_PROMPTS:-}}"
    if [[ -n "${LAST_MANAGER_CONTINUITY_CONSUMED:-}" && "${LAST_MANAGER_CONTINUITY_CONSUMED:-}" != "$continuity_file" ]]; then
      launched_csv=""
    else
      launched_csv="$(csv_retain_exact_items "$launched_csv" "$prompt_generated_csv")"
    fi
  fi
  while IFS= read -r prompt_file; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
    worker_prompt_launchable_for_manager_project "$project" "$prompt_file" || continue
    if ! csv_contains_exact_item "$launched_csv" "$prompt_file"; then
      return 0
    fi
  done < <(latest_manager_worker_prompt_paths_from_continuity "$continuity_file")
  return 1
}

manager_continuity_waiting_on_active_busy_worker() {
  local project="$1" continuity_file="$2"
  local prompt_file target_project prompt_generated_csv launched_csv="" saw_active_busy="0"
  [[ -f "$continuity_file" ]] || return 1
  manager_continuity_has_stale_runtime_worktree_refs "$project" "$continuity_file" && return 1
  prompt_generated_csv="$(latest_manager_worker_prompt_csv_from_continuity "$continuity_file")"
  if [[ -f "$(manager_worker_launch_state_file "$project")" ]]; then
    # shellcheck disable=SC1090
    source "$(manager_worker_launch_state_file "$project")"
    launched_csv="${LAST_MANAGER_WORKER_PROMPTS_CONSUMED:-${LAUNCHED_WORKER_PROMPTS:-}}"
    if [[ -n "${LAST_MANAGER_CONTINUITY_CONSUMED:-}" && "${LAST_MANAGER_CONTINUITY_CONSUMED:-}" != "$continuity_file" ]]; then
      launched_csv=""
    else
      launched_csv="$(csv_retain_exact_items "$launched_csv" "$prompt_generated_csv")"
    fi
  fi
