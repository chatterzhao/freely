current_runtime_discovery_excluded_pids_csv() {
  local pid="" parent="" csv="" seen_csv=""
  pid="${BASHPID:-$$}"
  while [[ -n "$pid" && "$pid" =~ ^[0-9]+$ && "$pid" != "0" ]]; do
    case ",$seen_csv," in
      *",$pid,"*) break ;;
    esac
    seen_csv="${seen_csv}${seen_csv:+,}$pid"
    csv="${csv}${csv:+,}$pid"
    parent="$(ps -p "$pid" -o ppid= 2>/dev/null | awk 'NR==1 {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0); print $0}')"
    [[ -n "$parent" && "$parent" != "$pid" ]] || break
    pid="$parent"
  done
  printf '%s\n' "$csv"
}

