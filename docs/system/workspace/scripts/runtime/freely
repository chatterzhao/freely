develop_push_followthrough_snapshot_for_project() {
  local project="$1"
  local branch upstream counts ahead behind state summary defer_reason defer_note defer_updated_at state_file
  branch="$(branch_name_for_project "$project")"
  state="not_applicable"
  summary="branch_not_develop"
  upstream="none"
  ahead="0"
  behind="0"
  defer_reason="none"
  defer_note="none"
  defer_updated_at="unavailable"
  state_file="$(develop_push_followthrough_state_file "$project")"

  if [[ -f "$state_file" ]]; then
    # shellcheck disable=SC1090
    source "$state_file"
    defer_reason="${DEVELOP_PUSH_DEFER_REASON:-none}"
    defer_note="${DEVELOP_PUSH_DEFER_NOTE:-none}"
    defer_updated_at="${DEVELOP_PUSH_DEFER_UPDATED_AT:-unavailable}"
    if [[ -n "$defer_reason" ]] && ! develop_push_defer_reason_is_valid "$defer_reason"; then
      defer_reason="invalid:${defer_reason}"
    fi
    [[ -n "$defer_note" ]] || defer_note="none"
  fi

  if [[ "$branch" == "develop" ]]; then
    upstream="$(develop_push_followthrough_upstream_for_project "$project")"
    if [[ -z "$upstream" ]]; then
      state="not_applicable"
      summary="no_upstream"
      upstream="none"
    else
      counts="$(git -C "$project" rev-list --left-right --count "HEAD...$upstream" 2>/dev/null || true)"
      if [[ -n "$counts" ]]; then
        ahead="$(printf '%s\n' "$counts" | awk '{print $1}')"
        behind="$(printf '%s\n' "$counts" | awk '{print $2}')"
      fi
      [[ "$ahead" =~ ^[0-9]+$ ]] || ahead="0"
      [[ "$behind" =~ ^[0-9]+$ ]] || behind="0"
      if (( ahead > 0 )); then
        if develop_push_defer_reason_is_valid "${DEVELOP_PUSH_DEFER_REASON:-}"; then
          state="push_deferred"
          summary="ahead=${ahead} behind=${behind} upstream=${upstream} defer=${DEVELOP_PUSH_DEFER_REASON}"
        else
          state="push_pending"
          summary="ahead=${ahead} behind=${behind} upstream=${upstream} defer=none"
        fi
      else
        state="clean"
        summary="ahead=0 behind=${behind} upstream=${upstream}"
      fi
    fi
  fi

  printf '%s|%s|%s|%s|%s|%s|%s\n' "$state" "$summary" "$upstream" "$ahead" "$behind" "$defer_reason" "$defer_updated_at"
}

