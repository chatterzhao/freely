      if (section == "worker prompts") {
        if ($0 ~ /^[[:space:]]*-[[:space:]]*launched:[[:space:]]*$/) {
          worker_prompts_subsection="launched"
          next
        }
        if ($0 ~ /^[[:space:]]*-[[:space:]]*queue:[[:space:]]*$/) {
          worker_prompts_subsection="queue"
          next
        }
        if ($0 ~ /^[[:space:]]*-[[:space:]]*frozen_queue:[[:space:]]*$/) {
          worker_prompts_subsection="frozen"
          next
        }
        # Accept both list-item format (- /path/...) and prose format (See: /path/...)
        if ($0 ~ /\/[^` ]+\/\.freely\/run\/worker-prompts\/[^` ]+\.txt/) {
          if (worker_prompts_subsection == "frozen") {
            if (mode != "launchable") {
              emit_prompt_paths($0)
            }
          } else if (worker_prompts_subsection == "" || worker_prompts_subsection == "launched" || worker_prompts_subsection == "queue") {
            if (mode != "frozen") {
              emit_prompt_paths($0)
            }
          }
          next
        }
      }
      if (section == "queue state") {
        if ($0 ~ /^[[:space:]]*(-[[:space:]]*)?worker_prompts:[[:space:]]*$/) {
          capture_worker_prompt_path_list=(mode != "frozen")
          worker_prompts_subsection="worker_prompts"
          next
        }
        if ($0 ~ /^[[:space:]]*(-[[:space:]]*)?frozen_queue:[[:space:]]*$/ || $0 ~ /^[[:space:]]*(-[[:space:]]*)?cleanup_queue:[[:space:]]*$/ || $0 ~ /^[[:space:]]*(-[[:space:]]*)?launch_queue:[[:space:]]*$/) {
          capture_worker_prompt_path_list=0
          worker_prompts_subsection=""
          next
        }
      }
      if (section == "queue|frozen queue") {
        if ($0 ~ /^[[:space:]]*-[[:space:]]*queue:[[:space:]]*$/) {
          worker_prompts_subsection="queue"
          next
        }
        if ($0 ~ /^[[:space:]]*-[[:space:]]*frozen_queue:[[:space:]]*$/ || $0 ~ /^[[:space:]]*-[[:space:]]*frozen queue:[[:space:]]*$/) {
          worker_prompts_subsection="frozen"
          next
        }
        if (($0 ~ /prompt_path:/ || $0 ~ /worker_prompt_path:/ || $0 ~ /worker_prompt:/)) {
          if (worker_prompts_subsection == "frozen") {
            if (mode != "launchable") {
              emit_prompt_paths($0)
            }
          } else if (worker_prompts_subsection == "queue") {
            if (mode != "frozen") {
              emit_prompt_paths($0)
            }
          }
          next
        }
        # Accept both list-item and prose formats for worker prompt paths
        if ($0 ~ /\/[^` ]+\/\.freely\/run\/worker-prompts\/[^` ]+\.txt/) {
          if (worker_prompts_subsection == "frozen") {
            if (mode != "launchable") {
              emit_prompt_paths($0)
            }
          } else if (worker_prompts_subsection == "queue") {
            if (mode != "frozen") {
              emit_prompt_paths($0)
            }
          }
          next
        }
      }
      if (section == "worker delegation") {
        if ($0 ~ /^[[:space:]]*-[[:space:]]*authoritative_worker_prompts:[[:space:]]*$/) {
          worker_prompts_subsection="authoritative"
          capture_worker_prompt_path_list=(mode != "frozen")
