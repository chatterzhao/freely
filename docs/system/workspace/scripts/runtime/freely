cmd_comment() {
  local issue_id="" message="" file_path="" project=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue) issue_id="${2:-}"; shift 2 ;;
      --file) file_path="${2:-}"; shift 2 ;;
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --help|-h) cat <<HELP; return 0
Usage: freely comment --issue raw-{key} <message>
       freely comment --issue raw-{key} --file <path>

Write a comment to a raw issue on all configured platforms (GitHub, Gitee, GitCode).
The comment is written directly to platforms via adapter — no local storage.

Options:
  --issue raw-{key}  Required. Target raw issue.
  --file <path>      Read comment body from file (alternative to inline message).
  --project <path>   Project root path.

Examples:
  freely comment --issue raw-20260628T005815Z "good point, let me fix that"
  freely comment --issue raw-20260628T005815Z --file /tmp/comment.txt
HELP
        ;;
      --*) log_error "unknown option: $1"; return 1 ;;
      *) message="$1"; shift ;;
    esac
  done

  project="$(resolve_project_or_fail "$project" 1)"

  # Validate issue_id
  [[ -n "$issue_id" ]] || { log_error "--issue is required"; return 1; }
  [[ "$issue_id" == raw-* ]] || { log_error "--issue must be a raw issue (raw-{key})"; return 1; }

  # Read message from file if --file specified
  if [[ -n "$file_path" ]]; then
    [[ -f "$file_path" ]] || { log_error "file not found: $file_path"; return 1; }
    message="$(cat "$file_path")"
  fi
  [[ -n "$message" ]] || { log_error "comment message is required"; return 1; }

  # Check if raw issue is closed on platform — reject if so
  local _adapter="$SELF_ROOT/docs/system/workspace/scripts/sync/platform-adapter.py"
  local _raw_key="${issue_id#raw-}"
  local _platform_state
  _platform_state=$(python3 "$_adapter" get-issue-state "$issue_id" 2>/dev/null || echo "unknown")
  if [[ "$_platform_state" == "closed" ]]; then
    log_error "raw issue $issue_id is closed on platform"
    echo >&2 "  Reopen the issue first, then comment."
    echo >&2 "  Use the platform UI or: freely issue-reopen $issue_id"
    return 1
  fi

  # Write comment to all platforms via adapter (uses existing `comment` CLI)
  echo "[comment] writing to all platforms..."
  local _adapter_result
  _adapter_result=$(python3 "$_adapter" comment "$issue_id" "$message" 2>&1) || {
    echo "[comment] ERROR: platform adapter failed (rc=$?)" >&2
    echo "$_adapter_result" >&2
    return 1
  }
  echo "[comment] adapter output:"
  echo "$_adapter_result"

  # Notify active worker via ACP session/prompt if worktree is active
  local _wt_path _agent_env="${project}/.freely/agent-id.env"
  if [[ -f "$_agent_env" ]]; then
    _wt_path=$(grep -F "raw-${_raw_key}" "$_agent_env" 2>/dev/null | head -1 | cut -d= -f1 || true)
    if [[ -n "$_wt_path" && -d "$_wt_path" ]]; then
      local _session_id
      _session_id=$(python3 -c "
import sqlite3, json
conn = sqlite3.connect('${project}/.freely/freely.db')
r = conn.execute(\"SELECT session_id FROM sessions WHERE project=? AND role IN ('worker','manager') AND status='active' ORDER BY updated_at DESC LIMIT 1\", ('$_wt_path',)).fetchone()
print(r[0] if r else '')
conn.close()
" 2>/dev/null || true)
      if [[ -n "$_session_id" ]]; then
        log_info "comment: notifying worker via ACP session $_session_id"
        python3 "$SELF_ROOT/docs/system/workspace/scripts/runtime/run-acp-prompt.py" \
          --session-id "$_session_id" \
          --prompt "New comment on $issue_id: ${message:0:200}" \
          --cwd "$_wt_path" >/dev/null 2>&1 || true
      fi
    fi
  fi

  echo "[comment] done: $issue_id"
}

cmd_feedback() {
  local title="" body="" severity="P2" issue_kind="" raw_key="" stamp="" local_id=""
  local issue_dir="" issue_file="" issue_sync_bin="" sync_result

  # ── Subcommand detection ──────────────────────────────────
  local _subcmd="${1:-create}"
  case "$_subcmd" in
    edit|create) shift ;;
    --help|-h) _subcmd="help"; shift ;;
    --title|--body|--kind|--severity) _subcmd="create" ;;  # legacy: direct args → create
  esac

  # ── feedback edit ─────────────────────────────────────────
  if [[ "$_subcmd" == "edit" ]]; then
    local edit_title="" edit_body="" has_title="" has_body=""

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --raw-key) raw_key="${2:-}"; shift 2 ;;
        --title) edit_title="${2:-}"; has_title="1"; shift 2 ;;
        --body) edit_body="${2:-}"; has_body="1"; shift 2 ;;
        --help|-h) cat <<HELP; return 0
Usage: freely feedback edit --raw-key <key> [--title <text>] [--body <text>]

Edit an existing raw issue — update its title and/or body on all configured
platforms, then update the local issue.md.

Options:
  --raw-key <key>   Required. Raw issue key (e.g. 20260629T122254Z).
  --title <text>    New title for the issue.
  --body <text>     New body/description for the issue.

At least one of --title or --body must be provided.

Examples:
  freely feedback edit --raw-key 20260629T122254Z --title "feat: better approach"
  freely feedback edit --raw-key 20260629T122254Z --body "## 背景\\n\\nUpdated details..."
  freely feedback edit --raw-key 20260629T122254Z --title "fix: typo" --body "## 修复方案\\n\\n..."
HELP
          ;;
        --repo|--repo=*)
          log_error "--repo is no longer needed: repo is auto-detected from git remotes. Remove --repo and retry."
          return 1
          ;;
        --*) log_error "unknown option: $1"; return 1 ;;
        *) break ;;
      esac
    done

    [[ -n "$raw_key" ]] || { log_error "--raw-key is required for edit"; return 1; }
    [[ -n "$has_title" || -n "$has_body" ]] || {
      log_error "at least one of --title or --body must be provided"
      return 1
    }

    local_id="raw-${raw_key}"
    local _issue_file="$SELF_ROOT/docs/B1-docs/${local_id}/issue.md"

    [[ -f "$_issue_file" ]] || {
      log_error "local issue file not found: docs/B1-docs/${local_id}/issue.md"
      echo >&2 "  Use 'freely feedback --help' to create a new issue."
      echo >&2 "  Or verify the raw-key is correct."
      return 1
    }

    # Extract platform_ids and kind from local issue.md YAML frontmatter
    local _fm_data _platform_ids_json _issue_kind
    _fm_data=$(python3 -c "
import sys, json
with open('$_issue_file') as f:
    content = f.read()
parts = content.split('---\n', 2)
if len(parts) < 2:
    print(json.dumps({'error': 'no frontmatter'}))
    sys.exit(1)
import yaml
fm = yaml.safe_load(parts[1]) or {}
print(json.dumps({
    'platform_ids': fm.get('platform_ids', {}),
    'kind': fm.get('kind', 'raw')
}))
" 2>&1) || {
      log_error "failed to read issue frontmatter: $_fm_data"
      return 1
    }

    _platform_ids_json=$(echo "$_fm_data" | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin)['platform_ids']))" 2>/dev/null)
    _issue_kind=$(echo "$_fm_data" | python3 -c "import sys,json; print(json.load(sys.stdin).get('kind','raw'))" 2>/dev/null)

    [[ -n "$_platform_ids_json" && "$_platform_ids_json" != "{}" ]] || {
      log_error "no platform_ids found in local issue.md — has the issue been synced to a platform?"
      return 1
    }

    # Build platform body: preserve the original kind from the platform body.
    # The local frontmatter kind is always "raw" (document type), not the
    # workflow kind (fix/feature) recorded at create time in the platform body.
    # Editing must not change the kind unless the user explicitly asks for it.
    local _platform_body=""
    if [[ -n "$has_body" ]]; then
      local _body_kind=""
      local _gh_id
      _gh_id=$(echo "$_platform_ids_json" | python3 -c "import sys,json; print(json.load(sys.stdin).get('github',{}).get('issue_id',''))" 2>/dev/null)
      if [[ -n "$_gh_id" ]]; then
        _body_kind=$(python3 - "$_gh_id" << 'PYEOF'
import sys, re, subprocess
gh_id = sys.argv[1]
result = subprocess.run(
    ["gh", "issue", "view", gh_id, "--json", "body", "--jq", ".body"],
    capture_output=True, text=True
)
if result.returncode != 0:
    print("raw")
    sys.exit(0)
body = result.stdout
# Platform body stores frontmatter with literal \n: ---\nkind: fix\n---\n
m = re.search(r'---\\nkind:\s*(\w+)\\n---', body)
print(m.group(1) if m else "raw")
PYEOF
        2>/dev/null)
      fi
      [[ -n "$_body_kind" ]] || _body_kind="unknown"
      _platform_body="---\nkind: ${_body_kind}\n---\n\n${edit_body}"
    fi

    # Call platform-adapter to update remote issues
    local _adapter="$SELF_ROOT/docs/system/workspace/scripts/sync/platform-adapter.py"
    local _adapter_result _updated=0

    echo "[feedback] updating raw-${raw_key}..."

    _adapter_result=$(python3 "$_adapter" update-issue "$local_id" "$_platform_ids_json" "${edit_title}" "${_platform_body}" 2>&1) || {
      echo "[feedback] ERROR: platform adapter failed (rc=$?)" >&2
      echo "[feedback] $_adapter_result" >&2
      return 1
    }
    echo "[feedback] adapter output:"
    echo "$_adapter_result"

    # Check results
    if echo "$_adapter_result" | grep -q '"status": "updated"'; then
      _updated=1
    fi

    if [[ "$_updated" != "1" ]]; then
      echo "[feedback] ERROR: no platform issue updated" >&2
      return 1
    fi

    # Update local issue.md body if --body was provided
    if [[ -n "$has_body" ]]; then
      python3 - "$_issue_file" "$edit_body" <<'PYEOF'
import sys
file_path = sys.argv[1]
new_body = sys.argv[2]
with open(file_path) as f:
    content = f.read()
parts = content.split('---\n', 2)
if len(parts) >= 3:
    new_content = '---\n' + parts[1] + '---\n\n' + new_body
    with open(file_path, 'w') as f:
        f.write(new_content)
PYEOF
      echo "[feedback] local issue.md body updated"
    fi

    echo "[feedback] issue updated: raw-${raw_key}"
    printf 'raw-%s\n' "$raw_key"
    return 0
  fi

  # ── feedback help (explicit freely feedback --help) ─────
  if [[ "$_subcmd" == "help" ]]; then
    cat <<HELP
Usage: freely feedback [create] --title <text> --body <text> --kind <fix|feature> [--severity P0|P1|P2]
       freely feedback edit --raw-key <key> [--title <text>] [--body <text>]

Commands:
  create                  Create a new raw issue (default when no command is given).
  edit                    Edit an existing raw issue — update title/body on all platforms.

Create options:
  --title <text>     Required. Issue title.
  --body <text>      Required. Issue body/description.
  --kind <fix|feature>   Required. Issue kind — determines workflow and RED strategy.
                        fix:     bug 存在时按测试方法测试一定是 RED，修复正确后，用修复前一样的测试方法，结论一定是 GREEN
                        feature: 新功能、重构、优化。功能未实现时，按测试方法测试一定是 RED，实现正确后，用实现前一样的测试方法，结论一定是 GREEN
  --severity <level> Priority: P0 (critical), P1 (high), P2 (default).

Edit options:
  --raw-key <key>    Required. Raw issue key (e.g. 20260629T122254Z).
  --title <text>     New title for the issue.
  --body <text>      New body/description for the issue.
  At least one of --title or --body must be provided.

Examples:
  freely feedback --title "fix: something broken" --body "details..." --kind fix
  freely feedback create --title "feat: new capability" --body "details..." --kind feature --severity P1
  freely feedback edit --raw-key 20260629T122254Z --title "fix: corrected title"
  freely feedback edit --raw-key 20260629T122254Z --body "## 修复方案\\n\\nUpdated..."
HELP
    return 0
  fi

  # ── feedback create (existing behaviour) ──────────────────

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title) title="${2:-}"; shift 2 ;;
      --body) body="${2:-}"; shift 2 ;;
      --kind) issue_kind="${2:-}"; shift 2 ;;
      --severity) severity="${2:-}"; shift 2 ;;
      --help|-h) cat <<HELP; return 0
Usage: freely feedback [create] --title <text> --body <text> --kind <fix|feature> [--severity P0|P1|P2]
       freely feedback edit --raw-key <key> [--title <text>] [--body <text>]

Commands:
  create                  Create a new raw issue (default when no command is given).
  edit                    Edit an existing raw issue — update title/body on all platforms.

Create options:
  --title <text>     Required. Issue title.
  --body <text>      Required. Issue body/description.
  --kind <fix|feature>   Required. Issue kind — determines workflow and RED strategy.
                        fix:     bug 存在时按测试方法测试一定是 RED，修复正确后，用修复前一样的测试方法，结论一定是 GREEN
                        feature: 新功能、重构、优化。功能未实现时，按测试方法测试一定是 RED，实现正确后，用实现前一样的测试方法，结论一定是 GREEN
  --severity <level> Priority: P0 (critical), P1 (high), P2 (default).

Edit options:
  --raw-key <key>    Required. Raw issue key (e.g. 20260629T122254Z).
  --title <text>     New title for the issue.
  --body <text>      New body/description for the issue.
  At least one of --title or --body must be provided.

Examples:
  freely feedback --title "fix: something broken" --body "details..." --kind fix
  freely feedback create --title "feat: new capability" --body "details..." --kind feature --severity P1
  freely feedback edit --raw-key 20260629T122254Z --title "fix: corrected title"
  freely feedback edit --raw-key 20260629T122254Z --body "## 修复方案\\n\\nUpdated..."
HELP
        ;;
      --repo|--repo=*)
        log_error "--repo is no longer needed: repo is auto-detected from git remotes. Remove --repo and retry."
        return 1
        ;;
      --*) log_error "unknown option: $1"; return 1 ;;
      *) break ;;
    esac
  done

  [[ -n "$title" ]] || { log_error "--title is required"; return 1; }
  [[ -n "$body" ]] || { log_error "--body is required"; return 1; }
  [[ -n "$issue_kind" ]] || {
    log_error "--kind is required. Carefully analyze your issue before choosing:"
    echo >&2 ""
    echo >&2 "  --kind fix"
    echo >&2 "    Bug 可以稳定复现。已有测试能捕获，或可以手工端到端复现。"
    echo >&2 "    RED 阶段 = 复现——bug 存在时按测试方法测试一定是 RED，修复正确后，用修复前一样的测试方法，结论一定是 GREEN"
    echo >&2 "    分支: fix/raw-{key}-{slug}"
    echo >&2 ""
    echo >&2 "  --kind feature"
    echo >&2 "    新功能、重构、优化、架构改进。"
    echo >&2 "    RED 阶段 = 设计测试——功能未实现时，按测试方法测试一定是 RED，实现正确后，用实现前一样的测试方法，结论一定是 GREEN"
    echo >&2 "    分支: feature/raw-{key}-{slug}"
    echo >&2 ""
    echo >&2 "  如果 bug 修复同时需要实现紧相关的新功能 → 拆为两个 raw issue，分别 feedback。"
    echo >&2 ""
    echo >&2 "  --kind 影响: ① 分支前缀 ② RED 阶段策略（复现 vs 设计新测试）"
    echo >&2 "  仔细分析，选错了 RED 阶段的行为就不对了。"
    return 1
  }
  case "$issue_kind" in
    fix|feature) ;;
    *) log_error "--kind must be 'fix' or 'feature' (got '$issue_kind')"; return 1 ;;
  esac
  case "$severity" in
    P0|P1|P2) ;;
    *) log_error "--severity must be P0, P1, or P2"; return 1 ;;
  esac

  # ── Title format validation ─────────────────────────────────
  # 1. Type prefix: must use conventional commit type prefix
  #    fix: / feat: / docs: / refactor: / chore: / test: / build: / ci: / perf: / style:
  local _title_types="fix|feat|docs|refactor|chore|test|build|ci|perf|style"
  if ! echo "$title" | grep -qE "^(${_title_types}): "; then
    log_error "title must start with a type prefix: ${_title_types//|/, }"
    echo >&2 "  Example: 'fix: something broken'  'feat: new capability'  'docs: update guide'"
    echo >&2 "  Got: '$title'"
    return 1
  fi

  # 2. Title length: user portion ≤ 72 chars, total (with [RAW-{key}] prefix) ≤ 100 chars
  local _prefix_len=28  # "[RAW-YYYYMMDDTHHMMSSZ] " ≈ 27+1 chars
  local _user_title_len="${#title}"
  local _total_len=$(( _prefix_len + _user_title_len ))
  if [[ "$_total_len" -gt 100 ]]; then
    log_error "title too long: $_total_len chars (max 100 including [RAW-{key}] prefix)"
    echo >&2 "  User title: $_user_title_len chars. Keep it ≤ 72 chars."
    echo >&2 "  Got: '$title'"
    return 1
  fi

  # ── Body format validation ──────────────────────────────────
  # 1. Minimum content: at least 50 non-whitespace characters
  local _body_trimmed; _body_trimmed=$(echo "$body" | tr -d '[:space:]')
  if [[ "${#_body_trimmed}" -lt 50 ]]; then
    log_error "body too short (${#_body_trimmed} non-ws chars, need ≥ 50)"
    echo >&2 "  Provide enough detail: root cause, impact, fix plan."
    return 1
  fi

  # 2. Must have at least one ## section heading (Freely raw issue convention)
  if ! echo "$body" | grep -q '^## '; then
    log_error "body must contain at least one ## section heading"
    echo >&2 "  Freely raw issues use structured sections: ## 根因 / ## 影响 / ## 修复方案"
    return 1
  fi

  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  raw_key="$stamp"
  local_id="raw-${raw_key}"

  # Prepend kind to body so wt-create can read it later
  body="---\nkind: ${issue_kind}\n---\n\n${body}"

  # Platforms are auto-detected by freely start / daemon start and written to config.toml.
  # Read directly from config.toml via freely_config.py, not from env (config.env is long deprecated).
  local _platforms
  _platforms="$("$SELF_ROOT/docs/system/workspace/scripts/runtime/freely_config.py" print --project "$SELF_ROOT" 2>/dev/null | grep '^FREELY_REPO_PLATFORMS' | sed 's/^FREELY_REPO_PLATFORMS *= *//; s/"//g' || true)"
  [[ -n "$_platforms" ]] || { log_error "no platforms configured. Run 'freely start' to auto-detect from git remotes."; return 1; }

  # Delegate to platform-adapter — handles all platforms based on FREELY_REPO_PLATFORMS
  local _adapter="$SELF_ROOT/docs/system/workspace/scripts/sync/platform-adapter.py"
  local _adapter_result _created=0

  echo "[feedback] raw issue created: raw-${raw_key}"

  _adapter_result=$(python3 "$_adapter" create-issue "$local_id" "[RAW-${stamp}] ${title}" "${body}" 2>&1) || {
    echo "[feedback] ERROR: platform adapter failed (rc=$?)" >&2
    exit 1
  }
  echo "[feedback] adapter output:"
  echo "$_adapter_result"

  # Check if any platform succeeded
  if echo "$_adapter_result" | grep -q '"status": "created"'; then
    _created=1
  fi

  if [[ "$_created" != "1" ]]; then
    echo "[feedback] ERROR: no platform issue created" >&2
    exit 1
  fi

  # Check every configured platform individually: any error → exit
  for _pf in $(echo "$_platforms" | tr ',' ' '); do
    [[ -n "$_pf" ]] || continue
    if echo "$_adapter_result" | grep -q "\"$_pf\""; then
      if echo "$_adapter_result" | grep -A2 "\"$_pf\"" | grep -q '"status": "error"'; then
        echo "[feedback] ERROR: $_pf platform creation failed" >&2
        exit 1
      fi
    fi
  done

  echo "[feedback]"
  echo "[feedback] Next: create a worktree to fix or implement:"
  echo "[feedback]   wt-create --raw-key ${raw_key} --source platform --kind fix --slug <slug>"
  echo "[feedback]   wt-create --raw-key ${raw_key} --source platform --kind feature --slug <slug>"

  printf 'raw-%s\n' "$raw_key"
}

cmd_tui() {
  local project="" once="0" input=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --once) once="1"; shift ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project" 1)"
  check_doc_gate_or_fail "$project"
  bootstrap_interruption_entry_runtime_or_fail "$project"

  if [[ "$once" == "1" || ! -t 0 ]]; then
    render_tui_dashboard "$project"
    if ! tui_compose_message input; then
      exit 0
    fi
    case "$input" in
      /quit|/exit) exit 0 ;;
      /refresh|"") exit 0 ;;
    esac
    [[ -n "$input" ]] || exit 0
    tui_submit_message "$project" "$input"
    printf 'submitted: %s\n' "$input"
    exit 0
  fi

  while true; do
    render_tui_dashboard "$project"
    if ! tui_compose_message input; then
      printf '\n'
      break
    fi
    case "$input" in
      /quit|/exit) break ;;
      /refresh|"") continue ;;
      *)
        tui_submit_message "$project" "$input"
        printf 'submitted. press Enter to continue...'
        IFS= read -r _ || true
        ;;
    esac
  done
}

cmd_intake_chat() {
  local project="" message="" message_file="" author="human" channel="chat" intake_id="" target_issue="" urgent="" new_issue="" conversation="" new_conversation=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --message) message="${2:-}"; shift 2 ;;
      --message-file) message_file="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --author) author="${2:-}"; shift 2 ;;
      --channel) channel="${2:-}"; shift 2 ;;
      --issue) target_issue="${2:-}"; shift 2 ;;
      --conversation) conversation="true"; shift ;;
      --new) new_conversation="true"; shift ;;
      --urgent) urgent="true"; shift ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project" 1)"
  if [[ -n "$message_file" ]]; then
    [[ -f "$message_file" ]] || { log_error "message file not found: $message_file"; exit 1; }
    message="$(cat "$message_file")"
  fi
  [[ -n "$message" ]] || { log_error "missing --message or --message-file"; exit 1; }

  # Conversation mode validation
  if [[ "$conversation" == "true" ]]; then
    if [[ -n "$target_issue" ]]; then
      log_error "--conversation and --issue are mutually exclusive"
      exit 1
    fi
    if [[ "$new_issue" == "true" ]]; then
      log_error "--conversation and --new-issue are mutually exclusive"
      exit 1
    fi
    export FREELY_CHAT_CONVERSATION="true"
    [[ "$new_conversation" == "true" ]] && export FREELY_CHAT_NEW_CONVERSATION="true"
  fi

  # Default to --new-issue when neither --issue, --new-issue, nor --conversation is specified
  if [[ -z "$target_issue" && "$new_issue" != "true" && "$conversation" != "true" ]]; then
    new_issue="true"
  fi
  if [[ -n "$target_issue" && "$new_issue" == "true" ]]; then
    log_error "--issue and --new-issue are mutually exclusive"
    exit 1
  fi

  # Set env vars for _write_chat_to_issue
  [[ -n "$target_issue" ]] && export FREELY_CHAT_TARGET_ISSUE="$target_issue"
  [[ -n "$new_issue" ]] && export FREELY_CHAT_NEW_ISSUE="$new_issue"
  [[ -n "$urgent" ]] && export FREELY_CHAT_URGENT="$urgent"

  intake_id="$(next_intake_id "$project" "$message")"
  write_intake_item "$project" "$intake_id" "$author" "$channel" "new" "" "pending://unclassified" "" "[]" "$message"
  log_info "intake recorded: $intake_id"
  append_lifecycle_trace "$project" "L300" "intake_recorded" \
    "intake_id=$intake_id" \
    "author=$author" \
    "channel=$channel" \
    "status=new" \
    "expected_next=L310"
  echo "intake_id: $intake_id"
  echo "intake_path: $(intake_dir_for_project "$project")/$intake_id"
  [[ -n "$target_issue" ]] && echo "target_issue: $target_issue"
  [[ -n "$urgent" ]] && echo "urgent: true"
  [[ "$conversation" == "true" ]] && echo "conversation: true"
  if [[ "$new_issue" == "true" ]]; then
    echo ""
    echo "[chat] To create a raw issue from this intake:"
    echo "[chat]   1. freely feedback --help   (review usage, then create the raw issue)"
    echo "[chat]   2. wt-create --raw-key <returned-key> --source platform --skill freely-fix-execution --slug <slug>"
    echo "[chat]"
    echo "[chat] Then follow the skill to complete the work:"
    echo "[chat]   skill:freely-fix-execution  — Fix first, govern later"
    echo "[chat]   skill:freely-feature-execution — Govern first, then code"
  fi
}

