pid_matches_project() {
  local pid="$1" project="$2" expected="$3"
  local cmd cwd candidate_paths candidate
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  if process_inspection_available; then
    cmd="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    if [[ -n "$cmd" ]]; then
      # Pattern check is advisory: exec -a names may not appear in ps output
      # on some platforms (macOS). The authoritative check is --project path match.
      if [[ -n "$expected" ]] && [[ "$cmd" == *"$expected"* ]]; then
        return 0
      fi
      candidate_paths="$(awk '
        {
          for (i = 1; i <= NF; i++) {
            if (($i == "--project" || $i == "-C") && (i + 1) <= NF) {
              print $(i + 1)
            }
            if (index($i, "--project=") == 1) {
              print substr($i, 11)
            }
          }
        }
      ' <<<"$cmd")"
      while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue
        if project_paths_equivalent "$candidate" "$project"; then
          return 0
        fi
      done <<<"$candidate_paths"
    fi
  fi
  cwd="$(lsof -a -d cwd -p "$pid" -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1)"
  if project_paths_equivalent "$cwd" "$project"; then
    return 0
  fi
  return 1
}

runtime_source_project_from_command() {
  local cmd="$1" token
  [[ -n "$cmd" ]] || return 0
  while IFS= read -r token; do
    [[ -n "$token" ]] || continue
    case "$token" in
      */docs/system/workspace/scripts/runtime/freely)
        printf '%s\n' "${token%/docs/system/workspace/scripts/runtime/freely}"
        return 0
        ;;
      */bin/freely)
        printf '%s\n' "${token%/bin/freely}"
        return 0
        ;;
    esac
  done < <(awk '{ for (i = 1; i <= NF; i++) print $i }' <<<"$cmd")
  return 0
}

