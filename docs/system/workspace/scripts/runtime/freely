      return 1
    fi
  fi
  if manager_continuity_cleanup_retirement_targets "$continuity_file" | grep -q .; then
    return 0
  fi
  if [[ -n "$continuity_project" ]] \
    && manager_cleanup_prompt_primary_target_row_from_continuity "$continuity_project" "$continuity_file" >/dev/null 2>&1; then
    if latest_manager_worker_prompt_paths_from_continuity "$continuity_file" | grep -q .; then
