cmd_status() {
  local project="" view="all"
  local -a forwarded=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --view) view="${2:-}"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  case "$view" in
    baseline|live|fleet|all) ;;
    *)
      log_error "unsupported --view: $view (supported: baseline, live, fleet, all)"
      exit 1
      ;;
  esac
  if [[ -n "$project" ]]; then
    forwarded+=(--project "$project")
  fi
  case "$view" in
    baseline)
      if ((${#forwarded[@]})); then
        cmd_baseline_status "${forwarded[@]}"
      else
        cmd_baseline_status
      fi
      ;;
    live)
      if ((${#forwarded[@]})); then
        cmd_live_status "${forwarded[@]}"
      else
        cmd_live_status
      fi
      ;;
    fleet)
      if ((${#forwarded[@]})); then
        cmd_fleet_status "${forwarded[@]}"
      else
        cmd_fleet_status
      fi
      ;;
    all)
      echo "== baseline =="
      if ((${#forwarded[@]})); then
        cmd_baseline_status "${forwarded[@]}"
      else
        cmd_baseline_status
      fi
      echo
      echo "== live =="
      if ((${#forwarded[@]})); then
        cmd_live_status "${forwarded[@]}"
      else
        cmd_live_status
      fi
      echo
      echo "== fleet =="
      if ((${#forwarded[@]})); then
        cmd_fleet_status "${forwarded[@]}"
      else
        cmd_fleet_status
      fi
      ;;
  esac
}

sleep_with_rate_limit_recheck() {
  local project="$1" total_sleep="$2" active_probe_mode="${3:-0}"
  local remaining chunk stop_file recheck_interval workable_slot
  remaining="${total_sleep:-0}"
  stop_file="$(stop_marker_file "$project")"
  [[ "$remaining" =~ ^[0-9]+$ ]] || remaining=0
  recheck_interval="${WATCHDOG_RECHECK_INTERVAL_SECS:-60}"
  [[ "$recheck_interval" =~ ^[0-9]+$ ]] || recheck_interval=60
  (( recheck_interval > 0 )) || recheck_interval=60
  while (( remaining > 0 )); do
    if [[ -f "$stop_file" ]]; then
      return 0
    fi
    if [[ "$AI_TOOL" == "codex" && "$active_probe_mode" == "1" ]]; then
      workable_slot="$(probe_any_usable_codex_slot_now "$project" || true)"
      if [[ -n "$workable_slot" ]]; then
        return 0
      fi
    fi
    chunk="$recheck_interval"
    if (( remaining < chunk )); then
      chunk="$remaining"
    fi
    sleep "$chunk"
    remaining=$((remaining - chunk))
  done
}

cmd_fleet_status() {
  local project="" repo_root entries wt_path wt_branch wt_state cfg run_dir session_state supervisor_pid ai_pid last_launch last_dirty checkpoint_json checkpoint_required restart_signal_reason restart_signal_at restart_summary semantic_loop_summary semantic_loop_signal ownership_conflict_summary manager_pending_ownership_conflicts role_hint
  local develop_push_snapshot develop_push_state develop_push_summary prompt_file prompt_intent_kind prompt_intent_target manager_generated_intents manager_consumed_intents
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project")"
  repo_root="$(git -C "$project" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$repo_root" ]] || { log_error "not a git repo: $project"; exit 1; }
  entries="$(git -C "$repo_root" worktree list --porcelain 2>/dev/null || true)"
  [[ -n "$entries" ]] || { log_error "no worktrees found for: $repo_root"; exit 1; }

  printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "branch" "tree" "sup" "ai" "dirty" "checkpoint" "path"
  printf "%s\n" "------------------------------------------------------------------------------------------------"
  while IFS='|' read -r wt_path wt_branch; do
    [[ -n "$wt_path" ]] || continue
    if [[ -n "$(git -C "$wt_path" status --porcelain 2>/dev/null)" ]]; then
      wt_state="DIRTY"
    else
      wt_state="CLEAN"
    fi
    cfg="$(config_file "$wt_path")"
    supervisor_pid="none"
    ai_pid="none"
    last_launch="-"
    last_dirty="-"
    checkpoint_required="false"
    prompt_intent_kind="none"
    prompt_intent_target="none"
    ownership_holder_status="none"
    manager_generated_intents="none"
    manager_consumed_intents="none"
    restart_signal_reason="-"
    restart_signal_at="-"
    restart_summary="-"
    semantic_loop_summary="-"
    ownership_conflict_summary="none"
    manager_pending_ownership_conflicts="none"
    role_hint="unknown"
    if [[ -f "$cfg" ]]; then
      run_dir="$(run_dir_for_project "$wt_path")"
      session_state="$(session_state_file "$wt_path")"
      role_hint="$(role_hint_for_project "$wt_path")"
      if [[ -f "$(manager_worker_launch_state_file "$wt_path")" ]]; then
        manager_worker_launch_state_refresh_for_status "$wt_path" >/dev/null 2>&1 || true
      fi
      if [[ -f "$run_dir/supervisor.pid" ]]; then
        supervisor_pid="$(cat "$run_dir/supervisor.pid" 2>/dev/null || echo none)"
        if ! valid_supervisor_pid_for_project "$wt_path" "$supervisor_pid"; then
          supervisor_pid="none"
        fi
      fi
      if [[ -f "$run_dir/ai.pid" ]]; then
        ai_pid="$(cat "$run_dir/ai.pid" 2>/dev/null || echo none)"
        if ! valid_ai_pid_for_project "$wt_path" "$ai_pid"; then
          ai_pid="none"
        fi
      fi
      if [[ -f "$session_state" ]]; then
        # shellcheck disable=SC1090
        source "$session_state"
        last_launch="${LAST_LAUNCH_KIND:--}"
        last_dirty="${LAST_PROJECT_DIRTY_ENTRIES:-0}"
        restart_signal_reason="${LAST_RESTART_STORM_SIGNAL_REASON:--}"
        restart_signal_at="${LAST_RESTART_STORM_SIGNAL_AT:--}"
        restart_summary="storm=${restart_signal_reason} window=${LAST_RESTART_STORM_WINDOW_SECS:-0}s count=${LAST_RESTART_STORM_COUNT:-0} peak=${LAST_PROCESS_CHURN_PEAK:-0}"
      fi
      semantic_loop_signal="$(manager_semantic_loop_signal_snapshot_for_project "$wt_path" 2>/dev/null || true)"
      if [[ -n "$semantic_loop_signal" ]]; then
        local semantic_loop_reason semantic_loop_repeat_count
        IFS='|' read -r semantic_loop_reason semantic_loop_repeat_count _ _ <<<"$semantic_loop_signal"
        semantic_loop_summary="loop=${semantic_loop_reason} repeats=${semantic_loop_repeat_count:-0}"
      fi
      develop_push_snapshot="$(develop_push_followthrough_snapshot_for_project "$wt_path")"
      IFS='|' read -r develop_push_state develop_push_summary _ _ _ _ _ <<<"$develop_push_snapshot"
      prompt_file="$(find_latest_prompt_file_for_project "$wt_path")"
      if [[ -n "$prompt_file" && -f "$prompt_file" ]]; then
        prompt_intent_kind="$(worker_prompt_normalized_intent_kind "$prompt_file")"
        prompt_intent_target="$(worker_prompt_effective_intent_target "$wt_path" "$prompt_file")"
        if worker_project_is_actively_running "$wt_path"; then
          ownership_holder_status="active"
        elif [[ "$role_hint" == "worker" ]] && [[ -n "$(project_current_blocking_intent_signature "$wt_path")" ]]; then
          ownership_holder_status="$(recorded_worker_ownership_status "$wt_path")"
        fi
      fi
      if [[ -f "$(manager_worker_launch_state_file "$wt_path")" ]]; then
        # shellcheck disable=SC1090
        source "$(manager_worker_launch_state_file "$wt_path")"
        manager_generated_intents="$(worker_prompt_intent_summary_csv "$wt_path" "${LAST_MANAGER_WORKER_PROMPTS_GENERATED:-none}")"
        manager_consumed_intents="$(worker_prompt_intent_summary_csv "$wt_path" "${LAST_MANAGER_WORKER_PROMPTS_CONSUMED:-none}")"
        if [[ "$role_hint" == "manager" ]]; then
          manager_pending_ownership_conflicts="$(manager_pending_ownership_conflicts_summary "$wt_path" "$(latest_generated_manager_continuity_file_for_project "$wt_path")" "${QUEUED_WORKER_PROMPTS:-none}")"
        fi
      fi
      ownership_conflict_summary="$(project_active_ownership_conflict_summary "$wt_path")"
      [[ -n "$ownership_conflict_summary" ]] || ownership_conflict_summary="none"
    else
      develop_push_state="not_applicable"
      develop_push_summary="config_missing"
    fi
    checkpoint_json="$(checkpoint_guard_json_for_project "$wt_path")"
    checkpoint_required="$(checkpoint_guard_value "$checkpoint_json" checkpoint_required)"
    printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "$wt_branch" "$wt_state" "$supervisor_pid" "$ai_pid" "$last_dirty" "${checkpoint_required:-false}" "$wt_path"
    if [[ "$prompt_intent_kind" != "unknown" && "$prompt_intent_kind" != "none" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "intent" "" "${prompt_intent_kind}@${prompt_intent_target}"
    fi
    if [[ "$ownership_holder_status" != "none" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "ownership_holder" "" "${ownership_holder_status}"
    fi
    if [[ "$manager_generated_intents" != "none" || "$manager_consumed_intents" != "none" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "manager_intent" "" "generated=${manager_generated_intents} consumed=${manager_consumed_intents}"
    fi
    if [[ "$manager_pending_ownership_conflicts" != "none" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "manager_pending_conflict" "" "${manager_pending_ownership_conflicts}"
    fi
    if [[ "$ownership_conflict_summary" != "none" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "ownership_conflict" "" "${ownership_conflict_summary}"
    fi
    if [[ "$last_launch" != "-" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "launch=$last_launch" "" ""
    fi
    if [[ "$restart_signal_at" != "-" && -n "$restart_signal_at" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "$restart_signal_reason" "" "$restart_summary"
    fi
    if [[ "$semantic_loop_summary" != "-" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "semantic_loop" "" "$semantic_loop_summary"
    fi
    if [[ "$develop_push_state" != "not_applicable" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "develop_push" "" "${develop_push_state} ${develop_push_summary}"
    fi
  done < <(printf '%s\n' "$entries" | awk '
    BEGIN { wt=""; br="(detached)" }
    /^worktree / { wt=substr($0, 10); br="(detached)" }
    /^branch / { br=$2; sub(/^refs\/heads\//, "", br) }
    /^$/ { if (wt != "") { print wt "|" br; wt=""; br="(detached)" } }
    END { if (wt != "") print wt "|" br }
  ')
}

cmd_develop_push() {
  local subcmd="${1:-}"
  [[ -n "$subcmd" ]] || { log_error "missing develop-push subcommand"; usage; exit 1; }
  shift || true

  local project="" reason="" note=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --reason) reason="${2:-}"; shift 2 ;;
      --note) note="${2:-}"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project")"

  case "$subcmd" in
    status)
      local snapshot state summary upstream ahead behind defer_reason defer_updated_at
      snapshot="$(develop_push_followthrough_snapshot_for_project "$project")"
      IFS='|' read -r state summary upstream ahead behind defer_reason defer_updated_at <<<"$snapshot"
      echo "project: $project"
      echo "develop_push_followthrough_state: $state"
      echo "develop_push_followthrough_summary: $summary"
      echo "develop_push_followthrough_upstream: $upstream"
      echo "develop_push_followthrough_ahead: $ahead"
      echo "develop_push_followthrough_behind: $behind"
      echo "develop_push_followthrough_defer_reason: $defer_reason"
      echo "develop_push_followthrough_defer_updated_at: $(format_timestamp_local_for_display "$defer_updated_at")"
      ;;
    defer)
      if ! develop_push_defer_reason_is_valid "$reason"; then
        log_error "unsupported --reason: ${reason:-<empty>}"
        log_error "supported reasons: post_merge_acceptance cleanup_followthrough remote_delivery_hold"
        exit 1
      fi
      write_develop_push_followthrough_state "$project" "$reason" "$note"
      echo "project: $project"
      echo "defer_reason: $reason"
      echo "defer_note: ${note:-none}"
      echo "state_file: $(develop_push_followthrough_state_file "$project")"
      ;;
    clear)
      clear_develop_push_followthrough_state "$project"
      echo "project: $project"
      echo "state_file: $(develop_push_followthrough_state_file "$project")"
      echo "status: cleared"
      ;;
    *)
      log_error "unknown develop-push subcommand: $subcmd"
      usage
      exit 1
      ;;
  esac
}

cmd_stop() {
  local project=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project")"
  stop_project_runtime "$project" "operator_stop"
  log_info "stopped (if running)"
}

main() {
  local cmd="${1:-}"
  [[ -n "$cmd" ]] || { usage; exit 1; }
  shift || true
  case "$cmd" in
    init) cmd_init "$@" ;;
    set-tool) cmd_set_tool "$@" ;;
    sync-tooling) cmd_sync_tooling "$@" ;;
    doctor) cmd_doctor "$@" ;;
    security-review-brief) cmd_security_review_brief "$@" ;;
    chat) cmd_chat "$@" ;;
    tui) cmd_tui "$@" ;;
    intake)
      local subcmd="${1:-}"
      shift || true
      case "$subcmd" in
        chat) cmd_intake_chat "$@" ;;
        claim) cmd_intake_claim "$@" ;;
        resolve) cmd_intake_resolve "$@" ;;
        status) cmd_intake_status "$@" ;;
        *) log_error "unknown intake subcommand: $subcmd"; usage; exit 1 ;;
      esac
      ;;
    ensure-manager) cmd_ensure_manager "$@" ;;
    auth-change-wake) cmd_auth_change_wake "$@" ;;
    ensure-interruption-dispatch) cmd_ensure_interruption_dispatch "$@" ;;
    start) cmd_start "$@" ;;
    restart) cmd_restart "$@" ;;
    restore-work) cmd_restore_work "$@" ;;
    baseline-status) cmd_baseline_status "$@" ;;
    security-review-brief) cmd_security_review_brief "$@" ;;
    status) cmd_status "$@" ;;
    live-status) cmd_live_status "$@" ;;
    fleet-status) cmd_fleet_status "$@" ;;
    develop-push) cmd_develop_push "$@" ;;
    stop) cmd_stop "$@" ;;
    *) log_error "unknown command: $cmd"; usage; exit 1 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
