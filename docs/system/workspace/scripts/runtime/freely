# parse_a2a_task_json_reply: extract A2A Task state from AI cycle.
# Primary path (post-A2A refactoring): read state from A2A Task created by a2a-exit tool.
# Fallback: parse ```json block from AI reply text.
# Returns: "ok:<exit_kind>" on success, "repair:<errors_json>" on failure.
parse_a2a_task_json_reply() {
  local project="$1" cycle_log="$2" role="$3" raw_key="$4"
  local _a2a_task_py _db_path _reply_text _result _action _exit_kind
  _a2a_task_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/a2a_task.py"
  _db_path="$project/.freely/freely.db"
  [[ -f "$_a2a_task_py" && -f "$_db_path" ]] || { printf 'repair:["a2a_task_py_or_db_missing"]\n'; return 1; }

  # ── Primary path: read A2A state from DB (single source of truth) ──
  if [[ "$role" == "manager" ]]; then
    _result=$(python3 "$_a2a_task_py" latest-manager 2>/dev/null || true)
  else
    _result=$(python3 "$_a2a_task_py" list --role worker --status completed 2>/dev/null | python3 -c "import json,sys; data=json.load(sys.stdin); rows=data.get('rows',[]); print(json.dumps(rows[0]) if rows else '{}')" 2>/dev/null || echo "{}")
  fi
  _action=$(echo "$_result" | python3 -c "import json,sys; r=json.load(sys.stdin); print(r.get('state',''))" 2>/dev/null || echo "")
  if [[ -n "$_action" && "$_action" != "null" ]]; then
    # Found A2A state from tool call — translate to exit_kind and return
    case "$_action" in
      submitted)
        # A2A-native: Manager creates individual worker tasks via a2a-exit --role worker.
        # Check for rotting: submitted + no workers + 30s grace period → resume_manager.
        local _w_count _task_ts _now _age
        _w_count=$(python3 "$_a2a_task_py" list --role worker --status pending 2>/dev/null | python3 -c "import json,sys; data=json.load(sys.stdin); print(len(data.get('rows',[])))" 2>/dev/null || echo "0")
        _task_ts=$(echo "$_result" | python3 -c "import json,sys; r=json.load(sys.stdin); print(r.get('updated_at',''))" 2>/dev/null || echo "")
        _now=$(date +%s)
        if [[ -n "$_task_ts" ]]; then
          _age=$(( _now - _task_ts ))
        else
          _age=0
        fi
        if [[ "${_w_count:-0}" -eq 0 && ${_age:-0} -gt 30 ]]; then
          # Rotting: submitted with no workers after 30s grace — resume manager
          _exit_kind="resume_manager"
        else
          # Normal: workers delegated or still within grace period
          _exit_kind="delegate_workers"
        fi ;;
      completed)
        if [[ "$role" == "worker" ]]; then _exit_kind="worker_done"
        else _exit_kind="resume_manager"; fi ;;
      failed)   _exit_kind="stop_ai" ;;
      working)
        if [[ "$role" == "worker" ]]; then _exit_kind="worker_working"
        else _exit_kind="manager_working"; fi ;;
      input-required|pending-input)
        if [[ "$role" == "worker" ]]; then _exit_kind="worker_blocked"
        else _exit_kind="resume_manager"; fi ;;
      *)        _exit_kind="resume_manager" ;;
    esac
    append_runtime_event "$project" "a2a_exit_tool_state_read" "state=$_action" "exit_kind=$_exit_kind"
    printf 'ok:%s\n' "$_exit_kind"
    return 0
  fi

  # ── Text parsing fallback REMOVED (Phase 3) — a2a-exit is the only path ──
  printf 'repair:["no_a2a_exit_called"]\n'
  return 1
}

manager_exit_contract_kind() {
  local project="$1" _a2a_task_py _db_path
  _a2a_task_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/a2a_task.py"
  _db_path=""$project/.freely/freely.db""
  if [[ -f "$_a2a_task_py" && -f "$_db_path" ]]; then
    local pending_workers
    pending_workers=$(python3 "$_a2a_task_py" list --role worker --status pending 2>/dev/null | python3 -c "import json,sys; data=json.load(sys.stdin); print(len(data.get('rows',[])))" 2>/dev/null || echo "0")
    if [[ "${pending_workers:-0}" -gt 0 ]]; then
      echo "delegate_workers"
      return 0
    fi
    # PR #2914 removed --workers from a2a-exit; worker_prompts_csv is
    # always empty. Worker delegation is now detected via tasks/list
    # --status pending above. Fall through to exit_kind.
    local latest_mgr
    latest_mgr=$(python3 "$_a2a_task_py" latest-manager 2>/dev/null | python3 -c "import json,sys; r=json.load(sys.stdin); print(r.get('exit_kind',''))" 2>/dev/null || true)
    if [[ -n "$latest_mgr" ]]; then
      echo "$latest_mgr"
      return 0
    fi
  fi
  # ── Step 4: Filesystem fallback (after_run safety net) — [DEPRECATED] ──
  # Deprecated after SSE full implementation. SSE provides real-time Worker
  # status notification via stream_task/resubscribe. This filesystem fallback
  # remains as a safety net for the transition period. Will be removed in a
  # future cleanup issue after SSE has been stable in production.
  # If A2A has no record (AI forgot a2a-exit, crashed, or timed out),
  # scan worker-prompts/ for files created during this AI cycle.
  # The filesystem IS the event bus: prompt file creation = delegation.
  # This guarantees the runtime always detects new worker prompts
  # regardless of AI behavior — equivalent to Routa's after_run hook.
  local _prompts_dir="$project/.freely/run/worker-prompts"
  local _prompt_file_ref _new_prompts_csv=""
  _prompt_file_ref="$(latest_prompt_file_for_project "$project" 2>/dev/null || true)"
  if [[ -d "$_prompts_dir" && -n "$_prompt_file_ref" && -f "$_prompt_file_ref" ]]; then
    local _cycle_start _new_count=0
    _cycle_start=$(stat -f %m "$_prompt_file_ref" 2>/dev/null || stat -c %Y "$_prompt_file_ref" 2>/dev/null || echo "0")
    if [[ "$_cycle_start" =~ ^[0-9]+$ && "$_cycle_start" -gt 0 ]]; then
      while IFS= read -r _pf; do
        [[ -n "$_pf" && -f "$_pf" ]] || continue
        local _pf_mtime
        _pf_mtime=$(stat -f %m "$_pf" 2>/dev/null || stat -c %Y "$_pf" 2>/dev/null || echo "0")
        if [[ "$_pf_mtime" =~ ^[0-9]+$ && "$_pf_mtime" -ge "$_cycle_start" ]]; then
          if [[ -z "$_new_prompts_csv" ]]; then
            _new_prompts_csv="$_pf"
          else
            _new_prompts_csv="$_new_prompts_csv,$_pf"
          fi
          ((_new_count++))
        fi
      done < <(find "$_prompts_dir" -maxdepth 1 -type f -name '*.txt' 2>/dev/null | sort)
    fi
    if [[ -n "$_new_prompts_csv" ]]; then
      log_info "[DEPRECATED] filesystem_fallback triggered for project $project (new_count=${_new_count}) — SSE should handle this"
      append_runtime_event "$project" "manager_exit_contract_filesystem_fallback" \
        "worker_prompts_csv=${_new_prompts_csv}" \
        "new_count=${_new_count}" \
        "deprecated=true"
      echo "delegate_workers"
      return 0
    fi
  fi
  return 1
}

