    fi
    if [[ "$route_only_handoff" == "1" ]]; then
      ROUTE_ONLY_STREAK_CURRENT=$((ROUTE_ONLY_STREAK_CURRENT + 1))
    else
      ROUTE_ONLY_STREAK_CURRENT=0
    fi
    network_failure_reason=""
    live_failure_reason=""
    live_network_failure_reason=""
    live_bridge_lost_reason=""
    if [[ -f "$network_failure_marker_file" ]]; then
      live_network_failure_reason="$(tr -d '\r' <"$network_failure_marker_file" | awk 'NF { print; exit }' || true)"
      rm -f "$network_failure_marker_file"
    fi
    if [[ -f "$failure_marker_file" ]]; then
      live_failure_reason="$(tr -d '\r' <"$failure_marker_file" | awk 'NF { print; exit }' || true)"
      rm -f "$failure_marker_file"
    fi
    if [[ -f "$bridge_lost_marker_file" ]]; then
      live_bridge_lost_reason="$(tr -d '\r' <"$bridge_lost_marker_file" | awk 'NF { print; exit }' || true)"
      rm -f "$bridge_lost_marker_file"
    fi
    if [[ -n "$live_network_failure_reason" ]]; then
      network_failure_reason="$(runtime_network_failure_reason_from_log "$PROJECT_ROOT" "$cycle_log" || true)"
    fi
    if [[ -n "$live_failure_reason" ]]; then
      slot_switch_reason="$live_failure_reason"
    fi
    # bridge_session_lost is handled at session-store level (mark failed → fresh next launch).
	    # ── Layer 1: Universal failure detection (all tools) ──
	    # Network failures, idle timeouts, and quota exhaustion affect ALL tools.
	    # This runs BEFORE tool-specific checks so new tools get protection by default.
	    if [[ -z "$slot_switch_reason" ]]; then
	      if log_has_ai_quota_exhausted "$cycle_log"; then
	        slot_switch_reason="ai_quota_exhausted"
	      elif _acp_bridge_has_fatal_error "$PROJECT_ROOT" || log_has_execution_network_failure "$cycle_log"; then
	        slot_switch_reason="network_failure"
	      fi
	      if [[ -n "$slot_switch_reason" ]]; then
	        LAST_SLOT_SWITCH_REASON="$slot_switch_reason"
	        LAST_SLOT_SWITCH_AT="$(current_timestamp_utc_for_machine)"
	      fi
	    fi
	    # ── Layer 2: Tool-specific failure detection ──

    # No slot switch needed — the tool itself is healthy, just the session is gone.
    if [[ "$AGENT_AI_TOOL" == "codex" || "$AGENT_AI_TOOL" == codex-* ]]; then
      rate_limit_reason="$(runtime_capture_or_empty codex_rate_limit_reason_from_usage "${primary_rate_limit_used_percent:-}" "${secondary_rate_limit_used_percent:-}")"
      rate_limit_reset_at="$(runtime_capture_or_empty codex_rate_limit_reset_at_for_reason "${rate_limit_reason:-}" "${primary_rate_limit_resets_at:-}" "${secondary_rate_limit_resets_at:-}")"
      if [[ -n "$slot_switch_reason" ]]; then
        :
      elif [[ -n "$rate_limit_reason" ]]; then
        slot_switch_reason="$rate_limit_reason"
        codex_record_slot_cooldown "$PROJECT_ROOT" "$active_cooldown_identity" "${rate_limit_reset_at:-}"
      elif log_has_codex_usage_limit "$cycle_log" || log_has_acp_usage_limit "$PROJECT_ROOT"; then
        slot_switch_reason="primary_rate_limit_exhausted"
        rate_limit_reset_at="$(log_codex_rate_limit_reset_at "$cycle_log" || log_acp_rate_limit_reset_at "$PROJECT_ROOT" || true)"
        codex_record_slot_cooldown "$PROJECT_ROOT" "$active_cooldown_identity" "${rate_limit_reset_at:-}"
      elif log_has_auth_failure "$cycle_log"; then
        slot_switch_reason="auth_failure"
      fi
      if [[ -n "$slot_switch_reason" ]]; then
        LAST_SLOT_SWITCH_REASON="$slot_switch_reason"
        LAST_SLOT_SWITCH_AT="$(current_timestamp_utc_for_machine)"
      fi
    elif [[ "$AGENT_AI_TOOL" == "kiro-cli" && -z "$slot_switch_reason" ]]; then
      slot_switch_reason="$(kiro_availability_reason_from_log "$cycle_log" || true)"
      if [[ -n "$slot_switch_reason" ]]; then
        LAST_SLOT_SWITCH_REASON="$slot_switch_reason"
        LAST_SLOT_SWITCH_AT="$(current_timestamp_utc_for_machine)"
      fi
    fi
    # Tool-agnostic: if AI exited non-zero with little cycle output, the tool
    # MAY be unproductive.  But first check the debug log: if the AI was making
    # tool calls, it WAS working — it just didn't finish (e.g. ACP timeout).
    # A small cycle log with active tool calls means the tool is healthy.
    local _tool_was_active=""
    cycle_debug_log="${cycle_log%.log}.debug.log"
    if [[ -f "$cycle_debug_log" ]]; then
      if grep -qE '\[ACP tool_call\]' "$cycle_debug_log" 2>/dev/null; then
        _tool_was_active="1"
      fi
    fi
    if [[ -z "$slot_switch_reason" && "${rc:-0}" != "0" && "$_tool_was_active" != "1" ]]; then
      local _cycle_size; _cycle_size=$(wc -c < "$cycle_log" 2>/dev/null || echo 0)
      if [[ ! -f "$cycle_log" || "$_cycle_size" -lt 200 ]]; then
        slot_switch_reason="tool_unproductive"
      elif [[ "$_cycle_size" -lt 500 ]]; then
        if ! grep -qE 'exit_kind|handoff|scan_summary|worker_prompts|delegate|next_action|completion_summary' "$cycle_log" 2>/dev/null; then
          slot_switch_reason="tool_unproductive"
        fi
      fi
    fi
    if [[ -z "$network_failure_reason" && -z "$slot_switch_reason" && -z "$rate_limit_reason" ]]; then
      network_failure_reason="$(runtime_network_failure_reason_from_log "$PROJECT_ROOT" "$cycle_log" || true)"
    else
      clear_execution_network_state "$PROJECT_ROOT"
    fi
    if [[ -n "$slot_switch_reason" ]]; then
      record_tool_unavailability_from_failure "$PROJECT_ROOT" "$AGENT_AI_TOOL" "$slot_switch_reason" "$cycle_log"
    fi
    if [[ -z "$slot_switch_reason" && -z "$network_failure_reason" ]]; then
      runtime_auto_recovery_reset_attempted_tools
    fi
    if [[ -n "$slot_switch_reason" || -n "$network_failure_reason" ]]; then
      emit_runtime_failure_guidance "$PROJECT_ROOT" "$AGENT_AI_TOOL" "$slot_switch_reason" "$network_failure_reason" "$cycle_log"
    fi

    local restart_signal_reason active_process_count now_epoch observe_delay restart_window_stats restart_window_count restart_window_peak
    restart_signal_reason=""
    active_process_count="$(runtime_active_process_count_for_project "$PROJECT_ROOT")"
    now_epoch="$(date +%s)"
    update_restart_storm_window "$PROJECT_ROOT" "$now_epoch" "${active_process_count:-0}"
    restart_window_stats="$(restart_storm_window_stats "$PROJECT_ROOT")"
    restart_window_count="${restart_window_stats%%|*}"
    restart_window_peak="${restart_window_stats##*|}"
    if restart_storm_signal_reason_for_window "${restart_window_count:-0}" "${restart_window_peak:-0}" >/dev/null 2>&1; then
      restart_signal_reason="$(runtime_capture_or_empty restart_storm_signal_reason_for_window "${restart_window_count:-0}" "${restart_window_peak:-0}")"
      record_restart_storm_signal "$PROJECT_ROOT" "$restart_signal_reason" "${restart_window_count:-0}" "${restart_window_peak:-0}"
    fi

    # Mark first ACP launch done → subsequent cycles use prompt mode for multi-turn delta.
    # Persisted via write_session_state below so it survives across loop iterations.
    FREELY_ACP_FIRST_LAUNCH_DONE=1

    write_session_state "$project" "$LAST_TOOL_SESSION_ID" "$LAST_TOOL_RESUME_TARGET" "$LAST_TOOL_JSONL_PATH" "$LAST_LAUNCH_KIND" "$LAST_ROTATION_REASON" "$LAST_CYCLE_LOG" "$prompt_file" "$LAST_CONTEXT_COMPACTED" "$LAST_CONTEXT_RATIO" "$LAST_PRIMARY_RATE_LIMIT_USED_PERCENT" "$LAST_PRIMARY_RATE_LIMIT_RESETS_AT" "$LAST_SECONDARY_RATE_LIMIT_USED_PERCENT" "$LAST_SECONDARY_RATE_LIMIT_RESETS_AT" "$LAST_ROUTE_ONLY_HANDOFF" "$ROUTE_ONLY_STREAK_CURRENT" "$RESUME_STREAK_CURRENT" "$(runtime_capture_or_empty runtime_read_tool_current_slot "$project" "$AGENT_AI_TOOL")" "$LAST_SLOT_SWITCH_REASON" "$LAST_SLOT_SWITCH_AT" "$LAST_CYCLE_DEBUG_LOG" "$LAST_CLAUDE_JSONL_PATH" "$LAST_CODEX_MCP_USED" "$LAST_CODEX_MCP_THREAD_ID" "$LAST_CODEX_MCP_JSONL_PATH" "${TOOL_SESSION_ID_CURRENT:-}" "${TOOL_SESSION_ID_PREVIOUS:-}" "$LAST_PROJECT_DIRTY_ENTRIES" "$LAST_WORKTREE_SUMMARY_TOTAL" "$LAST_WORKTREE_SUMMARY_DIRTY" "$CHECKPOINT_DRIFT_STREAK_CURRENT" "$LAST_DELEGATED_CONTINUATION_PENDING_IDS" "$LAST_DELEGATED_CONTINUATION_PENDING_COUNT" "$LAST_DELEGATED_CONTINUATION_CONSUMED_IDS" "$LAST_DELEGATED_CONTINUATION_CONSUMED_AT" "${LAST_RESTART_STORM_WINDOW_SECS:-0}" "${LAST_RESTART_STORM_COUNT:-0}" "${LAST_PROCESS_CHURN_PEAK:-0}" "${LAST_RESTART_STORM_SIGNAL_AT:-}" "${LAST_RESTART_STORM_SIGNAL_REASON:-}" "${LAST_RESTART_STORM_ESCALATED_AT:-}" "${LAST_RESTART_STORM_ESCALATION_TARGET:-}" "${AUTO_RECOVERY_ATTEMPTED_TOOLS_CSV:-}" "${AUTO_RECOVERY_ORIGIN_TOOL:-}" "${SESSION_PARENT_ID:-}"
    # Normalize rc=1 to 0 when the debug log shows a clean SessionEnd completion.
    # Claude Code -p mode may exit 1 even when the session ended gracefully (SessionEnd:other).
    if [[ "${rc:-0}" != "0" && -f "$cycle_debug_log" ]]; then
      if grep -q 'SessionEnd:.*completed with status 0' "$cycle_debug_log" 2>/dev/null; then
        rc=0
        log_info "normalized rc=1→0: clean SessionEnd detected in debug log"
      fi
    fi
    # Normalize rc=1→0: end_turn received before disconnect (Broken pipe tolerance)
    local _end_turn_detected=0
    if [[ "${rc:-0}" != "0" && -f "$cycle_log" ]]; then
      if grep -q 'stop_reason=end_turn' "$cycle_log" 2>/dev/null; then
        rc=0
        _end_turn_detected=1
        log_info "normalized rc=1→0: end_turn received before disconnect"
      fi
    fi
    LAST_WORKCELL_EXIT_REASON="${slot_switch_reason:-${rate_limit_reason:-${network_failure_reason:-ai_exit_rc_${rc}}}}"
    write_workcell_state "$project" "running" "up" "down" "$LAST_WORKCELL_EXIT_REASON"
    materialize_blocked_supervision_truth_if_needed "$PROJECT_ROOT" "$prompt_file" "$LAST_WORKCELL_EXIT_REASON" "$cycle_log"
    append_runtime_event "$project" "ai_cycle_finished" \
      "supervisor_pid=$$" \
      "tool=$AGENT_AI_TOOL" \
      "launch_kind=$mode_name" \
      "rotation_reason=${LAUNCH_ROTATION_REASON:-none}" \
      "rc=$rc" \
      "child_pid=${child_pid:-unknown}" \
      "session_id=${tool_session_id:-unavailable}" \
      "resume_target=${tool_resume_target:-unavailable}" \
      "jsonl_path=${tool_jsonl_path:-unavailable}" \
      "cycle_log=$cycle_log" \
      "context_compacted=$context_compacted" \
      "context_ratio=${context_ratio:-unavailable}" \
      "route_only_handoff=$route_only_handoff" \
      "slot_switch_reason=${slot_switch_reason:-none}" \
      "rate_limit_reason=${rate_limit_reason:-none}" \
      "network_failure_reason=${network_failure_reason:-none}" \
      "exit_reason=$LAST_WORKCELL_EXIT_REASON"
    # Cache metrics for token cost optimization observability
    local _cache_acp_count _cache_active_sessions
    _cache_acp_count=$(pgrep -c "claude-agent-acp" 2>/dev/null || echo "0")
    _cache_active_sessions=$(python3 "$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli" --project "$project" session.count-active --project "$project" 2>/dev/null || echo "0")
    local _pb _estimated_tokens
    _pb=$(wc -c < "$prompt_file" 2>/dev/null | tr -d ' ' || echo '0')
    _estimated_tokens=$(( _pb / 4 ))  # bytes → tokens estimate (CN/EN mix)
    append_runtime_event "$project" "cache_metrics" \
      "supervisor_pid=$$" \
      "role=${LAST_ROLE_HINT:-unknown}" \
      "launch_kind=$mode_name" \
      "prompt_file=$prompt_file" \
      "prompt_bytes=$_pb" \
      "estimated_input_tokens=$_estimated_tokens" \
      "resume_streak=${RESUME_STREAK_CURRENT:-0}" \
      "context_ratio=${context_ratio:-0}" \
      "acp_process_count=${_cache_acp_count}" \
      "active_session_count=${_cache_active_sessions}"
    append_lifecycle_trace "$project" "L042" "ai_cycle_finished" \
      "supervisor_pid=$$" \
      "tool=$AGENT_AI_TOOL" \
      "launch_kind=$mode_name" \
      "rc=$rc" \
      "child_pid=${child_pid:-unknown}" \
      "session_id=${tool_session_id:-unavailable}" \
      "resume_target=${tool_resume_target:-unavailable}" \
      "jsonl_path=${tool_jsonl_path:-unavailable}" \
      "cycle_log=$cycle_log" \
      "exit_reason=$LAST_WORKCELL_EXIT_REASON" \
      "from_checkpoint=L041" \
      "expected_from_previous=L042" \
      "expected_next=L020|L090|L201|L210|L230|TERM"

    FIRST_ROUND=false

    log_warn "ai process exited rc=$rc (pid=${child_pid:-unknown}, session_id=${tool_session_id:-unavailable}, context_compacted=$context_compacted, context_ratio=${context_ratio:-unavailable}, jsonl_path=${tool_jsonl_path:-unavailable}, primary_rate_limit_used_percent=${primary_rate_limit_used_percent:-unavailable}, primary_rate_limit_resets_at=${primary_rate_limit_resets_at:-unavailable}, secondary_rate_limit_used_percent=${secondary_rate_limit_used_percent:-unavailable}, secondary_rate_limit_resets_at=${secondary_rate_limit_resets_at:-unavailable}, route_only_handoff=${route_only_handoff})"
    # Preserve crash evidence: save debug log when AI exits non-zero.
    # Uses $AGENT_AI_TOOL (registry-derived, not hardcoded) — works for any tool.
    if [[ "$rc" != "0" && -f "${cycle_debug_log:-}" ]]; then
      local _crash_log; _crash_log="$(logs_dir_for_project "$PROJECT_ROOT")/crash-${AGENT_AI_TOOL:-unknown}-$(date +%Y%m%d-%H%M%S).log"
      cp "$cycle_debug_log" "$_crash_log" 2>/dev/null || true
      [[ -f "$cycle_log" ]] && cp "$cycle_log" "${_crash_log}.stdout" 2>/dev/null || true
      log_info "crash evidence saved: $_crash_log"
    fi
    # ACP mode: bridge persists across cycles — keep child_pid_file so watchdog knows AI is alive
    if [[ "${AGENT_AI_TOOL_ADAPTER:-direct}" != "acp" ]]; then
      rm -f "$child_pid_file"
    fi

    local exit_contract_action
    exit_contract_action="$(project_runtime_handle_exit_contract_after_ai_cycle "$PROJECT_ROOT" "$LAST_WORKCELL_EXIT_REASON")"
    case "$exit_contract_action" in
      stop_ai)
        stop_requested=1
        DESIRED_RUNTIME_STATE_VALUE="stopped"
        case "$(role_hint_for_project "$PROJECT_ROOT")" in
          manager) LAST_WORKCELL_EXIT_REASON="manager_exit_contract_stop_ai" ;;
          worker) LAST_WORKCELL_EXIT_REASON="worker_exit_contract_stop_ai" ;;
        esac
        log_info "exit contract requested stop_ai; exiting supervisor"
        exit 0
        ;;
      resume_invalid|resume_manager)
        case "$exit_contract_action" in
          resume_invalid)
            case "$(role_hint_for_project "$PROJECT_ROOT")" in
              manager) LAST_WORKCELL_EXIT_REASON="manager_exit_contract_invalid" ;;
              worker) LAST_WORKCELL_EXIT_REASON="worker_exit_contract_invalid" ;;
            esac
            ;;
          resume_manager)
            LAST_WORKCELL_EXIT_REASON="manager_exit_contract_resume"
            ;;
        esac
        write_workcell_state "$PROJECT_ROOT" "running" "up" "down" "$LAST_WORKCELL_EXIT_REASON"
        sleep "${RESTART_DELAY:-2}"
        continue
        ;;
      delegate_workers|continue|"")
        ;;
    esac

    # ── After-run worker detection for prompt mode (end_turn without a2a-exit) ──
    # When Manager exits with end_turn in prompt mode, no a2a-exit is called to
    # write the exit contract. The filesystem scan in manager_exit_contract_kind()
    # Step 4 may not be reached. This block runs BEFORE the next cycle starts,
    # detecting new worker prompts written during the cycle and triggering
    # delegate_workers so Workers are launched instead of restarting Manager.
    if [[ "$_end_turn_detected" == "1" \
          && "$exit_contract_action" != "delegate_workers" \
          && "$exit_contract_action" != "stop_ai" \
          && "$(effective_runtime_role_for_project "$PROJECT_ROOT")" == "manager" ]]; then
      local _ar_prompts_dir="$PROJECT_ROOT/.freely/run/worker-prompts"
      local _ar_prompt_ref _ar_new_csv="" _ar_new_count=0 _ar_pf_mtime
      _ar_prompt_ref="$(latest_prompt_file_for_project "$PROJECT_ROOT" 2>/dev/null || true)"
      if [[ -d "$_ar_prompts_dir" && -n "$_ar_prompt_ref" && -f "$_ar_prompt_ref" ]]; then
        local _ar_cycle_start
        _ar_cycle_start=$(stat -f %m "$_ar_prompt_ref" 2>/dev/null || stat -c %Y "$_ar_prompt_ref" 2>/dev/null || echo "0")
        if [[ "$_ar_cycle_start" =~ ^[0-9]+$ && "$_ar_cycle_start" -gt 0 ]]; then
          while IFS= read -r _ar_pf; do
            [[ -n "$_ar_pf" && -f "$_ar_pf" ]] || continue
            _ar_pf_mtime=$(stat -f %m "$_ar_pf" 2>/dev/null || stat -c %Y "$_ar_pf" 2>/dev/null || echo "0")
            if [[ "$_ar_pf_mtime" =~ ^[0-9]+$ && "$_ar_pf_mtime" -ge "$_ar_cycle_start" ]]; then
              if [[ -z "$_ar_new_csv" ]]; then
                _ar_new_csv="$_ar_pf"
              else
                _ar_new_csv="$_ar_new_csv,$_ar_pf"
              fi
              ((_ar_new_count++))
            fi
          done < <(find "$_ar_prompts_dir" -maxdepth 1 -type f -name '*.txt' 2>/dev/null | sort)
        fi
        if [[ -n "$_ar_new_csv" ]]; then
          log_info "[DEPRECATED] after_run_worker_detected for project $project — SSE should handle this"
          append_runtime_event "$project" "after_run_worker_detected" \
            "deprecated=true" \
            "worker_prompts_csv=${_ar_new_csv}" \
            "new_count=${_ar_new_count}" \
            "origin=end_turn_prompt_mode"
          log_info "after_run: detected ${_ar_new_count} new worker prompt(s) after end_turn (prompt mode)"
          exit_contract_action="delegate_workers"
          # Write worker CSV to exit contract so manager_runtime_launch_workers
          # can find the prompt files. Without this, _worker_csv stays empty.
          echo "WORKER_PROMPTS_CSV=$_ar_new_csv" >> "$(manager_exit_contract_file "$PROJECT_ROOT")"
        fi
      fi
    fi

    # SSE 替代了 delivery_status — after_run delivery marking 已废弃

    if [[ "$exit_contract_action" == "delegate_workers" ]]; then
      manager_runtime_launch_workers_after_ai_cycle_if_needed "$PROJECT_ROOT" "$LAST_WORKCELL_EXIT_REASON"
      LAST_WORKCELL_EXIT_REASON="manager_worker_launch_after_ai_cycle"
      write_workcell_state "$PROJECT_ROOT" "running" "up" "down" "$LAST_WORKCELL_EXIT_REASON"
    fi

    restart_count=$((restart_count + 1))
    if [[ "${MAX_RESTARTS:-0}" -gt 0 && "$restart_count" -gt "${MAX_RESTARTS:-0}" ]]; then
      log_error "reached MAX_RESTARTS=${MAX_RESTARTS}, stopping"
      append_runtime_event "$project" "supervisor_stopping" \
        "supervisor_pid=$$" \
        "reason=max_restarts" \
        "restart_count=$restart_count"
      exit 1
    fi
    local auto_recovery_reason=""
    auto_recovery_reason="${slot_switch_reason:-${network_failure_reason:-}}"
    # execution_network_transient means the tool is healthy, network blipped.
    # Don't switch tools for transient errors — just retry after backoff.
    if [[ "$auto_recovery_reason" == "execution_network_transient" ]]; then
      log_info "transient network error detected; retrying same tool after backoff"
      sleep_with_rate_limit_recheck "$PROJECT_ROOT" "$((5 + RANDOM % 10))"
      auto_recovery_reason=""
    fi
    if [[ -n "$auto_recovery_reason" ]]; then
      if attempt_runtime_proxy_self_heal_after_network_failure "$PROJECT_ROOT" "$AGENT_AI_TOOL" "$auto_recovery_reason"; then
        sleep_with_rate_limit_recheck "$PROJECT_ROOT" 1
        continue
      fi
      if attempt_runtime_auto_recovery_after_failure "$PROJECT_ROOT" "$AGENT_AI_TOOL" "$auto_recovery_reason"; then
        # attempt_runtime_auto_recovery_after_failure already handles cooldown
        # state (CROSS_TOOL_SWITCH_AT, CROSS_TOOL_SWITCH_INDEX).  Do NOT apply a
        # second cooldown here — the double sleep of 120s causes the ensure-manager
        # to kill the supervisor as stalled before it can restart the bridge.
        if [[ "${RUNTIME_AUTO_RECOVERY_TOOL:-$AGENT_AI_TOOL}" == "$AGENT_AI_TOOL" ]]; then
          log_warn "${auto_recovery_reason} detected for this workcell; worker runtime switched locally to slot=${RUNTIME_AUTO_RECOVERY_SLOT:-unknown} and will continue"
        else
          log_warn "${auto_recovery_reason} detected for this workcell; worker runtime switched to tool=${RUNTIME_AUTO_RECOVERY_TOOL:-unknown} slot=${RUNTIME_AUTO_RECOVERY_SLOT:-none} and will continue"
        fi
        append_runtime_event "$project" "supervisor_local_slot_recovery" \
          "supervisor_pid=$$" \
          "tool=${RUNTIME_AUTO_RECOVERY_TOOL:-$AGENT_AI_TOOL}" \
          "reason=$auto_recovery_reason" \
          "active_slot=${RUNTIME_AUTO_RECOVERY_SLOT:-unknown}"
        sleep_with_rate_limit_recheck "$PROJECT_ROOT" 1
        continue
      fi
      log_warn "${auto_recovery_reason} detected for this workcell; no auto-recovery path is ready, so local runtime will now stop"
      append_runtime_event "$project" "supervisor_stopping" \
        "supervisor_pid=$$" \
        "reason=$auto_recovery_reason"
      exit 0
    fi
    if [[ -n "$restart_signal_reason" ]]; then
      observe_delay="${RESTART_STORM_OBSERVE_DELAY_SECS:-30}"
      restart_count=0
      log_warn "restart storm / process churn detected for this workcell; pausing blind relaunch for ${observe_delay}s while waiting for manager auto-loop judgement (reason=$restart_signal_reason count=${LAST_RESTART_STORM_COUNT:-0} peak=${LAST_PROCESS_CHURN_PEAK:-0})"
      append_runtime_event "$project" "restart_storm_pause" \
        "supervisor_pid=$$" \
        "reason=$restart_signal_reason" \
        "count=${LAST_RESTART_STORM_COUNT:-0}" \
        "peak=${LAST_PROCESS_CHURN_PEAK:-0}" \
        "observe_delay=$observe_delay"
      sleep_with_rate_limit_recheck "$PROJECT_ROOT" "$observe_delay"
      continue
    fi
    # ── L0-L3 Loop Guard: detect dead loops before next cycle ──
    if declare -f loop_guard_check_all >/dev/null 2>&1; then
      loop_guard_check_all "$PROJECT_ROOT" \
        "${LAST_LAUNCH_KIND:-}" \
        "${LAST_EXIT_REASON:-}" \
        "${worker_launched_directly:-0}" \
        "${LAST_PROMPT_BYTES:-0}" || true  # never block supervisor on guard error
    fi

    sleep_with_rate_limit_recheck "$PROJECT_ROOT" "$next_restart_delay"
  done
}

preflight_project_runtime_restart_or_fail() {
  local project="$1"
  load_config "$project"
  ensure_codex_slot_switch_startup_ready_or_fail "$project" || exit 1
}

cmd_start() {
  local project="" force="0" task_mode=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --task-mode) task_mode="${2:-}"; shift 2 ;;
      --force) force="1"; shift ;;
      --reason) reason="${2:-}"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done

  # --reason gate: --force bypass requires business justification
  if [[ "$force" == "1" && -z "${reason:-}" ]]; then
    cat >&2 <<'REASON_GATE'
[GATE] 检测到你试图违规绕过门禁: freely start --force

  如果是因为实现没有达到门禁要求，请按要求去完成，而不是想着违规绕过。

  只有确实有合理的业务理由（运行时损坏无法正常恢复等），才允许绕过。
  请按以下格式加上绕过理由:
    --reason "违规绕过门禁中，理由充分，是：<业务理由>"

  示例: freely start --force --reason "违规绕过门禁中，理由充分，是：运行时状态损坏导致无法正常启动，需强制重建" --project /path/to/project
REASON_GATE
    exit 1
  fi

  project="$(resolve_project_or_fail "$project")"

  # Auto-detect platforms from git remotes and update FREELY_REPO_PLATFORMS in config.toml.
  # This field is auto-maintained by freely start / daemon start — do not edit manually.
  local _detected_platforms="" _found_gh=0 _found_gt=0
  while IFS= read -r _remote; do
    [[ -z "$_remote" || "$_remote" == "all" ]] && continue
    local _url; _url=$(git -C "$project" remote get-url "$_remote" 2>/dev/null || true)
    case "$_url" in
      *github.com*|*github-*|*github*) _found_gh=1 ;;
      *gitee.com*|*gitee-*|*gitee*)     _found_gt=1 ;;
    esac
  done < <(git -C "$project" remote 2>/dev/null)
  [[ "$_found_gh" == "1" ]] && _detected_platforms="$_detected_platforms,github"
  [[ "$_found_gt" == "1" ]] && _detected_platforms="$_detected_platforms,gitee"
  _detected_platforms="${_detected_platforms#,}"
  if [[ -n "$_detected_platforms" ]] && [[ "$_detected_platforms" != "${FREELY_REPO_PLATFORMS:-}" ]]; then
    upsert_config_key "$project" "FREELY_REPO_PLATFORMS" "$_detected_platforms"
    FREELY_REPO_PLATFORMS="$_detected_platforms"
  fi
	  # ── Issue-sync batch: clear deterministic sync tasks before scan ──
	  # Handles close/update/pull without AI, leaving only novel cases for Manager.
	  local _sync_bin="$project/bin/issue-sync"
	  if [[ -x "$_sync_bin" ]]; then
	    log_info "running issue-sync batch before daemon scan"
	    bash "$_sync_bin" batch 2>&1 | while IFS= read -r _line; do
	      log_info "issue-sync: $_line"
	    done || log_warn "issue-sync batch completed with warnings"
	  fi
	  # ── End issue-sync batch ─────────────────────────────────────────


  # Ensure DB daemon is running before write_task_mode writes to SQLite.
  # write_task_mode calls freely-db-cli which needs the DB daemon's Unix socket.
  ensure_freely_db "$project"
  # Write task mode: explicit flag or reset to default wait
  if [[ -n "$task_mode" ]]; then
    write_task_mode "$project" "$task_mode"
  else
    write_task_mode "$project" "wait"
  fi
  startup_self_heal_machine_state_if_needed "$project" "start_command"
  acquire_project_start_lock_or_wait "$project" "freely_start" || exit 1
  trap "release_project_start_lock_for_runtime '$project'" EXIT
  append_lifecycle_trace "$project" "L001" "start_requested" \
    "entrypoint=foreground" \
    "force=$force" \
    "task_mode=${task_mode:-wait}" \
    "expected_next=L010"
  append_runtime_event "$project" "user_start_command_received" \
    "force=$force" \
    "task_mode=${task_mode:-wait}"
  if [[ "$force" == "1" ]]; then
    log_info "forcing project-local runtime rebuild before start"
    stop_project_runtime "$project" "start_force"
  else
    local run_dir sup_pid_file child_pid_file
    run_dir="$(run_dir_for_project "$project")"
    sup_pid_file="$run_dir/supervisor.pid"
    child_pid_file="$run_dir/ai.pid"
    mkdir -p "$run_dir"
    if active_runtime_attach_reusable_for_project "$project" "$sup_pid_file" "$child_pid_file"; then
      log_info "daemon already running, attach skipped"
      return 0
    fi
    reject_repeated_user_start_if_running "$project" "start"
  fi
  append_runtime_event "$project" "user_start_precheck_clear" \
    "force=$force"
  # Clear old supervisor identity so the new one can write fresh.
  # Old identity has stale PID → watchdog rejects new supervisor.
  rm -f "$(supervisor_identity_dir_for_project "$project")/supervisor.env" 2>/dev/null || true
  if [[ -x "$project/bin/deploy-skills" ]]; then
    "$project/bin/deploy-skills" >/dev/null 2>&1 || log_warn "deploy-skills exited $? (non-fatal)"
  fi
  start_project_runtime "$project" "foreground"
}

