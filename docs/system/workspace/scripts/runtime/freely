ratio_meets_threshold() {
  local ratio="$1" threshold="$2"
  [[ -n "$ratio" && -n "$threshold" ]] || return 1
  awk -v ratio="$ratio" -v threshold="$threshold" 'BEGIN { exit !(ratio >= threshold) }'
}

slugify_text() {
  local text="$1"
  printf '%s\n' "$text" \
    | tr '[:upper:]' '[:lower:]' \
    | tr -cs 'a-z0-9' '-' \
    | sed 's/^-//; s/-$//' \
    | cut -c1-32
}

next_intake_id() {
  local project="$1" message="$2"
  local ts slug base candidate n intake_root
  ts="$(date '+%Y%m%d-%H%M%S')"
  slug="$(slugify_text "$message")"
  [[ -n "$slug" ]] || slug="message"
  base="${ts}-${slug}"
  candidate="$base"
  n=1
  intake_root="$(intake_dir_for_project "$project")"
  mkdir -p "$intake_root"
  while [[ -e "$intake_root/$candidate" ]]; do
    n=$((n + 1))
    candidate="${base}-${n}"
  done
  printf '%s\n' "$candidate"
}

count_intake_items_by_status() {
  local project="$1" expected_status="$2"
  local intake_root meta_file count
  intake_root="$(intake_dir_for_project "$project")"
  [[ -d "$intake_root" ]] || {
    printf '0\n'
    return 0
  }
  count=0
  while IFS= read -r meta_file; do
    [[ -f "$meta_file" ]] || continue
    if awk -F '"' -v expected="$expected_status" '/^STATUS=/{ if ($2 == expected) found=1 } END { exit found ? 0 : 1 }' "$meta_file"; then
      count=$((count + 1))
    fi
  done < <(find "$intake_root" -mindepth 2 -maxdepth 2 -type f -name meta.env | sort)
  printf '%s\n' "$count"
}

count_active_intake_items() {
  local project="$1"
  local intake_root meta_file count status
  intake_root="$(intake_dir_for_project "$project")"
  [[ -d "$intake_root" ]] || {
    printf '0\n'
    return 0
  }
  count=0
  while IFS= read -r meta_file; do
    [[ -f "$meta_file" ]] || continue
    status="$(awk -F '"' '/^STATUS=/{print $2; exit}' "$meta_file")"
    case "$status" in
      absorbed|dropped) ;;
      *) count=$((count + 1)) ;;
    esac
  done < <(find "$intake_root" -mindepth 2 -maxdepth 2 -type f -name meta.env | sort)
  printf '%s\n' "$count"
}

meta_env_value() {
  local meta_file="$1" key="$2"
  [[ -f "$meta_file" ]] || return 0
  awk -F '"' -v key="$key" '$1 == key "=" { print $2; exit }' "$meta_file"
}

validate_reaction_or_fail() {
  local reaction="$1"
  case "$reaction" in
    steer|followup|collect|interrupt|noise) ;;
    *)
      log_error "unsupported reaction: $reaction (supported: steer, followup, collect, interrupt, noise)"
      exit 1
      ;;
  esac
}

validate_absorption_classification_or_fail() {
  local classification="$1"
  [[ -z "$classification" ]] && return 0
  case "$classification" in
    discovery|continuation|control|noise) ;;
    *)
      log_error "unsupported classification: $classification (supported: discovery, continuation, control, noise)"
      exit 1
      ;;
  esac
}

validate_intake_status_or_fail() {
  local status="$1"
  case "$status" in
    new|classified|delegated|absorbed|dropped) ;;
    *)
      log_error "unsupported intake status: $status (supported: new, classified, delegated, absorbed, dropped)"
      exit 1
      ;;
  esac
}

update_intake_pending_signal() {
  local project="$1"
  local pending_file count
  pending_file="$(intake_pending_signal_file "$project")"
  mkdir -p "$(dirname "$pending_file")"
  count="$(count_active_intake_items "$project")"
  if [[ "$count" -gt 0 ]]; then
    cat >"$pending_file" <<EOF
PENDING_INTAKE_ITEMS="$count"
UPDATED_AT="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
EOF
  else
    rm -f "$pending_file"
  fi
}

write_intake_item() {
  local project="$1" intake_id="$2" author="$3" channel="$4" status="$5" classification="$6" linked_artifact="$7" delegated_worktree="$8" session_refs="$9" message="${10}" reaction="${11:-}" claimed_by="${12:-}" claimed_at="${13:-}" absorption_target="${14:-}" resolution_artifact="${15:-}" created_at_override="${16:-}"
  local intake_root item_dir meta_file message_file created_at
  intake_root="$(intake_dir_for_project "$project")"
  item_dir="$intake_root/$intake_id"
  meta_file="$item_dir/meta.env"
  message_file="$item_dir/message.txt"
  created_at="${created_at_override:-$(date -u '+%Y-%m-%dT%H:%M:%SZ')}"
  mkdir -p "$item_dir"
  cat >"$meta_file" <<EOF
INTAKE_ID="$intake_id"
CREATED_AT="$created_at"
AUTHOR="$author"
CHANNEL="$channel"
STATUS="$status"
CLASSIFICATION="$classification"
REACTION="$reaction"
LINKED_ARTIFACT="$linked_artifact"
DELEGATED_WORKTREE="$delegated_worktree"
SESSION_REFS="$session_refs"
CLAIMED_BY="$claimed_by"
CLAIMED_AT="$claimed_at"
ABSORPTION_TARGET="$absorption_target"
RESOLUTION_ARTIFACT="$resolution_artifact"
EOF
  printf '%s\n' "$message" >"$message_file"
  update_intake_pending_signal "$project"
}

write_interruption_resolution_artifact() {
  local project="$1" intake_id="$2" resolved_by="$3" reaction="$4" classification="$5" absorption_target="$6" linked_artifact="$7" delegated_worktree="$8" status="$9" content="${10}"
  local item_dir meta_file content_file created_at
  item_dir="$(interruption_resolution_item_dir "$project" "$intake_id")"
  meta_file="$item_dir/meta.env"
  content_file="$item_dir/resolution.md"
  created_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  mkdir -p "$item_dir"
  cat >"$meta_file" <<EOF
INTAKE_ID="$intake_id"
CREATED_AT="$created_at"
RESOLVED_BY="$resolved_by"
REACTION="$reaction"
CLASSIFICATION="$classification"
ABSORPTION_TARGET="$absorption_target"
LINKED_ARTIFACT="$linked_artifact"
DELEGATED_WORKTREE="$delegated_worktree"
STATUS="$status"
EOF
  printf '%s\n' "$content" >"$content_file"
