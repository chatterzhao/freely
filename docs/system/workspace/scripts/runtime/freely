  intake_root="$(intake_dir_for_project "$project")"
  [[ -d "$intake_root" ]] || return 0
  count=0
  while IFS= read -r item_dir; do
    meta_file="$item_dir/meta.env"
    message_file="$item_dir/message.txt"
    [[ -f "$meta_file" ]] || continue
    status="$(meta_env_status_value "$meta_file")"
    case "$status" in
      absorbed|dropped|delegated) continue ;;
    esac
    load_meta_env_snapshot "$meta_file"
    intake_id="$LOADED_META_INTAKE_ID"
    created_at="$LOADED_META_CREATED_AT"
    channel="$LOADED_META_CHANNEL"
    author="$LOADED_META_AUTHOR"
    classification="$LOADED_META_CLASSIFICATION"
    reaction="$LOADED_META_REACTION"
    claimed_by="$LOADED_META_CLAIMED_BY"
    linked_artifact="$LOADED_META_LINKED_ARTIFACT"
    absorption_target="$LOADED_META_ABSORPTION_TARGET"
    first_line="$(sed -n '1p' "$message_file" 2>/dev/null || true)"
    printf -- '- id=%s status=%s classification=%s reaction=%s claimed_by=%s author=%s channel=%s created_at=%s linked_artifact=%s absorption_target=%s message=%s\n' \
      "${intake_id:-unknown}" "${status:-unknown}" "${classification:-unclassified}" "${reaction:-pending}" "${claimed_by:-unclaimed}" "${author:-unknown}" "${channel:-unknown}" "$(format_timestamp_local_for_display "${created_at:-unknown}")" "${linked_artifact:-none}" "${absorption_target:-pending}" "${first_line:-}"
