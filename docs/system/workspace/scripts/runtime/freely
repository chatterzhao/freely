# ── codex writable_roots helper ──────────────────────────────────
# Patch config.toml sandbox.writable_roots to include project +
# worktrees directories (required for codex sandbox to create files).
# Called via slot.post_init hook from _bridge_env_for_registered_tool.
# Side effect: MAY modify config.toml on disk.
_bridge_env_ensure_writable_roots() {
  local _slot_dir="$1" project="$2"
  local _project_name _project_parent _wt_dir _slot_cfg

  _project_name=$(basename "$project")
  _project_parent=$(dirname "$project")
  _wt_dir="${_project_parent}/${_project_name}-worktrees"
  _slot_cfg="$_slot_dir/config.toml"

  [[ -f "$_slot_cfg" ]] || return 0

  local _need_append=0
  grep -qF "\"$project\"" "$_slot_cfg" 2>/dev/null || _need_append=1
  grep -qF "\"$_wt_dir\"" "$_slot_cfg" 2>/dev/null || _need_append=1
  [[ "$_need_append" -eq 1 ]] || return 0

  local _added; _added=$(python3 -c "
import re
cfg_path = '$_slot_cfg'
project = '$project'
wt_dir = '$_wt_dir'

with open(cfg_path) as f:
    content = f.read()

roots_match = re.search(r'^\[sandbox\]\s*\n(.*?)(?=\n\[|\Z)', content, re.DOTALL | re.MULTILINE)
writable_match = re.search(r'^writable_roots\s*=\s*\[(.*?)\]', content, re.MULTILINE)

existing = []
if writable_match:
    raw = writable_match.group(1)
    existing = [x.strip().strip('\"') for x in raw.split(',') if x.strip()]

added = []
for need in [project, wt_dir]:
    if need not in existing:
        existing.append(need)
        added.append(need)

if added:
    new_roots = '[' + ', '.join(f'\"{r}\"' for r in existing) + ']'
    if writable_match:
        content = content[:writable_match.start()] + 'writable_roots = ' + new_roots + content[writable_match.end():]
    elif roots_match:
        insert_pos = roots_match.end()
        content = content[:insert_pos] + f'writable_roots = {new_roots}\n' + content[insert_pos:]
    else:
        content += f'\n[sandbox]\nwritable_roots = {new_roots}\n'
    with open(cfg_path, 'w') as f:
        f.write(content)
    for a in added:
        print(a)
" 2>/dev/null) || true

  if [[ -n "$_added" ]]; then
    log_info "ACP bridge: appended to writable_roots: $(echo "$_added" | tr '\n' ', ' | sed 's/, $//')"
  fi
}

_ensure_acp_bridge_running() {
  local project="$1" base_tool="${2:-claude}"
  local pid_file socket
  pid_file="$(_acp_bridge_pid_file "$project" "$base_tool")"
  socket="$(_acp_bridge_socket "$project" "$base_tool")"

  # Determine the correct ACP binary for the given tool via registry

  # Read ACP binary and args from tool registry (single source of truth)
  local _reg_bin; _reg_bin="$(_tool_registry_get "$base_tool" "acp.binary" 2>/dev/null || true)"
  if [[ -n "$_reg_bin" ]]; then
    acp_bin="$_reg_bin"
    # Parse args from registry (space-separated)
    local _reg_args; _reg_args="$(_tool_registry_get "$base_tool" "acp.args" 2>/dev/null || true)"
    [[ -n "$_reg_args" ]] && read -ra _acp_args <<<"$_reg_args"

    # Handle auto-download via shared helper (version/repo/cache from registry)
    local _auto_dl; _auto_dl="$(_tool_registry_get "$base_tool" "acp.auto_download" 2>/dev/null || echo "false")"
    if [[ "$_auto_dl" == "true" ]]; then
      local _ensure_script="$SELF_ROOT/docs/system/workspace/scripts/runtime/ensure-codex-acp"
      if [[ -x "$_ensure_script" ]]; then
        local _cached_bin; _cached_bin="$("$_ensure_script" 2>/dev/null)" || true
        [[ -n "$_cached_bin" && -x "$_cached_bin" ]] && acp_bin="$_cached_bin"
      fi
    fi
  else
    # Not in registry: use claude-agent-acp as default
    acp_bin="${FREELY_CLAUDE_ACP_BIN:-claude-agent-acp}"
  fi

  # Store the binary path so we can detect tool changes across cycles
  local acp_bin_file="${pid_file}.bin"
  # Also store the tool name to detect same-base-tool slot switches
  local acp_tool_file="${pid_file}.tool"

  # Already running?
  if [[ -f "$pid_file" ]]; then
    local pid
    pid=$(cat "$pid_file" 2>/dev/null || true)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && [[ -S "$socket" ]]; then
      # Check if the running bridge uses the right binary
      local running_bin=""
      [[ -f "$acp_bin_file" ]] && running_bin=$(cat "$acp_bin_file" 2>/dev/null || true)
      # Check if the tool (including slot) changed — same base-tool but
      # different slot means different API key; bridge must restart.
      local running_tool=""
      [[ -f "$acp_tool_file" ]] && running_tool=$(cat "$acp_tool_file" 2>/dev/null || true)
      # Compare basename — config.toml may store full path while registry uses short name
      local _running_bin_name; _running_bin_name=$(basename "$running_bin" 2>/dev/null || echo "$running_bin")
      local _acp_bin_name; _acp_bin_name=$(basename "$acp_bin" 2>/dev/null || echo "$acp_bin")
      if [[ -n "$running_bin" && "$_running_bin_name" != "$_acp_bin_name" ]]; then
        log_info "ACP bridge binary changed ($running_bin → $acp_bin), gracefully closing session before restart"
        _acp_session_close "$project" "$base_tool" "${TOOL_SESSION_ID_CURRENT:-}"
        _stop_acp_bridge "$project" "${_cross_base_tool:-}"
      elif [[ -n "$running_tool" ]]; then
        # Compare base tool names (slot suffix may differ between cycles).
        # opencode-apikey-ds-flash-auto and opencode are the same base tool.
        local _running_base="${running_tool%%-*}"
        local _current_base="${base_tool:-claude}"
        _current_base="${_current_base:-claude}"
        if [[ "$_running_base" != "$_current_base" ]]; then
          log_info "ACP bridge tool changed ($running_tool → ${base_tool:-claude}), gracefully closing session before restart"
          _acp_session_close "$project" "$base_tool" "${TOOL_SESSION_ID_CURRENT:-}"
          _stop_acp_bridge "$project" "${_cross_base_tool:-}"
        fi
      elif _acp_bridge_health_check "$project" 5 "$base_tool"; then
        return 0
      else
        log_warn "existing ACP bridge (pid=$pid) is alive but failed health check; restarting"
      fi
    fi
    rm -f "$pid_file" "$socket" "$acp_bin_file" "$acp_tool_file"
  fi

  # ── Config.toml binary path lookup ──
  # After resolving the binary name from registry, check if config.toml has
  # a pre-recorded path (set by freely init). This avoids re-searching PATH
  # on every daemon start and supports non-PATH install locations.
  local _config_key; _config_key="FREELY_ACP_$(echo "$base_tool" | tr '[:lower:]' '[:upper:]')_BIN"
  local _config_path; _config_path="${!_config_key:-}"
  if [[ -n "$_config_path" && -x "$_config_path" ]]; then
    acp_bin="$_config_path"
  elif ! command -v "$acp_bin" >/dev/null 2>&1; then
    log_warn "ACP binary '$acp_bin' not in PATH and not found in config.toml ($_config_key)"
    log_warn "Run 'freely init' to set up ACP tools, or set $_config_key in .freely/config.toml"
  fi

  local bridge_script="$SELF_ROOT/docs/system/workspace/scripts/runtime/acp-bridge.py"
  [[ -f "$bridge_script" ]] || bridge_script="$(workspace_root_for_project "$project")/scripts/runtime/acp-bridge.py"
  if [[ ! -f "$bridge_script" ]]; then
    log_warn "acp-bridge.py not found, ACP bridge unavailable"
    return 1
  fi

  # Collect per-slot env vars to pass to the bridge process only (not global export).
  # This isolates concurrent projects using different slots.
  local -a _bridge_env=()
  # Resolve slot for this base_tool from agent-table (per-agent, not global AGENT_AI_TOOL)
  local _bridge_slot=""
  if [[ -f "$_at" && -x "$_aq" ]]; then
    for _role in manager worker reviewer; do
      _bridge_slot=$("$_aq" --get-slot "${_role}_01" 2>/dev/null || true)
      [[ -n "$_bridge_slot" && "${_bridge_slot%%-*}" == "$base_tool" ]] && break
      _bridge_slot=""
    done
  fi
  [[ -z "$_bridge_slot" ]] && _bridge_slot="${AGENT_AI_TOOL:-claude}"

  local tool_name="$_bridge_slot"

  # ── Unified auth-driven bridge env dispatch ──────────────────
  # ai_cli_tool_with_auth_assemble work reads ALL behavior from the
  # tool-registry.toml slot section.  Tool extracted from slot name internally.
  local _bridge_line
  while IFS= read -r _bridge_line; do
    [[ -n "$_bridge_line" ]] && _bridge_env+=("$_bridge_line")
  done < <(ai_cli_tool_with_auth_assemble work "$tool_name" 2>/dev/null || true)
  # Post-init hook (e.g. codex writable_roots) — kept in caller
  local _post_init; _post_init="$(_tool_registry_get "$base_tool" "slot.post_init" 2>/dev/null || true)"
  case "$_post_init" in
    ensure_writable_roots)
      local _slot_dir="$HOME/.ai-auth/$tool_name"
      local _is_dir; _is_dir="$(_tool_registry_get "$base_tool" "slot.is_dir" 2>/dev/null || echo "false")"
      if [[ "$_is_dir" == "true" ]]; then
        _bridge_env_ensure_writable_roots "$_slot_dir" "$project"
      else
        _bridge_env_ensure_writable_roots "$(dirname "$_slot_dir" 2>/dev/null || true)" "$project"
      fi
      ;;
  esac

  # Extract ACP CLI flags (ACP_CLI: prefix) from bridge env and append to _acp_args.
  # bridge_config_env values starting with "--" (e.g. "--config") emit
  # "ACP_CLI:--config=<slot_path>" which we unpack into separate args here.
  local -a _filtered_env=()
  local _item
  # bash 3.2 + set -u: iterating empty array directly errors ("unbound variable")
  if [[ ${#_bridge_env[@]} -gt 0 ]]; then
    for _item in "${_bridge_env[@]}"; do
      if [[ "$_item" == ACP_CLI:* ]]; then
        local _cli_spec="${_item#ACP_CLI:}"
        _acp_args+=("${_cli_spec%%=*}" "${_cli_spec#*=}")
      else
        _filtered_env+=("$_item")
      fi
    done
  fi
	# bash 3.2 + set -u: array copy from empty array errors
	if [[ ${#_filtered_env[@]} -gt 0 ]]; then
	  _bridge_env=("${_filtered_env[@]}")
	else
	  _bridge_env=()
	fi

  # ── Sanitize inherited AI tool environment variables ──────────
  # The daemon process inherits ANTHROPIC_*/CLAUDE_CODE_*/AI_AGENT
  # from the parent (e.g. Claude Code session).  Unset them so only
  # slot-specific vars (from ai_cli_tool_with_auth_assemble) reach
  # the bridge subprocess.
  local -a _sanitize_vars=(
    ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_MODEL
    ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL
    CLAUDE_CODE_AUTO_COMPACT_WINDOW CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_EXECPATH
    CLAUDE_CODE_SESSION_ID CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_SUBAGENT_MODEL
    AI_AGENT
  )
  local _sanitized=0
  for _var in "${_sanitize_vars[@]}"; do
    unset "$_var" 2>/dev/null && ((_sanitized++)) || true
  done
  [[ $_sanitized -gt 0 ]] && log_info "acp bridge env sanitized: $_sanitized inherited AI tool vars unset"

  # Use --foreground (no fork) + & to avoid child-process lifecycle issues
  local bridge_log; bridge_log="$(run_dir_for_project "$project")/acp-bridge-${base_tool}.log"
  if [[ ${#_bridge_env[@]} -gt 0 ]]; then
    env "${_bridge_env[@]}" python3 "$bridge_script" start --project "$project" --base-tool "$base_tool" --acp-bin "$acp_bin" ${_acp_args:+--acp-args "${_acp_args[*]}"} --foreground </dev/null >>"$bridge_log" 2>&1 &
  else
    python3 "$bridge_script" start --project "$project" --base-tool "$base_tool" --acp-bin "$acp_bin" ${_acp_args:+--acp-args "${_acp_args[*]}"} --foreground </dev/null >>"$bridge_log" 2>&1 &
  fi
  disown "$!" 2>/dev/null || true
  # Note: bridge writes its own PID file during start_server, don't overwrite it
  # Record the registry short name (not config.toml full path) so comparison
  # with next cycle's registry lookup uses consistent values.
  printf '%s\n' "${_reg_bin:-$acp_bin}" > "$acp_bin_file" 2>/dev/null || true
  printf '%s\n' "$_bridge_slot" > "$acp_tool_file" 2>/dev/null || true

  # Wait for readiness (codex-acp cold start ~8s, use 15s margin)
  local waited=0
  while [[ ! -S "$socket" ]] && (( waited < 150 )); do
    sleep 0.1
    waited=$((waited + 1))
  done
  [[ -S "$socket" ]] || { log_warn "ACP bridge socket did not appear"; return 1; }

  append_runtime_event "$project" "acp_bridge_started" "bridge_pid=$(cat "$pid_file" 2>/dev/null || echo unknown) binary=$acp_bin base_tool=$base_tool slot=${AGENT_AI_TOOL:-claude}"
  # Record startup in tool_switch_events for session continuity tracking
  local _ts_old_tool=""
  local _ts_record; _ts_record="$(_tool_switch_read_latest "$project")"
  if [[ -n "$_ts_record" ]]; then
    _ts_old_tool="$(echo "$_ts_record" | cut -d'|' -f6)"  # new_tool from last record
  fi
  _tool_switch_atomic_write "$project" "startup" "$_ts_old_tool" "" "" "" "${AGENT_AI_TOOL:-}" ""
}

# _acp_session_close: gracefully close an ACP session via bridge socket.
# This lets the SDK finalize JSONL, flush buffers, and write session metadata
# before the bridge is killed.  Works for all ACP implementations (claude/codex/opencode)
# since the bridge forwards session/close to the SDK via _send_request.
# Falls back silently if bridge is dead or SDK does not support the method.
# Signature: (project, session_id) — for direct session_id-based close.
_acp_session_close() {
  local base_tool="${2:-}"
  local project="$1" session_id="${3:-}"
  local socket; socket="$(_acp_bridge_socket "$project" "$base_tool")"
  [[ -S "$socket" ]] || return 0
  [[ -n "$session_id" ]] || return 0

  python3 -c "
import socket, json, sys
try:
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(15)
    sock.connect('$socket')
    req = json.dumps({'jsonrpc':'2.0','id':1,'method':'session/close','params':{'sessionId':'$session_id'}})
    sock.sendall((req + '\
').encode())
    sock.settimeout(15)
    resp = sock.recv(4096)
    sock.close()
    result = json.loads(resp)
    if 'error' in result:
        print(f'[acp-session-close] error: ' + str(result.get('error','unknown')), flush=True)
        sys.exit(1)
    print(f'[acp-session-close] closed session $session_id', flush=True)
except FileNotFoundError:
    pass
except Exception as e:
    print(f'[acp-session-close] failed: {e}', flush=True)
" 2>/dev/null || true
}

_stop_acp_bridge() {
  local project="$1" base_tool="${2:-}"
  local bridge_script="$SELF_ROOT/docs/system/workspace/scripts/runtime/acp-bridge.py"
  [[ -f "$bridge_script" ]] || bridge_script="$(workspace_root_for_project "$project")/scripts/runtime/acp-bridge.py"
  if [[ -n "$base_tool" ]]; then
    # Stop specific bridge
    if [[ -f "$bridge_script" ]]; then
      python3 "$bridge_script" stop --project "$project" --base-tool "$base_tool" >/dev/null 2>&1 || true
    fi
    local _spid _spid_file; _spid_file="$(_acp_bridge_pid_file "$project" "$base_tool")"
    _spid=$(cat "$_spid_file" 2>/dev/null || true)
    [[ -n "$_spid" ]] && kill "$_spid" 2>/dev/null || true
    rm -f "$_spid_file" "$(_acp_bridge_socket "$project" "$base_tool")"
  else
    # Stop all bridges
    if [[ -f "$bridge_script" ]]; then
      python3 "$bridge_script" stop --project "$project" >/dev/null 2>&1 || true
    fi
    # Clean up all per-tool pid/socket files
    rm -f /tmp/freely-acp-$(_acp_bridge_short_hash "$project")*.pid /tmp/freely-acp-$(_acp_bridge_short_hash "$project")*.sock
  fi
  # Kill ACP server processes (SIGTERM first, then SIGKILL)
  local patterns=(
    "claude-agent-acp"
    "claude.*--session-id.*--replay-user-messages"
    "claude.*--resume [a-f0-9-]\{36\}"
    "run-acp-prompt.py"
  )
  local p
  for p in "${patterns[@]}"; do
    pkill -f "$p" 2>/dev/null || true
  done
  sleep 0.5
  for p in "${patterns[@]}"; do
    pkill -9 -f "$p" 2>/dev/null || true
  done
  # Clean up state files
  # pid/socket files cleaned above (per-tool or all)
  rm -f "$(run_dir_for_project "$project")/acp-bridge"*.log
}

manager_ai_stalled_with_pending_intake() {
  local project="$1" threshold_secs="${2:-90}"
  local ai_pid cycle_log intake_signal log_mtime signal_mtime now
  ai_pid="$(manager_ai_pid_for_project "$project")"
  [[ -n "$ai_pid" ]] || return 1
  cycle_log="$(latest_cycle_log_for_project "$project")"
  [[ -n "$cycle_log" && -f "$cycle_log" ]] || return 1
  intake_signal="$(intake_pending_signal_file "$project")"
  [[ -f "$intake_signal" ]] || return 1
  log_mtime="$(file_mtime_epoch "$cycle_log" 2>/dev/null || true)"
  signal_mtime="$(file_mtime_epoch "$intake_signal" 2>/dev/null || true)"
  [[ -n "$log_mtime" && -n "$signal_mtime" ]] || return 1
  (( signal_mtime > log_mtime )) || return 1
  now="$(date +%s)"

  # Multi-signal liveness check before declaring stall.
  # A single mtime on the cycle log is unreliable — the AI may be
  # actively streaming/reading without flushing the cycle log.
  if (( now - log_mtime >= threshold_secs )); then
    if _ai_shows_liveness "$project" "$ai_pid" "$cycle_log" "$threshold_secs"; then
      return 1
    fi
    return 0
  fi
  return 1
}

latest_active_intake_meta_mtime_for_project() {
  local project="$1"
  local intake_root meta_file mtime latest_mtime=""
  intake_root="$(intake_dir_for_project "$project")"
  [[ -d "$intake_root" ]] || return 1
  while IFS= read -r meta_file; do
    [[ -f "$meta_file" ]] || continue
    intake_item_counts_as_active_in_current_round "$project" "$meta_file" || continue
    mtime="$(file_mtime_epoch "$meta_file" 2>/dev/null || true)"
    [[ -n "$mtime" ]] || continue
    if [[ -z "$latest_mtime" ]] || (( mtime > latest_mtime )); then
      latest_mtime="$mtime"
    fi
  done < <(find "$intake_root" -mindepth 2 -maxdepth 2 -type f -name meta.env | sort)
  [[ -n "$latest_mtime" ]] || return 1
  printf '%s\n' "$latest_mtime"
}

prompt_file_has_delegated_continuation() {
  local prompt_file="$1"
  [[ -f "$prompt_file" ]] || return 1
  grep -q '^Delegated continuation handoff:' "$prompt_file" 2>/dev/null
}

manager_ai_prompt_superseded_by_new_intake() {
  local project="$1" threshold_secs="${2:-20}"
  local ai_pid prompt_file prompt_mtime latest_intake_mtime now
  ai_pid="$(manager_ai_pid_for_project "$project")"
  [[ -n "$ai_pid" ]] || return 1
  prompt_file="$(latest_prompt_file_for_project "$project")"
  [[ -n "$prompt_file" && -f "$prompt_file" ]] || return 1
  prompt_file_has_delegated_continuation "$prompt_file" || return 1
  prompt_mtime="$(file_mtime_epoch "$prompt_file" 2>/dev/null || true)"
  latest_intake_mtime="$(latest_active_intake_meta_mtime_for_project "$project" 2>/dev/null || true)"
  [[ -n "$prompt_mtime" && -n "$latest_intake_mtime" ]] || return 1
  (( latest_intake_mtime > prompt_mtime )) || return 1
  now="$(date +%s)"
  (( now - latest_intake_mtime >= threshold_secs )) || return 1
}

manager_ai_stalled_after_delegated_continuation_prompt() {
  local project="$1" threshold_secs="${2:-90}"
  local ai_pid cycle_log prompt_file continuity_file
  local log_mtime prompt_mtime continuity_mtime now

  ai_pid="$(manager_ai_pid_for_project "$project")"
  [[ -n "$ai_pid" ]] || return 1
  cycle_log="$(latest_cycle_log_for_project "$project")"
  [[ -n "$cycle_log" && -f "$cycle_log" ]] || return 1
  prompt_file="$(latest_prompt_file_for_project "$project")"
  [[ -n "$prompt_file" && -f "$prompt_file" ]] || return 1
  prompt_file_has_delegated_continuation "$prompt_file" || return 1

  log_mtime="$(file_mtime_epoch "$cycle_log" 2>/dev/null || true)"
  prompt_mtime="$(file_mtime_epoch "$prompt_file" 2>/dev/null || true)"
  [[ -n "$log_mtime" && -n "$prompt_mtime" ]] || return 1

  now="$(date +%s)"
  if (( now - log_mtime >= threshold_secs && now - prompt_mtime >= threshold_secs )); then
    if ! _ai_shows_liveness "$project" "$ai_pid" "$cycle_log" "$threshold_secs"; then
      :
    else
      return 1
    fi
  else
    return 1
  fi

  if manager_delegated_supervision_quiet_period_waiting_on_active_worker "$project" "$prompt_mtime"; then
    return 1
  fi

  continuity_file="$(latest_generated_manager_continuity_file_for_project "$project")"
  if [[ -n "$continuity_file" && -f "$continuity_file" ]]; then
    continuity_mtime="$(file_mtime_epoch "$continuity_file" 2>/dev/null || true)"
    if [[ -n "$continuity_mtime" ]] && (( continuity_mtime >= prompt_mtime )); then
      if manager_continuity_waiting_on_active_busy_worker "$project" "$continuity_file"; then
        return 1
      fi
      if manager_continuity_has_unconsumed_launchable_worker_prompt "$project" "$continuity_file"; then
        return 0
      fi
      return 1
    fi
  fi
  return 0
}

manager_ai_stalled_without_runtime_progress() {
  local project="$1" threshold_secs="${2:-90}"
  local ai_pid cycle_log prompt_file
  local log_mtime prompt_mtime now

  ai_pid="$(manager_ai_pid_for_project "$project")"
  [[ -n "$ai_pid" ]] || return 1
  cycle_log="$(latest_cycle_log_for_project "$project")"
  [[ -n "$cycle_log" && -f "$cycle_log" ]] || return 1
  prompt_file="$(latest_prompt_file_for_project "$project")"
  [[ -n "$prompt_file" && -f "$prompt_file" ]] || return 1
  prompt_file_has_delegated_continuation "$prompt_file" && return 1
  [[ -f "$(intake_pending_signal_file "$project")" ]] && return 1

  log_mtime="$(file_mtime_epoch "$cycle_log" 2>/dev/null || true)"
  prompt_mtime="$(file_mtime_epoch "$prompt_file" 2>/dev/null || true)"
  [[ -n "$log_mtime" && -n "$prompt_mtime" ]] || return 1

  now="$(date +%s)"
  if (( now - log_mtime >= threshold_secs && now - prompt_mtime >= threshold_secs )); then
    _ai_shows_liveness "$project" "$ai_pid" "$cycle_log" "$threshold_secs" && return 1
    return 0
  fi
  return 1
}

manager_delegated_supervision_quiet_period_waiting_on_active_worker() {
  local project="$1" prompt_mtime="$2"
  local continuity_file continuity_mtime state_file consumed_csv prompt_file target_project saw_busy="0"
  local active_running_workers

  continuity_file="$(latest_generated_manager_continuity_file_for_project "$project")"
  if [[ -n "$continuity_file" && -f "$continuity_file" ]]; then
    continuity_mtime="$(file_mtime_epoch "$continuity_file" 2>/dev/null || true)"
    if [[ -n "$continuity_mtime" ]] && (( continuity_mtime >= prompt_mtime )); then
      if manager_continuity_has_unconsumed_launchable_worker_prompt "$project" "$continuity_file"; then
        return 1
      fi
      if manager_continuity_has_stale_runtime_worktree_refs "$project" "$continuity_file"; then
        return 1
      fi
      if manager_continuity_waiting_on_active_busy_worker "$project" "$continuity_file"; then
        return 0
      fi
      return 1
    fi
  fi

  state_file="$(manager_worker_launch_state_file "$project")"
  [[ -f "$state_file" ]] || return 1
  # shellcheck disable=SC1090
  source "$state_file"
  active_running_workers="$(manager_semantic_loop_active_worker_count_for_project "$project")"
  [[ "$active_running_workers" =~ ^[0-9]+$ ]] || return 1
  (( active_running_workers > 0 )) || return 1
  [[ -z "${QUEUED_WORKER_PROMPTS:-}" ]] || return 1

  consumed_csv="${LAST_MANAGER_WORKER_PROMPTS_CONSUMED:-${LAUNCHED_WORKER_PROMPTS:-}}"
  [[ -n "$consumed_csv" ]] || return 1

  IFS=',' read -r -a __quiet_period_consumed_prompts <<<"$consumed_csv"
  for prompt_file in "${__quiet_period_consumed_prompts[@]}"; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || return 1
    target_project="$(worker_prompt_resolved_worktree "$project" "$prompt_file")"
    [[ -n "$target_project" && -d "$target_project" ]] || return 1
    if worker_project_busy_with_delegated_continuation "$target_project"; then
      saw_busy="1"
      continue
    fi
    worker_project_waiting_on_delegated_continuation_startup "$target_project" || return 1
    saw_busy="1"
  done

  [[ "$saw_busy" == "1" ]]
}

resolve_manager_delegated_continuations_as_absorbed() {
  local project="$1" intake_ids_csv="$2" continuity_file="$3"
  local intake_id resolution_file
  [[ -n "$project" && -n "$intake_ids_csv" && -n "$continuity_file" ]] || return 0
  resolution_file="$(mktemp /tmp/freely-manager-delegated-absorption.XXXXXX)"
  cat >"$resolution_file" <<EOF
restart_point: \`continuation\`
ownership: \`manager\`
handoff_summary: 本轮 delegated continuation 已被主管吸收到新 continuity 中。
EOF
  IFS=',' read -r -a __manager_delegated_ids <<<"$intake_ids_csv"
  for intake_id in "${__manager_delegated_ids[@]}"; do
    [[ -n "$intake_id" ]] || continue
    cmd_intake_resolve \
      --project "$project" \
      --intake-id "$intake_id" \
      --resolved-by interruption-manager-agent \
      --reaction followup \
      --classification continuation \
      --resolution-file "$resolution_file" \
      --absorption-target "continuity://manager-supervision" \
      --status absorbed \
      --linked-artifact "$continuity_file" >/dev/null
  done
  rm -f "$resolution_file"
}

manager_ai_runtime_recovery_reason() {
  local project="$1" threshold_secs="${2:-90}"
  if manager_ai_stalled_with_pending_intake "$project" "$threshold_secs"; then
    printf 'manager_ai_stalled_with_pending_intake\n'
    return 0
  fi
  if manager_ai_prompt_superseded_by_new_intake "$project"; then
    printf 'manager_ai_prompt_superseded_by_new_intake\n'
    return 0
  fi
  if manager_ai_stalled_after_delegated_continuation_prompt "$project" "$threshold_secs"; then
    printf 'manager_ai_stalled_after_delegated_continuation_prompt\n'
    return 0
  fi
  if manager_ai_stalled_without_runtime_progress "$project" "$threshold_secs"; then
    printf 'manager_ai_stalled_without_runtime_progress\n'
    return 0
  fi
  return 1
}

recover_stalled_manager_ai_if_needed() {
  local project="$1" ai_pid current_slot stall_reason
  stall_reason="$(manager_ai_runtime_recovery_reason "$project" "${MANAGER_AI_STALL_THRESHOLD_SECS:-90}")" || return 1
  ai_pid="$(manager_ai_pid_for_project "$project")"
  current_slot=""
  if [[ "${AGENT_AI_TOOL:-}" == "codex" || "${AGENT_AI_TOOL:-}" == codex-* ]]; then
    current_slot="$(codex_current_slot "$project")"
  fi
  append_runtime_event "$project" "runtime_stalled_ai_recovery_triggered" \
    "role=manager" \
    "reason=$stall_reason" \
    "ai_pid=${ai_pid:-unknown}" \
    "slot=${current_slot:-unknown}"
  write_manager_bootstrap_handoff "$project" "manager_stall_detected" "${current_slot:-unknown}" "${current_slot:-unknown}" "$stall_reason" "relaunch-manager-after-stall-recovery"
  request_local_continuation_reentry "$project" "runtime-stalled-ai-recovery"
  restart_manager_supervisor_preserving_handoff "$project"
  log_warn "recovered stalled manager ai (project=$project ai_pid=${ai_pid:-unknown} reason=$stall_reason)"
  return 0
}

worker_ai_stalled_after_delegated_continuation_prompt() {
  local project="$1" threshold_secs="${2:-90}"
  local ai_pid cycle_log prompt_file log_mtime prompt_mtime now

  ai_pid="$(runtime_ai_pid_hint_for_project "$project")"
  [[ -n "$ai_pid" ]] || return 1
  cycle_log="$(latest_cycle_log_for_project "$project")"
  [[ -n "$cycle_log" && -f "$cycle_log" ]] || return 1
  prompt_file="$(latest_prompt_file_for_project "$project")"
  [[ -n "$prompt_file" && -f "$prompt_file" ]] || return 1
  prompt_file_has_delegated_continuation "$prompt_file" || return 1

  log_mtime="$(file_mtime_epoch "$cycle_log" 2>/dev/null || true)"
  prompt_mtime="$(file_mtime_epoch "$prompt_file" 2>/dev/null || true)"
  [[ -n "$log_mtime" && -n "$prompt_mtime" ]] || return 1

  now="$(date +%s)"
