  if [[ "$cmd" == "--help" || "$cmd" == "-h" ]]; then
    usage
    exit 0
  fi
  [[ -n "$cmd" ]] || { usage; exit 1; }
  shift || true
  case "$cmd" in
    init) cmd_init "$@" ;;
    set-tool) cmd_set_tool "$@" ;;
    sync-tooling) cmd_sync_tooling "$@" ;;
    doctor) cmd_doctor "$@" ;;
    security-review-brief) cmd_security_review_brief "$@" ;;
    chat) cmd_chat "$@" ;;
    comment) cmd_comment "$@" ;;
    discuss) cmd_discuss "$@" ;;
    feedback) cmd_feedback "$@" ;;
    tui) cmd_tui "$@" ;;
    intake)
      local subcmd="${1:-}"
      shift || true
      case "$subcmd" in
        chat) cmd_intake_chat "$@" ;;
        claim) cmd_intake_claim "$@" ;;
        resolve) cmd_intake_resolve "$@" ;;
        status) cmd_intake_status "$@" ;;
        *) log_error "unknown intake subcommand: $subcmd"; usage; exit 1 ;;
      esac
      ;;
    ensure-manager) cmd_ensure_manager "$@" ;;
    auth-change-wake) cmd_auth_change_wake "$@" ;;
    ensure-interruption-dispatch) cmd_ensure_interruption_dispatch "$@" ;;
    ensure-sse-watchdog) cmd_ensure_sse_watchdog "$@" ;;
    start) cmd_start "$@" ;;
    daemon)
      local subcmd="${1:-}"
      shift || true
      case "$subcmd" in
        start) cmd_daemon_start "$@" ;;
        stop) cmd_daemon_stop "$@" ;;
        status) cmd_daemon_status "$@" ;;
        logs) cmd_daemon_logs "$@" ;;
        *) log_error "unknown daemon subcommand: $subcmd"; usage; exit 1 ;;
      esac
      ;;
    daemon-run) cmd_daemon_run "$@" ;;
    new-session) cmd_new_session "$@" ;;
    restart) cmd_restart "$@" ;;
    restore-work) cmd_restore_work "$@" ;;
    task-mode) cmd_task_mode "$@" ;;
    baseline-status) cmd_baseline_status "$@" ;;
    security-review-brief) cmd_security_review_brief "$@" ;;
    task-source-scan) cmd_task_source_scan "$@" ;;
    issue-sync) cmd_issue_sync "$@" ;;
    raw-issue-pull) cmd_raw_issue_pull "$@" ;;
    status) cmd_status "$@" ;;
    live-status) cmd_live_status "$@" ;;
    fleet-status) cmd_fleet_status "$@" ;;
    develop-push) cmd_develop_push "$@" ;;
    wt-create) cmd_wt_create "$@" ;;
    pr-create-guarded) cmd_pr_create_guarded "$@" ;;
    pr-merge-guarded) cmd_pr_merge_guarded "$@" ;;
    wt-close) cmd_wt_close "$@" ;;
    pr-review-guarded) cmd_pr_review_guarded "$@" ;;
    cycle) cmd_cycle "$@" ;;
    watchdog) cmd_watchdog "$@" ;;
    deploy-skills) cmd_deploy_skills "$@" ;;
    governance-check) cmd_governance_check "$@" ;;
    checkpoint-guard) cmd_checkpoint_guard "$@" ;;
    pretests-gate) cmd_pretests_gate "$@" ;;
    pretests-retirement-gate) cmd_pretests_retirement_gate "$@" ;;
    stop) cmd_stop "$@" ;;
    *) log_error "unknown command: $cmd"; usage; exit 1 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
  exit $?
fi
