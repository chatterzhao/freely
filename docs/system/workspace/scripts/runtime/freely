milestone_patrol_seed_snapshot_for_project() {
  local project="$1" limit="${2:-6}"
  local milestones_file
  milestones_file="$project/docs/milestones.md"
  [[ -f "$milestones_file" ]] || return 0
  python3 - "$milestones_file" "$limit" <<'PY'
import re
import sys
from pathlib import Path

milestones_path = Path(sys.argv[1])
limit = int(sys.argv[2])
lines = milestones_path.read_text(encoding="utf-8").splitlines()

results = []
current_milestone = None
current_milestone_active = False
current_queue = None
current_item = None

def flush_item():
    global current_item
    if not current_item or not current_milestone_active:
        current_item = None
        return
    queue = current_item.get("queue")
    phase_state = current_item.get("phase_state", "")
    item_status = current_item.get("status", "")
    if queue == "completed_issues":
        current_item = None
        return
    if queue == "committed_issues" and phase_state == "completed":
        current_item = None
        return
    if queue == "candidate_issues" and item_status == "dropped":
        current_item = None
        return
    results.append({
        "milestone": current_milestone,
        "queue": queue,
        "item_id": current_item.get("item_id", "unknown"),
        "title": current_item.get("title", "untitled"),
        "phase_state": phase_state or "unspecified",
        "priority": current_item.get("priority", "unspecified"),
        "next_action": current_item.get("next_action", "missing"),
        "issue_path": current_item.get("issue_path", ""),
        "progress_path": current_item.get("progress_path", ""),
    })
    current_item = None

for raw_line in lines:
    line = raw_line.rstrip()
    milestone_match = re.match(r"^##\s+(M-[A-Za-z0-9._-]+)\s*$", line)
    if milestone_match:
        flush_item()
        current_milestone = milestone_match.group(1)
        current_milestone_active = False
        current_queue = None
        continue
    if current_milestone and current_queue is None:
        status_match = re.match(r"^- status:\s*(.+?)\s*$", line.strip())
        if status_match:
            current_milestone_active = status_match.group(1).strip() == "active"
            continue
    queue_match = re.match(r"^###\s+(candidate_issues|committed_issues|completed_issues)\s*$", line)
    if queue_match:
        flush_item()
        current_queue = queue_match.group(1)
        continue
    item_match = re.match(r"^[0-9]+\.\s+`([^`]+)`\s*$", line.strip())
    if item_match and current_milestone and current_queue:
        flush_item()
        current_item = {"queue": current_queue, "item_id": item_match.group(1)}
        continue
    if current_item:
        field_match = re.match(r"^-\s+([A-Za-z0-9_]+):\s*(.*)$", line.strip())
        if field_match:
            key = field_match.group(1)
            value = field_match.group(2).strip()
            if value.startswith("`") and value.endswith("`") and len(value) >= 2:
                value = value[1:-1]
            current_item[key] = value

flush_item()

for item in results[:limit]:
    route_hint = "candidate_research"
    if item["queue"] == "committed_issues":
        route_hint = f"issue_continuation/{item['phase_state']}"
    print(
        f"- milestone={item['milestone']} queue={item['queue']} route_hint={route_hint} "
        f"item={item['item_id']} priority={item['priority']} phase_state={item['phase_state']} "
        f"title={item['title']} next_action={item['next_action']}"
    )
    if item["issue_path"]:
        print(f"  issue_path={item['issue_path']}")
    if item["progress_path"]:
        print(f"  progress_path={item['progress_path']}")
PY
}

pre_brainstorm_patrol_seed_snapshot_for_project() {
  local project="$1" limit="${2:-6}"
  local index_file
  index_file="$project/docs/B1-docs/INDEX.md"
  [[ -f "$index_file" ]] || return 0
  python3 - "$project" "$index_file" "$limit" <<'PY'
import re
import sys
from pathlib import Path

project_root = Path(sys.argv[1])
index_path = Path(sys.argv[2])
limit = int(sys.argv[3])

entries = []
for raw_line in index_path.read_text(encoding="utf-8").splitlines():
    match = re.match(r"^-\s+([0-9]{8}-[0-9]{4}--[A-Za-z0-9._-]+)\s*$", raw_line.strip())
    if match:
        entries.append(match.group(1))

results = []
for entry in entries:
    candidates_path = project_root / "docs" / "pre-brainstorms" / entry / "candidates.md"
    if not candidates_path.is_file():
        continue
    current = None
    for raw_line in candidates_path.read_text(encoding="utf-8").splitlines():
        line = raw_line.rstrip()
        heading_match = re.match(r"^###\s+(.+?)\s*$", line)
        if heading_match:
            if current:
                results.append(current)
            current = {
                "pre_brainstorm": entry,
                "candidate": heading_match.group(1).strip(),
            }
            continue
        if current is None:
            continue
        field_match = re.match(r"^-\s+([A-Za-z0-9_]+):\s*(.*)$", line.strip())
        if not field_match:
            continue
        key = field_match.group(1)
        value = field_match.group(2).strip()
        if value.startswith("`") and value.endswith("`") and len(value) >= 2:
            value = value[1:-1]
        current[key] = value
    if current:
        results.append(current)

count = 0
for item in results:
    candidate_status = item.get("candidate_status", "unspecified")
    phase_state = item.get("phase_state", "unspecified")
    promoted_issue = item.get("promoted_issue_path", "")
    if candidate_status in {"promoted", "absorbed", "dropped"}:
        continue
    if phase_state == "completed":
        continue
    if promoted_issue and promoted_issue != "pending://issue-materialization":
        continue
    print(
        f"- pre_brainstorm={item['pre_brainstorm']} candidate={item['candidate']} "
        f"candidate_status={candidate_status} phase_state={phase_state} "
        f"priority={item.get('priority', 'unspecified')} milestone={item.get('milestone', 'missing')} "
        f"next_action={item.get('next_action', 'missing')}"
    )
    count += 1
    if count >= limit:
        break
PY
}

progress_patrol_seed_snapshot_for_project() {
  local project="$1" limit="${2:-6}"
  local progress_root
  progress_root="$project/docs/progress"
  [[ -d "$progress_root" ]] || return 0
  python3 - "$progress_root" "$limit" <<'PY'
import re
import sys
from pathlib import Path

progress_root = Path(sys.argv[1])
limit = int(sys.argv[2])

results = []
for path in sorted(progress_root.rglob("p-*.md")):
    text = path.read_text(encoding="utf-8")
    lines = text.splitlines()
    data = {"path": str(path.relative_to(progress_root.parent))}
    next_action = "missing"
    in_next_action = False
    for raw_line in lines:
        line = raw_line.rstrip()
        header_match = re.match(r"^##\s+Next Action\s*$", line)
        if header_match:
            in_next_action = True
            continue
        if in_next_action:
            if re.match(r"^##\s+", line):
                in_next_action = False
            else:
                step_match = re.match(r"^(?:[0-9]+\.\s+|-\s+)(.+)$", line.strip())
                if step_match:
                    next_action = step_match.group(1).strip()
                    in_next_action = False
                    continue
        field_match = re.match(r"^-\s+([A-Za-z0-9_]+):\s*(.*)$", line.strip())
        if field_match:
            key = field_match.group(1)
            value = field_match.group(2).strip()
            if value.startswith("`") and value.endswith("`") and len(value) >= 2:
                value = value[1:-1]
            data[key] = value
    phase_state = data.get("phase_state", "unspecified")
    runtime_state = data.get("runtime_state", "unspecified")
    if phase_state == "completed":
      continue
    results.append({
        "issue_id": data.get("issue_id", "unknown"),
        "title": data.get("title", path.stem),
        "phase_state": phase_state,
        "runtime_state": runtime_state,
        "issue_path": data.get("issue_path", ""),
        "branch": data.get("branch", "unknown"),
        "worktree_path": data.get("worktree_path", ""),
        "updated_at": data.get("updated_at", "unknown"),
        "next_action": next_action,
        "path": data["path"],
    })

for item in results[:limit]:
    print(
        f"- issue={item['issue_id']} phase_state={item['phase_state']} runtime_state={item['runtime_state']} "
        f"title={item['title']} updated_at={item['updated_at']} next_action={item['next_action']}"
    )
    print(f"  progress_path={item['path']}")
    if item["issue_path"]:
        print(f"  issue_path={item['issue_path']}")
    if item["worktree_path"]:
        print(f"  worktree_path={item['worktree_path']}")
PY
}

