rewrite_existing_intake_item() {
  local project="$1" intake_id="$2" status="$3" classification="$4" linked_artifact="$5" delegated_worktree="$6" reaction="$7" claimed_by="$8" claimed_at="$9" absorption_target="${10:-}" resolution_artifact="${11:-}" session_refs_override="${12:-}"

  # New model: update docs/B1-docs/<id>/issue.md frontmatter
  if [[ "$intake_id" == raw-* || "$intake_id" == I-* ]]; then
    local issue_file="$project/docs/B1-docs/$intake_id/issue.md"
    [[ -f "$issue_file" ]] || { log_error "issue not found: $intake_id"; exit 1; }
    python3 -c "
import re, sys
with open('$issue_file') as f:
    content = f.read()
parts = content.split('---', 2)
if len(parts) >= 3:
    fm = parts[1]
    fm = re.sub(r'^status:.*', 'status: $status', fm, flags=re.MULTILINE)
    if '$claimed_by' and '$claimed_by' != 'None':
        fm = re.sub(r'^claimed_by:.*', 'claimed_by: $claimed_by', fm, flags=re.MULTILINE) if 'claimed_by:' in fm else fm + '\nclaimed_by: $claimed_by'
    if '$claimed_at' and '$claimed_at' != 'None':
        fm = re.sub(r'^claimed_at:.*', 'claimed_at: $claimed_at', fm, flags=re.MULTILINE) if 'claimed_at:' in fm else fm + '\nclaimed_at: $claimed_at'
    new_content = '---' + fm + '---' + parts[2]
    with open('$issue_file', 'w') as f:
        f.write(new_content)
" 2>/dev/null || true
    log_info "intake updated in docs/B1-docs/: $intake_id -> $status"
    return 0
  fi

  # Legacy: .freely/intake/ path
  local meta_file message_file author channel session_refs message created_at
  meta_file="$(intake_item_meta_file "$project" "$intake_id")"
  message_file="$(intake_item_message_file "$project" "$intake_id")"
  [[ -f "$meta_file" ]] || {
    log_error "intake item not found: $intake_id"
    exit 1
  }
  created_at="$(meta_env_value "$meta_file" "CREATED_AT")"
  author="$(meta_env_value "$meta_file" "AUTHOR")"
  channel="$(meta_env_value "$meta_file" "CHANNEL")"
  session_refs="$(meta_env_value "$meta_file" "SESSION_REFS")"
  [[ -n "$session_refs_override" ]] && session_refs="$session_refs_override"
  message="$(cat "$message_file" 2>/dev/null || true)"
  write_intake_item \
    "$project" "$intake_id" "$author" "$channel" "$status" "$classification" "$linked_artifact" "$delegated_worktree" "${session_refs:-[]}" "$message" \
    "$reaction" "$claimed_by" "$claimed_at" "$absorption_target" "$resolution_artifact" "$created_at"
}

