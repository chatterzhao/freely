- closeout_review_artifact_policy: ${closeout_review_artifact_policy:-unknown}
EOF
    if [[ "${intent_kind:-unknown}" == "cleanup" ]] && worker_prompt_has_verification_metadata "$prompt_file"; then
      cat >>"$(exit_contract_file "$project")" <<'EOF'

## Cleanup Reentry Requirement
- Repairing the missing worker exit contract is necessary, but it is not by itself a valid cleanup completion.
- Before claiming `worker_done`, return to the original cleanup closeout gate and produce bounded cleanup evidence outside the runtime repair artifacts.
- This round must classify the lane as exactly one of:
  - atomic_checkpoint_ready
  - split_required_with_target
  - retire_only_ready
  - blocked_need_manager_decision
- If that bounded cleanup classification cannot be proven this round, emit `worker_blocked` or `worker_handoff_needed` instead of a repair-only `worker_done`.
EOF
    fi
  fi
}

worker_exit_contract_summary_is_repair_only() {
  local summary="${1:-}" summary_lower
  [[ -n "$summary" ]] || return 1
  summary_lower="$(printf '%s' "$summary" | tr '[:upper:]' '[:lower:]')"
  [[ "$summary_lower" == *"no additional cleanup work"* ]] && return 0
  [[ "$summary_lower" == *"repair-first round"* ]] && return 0
  [[ "$summary_lower" == *"repair"* && "$summary_lower" == *"exit contract"* ]] && return 0
  return 1
}

worker_exit_contract_evidence_is_internal_repair_only() {
  local project="$1" evidence_paths_csv="${2:-}" contract_file contract_path item
  [[ -n "$evidence_paths_csv" ]] || return 1
  contract_file="$(worker_exit_contract_file "$project")"
  contract_path="$(exit_contract_file "$project")"
  IFS=',' read -r -a __freely_repair_evidence_items <<<"$evidence_paths_csv"
  ((${#__freely_repair_evidence_items[@]} > 0)) || return 1
  for item in "${__freely_repair_evidence_items[@]}"; do
    item="${item#"${item%%[![:space:]]*}"}"
    item="${item%"${item##*[![:space:]]}"}"
    [[ -n "$item" ]] || continue
    case "$item" in
      "$contract_file"|"$contract_path") ;;
      *) return 1 ;;
    esac
  done
  return 0
}

worker_exit_contract_repair_round_requires_cleanup_reentry() {
  local project="$1" prompt_file rotation_reason
  rotation_reason="$(session_handoff_rotation_reason "$project" || true)"
  [[ "$rotation_reason" == "worker_exit_contract_repair" ]] || return 1
  prompt_file="$(authoritative_worker_prompt_file_for_project "$project" || true)"
  [[ -n "$prompt_file" && -f "$prompt_file" ]] || return 1
  [[ "$(worker_prompt_normalized_intent_kind "$prompt_file")" == "cleanup" ]] || return 1
  worker_prompt_has_verification_metadata "$prompt_file"
}

worker_exit_contract_done_is_repair_only_cleanup_escape() {
  local project="$1" contract_file summary evidence_paths_csv
  worker_exit_contract_repair_round_requires_cleanup_reentry "$project" || return 1
  contract_file="$(worker_exit_contract_file "$project")"
  summary="$(_db_exit_contract_field "$project" worker completion_summary)"
  evidence_paths_csv="$(_db_exit_contract_field "$project" worker evidence_paths)"
  worker_exit_contract_summary_is_repair_only "$summary" || return 1
  worker_exit_contract_evidence_is_internal_repair_only "$project" "$evidence_paths_csv"
}

