# ── tool_switch_events helpers ──────────────────────────────────
# Read latest switch record from DB. Returns pipe-delimited string:
#   trigger_error|old_tool|old_session_id|old_jsonl|old_cycle_log|new_tool|new_session_id|cross_tool
# Returns empty if no record exists.
_tool_switch_read_latest() {
  local project="$1"
  local cli="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli"
  python3 "$cli" --project "$project" session.tool-switch-read 2>>"$project/.freely/run/db-daemon.log" || true
}

# Atomic write: stale all previous + insert new succeeded.
_tool_switch_atomic_write() {
  local project="$1" trigger_error="$2" old_tool="$3" old_session_id="$4"
  local old_jsonl="$5" old_cycle_log="$6" new_tool="$7" new_session_id="$8"
  local cli="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli"
  python3 "$cli" --project "$project" session.tool-switch-write \
    --trigger_error "$trigger_error" --old_tool "$old_tool" --old_session_id "$old_session_id" \
    --old_jsonl_path "$old_jsonl" --old_cycle_log "$old_cycle_log" \
    --new_tool "$new_tool" --new_session_id "$new_session_id" 2>>"$project/.freely/run/db-daemon.log" || true
}

# _resolve_tool_alias: resolve a tool name to its canonical form using the
# registry aliases field (comma-separated).  Returns the canonical name if
# the given name is an alias, otherwise returns the name unchanged.
_resolve_tool_alias() {
  local tool="$1"
  # Check all registered tools for a matching alias
  local _reg_tools _t _aliases
  _reg_tools="$(_tool_registry_tools 2>/dev/null || true)"
  for _t in $_reg_tools; do
    _aliases="$(_tool_registry_get "$_t" "aliases" 2>/dev/null || true)"
    [[ -n "$_aliases" ]] || continue
    if echo "$_aliases" | tr ',' '
' | grep -qFx "$tool"; then
      printf '%s
' "$_t"
      return 0
    fi
  done
  printf '%s
' "$tool"
}

# Determine launch kind from latest switch record.
# Returns: fresh|resume  (fresh means session/new needed)
_tool_switch_launch_kind() {
  local project="$1"
  local db_path; db_path="$project/.freely/freely.db"
  local record
  record="$(_tool_switch_read_latest "$project")" || { printf 'fresh\n'; return 0; }
  [[ -n "$record" ]] || { printf 'fresh\n'; return 0; }

  IFS='|' read -r _trig _old_tool _old_sid _old_jsonl _old_clog _new_tool _new_sid _cross_tool <<<"$record"
  local current_tool="${AGENT_AI_TOOL:-}"
  if [[ -z "$current_tool" ]]; then
    printf 'fresh\n'; return 0
  fi

  # Resolve aliases at the full tool name level before extracting base.
  # cc-use-codex-cli → claude, then base=claude; cc-apikey-xxx → cc (no alias)
  # → resolve → claude → base=claude.  Without this, cc != claude → cross_tool.
  local _canonical_current _canonical_recorded
  _canonical_current="$(_resolve_tool_alias "$current_tool")"
  _canonical_recorded="$(_resolve_tool_alias "$_new_tool")"
  local base_current="${_canonical_current%%-*}"
  local base_recorded="${_canonical_recorded%%-*}"
  if [[ "$base_current" != "$base_recorded" ]]; then
    printf 'fresh\n'; return 0  # cross-tool → force fresh
  fi

  # Same tool: try resume if old session ID exists in the record,
  # OR if there's an active session in the session-store.
  if [[ -n "$_new_sid" ]]; then
    printf 'resume\n'; return 0
  fi
  # No session ID in the record (e.g. bridge restart created a fresh one).
  # Fall back to session-store — if an active session exists for this tool,
  # resume it instead of forcing yet another fresh_with_handoff cycle.
  local _active_sid _base_tool
  _base_tool="${current_tool%%-*}"
  local _cli
  _cli="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli"
  _active_sid=$(python3 "$_cli" --project "$project" session.get-active \
    --role manager --tool-like "${_base_tool}%" 2>/dev/null || true)
  if [[ -n "$_active_sid" ]]; then
    printf 'resume\n'; return 0
  fi
  printf 'fresh\n'
}

prepare_manager_same_tool_slot_recovery_if_needed() {
  local project="$1"
  local current_tool last_exit_reason supervisor_pid ai_pid
  TOOL_AUTO_RECOVERY_SAME_TOOL_EXHAUSTED="0"
  TOOL_AUTO_RECOVERY_ENTRY_BLOCKED="0"
  TOOL_AUTO_RECOVERY_SLOT=""
  last_exit_reason=""
  if [[ -f "$(workcell_state_file "$project")" ]]; then
    unset LAST_EXIT_REASON
    # shellcheck disable=SC1090
    source "$(workcell_state_file "$project")"
    last_exit_reason="${LAST_EXIT_REASON:-}"
  fi
  manager_bootstrap_runtime_expected "$project" || return 1
  current_tool="${AGENT_AI_TOOL:-}"
  [[ -n "$current_tool" ]] || return 1
  tool_supports_auto_same_tool_slot_recovery "$current_tool" || return 1
  supervisor_pid="$(manager_supervisor_pid_for_project "$project")"
  ai_pid="$(manager_ai_pid_for_project "$project")"
  [[ -z "$supervisor_pid" && -z "$ai_pid" ]] || return 1

  if [[ -n "$last_exit_reason" ]]; then
    tool_failure_allows_same_tool_slot_recovery "$current_tool" "$last_exit_reason" || return 1
    if tool_select_ready_slot_for_manager_auto_recovery "$project" "$current_tool" "after_failure"; then
      record_tool_auto_switch_event "$project" "$current_tool" "$current_tool" "${TOOL_AUTO_RECOVERY_SLOT:-}" "same_tool_slot_recovery"
      return 0
    fi
    TOOL_AUTO_RECOVERY_SAME_TOOL_EXHAUSTED="1"
    return 1
  fi

  if tool_select_ready_slot_for_manager_auto_recovery "$project" "$current_tool" "entry"; then
    return 0
  fi
  TOOL_AUTO_RECOVERY_ENTRY_BLOCKED="1"
  return 1
}

prepare_manager_cross_tool_fallback_if_needed() {
  local project="$1" same_tool_exhausted="${2:-0}"
  local current_tool fallback_tool last_exit_reason supervisor_pid ai_pid
  local candidate earliest_tool earliest_slot fallback_slot hint_reset hint_info hint_slot
  TOOL_AUTO_RECOVERY_DECISION="none"
  last_exit_reason=""
  if [[ -f "$(workcell_state_file "$project")" ]]; then
    unset LAST_EXIT_REASON
    # shellcheck disable=SC1090
    source "$(workcell_state_file "$project")"
    last_exit_reason="${LAST_EXIT_REASON:-}"
  fi
  manager_bootstrap_runtime_expected "$project" || return 1
  config_bool_enabled "${AUTO_SWITCH_TOOL:-false}" || return 1
  current_tool="${AGENT_AI_TOOL:-}"
  [[ -n "$current_tool" ]] || return 1
  supervisor_pid="$(manager_supervisor_pid_for_project "$project")"
  ai_pid="$(manager_ai_pid_for_project "$project")"
  [[ -z "$supervisor_pid" && -z "$ai_pid" ]] || return 1
  if [[ "$same_tool_exhausted" != "1" && "${TOOL_AUTO_RECOVERY_ENTRY_BLOCKED:-0}" != "1" ]]; then
    tool_failure_allows_cross_tool_auto_recovery "$current_tool" "$last_exit_reason" "$same_tool_exhausted" || return 1
  fi

  earliest_tool=""
  earliest_reset=""
  earliest_slot=""
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    [[ "$candidate" != "${current_tool%%-*}" ]] || continue
    if tool_ready_for_manager_auto_recovery "$project" "$candidate"; then
      fallback_tool="$candidate"
      fallback_slot="${TOOL_AUTO_RECOVERY_SLOT:-}"
      break
    fi
    if hint_info="$(tool_earliest_recovery_hint_for_project "$project" "$candidate" 2>/dev/null || true)" && [[ -n "$hint_info" ]]; then
      hint_slot="${hint_info%%|*}"
      hint_reset="${hint_info##*|}"
      if [[ "$hint_reset" =~ ^[0-9]+$ ]] && [[ -z "$earliest_reset" || "$hint_reset" -lt "$earliest_reset" ]]; then
        earliest_tool="$candidate"
        earliest_slot="$hint_slot"
        earliest_reset="$hint_reset"
      fi
    fi
  done < <(runtime_auto_recovery_tool_order "$current_tool")

  if [[ -n "${fallback_tool:-}" ]]; then
    persist_project_tool_selection "$project" "$fallback_tool"
    # Kill old ACP bridge immediately so next cycle starts with new tool's binary
    _stop_acp_bridge "$project" "${_cross_base_tool:-}"
    FREELY_ACP_FIRST_LAUNCH_DONE=0
    runtime_clear_session_state_for_fresh_launch "$project"
    record_tool_auto_switch_event "$project" "$current_tool" "$fallback_tool" "${fallback_slot:-}" "$last_exit_reason"
    # Record switch in tool_switch_events table for session/bridge handling
    local _old_sid _old_jsonl _old_clog
    _old_sid="${LAST_TOOL_SESSION_ID:-}"
    _old_jsonl="${LAST_TOOL_JSONL_PATH:-}"
    _old_clog="${LAST_CYCLE_LOG:-}"
    _tool_switch_atomic_write "$project" "$last_exit_reason" "$current_tool" "$_old_sid" "$_old_jsonl" "$_old_clog" "$fallback_tool" ""
    load_config "$project"
    TOOL_AUTO_RECOVERY_DECISION="selected"
    return 0
  fi

  if [[ -n "$earliest_tool" && -n "$earliest_reset" ]]; then
    persist_project_tool_selection "$project" "$earliest_tool"
    _stop_acp_bridge "$project" "${_cross_base_tool:-}"
    runtime_clear_session_state_for_fresh_launch "$project"
    [[ -n "$earliest_slot" ]] && runtime_write_tool_current_slot "$earliest_tool" "$earliest_slot"
    record_tool_auto_switch_event "$project" "$current_tool" "$earliest_tool" "${earliest_slot:-}" "all_tools_unavailable" "$earliest_reset" "true" "waiting" "${earliest_slot:-}"
    load_config "$project"
    TOOL_AUTO_RECOVERY_DECISION="waiting"
  fi
  return 1
}

