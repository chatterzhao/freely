config_file() {
  local project="$1"
  echo "$(state_dir "$project")/config.env"
}

project_has_freely_config() {
  local project="$1"
  [[ -n "$project" && -f "$(config_file "$project")" ]]
}

looks_like_project_root() {
  local project="$1"
  [[ -n "$project" ]] || return 1
  [[ -f "$project/docs/PROJECT_INTENT.md" ]] || return 1
  [[ -f "$project/docs/CONSTITUTION.md" ]] || return 1
  [[ -f "$project/docs/LAWS.md" ]] || return 1
  [[ -f "$project/AGENTS.md" ]] || return 1
  [[ -d "$project/docs/pre-brainstorms" ]] || return 1
}

git_root_for_path() {
  local path="$1"
  git -C "$path" rev-parse --show-toplevel 2>/dev/null || true
}

register_project_in_registry() {
  local project="$1"
  local registry dir tmp now existing
  registry="$(projects_registry_file)"
  dir="$(dirname "$registry")"
  now="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  mkdir -p "$dir"
  tmp="$(mktemp "${dir}/projects.XXXXXX")"
  {
    printf '%s\t%s\n' "$project" "$now"
    if [[ -f "$registry" ]]; then
      awk -F '\t' -v project="$project" '$1 != project { print $0 }' "$registry"
    fi
  } >"$tmp"
  mv "$tmp" "$registry"
}

read_single_registered_project() {
  local registry first count
  registry="$(projects_registry_file)"
  [[ -f "$registry" ]] || return 0
  count="$(awk 'END { print NR }' "$registry")"
  [[ "$count" == "1" ]] || return 0
  awk -F '\t' 'NR==1 { print $1; exit }' "$registry"
}

resolve_project_or_fail() {
  local project="${1:-}" allow_uninitialized="${2:-0}"
  local candidate git_root registered
  if [[ -n "$project" ]]; then
    candidate="$(abs_path_or_fail "$project")"
  elif [[ -n "${FREELY_PROJECT:-}" ]]; then
    candidate="$(abs_path_or_fail "$FREELY_PROJECT")"
  else
    git_root="$(git_root_for_path "$PWD")"
    if [[ -n "$git_root" && -f "$(config_file "$git_root")" ]]; then
      candidate="$git_root"
    elif [[ -f "$(config_file "$PWD")" ]]; then
      candidate="$PWD"
    fi

    if [[ -z "$candidate" ]]; then
      registered="$(read_single_registered_project)"
      if [[ -n "$registered" && -f "$(config_file "$registered")" ]]; then
        candidate="$registered"
      fi
    fi

    if [[ -z "$candidate" && "$allow_uninitialized" == "1" ]]; then
      if [[ -n "$git_root" ]] && looks_like_project_root "$git_root"; then
        candidate="$git_root"
      elif looks_like_project_root "$PWD"; then
        candidate="$PWD"
      fi
    fi
  fi

  [[ -n "$candidate" ]] || {
    log_error "unable to resolve project; use --project, set FREELY_PROJECT, or run inside an initialized repo"
    exit 1
  }
  [[ -d "$candidate" ]] || {
    log_error "project not found: $candidate"
    exit 1
  }
  if [[ "$allow_uninitialized" != "1" ]]; then
    project_has_freely_config "$candidate" || {
      log_error "project is not initialized for freely: $candidate"
      log_error "run: freely init --project $candidate --intent <abs_file> --constitution <abs_file> --ai <tool[:model][:mode]>"
      exit 1
    }
  fi
  printf '%s\n' "$candidate"
}

