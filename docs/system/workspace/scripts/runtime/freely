  [[ -n "$continuity_file" && -f "$continuity_file" ]] || continuity_file="$(latest_generated_manager_continuity_file_for_project "$project")"
  resume_target="${LAST_TOOL_RESUME_TARGET:-}"
  if [[ -z "$resume_target" && -f "$session_file" ]]; then
    resume_target="$(meta_env_value "$session_file" "LAST_TOOL_RESUME_TARGET")"
  fi
  route_kind="$(manager_continuity_resume_focus_route_kind "$continuity_file" || true)"
  restart_point="$(_db_exit_contract_field "$project" manager restart_point)"
  next_action="$(_db_exit_contract_field "$project" manager next_action)"
  resume_reason="$(_db_exit_contract_field "$project" manager reason)"
  cat >"$(exit_contract_file "$project")" <<EOF
# Session Handoff

- rotation_reason: manager_exit_contract_resume
- previous_launch_kind: resume
- previous_tool_resume_target: ${resume_target:-unavailable}
- worktree_path: $project

## Continue Current Manager Lane
- reason: ${resume_reason:-manager_exit_contract_resume}
- contract_file: $contract_file
- continuity_file: ${continuity_file:-none}
- route_kind: ${route_kind:-unknown}
- restart_point: ${restart_point:-unknown}
- next_action: ${next_action:-unknown}
- reason: ${resume_reason:-unknown}
- details: ${details:-none}

## What To Handle First
- This is a valid manager continuation, not an exit-contract repair round.
- Reuse the same manager context and continue from the current continuity / restart point before widening back to broad patrol.
- If the current continuity is no longer authoritative, refresh the judgement against current fleet truth and write the next bounded manager continuity instead of replaying a stale repair step.
EOF
}

