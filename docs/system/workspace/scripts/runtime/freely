# _resurrect_dead_tools_batch: run once before fallback switching.  Queries the
# db for dead (tool, slot) pairs, assembles slot-specific test commands with
# ~/.ai-auth/{slot}/ credentials, runs each with 30s hard timeout.
# Pass → _tool_failure_clear that slot.  Fail/timeout → slot stays dead.
_resurrect_dead_tools_batch() {
  local project="$1"
  local _dead_json _count _tool _slot _test_cmd _rc
  local _db_cli="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli"
  _dead_json=$(python3 "$_db_cli" --project "$project" tool.failure-list-dead \
    --window_secs 3600 --threshold 3 2>/dev/null || true)
  [[ -n "$_dead_json" ]] || return 0
  _count=$(echo "$_dead_json" | python3 -c "import json,sys; print(len(json.load(sys.stdin).get('tools',[])))" 2>/dev/null || echo 0)
  [[ "$_count" -gt 0 ]] || return 0

  log_info "batch resurrection: $_count dead slot(s) to test"
  echo "$_dead_json" | python3 -c "
import json, sys
for t in json.load(sys.stdin).get('tools', []):
    print(f'{t[\"tool\"]}|{t[\"slot\"]}')
" | while IFS='|' read -r _tool _slot; do
    [[ -n "$_tool" && -n "$_slot" ]] || continue
    _test_cmd="$(ai_cli_tool_with_auth_assemble test "$_slot")"
    if [[ -z "$_test_cmd" ]]; then
      log_warn "dead slot $_slot: could not assemble test command (skip)"
      continue
    fi
    log_info "testing dead slot $_tool/$_slot: $_test_cmd"
    if perl -e 'alarm 30; exec @ARGV' -- bash -c "$_test_cmd" >/dev/null 2>&1; then
      _tool_failure_clear "$_tool" "$_slot"
      log_info "dead slot $_tool/$_slot resurrected"
    else
      _rc=$?
      log_warn "dead slot $_tool/$_slot remains dead (test_command failed, rc=$_rc)"
    fi
  done
}

# ── Agent Working shim — replaces agent-id.env reads ─────────────────
# Queries agent_working table and outputs in agent-id.env-compatible format.
# Format: worktree_path=role=agent_id (one per line)

_agent_working_read_all() {
  local project="$1"
  local _aw_py="${project}/docs/system/workspace/scripts/runtime/agent_working.py"
  if [[ -f "$_aw_py" ]]; then
    python3 -c "
import sys; sys.path.insert(0, '${project}/docs/system/workspace/scripts/runtime')
from agent_working import _db_rpc
result = _db_rpc('${project}', 'agent_working.get_all', {})
rows = result.get('rows', [])
for r in rows:
    for role in ('manager','worker','reviewer'):
        val = r.get(f'{role}_id','')
        if val:
            agent = val.split(':',1)[0] if ':' in str(val) else str(val)
            wt = r.get('worktree','')
            print(f'{wt}={role}={agent}')
            if role == 'reviewer':
                pairs = [p.split(':',1)[0] for p in str(val).split(',') if ':' in p]
                for a in pairs:
                    print(f'{r.get(\"test_worktree\",\"\")}={role}={a}')
" 2>/dev/null || true
  fi
}

