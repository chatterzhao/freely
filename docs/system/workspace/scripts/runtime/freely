merged_feature_worktree_entries_for_project() {
  local project="$1"
  local merged_branches wt_path branch line
  merged_branches="$(git -C "$project" branch --format='%(refname:short)' --merged develop 2>/dev/null | grep '^feature/' || true)"
  [[ -n "$merged_branches" ]] || return 0
  wt_path=""
  branch=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      "worktree "*)
        wt_path="${line#worktree }"
        ;;
      "branch refs/heads/"*)
        branch="${line#branch refs/heads/}"
        ;;
      "")
        if [[ -n "$wt_path" && -n "$branch" ]] && printf '%s\n' "$merged_branches" | grep -Fxq "$branch"; then
          printf '%s\t%s\n' "$wt_path" "$branch"
        fi
        wt_path=""
        branch=""
        ;;
    esac
  done < <(git -C "$project" worktree list --porcelain 2>/dev/null)
  if [[ -n "$wt_path" && -n "$branch" ]] && printf '%s\n' "$merged_branches" | grep -Fxq "$branch"; then
    printf '%s\t%s\n' "$wt_path" "$branch"
  fi
}

write_cleanup_followthrough_resolution_file() {
  local intake_id="$1" out_file="$2" cleaned="$3" retained="$4" blocked_reason="$5" next_restart_point="$6" next_ownership="$7" next_handoff="$8"
  cat >"$out_file" <<EOF
# Interruption Resolution
- intake_id: \`$intake_id\`
- intent_summary: 已检查 merged worktree 的 cleanup 收口状态。
- worker_action: \`cleanup-followthrough\`
- blocked_reason: ${blocked_reason:-none}
- cleaned_items:
$(if [[ -n "$cleaned" ]]; then printf '%s\n' "$cleaned" | sed 's/^/  - /'; else printf '  - none\n'; fi)
- retained_items:
$(if [[ -n "$retained" ]]; then printf '%s\n' "$retained" | sed 's/^/  - /'; else printf '  - none\n'; fi)
- next_restart_point: ${next_restart_point:-none}
- next_ownership: ${next_ownership:-none}
- next_handoff_summary: ${next_handoff:-none}
EOF
}

cleanup_followthrough_remote_name() {
  local project="$1"
  if git -C "$project" remote | grep -Fxq origin; then
    printf 'origin\n'
    return 0
  fi
  git -C "$project" remote | sed -n '1p'
}

cleanup_followthrough_pretests_gate_bin() {
  local project="$1"
  local project_gate runtime_root runtime_gate
  project_gate="$project/bin/pretests-retirement-gate"
  if [[ -e "$project_gate" ]]; then
    printf '%s\n' "$project_gate"
    return 0
  fi
  runtime_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
  runtime_gate="$runtime_root/bin/pretests-retirement-gate"
  printf '%s\n' "$runtime_gate"
}

run_cleanup_followthrough() {
  local project="$1" intake_id="$2" classification="$3" reaction="$4" why_text="$5" handoff_text="$6"
  local resolution_file blocked_reason cleaned retained wt_path branch dirty supervisor ai
  local remote_name remote_fetch_state remote_note remote_ref
  local resolution_status absorption_target linked_artifact next_restart_point next_ownership next_handoff ownership_claim local_intent_signature ownership_state ownership_branch ownership_ref ownership_status local_intent_status pretests_retirement_gate pretests_output pretests_reason retire_ready_reclaim="0" latest_prompt_file_for_reclaim=""
  blocked_reason=""
  cleaned=""
  retained=""
  next_restart_point=""
  next_ownership=""
  next_handoff=""
  pretests_retirement_gate="$(cleanup_followthrough_pretests_gate_bin "$project")"
  remote_name="$(cleanup_followthrough_remote_name "$project")"
  if [[ -n "$remote_name" ]]; then
    if git -C "$project" fetch "$remote_name" --prune >/dev/null 2>&1; then
      remote_fetch_state="ready"
    else
      remote_fetch_state="sync-failed"
    fi
  else
    remote_fetch_state="not-configured"
  fi

  normalized_project="$(normalize_runtime_worktree_path "$project")"
  while IFS=$'\t' read -r wt_path branch; do
    [[ -n "$wt_path" && -n "$branch" ]] || continue
    normalized_wt_path="$(normalize_runtime_worktree_path "$wt_path")"
    if [[ -n "$normalized_wt_path" && "$normalized_wt_path" == "$normalized_project" ]]; then
      continue
    fi
    retire_ready_reclaim="0"
    if retire_ready_merged_worktree_can_reclaim_ownership "$project" "$wt_path" "$branch"; then
      retire_ready_reclaim="1"
    fi
    latest_prompt_file_for_reclaim="$(latest_prompt_file_for_project "$wt_path")"
    dirty="$(git_status_porcelain_with_runtime_hygiene "$wt_path")"
    if [[ -n "$dirty" ]]; then
      retained="${retained}${retained:+$'\n'}${branch} @ ${wt_path} (dirty)"
      continue
    fi
    local_intent_signature="$(project_current_blocking_intent_signature "$wt_path")"
    if [[ -n "$local_intent_signature" ]]; then
      if worker_project_is_actively_running "$wt_path"; then
        retained="${retained}${retained:+$'\n'}${branch} @ ${wt_path} (ownership:local-intent:${local_intent_signature}:status=active)"
        continue
      fi
      local_intent_status="$(recorded_worker_ownership_status "$wt_path")"
      if [[ "$retire_ready_reclaim" != "1" && "$local_intent_status" != "hard_stale" ]]; then
        retained="${retained}${retained:+$'\n'}${branch} @ ${wt_path} (ownership:local-intent:${local_intent_signature}:status=${local_intent_status:-soft_stale})"
        continue
      fi
    fi
    ownership_claim="$(manager_project_ownership_claim_for_worktree "$project" "$wt_path")"
    if [[ -n "$ownership_claim" ]]; then
      IFS='|' read -r ownership_state ownership_branch ownership_ref ownership_status <<<"$(manager_worktree_ownership_claim_snapshot "$project" "$wt_path")"
      if [[ -n "$ownership_state" && "$ownership_state" != "none" ]]; then
        retained="${retained}${retained:+$'\n'}${branch} @ ${wt_path} (ownership:${ownership_state}:${ownership_branch:-unknown}@${ownership_ref}:status=${ownership_status:-unknown})"
      else
        retained="${retained}${retained:+$'\n'}${branch} @ ${wt_path} (ownership:${ownership_claim})"
      fi
      continue
    fi
    supervisor=""
    ai=""
    if [[ -f "$wt_path/.freely/run/supervisor.pid" ]]; then
      supervisor="$(cat "$wt_path/.freely/run/supervisor.pid" 2>/dev/null || true)"
    fi
    if [[ -f "$wt_path/.freely/run/ai.pid" ]]; then
      ai="$(cat "$wt_path/.freely/run/ai.pid" 2>/dev/null || true)"
    fi
    if ([[ -n "$supervisor" ]] && kill -0 "$supervisor" 2>/dev/null) || ([[ -n "$ai" ]] && kill -0 "$ai" 2>/dev/null); then
      retained="${retained}${retained:+$'\n'}${branch} @ ${wt_path} (runtime-active)"
      continue
    fi
    if [[ "$retire_ready_reclaim" == "1" ]] && ! worker_project_has_launchable_verification_contract "$wt_path"; then
      latest_prompt_file_for_reclaim="$(latest_prompt_file_for_project "$wt_path")"
    else
      latest_prompt_file_for_reclaim=""
    fi
    if [[ "$retire_ready_reclaim" == "1" && -n "$latest_prompt_file_for_reclaim" && -f "$latest_prompt_file_for_reclaim" ]]; then
      write_worker_verification_contract_file \
        "$(worker_verification_contract_state_file "$wt_path")" \
        "$latest_prompt_file_for_reclaim" \
        "" \
        "$wt_path"
    fi
    if [[ "$retire_ready_reclaim" == "1" ]] && [[ ! -f "$(workcell_state_file "$wt_path")" || ! -s "$(workcell_state_file "$wt_path")" ]]; then
      write_workcell_state "$wt_path" "stopped" "down" "down" "retire_ready_merged_worker"
    elif [[ "$retire_ready_reclaim" == "1" ]]; then
      write_workcell_state "$wt_path" "stopped" "down" "down" "retire_ready_merged_worker"
    fi
    if [[ ! -x "$pretests_retirement_gate" ]]; then
      retained="${retained}${retained:+$'\n'}${branch} @ ${wt_path} (pretests-retirement-gate-unavailable:${pretests_retirement_gate})"
      blocked_reason="${blocked_reason:-pretests_retirement_gate_unavailable}"
      continue
    fi
    if ! pretests_output="$("$pretests_retirement_gate" --project "$project" --worktree-path "$wt_path" 2>&1)"; then
      pretests_reason="$(printf '%s\n' "$pretests_output" | tr '\n' ';' | sed 's/;*$//' | sed 's/[[:space:]]\+/ /g')"
      retained="${retained}${retained:+$'\n'}${branch} @ ${wt_path} (pretests-retirement-blocked:${pretests_reason})"
      blocked_reason="${blocked_reason:-pretests_retirement_blocked}"
      continue
    fi
    remote_note="not-configured"
    case "$remote_fetch_state" in
      ready)
        remote_ref="refs/remotes/$remote_name/$branch"
        if git -C "$project" show-ref --verify --quiet "$remote_ref"; then
          if git -C "$project" merge-base --is-ancestor "$remote_ref" HEAD >/dev/null 2>&1; then
            if git -C "$project" push "$remote_name" --delete "$branch" >/dev/null 2>&1; then
              remote_note="$remote_name deleted"
            else
              retained="${retained}${retained:+$'\n'}${branch} @ ${wt_path} (remote-delete-failed:$remote_name)"
              continue
            fi
          else
            retained="${retained}${retained:+$'\n'}${branch} @ ${wt_path} (remote-unmerged:$remote_name)"
            continue
          fi
        else
          remote_note="$remote_name absent"
        fi
        ;;
      sync-failed)
        retained="${retained}${retained:+$'\n'}${branch} @ ${wt_path} (remote-sync-failed:$remote_name)"
        continue
        ;;
      not-configured)
        remote_note="not-configured"
        ;;
    esac
    if git -C "$project" worktree remove "$wt_path" >/dev/null 2>&1 && git -C "$project" branch -d "$branch" >/dev/null 2>&1; then
      if [[ -d "$wt_path" ]] || git -C "$project" show-ref --verify --quiet "refs/heads/$branch" >/dev/null 2>&1; then
        retained="${retained}${retained:+$'\n'}${branch} @ ${wt_path} (local-remove-postcheck-failed; remote:${remote_note})"
        blocked_reason="${blocked_reason:-cleanup_followthrough_postcheck_failed}"
        continue
      fi
      reset_project_runtime_discovery_cache "$project"
      retire_manager_worker_prompts_for_target "$project" "$wt_path" "$branch"
      cleaned="${cleaned}${cleaned:+$'\n'}${branch} @ ${wt_path} (remote:${remote_note})"
    else
      retained="${retained}${retained:+$'\n'}${branch} @ ${wt_path} (local-remove-failed; remote:${remote_note})"
    fi
  done < <(merged_feature_worktree_entries_for_project "$project")

  resolution_status="absorbed"
  absorption_target="cleanup://merged-worktree-followthrough"
  linked_artifact="cleanup://merged-worktree-followthrough"
  if [[ -n "$retained" ]]; then
    blocked_reason="${blocked_reason:-cleanup_followthrough_incomplete}"
    next_restart_point="continuation"
    next_ownership="manager"
    next_handoff="仍有 retained merged worktree 需要 fleet_closure / retirement_handoff 继续收口；先处理 retained_items，再重跑 cleanup followthrough。"
    resolution_status="delegated"
    absorption_target="handoff://continuation"
    linked_artifact="pending://cleanup-followthrough-continuation"
  fi

  resolution_file="$(mktemp /tmp/freely-interruption-cleanup-followthrough.XXXXXX)"
  write_cleanup_followthrough_resolution_file "$intake_id" "$resolution_file" "$cleaned" "$retained" "$blocked_reason" "$next_restart_point" "$next_ownership" "$next_handoff"
  cmd_intake_resolve \
    --project "$project" \
    --intake-id "$intake_id" \
    --resolved-by interruption-cleanup-worker \
    --reaction "${reaction:-followup}" \
    --classification "${classification:-control}" \
    --resolution-file "$resolution_file" \
    --absorption-target "$absorption_target" \
    --status "$resolution_status" \
    --linked-artifact "$linked_artifact" >/dev/null
  rm -f "$resolution_file"
}

run_interruption_handler_for_intake() {
  local handler_bin="$1" project="$2" intake_id="$3"
  local timeout_secs="${FREELY_INTERRUPTION_HANDLER_TIMEOUT_SECS:-30}"
  local stdout_file stderr_file meta_file rc

  [[ "$timeout_secs" =~ ^[0-9]+$ ]] || timeout_secs=30
  stdout_file="$(mktemp /tmp/freely-interruption-handler-stdout.XXXXXX)"
  stderr_file="$(mktemp /tmp/freely-interruption-handler-stderr.XXXXXX)"
  meta_file="$(mktemp /tmp/freely-interruption-handler-meta.XXXXXX)"
  INTERRUPTION_HANDLER_STDOUT=""
  INTERRUPTION_HANDLER_STDERR=""
  INTERRUPTION_HANDLER_TIMEOUT_SECS_USED="$timeout_secs"
  INTERRUPTION_HANDLER_ELAPSED_MS="unknown"
  INTERRUPTION_HANDLER_STDOUT_BYTES="0"
  INTERRUPTION_HANDLER_STDERR_BYTES="0"
  INTERRUPTION_HANDLER_EXIT_CODE="unknown"

  if python3 - "$handler_bin" "$project" "$intake_id" "$timeout_secs" "$stdout_file" "$stderr_file" "$meta_file" <<'PY'
import pathlib
import subprocess
import sys
import time

handler_bin = sys.argv[1]
project = sys.argv[2]
intake_id = sys.argv[3]
timeout_secs = int(sys.argv[4])
stdout_path = pathlib.Path(sys.argv[5])
stderr_path = pathlib.Path(sys.argv[6])
meta_path = pathlib.Path(sys.argv[7])

start = time.monotonic()
timed_out = False
rc = 0
stdout = ""
stderr = ""
try:
    completed = subprocess.run(
        [handler_bin, "--project", project, "--intake-id", intake_id],
        capture_output=True,
        text=True,
        timeout=timeout_secs,
        start_new_session=True,
        check=False,
    )
    rc = completed.returncode
    stdout = completed.stdout
    stderr = completed.stderr
except subprocess.TimeoutExpired as exc:
    timed_out = True
    rc = 124
    stdout = exc.stdout or ""
    stderr = exc.stderr or ""

elapsed_ms = int((time.monotonic() - start) * 1000)
stdout_path.write_text(stdout, encoding="utf-8")
stderr_path.write_text(stderr, encoding="utf-8")
meta_path.write_text(
    f"timed_out={'1' if timed_out else '0'}\n"
    f"elapsed_ms={elapsed_ms}\n"
    f"stdout_bytes={len(stdout.encode('utf-8'))}\n"
    f"stderr_bytes={len(stderr.encode('utf-8'))}\n"
    f"exit_code={rc}\n",
    encoding="utf-8",
)
raise SystemExit(rc)
PY
  then
    rc=0
  else
    rc=$?
  fi
  INTERRUPTION_HANDLER_STDOUT="$(cat "$stdout_file" 2>/dev/null || true)"
  INTERRUPTION_HANDLER_STDERR="$(cat "$stderr_file" 2>/dev/null || true)"
  INTERRUPTION_HANDLER_ELAPSED_MS="$(awk -F= '/^elapsed_ms=/{print $2; exit}' "$meta_file" 2>/dev/null || true)"
  INTERRUPTION_HANDLER_STDOUT_BYTES="$(awk -F= '/^stdout_bytes=/{print $2; exit}' "$meta_file" 2>/dev/null || true)"
  INTERRUPTION_HANDLER_STDERR_BYTES="$(awk -F= '/^stderr_bytes=/{print $2; exit}' "$meta_file" 2>/dev/null || true)"
  INTERRUPTION_HANDLER_EXIT_CODE="$(awk -F= '/^exit_code=/{print $2; exit}' "$meta_file" 2>/dev/null || true)"
  rm -f "$stdout_file" "$stderr_file" "$meta_file"

  if [[ "$rc" == "124" ]]; then
    return 124
  fi
  return "$rc"
}

apply_interruption_handler_failure_fallback_if_applicable() {
  local project="$1" intake_id="$2" failure_kind="$3"
  local role ai_pid reason_text handoff_text

  role="$(role_hint_for_project "$project")"
  [[ "$role" == "worker" ]] || return 1

  ai_pid="$(runtime_ai_pid_hint_for_project "$project")"
  [[ -n "$ai_pid" ]] || return 1
  kill -0 "$ai_pid" 2>/dev/null || return 1

  case "$failure_kind" in
    timeout)
      reason_text="triage 超时，保守交回当前 worker"
      ;;
    stderr)
      reason_text="triage 异常写 stderr，保守交回当前 worker"
      ;;
    nonzero|*)
      reason_text="triage 异常退出，保守交回当前 worker"
      ;;
  esac
  handoff_text="让当前 worker 继续当前 issue，并优先吸收这条插话"
  apply_interruption_manager_decision \
    "$project" "$intake_id" "delegate" "followup" "continuation" \
    "$reason_text" "continuation" "worker" "$handoff_text" ""
}

apply_interruption_manager_decision() {
  local project="$1" intake_id="$2" decision="$3" reaction="$4" classification="$5" why_text="$6" restart_point="$7" ownership="$8" handoff_text="$9" answer_text="${10}"
  local resolution_file
  validate_restart_point_or_fail "$restart_point"
  validate_signal_ownership_or_fail "$ownership"
  case "$decision" in
    answer)
      cmd_intake_claim --project "$project" --intake-id "$intake_id" --claimed-by interruption-manager-agent --reaction "${reaction:-followup}" --classification "${classification:-control}" --linked-artifact pending://interruption-manager-answer --from-checkpoint L331 --expected-from-previous L310\|L320 >/dev/null
      resolution_file="$(mktemp /tmp/freely-interruption-answer.XXXXXX)"
      write_manager_answer_resolution_file "$intake_id" "$resolution_file" "$answer_text" "$why_text" "$restart_point"
      cmd_intake_resolve \
        --project "$project" \
        --intake-id "$intake_id" \
        --resolved-by interruption-manager-agent \
        --reaction "${reaction:-followup}" \
        --classification "${classification:-control}" \
        --resolution-file "$resolution_file" \
        --absorption-target answer://manager-clarification \
        --from-checkpoint L310 \
        --expected-from-previous L320 \
        --linked-artifact answer://manager-clarification >/dev/null
      rm -f "$resolution_file"
      ;;
    delegate)
      cmd_intake_claim \
        --project "$project" \
        --intake-id "$intake_id" \
        --claimed-by interruption-manager-agent \
        --reaction "${reaction:-followup}" \
        --classification "${classification:-discovery}" \
        --from-checkpoint L331 \
        --expected-from-previous L310\|L320 \
        --linked-artifact pending://interruption-manager-delegation >/dev/null
      resolution_file="$(mktemp /tmp/freely-interruption-delegate.XXXXXX)"
      write_delegate_handoff_resolution_file "$intake_id" "$resolution_file" "$why_text" "${classification:-discovery}" "$restart_point" "$ownership" "$handoff_text"
      cmd_intake_resolve \
        --project "$project" \
        --intake-id "$intake_id" \
        --resolved-by interruption-manager-agent \
        --reaction "${reaction:-followup}" \
        --classification "${classification:-discovery}" \
        --resolution-file "$resolution_file" \
        --absorption-target "handoff://${restart_point:-pre_brainstorm}" \
        --status delegated \
        --from-checkpoint L310 \
        --expected-from-previous L320 \
        --linked-artifact pending://interruption-manager-delegation >/dev/null
      rm -f "$resolution_file"
      ;;
    *)
      return 1
      ;;
  esac
}

handle_interruption_intake_once() {
  local project="$1" intake_id="$2"
  local meta_file message_file status claimed_by handler_bin handler_output decision reaction classification why_text restart_point ownership handoff_text answer_text
  local lock_acquired="0"
  # Try new docs/B1-docs/ path first (raw-xxx or I-xxx)
  if [[ "$intake_id" == raw-* || "$intake_id" == I-* ]]; then
    issue_file="$project/docs/B1-docs/$intake_id/issue.md"
    [[ -f "$issue_file" ]] || return 1
    log_info "processing docs/B1-docs/ intake: $intake_id"
    # For now, skip full claim/resolve for new-model items (deferred to handler migration)
    return 0
  fi

  meta_file="$(intake_item_meta_file "$project" "$intake_id")"
  message_file="$(intake_item_message_file "$project" "$intake_id")"
  [[ -f "$meta_file" && -f "$message_file" ]] || return 1
  if ! acquire_interruption_triage_lock_for_intake "$project" "$intake_id"; then
    return 1
  fi
  lock_acquired="1"
  status="$(meta_env_value "$meta_file" "STATUS")"
  claimed_by="$(meta_env_value "$meta_file" "CLAIMED_BY")"
  if [[ "$status" != "new" || -n "$claimed_by" ]]; then
    release_interruption_triage_lock_for_intake "$project" "$intake_id"
    return 1
  fi

  cmd_intake_claim \
    --project "$project" \
    --intake-id "$intake_id" \
    --claimed-by interruption-manager-agent \
    --reaction followup \
    --from-checkpoint L300 \
    --expected-from-previous L310 \
    --linked-artifact pending://interruption-manager-triage >/dev/null
  append_lifecycle_trace_in "$project" "L330" "intake_handler_started" \
    "intake_id=$intake_id" \
    "handler=interruption-manager" \
    "next=run_handler" \
    "from_checkpoint=L310" \
    "expected_from_previous=L330"

  handler_bin="$(interruption_handler_bin_for_project "$project")"
  if [[ ! -x "$handler_bin" ]]; then
    log_warn "interruption handler missing or not executable; returning intake to new: $intake_id"
    append_lifecycle_trace_out "$project" "L330" "intake_handler_started" \
      "intake_id=$intake_id" \
      "handler=interruption-manager" \
      "to_checkpoint=L332"
    append_lifecycle_trace "$project" "L332" "intake_handler_path_unavailable" \
      "intake_id=$intake_id" \
      "trigger=handler_missing_or_not_executable" \
      "next=return_to_new" \
      "from_checkpoint=L330" \
      "expected_from_previous=L331|L332|L333|L334|L335|L336" \
      "expected_next=TERM"
    reset_intake_claim_for_retry "$project" "$intake_id"
    return 0
  fi
  if run_interruption_handler_for_intake "$handler_bin" "$project" "$intake_id"; then
    :
  else
    local handler_rc="$?"
    if [[ "$handler_rc" == "124" ]]; then
      log_warn "interruption handler timed out; attempting conservative fallback: $intake_id"
      append_lifecycle_trace_out "$project" "L330" "intake_handler_started" \
        "intake_id=$intake_id" \
        "handler=interruption-manager" \
        "to_checkpoint=L333"
      append_lifecycle_trace "$project" "L333" "intake_handler_failed" \
        "intake_id=$intake_id" \
        "trigger=timeout" \
        "timeout_secs=$INTERRUPTION_HANDLER_TIMEOUT_SECS_USED" \
        "elapsed_ms=${INTERRUPTION_HANDLER_ELAPSED_MS:-unknown}" \
        "stdout_bytes=${INTERRUPTION_HANDLER_STDOUT_BYTES:-0}" \
        "stderr_bytes=${INTERRUPTION_HANDLER_STDERR_BYTES:-0}" \
        "next=conservative_fallback_or_retry" \
        "from_checkpoint=L330" \
        "expected_from_previous=L331|L332|L333|L334|L335|L336" \
        "expected_next=TERM"
      if apply_interruption_handler_failure_fallback_if_applicable "$project" "$intake_id" "timeout"; then
        release_interruption_triage_lock_for_intake "$project" "$intake_id"
        return 0
      fi
      log_warn "interruption handler timed out; returning intake to new: $intake_id"
    else
      log_warn "interruption handler exited non-zero; attempting conservative fallback: $intake_id"
      append_lifecycle_trace_out "$project" "L330" "intake_handler_started" \
        "intake_id=$intake_id" \
        "handler=interruption-manager" \
        "to_checkpoint=L333"
      append_lifecycle_trace "$project" "L333" "intake_handler_failed" \
        "intake_id=$intake_id" \
        "trigger=nonzero_exit" \
        "exit_code=$handler_rc" \
        "elapsed_ms=${INTERRUPTION_HANDLER_ELAPSED_MS:-unknown}" \
        "stdout_bytes=${INTERRUPTION_HANDLER_STDOUT_BYTES:-0}" \
        "stderr_bytes=${INTERRUPTION_HANDLER_STDERR_BYTES:-0}" \
        "next=conservative_fallback_or_retry" \
        "from_checkpoint=L330" \
        "expected_from_previous=L331|L332|L333|L334|L335|L336" \
        "expected_next=TERM"
      if apply_interruption_handler_failure_fallback_if_applicable "$project" "$intake_id" "nonzero"; then
        release_interruption_triage_lock_for_intake "$project" "$intake_id"
        return 0
      fi
      log_warn "interruption handler exited non-zero; returning intake to new: $intake_id"
    fi
    reset_intake_claim_for_retry "$project" "$intake_id"
    release_interruption_triage_lock_for_intake "$project" "$intake_id"
    return 0
  fi
  handler_output="$INTERRUPTION_HANDLER_STDOUT"
  decision="$(printf '%s\n' "$handler_output" | awk -F= '/^DECISION=/{print substr($0,10); exit}')"
  if [[ -n "${INTERRUPTION_HANDLER_STDERR:-}" && -z "$decision" ]]; then
    log_warn "interruption handler wrote stderr without a decision; attempting conservative fallback: $intake_id"
    append_lifecycle_trace_out "$project" "L330" "intake_handler_started" \
      "intake_id=$intake_id" \
      "handler=interruption-manager" \
      "to_checkpoint=L334"
    append_lifecycle_trace "$project" "L334" "intake_handler_stderr_without_decision" \
      "intake_id=$intake_id" \
      "elapsed_ms=${INTERRUPTION_HANDLER_ELAPSED_MS:-unknown}" \
      "stdout_bytes=${INTERRUPTION_HANDLER_STDOUT_BYTES:-0}" \
      "stderr_bytes=${INTERRUPTION_HANDLER_STDERR_BYTES:-0}" \
      "next=conservative_fallback_or_retry" \
      "from_checkpoint=L330" \
      "expected_from_previous=L331|L332|L333|L334|L335|L336" \
      "expected_next=TERM"
    if apply_interruption_handler_failure_fallback_if_applicable "$project" "$intake_id" "stderr"; then
      release_interruption_triage_lock_for_intake "$project" "$intake_id"
      return 0
    fi
    log_warn "interruption handler wrote stderr without a decision; returning intake to new: $intake_id"
    reset_intake_claim_for_retry "$project" "$intake_id"
    release_interruption_triage_lock_for_intake "$project" "$intake_id"
    return 0
  fi
  if [[ -n "${INTERRUPTION_HANDLER_STDERR:-}" && -n "$decision" ]]; then
    log_warn "interruption handler wrote stderr alongside a decision; continuing with stdout decision: $intake_id"
    append_lifecycle_trace_out "$project" "L330" "intake_handler_started" \
      "intake_id=$intake_id" \
      "handler=interruption-manager" \
      "to_checkpoint=L335"
    append_lifecycle_trace "$project" "L335" "intake_handler_stderr_with_decision" \
      "intake_id=$intake_id" \
      "decision=$decision" \
      "elapsed_ms=${INTERRUPTION_HANDLER_ELAPSED_MS:-unknown}" \
      "stdout_bytes=${INTERRUPTION_HANDLER_STDOUT_BYTES:-0}" \
      "stderr_bytes=${INTERRUPTION_HANDLER_STDERR_BYTES:-0}" \
      "next=continue_with_stdout_decision" \
      "from_checkpoint=L330" \
      "expected_from_previous=L331|L332|L333|L334|L335|L336" \
      "expected_next=L331"
  fi
  reaction="$(printf '%s\n' "$handler_output" | awk -F= '/^REACTION=/{print substr($0,10); exit}')"
  classification="$(printf '%s\n' "$handler_output" | awk -F= '/^CLASSIFICATION=/{print substr($0,16); exit}')"
  restart_point="$(printf '%s\n' "$handler_output" | awk -F= '/^RESTART_POINT=/{print substr($0,15); exit}')"
  ownership="$(printf '%s\n' "$handler_output" | awk -F= '/^OWNERSHIP=/{print substr($0,11); exit}')"
  why_text="$(printf '%s\n' "$handler_output" | awk -F= '/^WHY=/{print substr($0,5); exit}')"
  handoff_text="$(printf '%s\n' "$handler_output" | awk -F= '/^HANDOFF=/{print substr($0,9); exit}')"
  answer_text="$(printf '%s\n' "$handler_output" | awk -F= '/^ANSWER=/{print substr($0,8); exit}')"
  IFS='|' read -r classification restart_point ownership <<<"$(normalize_interruption_manager_contract "$classification" "$restart_point" "$ownership")"
  if [[ -z "$decision" ]]; then
    log_warn "interruption handler returned no decision; returning intake to new: $intake_id"
    append_lifecycle_trace_out "$project" "L330" "intake_handler_started" \
      "intake_id=$intake_id" \
      "handler=interruption-manager" \
      "to_checkpoint=L336"
    append_lifecycle_trace "$project" "L336" "intake_handler_no_decision" \
      "intake_id=$intake_id" \
      "next=return_to_new" \
      "from_checkpoint=L330" \
      "expected_from_previous=L331|L332|L333|L334|L335|L336" \
      "expected_next=TERM"
    reset_intake_claim_for_retry "$project" "$intake_id"
    release_interruption_triage_lock_for_intake "$project" "$intake_id"
    return 0
  fi
  local decision_from_checkpoint="L330"
  if [[ -n "${INTERRUPTION_HANDLER_STDERR:-}" && -n "$decision" ]]; then
    decision_from_checkpoint="L335"
  else
    append_lifecycle_trace_out "$project" "L330" "intake_handler_started" \
      "intake_id=$intake_id" \
      "handler=interruption-manager" \
      "to_checkpoint=L331"
  fi
  append_lifecycle_trace_in "$project" "L331" "intake_handler_decision_parsed" \
    "intake_id=$intake_id" \
    "decision=$decision" \
    "reaction=${reaction:-followup}" \
    "classification=${classification:-unclassified}" \
    "restart_point=${restart_point:-unknown}" \
    "ownership=${ownership:-unknown}" \
    "elapsed_ms=${INTERRUPTION_HANDLER_ELAPSED_MS:-unknown}" \
    "stdout_bytes=${INTERRUPTION_HANDLER_STDOUT_BYTES:-0}" \
    "stderr_bytes=${INTERRUPTION_HANDLER_STDERR_BYTES:-0}" \
    "from_checkpoint=$decision_from_checkpoint" \
    "expected_from_previous=L331"
  append_lifecycle_trace_out "$project" "L331" "intake_handler_decision_parsed" \
    "intake_id=$intake_id" \
    "decision=$decision" \
    "reaction=${reaction:-followup}" \
    "classification=${classification:-unclassified}" \
    "restart_point=${restart_point:-unknown}" \
    "ownership=${ownership:-unknown}" \
    "to_checkpoint=L310"
  apply_interruption_manager_decision "$project" "$intake_id" "$decision" "$reaction" "$classification" "$why_text" "$restart_point" "$ownership" "$handoff_text" "$answer_text"
  [[ "$lock_acquired" == "1" ]] && release_interruption_triage_lock_for_intake "$project" "$intake_id"
}

ensure_interruption_dispatch_once() {
  local project="$1"
  local run_dir pid_file existing_pid item_dir intake_id handled_any
  run_dir="$(run_dir_for_project "$project")"
  mkdir -p "$run_dir"
  recover_stale_interruption_triage_claims "$project"
  handled_any="0"
  while IFS= read -r item_dir; do
    intake_id="$(basename "$item_dir")"
    if handle_interruption_intake_once "$project" "$intake_id"; then
      handled_any="1"
    fi
  done < <(find "$(intake_dir_for_project "$project")" -mindepth 1 -maxdepth 1 -type d | sort)

  # Also process new raw issues from docs/B1-docs/ (IBM Framework B1_IBM)
  local issues_dir="$project/docs/B1-docs"
  if [[ -d "$issues_dir" ]]; then
    for raw_dir in "$issues_dir"/raw-*/; do
      [[ -d "$raw_dir" ]] || continue
      local raw_id raw_file frontmatter_status
      raw_id="$(basename "$raw_dir")"
      raw_file="$raw_dir/issue.md"
      [[ -f "$raw_file" ]] || continue
      # Check if already claimed/resolved (status in frontmatter)
      frontmatter_status="$(sed -n '/^---$/,/^---$/p' "$raw_file" | grep "^status:" | sed 's/^status: *//' | tr -d '"' 2>/dev/null || echo "proposed")"
      if [[ "$frontmatter_status" == "proposed" ]]; then
        if handle_interruption_intake_once "$project" "$raw_id"; then
          handled_any="1"
        fi
      fi
    done
  fi

  if [[ "$handled_any" == "1" ]]; then
    log_info "interruption dispatcher handled intake(s)"
  fi

  # Periodically mark old consumed chats as stale (consumed=-1).
  # Preserves audit trail but removes from active view.
  local _db_path
  _db_path="$project/.freely/freely.db"
  if [[ -f "$_db_path" ]]; then
    python3 -c "
import sqlite3, time
try:
    db = sqlite3.connect('$_db_path')
    cutoff = int(time.time()) - 7*86400  # 7 days
    db.execute(\"UPDATE chats SET consumed = -1 WHERE consumed = 1 AND CAST(created_at AS INTEGER) < ?\", (cutoff,))
    db.commit()
    db.close()
except: pass
" 2>/dev/null || true
  fi
}

cmd_ensure_interruption_dispatch_watch() {
  local project="$1" interval="$2" pid_file existing_pid
  pid_file="$(interruption_dispatcher_pid_file "$project")"
  mkdir -p "$(dirname "$pid_file")"

  if [[ -f "$pid_file" ]]; then
    existing_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ "$existing_pid" != "$$" ]] && valid_interruption_dispatcher_pid_for_project "$project" "$existing_pid"; then
      log_info "interruption dispatcher already running (pid=$existing_pid)"
      return 0
    fi
  fi

  echo "$$" >"$pid_file"
  trap "rm -f '$pid_file'" EXIT

  while true; do
    if [[ -f "$(stop_marker_file "$project")" ]]; then
      exit 0
    fi
    if [[ -f "$(intake_pending_signal_file "$project")" ]]; then
      ensure_interruption_dispatch_once "$project"
    fi
    sleep "$interval"
  done
}

_start_watchdog_sse_py() {
  local project="$1"
  local _watchdog_py="${project}/docs/system/workspace/scripts/runtime/watchdog_sse.py"
  local _a2a_socket; _a2a_socket="/tmp/freely-a2a-$(python3 -c "import hashlib,os; print(hashlib.sha256(os.path.abspath('${project}').encode()).hexdigest()[:16])" 2>/dev/null).sock"
  # Guard: don't launch if already running (prevents duplicate instances on restart)
  local _pid_file; _pid_file="$(run_dir_for_project "$project")/watchdog-sse.pid"
  if [[ -f "$_pid_file" ]]; then
    local _existing_pid; _existing_pid=$(cat "$_pid_file" 2>/dev/null || true)
    if [[ -n "$_existing_pid" ]] && kill -0 "$_existing_pid" 2>/dev/null; then
      return 0
    fi
    rm -f "$_pid_file"
  fi
  if [[ -f "$_watchdog_py" && -S "$_a2a_socket" ]]; then
    log_info "starting watchdog_sse.py for $project"
    nohup python3 "$_watchdog_py" --project "$project" --a2a-socket "$_a2a_socket" </dev/null >>"$project/.freely/run/watchdog-sse.log" 2>&1 &
    echo $! > "$_pid_file"
    disown $!
  fi
}

cmd_ensure_sse_watchdog_watch() {
  local project="$1" interval="$2" pid_file existing_pid
  pid_file="$(sse_watchdog_pid_file "$project")"
  mkdir -p "$(dirname "$pid_file")"

  if [[ -f "$pid_file" ]]; then
    existing_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ "$existing_pid" != "$$" ]] && valid_sse_watchdog_pid_for_project "$project" "$existing_pid"; then
      log_info "SSE watchdog already running (pid=$existing_pid)"
      return 0
    fi
    rm -f "$pid_file"
  fi

  echo "$$" >"$pid_file"
  trap "rm -f '$pid_file'; exit 0" INT TERM HUP
  trap "rm -f '$pid_file'" EXIT

  while true; do
    if [[ -f "$(stop_marker_file "$project")" ]]; then
      exit 0
    fi
    if ! bash "$_sse_watchdog_sh" --project "$project" --watch --interval 10; then
      log_warn "SSE watchdog iteration failed, retrying"
    fi
    sleep "$interval"
  done
}

cmd_ensure_manager_watch() {
  local project="$1" interval="$2" pid_file run_dir existing_pid
  run_dir="$(run_dir_for_project "$project")"
  pid_file="$(ensure_manager_watchdog_pid_file "$project")"
  mkdir -p "$run_dir"

  if [[ -f "$pid_file" ]]; then
    existing_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ "$existing_pid" != "$$" ]] && valid_ensure_manager_watchdog_pid_for_project "$project" "$existing_pid"; then
      log_info "ensure-manager watchdog already running (pid=$existing_pid)"
      return 0
    fi
    rm -f "$pid_file"
  fi

  echo "$$" >"$pid_file"
