  primary_row="$(manager_cleanup_prompt_primary_target_row_from_continuity "$project" "$continuity_file")"
  [[ -n "$primary_row" ]] || return 1
  IFS='|' read -r primary_path primary_branch _desired _role_hint _section_key _disposition <<<"$primary_row"
  [[ -n "$primary_path" && -d "$primary_path" && -n "$primary_branch" ]] || return 1

  owner_issue_rel="$(manager_continuity_backtick_field_value "$continuity_file" "issue_truth")"
  if [[ -n "$owner_issue_rel" ]]; then
    owner_issue_source="$project/$owner_issue_rel"
    if [[ -f "$owner_issue_source" ]]; then
      pre_tests_rel="$(markdown_backtick_field_value "$owner_issue_source" "pre_tests_path")"
      verification_rel="$(markdown_backtick_field_value "$owner_issue_source" "verification_artifact_dir")"
      owner_issue_abs="$primary_path/$owner_issue_rel"
      [[ -f "$owner_issue_abs" ]] || owner_issue_abs="$owner_issue_source"
      [[ -n "$pre_tests_rel" ]] && pre_tests_rel="$primary_path/$pre_tests_rel"
      [[ -n "$verification_rel" ]] && verification_rel="$primary_path/$verification_rel"
      issue_id="$(markdown_backtick_field_value "$owner_issue_source" "issue_id")"
    fi
  fi

  source_prompt_file="$(authoritative_worker_prompt_file_for_project "$primary_path" || true)"
  if [[ -z "$source_prompt_file" || ! -f "$source_prompt_file" ]] \
    || ! worker_prompt_has_verification_metadata "$source_prompt_file"; then
    source_prompt_file="$(manager_cleanup_source_prompt_file_from_continuity "$project" "$continuity_file" "$primary_path" || true)"
  fi
  if [[ -n "$source_prompt_file" && -f "$source_prompt_file" ]] \
    && worker_prompt_has_verification_metadata "$source_prompt_file"; then
    owner_issue_abs="$(worker_prompt_owner_issue "$source_prompt_file")"
    pre_tests_rel="$(worker_prompt_pre_tests_path "$source_prompt_file")"
    verification_rel="$(worker_prompt_verification_artifact_dir "$source_prompt_file")"
    required_test_lanes_csv="$(worker_prompt_required_test_lanes_csv "$source_prompt_file")"
    required_acceptance_ids_csv="$(worker_prompt_required_acceptance_item_ids_csv "$source_prompt_file")"
    minimum_evidence_level="$(worker_prompt_minimum_evidence_level "$source_prompt_file")"
    target_environment="$(worker_prompt_target_environment "$source_prompt_file")"
    closeout_gate="$(worker_prompt_closeout_gate "$source_prompt_file")"
    closeout_gate_command="$(worker_prompt_closeout_gate_command "$source_prompt_file")"
    closeout_target_lane="$(worker_prompt_closeout_target_lane "$source_prompt_file")"
    closeout_promotion_gate="$(worker_prompt_closeout_promotion_gate "$source_prompt_file")"
    closeout_requires_adequacy="$(worker_prompt_closeout_requires_adequacy "$source_prompt_file")"
    closeout_review_artifact_policy="$(worker_prompt_closeout_review_artifact_policy "$source_prompt_file")"
    if [[ -f "$owner_issue_abs" ]]; then
      issue_id="$(markdown_backtick_field_value "$owner_issue_abs" "issue_id")"
    fi
  fi

  if [[ -n "$owner_issue_abs" && "$owner_issue_abs" != /* ]]; then
    owner_issue_abs="$primary_path/$owner_issue_abs"
  fi
  if [[ -n "$pre_tests_rel" && "$pre_tests_rel" != /* ]]; then
    pre_tests_rel="$primary_path/$pre_tests_rel"
  fi
  if [[ -n "$verification_rel" && "$verification_rel" != /* ]]; then
    verification_rel="$primary_path/$verification_rel"
  fi

  [[ -n "$owner_issue_abs" && -n "$pre_tests_rel" && -n "$verification_rel" ]] || return 1
  [[ -n "$issue_id" ]] || issue_id="$(manager_continuity_cleanup_issue_id "$continuity_file")"
  [[ -n "$issue_id" ]] || issue_id="cleanup-governance"
  [[ -n "$required_test_lanes_csv" ]] || required_test_lanes_csv="cleanup-followthrough"
  [[ -n "$required_acceptance_ids_csv" ]] || required_acceptance_ids_csv="cleanup-governance-retirement-handoff"
  [[ -n "$minimum_evidence_level" ]] || minimum_evidence_level="cleanup followthrough evidence plus worktree retirement disposition"
  [[ -n "$target_environment" ]] || target_environment="$(printf '%s cleanup_governance retirement followthrough' "$issue_id")"
  [[ -n "$closeout_gate" ]] || closeout_gate="Only claim closeout after the retained merged cleanup targets are retired or explicitly left with bounded followthrough evidence"
  [[ -n "$closeout_gate_command" ]] || closeout_gate_command="freely daemon start --project $project"
  [[ -n "$closeout_target_lane" ]] || closeout_target_lane="develop"
  [[ -n "$closeout_promotion_gate" ]] || closeout_promotion_gate="Retire retained merged worktrees for $issue_id without reopening replay"
  [[ -n "$closeout_requires_adequacy" ]] || closeout_requires_adequacy="true"
  [[ -n "$closeout_review_artifact_policy" ]] || closeout_review_artifact_policy="Append cleanup receipts, retained-vs-retired disposition, and fleet closeout evidence to the owner verification artifact"

  cleanup_selected_tool="$(manager_continuity_backtick_field_value "$continuity_file" "selected_tool")"
  if [[ -z "$cleanup_selected_tool" ]]; then
    current_truth="$(project_tool_runtime_selection_truth "$project")"
    IFS='|' read -r current_tool _ <<<"$current_truth"
    cleanup_selected_tool="${current_tool:-${AGENT_AI_TOOL:-}}"
  fi

  prompt_file="$(manager_cleanup_prompt_file_for_continuity "$project" "$continuity_file")"
  mkdir -p "$(dirname "$prompt_file")"
  {
    printf 'Worktree:\n'
    printf -- '- `%s`\n' "$primary_path"
    printf 'Branch:\n'
    printf -- '- `%s`\n' "$primary_branch"

    # 如果是保护工位，查找配对的可写工位
    if [[ "$primary_branch" == test-pre-merge-* ]]; then
      local raw_key companion_wt companion_branch
      raw_key="$(echo "$primary_branch" | grep -oE '[0-9]{8}T[0-9]{4,6}Z' | head -1)"
      if [[ -n "$raw_key" ]]; then
        companion_wt="$(git -C "$ROOT_DIR" worktree list --porcelain 2>/dev/null | awk -v key="$raw_key" '
          /^worktree / { wt=$2 }
          /^branch/ && $2 ~ "refs/heads/(fix|feature)/raw-"key"-" { print wt; exit }
        ')"
        companion_branch="$(git -C "$ROOT_DIR" worktree list --porcelain 2>/dev/null | awk -v key="$raw_key" '
          /^branch/ && $2 ~ "refs/heads/(fix|feature)/raw-"key"-" { sub("refs/heads/","",$2); print $2; exit }
        ')"
      fi
      if [[ -n "$companion_wt" ]]; then
        printf '\n## 工位可写性\n'
        printf '当前工位是 test-pre-merge（保护工位，不可 add/commit/push）。\n'
        printf '配对的**可写工位**已存在：\n'
        printf -- '- 路径: `%s`\n' "$companion_wt"
        printf -- '- 分支: `%s`\n' "$companion_branch"
        if [[ "$companion_branch" == fix/* ]]; then
          printf 'freely-fix-execution 模式: test-pre-merge 可临时修改测试（dirty only），实际提交需 cd 到上述路径后 commit。\n'
        elif [[ "$companion_branch" == feature/* ]]; then
          printf 'freely-feature-execution 模式: 所有开发和提交需在 feature 工位进行，不在当前工位修改。\n'
        fi
      fi
    fi
    printf 'dispatch_priority: `P0`\n'
    printf 'parallel_safe: `false`\n'
    printf 'write_scope:\n'
    while IFS= read -r write_scope_path; do
      [[ -n "$write_scope_path" ]] || continue
      printf -- '- `%s`\n' "$write_scope_path"
    done < <(manager_cleanup_prompt_write_scope_paths_from_continuity "$project" "$continuity_file")
    printf 'intent_kind: `cleanup`\n'
    printf 'intent_target: `%s`\n' "$primary_path"
    if [[ -n "$cleanup_selected_tool" ]]; then
      printf -- '- selected_tool: `%s`\n' "$cleanup_selected_tool"
    fi
    printf 'Owner-Issue:\n'
    printf -- '- `%s`\n' "$owner_issue_abs"
    printf 'Pre-Tests-Path:\n'
    printf -- '- `%s`\n' "$pre_tests_rel"
    printf 'Verification-Artifact-Dir:\n'
    printf -- '- `%s`\n' "$verification_rel"
    printf 'Required-Test-Lanes:\n'
    while IFS= read -r write_scope_path; do
      [[ -n "$write_scope_path" ]] || continue
      printf -- '- `%s`\n' "$write_scope_path"
    done < <(printf '%s\n' "$required_test_lanes_csv" | tr ',' '\n')
    printf 'Required-Acceptance-Item-Ids:\n'
    while IFS= read -r write_scope_path; do
      [[ -n "$write_scope_path" ]] || continue
      printf -- '- `%s`\n' "$write_scope_path"
    done < <(printf '%s\n' "$required_acceptance_ids_csv" | tr ',' '\n')
    printf 'Minimum-Evidence-Level: `%s`\n' "$minimum_evidence_level"
    printf 'Target-Environment: `%s`\n' "$target_environment"
    printf 'Closeout-Gate: `%s`\n' "$closeout_gate"
    printf 'Closeout-Gate-Command: `%s`\n' "$closeout_gate_command"
    printf 'Closeout-Target-Lane: `%s`\n' "$closeout_target_lane"
    printf 'Closeout-Promotion-Gate: `%s`\n' "$closeout_promotion_gate"
    printf 'Closeout-Requires-Adequacy: `%s`\n' "$closeout_requires_adequacy"
    printf 'Closeout-Review-Artifact-Policy: `%s`\n' "$closeout_review_artifact_policy"
    printf '\nManager-Continuity:\n'
    printf -- '- `%s`\n' "$continuity_file"
    printf '\nYou are not alone in the codebase. Do not revert other people'\''s changes. Adjust to concurrent truth if a newer manager continuity lands while you work.\n'
    printf '\nStay inside `%s`. This is cleanup_governance followthrough, not a new replay lane.\n' "$issue_id"
    printf '\nExecution contract:\n'
    printf '1. Start from `%s`.\n' "$primary_path"
    printf '2. Reconcile the owner issue/progress/verification surfaces to reflect absorbed merged cleanup truth instead of replay truth.\n'
    printf '3. Use the retained merged worktrees in `write_scope` as the cleanup/retirement boundary for this owner.\n'
    printf '4. Leave explicit retirement-ready evidence for each retained merged worktree you do not retire directly.\n'
    printf '5. If cleanup closes successfully, leave the lane ready for manager fleet closure and next-task patrol.\n'
  } >"$prompt_file"

  append_manager_cleanup_worker_prompt_reference_to_continuity "$continuity_file" "$prompt_file" "$issue_id" || return 1
  append_runtime_event "$project" "manager_cleanup_worker_prompt_materialized" \
    "continuity=$(basename "$continuity_file")" \
    "prompt=$(basename "$prompt_file")" \
    "target_branch=$primary_branch"
  printf '%s\n' "$prompt_file"
}

