launch_manager_supervisor() {
  local project="$1"
  local launch_bin launch_mode launch_mode_command
  launch_bin="${FREELY_ENSURE_MANAGER_LAUNCH_BIN:-$SELF_ROOT/bin/freely}"
  launch_mode="$(project_control_plane_entrypoint_mode "$project")"
  launch_mode_command="start"
  if [[ "$launch_mode" == "daemon" ]]; then
    launch_mode_command="daemon-run"
  fi
  # Kill orphaned monitor-ai-acp.sh processes that survived a bridge crash.
  # These zombies block supervisor restart by holding PID files and resources.
  _cleanup_orphaned_monitors "$project"
  clear_execution_network_state "$project"
  if [[ -n "${FREELY_ENSURE_MANAGER_LAUNCH_BIN:-}" ]]; then
    # Test launch shims are synchronous evidence points; avoid background races in focused regressions.
    bash "$launch_bin" "$launch_mode_command" --project "$project" </dev/null >/dev/null 2>&1
    return 0
  fi
  local _restart_mode; _restart_mode="$(read_task_mode "$project")"
  [[ "$_restart_mode" == "auto" || "$_restart_mode" == "wait" || "$_restart_mode" == "listen" || "$_restart_mode" == id:* ]] || _restart_mode="wait"
  nohup bash "$launch_bin" "$launch_mode_command" --project "$project" --task-mode "$_restart_mode" </dev/null >/dev/null 2>&1 &
  disown "$!" 2>/dev/null || true
}

