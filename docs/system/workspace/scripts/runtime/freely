tool_default_adapter_for_runtime() {
  local tool="$1"
  [[ -n "$tool" ]] || {
    printf '\n'
    return 0
  }
  # Registry-driven: read adapters.default field, fallback to acp
  local _default
  _default=$(_tool_registry_get "$tool" "adapters.default" 2>/dev/null || true)
  if [[ -n "$_default" ]]; then
    printf '%s\n' "$_default"
  else
    printf 'acp\n'
  fi
}

tool_supported_adapters_for_runtime() {
  local tool="$1"
  # Strip slot suffix to get base tool: codex-apikey-xxx → codex
  local base_tool="$tool"
  case "$base_tool" in
    *-apikey-*) base_tool="${base_tool%%-apikey-*}" ;;
    *-account-*) base_tool="${base_tool%%-account-*}" ;;
  esac
  # Registry-driven: read adapters.supported from tool-registry.toml.
  # The TOML is the single source of truth — no per-tool hardcoding here.
  local _supported
  _supported=$(_tool_registry_get "$base_tool" "adapters.supported" 2>/dev/null || true)
  if [[ -n "$_supported" ]]; then
    printf '%s\n' "$_supported" | tr ',' '\n' | sed 's/^ *//; s/ *$//'
  else
    # Conservative default for tools not yet in the registry
    printf 'direct\n'
  fi
}

