worker_project_has_only_retirement_followthrough_dirty_entries() {
  local target_worktree="$1" prompt_file="${2:-}" dirty_line dirty_path allowed_path matched
  [[ -n "$target_worktree" && -d "$target_worktree" ]] || return 1

  while IFS= read -r dirty_line; do
    [[ -n "$dirty_line" ]] || continue
    dirty_path="${dirty_line:3}"
    [[ -n "$dirty_path" ]] || return 1
    [[ "$dirty_path" == *" -> "* ]] && return 1
    matched="0"
    while IFS= read -r allowed_path; do
      [[ -n "$allowed_path" ]] || continue
      if [[ "$allowed_path" == */ ]]; then
        allowed_path="${allowed_path%/}"
        case "$dirty_path" in
          "$allowed_path"|"$allowed_path"/*)
            matched="1"
            break
            ;;
        esac
      elif [[ "$dirty_path" == "$allowed_path" ]]; then
        matched="1"
        break
      fi
    done < <(worker_retirement_followthrough_paths "$target_worktree" "$prompt_file")
    [[ "$matched" == "1" ]] || return 1
  done < <(git_status_porcelain_with_runtime_hygiene "$target_worktree")
  return 0
}

worker_project_is_retire_ready_merged_followthrough() {
  local manager_project="$1" target_worktree="$2" target_branch="$3" prompt_file="${4:-}" dirty_entries
  [[ -n "$target_worktree" && -d "$target_worktree" ]] || return 1
  worker_worktree_has_runtime_history "$target_worktree" || return 1
  [[ -n "$target_branch" ]] || return 1
  worker_worktree_has_pending_non_cleanup_manager_prompt "$manager_project" "$target_worktree" && return 1
  branch_is_merged_into_develop "$manager_project" "$target_branch" || return 1
  dirty_entries="$(project_dirty_entries "$target_worktree")"
  [[ "$dirty_entries" =~ ^[0-9]+$ ]] || return 1
  if (( dirty_entries == 0 )); then
    return 0
  fi
  worker_project_has_only_retirement_followthrough_dirty_entries "$target_worktree" "$prompt_file"
}

worker_prompt_targets_retire_ready_merged_worktree() {
  local manager_project="$1" prompt_file="$2"
  local resolved_worktree target_branch
  resolved_worktree="$(worker_prompt_resolved_worktree "$manager_project" "$prompt_file")"
  [[ -n "$resolved_worktree" && -d "$resolved_worktree" ]] || return 1
  target_branch="$(worker_prompt_target_branch "$prompt_file")"
  worker_project_is_retire_ready_merged_followthrough "$manager_project" "$resolved_worktree" "$target_branch" "$prompt_file"
}

worker_prompt_launchable_for_manager_project() {
  local manager_project="$1" prompt_file="$2" resolved_worktree target_branch handoff_prompt_file raw_key_hint
  resolved_worktree="$(worker_prompt_resolved_worktree "$manager_project" "$prompt_file")"
  raw_key_hint="$(echo "$prompt_file" | grep -oE '[0-9]{8}T[0-9]{4,6}Z' | head -1 || true)"
  if [[ -z "$resolved_worktree" || ! -d "$resolved_worktree" ]]; then
    if worker_prompt_can_materialize_missing_worktree "$manager_project" "$prompt_file"; then
      return 0
    fi
    LAUNCH_REJECT_REASON="worktree missing: '${resolved_worktree:-<empty>}' — create it with: wt-create --raw-key ${raw_key_hint:-<key>} --source platform --skill <skill> --slug <slug>"
    log_warn "worker_prompt_launchable: $LAUNCH_REJECT_REASON"
    return 1
  fi
  # Gate: validate raw issue exists and is open before launching worker (#3290)
  if [[ -n "$raw_key_hint" ]]; then
    local _raw_issue_file="$manager_project/docs/B1-docs/raw-${raw_key_hint}/issue.md"
    if [[ ! -f "$_raw_issue_file" ]]; then
      LAUNCH_REJECT_REASON="raw-${raw_key_hint} has no corresponding raw issue at docs/B1-docs/raw-${raw_key_hint}/issue.md — check raw_key is correct. If the issue was renamed/moved, update the task's raw_key."
      log_warn "worker_prompt_launchable: $LAUNCH_REJECT_REASON"
      return 1
    fi
    local _raw_phase
    _raw_phase="$(sed -n '/^---$/,/^---$/p' "$_raw_issue_file" | grep "^phase_state:" | sed 's/^phase_state: *//' | tr -d '"' 2>/dev/null || true)"
    case "$_raw_phase" in
      absorbed|completed|dropped)
        LAUNCH_REJECT_REASON="raw-${raw_key_hint} is closed (phase_state=${_raw_phase}) — re-open the raw issue if still active, or use a new raw_key for new work"
        log_warn "worker_prompt_launchable: $LAUNCH_REJECT_REASON"
        return 1
        ;;
    esac
  fi
  handoff_prompt_file="$(worker_handoff_followthrough_prompt_file_for_project "$resolved_worktree" || true)"
  if [[ -n "$handoff_prompt_file" && -f "$handoff_prompt_file" && "$handoff_prompt_file" != "$prompt_file" ]]; then
    LAUNCH_REJECT_REASON="worktree busy: '$resolved_worktree' has followthrough prompt, worker already assigned"
    log_warn "worker_prompt_launchable: $LAUNCH_REJECT_REASON"
    return 1
  fi
  target_branch="$(worker_prompt_target_branch "$prompt_file")"
  # Worker must run on fix/* or feature/*. develop allowed only for cleanup.
  case "$target_branch" in
    fix/*|feature/*) ;;
    hotfix/*) ;;  # emergency fixes
    develop)
      if [[ "$(worker_prompt_normalized_intent_kind "$prompt_file")" != "cleanup" ]]; then
        LAUNCH_REJECT_REASON="develop rejected: only cleanup intent allowed, got '$(worker_prompt_normalized_intent_kind "$prompt_file")' — for edit/feature work, create a fix|feature/* worktree via wt-create --raw-key ${raw_key_hint:-<key>}"
        log_warn "worker_prompt_launchable: $LAUNCH_REJECT_REASON"
        return 1
      fi
      # develop cleanup is theoretically allowed but practically blocked:
      # develop is the protected manager worktree. Cleanups must run from a dedicated worktree.
      LAUNCH_REJECT_REASON="develop is protected: cleanup workers cannot run on develop — create a fix|feature/* worktree via wt-create --raw-key ${raw_key_hint:-<key>} --skill freely-fix-execution --slug <slug>"
      log_warn "worker_prompt_launchable: $LAUNCH_REJECT_REASON"
      return 1
      ;;
    *)
      LAUNCH_REJECT_REASON="branch='$target_branch' not in fix/*|feature/*|hotfix/* — create a worktree with: wt-create --raw-key ${raw_key_hint:-<key>} --source platform --skill <skill> --slug <slug>"
      log_warn "worker_prompt_launchable: $LAUNCH_REJECT_REASON"
      return 1
      ;;
  esac
  if worker_project_is_absorbed_merged_lane "$manager_project" "$resolved_worktree" "$target_branch"; then
    if [[ "$(worker_prompt_normalized_intent_kind "$prompt_file")" == "cleanup" ]]; then
      return 0
    fi
    LAUNCH_REJECT_REASON="worktree is absorbed/merged lane: '$resolved_worktree' — only cleanup intent allowed. For new work, create a fresh worktree via wt-create"
    log_warn "worker_prompt_launchable: $LAUNCH_REJECT_REASON"
    return 1
  fi
  return 0
}

worker_prompt_matches_active_authoritative_worker() {
  local manager_project="$1" target_project="$2" prompt_file="$3"
  local authoritative_prompt_file
  [[ -n "$manager_project" && -n "$target_project" && -d "$target_project" ]] || return 1
  [[ -n "$prompt_file" && -f "$prompt_file" ]] || return 1
  worker_project_is_actively_running "$target_project" || return 1
  worker_project_busy_with_delegated_continuation "$target_project" && return 1
  authoritative_prompt_file="$(authoritative_worker_prompt_file_for_project "$target_project" || true)"
  [[ -n "$authoritative_prompt_file" && "$authoritative_prompt_file" == "$prompt_file" ]]
}

