manager_continuity_gap_snapshot_for_project() {
  local project="$1"
  local prompt_file expected_continuity latest_generated prompt_epoch latest_generated_epoch
  local now_epoch gap_age_secs gap_age_state grace_secs
  prompt_file="$(find_latest_prompt_file_for_project "$project")"
  [[ -n "$prompt_file" && -f "$prompt_file" ]] || {
    printf 'none|none|none|none|none|none|none|none\n'
    return 0
  }
  expected_continuity="$(required_manager_continuity_file_from_prompt "$prompt_file")"
  [[ -n "$expected_continuity" ]] || {
    printf 'none|none|none|none|%s|none|none|none\n' "$prompt_file"
    return 0
  }
  latest_generated="$(latest_generated_manager_continuity_file_for_project "$project")"
  if [[ -f "$expected_continuity" ]]; then
    printf 'none|none|%s|%s|%s|0|none|present\n' "$expected_continuity" "${latest_generated:-none}" "$prompt_file"
    return 0
  fi

  prompt_epoch="$(file_mtime_epoch "$prompt_file" 2>/dev/null || true)"
  latest_generated_epoch="0"
  if [[ -n "$latest_generated" && -f "$latest_generated" ]]; then
    latest_generated_epoch="$(file_mtime_epoch "$latest_generated" 2>/dev/null || true)"
  fi
  [[ "$prompt_epoch" =~ ^[0-9]+$ ]] || prompt_epoch="0"
  [[ "$latest_generated_epoch" =~ ^[0-9]+$ ]] || latest_generated_epoch="0"
  now_epoch="$(runtime_now_epoch 2>/dev/null || true)"
  [[ "$now_epoch" =~ ^[0-9]+$ ]] || now_epoch="0"
  gap_age_secs="unknown"
  gap_age_state="unknown"
  if (( now_epoch > 0 && prompt_epoch > 0 && now_epoch >= prompt_epoch )); then
    gap_age_secs="$((now_epoch - prompt_epoch))"
    grace_secs="${FREELY_MANAGER_CONTINUITY_GAP_GRACE_SECS:-15}"
    [[ "$grace_secs" =~ ^[0-9]+$ ]] || grace_secs=15
    if (( gap_age_secs <= grace_secs )); then
      gap_age_state="within_grace"
    else
      gap_age_state="beyond_grace"
    fi
  fi

  if (( prompt_epoch >= latest_generated_epoch )); then
    printf 'active|expected_continuity_missing|%s|%s|%s|%s|%s|latest_generated=%s prompt=%s age_secs=%s age_state=%s\n' \
      "$expected_continuity" \
      "${latest_generated:-none}" \
      "$prompt_file" \
      "$gap_age_secs" \
      "$gap_age_state" \
      "${latest_generated:-none}" \
      "$prompt_file" \
      "$gap_age_secs" \
      "$gap_age_state"
    return 0
  fi

  printf 'none|none|%s|%s|%s|%s|%s|latest_generated_newer=%s age_secs=%s age_state=%s\n' \
    "$expected_continuity" \
    "${latest_generated:-none}" \
    "$prompt_file" \
    "$gap_age_secs" \
    "$gap_age_state" \
    "${latest_generated:-none}" \
    "$gap_age_secs" \
    "$gap_age_state"
}

materialize_missing_required_manager_continuity_fallback() {
  local project="$1" fallback_reason="${2:-runtime_cleanup}"
  local gap_state gap_reason expected_continuity latest_generated prompt_file gap_age_secs gap_age_state gap_summary
  local continuity_id branch generated_at previous_manager_continuity resolution_file session_file cycle_log cycle_log_from_state=""
  [[ "$(role_hint_for_project "$project")" == "manager" ]] || return 1

  IFS='|' read -r gap_state gap_reason expected_continuity latest_generated prompt_file gap_age_secs gap_age_state gap_summary <<<"$(manager_continuity_gap_snapshot_for_project "$project")"
  [[ "$gap_state" == "active" && "$gap_reason" == "expected_continuity_missing" ]] || return 1
  [[ -n "$expected_continuity" && "$expected_continuity" != "none" ]] || return 1
  [[ ! -f "$expected_continuity" ]] || return 0

  mkdir -p "$(dirname "$expected_continuity")"
  continuity_id="$(manager_continuity_id_from_path "$expected_continuity")"
  branch="$(git -C "$project" branch --show-current 2>/dev/null || printf 'unknown')"
  generated_at="$(current_timestamp_local_for_display)"
  previous_manager_continuity="${latest_generated:-none}"
  [[ -n "$previous_manager_continuity" && -f "$previous_manager_continuity" ]] || previous_manager_continuity="none"
  resolution_file="$(latest_interruption_resolution_file_for_project "$project")"
  [[ -n "$resolution_file" && -f "$resolution_file" ]] || resolution_file="none"
  session_file="$(session_state_file "$project")"
  if [[ ! -f "$session_file" ]]; then
    session_file="none"
  elif [[ -z "${LAST_CYCLE_LOG:-}" ]]; then
    cycle_log_from_state="$(awk -F= '/^LAST_CYCLE_LOG=/ {print $2; exit}' "$session_file" 2>/dev/null || true)"
    cycle_log_from_state="$(strip_simple_shell_quotes "$cycle_log_from_state")"
  fi
  cycle_log="${LAST_CYCLE_LOG:-none}"
  if [[ "$cycle_log" == "none" && -n "$cycle_log_from_state" ]]; then
    cycle_log="$cycle_log_from_state"
  fi
  [[ -n "$cycle_log" && -f "$cycle_log" ]] || cycle_log="none"

  cat >"$expected_continuity" <<EOF
# Manager Continuity
- continuity_id: \`${continuity_id:-unknown}\`
- generated_at: \`${generated_at}\`
- role: \`manager\`
- branch: \`${branch:-unknown}\`
- worktree: \`${project}\`
- tool: \`${AGENT_AI_TOOL:-unknown}\`
- model: \`${AI_MODEL:-unknown}\`
