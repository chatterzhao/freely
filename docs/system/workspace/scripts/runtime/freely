        seq=""
        for (i = 1; i <= NF; i++) {
          if ($i ~ /^checkpoint=/) {
            checkpoint = substr($i, 12)
          } else if ($i ~ /^seq=/) {
            seq = substr($i, 5)
          }
        }
        if (checkpoint == "L041") {
          print seq "|" $1 "|" checkpoint
        }
      }
    ' "$trace_file" | tail -n 1
  )"
  [[ -n "$finalize_snapshot" ]] || return 1
  IFS='|' read -r last_finalize_seq last_finalize_ts _ <<<"$finalize_snapshot"
  [[ "$last_finalize_seq" =~ ^[0-9]+$ ]] || return 1

  terminal_snapshot="$(
    awk -v pid="$supervisor_pid" '
      index($0, "supervisor_pid=" pid) {
        checkpoint=""
        seq=""
        for (i = 1; i <= NF; i++) {
          if ($i ~ /^checkpoint=/) {
            checkpoint = substr($i, 12)
          } else if ($i ~ /^seq=/) {
            seq = substr($i, 5)
          }
        }
        if (checkpoint == "L042" || checkpoint == "L090" || checkpoint == "L091" || checkpoint == "L092") {
          print seq "|" $1 "|" checkpoint
        }
      }
    ' "$trace_file" | tail -n 1
  )"
  if [[ -n "$terminal_snapshot" ]]; then
    IFS='|' read -r last_terminal_seq last_terminal_ts last_terminal_checkpoint <<<"$terminal_snapshot"
    if [[ "$last_terminal_seq" =~ ^[0-9]+$ ]] && (( last_terminal_seq >= last_finalize_seq )); then
      if [[ "$last_terminal_checkpoint" == "L042" ]]; then
        finalize_epoch="$(timestamp_epoch_or_zero "$last_terminal_ts")"
        [[ "$finalize_epoch" =~ ^[0-9]+$ ]] || finalize_epoch=0
