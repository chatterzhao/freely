        if ($0 ~ /prompt_path:/ || $0 ~ /worker_prompt_path:/) {
          emit_prompt_paths($0)
          next
        }
        if ($0 ~ /^[[:space:]]*-[[:space:]]*`?\/[^` ]+\/\.freely\/run\/worker-prompts\/[^` ]+\.txt`?[[:space:]]*$/) {
          emit_prompt_paths($0)
        }
        next
      }
      if (section == "queue") {
        if ($0 ~ /^[[:space:]]*-[[:space:]]*(worker_prompt|queued_worker_prompt|refreshed_queued_worker_prompt):[[:space:]]*$/) {
          capture_worker_prompt_path_list=1
          next
        }
        if ($0 ~ /prompt_path:/ || $0 ~ /worker_prompt_path:/) {
          emit_prompt_paths($0)
          next
        }
        if ($0 ~ /^[[:space:]]*-[[:space:]]*`?\/[^` ]+\/\.freely\/run\/worker-prompts\/[^` ]+\.txt`?[[:space:]]*$/) {
          emit_prompt_paths($0)
        }
        next
      }
      if (capture_worker_prompt_path_list == 1) {
        if ($0 ~ /^[[:space:]]*-[[:space:]]*`?\/[^` ]+\/\.freely\/run\/worker-prompts\/[^` ]+\.txt`?[[:space:]]*$/) {
          emit_prompt_paths($0)
          next
        }
        if ($0 ~ /^[[:space:]]*-[[:space:]]*`none`[[:space:]]*$/ || $0 ~ /^[[:space:]]*`none`[[:space:]]*$/) {
          capture_worker_prompt_path_list=0
          next
        }
        if ($0 !~ /^[[:space:]]*$/ && $0 !~ /^[[:space:]]*-[[:space:]]/) {
          capture_worker_prompt_path_list=0
        }
      }
      if ($0 ~ /- queued_worker_prompt: / || $0 ~ /- refreshed_queued_worker_prompt: /) {
        emit_prompt_paths($0)
      }
    }
  ' "$continuity_file"
}

worker_prompt_superseded_paths() {
  local prompt_file="$1"
  [[ -f "$prompt_file" ]] || return 0
  awk '
    function emit_prompt_paths(line,    remaining) {
      remaining=line
      while (match(remaining, /\/[^` ]+\/\.freely\/run\/worker-prompts\/[^` ]+\.txt/)) {
        print substr(remaining, RSTART, RLENGTH)
        remaining=substr(remaining, RSTART + RLENGTH)
      }
    }
    /^This prompt supersedes / {
      capture=1
      next
    }
    capture == 1 {
      if ($0 ~ /^[[:space:]]*-[[:space:]]*`?\/[^` ]+\/\.freely\/run\/worker-prompts\/[^` ]+\.txt`?[[:space:]]*$/) {
        emit_prompt_paths($0)
        next
      }
      if ($0 ~ /^[[:space:]]*$/ || $0 !~ /^[[:space:]]*-[[:space:]]/) {
        capture=0
      }
    }
  ' "$prompt_file" | sort -u
}

worker_prompt_supersedes_prompt() {
  local prompt_file="$1" candidate_prompt="$2" superseded_prompt
  [[ -n "$prompt_file" && -f "$prompt_file" ]] || return 1
  [[ -n "$candidate_prompt" && -f "$candidate_prompt" ]] || return 1
  while IFS= read -r superseded_prompt; do
    [[ -n "$superseded_prompt" ]] || continue
    [[ "$superseded_prompt" == "$candidate_prompt" ]] && return 0
  done < <(worker_prompt_superseded_paths "$prompt_file")
  return 1
}

manager_launchable_prompt_supersedes_frozen_prompt() {
  local continuity_file="$1" frozen_prompt="$2" prompt_file
  [[ -n "$continuity_file" && -f "$continuity_file" ]] || return 1
  [[ -n "$frozen_prompt" && -f "$frozen_prompt" ]] || return 1
  while IFS= read -r prompt_file; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
    worker_prompt_supersedes_prompt "$prompt_file" "$frozen_prompt" && return 0
  done < <(latest_manager_worker_prompt_paths_from_continuity "$continuity_file")
  return 1
}

worker_prompt_target_branch() {
  local prompt_file="$1"
  [[ -f "$prompt_file" ]] || return 0
  awk '
    /^You are the [^`]*worker for `/ && / in `\// {
      value=$0
      sub(/^You are the [^`]*worker for `/, "", value)
      split(value, parts, "` in `")
      print parts[1]
      exit
    }
    /^- branch: / {
      value=$0
      sub(/^- branch: `/, "", value)
      sub(/`$/, "", value)
      print value
      exit
    }
	    /^Branch: / { sub(/^Branch: /, ""); print; exit }
    /^Branch:$/ { capture=1; next }
    capture && /^- / {
      value=$0
      sub(/^- /, "", value)
      gsub(/`/, "", value)
      print value
      exit
    }
  ' "$prompt_file"
}

worker_prompt_selected_tool() {
  local prompt_file="$1"
  [[ -f "$prompt_file" ]] || return 0
  awk '
    /^- selected_tool: / {
      value=$0
      sub(/^- selected_tool: `?/, "", value)
      sub(/`?$/, "", value)
      print value
      exit
    }
    /^selected_tool: / {
      value=$0
      sub(/^selected_tool: `?/, "", value)
      sub(/`?$/, "", value)
      print value
      exit
    }
  ' "$prompt_file"
}

worker_selected_tool_from_verification_contract_for_project() {
  local project="$1" contract_file prompt_file
  contract_file="$(worker_verification_contract_state_file "$project")"
  [[ -f "$contract_file" ]] || return 1
  prompt_file="$(meta_env_value "$contract_file" "SOURCE_PROMPT_FILE")"
  [[ -n "$prompt_file" && -f "$prompt_file" ]] || return 1
  worker_prompt_selected_tool "$prompt_file"
}

worker_runtime_reconcile_selected_tool_from_contract_if_needed() {
  local project="$1" role selected_tool current_tool _ current_truth
  role="$(effective_runtime_role_for_project "$project")"
  [[ "$role" == "worker" ]] || return 1
  selected_tool="$(worker_selected_tool_from_verification_contract_for_project "$project")"
  [[ -n "$selected_tool" ]] || return 1
  current_truth="$(project_tool_runtime_selection_truth "$project")"
  IFS='|' read -r current_tool _ <<<"$current_truth"
  [[ -n "$current_tool" ]] || current_tool="${AGENT_AI_TOOL:-}"
  [[ "$selected_tool" == "$current_tool" ]] && return 0
  persist_project_tool_selection "$project" "$selected_tool"
  runtime_clear_session_state_for_fresh_launch "$project"
  return 0
}

worktree_path_for_branch() {
  local project="$1" target_branch="$2"
  [[ -n "$target_branch" ]] || return 0
  project_worktree_list_porcelain_cached "$project" | awk -v target="refs/heads/$target_branch" '
    /^worktree / { wt=substr($0, 10); next }
    /^branch / {
      if ($2 == target) {
        print wt
        exit
      }
    }
  '
}

worker_prompt_resolved_worktree() {
  local manager_project="$1" prompt_file="$2"
  local target_worktree target_branch derived_worktree
  target_worktree="$(worker_prompt_target_worktree "$prompt_file")"
  if [[ -n "$target_worktree" && -d "$target_worktree" ]]; then
    normalize_runtime_worktree_path "$target_worktree"
    return 0
  fi
  target_branch="$(worker_prompt_target_branch "$prompt_file")"
  if [[ -n "$target_branch" ]]; then
    worktree_path_for_branch "$manager_project" "$target_branch"
    return 0
  fi
  # Fallback: prompt files are always stored at
  # <worktree>/.freely/run/a2a-prompts/task-<id>.txt.
  # Derive the worktree path from the file location.
  derived_worktree="$(dirname "$(dirname "$(dirname "$(dirname "$prompt_file")")")")"
  if [[ -d "$derived_worktree/.freely" ]]; then
    normalize_runtime_worktree_path "$derived_worktree"
    return 0
  fi
}

worker_worktree_needs_managed_tooling_repair() {
  local project="$1"
  local wrapper_dir tool tool_capabilities
  [[ -n "$project" && -d "$project" ]] || return 1
  [[ -f "$(config_file "$project")" ]] || return 0
  [[ -f "$(project_tool_boundary_bootstrap_file "$project")" ]] || return 0
  wrapper_dir="$(project_tool_wrapper_dir "$project")"
  [[ -x "$wrapper_dir/codex" ]] || return 0
  tool="${AGENT_AI_TOOL:-codex}"
  tool_capabilities="${AGENT_AI_TOOL_CAPABILITIES:-$(tool_default_capabilities_for_runtime "$tool")}"
  if tool_requires_project_codex_config "$tool" "$tool_capabilities"; then
    [[ -f "$(project_codex_config_file "$project")" ]] || return 0
  fi
  return 1
}

repair_existing_worker_worktree_if_needed() {
  local manager_project="$1" target_project="$2"
  local freely_bin
  [[ -n "$manager_project" && -d "$manager_project" ]] || return 1
  [[ -n "$target_project" && -d "$target_project" ]] || return 1
  project_has_authoritative_worktree_path "$manager_project" "$target_project" || return 1
  worker_worktree_needs_managed_tooling_repair "$target_project" || return 0
  freely_bin="$(freely_bin_for_project "$manager_project")"
  [[ -x "$freely_bin" ]] || return 1
  bash "$freely_bin" sync-tooling --source-project "$manager_project" --project "$target_project" >/dev/null 2>&1 || return 1
  worker_worktree_needs_managed_tooling_repair "$target_project" && return 1
  return 0
}

worker_prompt_can_materialize_missing_worktree() {
  local manager_project="$1" prompt_file="$2"
  local target_worktree target_branch sibling_root normalized_target normalized_parent
  target_worktree="$(worker_prompt_target_worktree "$prompt_file")"
  target_branch="$(worker_prompt_target_branch "$prompt_file")"
  [[ -n "$target_worktree" && -n "$target_branch" ]] || return 1
  [[ ! -d "$target_worktree" ]] || return 1
  case "$target_branch" in
    feature/*|fix/*|feature/premerge-*|test-pre-merge-*|hotfix/*|release/*) ;;
    *) return 1 ;;
  esac
  normalized_parent="$(cd "$(dirname "$target_worktree")" 2>/dev/null && pwd -P)" || return 1
  normalized_target="$normalized_parent/$(basename "$target_worktree")"
  sibling_root="$(normalize_runtime_worktree_path "$(cd "$manager_project/.." 2>/dev/null && pwd -P)/$(basename "$manager_project")-worktrees")"
  case "$normalized_target" in
    "$sibling_root"/*) return 0 ;;
  esac
  return 1
}

retire_manager_worker_prompts_for_target() {
  local manager_project="$1" target_worktree="$2" target_branch="$3"
  local prompt_dir prompt_file prompt_worktree prompt_branch
  prompt_dir="$(run_dir_for_project "$manager_project")/worker-prompts"
  [[ -d "$prompt_dir" ]] || return 0
  while IFS= read -r prompt_file; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
    prompt_worktree="$(worker_prompt_target_worktree "$prompt_file")"
    prompt_branch="$(worker_prompt_target_branch "$prompt_file")"
    if [[ -n "$target_worktree" && -n "$prompt_worktree" && "$prompt_worktree" == "$target_worktree" ]]; then
      rm -f "$prompt_file"
      continue
    fi
    if [[ -n "$target_branch" && -n "$prompt_branch" && "$prompt_branch" == "$target_branch" ]]; then
      rm -f "$prompt_file"
    fi
  done < <(find "$prompt_dir" -maxdepth 1 -type f -name '*.txt' | sort)
}

materialize_worker_prompt_worktree_if_needed() {
  local manager_project="$1" prompt_file="$2"
  local target_project target_worktree target_branch freely_bin
  target_project="$(worker_prompt_resolved_worktree "$manager_project" "$prompt_file")"
  if [[ -n "$target_project" && -d "$target_project" ]]; then
    # Worker must never share the manager's own worktree
    if [[ "$(normalize_runtime_worktree_path "$target_project")" == "$(normalize_runtime_worktree_path "$manager_project")" ]]; then
      log_warn "worker launch blocked: prompt resolves to manager worktree ($target_project)"
      return 1
    fi
    repair_existing_worker_worktree_if_needed "$manager_project" "$target_project" || return 1
    printf '%s\n' "$target_project"
    return 0
  fi

  worker_prompt_can_materialize_missing_worktree "$manager_project" "$prompt_file" || return 1
  target_worktree="$(worker_prompt_target_worktree "$prompt_file")"
  target_branch="$(worker_prompt_target_branch "$prompt_file")"

  # Only wt-create is allowed — it ensures governance traceability.
  # Failure here means Manager must create the worktree before delegating.
  if [[ -x "$manager_project/bin/wt-create" ]]; then
    if ! bash "$manager_project/bin/wt-create" "$target_branch" --base develop 2>&1; then
      log_warn "worker worktree auto-materialize blocked: wt-create failed for branch=$target_branch"
      log_warn "  Manager must create the worktree before delegating:"
      log_warn "  freely wt-create --raw-key <key> --source <source> --skill <skill> --slug <slug>"
      return 1
    fi
  else
    log_warn "worker worktree auto-materialize blocked: wt-create not found"
    return 1
  fi

  reset_project_runtime_discovery_cache "$manager_project"
  target_project="$(worker_prompt_resolved_worktree "$manager_project" "$prompt_file")"
  [[ -n "$target_project" && -d "$target_project" ]] || return 1
  printf '%s\n' "$target_project"
}

worker_worktree_has_runtime_history() {
  local worktree_path="$1"
  [[ -n "$worktree_path" && -d "$worktree_path" ]] || return 1
  [[ -f "$(config_file "$worktree_path")" ]] || return 1
}

branch_is_merged_into_develop() {
  local project="$1" target_branch="$2"
  [[ -n "$target_branch" ]] || return 1
  [[ "$target_branch" != "develop" ]] || return 1
  git -C "$project" show-ref --verify --quiet "refs/heads/$target_branch" 2>/dev/null || return 1
  git -C "$project" show-ref --verify --quiet "refs/heads/develop" 2>/dev/null || return 1
  # Branch must have unique commits beyond develop — empty/new branches are NOT merged
  local ahead
  ahead=$(git -C "$project" rev-list --count "develop..$target_branch" 2>/dev/null || echo "0")
  [[ "$ahead" -gt 0 ]] || return 1
  git -C "$project" merge-base --is-ancestor "refs/heads/$target_branch" "refs/heads/develop" 2>/dev/null
}

worker_project_is_absorbed_merged_lane() {
  local manager_project="$1" target_worktree="$2" target_branch="$3"
  [[ -n "$target_worktree" && -d "$target_worktree" ]] || return 1
  worker_worktree_has_runtime_history "$target_worktree" || return 1
  [[ -f "$(workcell_state_file "$target_worktree")" ]] || return 1
  [[ -n "$target_branch" ]] || return 1
  worker_worktree_has_pending_non_cleanup_manager_prompt "$manager_project" "$target_worktree" && return 1
  branch_is_merged_into_develop "$manager_project" "$target_branch" || return 1
}

worker_project_is_retire_ready_merged_clean() {
  local manager_project="$1" target_worktree="$2" target_branch="$3" dirty_entries
  [[ -n "$target_worktree" && -d "$target_worktree" ]] || return 1
  worker_worktree_has_runtime_history "$target_worktree" || return 1
  [[ -n "$target_branch" ]] || return 1
  branch_is_merged_into_develop "$manager_project" "$target_branch" || return 1
  dirty_entries="$(project_dirty_entries "$target_worktree")"
  [[ "$dirty_entries" =~ ^[0-9]+$ ]] || return 1
  (( dirty_entries == 0 ))
}

markdown_backtick_field_value() {
  local markdown_file="$1" field_name="$2"
  [[ -f "$markdown_file" ]] || return 0
  awk -v field_name="$field_name" '
    $0 ~ "^- " field_name ":" {
      if (match($0, /`[^`]+`/)) {
        print substr($0, RSTART + 1, RLENGTH - 2)
        exit
      }
    }
  ' "$markdown_file"
}

manager_continuity_backtick_field_value() {
  local continuity_file="$1" field_name="$2"
  [[ -f "$continuity_file" ]] || return 0
  awk -v field_name="$field_name" '
    $0 ~ "^- " field_name ":" {
      if (match($0, /`[^`]+`/)) {
        print substr($0, RSTART + 1, RLENGTH - 2)
        exit
      }
    }
  ' "$continuity_file"
}

manager_continuity_selected_cleanup_rows() {
  local continuity_file="$1"
  [[ -f "$continuity_file" ]] || return 0
  awk '
    function trim_tick(value) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      gsub(/`/, "", value)
      return value
    }
    function emit_current() {
      if (path != "") {
        printf "%s|%s|%s|%s|%s|%s\n", path, branch, desired, role_hint, section_key, disposition
      }
      path=""
      branch=""
      desired=""
      role_hint=""
      disposition=""
    }
    /^## Fleet Inventory$/ { in_section=1; next }
    /^## / && in_section {
      emit_current()
      exit
    }
    !in_section { next }
    /^[[:space:]]*-[[:space:]]*selected_cleanup_[a-zA-Z0-9_-]+:[[:space:]]*$/ {
      emit_current()
      line=$0
      sub(/^[[:space:]]*-[[:space:]]*/, "", line)
      sub(/:[[:space:]]*$/, "", line)
      section_key=trim_tick(line)
      in_cleanup=1
      next
    }
    /^[[:space:]]*-[[:space:]]*[a-zA-Z0-9_-]+:[[:space:]]*$/ {
      if (in_cleanup == 1) {
        emit_current()
      }
      in_cleanup=0
      section_key=""
      next
    }
    in_cleanup != 1 { next }
    /^[[:space:]]*-[[:space:]]*path:[[:space:]]*/ || /^[[:space:]]*path:[[:space:]]*/ {
      emit_current()
      line=$0
      sub(/^[[:space:]]*-[[:space:]]*path:[[:space:]]*/, "", line)
      sub(/^[[:space:]]*path:[[:space:]]*/, "", line)
      path=trim_tick(line)
      next
    }
    path == "" { next }
    /^[[:space:]]*branch:[[:space:]]*/ {
      line=$0
      sub(/^[[:space:]]*branch:[[:space:]]*/, "", line)
      branch=trim_tick(line)
      next
    }
    /^[[:space:]]*desired:[[:space:]]*/ {
      line=$0
      sub(/^[[:space:]]*desired:[[:space:]]*/, "", line)
      desired=trim_tick(line)
      next
    }
    /^[[:space:]]*role_hint:[[:space:]]*/ {
      line=$0
      sub(/^[[:space:]]*role_hint:[[:space:]]*/, "", line)
      role_hint=trim_tick(line)
      next
    }
    /^[[:space:]]*disposition:[[:space:]]*/ {
      line=$0
      sub(/^[[:space:]]*disposition:[[:space:]]*/, "", line)
      disposition=trim_tick(line)
      next
    }
    END {
      emit_current()
    }
  ' "$continuity_file"
}

manager_cleanup_prompt_primary_target_row_from_continuity() {
  local project="$1" continuity_file="$2"
  local row path branch desired role_hint section_key disposition fallback=""
  local prompt_file prompt_worktree prompt_branch
  while IFS='|' read -r path branch desired role_hint section_key disposition; do
    [[ -n "$path" && -d "$path" ]] || continue
    project_has_authoritative_worktree_path "$project" "$path" || continue
    [[ -n "$branch" ]] || continue
    if [[ -n "$desired" && "$desired" != "stopped" ]]; then
      continue
    fi
    if [[ "$branch" == feature/* || "$role_hint" == "cleanup" || "$section_key" == "selected_cleanup_lane" ]]; then
      printf '%s|%s|%s|%s|%s|%s\n' "$path" "$branch" "$desired" "$role_hint" "$section_key" "$disposition"
      return 0
    fi
    [[ -n "$fallback" ]] || fallback="$path|$branch|$desired|$role_hint|$section_key|$disposition"
  done < <(manager_continuity_selected_cleanup_rows "$continuity_file")
  if [[ -n "$fallback" ]]; then
    printf '%s\n' "$fallback"
    return 0
  fi
  while IFS= read -r prompt_file; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
    prompt_worktree="$(worker_prompt_resolved_worktree "$project" "$prompt_file")"
    prompt_branch="$(worker_prompt_target_branch "$prompt_file")"
    [[ -n "$prompt_worktree" && -d "$prompt_worktree" && -n "$prompt_branch" ]] || continue
    project_has_authoritative_worktree_path "$project" "$prompt_worktree" || continue
    printf '%s|%s|stopped|cleanup|worker_prompt_fallback|retained-with-reason\n' "$prompt_worktree" "$prompt_branch"
    return 0
  done < <(latest_manager_worker_prompt_paths_from_continuity "$continuity_file")
  return 1
}

manager_cleanup_source_prompt_file_from_continuity() {
  local project="$1" continuity_file="$2" primary_path="$3"
  local prompt_file prompt_worktree
  [[ -n "$primary_path" && -d "$primary_path" ]] || return 1
  while IFS= read -r prompt_file; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
    worker_prompt_has_verification_metadata "$prompt_file" || continue
    prompt_worktree="$(worker_prompt_resolved_worktree "$project" "$prompt_file")"
    [[ -n "$prompt_worktree" && "$prompt_worktree" == "$primary_path" ]] || continue
    printf '%s\n' "$prompt_file"
    return 0
  done < <(latest_manager_worker_prompt_paths_from_continuity "$continuity_file")
  return 1
}

manager_cleanup_prompt_write_scope_paths_from_continuity() {
  local project="$1" continuity_file="$2"
  local row path branch desired role_hint section_key disposition emitted="0" primary_row primary_path primary_branch
  while IFS='|' read -r path branch desired role_hint section_key disposition; do
    [[ -n "$path" && -d "$path" ]] || continue
    project_has_authoritative_worktree_path "$project" "$path" || continue
    if [[ -n "$desired" && "$desired" != "stopped" ]]; then
      continue
    fi
    printf '%s\n' "$path"
    emitted="1"
  done < <(manager_continuity_selected_cleanup_rows "$continuity_file")
  if [[ "$emitted" != "1" ]]; then
    primary_row="$(manager_cleanup_prompt_primary_target_row_from_continuity "$project" "$continuity_file" || true)"
    if [[ -n "$primary_row" ]]; then
      IFS='|' read -r primary_path primary_branch _desired _role_hint _section_key _disposition <<<"$primary_row"
      [[ -n "$primary_path" && -d "$primary_path" ]] && printf '%s\n' "$primary_path"
    fi
  fi
  printf '%s\n' "$project/.freely/run/"
}

manager_continuity_cleanup_issue_id() {
  local continuity_file="$1" value
  value="$(manager_continuity_backtick_field_value "$continuity_file" "issue_id")"
  if [[ -n "$value" ]]; then
    printf '%s\n' "$value"
    return 0
  fi
  value="$(manager_continuity_backtick_field_value "$continuity_file" "selected_source")"
  printf '%s\n' "$value"
}

manager_cleanup_prompt_file_for_continuity() {
  local project="$1" continuity_file="$2" issue_id slug
  issue_id="$(manager_continuity_cleanup_issue_id "$continuity_file")"
  slug="$(printf '%s' "${issue_id:-cleanup-governance}" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-')"
  slug="${slug#-}"
  slug="${slug%-}"
  [[ -n "$slug" ]] || slug="cleanup-governance"
  printf '%s/.freely/run/worker-prompts/%s-worker-%s-cleanup-codex.txt\n' \
    "$project" \
    "$(date '+%Y%m%d-%H%M%S')" \
    "$slug"
}

append_manager_cleanup_worker_prompt_reference_to_continuity() {
  local continuity_file="$1" prompt_file="$2" lane_id="$3"
  local tmp_file
  [[ -f "$continuity_file" && -n "$prompt_file" ]] || return 1
  if grep -Fq "$prompt_file" "$continuity_file"; then
    return 0
  fi
  tmp_file="$(mktemp "${TMPDIR:-/tmp}/freely-cleanup-continuity.XXXXXX")"
  awk -v prompt_file="$prompt_file" '
    BEGIN {
      in_dispatch=0
      rewriting_paths=0
      rewrote=0
    }
    /^## / {
      in_dispatch=($0 == "## Dispatch State")
      rewriting_paths=0
      print
      next
    }
    {
      if (in_dispatch == 1 && $0 ~ /^[[:space:]]*-[[:space:]]*worker_prompt_paths:[[:space:]]*$/) {
        print
        printf "  - `%s`\n", prompt_file
        rewriting_paths=1
        rewrote=1
        next
      }
      if (rewriting_paths == 1) {
        if ($0 ~ /^[[:space:]]{2}-[[:space:]]/) {
          next
        }
        rewriting_paths=0
      }
      print
    }
    END {
      if (rewrote == 0) {
        exit 0
      }
    }
  ' "$continuity_file" >"$tmp_file"
  mv "$tmp_file" "$continuity_file"
  {
    printf '\n## Worker Delegation\n'
    printf -- '- authoritative_worker_prompts:\n'
    printf -- '  - `%s`\n' "$prompt_file"
    printf -- '- launchable_queue:\n'
    printf -- '  - lane_id: `%s`\n' "${lane_id:-cleanup-governance}"
    printf -- '    dispatch_priority: `P0`\n'
    printf -- '    prompt_path: `%s`\n' "$prompt_file"
  } >>"$continuity_file"
}

materialize_cleanup_worker_prompt_from_manager_continuity_if_needed() {
  local project="$1" continuity_file="$2"
  local route_kind primary_row primary_path primary_branch _desired _role_hint _section_key _disposition
  local owner_issue_rel owner_issue_source owner_issue_abs pre_tests_rel verification_rel issue_id prompt_file
  local write_scope_path target_environment cleanup_selected_tool current_tool _ current_truth
  local source_prompt_file required_test_lanes_csv required_acceptance_ids_csv minimum_evidence_level
  local closeout_gate closeout_gate_command closeout_target_lane closeout_promotion_gate
  local closeout_requires_adequacy closeout_review_artifact_policy

  [[ -n "$project" && -f "$continuity_file" ]] || return 1
  if manager_continuity_has_worker_prompts "$continuity_file" \
    && manager_continuity_is_launchable_for_project "$project" "$continuity_file"; then
    return 1
  fi

  route_kind="$(manager_continuity_resume_focus_route_kind "$continuity_file" || true)"
