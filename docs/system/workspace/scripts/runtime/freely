    fi
    reject_repeated_user_start_if_running "$project" "daemon start"
  fi
  append_runtime_event "$project" "user_daemon_start_precheck_clear" \
    "force=$force"
  if [[ -x "$project/bin/deploy-skills" ]]; then
    "$project/bin/deploy-skills" >/dev/null 2>&1 || log_warn "deploy-skills exited $? (non-fatal)"
  fi
  release_project_start_lock_for_runtime "$project"
