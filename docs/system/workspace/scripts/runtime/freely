develop_push_followthrough_snapshot_for_project() {
  local project="$1"
  local branch upstream ahead behind state summary defer_reason defer_updated_at blocked_reason blocked_updated_at blocked_head blocked_note push_urgency resync_required
  local canonical_develop_project canonical_develop_state canonical_develop_summary canonical_develop_upstream canonical_develop_ahead canonical_develop_behind canonical_develop_defer_reason canonical_develop_defer_updated_at canonical_develop_blocked_reason canonical_develop_blocked_updated_at canonical_develop_blocked_head canonical_develop_blocked_note
  branch="$(branch_name_for_project "$project")"
  state="not_applicable"
  summary="branch_not_develop"
  upstream="none"
  ahead="0"
  behind="0"
  defer_reason="none"
  defer_updated_at="unavailable"
  blocked_reason="none"
  blocked_updated_at="unavailable"
  blocked_head="none"
  blocked_note="none"
  push_urgency="none"
  resync_required="false"

  if [[ "$branch" == "develop" ]]; then
    IFS='|' read -r state summary upstream ahead behind defer_reason defer_updated_at blocked_reason blocked_updated_at blocked_head blocked_note <<<"$(develop_push_followthrough_snapshot_for_develop_project "$project")"
  else
    canonical_develop_project="$(develop_push_followthrough_authoritative_develop_project "$project")"
    if [[ -n "$canonical_develop_project" ]]; then
      IFS='|' read -r canonical_develop_state canonical_develop_summary canonical_develop_upstream canonical_develop_ahead canonical_develop_behind canonical_develop_defer_reason canonical_develop_defer_updated_at canonical_develop_blocked_reason canonical_develop_blocked_updated_at canonical_develop_blocked_head canonical_develop_blocked_note <<<"$(develop_push_followthrough_snapshot_for_develop_project "$canonical_develop_project")"
      if [[ "${canonical_develop_ahead:-0}" =~ ^[0-9]+$ ]] && (( canonical_develop_ahead > 0 )); then
        resync_required="true"
        summary="branch_not_develop canonical_develop_state=${canonical_develop_state} canonical_develop_ahead=${canonical_develop_ahead} canonical_develop_upstream=${canonical_develop_upstream}"
      fi
    fi
  fi

  push_urgency="$(develop_push_followthrough_push_urgency_for_state "$state")"
  printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' "$state" "$summary" "$upstream" "$ahead" "$behind" "$defer_reason" "$defer_updated_at" "$blocked_reason" "$blocked_updated_at" "$blocked_head" "$blocked_note" "$push_urgency" "$resync_required"
}

