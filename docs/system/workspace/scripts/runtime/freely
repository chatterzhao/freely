project_start_lock_snapshot_for_runtime() {
  local project="$1"
  local lock_dir state_file owner_pid="" started_at="" reason="" detail=""
  local line key raw_value value owner_alive="0"
  lock_dir="$(project_start_lock_dir_for_runtime "$project")"
  state_file="$(project_start_lock_state_file_for_runtime "$project")"

  CURRENT_PROJECT_START_LOCK_STATE="idle"
  CURRENT_PROJECT_START_LOCK_DETAIL="lock_dir_absent"
  CURRENT_PROJECT_START_LOCK_OWNER_PID="none"
  CURRENT_PROJECT_START_LOCK_STARTED_AT="none"
  CURRENT_PROJECT_START_LOCK_REASON="none"
  CURRENT_PROJECT_START_LOCK_PATH="$lock_dir"

  if [[ ! -d "$lock_dir" ]]; then
    return 0
  fi

  if [[ ! -f "$state_file" ]]; then
    CURRENT_PROJECT_START_LOCK_STATE="ambiguous"
    CURRENT_PROJECT_START_LOCK_DETAIL="state_file_missing"
    return 0
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"
    raw_value="${line#*=}"
    value="$(strip_simple_shell_quotes "$raw_value")"
    case "$key" in
      owner_pid) owner_pid="$value" ;;
      started_at) started_at="$value" ;;
      reason) reason="$value" ;;
    esac
  done <"$state_file"

  [[ -n "$owner_pid" ]] || owner_pid="none"
  [[ -n "$started_at" ]] || started_at="none"
  [[ -n "$reason" ]] || reason="none"
  CURRENT_PROJECT_START_LOCK_OWNER_PID="$owner_pid"
  CURRENT_PROJECT_START_LOCK_STARTED_AT="$started_at"
  CURRENT_PROJECT_START_LOCK_REASON="$reason"

  if [[ "$owner_pid" == "none" ]]; then
    CURRENT_PROJECT_START_LOCK_STATE="stale"
    CURRENT_PROJECT_START_LOCK_DETAIL="owner_pid_missing"
    return 0
  fi

  if [[ ! "$owner_pid" =~ ^[0-9]+$ ]]; then
    CURRENT_PROJECT_START_LOCK_STATE="ambiguous"
    CURRENT_PROJECT_START_LOCK_DETAIL="owner_pid_malformed"
    return 0
  fi

  if kill -0 "$owner_pid" 2>/dev/null; then
    owner_alive="1"
  fi
  if [[ "$owner_alive" == "1" ]]; then
    CURRENT_PROJECT_START_LOCK_STATE="active"
    CURRENT_PROJECT_START_LOCK_DETAIL="owner_pid_alive"
    return 0
  fi

  CURRENT_PROJECT_START_LOCK_STATE="stale"
  CURRENT_PROJECT_START_LOCK_DETAIL="owner_pid_dead"
}

cleanup_project_start_lock_if_stale_for_runtime() {
