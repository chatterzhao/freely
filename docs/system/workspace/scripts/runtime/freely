  case "${1:-}" in
    fresh_with_handoff) printf 'fresh\n' ;;
    *) printf '%s\n' "${1:-fresh}" ;;
  esac
}

select_launch_kind() {
  local handoff_rotation_reason=""
  local resume_target_before_launch=""
  handoff_rotation_reason="$(session_handoff_rotation_reason "$PROJECT_ROOT" || true)"
  resume_target_before_launch="$(tool_runtime_resume_target_before_launch "$AGENT_AI_TOOL" "$PROJECT_ROOT")"

  # ACP mode: session identity stored in session-store (SQLite).
  # tool_switch_events is the unified truth source for session continuity —
  # consulted FIRST, before session-store, to detect cross-tool switches and
  # bridge restarts that invalidated old sessions.
  if [[ "${AGENT_AI_TOOL_ADAPTER:-direct}" == "acp" ]]; then
    # Fork: worker inherits parent session context.
    if [[ -n "${SESSION_PARENT_ID:-}" && -z "${TOOL_SESSION_ID_CURRENT:-}" \
          && "${LAST_LAUNCH_KIND:-}" != "fork" && -z "${LAST_LAUNCH_KIND:-}" ]]; then
      local role; role="$(role_hint_for_project "$project")"
      if [[ "$role" == "worker" ]]; then
        LAUNCH_KIND_SELECTED="fork"
        LAUNCH_ROTATION_REASON="worker_fork_from_parent_acp"
        LAST_TOOL_RESUME_TARGET="${SESSION_PARENT_ID:-}"
        return 0
      fi
    fi
    # Check tool_switch_events FIRST — before querying session-store.
    # If the tool changed or the bridge restarted, force fresh launch.
    local _ts_launch; _ts_launch="$(_tool_switch_launch_kind "$PROJECT_ROOT")"
    if [[ "$_ts_launch" == "fresh" ]]; then
      LAUNCH_KIND_SELECTED="fresh_with_handoff"
      LAUNCH_ROTATION_REASON="cross_tool_switch"
      return 0
    fi
    # _tool_switch_launch_kind returned resume — trust the session ID from the
    # tool_switch_events record (written by monitor-ai-acp.sh writeback).
    # Avoid a second session-store query: the store may disagree because
    # is_valid_uuid rejects non-UUID formats, stall watchdog marks sessions
    # failed, or get-active returns a different tool's session.
    local _ts_record _ts_sid
    _ts_record="$(_tool_switch_read_latest "$PROJECT_ROOT")"
    if [[ -n "$_ts_record" ]]; then
      IFS='|' read -r _ _ _ _ _ _ _ts_sid _ <<<"$_ts_record"
    fi
    if [[ -n "$_ts_sid" ]]; then
      TOOL_SESSION_ID_CURRENT="$_ts_sid"
      LAST_TOOL_SESSION_ID="$_ts_sid"
      if [[ "${FREELY_ACP_FIRST_LAUNCH_DONE:-0}" == "1" ]]; then
        LAUNCH_KIND_SELECTED="prompt"
        LAUNCH_ROTATION_REASON="acp_multi_turn"
      else
        LAUNCH_KIND_SELECTED="fresh"
        LAUNCH_ROTATION_REASON="acp_first_launch"
      fi
      return 0
    fi
    # No session ID in tool_switch record either — fresh launch.
    LAUNCH_KIND_SELECTED="fresh"
    LAUNCH_ROTATION_REASON="acp_first_launch"
    return 0
  fi

  # Fork detection: if this worktree has a SESSION_PARENT_ID set (by the
  # delegating manager), and it has never launched before (no own session ID),
  # fork from the parent to inherit its context with prompt cache hit.
  if [[ -n "${SESSION_PARENT_ID:-}" && -z "${TOOL_SESSION_ID_CURRENT:-}" ]]; then
    LAUNCH_KIND_SELECTED="fork"
    LAUNCH_ROTATION_REASON="worker_fork_from_parent"
    # Set resume target to parent so tool-launchers.sh passes --resume <parent>
    LAST_TOOL_RESUME_TARGET="${SESSION_PARENT_ID:-}"
    log_info "forking from parent session ${SESSION_PARENT_ID} for new worker"
    return 0
  fi

  # Circuit breaker: if we're in a tight fresh-launch loop, stop early.
  # Tracks fresh launches via session state; trips after MAX in cooldown window.
  _check_fresh_launch_circuit_breaker() {
    local now window count first_at max_count
    now="$(date +%s)"
    window="${FRESH_LAUNCH_COOLDOWN_SECS:-300}"
    count="${FRESH_LAUNCH_COUNT_CURRENT:-0}"
    first_at="${FRESH_LAUNCH_FIRST_AT:-0}"
    # When AI_RESUME_ON_RESTART is true, zero tolerance: even one fresh launch trips the breaker.
    if [[ "${AI_RESUME_ON_RESTART:-false}" == "true" ]]; then
      max_count=1
    else
      max_count="${FRESH_LAUNCH_MAX_COUNT:-3}"
    fi
    if [[ "$first_at" =~ ^[0-9]+$ ]] && (( now - first_at < window )); then
      count=$((count + 1))
      if (( count >= max_count )); then
        log_error "fresh launch circuit breaker tripped: ${count} in ${window}s (max=${max_count}). Restarting supervisor with fresh counters."
        write_workcell_state "$PROJECT_ROOT" "running" "down" "down" "fresh_launch_loop_detected"
        # Exit without stop_marker so watchdog can restart supervisor with reset counters
        exit 0
      fi
    else
      count=1
      first_at="$now"
    fi
    FRESH_LAUNCH_COUNT_CURRENT="$count"
    FRESH_LAUNCH_FIRST_AT="$first_at"
  }

  # Cross-tool switch detection: if tool changed, force fresh launch.
  # Must run BEFORE handoff_rotation_reason case so all paths benefit.
  local _ts_launch; _ts_launch="$(_tool_switch_launch_kind "$PROJECT_ROOT")"

  case "$handoff_rotation_reason" in
    manager_exit_contract_repair|worker_exit_contract_repair)
      if [[ "$_ts_launch" == "resume" && -n "$resume_target_before_launch" ]] && tool_has_resume_evidence "$AGENT_AI_TOOL" "$PROJECT_ROOT" && [[ -z "${AUTO_RECOVERY_ORIGIN_TOOL:-}" || "${AUTO_RECOVERY_ORIGIN_TOOL:-}" == "$AGENT_AI_TOOL" ]]; then
        LAUNCH_KIND_SELECTED="resume"
        LAUNCH_ROTATION_REASON=""
      else
        LAUNCH_KIND_SELECTED="fresh_with_handoff"
        LAUNCH_ROTATION_REASON="missing_resume_evidence"
        _check_fresh_launch_circuit_breaker
      fi
      return 0
      ;;
  esac

  # Cross-tool switch: force fresh, don't try resume from old tool's session
  if [[ "$_ts_launch" == "fresh" ]]; then
    LAUNCH_KIND_SELECTED="fresh_with_handoff"
    LAUNCH_ROTATION_REASON="cross_tool_switch"
    _check_fresh_launch_circuit_breaker
    return 0
  fi

  if [[ "${FIRST_ROUND:-true}" == true ]] \
    && [[ ! -f "$(exit_contract_file "$PROJECT_ROOT")" ]] \
    && [[ -z "${LAST_TOOL_RESUME_TARGET:-}" ]] \
    && [[ -z "${LAST_TOOL_SESSION_ID:-}" ]] \
    && [[ -z "${LAST_LAUNCH_KIND:-}" ]] \
    && [[ -z "${LAST_CYCLE_LOG:-}" ]]; then
    # AI_RESUME_ON_RESTART: restart means a previous launch already ran, so JSONL
    # files MUST exist. If they don't, something is wrong — hard error, no fresh.
    # AI_RESUME_ON_START: first start may not have JSONL yet. Check: if JSONL
    # exists → must resume; if not → allow one fresh (first-ever launch).
    local resume_required="false"
    if [[ "${AI_RESUME_ON_RESTART:-false}" == "true" ]]; then
      resume_required="true"  # restart: JSONL MUST exist, no exceptions
    elif [[ "${AI_RESUME_ON_START:-true}" == "true" ]]; then
      resume_required="check"  # start: check JSONL first
    fi

    # FORCE_FRESH: set by 'freely new-session'. User explicitly requested a fresh
    # launch — skip all JSONL fallback and resume logic.
    if [[ "${FORCE_FRESH:-false}" == "true" ]]; then
      log_info "FORCE_FRESH marker detected, forcing fresh launch"
      LAUNCH_KIND_SELECTED="fresh"
      LAUNCH_ROTATION_REASON="force_fresh"
      unset FORCE_FRESH
      _check_fresh_launch_circuit_breaker
      return 0
    fi

    if [[ "$resume_required" == "true" || "$resume_required" == "check" ]]; then
      local session_dir has_jsonl fallback_id
      session_dir="$(_tool_session_dir "$(_resolve_tool_family "$AGENT_AI_TOOL")" "$PROJECT_ROOT" 2>/dev/null || true)"
      if [[ -n "$session_dir" && -d "$session_dir" ]]; then
        has_jsonl=$(find "$session_dir" -name "*.jsonl" -type f 2>/dev/null | head -1)
      fi

      # session-state.env exists → daemon was running before. Check JSONL.
      local state_file_exists="false"
      [[ -f "$(session_state_file "$PROJECT_ROOT")" ]] && state_file_exists="true"

      if [[ -n "$has_jsonl" ]]; then
        if [[ "$state_file_exists" == "true" || "$resume_required" == "true" ]]; then
          # State file exists or restart required → MUST resume from JSONL.
          fallback_id="$(_find_recent_session_from_tool_dir "$PROJECT_ROOT" "$AGENT_AI_TOOL" || true)"
          if [[ -n "$fallback_id" ]]; then
            log_info "resume: found JSONL session $fallback_id in $session_dir"
            TOOL_SESSION_ID_CURRENT="$fallback_id"
          elif [[ "$resume_required" == "true" ]]; then
            log_error "JSONL files exist but could not extract valid session ID."
            exit 1
          fi
        else
          # Clean start (no state file) + JSONL exists from other sources.
          # Don't force resume — allow fresh. JSONL files might be from other tools.
          log_info "AI_RESUME_ON_START: clean start with existing JSONL, allowing fresh launch"
          LAUNCH_KIND_SELECTED="fresh"
          LAUNCH_ROTATION_REASON="initial_start"
          _check_fresh_launch_circuit_breaker
          return 0
        fi
      elif [[ "$resume_required" == "true" ]]; then
        # Restart: JSONL MUST exist. Hard error.
        log_error "AI_RESUME_ON_RESTART=true but no JSONL files found in $session_dir."
        log_error "A previous launch should have created sessions. Something is wrong."
        log_error "To force a fresh start: freely new-session --project $PROJECT_ROOT"
        exit 1
      else
        # Start: no JSONL → first-ever launch. Allow one fresh.
        log_info "AI_RESUME_ON_START: no JSONL sessions found, allowing initial fresh launch"
        LAUNCH_KIND_SELECTED="fresh"
        LAUNCH_ROTATION_REASON="initial_start"
        _check_fresh_launch_circuit_breaker
        return 0
      fi
    else
      LAUNCH_KIND_SELECTED="fresh"
      LAUNCH_ROTATION_REASON="initial_start"
      _check_fresh_launch_circuit_breaker
      return 0
    fi
  fi

  if [[ "${ROTATE_ON_CONTEXT_COMPACTED:-1}" == "1" && "${LAST_CONTEXT_COMPACTED:-0}" == "1" ]]; then
    LAUNCH_KIND_SELECTED="fresh_with_handoff"
    LAUNCH_ROTATION_REASON="context_compacted"
    _check_fresh_launch_circuit_breaker
    return 0
  fi

  if [[ "${RESUME_STREAK_CURRENT:-0}" -ge "${MAX_RESUME_STREAK:-24}" ]]; then
    LAUNCH_KIND_SELECTED="fresh_with_handoff"
    LAUNCH_ROTATION_REASON="resume_streak_limit"
    _check_fresh_launch_circuit_breaker
    return 0
  fi

  if [[ "${LAST_ROUTE_ONLY_HANDOFF:-0}" == "1" && "${ROUTE_ONLY_STREAK_CURRENT:-0}" -ge "${MAX_ROUTE_ONLY_STREAK:-1}" ]]; then
    LAUNCH_KIND_SELECTED="fresh_with_handoff"
    LAUNCH_ROTATION_REASON="route_only_handoff"
    _check_fresh_launch_circuit_breaker
    return 0
  fi

  if ratio_meets_threshold "${LAST_CONTEXT_RATIO:-}" "${CONTEXT_ROTATE_RATIO:-0.70}"; then
    LAUNCH_KIND_SELECTED="fresh_with_handoff"
    LAUNCH_ROTATION_REASON="context_usage_threshold"
    _check_fresh_launch_circuit_breaker
    return 0
  fi

  if [[ "${LAST_PROJECT_DIRTY_ENTRIES:-0}" =~ ^[0-9]+$ ]] && (( LAST_PROJECT_DIRTY_ENTRIES >= ${CHECKPOINT_BLOCK_DIRTY_ENTRIES:-120} )); then
    LAUNCH_KIND_SELECTED="fresh_with_handoff"
    LAUNCH_ROTATION_REASON="checkpoint_dirty_budget"
    _check_fresh_launch_circuit_breaker
    return 0
  fi

  if tool_prefers_resume_evidence "$AGENT_AI_TOOL" && ! tool_has_resume_evidence "$AGENT_AI_TOOL" "$PROJECT_ROOT"; then
    # AI_RESUME_ON_RESTART: prefer resume even without verified evidence (e.g. stall-killed)
    if [[ "${AI_RESUME_ON_RESTART:-true}" == "true" ]]; then
      LAUNCH_KIND_SELECTED="resume"
      LAUNCH_ROTATION_REASON="prefer_resume_without_evidence"
      return 0
    fi
    LAUNCH_KIND_SELECTED="fresh_with_handoff"
    LAUNCH_ROTATION_REASON="missing_resume_evidence"
    _check_fresh_launch_circuit_breaker
    return 0
  fi

  LAUNCH_KIND_SELECTED="resume"
  LAUNCH_ROTATION_REASON=""
}

