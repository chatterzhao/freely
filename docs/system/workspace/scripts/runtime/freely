        print(f"  --force = 永久丢弃。不是废弃严禁使用。门禁报错去解决问题，不是绕过。")

# Scan dedup hint
scan_covered = set()
for r in rows:
    if r["scan_match"]:
        scan_covered.add("platform_sync_batch" if "platform_sync" in r["scan_match"] else r["intent"])
if scan_covered:
    print()
    print("### Scan Dedup: Active Workers vs Current Scan")
    for sc in sorted(scan_covered):
        active_count = sum(1 for r in rows if sc in r.get("scan_match", "") or r["intent"] == sc)
        print(f"- `{sc}`: {active_count} active/pending worker(s) → check if new scan item is the same task before delegating")
PYEOF
}

