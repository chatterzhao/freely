manager_continuity_resume_focus_route_kind() {
  local continuity_file="$1"
  [[ -f "$continuity_file" ]] || return 1
  awk '
    /^## / && !in_section && !top_section_done { top_section_done=1 }
    !in_section && !top_section_done && /route_kind:/ {
      if (match($0, /`[^`]+`/)) {
        value=substr($0, RSTART + 1, RLENGTH - 2)
        print value
        exit
      }
    }
    /^## Ownership And Restart Point$/ { in_section=1; next }
    /^## Primary Judgement$/ { in_section=1; next }
    /^## / && in_section { exit }
    in_section && /route_kind:/ {
      if (match($0, /`[^`]+`/)) {
        value=substr($0, RSTART + 1, RLENGTH - 2)
        print value
        exit
      }
    }
  ' "$continuity_file"
}

manager_continuity_resume_focus_section() {
  local continuity_file="$1" primary_heading="$2" secondary_heading="${3:-}"
  [[ -f "$continuity_file" ]] || return 1
  awk -v primary="$primary_heading" -v secondary="$secondary_heading" '
    BEGIN {
      primary_header="## " primary
      secondary_header=(secondary == "" ? "" : "## " secondary)
    }
    $0 == primary_header { in_section=1; print; next }
    secondary_header != "" && $0 == secondary_header { in_section=1; print; next }
    /^## / && in_section { exit }
    in_section { print }
  ' "$continuity_file"
}

manager_continuity_cleanup_retirement_targets() {
  local continuity_file="$1"
  [[ -f "$continuity_file" ]] || return 1
  awk '
    /^## Cleanup Queue$/ { in_section=1; next }
    /^## / && in_section { exit }
    in_section && (/target_paths:/ || /cleanup_targets:/) { in_targets=1; next }
    in_section && in_targets && /^   - / {
      line=$0
      sub(/^   - /, "", line)
      gsub(/`/, "", line)
      print line
      next
    }
    in_targets && !/^   - / { in_targets=0 }
  ' "$continuity_file"
}

