# Guard against recursive build_prompt → build_handoff_only_prompt → build_prompt loop
_BUILD_HANDOFF_ONLY_GUARD=0

build_handoff_only_prompt() {
	local project="$1"
	local contract_path
	contract_path="$(exit_contract_file "$project")"
	if [[ ! -f "$contract_path" ]]; then
		if [[ "$_BUILD_HANDOFF_ONLY_GUARD" -eq 1 ]]; then
			log_warn "handoff-only prompt: no handoff file found AND recursive guard active; building minimal delta prompt"
			cat <<PROMPT_FALLBACK
# Context Rotation (No Handoff File)

The previous session reached high context capacity but no structured handoff
file was found. Continue based on your training knowledge and the workspace
state visible to you.

$(context_summary_target_hint "$project")
PROMPT_FALLBACK
			return 0
		fi
		log_warn "handoff-only prompt requested but no handoff file found at $contract_path; falling back to full prompt"
		_BUILD_HANDOFF_ONLY_GUARD=1
		build_prompt
		return 0
	fi
	local _pct
	_pct="$(awk -v r="${LAST_CONTEXT_RATIO:-0}" 'BEGIN { printf "%.0f", r * 100 }' 2>/dev/null || echo "unknown")"
	cat <<PROMPT_HANDOFF_ONLY
# Context Rotation Handover

This is a CLEAN session created after a context-rotation trigger.
The OLD session reached ${_pct}% context capacity.

The ONLY context available is the handoff below. DO NOT assume any prior
session state, tool output, or conversation history exists.

Read the handoff carefully and continue from where it left off.

PROMPT_HANDOFF_ONLY

	cat "$contract_path"

	cat <<PROMPT_HANDOFF_ONLY_TAIL

## Continuation Instructions

1. First verify the current state of the workspace (git status, worktree state).
2. Pick up from the Recovery Hints in the handoff above.
3. If the handoff mentions continuation artifacts, read them for additional context.
4. Output a \`\`\`handoff JSON block at the end of your reply so runtime can
   persist your continuation state for the next rotation.

$(context_summary_target_hint "$project")
PROMPT_HANDOFF_ONLY_TAIL
}

