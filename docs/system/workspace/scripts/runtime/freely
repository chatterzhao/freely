materialize_manager_worker_terminal_continuation() {
  local project="$1" worker_project="$2" branch="$3" terminal_kind="$4"
  local contract_file intake_id created_at meta_file resolution_dir resolution_artifact
  local contract_summary manager_next_action linked_artifact content intake_message
  local owner_issue artifact_dir closeout_target_lane closeout_gate_command closeout_promotion_gate evidence_paths_csv
  # contract reads from DB; verification metadata falls back to verification contract
  manager_exit_contract_kind "$project" >/dev/null 2>&1 || return 1

  case "$terminal_kind" in
    worker_done)
      contract_summary="$(_db_exit_contract_field "$project" worker completion_summary)"
      manager_next_action="Consume this completed worker result before broad patrol, then decide manager-owned closeout, merge judgement, retirement, or next dispatch."
      ;;
    worker_blocked)
      contract_summary="$(_db_exit_contract_field "$project" worker reason)"
      manager_next_action="Consume this blocked worker result before broad patrol, then decide manager-owned unblock, re-dispatch, or bounded stop."
      ;;
    worker_handoff_needed)
      contract_summary="$(_db_exit_contract_field "$project" worker reason)"
      manager_next_action="Consume this worker handoff before broad patrol, then decide manager-owned followthrough or next dispatch."
      ;;
    *)
      contract_summary="terminal worker result observed"
      manager_next_action="Consume this terminal worker result before broad patrol."
      ;;
  esac
  [[ -n "$contract_summary" ]] || contract_summary="summary_missing"

  owner_issue="$(meta_env_value "$contract_file" "OWNER_ISSUE")"
  [[ -n "$owner_issue" ]] || owner_issue="$(meta_env_value "$(worker_verification_contract_file "$worker_project")" "OWNER_ISSUE")"
  artifact_dir="$(meta_env_value "$contract_file" "VERIFICATION_ARTIFACT_DIR")"
  [[ -n "$artifact_dir" ]] || artifact_dir="$(meta_env_value "$(worker_verification_contract_file "$worker_project")" "VERIFICATION_ARTIFACT_DIR")"
  closeout_target_lane="$(meta_env_value "$contract_file" "CLOSEOUT_TARGET_LANE")"
  [[ -n "$closeout_target_lane" ]] || closeout_target_lane="$(meta_env_value "$(worker_verification_contract_file "$worker_project")" "CLOSEOUT_TARGET_LANE")"
  closeout_gate_command="$(meta_env_value "$contract_file" "CLOSEOUT_GATE_COMMAND")"
  [[ -n "$closeout_gate_command" ]] || closeout_gate_command="$(meta_env_value "$(worker_verification_contract_file "$worker_project")" "CLOSEOUT_GATE_COMMAND")"
  closeout_promotion_gate="$(meta_env_value "$contract_file" "CLOSEOUT_PROMOTION_GATE")"
  [[ -n "$closeout_promotion_gate" ]] || closeout_promotion_gate="$(meta_env_value "$(worker_verification_contract_file "$worker_project")" "CLOSEOUT_PROMOTION_GATE")"
  evidence_paths_csv="$(_db_exit_contract_field "$project" worker evidence_paths)"

  intake_id="$(manager_worker_terminal_continuation_intake_id "$project" "$branch" "$terminal_kind" "$worker_project")"
  meta_file="$(intake_item_meta_file "$project" "$intake_id")"
  created_at="$(current_timestamp_utc_for_machine)"
  if [[ -f "$meta_file" ]]; then
    created_at="$(meta_env_value "$meta_file" "CREATED_AT")"
    [[ -n "$created_at" ]] || created_at="$(current_timestamp_utc_for_machine)"
  fi

  linked_artifact="$contract_file"
  content="$(cat <<EOF
# Resolution
- worker_terminal_state: ${terminal_kind}
- worker_project: \`${worker_project}\`
- worker_branch: \`${branch:-unknown}\`
- contract_file: \`${contract_file}\`
- owner_issue: \`${owner_issue:-unknown}\`
- verification_artifact_dir: \`${artifact_dir:-unknown}\`
- closeout_target_lane: \`${closeout_target_lane:-unknown}\`
- closeout_gate_command: \`${closeout_gate_command:-unknown}\`
- closeout_promotion_gate: \`${closeout_promotion_gate:-unknown}\`
- summary: ${contract_summary}
- next_restart_point: \`consume worker terminal result from ${worker_project}\`
- next_ownership: \`manager\`
- handoff_summary: Manager must absorb this worker terminal result before broad patrol so merge / cleanup / next-dispatch sequencing stays attached to the completed lane.
EOF
)"
  if [[ -n "$evidence_paths_csv" ]]; then
    content="${content}"$'\n'"- evidence_paths_csv: \`${evidence_paths_csv}\`"
  fi
  resolution_dir="$(
    write_interruption_resolution_artifact \
      "$project" "$intake_id" "manager-runtime-worker-terminal-recovery" "followup" "continuation" "handoff://continuation" "$linked_artifact" "$project" "delegated" "$content"
  )"
  resolution_artifact="$resolution_dir/resolution.md"
  intake_message="$(cat <<EOF
worker terminal followthrough
- worker_project: \`${worker_project}\`
- worker_branch: \`${branch:-unknown}\`
- worker_terminal_kind: \`${terminal_kind}\`
- summary: ${contract_summary}
- owner_issue: \`${owner_issue:-unknown}\`
- verification_artifact_dir: \`${artifact_dir:-unknown}\`
- closeout_target_lane: \`${closeout_target_lane:-unknown}\`
- closeout_gate_command: \`${closeout_gate_command:-unknown}\`
- closeout_promotion_gate: \`${closeout_promotion_gate:-unknown}\`
- next_action: ${manager_next_action}
EOF
)"
  if worker_terminal_continuation_materialization_is_current \
    "$project" \
    "$intake_id" \
    "$linked_artifact" \
    "$resolution_artifact" \
    "$intake_message" \
    "$content"; then
    return 0
  fi
  write_intake_item \
    "$project" \
    "$intake_id" \
    "manager-runtime-worker-terminal-recovery" \
    "delegation" \
    "delegated" \
    "continuation" \
    "$linked_artifact" \
    "$project" \
    "[]" \
    "$intake_message" \
    "followup" \
    "manager-runtime-worker-terminal-recovery" \
    "$created_at" \
    "handoff://continuation" \
    "$resolution_artifact" \
    "$created_at" >/dev/null
  request_local_continuation_reentry "$project" "$intake_id"
  printf '%s\n' "$intake_id"
}

worker_terminal_continuation_materialization_is_current() {
  local project="$1" intake_id="$2" linked_artifact="$3" resolution_artifact="$4" intake_message="$5" resolution_content="$6"
  local meta_file message_file
  meta_file="$(intake_item_meta_file "$project" "$intake_id")"
  message_file="$(intake_item_message_file "$project" "$intake_id")"
  [[ -f "$meta_file" && -f "$message_file" && -n "$resolution_artifact" && -f "$resolution_artifact" ]] || return 1
  [[ "$(meta_env_value "$meta_file" "STATUS")" == "delegated" ]] || return 1
  [[ "$(meta_env_value "$meta_file" "CLASSIFICATION")" == "continuation" ]] || return 1
  [[ "$(meta_env_value "$meta_file" "REACTION")" == "followup" ]] || return 1
  [[ "$(meta_env_value "$meta_file" "CLAIMED_BY")" == "manager-runtime-worker-terminal-recovery" ]] || return 1
  [[ "$(meta_env_value "$meta_file" "LINKED_ARTIFACT")" == "$linked_artifact" ]] || return 1
  [[ "$(meta_env_value "$meta_file" "DELEGATED_WORKTREE")" == "$project" ]] || return 1
  [[ "$(meta_env_value "$meta_file" "ABSORPTION_TARGET")" == "handoff://continuation" ]] || return 1
  [[ "$(meta_env_value "$meta_file" "RESOLUTION_ARTIFACT")" == "$resolution_artifact" ]] || return 1
  [[ "$(cat "$message_file" 2>/dev/null || true)" == "$intake_message" ]] || return 1
  [[ "$(cat "$resolution_artifact" 2>/dev/null || true)" == "$resolution_content" ]] || return 1
  return 0
}

# Query friedly.db chats table for unconsumed human messages (docs/B1-docs/ migration).
# Complements intake_snapshot_for_project which reads legacy .freely/intake/.
chat_intake_snapshot_for_project() {
  local project="$1" limit="${2:-8}"
  local _db_path _rows
  _db_path="$project/.freely/freely.db"
  [[ -f "$_db_path" ]] || return 0
  _rows=$(python3 -c "
import sqlite3, sys
try:
    db = sqlite3.connect('$_db_path')
    rows = db.execute('SELECT id, chat_type, issue_id, author, message, created_at FROM chats WHERE consumed = 0 ORDER BY id DESC LIMIT $limit').fetchall()
    for r in rows:
        cid, ctype, issue, author, msg, created = r
        msg_preview = (msg or '')[:120].replace(chr(10),' ')
        print(f'- id=chat-{cid} status=pending type={ctype} author={author} issue={issue} created_at={created} message={msg_preview}')
    db.close()
except: pass
" 2>/dev/null || true)
  [[ -n "$_rows" ]] || return 0
  printf 'chat messages (freely.db):\n%s\n' "$_rows"
}

intake_snapshot_for_project() {
  local project="$1" limit="${2:-8}"
