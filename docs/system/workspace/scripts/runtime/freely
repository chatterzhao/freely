tool_select_ready_slot_for_manager_auto_recovery() {
  local project="$1" tool="$2" mode="${3:-entry}" selected_slot=""
  TOOL_AUTO_RECOVERY_SLOT=""
  case "$tool" in
    codex)
      ensure_codex_slot_ready_for_manager "$project" || return 1
      selected_slot="$(runtime_read_tool_current_slot "$project" "$tool")"
      ;;
    *)
      if [[ "$mode" == "after_failure" ]]; then
        selected_slot="$(runtime_next_tool_slot_after_current "$project" "$tool" || true)"
