discover_supervisor_pids() {
  local project="$1" excluded_pids="${2:-}"
  local project_regex
  process_inspection_available || return 0
  project_regex="$(printf '%s\n' "$project" | sed 's/[][(){}.^$+*?|\\]/\\&/g')"
  if command -v pgrep >/dev/null 2>&1; then
    {
      pgrep -fal "runtime/freely start.*${project_regex}" 2>/dev/null || true
      pgrep -fal "runtime/freely daemon-run.*${project_regex}" 2>/dev/null || true
    } | awk -v p="$project" -v excluded="$excluded_pids" '
      BEGIN {
        split(excluded, raw, ",")
        for (i in raw) {
          if (raw[i] != "") {
            skip[raw[i]] = 1
          }
        }
      }
      {
        if (skip[$1]) {
          next
        }
        for (i = 1; i <= NF; i++) {
          if ($i == "--project" && (i + 1) <= NF && $(i + 1) == p) {
            print $1
            next
          }
          if (index($i, "--project=") == 1 && substr($i, 11) == p) {
            print $1
            next
          }
        }
      }
    '
    return 0
  fi
  ps -axo pid=,command= 2>/dev/null | awk -v p="$project" -v excluded="$excluded_pids" '
    BEGIN {
      split(excluded, raw, ",")
      for (i in raw) {
        if (raw[i] != "") {
          skip[raw[i]] = 1
        }
      }
    }
    index($0, "runtime/freely start") || index($0, "runtime/freely daemon-run") {
      if (skip[$1]) {
        next
      }
      for (i = 1; i <= NF; i++) {
        if ($i == "--project" && (i + 1) <= NF && $(i + 1) == p) {
          print $1
          next
        }
        if (index($i, "--project=") == 1 && substr($i, 11) == p) {
          print $1
          next
        }
      }
    }
  '
}

