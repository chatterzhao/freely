worker_runtime_reactivation_allowed() {
  local project="$1"
  local role desired_state last_exit_reason supervisor_pid ai_pid
  role="$(role_hint_for_project "$project")"
  [[ "$role" == "worker" ]] || return 1
  desired_state="unknown"
  last_exit_reason=""
  if [[ -f "$(workcell_state_file "$project")" ]]; then
    # shellcheck disable=SC1090
    source "$(workcell_state_file "$project")"
    desired_state="${DESIRED_RUNTIME_STATE:-unknown}"
    last_exit_reason="${LAST_EXIT_REASON:-}"
  fi
  [[ "$desired_state" == "stopped" ]] || return 1
  [[ "$last_exit_reason" == "operator_stop" ]] || return 1
  supervisor_pid="$(manager_supervisor_pid_for_project "$project")"
  ai_pid="$(runtime_ai_pid_hint_for_project "$project")"
