runtime_network_failure_reason_from_log() {
  local project="$1" log_file="$2"
  local state_file now_epoch last_epoch last_count next_retry_epoch reason failure_count window_secs budget base_delay max_delay backoff cooldown
  [[ -f "$log_file" ]] || return 1

  if log_has_proxy_config_invalid "$log_file"; then
    now_epoch="$(date +%s)"
    next_retry_epoch="$((now_epoch + $(proxy_config_invalid_retry_secs)))"
    persist_execution_network_state "$project" "proxy_config_invalid" 1 "$next_retry_epoch" "$now_epoch"
    printf 'proxy_config_invalid\n'
    return 0
  fi

  log_has_execution_network_failure "$log_file" || return 1

  state_file="$(execution_network_state_file "$project")"
  last_epoch=0
  last_count=0
  if [[ -f "$state_file" ]]; then
    unset EXECUTION_NETWORK_REASON EXECUTION_NETWORK_FAILURE_COUNT EXECUTION_NETWORK_NEXT_RETRY_EPOCH EXECUTION_NETWORK_LAST_FAILURE_EPOCH
    # shellcheck disable=SC1090
    source "$state_file"
    last_epoch="${EXECUTION_NETWORK_LAST_FAILURE_EPOCH:-0}"
    last_count="${EXECUTION_NETWORK_FAILURE_COUNT:-0}"
  fi

  now_epoch="$(date +%s)"
  window_secs="$(execution_network_window_secs)"
  if [[ "$last_epoch" =~ ^[0-9]+$ ]] && (( now_epoch - last_epoch <= window_secs )); then
    failure_count=$((last_count + 1))
  else
    failure_count=1
  fi

  budget="$(execution_network_budget)"
  if (( failure_count > budget )); then
    cooldown="$(execution_network_persistent_cooldown_secs)"
    next_retry_epoch="$((now_epoch + cooldown))"
    reason="execution_network_persistent"
  else
    base_delay="$(execution_network_transient_base_delay_secs)"
    max_delay="$(execution_network_transient_max_delay_secs)"
    backoff=$((base_delay << (failure_count - 1)))
    if (( backoff > max_delay )); then
      backoff="$max_delay"
    fi
    next_retry_epoch="$((now_epoch + backoff))"
    reason="execution_network_transient"
  fi

  persist_execution_network_state "$project" "$reason" "$failure_count" "$next_retry_epoch" "$now_epoch"
  printf '%s\n' "$reason"
}

execution_network_launch_block_active() {
  local project="$1" failure_reason="$2"
  local state_file now_epoch next_retry_epoch
  case "$failure_reason" in
    execution_network_transient|execution_network_persistent|proxy_config_invalid) ;;
    *) return 1 ;;
  esac
  state_file="$(execution_network_state_file "$project")"
  [[ -f "$state_file" ]] || return 1
  unset EXECUTION_NETWORK_REASON EXECUTION_NETWORK_FAILURE_COUNT EXECUTION_NETWORK_NEXT_RETRY_EPOCH EXECUTION_NETWORK_LAST_FAILURE_EPOCH
  # shellcheck disable=SC1090
  source "$state_file"
  next_retry_epoch="${EXECUTION_NETWORK_NEXT_RETRY_EPOCH:-0}"
  [[ "$next_retry_epoch" =~ ^[0-9]+$ ]] || return 1
  now_epoch="$(date +%s)"
  (( now_epoch < next_retry_epoch ))
}

