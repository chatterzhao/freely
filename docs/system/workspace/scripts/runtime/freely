- 当前轮次为 fresh session，但不是第一次启动。
- 先吸收下面这份交接记录，再继续 Freely 的首跳闭环。
- 若交接中的旧结论与仓库现状冲突，以当前仓库事实为准。

EOF
  cat "$handoff_path"
}

write_manager_bootstrap_handoff() {
  local project="$1" trigger="$2" previous_account="$3" active_account="$4" reason="$5" next_action="$6"
  local handoff_path branch fleet_snapshot
  handoff_path="$(handoff_file "$project")"
  branch="$(git -C "$project" branch --show-current 2>/dev/null || true)"
  fleet_snapshot="$(fleet_status_text_for_project "$project")"

  cat >"$handoff_path" <<EOF
# Session Handoff

- rotation_reason: manager_bootstrap_watchdog
- previous_launch_kind: ensure-manager
- previous_tool_session_id: unavailable://manager-relaunched-by-script
- previous_tool_jsonl_path: unavailable://manager-relaunched-by-script
- previous_cycle_log: unavailable://manager-relaunched-by-script
- previous_context_ratio: unavailable
- previous_route_only_handoff: 0
- previous_project_dirty_entries: 0
- previous_worktree_summary_total: 0
- previous_worktree_summary_dirty: 0
- branch: ${branch:-unknown}
- worktree_path: $project

## Manager Bootstrap Recovery
- trigger: ${trigger:-unknown}
- previous_account: ${previous_account:-unavailable}
- active_account: ${active_account:-unavailable}
- reason: ${reason:-unavailable}
- next_action: ${next_action:-check-fleet-and-continue}

## What To Handle First
- The previous manager chain stopped or became unusable before this new session started.
- First inspect the fleet snapshot and decide which worktrees should keep running, which should be resumed, and which should remain stopped.
- If a worktree is expected-running but currently down, decide whether runtime recovery should proceed with resume or whether a fresh_with_handoff rotation is safer.
- Do not redo global account switching here; that recovery was already owned by the watchdog script.

## Summary Target Hint
$(context_summary_target_hint "$project")
EOF

  if [[ -n "$fleet_snapshot" ]]; then
    cat >>"$handoff_path" <<EOF

## Fleet Snapshot
\`\`\`
$fleet_snapshot
\`\`\`
EOF
  fi
}

append_context_warning_if_needed() {
  if [[ "${LAUNCH_KIND_SELECTED:-}" != "resume" ]]; then
    return 0
  fi
  if ! ratio_meets_threshold "${LAST_CONTEXT_RATIO:-}" "${CONTEXT_WARN_RATIO:-0.50}"; then
    return 0
  fi
  cat <<EOF

上下文容量预警：
- 上一轮 Codex context ratio: ${LAST_CONTEXT_RATIO}
- 本地 warn 阈值: ${CONTEXT_WARN_RATIO:-0.50}
- 在继续当前 issue 前，先更新当前阶段对应的 continuity artifact，再继续推进。

$(context_summary_target_hint "$PROJECT_ROOT")
EOF
}

append_checkpoint_governance_if_needed() {
  local dirty_entries warn_threshold block_threshold checkpoint_json checkpoint_required reason_codes scope_count story_scope_count
  dirty_entries="${LAST_PROJECT_DIRTY_ENTRIES:-0}"
  warn_threshold="${CHECKPOINT_WARN_DIRTY_ENTRIES:-40}"
  block_threshold="${CHECKPOINT_BLOCK_DIRTY_ENTRIES:-120}"
  checkpoint_json="$(checkpoint_guard_json_for_project "$PROJECT_ROOT")"
  checkpoint_required="$(checkpoint_guard_value "$checkpoint_json" checkpoint_required)"
  reason_codes="$(checkpoint_guard_reason_codes "$checkpoint_json")"
  scope_count="$(checkpoint_guard_value "$checkpoint_json" scope_count)"
  story_scope_count="$(checkpoint_guard_value "$checkpoint_json" story_scope_count)"

  [[ "$dirty_entries" =~ ^[0-9]+$ ]] || dirty_entries=0
  if (( dirty_entries < warn_threshold )) && [[ "$checkpoint_required" != "true" ]]; then
    return 0
  fi

  cat <<EOF

Checkpoint governance:
- current_project_dirty_entries: ${dirty_entries}
- checkpoint_warn_dirty_entries: ${warn_threshold}
- checkpoint_block_dirty_entries: ${block_threshold}
- current_worktree_dirty_summary: ${LAST_WORKTREE_SUMMARY_DIRTY:-0}/${LAST_WORKTREE_SUMMARY_TOTAL:-0}
- checkpoint_required_now: ${checkpoint_required:-false}
- checkpoint_reason_codes: ${reason_codes:-none}
- checkpoint_scope_count: ${scope_count:-0}
- checkpoint_story_scope_count: ${story_scope_count:-0}
- Before adding more implementation, first update the phase-appropriate continuity artifact and cut a checkpoint commit when the current issue boundary is verified.
- If current work should be split by ownership, move unrelated changes into another dedicated worktree instead of letting this tree keep expanding.

$(context_summary_target_hint "$PROJECT_ROOT")
EOF
}

append_checkpoint_intervention_if_needed() {
