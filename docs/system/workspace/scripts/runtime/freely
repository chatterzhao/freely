ratio_meets_threshold() {
  local ratio="$1" threshold="$2"
  [[ -n "$ratio" && -n "$threshold" ]] || return 1
  awk -v ratio="$ratio" -v threshold="$threshold" 'BEGIN { exit !(ratio >= threshold) }'
}

slugify_text() {
  local text="$1"
  printf '%s\n' "$text" \
    | tr '[:upper:]' '[:lower:]' \
    | tr -cs 'a-z0-9' '-' \
    | sed 's/^-//; s/-$//' \
    | cut -c1-32
}

next_intake_id() {
  local project="$1" message="$2"
  local ts slug base candidate n intake_root
  ts="$(date '+%Y%m%d-%H%M%S')"
  slug="$(slugify_text "$message")"
  [[ -n "$slug" ]] || slug="message"
  base="${ts}-${slug}"
  candidate="$base"
  n=1
  intake_root="$(intake_dir_for_project "$project")"
  mkdir -p "$intake_root"
  while [[ -e "$intake_root/$candidate" ]]; do
    n=$((n + 1))
    candidate="${base}-${n}"
  done
  printf '%s\n' "$candidate"
}

count_intake_items_by_status() {
  local project="$1" expected_status="$2"
  local intake_root meta_file count
  intake_root="$(intake_dir_for_project "$project")"
  [[ -d "$intake_root" ]] || {
    printf '0\n'
    return 0
  }
  count=0
  while IFS= read -r meta_file; do
    [[ -f "$meta_file" ]] || continue
    if awk -F '"' -v expected="$expected_status" '/^STATUS=/{ if ($2 == expected) found=1 } END { exit found ? 0 : 1 }' "$meta_file"; then
      count=$((count + 1))
    fi
  done < <(find "$intake_root" -mindepth 2 -maxdepth 2 -type f -name meta.env | sort)
  printf '%s\n' "$count"
}

count_active_intake_items() {
  local project="$1"
  local intake_root meta_file count status
  intake_root="$(intake_dir_for_project "$project")"
  [[ -d "$intake_root" ]] || {
    printf '0\n'
    return 0
  }
  count=0
  while IFS= read -r meta_file; do
    [[ -f "$meta_file" ]] || continue
    status="$(awk -F '"' '/^STATUS=/{print $2; exit}' "$meta_file")"
    case "$status" in
      absorbed|dropped) ;;
      *) count=$((count + 1)) ;;
    esac
  done < <(find "$intake_root" -mindepth 2 -maxdepth 2 -type f -name meta.env | sort)
  printf '%s\n' "$count"
}

has_local_delegated_worker_reactivation_target() {
  local project="$1"
  local intake_root meta_file status absorption_target delegated_worktree project_real delegated_real
  intake_root="$(intake_dir_for_project "$project")"
  [[ -d "$intake_root" ]] || return 1
  project_real="$(cd "$project" && pwd -P)"
  while IFS= read -r meta_file; do
    [[ -f "$meta_file" ]] || continue
    status="$(meta_env_value "$meta_file" "STATUS")"
    absorption_target="$(meta_env_value "$meta_file" "ABSORPTION_TARGET")"
    delegated_worktree="$(meta_env_value "$meta_file" "DELEGATED_WORKTREE")"
    [[ "$status" == "delegated" ]] || continue
    case "$absorption_target" in
      handoff://continuation|handoff://verification) ;;
      *) continue ;;
    esac
    delegated_real=""
    if [[ -n "$delegated_worktree" ]]; then
      delegated_real="$(cd "$delegated_worktree" 2>/dev/null && pwd -P || true)"
    fi
    if [[ -z "$delegated_real" || "$delegated_real" == "$project_real" ]]; then
      return 0
    fi
  done < <(find "$intake_root" -mindepth 2 -maxdepth 2 -type f -name meta.env | sort)
  return 1
}

meta_env_value() {
  local meta_file="$1" key="$2"
  [[ -f "$meta_file" ]] || return 0
  awk -F '"' -v key="$key" '$1 == key "=" { print $2; exit }' "$meta_file"
}

validate_reaction_or_fail() {
  local reaction="$1"
  case "$reaction" in
    steer|followup|collect|interrupt|noise) ;;
