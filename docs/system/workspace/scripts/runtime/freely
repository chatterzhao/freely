kiro_monthly_limit_reset_epoch_from_log() {
  local log_file="$1" reset_epoch
  [[ -f "$log_file" ]] || return 1
  reset_epoch="$(python3 - <<'PY' "$log_file" "${FREELY_TEST_NOW_EPOCH:-}" 2>/dev/null || true
import datetime as dt
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
now_arg = sys.argv[2].strip()
text = path.read_text(encoding="utf-8", errors="ignore")
match = re.search(r'reset on\s+([0-9]{2})/([0-9]{2})', text, re.IGNORECASE)
if now_arg.isdigit():
    now = dt.datetime.fromtimestamp(int(now_arg))
else:
    now = dt.datetime.now()

if match:
    month = int(match.group(1))
    day = int(match.group(2))
    year = now.year
    candidate = dt.datetime(year, month, day)
    if candidate < now:
        candidate = dt.datetime(year + 1, month, day)
else:
    if now.month == 12:
        candidate = dt.datetime(now.year + 1, 1, 1)
    else:
        candidate = dt.datetime(now.year, now.month + 1, 1)

print(int(candidate.timestamp()))
PY
)"
  [[ "$reset_epoch" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$reset_epoch"
}

