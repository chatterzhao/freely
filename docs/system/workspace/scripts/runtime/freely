runtime_proxy_self_heal_explicit_candidate_available() {
  local project="$1" values cfg explicit_url explicit_all explicit_http explicit_https explicit_no_proxy
  while IFS= read -r cfg; do
    [[ -f "$cfg" ]] || continue
    values="$(freely_network_proxy_read_config_values "$cfg" || true)"
    [[ -n "$values" ]] || continue
    IFS=$'\x1f' read -r _ explicit_url explicit_all explicit_http explicit_https explicit_no_proxy <<<"$values"
    if [[ -n "${explicit_url:-}" || -n "${explicit_all:-}" || -n "${explicit_http:-}" || -n "${explicit_https:-}" || -n "${explicit_no_proxy:-}" ]]; then
      return 0
    fi
  done < <(printf '%s\n' "$(freely_network_proxy_project_config_file "$project")" "$(freely_network_proxy_global_config_file)")
