LAST_TASK_SOURCE_SCAN_REASON="$regeneration_reason"
LAST_TASK_SOURCE_SCAN_GENERATED_AT="$generated_at"
LAST_TASK_SOURCE_SCAN_PROJECT_HEAD="$project_head"
EOF
}
append_task_source_patrol_seed_if_needed() {
  local scan_json_path scan_reason active_running_workers skip_if_active="${1:-}"

  [[ "$(role_hint_for_project "$PROJECT_ROOT")" == "manager" ]] || return 0
  # Only skip scan for active workers in prompt (delta) path — the Manager
  # already has full context from the fresh cycle and should process worker
  # results first. Fresh/fork cycles always show scan for full task visibility.
  if [[ "$skip_if_active" == "skip_if_active" ]]; then
    active_running_workers="$(manager_semantic_loop_active_worker_count_for_project "$PROJECT_ROOT" 2>/dev/null || true)"
    [[ "$active_running_workers" =~ ^[0-9]+$ ]] || active_running_workers="0"
    if (( active_running_workers > 0 )); then
      return 0
    fi
  fi

  scan_reason="$(task_source_scan_regeneration_reason_for_project "$PROJECT_ROOT" 2>/dev/null || true)"
  if [[ -n "$scan_reason" ]]; then
    write_task_source_scan_json_for_project "$PROJECT_ROOT" "$scan_reason" >/dev/null
  else
    if [[ ! -f "$(task_source_scan_json_path_for_project "$PROJECT_ROOT")" ]] || [[ ! -s "$(task_source_scan_json_path_for_project "$PROJECT_ROOT")" ]]; then
      write_task_source_scan_json_for_project "$PROJECT_ROOT" "bootstrap_missing_scan" >/dev/null
    fi
    scan_reason="reuse_existing_scan"
  fi
  scan_json_path="$(task_source_scan_json_path_for_project "$PROJECT_ROOT")"

  # Inject current task mode before the scan section
  local _tm_mode _tm_info
  _tm_mode="$(read_task_mode "$PROJECT_ROOT")"
  case "$_tm_mode" in
    auto) _tm_info="task-auto: 自动模式 — 从 scan 中找任务、做任务、收口、循环" ;;
    wait) _tm_info="task-wait: 等待模式 — 不主动找任务，等待用户通过 task-mode set 指令切换" ;;
    listen) _tm_info="task-listen: 监听模式 — 定期 scan，发现任务后自动切换到 auto" ;;
    id:*) _tm_info="task-id: 指定任务模式 — 仅处理 scan-id=${_tm_mode#id:} 的任务，收口后自动切回 wait" ;;
    *) _tm_info="task-mode: ${_tm_mode:-unknown}" ;;
  esac

  # For task-mode id:*, run filtered scan and merge into main scan by key.
  # Other keys are unaffected. If filtered scan is empty, old entries for
  # this key are removed — signalling the task is no longer actionable.
  if [[ "$_tm_mode" == id:* ]]; then
    local _raw_key="${_tm_mode#id:}"
    _raw_key="${_raw_key#raw-}"
    local _tmp_scan="/tmp/freely-id-scan-$$.json"
    python3 "$TASK_SOURCE_SCAN_SCRIPT" --project "$PROJECT_ROOT" --raw-key "$_raw_key" > "$_tmp_scan" 2>/dev/null || true
    if [[ -f "$_tmp_scan" ]]; then
      python3 - "$scan_json_path" "$_tmp_scan" "$_raw_key" <<'PY'
import json, sys
main_path, tmp_path, raw_key = sys.argv[1], sys.argv[2], sys.argv[3]
with open(main_path) as f: main = json.load(f)
with open(tmp_path) as f: tmp = json.load(f)
# Remove old items for this key, add new filtered ones
main["items"] = [it for it in main.get("items",[]) if it.get("key") != raw_key]
main["items"].extend(tmp.get("items", []))
# Update summary
items = main["items"]
main["summary"]["total_incomplete"] = len(items)
by_stage = {}
for it in items:
    s = it.get("stage","?")
    by_stage[s] = by_stage.get(s, 0) + 1
main["summary"]["by_stage"] = by_stage
main["summary"]["ready"] = sum(1 for it in items if it.get("ready"))
with open(main_path, "w") as f: json.dump(main, f, indent=2, sort_keys=True, ensure_ascii=False)
PY
      rm -f "$_tmp_scan"
    fi
  fi

  # Parse lifecycle scan JSON and build prompt section
  python3 - "$scan_json_path" "$scan_reason" "$_tm_mode" "$_tm_info" <<'PY'
import json
import sys

scan_path = sys.argv[1]
scan_reason = sys.argv[2]
task_mode = sys.argv[3] if len(sys.argv) > 3 else "wait"
task_mode_info = sys.argv[4] if len(sys.argv) > 4 else ""

try:
    with open(scan_path, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    print("")
    sys.exit(0)

items = data.get("items", [])
summary = data.get("summary", {})
total = summary.get("total", summary.get("total_incomplete", 0))
by_stage = summary.get("by_station", summary.get("by_stage", {}))
ready = summary.get("ready", 0)

# When task_mode is id:raw-xxx, filter items to only the targeted raw key\'s chain
# and recalc summary so the stage-grouped output below only shows that one item.
if task_mode.startswith("id:"):
    _raw_key = task_mode[3:]
    if _raw_key.startswith("raw-"):
        _raw_key = _raw_key[4:]
    _filtered = [it for it in items if it.get("key") == _raw_key]
    items = _filtered
    total = len(items)
    by_stage = {}
    ready = 0
    for it in items:
        s = it.get("station", it.get("stage", "unknown"))
        by_stage[s] = by_stage.get(s, 0) + 1
        if it.get("ready"):
            ready += 1

if total == 0:
    print("")
    sys.exit(0)

# Build lifecycle-aware patrol seed
print("")
print(f"## Task Mode: {task_mode_info}")
print("")
print("Lifecycle task scan (lifecycle-v2):")
print(f"- scan_reason: `{scan_reason}`")
print(f"- total_incomplete: {total}  items across the raw\u2192I lifecycle chain")
print(f"- ready_for_work: {ready}  items\uff08\u5df2 promote\uff0c\u53ef\u8fdb\u5165 B2 \u6216\u6536\u53e3\uff09")
print(f"- by_stage: " + ", ".join(f"{k}={v}" for k, v in sorted(by_stage.items())))
print(f"- machine_readable_scan_json: `{scan_path}`")
print("")
print("\u539f\u5219\uff1a\u5df2\u5b8c\u6210\u7684\u6761\u76ee\u4e0d\u4f1a\u51fa\u73b0\u5728\u8fd9\u91cc\u3002\u6bcf\u4e2a\u6761\u76ee\u90fd\u6709\u5177\u4f53\u7684 incomplete \u539f\u56e0\u548c next_action\u3002")
print("")

# Group by stage \u2014 dynamically from scan data, sorted by item count (most first)
stage_order = sorted(by_stage.keys(), key=lambda s: -by_stage.get(s, 0))
for stage in stage_order:
    stage_items = [it for it in items if it.get("station", it.get("stage")) == stage]
    if not stage_items:
        continue
    # Show ready items first, limit per stage to keep prompt manageable
    stage_items.sort(key=lambda it: (0 if it.get("ready") else 1, it.get("key", "")))
    label = stage
    shown = len(stage_items)
    if len(stage_items) > 30:
        stage_items = stage_items[:30]
    print(f"## Stage: {label} ({shown} items, showing {len(stage_items)})")
    for it in stage_items:
        incomplete = " ".join(it.get("incomplete", []))
        next_action = it.get("next_action", "\u68c0\u67e5\u5e76\u5b8c\u6210\u6536\u53e3\u6b65\u9aa4")
        title = it.get("title", "") or it.get("key", "")
        children = it.get("children", [])
        child_ids = ", ".join(c.get("id", "?") for c in children) if children else "\u65e0"
        is_ready = "ready" if it.get("ready") else "blocked"
        source_family = it.get("source_family", "")
        if source_family == "chat_inbox":
            print(f"  chat_type={it.get('chat_type', '?')}")
            print(f"  issue_id={it.get('issue_id', '?')}")
            print(f"  worktree_exists={it.get('worktree_exists', '?')}")
            print(f"  message_preview={it.get('message_preview', '')[:100]}")
        scan_state = it.get("scan_state", "?")
        scan_wt = it.get("scan_state_worktree", "")
        print(f"- key={it['key']} stage={stage} ready={is_ready} scan_state={scan_state}")
        print(f"  title={title}")
        if scan_wt:
            print(f"  worktree={scan_wt}")
        # Dead worker detection: worktree exists but no active A2A worker
        if scan_state == "working" and not scan_wt:
            print(f"  ⚠️ 工位存在但 Worker 无响应（查 A2A task 状态，prompt 唤醒或 wt-close）")
        if source_family == "worktree_governance":
            print(f"  branch={it.get('branch', '?')}")
            print(f"  worktree_path={it.get('worktree_path', '?')}")
            print(f"  dirty={it.get('dirty', '?')}")
            print(f"  merged_to_develop={it.get('merged_to_develop', '?')}")
        print(f"  incomplete={incomplete}")
        print(f"  children={child_ids}")
        print(f"  next_action={next_action}")
    print("")

    print("## 行为契约：scan next_action 处理规则")
    print("")
    print("- `next_action` 以 `[manager]` 开头 → Manager **必须自己执行 Terminal 命令**")
    print("  - Manager 唯一能力：wt-create（创建工位，不修改 develop 跟踪文件）")
    print("  - 执行 wt-create 后 → 工位就绪 → delegate_workers 委派 Worker")
    print("- `next_action` 以 `[worker]` 开头 → Manager **必须委派 Worker** 到对应工位")
    print("  - 如果工位已存在（没有 `[manager]` 段）：直接委派")
    print("  - 如果工位刚由 wt-create 创建：委派到新工位")
    print("- **platform_sync_batch 优先级最高** — 出现在 scan 第一条时必须优先处理")
    print("- 只有当**所有 ready 条目都没有可执行的 `[manager]` 或 `[worker]`** 时，才允许 stop_ai")
    print("")
PY
}
manager_supervision_alerts() {
  local project="$1" repo_root wt_path branch desired_state role_hint exit_reason supervisor_state ai_state owner next_action anomaly normalized_project normalized_wt_path
  local worker_prompt_file
  repo_root="$(git -C "$project" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$repo_root" ]] || return 0
  normalized_project="$(normalize_runtime_worktree_path "$project")"
  while IFS='|' read -r wt_path branch; do
    [[ -n "$wt_path" ]] || continue
    normalized_wt_path="$(normalize_runtime_worktree_path "$wt_path")"
    [[ -n "$normalized_wt_path" && "$normalized_wt_path" == "$normalized_project" ]] && continue
    [[ -f "$(config_file "$wt_path")" ]] || continue
    desired_state=""
    role_hint=""
    exit_reason=""
    supervisor_state="down"
    ai_state="down"
    if [[ -f "$(workcell_state_file "$wt_path")" ]]; then
      # shellcheck disable=SC1090
      source "$(workcell_state_file "$wt_path")"
      desired_state="${DESIRED_RUNTIME_STATE:-}"
      role_hint="${LAST_ROLE_HINT:-}"
      exit_reason="${LAST_EXIT_REASON:-}"
    fi
    [[ "$desired_state" == "running" ]] || continue
    owner="runtime-owned"
    next_action="runtime_recovery_requested"
    worker_prompt_file="$(authoritative_worker_prompt_file_for_project "$wt_path" || true)"
    if worker_project_is_absorbed_merged_lane "$project" "$wt_path" "$branch" || \
      worker_project_is_retire_ready_merged_followthrough "$project" "$wt_path" "$branch" "$worker_prompt_file" || \
      worker_prompt_targets_retire_ready_merged_worktree "$project" "$worker_prompt_file"; then
      printf -- '- %s: branch=%s role=%s owner=%s next_action=%s exit_reason=%s path=%s\n' \
        "retire_ready_merged_worktree_retained" \
        "${branch:-unknown}" \
        "${role_hint:-worker}" \
        "manager-owned" \
        "cleanup_followthrough" \
        "${exit_reason:-unknown}" \
        "$wt_path"
      continue
    fi
    if [[ -f "$(run_dir_for_project "$wt_path")/supervisor.pid" ]]; then
      local sp
      sp="$(cat "$(run_dir_for_project "$wt_path")/supervisor.pid" 2>/dev/null || true)"
      if valid_supervisor_pid_for_project "$wt_path" "$sp"; then
        supervisor_state="up"
      fi
    fi
    if [[ -f "$(run_dir_for_project "$wt_path")/ai.pid" ]]; then
      local ap
      ap="$(cat "$(run_dir_for_project "$wt_path")/ai.pid" 2>/dev/null || true)"
      if valid_ai_pid_for_project "$wt_path" "$ap"; then
        ai_state="up"
      fi
    fi
    if [[ "$supervisor_state" == "down" ]]; then
      anomaly="expected_running_worktree_down"
      printf -- '- %s: branch=%s role=%s owner=%s next_action=%s exit_reason=%s path=%s\n' "$anomaly" "${branch:-unknown}" "${role_hint:-worker}" "$owner" "$next_action" "${exit_reason:-unknown}" "$wt_path"
    elif [[ "$ai_state" == "down" ]]; then
      anomaly="expected_running_worktree_degraded"
      printf -- '- %s: branch=%s role=%s owner=%s next_action=%s exit_reason=%s path=%s\n' "$anomaly" "${branch:-unknown}" "${role_hint:-worker}" "$owner" "$next_action" "${exit_reason:-unknown}" "$wt_path"
    fi
  done < <(git -C "$repo_root" worktree list --porcelain | awk '
    /^worktree / { wt=substr($0, 10); br="" }
    /^branch / { br=$2; sub(/^refs\/heads\//, "", br); print wt "|" br }
  ')
}

manager_unresolved_expected_running_worker_count() {
  local project="$1" alerts
  alerts="$(manager_supervision_alerts "$project")"
  [[ -n "$alerts" ]] || {
