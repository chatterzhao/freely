append_lifecycle_trace_record() {
  local project="$1" checkpoint="$2" stage="$3" phase="$4"
  shift 4
  local log_file seq_file lock_file kv key value sanitized_value
  local loop_name loop_code trace_id trace_display_id from_checkpoint="" to_checkpoint="" expected_next="" expected_from_previous=""
  local qualified_expected_from_previous="" display_from="" display_to="" transition_match="" outgoing_ok=""
  local -a record_pairs=() extra_pairs=()
  log_file="$(lifecycle_trace_log_file "$project")"
  seq_file="$(lifecycle_trace_seq_file "$project")"
  lock_file="$(lifecycle_trace_lock_file "$project")"
  mkdir -p "$(dirname "$log_file")"
  mkdir -p "$(dirname "$seq_file")"
  : >"$lock_file"
  loop_name="$(lifecycle_loop_name_for_checkpoint "$checkpoint")"
  loop_code="$(lifecycle_loop_code_for_name "$loop_name")"
  trace_id="$(qualify_lifecycle_checkpoint "$checkpoint" "$loop_code")"
  trace_display_id="$(lifecycle_trace_display_id "$checkpoint")"
  for kv in "$@"; do
    key="${kv%%=*}"
    value="${kv#*=}"
    case "$key" in
      from_checkpoint) from_checkpoint="$value" ;;
      to_checkpoint) to_checkpoint="$value" ;;
      expected_next) expected_next="$value" ;;
      expected_from_previous) expected_from_previous="$value" ;;
      *)
        sanitized_value="$(sanitize_lifecycle_trace_kv "$project" "$key" "$value")"
        extra_pairs+=("$key=$sanitized_value")
        ;;
    esac
  done
  case "$phase" in
    IN)
      display_from="ENTRY"
      if [[ -n "$from_checkpoint" ]]; then
        display_from="$(lifecycle_trace_display_id "$from_checkpoint")"
        if [[ -n "$expected_from_previous" ]]; then
          qualified_expected_from_previous="$(qualify_lifecycle_expected_next_list "$expected_from_previous" "$loop_code")"
        fi
        if [[ -n "$qualified_expected_from_previous" ]]; then
          if lifecycle_expected_next_contains_checkpoint "$qualified_expected_from_previous" "$trace_id"; then
            transition_match="1"
          else
            transition_match="0"
          fi
        fi
      fi
      record_pairs=("ph=IN" "me=$trace_display_id" "fr=$display_from")
      [[ -n "$transition_match" ]] && record_pairs+=("ok=$transition_match")
      ;;
    OUT)
      if [[ -n "$to_checkpoint" ]]; then
        display_to="$(display_lifecycle_expected_next_list "$to_checkpoint")"
        outgoing_ok="1"
      elif [[ -n "$expected_next" ]]; then
        display_to="$(display_lifecycle_expected_next_list "$expected_next")"
        outgoing_ok="1"
      else
        display_to="UNSET"
        outgoing_ok="0"
      fi
      record_pairs=("ph=OUT" "me=$trace_display_id" "to=$display_to" "ok=$outgoing_ok")
      ;;
    *)
      log_error "unknown lifecycle trace phase: $phase"
      return 1
      ;;
  esac
  record_pairs+=("checkpoint=$checkpoint" "stage=$stage")
  record_pairs+=("${extra_pairs[@]}")
  python3 - "$log_file" "$seq_file" "$lock_file" "${record_pairs[@]}" <<'PY'
from datetime import datetime, timezone
import fcntl
import pathlib
import shlex
import sys

log_path = pathlib.Path(sys.argv[1])
seq_path = pathlib.Path(sys.argv[2])
lock_path = pathlib.Path(sys.argv[3])
kv_pairs = sys.argv[4:]

with lock_path.open("r+") as lock_handle:
    fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
    try:
        current = seq_path.read_text().strip() if seq_path.exists() else "0"
        if not current.isdigit():
            current = "0"
        seq = int(current) + 1
        timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        with log_path.open("a", encoding="utf-8") as handle:
            parts = [timestamp, f"seq={seq}"]
            for pair in kv_pairs:
                key, _, value = pair.partition("=")
                parts.append(f"{key}={shlex.quote(value)}")
            handle.write(" ".join(parts) + "\n")
        seq_path.write_text(f"{seq}\n")
    finally:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)
PY
}

