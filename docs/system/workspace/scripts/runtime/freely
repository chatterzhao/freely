  local source_hooks target_hooks hook_file
  source_hooks="$source_project/.githooks"
  target_hooks="$target_project/.githooks"
  [[ -d "$source_hooks" ]] || return 0

  rm -rf "$target_hooks"
  cp -R "$source_hooks" "$target_hooks"
  while IFS= read -r hook_file; do
    chmod +x "$hook_file"
  done < <(find "$target_hooks" -type f | sort)
}

sync_project_tooling_from_source() {
  local source_project="$1" target_project="$2"
  local source_cfg target_cfg
  source_cfg="$(config_file "$source_project")"
  target_cfg="$(config_file "$target_project")"

  [[ -d "$source_project" ]] || {
    log_error "source project not found: $source_project"
    return 1
  }
  [[ -d "$target_project" ]] || {
    log_error "target project not found: $target_project"
    return 1
  }
  [[ -f "$source_cfg" ]] || {
    log_warn "skip tooling sync: source config missing at $(config_file "$source_project")"
    return 0
  }
  if [[ "$target_project" != "$source_project" ]] && project_path_is_under_worktrees_root "$source_project" "$target_project"; then
    if ! project_has_authoritative_worktree_path "$source_project" "$target_project"; then
      log_warn "skip tooling sync: target worktree is outside authoritative git worktree inventory: $target_project"
      return 0
    fi
  fi

	  mkdir -p "$(dirname "$target_cfg")"
	  cp "$source_cfg" "$target_cfg"
	  rewrite_synced_project_config_for_target "$source_project" "$target_project"
	  # ── Agent-table: write agent-id.env only (NOT config) ──
	  # AGENT_AI_TOOL resolved by load_config from agent-table at startup.
	  # No config writes needed — agent-table IS the single source of truth.
	  _agent_table="$source_project/.freely/agent-table.toml"
	  _agent_query="$source_project/bin/agent-table-query"
	  if [[ -f "$_agent_table" && -x "$_agent_query" ]]; then
	    # ── Concurrency control: reconcile zombies, count active, pick idle worker ──
	    _agent_env="$source_project/.freely/agent-id.env"
	    manager_reconcile_agent_id_env "$_agent_env" 2>/dev/null || true
	    local _active_count _max_workers _all_workers _picked _wt_path
	    _active_count=$(count_active_running_workers_for_manager_project "$source_project" 2>/dev/null || echo 0)
	    _max_workers="$(manager_max_parallel_workers)"
	    _max_workers="${_max_workers%%:*}"
	    [[ "$_max_workers" =~ ^[0-9]+$ ]] || _max_workers="10"
	    if (( _active_count >= _max_workers )); then
	      log_warn "agent-table: concurrency limit reached ($_active_count/$_max_workers), deferring worker assignment"
	      return 0
	    fi
	    # Pick first idle worker — use agent_working table (authoritative source).
	    # Falls back to legacy agent-id.env grep if DB RPC fails.
	    _next_worker=$(python3 -c "
import sys; sys.path.insert(0, '${PROJECT_ROOT}/docs/system/workspace/scripts/runtime')
from agent_working import agent_next_free
print(agent_next_free('${PROJECT_ROOT}', 'worker', 10) or '')
" 2>/dev/null || true)
	    # Fallback: legacy agent-id.env grep
	    if [[ -z "$_next_worker" ]]; then
	      _all_workers=$("$_agent_query" --project "$source_project" --list worker 2>/dev/null || true)
	      for _w in $_all_workers; do
	        [[ -n "$_w" ]] || continue
	        if ! grep -q "=$_w\$" "$_agent_env" 2>/dev/null; then
	          _next_worker="$_w"; break
	        fi
	      done
	      [[ -z "$_next_worker" ]] && _next_worker="${_all_workers%% *}"
	    fi
	    if [[ -n "$_next_worker" ]]; then
	      # Auto-wake: ensure target bridge is alive before delegation.
	      local _worker_slot _worker_bt
	      _worker_slot=$("$_agent_query" --get-slot "$_next_worker" 2>/dev/null || true)
	      _worker_bt="${_worker_slot%%-*}"
	      if [[ -n "$_worker_bt" ]]; then
	        _ensure_acp_bridge_running "$source_project" "$_worker_bt" || {
	          log_warn "agent-table: failed to start worker bridge for $_worker_bt, deferring assignment"
	          return 1
	        }
	      fi
	      mkdir -p "$(dirname "$_agent_env")"
	      echo "$target_project=worker=$_next_worker" >> "$_agent_env"
		      # Phase 1: dual-write to agent_working table
		      python3 -c "import sys; sys.path.insert(0, '${PROJECT_ROOT}/docs/system/workspace/scripts/runtime'); from agent_working import agent_assign; agent_assign('${PROJECT_ROOT}', 'develop', 'worker', '$_next_worker', worktree='${target_project}')" 2>/dev/null || true
	      log_info "agent-table: assigned $_next_worker to $target_project (agent-id.env + agent_working)"
	    fi
	  fi
	  sync_repo_hook_assets_from_source "$source_project" "$target_project"
	  load_config "$target_project"
	  materialize_project_tooling_for_loaded_config "$target_project" "true"
	  log_info "synced project-local tooling: $source_project -> $target_project"
}

write_project_codex_config() {
  local project="$1" force="${2:-false}" mode="${3:-step}"
  local cfg root approval_policy
  cfg="$(project_codex_config_file "$project")"
  root="$(project_worktrees_root_for_path "$project")"
  approval_policy="on-request"
  [[ "$mode" == "auto" ]] && approval_policy="never"
  mkdir -p "$(dirname "$cfg")"

  if [[ -f "$cfg" && "$force" != "true" ]]; then
    log_info "skip: $cfg already exists"
    log_info "manual: edit $cfg or rerun freely init --force to rewrite Freely-managed codex defaults"
    return 0
  fi

  local template
  template="$(cat <<'EOF'
# Freely 项目级 Codex 配置
# Reference: https://developers.openai.com/codex/config-reference/
#
# 实际完整配置在 slot 目录: __FREELY_SLOT_DIR__/config.toml
# 本文件仅放项目级覆盖字段，方便用户快速修改。
# 其余字段（openai_base_url / auth / provider）在 slot 配置中。
# 修改后生效于下次 codex session，无需重启 freely。

# ── 默认模型 ── (方便快速修改，会覆盖 slot 的 model)
model = "gpt-5.5"

# ── 批准策略 ──────────────────────────────────────────
# "never"        — 自动批准所有操作（Freely auto 模式默认）
# "on-failure"   — 仅命令失败时请求批准
# "on-request"   — 命令请求批准时询问（step 模式默认）
# "always"       — 始终需要手动批准
approval_policy = "__FREELY_APPROVAL_POLICY__"

# ── 沙箱模式 ──────────────────────────────────────────
# "read-only"         — 只读，禁止修改文件系统
# "workspace-write"   — 项目目录可写（推荐）
# "danger-full-access" — 完全访问，无限制
sandbox_mode = "workspace-write"

# ── 沙箱网络 ──────────────────────────────────────────
# true = 允许命令访问网络, false = 禁止
# 注意: 此字段在 [sandbox_workspace_write] 段下，
# 自由模式或 danger 模式需另设全局 network_access。
[sandbox_workspace_write]
network_access = false

# ── 额外可写路径 ──────────────────────────────────────
# 项目 worktrees 目录在项目根外，需显式放行
writable_roots = ["__FREELY_WORKTREES_ROOT__"]

# ── 上下文管理 ────────────────────────────────────────
# 控制 session 上下文预算，超限触发 compaction
model_context_window = 200000
model_auto_compact_token_limit = 150000
project_doc_max_bytes = 32768
EOF
)"
  template="${template/__FREELY_APPROVAL_POLICY__/$approval_policy}"
  template="${template/__FREELY_WORKTREES_ROOT__/$root}"
  local slot_dir="$HOME/.ai-auth/${AGENT_AI_TOOL:-codex}"
  template="${template/__FREELY_SLOT_DIR__/$slot_dir}"
  printf '%s\n' "$template" >"$cfg"

  log_info "manual: trust this project in ~/.codex/config.toml if Codex has not yet marked it trusted"
}

