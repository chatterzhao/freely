  unset DESIRED_RUNTIME_STATE LAST_SUPERVISOR_STATE LAST_EXIT_REASON
  # shellcheck disable=SC1090
  source "$(workcell_state_file "$project")"
  [[ "${DESIRED_RUNTIME_STATE:-unknown}" == "running" ]] || return 1
  [[ "${LAST_SUPERVISOR_STATE:-unknown}" == "up" ]] || return 1
  [[ "${LAST_EXIT_REASON:-}" == "starting" || "${LAST_EXIT_REASON:-}" == "up" || "${LAST_EXIT_REASON:-}" == "already_running_attach" ]]
}

