prepare_manager_same_tool_slot_recovery_if_needed() {
  local project="$1"
  local desired_state current_tool last_exit_reason supervisor_pid ai_pid
  TOOL_AUTO_RECOVERY_SAME_TOOL_EXHAUSTED="0"
  TOOL_AUTO_RECOVERY_ENTRY_BLOCKED="0"
  TOOL_AUTO_RECOVERY_SLOT=""
  desired_state="unknown"
  last_exit_reason=""
  if [[ -f "$(workcell_state_file "$project")" ]]; then
    unset DESIRED_RUNTIME_STATE LAST_EXIT_REASON
    # shellcheck disable=SC1090
    source "$(workcell_state_file "$project")"
    desired_state="${DESIRED_RUNTIME_STATE:-unknown}"
    last_exit_reason="${LAST_EXIT_REASON:-}"
  fi
  [[ "$desired_state" == "running" ]] || return 1
  config_bool_enabled "${AUTO_SWITCH_SLOT:-false}" || return 1
  current_tool="${AI_TOOL:-}"
  [[ -n "$current_tool" ]] || return 1
  tool_supports_auto_same_tool_slot_recovery "$current_tool" || return 1
  supervisor_pid="$(manager_supervisor_pid_for_project "$project")"
  ai_pid="$(manager_ai_pid_for_project "$project")"
  [[ -z "$supervisor_pid" && -z "$ai_pid" ]] || return 1

  if [[ -n "$last_exit_reason" ]]; then
    tool_failure_allows_same_tool_slot_recovery "$current_tool" "$last_exit_reason" || return 1
    if tool_select_ready_slot_for_manager_auto_recovery "$project" "$current_tool" "after_failure"; then
      record_tool_auto_switch_event "$project" "$current_tool" "$current_tool" "${TOOL_AUTO_RECOVERY_SLOT:-}" "same_tool_slot_recovery"
      return 0
    fi
    TOOL_AUTO_RECOVERY_SAME_TOOL_EXHAUSTED="1"
    return 1
  fi

  if tool_select_ready_slot_for_manager_auto_recovery "$project" "$current_tool" "entry"; then
    return 0
  fi
  TOOL_AUTO_RECOVERY_ENTRY_BLOCKED="1"
  return 1
}

prepare_manager_cross_tool_fallback_if_needed() {
  local project="$1" same_tool_exhausted="${2:-0}"
  local desired_state current_tool fallback_tool last_exit_reason supervisor_pid ai_pid
  local candidate earliest_tool earliest_slot fallback_slot hint_reset hint_info hint_slot
  TOOL_AUTO_RECOVERY_DECISION="none"
  desired_state="unknown"
  last_exit_reason=""
  if [[ -f "$(workcell_state_file "$project")" ]]; then
    unset DESIRED_RUNTIME_STATE LAST_EXIT_REASON
    # shellcheck disable=SC1090
    source "$(workcell_state_file "$project")"
    desired_state="${DESIRED_RUNTIME_STATE:-unknown}"
    last_exit_reason="${LAST_EXIT_REASON:-}"
  fi
  [[ "$desired_state" == "running" ]] || return 1
  config_bool_enabled "${AUTO_SWITCH_TOOL:-false}" || return 1
  current_tool="${AI_TOOL:-}"
  [[ -n "$current_tool" ]] || return 1
  supervisor_pid="$(manager_supervisor_pid_for_project "$project")"
  ai_pid="$(manager_ai_pid_for_project "$project")"
  [[ -z "$supervisor_pid" && -z "$ai_pid" ]] || return 1
  if [[ "$same_tool_exhausted" != "1" && "${TOOL_AUTO_RECOVERY_ENTRY_BLOCKED:-0}" != "1" ]]; then
    tool_failure_allows_cross_tool_auto_recovery "$current_tool" "$last_exit_reason" "$same_tool_exhausted" || return 1
  fi

  earliest_tool=""
  earliest_reset=""
  earliest_slot=""
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    [[ "$candidate" != "$current_tool" ]] || continue
    if tool_ready_for_manager_auto_recovery "$project" "$candidate"; then
      fallback_tool="$candidate"
      fallback_slot="${TOOL_AUTO_RECOVERY_SLOT:-}"
      break
    fi
    if hint_info="$(tool_earliest_recovery_hint_for_project "$project" "$candidate" 2>/dev/null || true)" && [[ -n "$hint_info" ]]; then
      hint_slot="${hint_info%%|*}"
      hint_reset="${hint_info##*|}"
      if [[ "$hint_reset" =~ ^[0-9]+$ ]] && [[ -z "$earliest_reset" || "$hint_reset" -lt "$earliest_reset" ]]; then
        earliest_tool="$candidate"
        earliest_slot="$hint_slot"
        earliest_reset="$hint_reset"
      fi
    fi
  done < <(runtime_auto_recovery_tool_order "$current_tool")

  if [[ -n "${fallback_tool:-}" ]]; then
    persist_project_tool_selection "$project" "$fallback_tool"
    record_tool_auto_switch_event "$project" "$current_tool" "$fallback_tool" "${fallback_slot:-}" "$last_exit_reason"
    load_config "$project"
    TOOL_AUTO_RECOVERY_DECISION="selected"
    return 0
  fi

  if [[ -n "$earliest_tool" && -n "$earliest_reset" ]]; then
    persist_project_tool_selection "$project" "$earliest_tool"
    [[ -n "$earliest_slot" ]] && runtime_write_tool_current_slot "$earliest_tool" "$earliest_slot"
    record_tool_auto_switch_event "$project" "$current_tool" "$earliest_tool" "${earliest_slot:-}" "all_tools_unavailable" "$earliest_reset" "true" "waiting" "${earliest_slot:-}"
    load_config "$project"
    TOOL_AUTO_RECOVERY_DECISION="waiting"
  fi
  return 1
}

