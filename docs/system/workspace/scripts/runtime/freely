tool_select_ready_slot_for_manager_auto_recovery() {
  local project="$1" tool="$2" mode="${3:-entry}" selected_slot=""
  TOOL_AUTO_RECOVERY_SLOT=""
  case "$tool" in
    codex)
      if [[ "$mode" == "after_failure" ]]; then
        switch_to_next_codex_slot "$project" "after_failure_exec_recovery_next_slot" || return 1
      else
        ensure_codex_slot_ready_for_manager "$project" "$mode" || return 1
      fi
      selected_slot="$(runtime_read_tool_current_slot "$project" "$tool")"
      ;;
    *)
      # ── Same-tool slot recovery with live testing ──────────
      # Scan ~/.ai-auth/{tool}-* slots, test each with ai_cli_tool_with_auth_assemble.
      # Skip current (failed) slot.  First working slot wins.
      # On success: update agent-table.toml {role}_slot.
      local _auth_dir _current_slot _candidate _found=""
      _auth_dir="$HOME/.ai-auth"
      _current_slot="$(runtime_read_tool_current_slot "$project" "$tool" 2>/dev/null || true)"
      if [[ -d "$_auth_dir" ]]; then
        while IFS= read -r _candidate; do
          [[ -n "$_candidate" ]] || continue
          [[ "$_candidate" == "$_current_slot" && "$mode" == "after_failure" ]] && continue
          if _test_slot "$_candidate"; then
            _found="$_candidate"
            break
          fi
        done < <(ls -1 "$_auth_dir" 2>/dev/null | grep "^${tool}-")
      fi
      [[ -n "$_found" ]] || return 1
      selected_slot="$_found"
      tool_binary_available_for_auto_recovery "$tool" || return 1
      runtime_write_tool_current_slot "$tool" "$selected_slot"
      # Update agent-table for current agent's role
      local _agent_id; _agent_id=$(_resolve_current_agent_id "$project" || true)
      [[ -n "$_agent_id" ]] && _update_agent_table_slot "$_agent_id" "$selected_slot" || true
      ;;
  esac
  TOOL_AUTO_RECOVERY_SLOT="$selected_slot"
  return 0
}

tool_ready_for_manager_auto_recovery() {
  local project="$1" tool="$2"
  tool_cached_availability_blocks_auto_recovery "$project" "$tool" && return 1
  tool_select_ready_slot_for_manager_auto_recovery "$project" "$tool" "entry"
