collect_global_restart_snapshot_rows() {
  local repo_root="$1" wt_path declared_project_root branch workcell_state launch_state manager_continuity worker_continuity
  local resolution_file prompt_file intake_count desired_state last_exit_reason operator_anchor_count
  local restore_candidate restore_ready restore_blocker
  while IFS= read -r wt_path; do
    [[ -n "$wt_path" ]] || continue
    [[ -f "$(config_file "$wt_path")" ]] || continue
    declared_project_root="$wt_path"
    unset PROJECT_ROOT
    # shellcheck disable=SC1090
    source "$(config_file "$wt_path")"
    declared_project_root="${PROJECT_ROOT:-$wt_path}"
    branch="$(git -C "$wt_path" branch --show-current 2>/dev/null || true)"
    workcell_state="$(workcell_state_file "$wt_path")"
    launch_state="$(manager_worker_launch_state_file "$wt_path")"
    manager_continuity="$(latest_generated_manager_continuity_file_for_project "$wt_path")"
    worker_continuity="$(latest_worker_continuity_file_for_project "$wt_path")"
    resolution_file="$(latest_interruption_resolution_file_for_project "$wt_path")"
    prompt_file="$(find_latest_prompt_file_for_project "$wt_path")"
    intake_count="$(count_active_intake_items "$wt_path")"
    desired_state="unknown"
    last_exit_reason="unavailable"
    if [[ -f "$workcell_state" ]]; then
      unset DESIRED_RUNTIME_STATE LAST_EXIT_REASON
      # shellcheck disable=SC1090
      source "$workcell_state"
      desired_state="${DESIRED_RUNTIME_STATE:-unknown}"
      last_exit_reason="${LAST_EXIT_REASON:-unavailable}"
    fi
    operator_anchor_count="$(count_restore_operator_anchors_for_project "$wt_path")"
    restore_candidate="0"
    restore_ready="0"
    restore_blocker=""
    if [[ -f "$workcell_state" && "$desired_state" == "running" ]]; then
      restore_candidate="1"
      if (( operator_anchor_count > 0 )); then
        restore_ready="1"
      else
        restore_blocker="missing_operator_anchor"
      fi
    elif [[ ! -f "$workcell_state" ]]; then
      restore_blocker="missing_workcell_state"
    elif [[ "$desired_state" != "running" ]]; then
      restore_blocker="operator_stopped_or_not_desired_running"
    fi

    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$declared_project_root" \
      "$branch" \
      "$desired_state" \
      "$last_exit_reason" \
      "$workcell_state" \
      "$launch_state" \
      "$manager_continuity" \
      "$worker_continuity" \
      "$resolution_file" \
      "$prompt_file" \
      "$intake_count" \
      "$restore_candidate" \
      "$restore_ready" \
      "$restore_blocker"
  done < <(global_restart_project_paths "$repo_root")
}

write_global_restart_manifest() {
  local repo_root="$1" manifest_timestamp="$2" history_file="$3" latest_file="$4" rows_file="$5"
  local history_dir latest_dir retention_count
  history_dir="$(dirname "$history_file")"
  latest_dir="$(dirname "$latest_file")"
  mkdir -p "$history_dir" "$latest_dir"
  retention_count="$(global_restart_history_retention)"
  python3 - "$repo_root" "$manifest_timestamp" "$history_file" "$latest_file" "$retention_count" "$rows_file" <<'PY'
import json
import os
import sys

repo_root, manifest_timestamp, history_file, latest_file, retention_count, rows_file = sys.argv[1:]
projects = []
previously_running = []
operator_stopped_projects = []
blocked_restore = []

with open(rows_file, "r", encoding="utf-8") as rows:
    for raw in rows:
        raw = raw.rstrip("\n")
        if not raw:
            continue
        fields = raw.split("\t")
        while len(fields) < 14:
            fields.append("")
        (
            project_root,
            branch,
            desired_state,
            last_exit_reason,
            workcell_state,
            launch_state,
            manager_continuity,
            worker_continuity,
            resolution_file,
            prompt_file,
            intake_count,
            restore_candidate,
            restore_ready,
            restore_blocker,
        ) = fields[:14]

        intake_dir = os.path.join(project_root, ".freely", "intake")
        continuity_artifacts = [path for path in (manager_continuity, worker_continuity) if path]
        has_intake_dir = os.path.isdir(intake_dir) and bool(os.listdir(intake_dir))
        mandatory_restore_anchors = [
            path
            for path in (
                workcell_state,
                launch_state,
                *continuity_artifacts,
                resolution_file,
                prompt_file,
                intake_dir if has_intake_dir else "",
            )
            if path
        ]
        auxiliary_evidence = [
            path
            for path in (
                os.path.join(project_root, ".freely", "run", "session-state.env"),
                os.path.join(project_root, ".freely", "run", "session-handoff.txt"),
                os.path.join(project_root, ".freely", "run", "ai.pid"),
                os.path.join(project_root, ".freely", "run", "supervisor.pid"),
                os.path.join(project_root, ".freely", "run", "stop.requested"),
                os.path.join(project_root, ".freely", "run", "restart-storm-window.tsv"),
                os.path.join(project_root, ".freely", "run", "codex-slot-cooldowns.tsv"),
            )
            if os.path.exists(path)
        ]
        restore_candidate_bool = restore_candidate == "1"
        restore_selected = restore_ready == "1"
        operator_stopped = last_exit_reason == "operator_stop" or desired_state != "running"
        continuity_anchor = next(
            (
                path
                for path in (
                    manager_continuity,
                    worker_continuity,
                    resolution_file,
                    prompt_file,
                    launch_state,
                    workcell_state,
                )
                if path
            ),
            "",
        )

        entry = {
            "project_root": project_root,
            "project_path": project_root,
            "branch": branch,
            "desired_runtime_state": desired_state,
            "last_exit_reason": last_exit_reason,
            "restore_candidate": restore_candidate_bool,
            "restore_ready": restore_selected,
            "restore_selected": restore_selected,
            "restore_blocker": restore_blocker or None,
            "operator_stopped": operator_stopped,
            "continuity_anchor": continuity_anchor,
            "mandatory_restore_anchors": mandatory_restore_anchors,
            "auxiliary_evidence": auxiliary_evidence,
            "mandatory_restore_anchor_details": {
                "workcell_state": workcell_state or None,
                "launch_state": launch_state or None,
                "continuity_artifacts": continuity_artifacts,
                "interruption_resolution": resolution_file or None,
                "delegated_prompt_evidence": prompt_file or None,
                "active_intake_dir": intake_dir if has_intake_dir else None,
            },
        }
        projects.append(entry)
        if restore_candidate_bool:
            if restore_selected:
                previously_running.append(project_root)
            else:
                blocked_restore.append({"project_root": project_root, "reason": entry["restore_blocker"]})
        if operator_stopped:
            operator_stopped_projects.append(project_root)

payload = {
    "manifest_version": "global-restart-v1",
    "action": "global_restart",
    "operator_scope": "all-projects",
    "repo_root": repo_root,
    "generated_at": manifest_timestamp,
    "durable_home": {
        "latest": latest_file,
        "history": history_file,
        "retention": f"keep_last_{retention_count}",
    },
    "restore_policy": {
        "surface": "explicit_global_restart",
        "previously_running_projects": previously_running,
        "operator_stopped_exclusion": operator_stopped_projects,
        "blocked_restore_candidates": blocked_restore,
    },
    "projects": projects,
}

encoded = json.dumps(payload, indent=2, sort_keys=True)
with open(history_file, "w", encoding="utf-8") as f:
    f.write(encoded)
    f.write("\n")
with open(latest_file, "w", encoding="utf-8") as f:
    f.write(encoded)
    f.write("\n")
PY
}

