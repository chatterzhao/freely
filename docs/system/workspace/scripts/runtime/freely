require_default_autonomy_activation_consent() {
  local project="$1" accept_flag="${2:-false}"
  local phrase="I UNDERSTAND FREELY DEFAULT AUTONOMY"
  local first second recorded_at

  if [[ "${AI_MODE:-}" != "auto" ]]; then
    FREELY_INIT_CONSENT_STATUS="not-required"
    FREELY_INIT_CONSENT_RECORDED_AT="unavailable"
    FREELY_INIT_CONSENT_RECORDED_VIA="not-required"
    return 0
  fi

  echo "Freely activation consent required:"
  print_autonomy_posture_summary "$project"
  echo "note: safeguards are strongly recommended and supported, but not default activation blockers"

  recorded_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [[ "$accept_flag" == "true" ]]; then
    FREELY_INIT_CONSENT_STATUS="accepted"
    FREELY_INIT_CONSENT_RECORDED_AT="$recorded_at"
    FREELY_INIT_CONSENT_RECORDED_VIA="flag"
    return 0
  fi

  if [[ ! -t 0 || ! -t 1 ]]; then
    log_error "default autonomy activation consent required for mode=auto"
    log_error "rerun freely init with --accept-default-autonomy if you understand and accept the posture above"
    exit 1
  fi

  printf 'Type exactly to continue: %s\n> ' "$phrase"
  IFS= read -r first || true
  [[ "$first" == "$phrase" ]] || {
    log_error "activation consent mismatch"
    exit 1
  }
  printf 'Type the same phrase again to confirm: %s\n> ' "$phrase"
  IFS= read -r second || true
  [[ "$second" == "$phrase" ]] || {
    log_error "activation consent confirmation mismatch"
    exit 1
  }

  FREELY_INIT_CONSENT_STATUS="accepted"
  FREELY_INIT_CONSENT_RECORDED_AT="$recorded_at"
  FREELY_INIT_CONSENT_RECORDED_VIA="tty-repeat"
}

