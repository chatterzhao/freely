discover_supervisor_pid() {
  local project="$1"
  ps -axo pid=,command= | awk -v p="$project" '
    index($0, "runtime/freely start") {
      for (i = 1; i <= NF; i++) {
        if ($i == "--project" && (i + 1) <= NF && $(i + 1) == p) {
          print $1
          exit
        }
        if (index($i, "--project=") == 1 && substr($i, 11) == p) {
          print $1
          exit
        }
      }
    }
  '
}

pid_matches_project() {
  local pid="$1" project="$2" expected="$3"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  ps -p "$pid" -o command= 2>/dev/null | awk -v p="$project" -v e="$expected" '
    index($0, e) {
      for (i = 1; i <= NF; i++) {
        if (($i == "--project" || $i == "-C") && (i + 1) <= NF && $(i + 1) == p) {
          found=1
        }
        if (index($i, "--project=") == 1 && substr($i, 11) == p) {
          found=1
        }
      }
    }
    END { exit found ? 0 : 1 }
  '
}

valid_supervisor_pid_for_project() {
  local project="$1" pid="$2"
  pid_matches_project "$pid" "$project" "runtime/freely start --project"
}

valid_ensure_manager_watchdog_pid_for_project() {
