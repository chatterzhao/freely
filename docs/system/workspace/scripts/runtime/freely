    if [[ ! "$item_epoch" =~ ^[0-9]+$ || "$item_epoch" -le 0 ]]; then
      item_epoch="$(file_mtime_epoch "$meta_file" 2>/dev/null || true)"
    fi
    [[ "$item_epoch" =~ ^[0-9]+$ ]] || item_epoch="0"
    if (( continuity_floor_epoch > 0 && item_epoch > 0 && item_epoch <= continuity_floor_epoch )); then
      continue
    fi
    delegated_real=""
    if [[ -n "$delegated_worktree" ]]; then
