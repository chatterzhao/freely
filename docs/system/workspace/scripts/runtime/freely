}

append_runtime_event() {
  local project="$1" event="$2"
  shift 2
  local log_file timestamp kv key value
  log_file="$(runtime_events_log_file "$project")"
  mkdir -p "$(dirname "$log_file")"
  timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  {
    printf '%s event=%s' "$timestamp" "$event"
    for kv in "$@"; do
      key="${kv%%=*}"
      value="${kv#*=}"
      printf ' %s=%q' "$key" "$value"
    done
    printf '\n'
  } >>"$log_file"
}

