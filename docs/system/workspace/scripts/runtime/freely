intake_snapshot_for_project() {
  local project="$1" limit="${2:-8}"
  local intake_root item_dir meta_file message_file status intake_id created_at channel author classification linked_artifact first_line count reaction claimed_by absorption_target
  intake_root="$(intake_dir_for_project "$project")"
  [[ -d "$intake_root" ]] || return 0
  count=0
  while IFS= read -r item_dir; do
    meta_file="$item_dir/meta.env"
    message_file="$item_dir/message.txt"
    [[ -f "$meta_file" ]] || continue
    status="$(awk -F '"' '/^STATUS=/{print $2; exit}' "$meta_file")"
    case "$status" in
      absorbed|dropped) continue ;;
    esac
    intake_id="$(awk -F '"' '/^INTAKE_ID=/{print $2; exit}' "$meta_file")"
    created_at="$(awk -F '"' '/^CREATED_AT=/{print $2; exit}' "$meta_file")"
    channel="$(awk -F '"' '/^CHANNEL=/{print $2; exit}' "$meta_file")"
    author="$(awk -F '"' '/^AUTHOR=/{print $2; exit}' "$meta_file")"
    classification="$(awk -F '"' '/^CLASSIFICATION=/{print $2; exit}' "$meta_file")"
    reaction="$(awk -F '"' '/^REACTION=/{print $2; exit}' "$meta_file")"
    claimed_by="$(awk -F '"' '/^CLAIMED_BY=/{print $2; exit}' "$meta_file")"
    linked_artifact="$(awk -F '"' '/^LINKED_ARTIFACT=/{print $2; exit}' "$meta_file")"
    absorption_target="$(awk -F '"' '/^ABSORPTION_TARGET=/{print $2; exit}' "$meta_file")"
    first_line="$(sed -n '1p' "$message_file" 2>/dev/null || true)"
    printf -- '- id=%s status=%s classification=%s reaction=%s claimed_by=%s author=%s channel=%s created_at=%s linked_artifact=%s absorption_target=%s message=%s\n' \
