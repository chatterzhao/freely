validate_manager_exit_contract_for_project() {
  local project="$1" kind="" missing_csv=""
  local stop_reason restart_point next_action why_not_stop why_not_delegate
  local _a2a_task_py _db_path
  _a2a_task_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/a2a_task.py"
  _db_path=""$project/.freely/freely.db""
  if [[ -f "$_a2a_task_py" && -f "$_db_path" ]]; then
    # A2A-native: query submitted worker tasks instead of CSV
    local pending_workers
    pending_workers=$(python3 "$_a2a_task_py" list --role worker --status submitted 2>/dev/null | python3 -c "
import json,sys
try:
    data=json.load(sys.stdin)
    print(len(data.get('rows',[])))
except: print('0')
" 2>/dev/null || echo "0")
    if [[ "${pending_workers:-0}" -gt 0 ]]; then
      kind="delegate_workers"
    fi
    if [[ -z "$kind" ]]; then
      kind="$(_db_exit_contract_field "$project" manager exit_kind)"
    fi
  fi
  if [[ -z "$kind" ]]; then
    printf 'missing_file\n'
    return 1
  fi
  case "$kind" in
    stop_ai|resume_manager|delegate_workers) ;;
    *)
      printf 'invalid_exit_kind\n'
      return 1
      ;;
  esac
  # Reset auto-mode stop_ai override counter when manager does productive work
  if [[ "$kind" != "stop_ai" ]]; then
    rm -f "$project/.freely/run/auto-stop-ai-override-count" 2>/dev/null || true
  fi

  stop_reason="$(_db_exit_contract_field "$project" manager reason)"
  restart_point="$(_db_exit_contract_field "$project" manager restart_point)"
  next_action="$(_db_exit_contract_field "$project" manager next_action)"
  why_not_stop=""
  why_not_delegate=""
  case "$kind" in
    stop_ai)
      [[ -n "$stop_reason" ]] || missing_csv="$(csv_append_unique_item "$missing_csv" "STOP_REASON")"
      [[ -z "$restart_point$next_action" ]] || missing_csv="$(csv_append_unique_item "$missing_csv" "exclusive_fields_conflict")"
      ;;
    resume_manager)
      [[ -n "$restart_point" ]] || missing_csv="$(csv_append_unique_item "$missing_csv" "RESTART_POINT")"
      [[ -n "$next_action" ]] || missing_csv="$(csv_append_unique_item "$missing_csv" "NEXT_ACTION")"
      [[ -z "$why_not_stop$why_not_delegate" ]] || missing_csv="$(csv_append_unique_item "$missing_csv" "exclusive_fields_conflict")"
      ;;
    delegate_workers)
      # A2A-native: worker existence validated via tasks/list query above
      [[ -z "$restart_point$next_action$why_not_stop$why_not_delegate" ]] || missing_csv="$(csv_append_unique_item "$missing_csv" "exclusive_fields_conflict")"
      ;;
  esac
  if [[ -n "$missing_csv" ]]; then
    printf '%s\n' "$missing_csv"
    return 1
  fi
  printf '\n'
}

