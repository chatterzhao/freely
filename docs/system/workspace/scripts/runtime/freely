  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    # Only kill if parent is launchd (PID 1, orphaned) or parent is dead
    local ppid
    ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
    if [[ "$ppid" == "1" ]] || ! kill -0 "$ppid" 2>/dev/null; then
      log_warn "killing orphaned monitor-ai-acp.sh pid=$pid (ppid=${ppid:-dead})"
      kill "$pid" 2>/dev/null || true
    fi
  done < <(pgrep -f "monitor-ai-acp.sh.*$project" 2>/dev/null || true)
  # Clean up stale pid files
  pid_file="$run_dir/ai.pid"
  if [[ -f "$pid_file" ]]; then
    local stale_pid
    stale_pid=$(cat "$pid_file" 2>/dev/null || true)
    if [[ -n "$stale_pid" ]] && ! kill -0 "$stale_pid" 2>/dev/null; then
      rm -f "$pid_file"
    fi
  fi
}
# _update_heartbeat: touch the supervisor heartbeat file so the ensure-manager
# watchdog knows the supervisor is alive and working.  Called every ~2s by the
# background heartbeat process and at key points in the main loop.
_update_heartbeat() {
  local project="$1"
  touch "$(run_dir_for_project "$project")/supervisor-heartbeat" 2>/dev/null || true
}




runtime_network_failure_reason_from_log() {
  local project="$1" log_file="$2"
  local state_file now_epoch last_epoch last_count next_retry_epoch reason failure_count window_secs budget base_delay max_delay backoff cooldown
  [[ -f "$log_file" ]] || return 1

  if log_has_proxy_config_invalid "$log_file"; then
    now_epoch="$(date +%s)"
    next_retry_epoch="$((now_epoch + $(proxy_config_invalid_retry_secs)))"
    persist_execution_network_state "$project" "proxy_config_invalid" 1 "$next_retry_epoch" "$now_epoch"
    printf 'proxy_config_invalid\n'
    return 0
  fi

  log_has_execution_network_failure "$log_file" || return 1

  state_file="$(execution_network_state_file "$project")"
  last_epoch=0
  last_count=0
  if [[ -f "$state_file" ]]; then
    unset EXECUTION_NETWORK_REASON EXECUTION_NETWORK_FAILURE_COUNT EXECUTION_NETWORK_NEXT_RETRY_EPOCH EXECUTION_NETWORK_LAST_FAILURE_EPOCH
    # shellcheck disable=SC1090
    source "$state_file"
    last_epoch="${EXECUTION_NETWORK_LAST_FAILURE_EPOCH:-0}"
    last_count="${EXECUTION_NETWORK_FAILURE_COUNT:-0}"
  fi

  now_epoch="$(date +%s)"
  window_secs="$(execution_network_window_secs)"
  if [[ "$last_epoch" =~ ^[0-9]+$ ]] && (( now_epoch - last_epoch <= window_secs )); then
    failure_count=$((last_count + 1))
  else
    failure_count=1
  fi

  budget="$(execution_network_budget)"
  if (( failure_count > budget )); then
    cooldown="$(execution_network_persistent_cooldown_secs)"
    next_retry_epoch="$((now_epoch + cooldown))"
    reason="execution_network_persistent"
  else
    base_delay="$(execution_network_transient_base_delay_secs)"
    max_delay="$(execution_network_transient_max_delay_secs)"
    backoff=$((base_delay << (failure_count - 1)))
    if (( backoff > max_delay )); then
      backoff="$max_delay"
    fi
    next_retry_epoch="$((now_epoch + backoff))"
    reason="execution_network_transient"
  fi

  persist_execution_network_state "$project" "$reason" "$failure_count" "$next_retry_epoch" "$now_epoch"
  printf '%s\n' "$reason"
}

runtime_proxy_mode_summary_for_logs() {
  local project="$1" project_cfg global_cfg mode
  project_cfg="$project/.freely/config.toml"
  global_cfg="${FREELY_HOME:-$HOME/.freely}/config.toml"

  if declare -F freely_network_proxy_project_config_file >/dev/null 2>&1; then
    project_cfg="$(freely_network_proxy_project_config_file "$project")"
  fi
  if declare -F freely_network_proxy_global_config_file >/dev/null 2>&1; then
    global_cfg="$(freely_network_proxy_global_config_file)"
  fi

  if declare -F freely_network_proxy_resolve_config >/dev/null 2>&1; then
    freely_network_proxy_resolve_config "$project"
  fi
  if declare -F freely_network_proxy_mode >/dev/null 2>&1; then
    mode="$(freely_network_proxy_mode)"
  else
    mode="${FREELY_NETWORK_PROXY_MODE:-inherit}"
  fi

  case "$mode" in
    disabled)
      printf 'proxy mode=disabled; Freely clears proxy env before launch (project_cfg=%s global_cfg=%s)\n' "$project_cfg" "$global_cfg"
      ;;
    explicit)
      printf 'proxy mode=explicit; Freely applies FREELY_NETWORK_PROXY_URL/FREELY_ALL_PROXY/FREELY_HTTP_PROXY/FREELY_HTTPS_PROXY/FREELY_NO_PROXY from config (project_cfg=%s global_cfg=%s)\n' "$project_cfg" "$global_cfg"
      ;;
    *)
      printf 'proxy mode=inherit; Freely keeps ambient ALL_PROXY/HTTP_PROXY/HTTPS_PROXY/NO_PROXY from the shell unless project/global config overrides it (project_cfg=%s global_cfg=%s)\n' "$project_cfg" "$global_cfg"
      ;;
  esac
}

runtime_proxy_self_heal_candidate_modes() {
