manager_project_ownership_claim_for_worktree() {
  local project="$1" target_worktree="$2"
  local holder_state holder_branch holder_ref holder_status
  IFS='|' read -r holder_state holder_branch holder_ref holder_status <<<"$(manager_worktree_ownership_claim_snapshot "$project" "$target_worktree")"
  case "$holder_state" in
    active-owner) printf 'runtime-active-owner\n' ;;
    recorded-owner)
      [[ "$holder_status" == "hard_stale" ]] || printf 'runtime-recorded-owner\n'
      ;;
    queued-owner) printf 'manager-queued-owner\n' ;;
    frozen-owner) printf 'manager-frozen-owner\n' ;;
    *) printf '\n' ;;
  esac
}

manager_worktree_ownership_claim_snapshot() {
  local project="$1" target_worktree="$2"
  local continuity_file wt_path prompt_file holder_branch holder_status
  continuity_file="$(latest_generated_manager_continuity_file_for_project "$project")"

  while IFS= read -r wt_path; do
    [[ -n "$wt_path" && -d "$wt_path" ]] || continue
    [[ "$(role_hint_for_project "$wt_path")" == "worker" ]] || continue
    prompt_file="$(latest_prompt_file_for_project "$wt_path")"
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
    worker_prompt_targets_worktree "$wt_path" "$prompt_file" "$target_worktree" || continue
    holder_branch="$(branch_name_for_project "$wt_path")"
    if worker_project_is_actively_running "$wt_path"; then
      printf 'active-owner|%s|%s|active\n' "${holder_branch:-unknown}" "$wt_path"
    else
      holder_status="$(recorded_worker_ownership_status "$wt_path")"
      printf 'recorded-owner|%s|%s|%s\n' "${holder_branch:-unknown}" "$wt_path" "${holder_status:-soft_stale}"
    fi
    return 0
  done < <(all_repo_worktrees_for_project "$project")

  if [[ -n "$continuity_file" && -f "$continuity_file" ]]; then
    while IFS= read -r prompt_file; do
      [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
      worker_prompt_targets_worktree "$project" "$prompt_file" "$target_worktree" || continue
      holder_branch="$(worker_prompt_target_branch "$prompt_file")"
      printf 'queued-owner|%s|%s|queued\n' "${holder_branch:-unknown}" "$prompt_file"
      return 0
    done < <(latest_manager_worker_prompt_paths_from_continuity "$continuity_file")

    while IFS= read -r prompt_file; do
      [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
      worker_prompt_targets_worktree "$project" "$prompt_file" "$target_worktree" || continue
      holder_branch="$(worker_prompt_target_branch "$prompt_file")"
      printf 'frozen-owner|%s|%s|frozen\n' "${holder_branch:-unknown}" "$prompt_file"
      return 0
    done < <(latest_frozen_manager_worker_prompt_paths_from_continuity "$continuity_file")
  fi

  printf 'none|||\n'
}

worker_prompt_intent_summary_csv() {
  local manager_project="$1" prompt_csv="$2"
