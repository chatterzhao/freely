blocked_supervision_reason_from_exit_context() {
  local exit_reason="${1:-}" cycle_log="${2:-}"
  if [[ -n "$cycle_log" && -f "$cycle_log" ]]; then
    if grep -Eqi 'Operation not permitted|Permission denied' "$cycle_log"; then
      printf 'execution_permission_denied\n'
      return 0
    fi
    if grep -Eqi 'slot switch is already in progress|timed out waiting .*slot switch' "$cycle_log"; then
      printf 'slot_switch_busy\n'
      return 0
    fi
    if grep -Eqi 'Resource temporarily unavailable|fork:' "$cycle_log"; then
      printf 'local_process_capacity_exhausted\n'
      return 0
    fi
  fi
  case "$exit_reason" in
    slot_switch_busy|execution_permission_denied|local_process_capacity_exhausted)
      printf '%s\n' "$exit_reason"
      return 0
      ;;
  esac
  return 1
}

