  fi

  while true; do
    _update_heartbeat "$PROJECT_ROOT"
    _rotate_log "$PROJECT_ROOT/.freely/run/a2a-server.log" 2>/dev/null || true
    _rotate_log "$PROJECT_ROOT/.freely/run/db-daemon.log" 2>/dev/null || true
    _rotate_log "$PROJECT_ROOT/.freely/run/watchdog-sse.log" 2>/dev/null || true
    _rotate_log "$PROJECT_ROOT/.freely/logs/lifecycle-trace.log" 2>/dev/null || true
    _rotate_log "$PROJECT_ROOT/.freely/logs/runtime-events.log" 2>/dev/null || true

    # Re-load session state each cycle so resume/fork decisions see latest values
    load_session_state_or_defaults "$project"

    # Ensure all ACP bridges are alive (tool may have been switched by auto-recovery)
    if [[ "${AGENT_AI_TOOL_ADAPTER:-direct}" == "acp" ]]; then
      local _at="${PROJECT_ROOT}/.freely/agent-table.toml"
      local _aq="${PROJECT_ROOT}/bin/agent-table-query"
      local -a _cycle_tools=()
      local _slot _bt
      if [[ -f "$_at" && -x "$_aq" ]]; then
        for role in manager worker reviewer; do
          _slot=$("$_aq" --get-slot "${role}_01" 2>/dev/null || true)
