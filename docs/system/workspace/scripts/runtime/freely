tui_compose_message() {
  local __result_var="$1"
  local prompt="> "
  local line message=""

  while true; do
    if [[ -t 0 ]]; then
      if ! IFS= read -er -p "$prompt" line; then
        if [[ -n "$message" ]]; then
          break
        fi
        return 1
      fi
    else
      if ! IFS= read -r line; then
        if [[ -n "$message" ]]; then
          break
        fi
        return 1
      fi
    fi

    [[ -n "$line" ]] || break
    if [[ -n "$message" ]]; then
      message+=$'\n'
    fi
    message+="$line"
    prompt="| "
  done

  printf -v "$__result_var" '%s' "$message"
  return 0
}

