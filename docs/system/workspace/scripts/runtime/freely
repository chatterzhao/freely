settle_retire_ready_merged_worker_runtime_state() {
  local manager_project="$1" target_project="$2" branch="${3:-}" worker_prompt_file="" supervisor_pid="" ai_pid=""
  [[ -n "$manager_project" && -n "$target_project" && -d "$target_project" ]] || return 1
  worker_prompt_file="$(authoritative_worker_prompt_file_for_project "$target_project" || true)"
  if [[ -n "$worker_prompt_file" && -f "$worker_prompt_file" ]] \
    && [[ "$(worker_prompt_normalized_intent_kind "$worker_prompt_file")" == "cleanup" ]] \
    && worker_prompt_has_verification_metadata "$worker_prompt_file" \
    && worker_prompt_spans_external_cleanup_surfaces "$manager_project" "$worker_prompt_file"; then
    return 1
  fi
  if ! worker_project_is_absorbed_merged_lane "$manager_project" "$target_project" "$branch" \
    && ! worker_project_is_retire_ready_merged_followthrough "$manager_project" "$target_project" "$branch" "$worker_prompt_file" \
    && ! worker_prompt_targets_retire_ready_merged_worktree "$manager_project" "$worker_prompt_file"; then
    return 1
  fi
  supervisor_pid="$(manager_supervisor_pid_for_project "$target_project")"
  ai_pid="$(runtime_ai_pid_hint_for_project "$target_project")"
  if [[ -n "$supervisor_pid" || -n "$ai_pid" ]]; then
    : >"$(stop_marker_file "$target_project")"
    [[ -n "$ai_pid" ]] && kill -TERM "$ai_pid" 2>/dev/null || true
    [[ -n "$supervisor_pid" ]] && kill -TERM "$supervisor_pid" 2>/dev/null || true
  fi
  rm -f \
    "$(run_dir_for_project "$target_project")/supervisor.pid" \
    "$(run_dir_for_project "$target_project")/ai.pid" \
    "$(interruption_dispatcher_pid_file "$target_project")" \
    "$(ensure_manager_watchdog_pid_file "$target_project")" \
    "$(session_state_file "$target_project")" \
    "$(exit_contract_file "$target_project")"
  write_workcell_state "$target_project" "stopped" "down" "down" "retire_ready_merged_worker"
  append_runtime_event "$manager_project" "retire_ready_merged_worker_settled" \
    "worktree=$target_project" \
    "branch=${branch:-unknown}" \
    "previous_supervisor_pid=${supervisor_pid:-none}" \
    "previous_ai_pid=${ai_pid:-none}"
  return 0
}

manager_hygiene_alerts() {
  local project="$1" repo_root wt_path branch role_hint dirty_entries checkpoint_json checkpoint_required streak threshold normalized_project normalized_wt_path
  repo_root="$(git -C "$project" rev-parse --show-toplevel 2>/dev/null || true)"
