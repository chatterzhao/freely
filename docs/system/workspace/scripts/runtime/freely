  # ERR trap: capture crash → auto-report as raw issue via freely feedback.
  # Desensitized: no user paths, no prompt content, no session IDs.
  _on_supervisor_err() {
    # Prevent recursive ERR trap: disable errexit while handling crash.
    # Without this, any failing command inside the handler re-triggers ERR,
    # causing "supervisor crash: bash at freely:19074 (rc=1)" recursive reports.
    set +e
    # Guard against re-entry (ERR trap may fire again during exit/cleanup)
    if [[ -n "${_FREELY_CRASH_HANDLER_ACTIVE:-}" ]]; then
      return 0
    fi
    _FREELY_CRASH_HANDLER_ACTIVE=1
    local _err_rc=$?
    local _err_cmd _err_line _err_reason _msg
    _err_cmd="${BASH_COMMAND%% *}"
    if [[ "$_err_rc" -eq 0 ]]; then
      LAST_WORKCELL_EXIT_REASON="set_e_exit_cmd=unknown@${BASH_SOURCE##*/}:${1:-0}_rc_0"
      return
    fi
    _err_line="${1:-${LINENO}}"
    _err_reason="set_e_exit_cmd=${_err_cmd}@${BASH_SOURCE##*/}:${_err_line}_rc_${_err_rc}"
    LAST_WORKCELL_EXIT_REASON="$_err_reason"
    if [[ -x "$SELF_ROOT/bin/freely" ]]; then
      _msg="supervisor crash: ${_err_cmd} at ${BASH_SOURCE##*/}:${_err_line} (rc=${_err_rc})
last_exit_reason_before_crash: ${LAST_WORKCELL_EXIT_REASON:-none}
tool: ${AGENT_AI_TOOL:-unknown}
adapter: ${AGENT_AI_TOOL_ADAPTER:-unknown}
launch_kind: ${mode_name:-unknown}"
      if [[ -n "${FREELY_REPO_URL:-}" ]]; then
        local _crash_title _existing_issue _ts
        _crash_title="supervisor crash: ${_err_cmd} rc=${_err_rc}"
        _ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        # Search for existing OPEN issue with same crash signature
        _existing_issue=$(gh issue list --repo "$FREELY_REPO_URL" --state open --search "$_crash_title" --limit 1 --json number --jq '.[0].number' 2>/dev/null || true)
        if [[ -n "$_existing_issue" && "$_existing_issue" =~ ^[0-9]+$ ]]; then
          # Append comment to existing issue
          gh issue comment "$_existing_issue" --repo "$FREELY_REPO_URL" \
            --body "Recurred at ${_ts}:
${_msg}" >/dev/null 2>&1 || true
        else
          # No existing issue — create new one
          "$SELF_ROOT/bin/freely" feedback --title "$_crash_title" --body "$_msg" >/dev/null 2>&1 || true
        fi
      fi
    fi
  }
  trap '_on_supervisor_err $LINENO' ERR
  # ── Heartbeat subprocess: keeps supervisor-heartbeat fresh while we wait ──
  # Checks parent liveness so an orphaned heartbeat can't fool the watchdog.
  # Pass supervisor PID explicitly — $$ inside () is the subshell's PID.
  local _supervisor_pid=$$
  (
    while kill -0 $_supervisor_pid 2>/dev/null; do
      _update_heartbeat "$PROJECT_ROOT"
    _rotate_log "$PROJECT_ROOT/.freely/run/a2a-server.log" 2>/dev/null || true
    _rotate_log "$PROJECT_ROOT/.freely/run/db-daemon.log" 2>/dev/null || true
    _rotate_log "$PROJECT_ROOT/.freely/run/watchdog-sse.log" 2>/dev/null || true
    _rotate_log "$PROJECT_ROOT/.freely/logs/lifecycle-trace.log" 2>/dev/null || true
    _rotate_log "$PROJECT_ROOT/.freely/logs/runtime-events.log" 2>/dev/null || true

      sleep 2
