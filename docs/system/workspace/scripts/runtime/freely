restart_manager_supervisor_preserving_handoff() {
  local project="$1" run_dir ai_pid supervisor_pid
  run_dir="$(run_dir_for_project "$project")"
  ai_pid="$(manager_ai_pid_for_project "$project")"
  supervisor_pid="$(manager_supervisor_pid_for_project "$project")"
  if [[ -n "$ai_pid" ]]; then
    terminate_pid_with_graceful_wait "$ai_pid" "manager ai restart preserving handoff"
    rm -f "$run_dir/ai.pid"
  fi
  if [[ -n "$supervisor_pid" ]]; then
    # Daemon supervisors ignore naked TERM without a stop marker, so recovery
    # restarts must force teardown instead of relying on operator-stop semantics.
    terminate_pid_with_graceful_wait "$supervisor_pid" "manager supervisor restart preserving handoff"
    clear_supervisor_identity_truth "$project" "$supervisor_pid"
    rm -f "$run_dir/supervisor.pid"
  fi
  for _ in $(seq 1 20); do
    if [[ -n "$supervisor_pid" ]] && kill -0 "$supervisor_pid" 2>/dev/null; then
      sleep 0.2
      continue
    fi
    break
  done
}


# ── Reviewer Agent ───────────────────────────────────────────
# Reviewer as independent agent. Allocated from pool via agent_working_next.
# Uses agent-table reviewer_slot. ACP session/fork from Manager (same tool) or session/new.

_ensure_reviewer_agent() {
  local project="$1"
  local _reviewer_id="${2:-}"              # e.g. reviewer_05 (explicit) or auto-allocated
  local _raw_key="${3:-}"                  # which issue this reviewer serves
  local _parent_worktree="${4:-}"          # parent worktree for tool inheritance
  local _reviewer_slot=""

  # If no reviewer_id given, allocate next free from pool
  if [[ -z "$_reviewer_id" ]]; then
    local _aq="${PROJECT_ROOT}/bin/agent-table-query"
    if [[ -x "$_aq" ]]; then
      _reviewer_id="$("$_aq" --next-free reviewer 99 2>/dev/null || true)"
    fi
    [[ -z "$_reviewer_id" ]] && { log_warn "no free reviewer slot available (pool exhausted)"; return 1; }
  fi

  # Resolve slot from agent-table v2 (flat format)
  local _aq="${PROJECT_ROOT}/bin/agent-table-query"
  if [[ -x "$_aq" ]]; then
    _reviewer_slot="$("$_aq" --get-slot "$_reviewer_id" 2>/dev/null || true)"
  fi
  [[ -z "$_reviewer_slot" ]] && { log_warn "reviewer slot not found for $_reviewer_id"; return 1; }

  log_info "reviewer agent: $_reviewer_id slot=$_reviewer_slot raw_key=$_raw_key"

  # Write to agent_working table
  local _agent_py="${PROJECT_ROOT}/docs/system/workspace/scripts/runtime/agent_working.py"
  python3 -c "
import sys; sys.path.insert(0, '${PROJECT_ROOT}/docs/system/workspace/scripts/runtime')
from agent_working import acp_session_register
acp_session_register('${project}', '${_raw_key}', 'reviewer', '${_reviewer_id}',
             worktree='$(pwd)', branch='$(git branch --show-current 2>/dev/null || echo develop)')
" 2>/dev/null || true

  # Start ACP session for reviewer (reuse same bridge, new session)
  # The ACP bridge already runs for Manager; reviewer uses session/fork (same tool)
  # or session/new (different tool). For Phase 1, reviewer shares Manager's tool.
  log_info "reviewer $_reviewer_id: creating ACP session/new via bridge"

  # Create ACP session for reviewer via bridge socket
  local _bridge_socket; _bridge_socket="$(_acp_bridge_socket "$PROJECT_ROOT")"
  if [[ -S "$_bridge_socket" ]]; then
    local _session_id; _session_id="rev_$(date +%s)_${_reviewer_id}"
    python3 -c "
import json, socket, sys
req = json.dumps({'jsonrpc':'2.0','id':1,'method':'session/new','params':{'sessionId':'${_session_id}','cwd':'${PROJECT_ROOT}'}}) + '
'
s = socket.socket(socket.AF_UNIX)
s.settimeout(5)
try:
    s.connect('${_bridge_socket}')
    s.sendall(req.encode())
    s.shutdown(socket.SHUT_WR)
    resp = b''
    while True:
        chunk = s.recv(4096)
        if not chunk: break
        resp += chunk
    result = json.loads(resp.decode()).get('result',{})
    sid = result.get('sessionId','')
    if sid:
        # Write session_id to agent_working
        sys.path.insert(0, '${PROJECT_ROOT}/docs/system/workspace/scripts/runtime')
        from agent_working import acp_session_register
        acp_session_register('${PROJECT_ROOT}', '${_raw_key}', 'reviewer', '${_reviewer_id}', session_id=sid, slot='${_reviewer_slot}')
        print(f'[reviewer] session created: {sid}', file=sys.stderr)
except Exception as e:
    print(f'[reviewer] failed to create ACP session: {e}', file=sys.stderr)
finally:
    s.close()
" 2>/dev/null || log_warn "reviewer $_reviewer_id: ACP session creation failed (bridge not ready)"
  else
    log_warn "reviewer $_reviewer_id: ACP bridge socket not found, session deferred"
  fi
  return 0
}

# ── ACP Session Helpers ────────────────────────────────────────
# C2: Create new ACP session for any agent role.
_acp_session_new() {
  local project="$1" role="$2" agent_id="$3" raw_key="$4"
  local _bridge_socket; _bridge_socket="$(_acp_bridge_socket "$project")"
  [[ -S "$_bridge_socket" ]] || { log_warn "ACP bridge not found for session/new ($role $agent_id)"; return 1; }
  local _session_id; _session_id="${role}_$(date +%s)_${agent_id}"
  python3 -c "
import json, socket, sys
req = json.dumps({'jsonrpc':'2.0','id':1,'method':'session/new','params':{'sessionId':'${_session_id}','cwd':'${project}'}}) + '\n'
s = socket.socket(socket.AF_UNIX); s.settimeout(5)
try:
    s.connect('${_bridge_socket}'); s.sendall(req.encode()); s.shutdown(socket.SHUT_WR)
    resp = b''; [resp := resp + chunk for chunk in iter(lambda: s.recv(4096), b'')]
    sid = json.loads(resp.decode()).get('result',{}).get('sessionId','')
    if sid:
        sys.path.insert(0, '${project}/docs/system/workspace/scripts/runtime')
        from agent_working import acp_session_register
        acp_session_register('${project}', '${raw_key}', '${role}', '${agent_id}', session_id=sid)
        print(sid)
except Exception as e: print(f'ERROR:{e}', file=sys.stderr)
finally: s.close()
" 2>/dev/null
}

# C3: Resume existing ACP session.
_acp_session_resume() {
  local project="$1" role="$2" raw_key="$3"
  # Get session_id from agent_working table
  local _session_id; _session_id=$(python3 -c "
import sys; sys.path.insert(0, '${project}/docs/system/workspace/scripts/runtime')
from agent_working import agent_get_session
print(agent_get_session('${project}', '${raw_key}', '${role}') or '')
" 2>/dev/null)
  [[ -z "$_session_id" ]] && { log_warn "no session to resume for $role on $raw_key"; return 1; }
  local _bridge_socket; _bridge_socket="$(_acp_bridge_socket "$project")"
  [[ -S "$_bridge_socket" ]] || { log_warn "ACP bridge not found for session/resume"; return 1; }
  python3 -c "
import json, socket
req = json.dumps({'jsonrpc':'2.0','id':1,'method':'session/resume','params':{'sessionId':'${_session_id}','cwd':'${project}'}}) + '\n'
s = socket.socket(socket.AF_UNIX); s.settimeout(5)
try:
    s.connect('${_bridge_socket}'); s.sendall(req.encode()); s.shutdown(socket.SHUT_WR)
    resp = b''; [resp := resp + chunk for chunk in iter(lambda: s.recv(4096), b'')]
    print(json.loads(resp.decode()).get('result',{}).get('sessionId','ok'))
except Exception as e: print(f'ERROR:{e}', file=sys.stderr)
finally: s.close()
" 2>/dev/null
}

# D13: Fork child session from parent agent session.
# session/fork inherits parent's system prompt + tools + cache prefix (~80% token savings).
# Used for Reviewer dispatch: fork from Manager (neutral, has governance context).
# FORBIDDEN: fork from Worker (self-review bias).
_acp_session_fork() {
  local project="$1" parent_role="$2" child_role="$3" child_agent_id="$4" raw_key="$5"
  # Manager session stored under "__manager__", not issue raw_key
  local _lookup_key="$raw_key"
  [[ "$parent_role" == "manager" ]] && _lookup_key="__manager__"
  local _parent_sid; _parent_sid=$(python3 -c "
import sys; sys.path.insert(0, '${project}/docs/system/workspace/scripts/runtime')
from agent_working import agent_get_session
print(agent_get_session('${project}', '${_lookup_key}', '${parent_role}') or '')
" 2>/dev/null)
  [[ -z "$_parent_sid" ]] && { log_warn "no ${parent_role} session to fork for ${raw_key}"; return 1; }
  local _bridge_socket; _bridge_socket="$(_acp_bridge_socket "$project")"
  [[ -S "$_bridge_socket" ]] || { log_warn "ACP bridge not found for session/fork"; return 1; }
  python3 -c "
import json, socket
params = {'sessionId': '${_parent_sid}', 'role': '${child_role}', 'agentId': '${child_agent_id}'}
req = json.dumps({'jsonrpc':'2.0','id':1,'method':'session/fork','params':params}) + '\n'
s = socket.socket(socket.AF_UNIX); s.settimeout(10)
try:
    s.connect('${_bridge_socket}'); s.sendall(req.encode()); s.shutdown(socket.SHUT_WR)
    resp = b''; [resp := resp + chunk for chunk in iter(lambda: s.recv(4096), b'')]
    result = json.loads(resp.decode())
    sid = result.get('result',{}).get('sessionId','')
    if sid:
        import sys; sys.path.insert(0, '${project}/docs/system/workspace/scripts/runtime')
        from agent_working import acp_session_register
        acp_session_register('${project}', '${raw_key}', '${child_role}', '${child_agent_id}', session_id=sid)
        print(sid)
    else:
        print(f'fork error: {result}', file=__import__('sys').stderr)
except Exception as e: print(f'fork error: {e}', file=__import__('sys').stderr)
finally: s.close()
" 2>/dev/null
}

# C4: Close agent ACP session and release agent_working entry.
_acp_agent_session_close() {
  local project="$1" role="$2" raw_key="$3"
  local _session_id; _session_id=$(python3 -c "
import sys; sys.path.insert(0, '${project}/docs/system/workspace/scripts/runtime')
from agent_working import agent_get_session
print(agent_get_session('${project}', '${raw_key}', '${role}') or '')
" 2>/dev/null)
  if [[ -n "$_session_id" ]]; then
    local _bridge_socket; _bridge_socket="$(_acp_bridge_socket "$project")"
    if [[ -S "$_bridge_socket" ]]; then
      python3 -c "
import json, socket
req = json.dumps({'jsonrpc':'2.0','id':1,'method':'session/close','params':{'sessionId':'${_session_id}'}}) + '\n'
s = socket.socket(socket.AF_UNIX); s.settimeout(5)
try:
    s.connect('${_bridge_socket}'); s.sendall(req.encode()); s.shutdown(socket.SHUT_WR)
    s.recv(4096)
except: pass
finally: s.close()
" 2>/dev/null
    fi
  fi
  # Release from agent_working
  python3 -c "
import sys; sys.path.insert(0, '${project}/docs/system/workspace/scripts/runtime')
from agent_working import agent_release
agent_release('${project}', '${raw_key}', '${role}')
" 2>/dev/null || true
}

ensure_manager_once() {
  local project="$1"
  local run_dir sup_pid_file current_pid current_ai_pid same_tool_blocked desired_state last_exit_reason supervisor_hint

  load_config "$project"
  run_dir="$(run_dir_for_project "$project")"
  sup_pid_file="$run_dir/supervisor.pid"
  mkdir -p "$run_dir"
  current_pid=""
  if [[ -f "$sup_pid_file" ]]; then
    current_pid="$(cat "$sup_pid_file" 2>/dev/null || true)"
    if ! valid_supervisor_pid_for_project "$project" "$current_pid"; then
      current_pid=""
    fi
  fi
  if [[ -z "$current_pid" ]]; then
    current_pid="$(discover_supervisor_pid "$project")"
  fi
  if [[ -n "$current_pid" ]]; then
    current_pid="$(manager_recheck_wait_for_supervisor_teardown_if_needed "$project" "$current_pid")"
  fi
  supervisor_hint="$(manager_supervisor_pid_hint_for_project "$project")"

  desired_state="unknown"
  last_exit_reason=""
  if [[ -f "$(workcell_state_file "$project")" ]]; then
    unset DESIRED_RUNTIME_STATE LAST_EXIT_REASON
    # shellcheck disable=SC1090
    source "$(workcell_state_file "$project")"
    desired_state="${DESIRED_RUNTIME_STATE:-unknown}"
    last_exit_reason="${LAST_EXIT_REASON:-}"
  fi
  if [[ "$desired_state" == "running" ]] && execution_network_launch_block_active "$project" "$last_exit_reason"; then
    log_warn "manager bootstrap paused by bounded network-recovery gate (reason=${last_exit_reason})"
    append_lifecycle_trace "$project" "L210" "manager_bootstrap_paused" \
      "trigger=network_recovery_gate_active" \
      "reason=${last_exit_reason:-unknown}" \
      "next=wait"
    return 0
  fi

  same_tool_blocked="0"
  current_ai_pid="$(manager_ai_pid_for_project "$project")"
  if [[ -n "$current_pid" ]] && [[ -n "$current_ai_pid" ]]; then
    if recover_stalled_manager_ai_if_needed "$project"; then
      current_pid=""
      current_ai_pid=""
    fi
  fi
  if tool_supports_auto_same_tool_slot_recovery "${AGENT_AI_TOOL:-}"; then
    if ! prepare_manager_same_tool_slot_recovery_if_needed "$project"; then
      if [[ "${TOOL_AUTO_RECOVERY_SAME_TOOL_EXHAUSTED:-0}" == "1" ]]; then
        same_tool_blocked="1"
        log_warn "no ${AGENT_AI_TOOL:-unknown} slot is ready for manager bootstrap; checking cross-tool fallback policy"
        append_lifecycle_trace "$project" "L211" "manager_same_tool_recovery_blocked" \
          "trigger=same_tool_slots_exhausted" \
          "tool=${AGENT_AI_TOOL:-unknown}" \
          "next=cross_tool_fallback_selection"
      elif [[ "${TOOL_AUTO_RECOVERY_ENTRY_BLOCKED:-0}" == "1" ]]; then
        same_tool_blocked="1"
        log_warn "current ${AGENT_AI_TOOL:-unknown} slot entry is unavailable; holding manager bootstrap until recovery path is ready"
        append_lifecycle_trace "$project" "L212" "manager_same_tool_recovery_blocked" \
          "trigger=entry_slot_unavailable" \
          "tool=${AGENT_AI_TOOL:-unknown}" \
          "next=wait_or_cross_tool_fallback"
      fi
    fi
  fi
  # ── Heartbeat-based liveness (replaces L220-L240 grace chain) ──
  # The supervisor touches supervisor-heartbeat every ~2s via a background
  # subprocess.  If the heartbeat is stale, the supervisor is dead/stuck.
  # No ai.pid dependency, no file-IPC state inference, no grace layers.
  local _hb_file _hb_timeout _hb_now _hb_epoch _hb_stale
  _hb_file="$run_dir/supervisor-heartbeat"
  _hb_timeout="${SUPERVISOR_HEARTBEAT_TIMEOUT_SECS:-120}"
  if [[ -n "$current_pid" ]] && kill -0 "$current_pid" 2>/dev/null; then
    _hb_stale=0
    if [[ -f "$_hb_file" ]]; then
      _hb_epoch=$(file_mtime_epoch "$_hb_file" 2>/dev/null || echo 0)
      _hb_now=$(date +%s)
      if (( _hb_now - _hb_epoch > _hb_timeout )); then
        _hb_stale=1
      fi
    else
      # No heartbeat file yet — supervisor may be starting.  Give it a
      # short grace (15s) for the first heartbeat to appear.
      local _sup_start_epoch
      _sup_start_epoch=$(file_mtime_epoch "$sup_pid_file" 2>/dev/null || echo 0)
      _hb_now=$(date +%s)
      if (( _hb_now - _sup_start_epoch > 15 )); then
        _hb_stale=1
      fi
    fi
    if [[ "$_hb_stale" == "0" ]]; then
      return 0
    fi
    log_warn "supervisor heartbeat stale (>${_hb_timeout}s or missing), restarting (pid=$current_pid)"
    kill "$current_pid" 2>/dev/null || true
    sleep 1
    current_pid=""
  fi

  prepare_manager_cross_tool_fallback_if_needed "$project" "$same_tool_blocked" || true

  if [[ "${TOOL_AUTO_RECOVERY_DECISION:-none}" == "waiting" ]]; then
    log_warn "manager bootstrap remains blocked while every configured recovery path is unavailable"
    append_lifecycle_trace "$project" "L230" "manager_recovery_waiting" \
      "trigger=all_recovery_paths_unavailable" \
      "tool=${AGENT_AI_TOOL:-unknown}" \
      "decision=${TOOL_AUTO_RECOVERY_DECISION:-none}" \
      "next=wait"
    return 0
  fi

  if [[ "$same_tool_blocked" == "1" && "${TOOL_AUTO_RECOVERY_DECISION:-none}" != "selected" ]]; then
    log_warn "manager bootstrap skipped because no recovery-capable tool is ready"
    current_pid=""
    append_lifecycle_trace "$project" "L231" "manager_bootstrap_skipped" \
      "trigger=no_recovery_capable_tool_ready" \
      "tool=${AGENT_AI_TOOL:-unknown}" \
      "decision=${TOOL_AUTO_RECOVERY_DECISION:-none}" \
      "next=wait"
    return 0
  fi

  if [[ "${TOOL_AUTO_RECOVERY_DECISION:-none}" != "selected" ]] \
    && ([[ -n "$current_pid" ]] || project_bootstrap_launch_in_flight_from_unverified_supervisor_hint "$project"); then
    log_info "manager supervisor already running (pid=${current_pid:-${supervisor_hint:-unknown}})"
    append_lifecycle_trace "$project" "L232" "manager_supervisor_already_running" \
      "supervisor_pid=${current_pid:-${supervisor_hint:-unknown}}" \
      "decision=${TOOL_AUTO_RECOVERY_DECISION:-none}" \
      "next=keep_current_supervisor"
    return 0
  fi

  # Clear stale "stopped" state from startup_self_heal_no_runtime.
  # This state means the PREVIOUS supervisor detected no runtime — not that
  # the operator requested a permanent stop. Only operator_stop should persist.
  if [[ "$desired_state" == "stopped" && "$last_exit_reason" != "operator_stop" ]]; then
    write_workcell_state "$project" "running" "down" "down" "watchdog_restart"
  fi
  append_lifecycle_trace "$project" "L240" "manager_launch_requested" \
    "decision=${TOOL_AUTO_RECOVERY_DECISION:-none}" \
    "tool=${AGENT_AI_TOOL:-unknown}" \
    "next=launch_manager_supervisor"
  launch_manager_supervisor "$project"
  log_info "manager bootstrap requested"
}

latest_prompt_file_for_project() {
  local project="$1"
  local state_file anchored_prompt_file
  state_file="$(session_state_file "$project")"
  anchored_prompt_file="${LAST_PROMPT_FILE:-}"
  if [[ -z "$anchored_prompt_file" && -f "$state_file" ]]; then
    anchored_prompt_file="$(awk -F= '/^LAST_PROMPT_FILE=/ {print $2; exit}' "$state_file" 2>/dev/null || true)"
    anchored_prompt_file="${anchored_prompt_file#\"}"
    anchored_prompt_file="${anchored_prompt_file%\"}"
  fi
  if [[ -n "$anchored_prompt_file" && -f "$anchored_prompt_file" ]]; then
    printf '%s\n' "$anchored_prompt_file"
    return 0
  fi
  latest_run_artifact_for_project "$project" 'prompt-*.txt'
}

ai_process_command_for_project() {
  local project="$1" ai_pid
  ai_pid="$(runtime_ai_pid_hint_for_project "$project")"
  [[ -n "$ai_pid" ]] || return 0
  ps -p "$ai_pid" -o command= 2>/dev/null || true
