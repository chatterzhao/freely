      [[ -n "$selected_slot" ]] || return 1
      tool_binary_available_for_auto_recovery "$tool" || return 1
      runtime_write_tool_current_slot "$tool" "$selected_slot"
      ;;
  esac
  TOOL_AUTO_RECOVERY_SLOT="$selected_slot"
  return 0
}

