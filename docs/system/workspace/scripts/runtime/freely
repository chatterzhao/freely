worker_prompt_target_worktree() {
  local prompt_file="$1"
  [[ -f "$prompt_file" ]] || return 0
  awk '
    /^You are the [^`]*worker for `/ && / in `\// {
      value=$0
      sub(/^You are the [^`]*worker for `/, "", value)
      split(value, parts, "` in `")
      value=parts[2]
      sub(/`\.$/, "", value)
      sub(/`$/, "", value)
      print value
      exit
    }
    /^你的 worktree：$/ { capture=1; next }
	    /^Worktree: \// { sub(/^Worktree: /, ""); print; exit }
    /^Worktree:$/ { capture=1; next }
    capture && /^- / {
      sub(/^- /, "", $0)
      gsub(/`/, "", $0)
      print
      exit
    }
  ' "$prompt_file"
}

worker_prompt_dispatch_metadata_value() {
  local prompt_file="$1" key="$2"
  [[ -f "$prompt_file" && -n "$key" ]] || return 0
  awk -v desired_key="$key" '
    function trim(value) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      gsub(/`/, "", value)
      return value
    }
    function normalize_key(value) {
      value=trim(value)
      sub(/^[[:space:]]*-[[:space:]]*/, "", value)
      gsub(/[[:space:]-]/, "_", value)
      return tolower(value)
    }
    BEGIN {
      awaiting_value=0
    }
    {
      line=$0
      if (line ~ /^[[:space:]]*$/) next

      if (awaiting_value == 1) {
        value_line=line
        if (value_line ~ /^[[:space:]]*-[[:space:]]*/) {
          gsub(/^[[:space:]]*-[[:space:]]*/, "", value_line)
          print trim(value_line)
          exit
        }
        if (value_line ~ /^[[:space:]]*[^:]+:[[:space:]]*/) {
          awaiting_value=0
        } else {
          next
        }
      }

      if (line !~ /:/) next
      split(line, parts, ":")
      key_part=normalize_key(parts[1])
      if (key_part != tolower(desired_key)) next
      if (line ~ /^[^:]+:[[:space:]]*[^[:space:]].*$/) {
        sub(/^[^:]+:[[:space:]]*/, "", line)
        print trim(line)
        exit
      }
      awaiting_value=1
    }
  ' "$prompt_file"
}

worker_prompt_dispatch_metadata_csv() {
  local prompt_file="$1" key="$2"
  [[ -f "$prompt_file" && -n "$key" ]] || return 0
  awk -v desired_key="$key" '
    function trim(value) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      gsub(/`/, "", value)
      return value
    }
    function normalize_key(value) {
      value=trim(value)
      sub(/^[[:space:]]*-[[:space:]]*/, "", value)
      gsub(/[[:space:]-]/, "_", value)
      return tolower(value)
    }
    function emit_current() {
      if (current_value != "") {
        if (out != "") out = out ","
        out = out current_value
      }
      current_value=""
    }
    BEGIN {
      capture=0
      out=""
      current_value=""
    }
    {
      line=$0
      if (line ~ /^[[:space:]]*$/) {
        if (capture == 1 && current_value != "") {
          emit_current()
        }
        next
      }

      if (capture == 1 && line ~ /^[[:space:]]*-[[:space:]]*/) {
        emit_current()
        sub(/^[[:space:]]*-[[:space:]]*/, "", line)
        current_value=trim(line)
        next
      }

      if (line ~ /:/) {
        split(line, parts, ":")
        key_part=normalize_key(parts[1])
        if (capture == 1 && key_part != tolower(desired_key)) {
          emit_current()
          capture=0
        }
        if (key_part == tolower(desired_key)) {
          capture=1
          sub(/^[^:]+:[[:space:]]*/, "", line)
          line=trim(line)
          if (line != "") {
            emit_current()
            current_value=line
          }
          next
        }
      }

      if (capture == 1 && current_value != "") {
        current_value=current_value " " trim(line)
      }
    }
    END {
      if (capture == 1 && current_value != "") {
        emit_current()
      }
      print out
    }
  ' "$prompt_file"
}

