      source "$(session_state_file "$wt_path")"
      streak="${CHECKPOINT_DRIFT_STREAK_CURRENT:-0}"
    fi
    [[ "$streak" =~ ^[0-9]+$ ]] || streak=0
    if [[ "$checkpoint_required" == "true" || "$dirty_entries" =~ ^[0-9]+$ && "$dirty_entries" -ge "${CHECKPOINT_WARN_DIRTY_ENTRIES:-40}" || "$streak" -ge "$threshold" ]]; then
      printf -- '- worktree_checkpoint_drift: branch=%s role=%s owner=manager-owned next_action=delegate_hygiene_worker dirty_entries=%s checkpoint_required=%s drift_streak=%s path=%s\n' \
        "${branch:-unknown}" "${role_hint:-worker}" "${dirty_entries:-0}" "${checkpoint_required:-false}" "${streak:-0}" "$wt_path"
    fi
  done < <(git -C "$repo_root" worktree list --porcelain | awk '
    /^worktree / { wt=substr($0, 10); br="" }
    /^branch / { br=$2; sub(/^refs\/heads\//, "", br); print wt "|" br }
  ')
}

manager_runtime_recover_workers_if_needed() {
  local project="$1" repo_root wt_path branch desired_state role_hint exit_reason supervisor_state recovered latest_continuity_file normalized_project normalized_wt_path
  local worker_signature worker_prompt_file terminal_kind terminal_exit_reason handoff_prompt_file allow_terminal_handoff_absorb terminal_intake_id
  local skip_continuity_recovery="${2:-false}"
  repo_root="$(git -C "$project" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$repo_root" ]] || return 0
  [[ "$(effective_runtime_role_for_project "$project")" == "manager" ]] || return 0

  # Continuity-based recovery (deprecated old path): skip on first patrol cycle
  # because fleet cache is not populated until build_prompt runs.
  if [[ "$skip_continuity_recovery" != "true" ]]; then
    reset_project_runtime_discovery_cache "$project"
    latest_continuity_file="$(latest_generated_manager_continuity_file_for_project "$project")"
    recovered="$(manager_runtime_launch_workers_from_latest_task "$project")"
    [[ "$recovered" =~ ^[0-9]+$ ]] || recovered=0
  fi
  normalized_project="$(normalize_runtime_worktree_path "$project")"
  while IFS='|' read -r wt_path branch; do
    [[ -n "$wt_path" ]] || continue
    normalized_wt_path="$(normalize_runtime_worktree_path "$wt_path")"
    [[ -n "$normalized_wt_path" && "$normalized_wt_path" == "$normalized_project" ]] && continue
    [[ -f "$(config_file "$wt_path")" ]] || continue
    desired_state=""
    role_hint=""
    exit_reason=""
    supervisor_state="down"
    if [[ -f "$(workcell_state_file "$wt_path")" ]]; then
      reconcile_delegated_runtime_handoff_state_if_needed "$wt_path" >/dev/null 2>&1 || true
      # shellcheck disable=SC1090
      source "$(workcell_state_file "$wt_path")"
      desired_state="${DESIRED_RUNTIME_STATE:-}"
      role_hint="${LAST_ROLE_HINT:-$(effective_runtime_role_for_project "$wt_path")}"
      exit_reason="${LAST_EXIT_REASON:-}"
    fi

    [[ "${role_hint:-worker}" == "worker" ]] || continue

    if worker_project_has_terminal_exit_contract "$wt_path"; then
      terminal_kind="$(worker_exit_contract_kind "$wt_path" || true)"
      allow_terminal_handoff_absorb=0
      if [[ "$terminal_kind" == "worker_handoff_needed" ]]; then
        if [[ "$desired_state" == "running" || "$desired_state" == "stopped" || "${exit_reason:-}" == "worker_exit_contract_handoff_needed" ]]; then
          allow_terminal_handoff_absorb=1
        fi
      fi
      if [[ "$allow_terminal_handoff_absorb" -eq 1 ]]; then
        handoff_prompt_file="$(worker_handoff_followthrough_prompt_file_for_project "$wt_path" || true)"
        if [[ -n "$handoff_prompt_file" && -f "$handoff_prompt_file" ]]; then
          log_info "manager runtime absorbs terminal worker handoff into followthrough prompt: branch=${branch:-unknown} prompt=$handoff_prompt_file path=$wt_path"
          if launch_worker_from_manager_prompt_if_needed "$project" "$handoff_prompt_file"; then
            # contract cleanup deprecated
            append_runtime_event "$project" "worker_exit_contract_handoff_absorbed" \
              "worktree=$wt_path" \
              "branch=${branch:-unknown}" \
              "followthrough_prompt=$handoff_prompt_file"
            recovered=$((recovered + 1))
            continue
          fi
          append_runtime_event "$project" "worker_exit_contract_handoff_absorb_launch_failed" \
            "worktree=$wt_path" \
            "branch=${branch:-unknown}" \
            "followthrough_prompt=$handoff_prompt_file"
        fi
      fi
      case "$terminal_kind" in
        worker_done) terminal_exit_reason="worker_exit_contract_done" ;;
        worker_blocked) terminal_exit_reason="worker_exit_contract_blocked" ;;
        worker_handoff_needed) terminal_exit_reason="worker_exit_contract_handoff_needed" ;;
        *) terminal_exit_reason="worker_exit_contract_terminal" ;;
      esac
      if [[ "${exit_reason:-}" != "$terminal_exit_reason" ]]; then
        append_runtime_event "$project" "$terminal_exit_reason" \
          "worktree=$wt_path" \
          "branch=${branch:-unknown}" \
          "source=manager_runtime_recover_workers_if_needed"
      fi
      terminal_intake_id="$(materialize_manager_worker_terminal_continuation "$project" "$wt_path" "$branch" "$terminal_kind" || true)"
      if [[ -n "$terminal_intake_id" ]]; then
        append_runtime_event "$project" "worker_terminal_followthrough_materialized" \
          "worktree=$wt_path" \
          "branch=${branch:-unknown}" \
          "terminal_kind=${terminal_kind:-unknown}" \
          "intake_id=$terminal_intake_id"
      fi
      write_workcell_state "$wt_path" "stopped" "down" "down" "$terminal_exit_reason"
      log_info "manager runtime skips expected-running recovery for terminal worker exit contract: branch=${branch:-unknown} state=${terminal_kind:-unknown} path=$wt_path"
      continue
    fi

    [[ "$desired_state" == "running" ]] || continue

    if [[ -f "$(run_dir_for_project "$wt_path")/supervisor.pid" ]]; then
      local sp
      sp="$(cat "$(run_dir_for_project "$wt_path")/supervisor.pid" 2>/dev/null || true)"
      if valid_supervisor_pid_for_project "$wt_path" "$sp"; then
        supervisor_state="up"
      fi
    fi
    if [[ "$supervisor_state" == "up" ]]; then
      if settle_retire_ready_merged_worker_runtime_state "$project" "$wt_path" "$branch"; then
        log_info "manager runtime settled retire-ready merged worker out of active recovery: branch=${branch:-unknown} path=$wt_path"
        continue
      fi
      if manager_continuity_explicitly_freezes_worker_project "$project" "$wt_path" "$latest_continuity_file"; then
        log_info "manager continuity keeps worker frozen; skipping active recovery: branch=${branch:-unknown} path=$wt_path"
        continue
      fi
      if recover_stalled_worker_ai_if_needed "$wt_path"; then
        recovered=$((recovered + 1))
      fi
      continue
    fi

    if manager_continuity_explicitly_freezes_worker_project "$project" "$wt_path" "$latest_continuity_file"; then
      log_info "manager continuity keeps worker frozen; skipping expected-running recovery: branch=${branch:-unknown} path=$wt_path"
      continue
    fi

    worker_prompt_file="$(authoritative_worker_prompt_file_for_project "$wt_path" || true)"
    if worker_project_is_absorbed_merged_lane "$project" "$wt_path" "$branch" || \
      worker_project_is_retire_ready_merged_followthrough "$project" "$wt_path" "$branch" "$worker_prompt_file" || \
      worker_prompt_targets_retire_ready_merged_worktree "$project" "$worker_prompt_file"; then
      settle_retire_ready_merged_worker_runtime_state "$project" "$wt_path" "$branch" >/dev/null 2>&1 || true
      log_info "manager runtime skips expected-running recovery for retire-ready merged worker: branch=${branch:-unknown} path=$wt_path"
      continue
    fi

    worker_signature="$(project_current_blocking_intent_signature "$wt_path")"
    if [[ -n "$worker_signature" ]] && manager_other_worker_holds_blocking_intent_signature "$project" "$wt_path" "$worker_signature"; then
      log_info "manager runtime skips expected-running recovery due to ownership conflict: branch=${branch:-unknown} intent=${worker_signature} path=$wt_path"
      continue
    fi

    log_info "manager runtime recovering expected-running worker: branch=${branch:-unknown} exit_reason=${exit_reason:-unknown} path=$wt_path"
    if ! worker_project_has_launchable_verification_contract "$wt_path"; then
      local verification_missing_fields_csv
      verification_missing_fields_csv="$(worker_verification_contract_missing_fields_csv_for_project "$wt_path")"
      write_worker_verification_contract_stub_for_project "$wt_path" "$verification_missing_fields_csv" "" "$wt_path"
      write_workcell_state "$wt_path" "stopped" "down" "down" "manager_worker_launch_verification_blocked"
      log_warn "manager runtime skips expected-running recovery without launchable verification contract: branch=${branch:-unknown} missing=${verification_missing_fields_csv:-verification_contract_missing} path=$wt_path"
      continue
    fi
    start_workcell_supervisor_async "$wt_path" "$project"
    recovered=$((recovered + 1))
  done < <(git -C "$repo_root" worktree list --porcelain | awk '
    /^worktree / { wt=substr($0, 10); br="" }
    /^branch / { br=$2; sub(/^refs\/heads\//, "", br); print wt "|" br }
  ')

  printf '%s\n' "$recovered"
}

