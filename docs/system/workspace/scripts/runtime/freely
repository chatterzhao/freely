      wt_state="CLEAN"
    fi
    cfg="$(config_file "$wt_path")"
    supervisor_pid="none"
    ai_pid="none"
    last_launch="-"
    last_dirty="-"
    checkpoint_required="false"
    if [[ -f "$cfg" ]]; then
      run_dir="$(run_dir_for_project "$wt_path")"
      session_state="$(session_state_file "$wt_path")"
      if [[ -f "$run_dir/supervisor.pid" ]]; then
        supervisor_pid="$(cat "$run_dir/supervisor.pid" 2>/dev/null || echo none)"
        if ! valid_supervisor_pid_for_project "$wt_path" "$supervisor_pid"; then
          supervisor_pid="none"
        fi
      fi
      if [[ -f "$run_dir/ai.pid" ]]; then
        ai_pid="$(cat "$run_dir/ai.pid" 2>/dev/null || echo none)"
        if ! valid_ai_pid_for_project "$wt_path" "$ai_pid"; then
          ai_pid="none"
        fi
      fi
      if [[ -f "$session_state" ]]; then
        # shellcheck disable=SC1090
        source "$session_state"
        last_launch="${LAST_LAUNCH_KIND:--}"
        last_dirty="${LAST_PROJECT_DIRTY_ENTRIES:-0}"
      fi
    fi
    checkpoint_json="$(checkpoint_guard_json_for_project "$wt_path")"
    checkpoint_required="$(checkpoint_guard_value "$checkpoint_json" checkpoint_required)"
    printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "$wt_branch" "$wt_state" "$supervisor_pid" "$ai_pid" "$last_dirty" "${checkpoint_required:-false}" "$wt_path"
    if [[ "$last_launch" != "-" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "launch=$last_launch" "" ""
    fi
  done < <(printf '%s\n' "$entries" | awk '
    BEGIN { wt=""; br="(detached)" }
    /^worktree / { wt=substr($0, 10); br="(detached)" }
    /^branch / { br=$2; sub(/^refs\/heads\//, "", br) }
    /^$/ { if (wt != "") { print wt "|" br; wt=""; br="(detached)" } }
    END { if (wt != "") print wt "|" br }
  ')
}

cmd_stop() {
  local project=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project")"
  local sdir run_dir
  sdir="$(state_dir "$project")"
  run_dir="$(run_dir_for_project "$project")"
  mkdir -p "$run_dir"
  : >"$(stop_marker_file "$project")"

  if [[ -f "$run_dir/ai.pid" ]]; then
    local ap
    ap="$(cat "$run_dir/ai.pid" 2>/dev/null || true)"
    [[ -n "$ap" ]] && kill "$ap" 2>/dev/null || true
    rm -f "$run_dir/ai.pid"
  fi
  if [[ -f "$(ensure_manager_watchdog_pid_file "$project")" ]]; then
    local wp
    wp="$(cat "$(ensure_manager_watchdog_pid_file "$project")" 2>/dev/null || true)"
    if valid_ensure_manager_watchdog_pid_for_project "$project" "$wp"; then
      [[ -n "$wp" ]] && kill "$wp" 2>/dev/null || true
    fi
    rm -f "$(ensure_manager_watchdog_pid_file "$project")"
  fi
  if [[ -f "$(interruption_dispatcher_pid_file "$project")" ]]; then
    local dp
    dp="$(cat "$(interruption_dispatcher_pid_file "$project")" 2>/dev/null || true)"
    if valid_interruption_dispatcher_pid_for_project "$project" "$dp"; then
      [[ -n "$dp" ]] && kill "$dp" 2>/dev/null || true
    fi
    rm -f "$(interruption_dispatcher_pid_file "$project")"
  fi
  if [[ -f "$run_dir/supervisor.pid" ]]; then
    local sp
    sp="$(cat "$run_dir/supervisor.pid" 2>/dev/null || true)"
    if valid_supervisor_pid_for_project "$project" "$sp"; then
      [[ -n "$sp" ]] && kill "$sp" 2>/dev/null || true
    fi
    rm -f "$run_dir/supervisor.pid"
  else
    local sp
    sp="$(discover_supervisor_pid "$project")"
    [[ -n "$sp" ]] && kill "$sp" 2>/dev/null || true
  fi
  if [[ -f "$run_dir/supervisor.pid" ]]; then
    local sp
    sp="$(cat "$run_dir/supervisor.pid" 2>/dev/null || true)"
    if [[ -n "$sp" ]]; then
      for _ in $(seq 1 20); do
        kill -0 "$sp" 2>/dev/null || break
        sleep 0.2
      done
    fi
  fi
  rm -f "$(session_state_file "$project")" "$(handoff_file "$project")"
  rm -f "$(stop_marker_file "$project")"
  write_workcell_state "$project" "stopped" "down" "down" "operator_stop"
  log_info "stopped (if running)"
}

main() {
  local cmd="${1:-}"
  [[ -n "$cmd" ]] || { usage; exit 1; }
  shift || true
  case "$cmd" in
    init) cmd_init "$@" ;;
    doctor) cmd_doctor "$@" ;;
    chat) cmd_chat "$@" ;;
    tui) cmd_tui "$@" ;;
    intake)
      local subcmd="${1:-}"
      shift || true
      case "$subcmd" in
        chat) cmd_intake_chat "$@" ;;
        claim) cmd_intake_claim "$@" ;;
        resolve) cmd_intake_resolve "$@" ;;
        status) cmd_intake_status "$@" ;;
        *) log_error "unknown intake subcommand: $subcmd"; usage; exit 1 ;;
      esac
      ;;
    ensure-manager) cmd_ensure_manager "$@" ;;
    ensure-interruption-dispatch) cmd_ensure_interruption_dispatch "$@" ;;
    start) cmd_start "$@" ;;
    status) cmd_status "$@" ;;
    fleet-status) cmd_fleet_status "$@" ;;
    stop) cmd_stop "$@" ;;
    *) log_error "unknown command: $cmd"; usage; exit 1 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
