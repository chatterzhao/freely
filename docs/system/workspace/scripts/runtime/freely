cmd_tui() {
  local project="" once="0" input=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --once) once="1"; shift ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project" 1)"
  check_doc_gate_or_fail "$project"
  bootstrap_interruption_entry_runtime_or_fail "$project"

  if [[ "$once" == "1" || ! -t 0 ]]; then
    render_tui_dashboard "$project"
    if ! tui_compose_message input; then
      exit 0
    fi
    case "$input" in
      /quit|/exit) exit 0 ;;
      /refresh|"") exit 0 ;;
    esac
    [[ -n "$input" ]] || exit 0
    tui_submit_message "$project" "$input"
    printf 'submitted: %s\n' "$input"
    exit 0
  fi

  while true; do
    render_tui_dashboard "$project"
    if ! tui_compose_message input; then
      printf '\n'
      break
    fi
    case "$input" in
      /quit|/exit) break ;;
      /refresh|"") continue ;;
      *)
        tui_submit_message "$project" "$input"
        printf 'submitted. press Enter to continue...'
        IFS= read -r _ || true
        ;;
    esac
  done
}

cmd_intake_chat() {
  local project="" message="" message_file="" author="human" channel="chat" intake_id=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --message) message="${2:-}"; shift 2 ;;
      --message-file) message_file="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --author) author="${2:-}"; shift 2 ;;
      --channel) channel="${2:-}"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
