  local tool="$1" field="$2"
  [[ -f "$TOOL_REGISTRY" && -f "$TOOL_REGISTRY_QUERY" ]] || return 1
  python3 "$TOOL_REGISTRY_QUERY" "$TOOL_REGISTRY" "$tool" "$field" 2>/dev/null
}

