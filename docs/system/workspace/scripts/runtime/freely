    [[ "$wt_path" == "$exclude_project" ]] && continue
    [[ "$(role_hint_for_project "$wt_path")" == "worker" ]] || continue
    if [[ "$active_only" == "true" ]]; then
      worker_project_is_actively_running "$wt_path" || continue
    elif ! worker_project_is_actively_running "$wt_path"; then
      recorded_status="$(recorded_worker_ownership_status "$wt_path")"
      [[ "$recorded_status" == "hard_stale" ]] && continue
    fi
    current_signature="$(project_current_blocking_intent_signature "$wt_path")"
