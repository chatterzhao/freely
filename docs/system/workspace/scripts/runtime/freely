_update_test_gate() {
  local project="$1" status="$2"
  local gate_file branch
  gate_file="$(run_dir_for_project "$project")/test-gate.env"
  # Only for test-pre-merge worktrees. Other worktrees don't need test-gate.
  branch="$(git -C "$project" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  [[ "$branch" == test-pre-merge-* ]] || return 0
  mkdir -p "$(dirname "$gate_file")"
  local tested_at tested_commit
  tested_at="$(current_timestamp_utc_for_machine)"
  tested_commit=""
  if [[ "$status" == "completed" ]]; then
    tested_commit="$(git -C "$project" rev-parse HEAD 2>/dev/null || true)"
  fi
  cat >"$gate_file" <<EOF
TEST_STATUS="$status"
LAST_TESTED_AT="$tested_at"
LAST_TESTED_COMMIT="$tested_commit"
EOF
}

