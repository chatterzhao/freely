write_project_tool_wrapper_scripts() {
  local project="$1"
  local wrapper_dir worktrees_root marker
  wrapper_dir="$(project_tool_wrapper_dir "$project")"
  worktrees_root="$(project_worktrees_root_for_path "$project")"
  marker="# Freely managed tool wrapper"
  mkdir -p "$wrapper_dir"

  cat >"$wrapper_dir/codex" <<EOF
#!/usr/bin/env bash
set -euo pipefail
$marker
exec codex --add-dir "$worktrees_root" "\$@"
EOF
  chmod +x "$wrapper_dir/codex"

  cat >"$wrapper_dir/claude" <<EOF
#!/usr/bin/env bash
set -euo pipefail
$marker
exec claude --add-dir "$worktrees_root" "\$@"
EOF
  chmod +x "$wrapper_dir/claude"

  cat >"$wrapper_dir/iflow" <<EOF
#!/usr/bin/env bash
set -euo pipefail
$marker
exec iflow --add-dir "$worktrees_root" "\$@"
EOF
  chmod +x "$wrapper_dir/iflow"

  cat >"$wrapper_dir/kiro-cli" <<EOF
#!/usr/bin/env bash
set -euo pipefail
$marker
# kiro-cli currently exposes tool-trust flags but no verified sibling-worktree
# writable-root/project-config switch, so this wrapper stays a passthrough.
exec kiro-cli "\$@"
EOF
  chmod +x "$wrapper_dir/kiro-cli"
