freely_security_review_scope_for_audit_detail() {
  local detail="${1:-}"
  local scopes=()
  [[ "$detail" == *"activation_consent_status="* ]] && scopes+=("activation-consent")
  [[ "$detail" == *"missing_project_codex_config"* ]] && scopes+=("project-codex-config")
  [[ "$detail" == *"codex_approval_policy="* ]] && scopes+=("codex-approval-policy")
  [[ "$detail" == *"codex_sandbox_mode_drift"* ]] && scopes+=("codex-sandbox")
  [[ "$detail" == *"codex_network_access_drift"* ]] && scopes+=("codex-network-access")
  if [[ "${#scopes[@]}" -eq 0 ]]; then
    printf 'execution-boundary\n'
  else
    printf '%s\n' "$(IFS=,; echo "${scopes[*]}")"
  fi
}

freely_security_review_decision_fields_for_loaded_config() {
  local project="$1"
  local audit_summary audit_status audit_detail review_scope
  local review_mode reviewer_count decision continuation_guidance minimal_risk_state

  audit_summary="$(freely_execution_boundary_audit_summary_for_loaded_config "$project")"
  audit_status="$(freely_execution_boundary_audit_status_for_loaded_config "$audit_summary")"
  audit_detail="$(freely_execution_boundary_audit_detail_for_loaded_config "$audit_summary")"
  review_scope="$(freely_security_review_scope_for_audit_detail "$audit_detail")"

  case "$audit_status" in
    pass)
      review_mode="none"
      reviewer_count="0"
      decision="continue-current-agent"
      continuation_guidance="continue_current_plan"
      minimal_risk_state="not-needed"
      ;;
    warn)
      review_mode="single-reviewer"
      reviewer_count="1"
      decision="reviewer-guided-continue"
      continuation_guidance="continue_with_reviewer_guidance"
      minimal_risk_state="not-needed"
      ;;
    fail)
      review_mode="decision-committee"
      reviewer_count="2"
      decision="repair-boundary-before-continue"
      continuation_guidance="repair_boundary_then_recheck"
      minimal_risk_state="$(freely_minimal_risk_posture_for_loaded_config)"
