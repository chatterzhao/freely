    ai_ps_line="$(ps -p "$ai_pid" -o pid=,etime=,state=,command= 2>/dev/null | sed 's/^ *//')"
    cat <<EOF
- direct_answer: 当前后台 AI 进程正在运行。
- ai_process:
  - pid: \`$ai_pid\`
  - snapshot: \`${ai_ps_line:-unavailable}\`
- last_tool_session_id: \`$tool_session_id\`
- last_tool_jsonl_path: \`$tool_jsonl_path\`
- latest_prompt_file: \`$prompt_file\`
EOF
  else
    cat <<EOF
- direct_answer: 当前没有运行中的后台 AI 进程。
- ai_process:
  - pid: \`none\`
  - snapshot: \`none\`
- last_tool_session_id: \`$tool_session_id\`
- last_tool_jsonl_path: \`$tool_jsonl_path\`
- latest_prompt_file: \`$prompt_file\`
EOF
  fi
}

validate_restart_point_or_fail() {
  local restart_point="$1"
  [[ -z "$restart_point" ]] && return 0
  case "$restart_point" in
    pre_brainstorm|candidate|milestone|ibm|dev|review|verification|continuation|runtime|cleanup) ;;
    *)
      log_error "unsupported restart point: $restart_point"
      exit 1
      ;;
  esac
}

validate_signal_ownership_or_fail() {
  local ownership="$1"
  [[ -z "$ownership" ]] && return 0
  case "$ownership" in
    manager|worker|runtime) ;;
    *)
      log_error "unsupported ownership: $ownership"
      exit 1
      ;;
  esac
}

