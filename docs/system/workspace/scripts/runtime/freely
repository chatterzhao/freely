  [[ -n "$command_name" ]] || return 1
  command -v "$command_name" >/dev/null 2>&1
}

tool_failure_scope_for_auto_recovery() {
  local tool="$1" failure_reason="$2"
  case "$tool:$failure_reason" in
    *:primary_rate_limit_exhausted|*:secondary_rate_limit_exhausted|*:auth_failure)
      printf 'slot_local\n'
      ;;
    kiro-cli:kiro_monthly_request_limit|kiro-cli:kiro_subscription_status_service_error)
      printf 'slot_local\n'
      ;;
    *:execution_network_transient|*:execution_network_persistent|*:proxy_config_invalid)
      printf 'network_local\n'
      ;;
    *)
      printf 'unknown\n'
      ;;
  esac
}

tool_failure_allows_same_tool_slot_recovery() {
  local tool="$1" failure_reason="$2" scope
  scope="$(tool_failure_scope_for_auto_recovery "$tool" "$failure_reason")"
  [[ "$scope" == "slot_local" ]]
}

tool_failure_allows_cross_tool_auto_recovery() {
  local tool="$1" failure_reason="$2" same_tool_exhausted="${3:-0}" scope
  scope="$(tool_failure_scope_for_auto_recovery "$tool" "$failure_reason")"
  case "$scope" in
    slot_local)
      [[ "$same_tool_exhausted" == "1" ]]
      ;;
    tool_local)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

append_unique_tool_to_stream() {
  local candidate="$1" seen="$2"
  [[ -n "$candidate" ]] || return 1
  case ",$seen," in
    *",$candidate,"*) return 1 ;;
  esac
  printf '%s\n' "$candidate"
}

runtime_auto_recovery_tool_order() {
  local current_tool="$1"
  local seen="" candidate
  seen="$current_tool"
  while IFS= read -r candidate; do
    candidate="$(printf '%s' "$candidate" | tr -d '[:space:]')"
    [[ -n "$candidate" ]] || continue
    append_unique_tool_to_stream "$candidate" "$seen" || continue
    seen="${seen}${seen:+,}$candidate"
  done < <(printf '%s\n' "$(runtime_cross_tool_fallback_order_for_current_tool "$current_tool")" | tr ',' '\n')
}

