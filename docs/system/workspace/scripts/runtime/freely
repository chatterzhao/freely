      return 1
    fi
  fi

  finalize_epoch="$(timestamp_epoch_or_zero "$last_finalize_ts")"
  [[ "$finalize_epoch" =~ ^[0-9]+$ ]] || finalize_epoch=0
  (( finalize_epoch > 0 )) || return 1

  now_epoch="$(date +%s)"
  grace_secs="${FREELY_MANAGER_POST_AI_CYCLE_FINALIZE_GRACE_SECS:-20}"
  [[ "$grace_secs" =~ ^[0-9]+$ ]] || grace_secs=20
