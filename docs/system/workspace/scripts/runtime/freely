select_launch_kind() {
  if [[ "${FIRST_ROUND:-true}" == true ]]; then
    LAUNCH_KIND_SELECTED="fresh"
    LAUNCH_ROTATION_REASON="initial_start"
    return 0
  fi

  if [[ "${ROTATE_ON_CONTEXT_COMPACTED:-1}" == "1" && "${LAST_CONTEXT_COMPACTED:-0}" == "1" ]]; then
    LAUNCH_KIND_SELECTED="fresh_with_handoff"
    LAUNCH_ROTATION_REASON="context_compacted"
    return 0
  fi

  if [[ "${RESUME_STREAK_CURRENT:-0}" -ge "${MAX_RESUME_STREAK:-24}" ]]; then
    LAUNCH_KIND_SELECTED="fresh_with_handoff"
    LAUNCH_ROTATION_REASON="resume_streak_limit"
    return 0
  fi

  if [[ "${LAST_ROUTE_ONLY_HANDOFF:-0}" == "1" && "${ROUTE_ONLY_STREAK_CURRENT:-0}" -ge "${MAX_ROUTE_ONLY_STREAK:-1}" ]]; then
    LAUNCH_KIND_SELECTED="fresh_with_handoff"
    LAUNCH_ROTATION_REASON="route_only_handoff"
    return 0
  fi

  if ratio_meets_threshold "${LAST_CONTEXT_RATIO:-}" "${CONTEXT_ROTATE_RATIO:-0.70}"; then
    LAUNCH_KIND_SELECTED="fresh_with_handoff"
    LAUNCH_ROTATION_REASON="context_usage_threshold"
    return 0
  fi

  if [[ "${LAST_PROJECT_DIRTY_ENTRIES:-0}" =~ ^[0-9]+$ ]] && (( LAST_PROJECT_DIRTY_ENTRIES >= ${CHECKPOINT_BLOCK_DIRTY_ENTRIES:-120} )); then
    LAUNCH_KIND_SELECTED="fresh_with_handoff"
    LAUNCH_ROTATION_REASON="checkpoint_dirty_budget"
    return 0
  fi

  if tool_prefers_resume_evidence "$AI_TOOL" && [[ -z "${LAST_TOOL_SESSION_ID:-}" ]]; then
    LAUNCH_KIND_SELECTED="fresh_with_handoff"
    LAUNCH_ROTATION_REASON="missing_resume_evidence"
    return 0
  fi

  LAUNCH_KIND_SELECTED="resume"
  LAUNCH_ROTATION_REASON=""
}

workspace_root_for_project() {
  local project="$1"
  local candidate start_script
  candidate="$project/docs/system/workspace"
  start_script="$candidate/scripts/start-lead-agent.sh"
  if [[ -d "$candidate" && -f "$start_script" ]]; then
    if rg -q -- '--workspace-root' "$start_script" && rg -q -- '--reasoning-effort' "$start_script"; then
      echo "$candidate"
      return 0
    fi
  fi
  echo "$SELF_ROOT/docs/system/workspace"
}

ai_cli_bin_for_project() {
  local project="$1"
  if [[ -x "$project/bin/ai" ]]; then
    echo "$project/bin/ai"
  else
    echo "$SELF_ROOT/bin/ai"
  fi
}

checkpoint_guard_bin_for_project() {
  local project="$1"
  if [[ -x "$project/bin/checkpoint-guard" ]]; then
    echo "$project/bin/checkpoint-guard"
  else
    echo "$SELF_ROOT/bin/checkpoint-guard"
  fi
}

checkpoint_guard_json_for_project() {
  local project="$1" guard_bin
  guard_bin="$(checkpoint_guard_bin_for_project "$project")"
  [[ -x "$guard_bin" ]] || return 0
  "$guard_bin" --project "$project" --format json 2>/dev/null || true
}

checkpoint_guard_value() {
  local json="$1" key="$2"
  local marker value
  marker="\"${key}\":"
  value="${json#*${marker}}"
  [[ "$value" != "$json" ]] || return 0
  case "$value" in
    true*) printf 'true\n' ;;
    false*) printf 'false\n' ;;
    \"*\") value="${value#\"}"; value="${value%%\"*}"; printf '%s\n' "$value" ;;
    [0-9]*) printf '%s\n' "${value%%[^0-9]*}" ;;
  esac
}

checkpoint_guard_reason_codes() {
  local json="$1"
  local value
  value="${json#*\"reason_codes\":[}"
  [[ "$value" != "$json" ]] || return 0
  value="${value%%]*}"
  value="${value//\"/}"
  value="${value//,/ }"
  printf '%s\n' "$value" | xargs
}

launch_manager_supervisor() {
  local project="$1"
  local launch_bin
  launch_bin="${FREELY_ENSURE_MANAGER_LAUNCH_BIN:-$SELF_ROOT/bin/freely}"
  bash "$launch_bin" start --project "$project" >/dev/null 2>&1 &
  disown "$!" 2>/dev/null || true
}

manager_supervisor_pid_for_project() {
  local project="$1" run_dir sp
  run_dir="$(run_dir_for_project "$project")"
  if [[ -f "$run_dir/supervisor.pid" ]]; then
    sp="$(cat "$run_dir/supervisor.pid" 2>/dev/null || true)"
    if valid_supervisor_pid_for_project "$project" "$sp"; then
      printf '%s\n' "$sp"
      return 0
    fi
  fi
  discover_supervisor_pid "$project"
}

manager_ai_pid_for_project() {
  local project="$1" run_dir ap
  run_dir="$(run_dir_for_project "$project")"
  if [[ -f "$run_dir/ai.pid" ]]; then
    ap="$(cat "$run_dir/ai.pid" 2>/dev/null || true)"
    if valid_ai_pid_for_project "$project" "$ap"; then
      printf '%s\n' "$ap"
      return 0
    fi
  fi
}

restart_manager_supervisor_preserving_handoff() {
  local project="$1" run_dir ai_pid supervisor_pid
  run_dir="$(run_dir_for_project "$project")"
  ai_pid="$(manager_ai_pid_for_project "$project")"
  supervisor_pid="$(manager_supervisor_pid_for_project "$project")"
  if [[ -n "$ai_pid" ]]; then
    kill "$ai_pid" 2>/dev/null || true
    rm -f "$run_dir/ai.pid"
  fi
  if [[ -n "$supervisor_pid" ]]; then
    kill "$supervisor_pid" 2>/dev/null || true
    rm -f "$run_dir/supervisor.pid"
  fi
  for _ in $(seq 1 20); do
    if [[ -n "$supervisor_pid" ]] && kill -0 "$supervisor_pid" 2>/dev/null; then
      sleep 0.2
      continue
    fi
    break
  done
}

ensure_manager_once() {
  local project="$1"
  local run_dir sup_pid_file current_pid current_account current_ai_pid

  run_dir="$(run_dir_for_project "$project")"
  sup_pid_file="$run_dir/supervisor.pid"
  mkdir -p "$run_dir"
  current_pid=""
  if [[ -f "$sup_pid_file" ]]; then
    current_pid="$(cat "$sup_pid_file" 2>/dev/null || true)"
    if ! valid_supervisor_pid_for_project "$project" "$current_pid"; then
      current_pid=""
    fi
  fi
  if [[ -z "$current_pid" ]]; then
    current_pid="$(discover_supervisor_pid "$project")"
  fi

  if [[ "$AI_TOOL" == "codex" ]]; then
    current_account="$(codex_current_account "$project")"
    current_ai_pid="$(manager_ai_pid_for_project "$project")"
    if [[ -n "$current_pid" ]] && [[ -n "$current_account" ]] && ! codex_account_is_available_now "$project" "$current_account" && [[ -z "$current_ai_pid" ]]; then
      log_warn "manager supervisor is idle on an unavailable codex account ($current_account); restarting manager under watchdog control"
      write_manager_bootstrap_handoff "$project" "manager_limit_detected" "$current_account" "$current_account" "manager_process_ended_on_unavailable_account" "relaunch-manager-after-account-recovery"
      restart_manager_supervisor_preserving_handoff "$project"
      current_pid=""
    fi
    ensure_codex_account_ready_for_manager "$project"
  fi

  if [[ -n "$current_pid" ]]; then
    log_info "manager supervisor already running (pid=$current_pid)"
    return 0
  fi

  launch_manager_supervisor "$project"
  log_info "manager bootstrap requested"
}

cmd_ensure_manager_watch() {
  local project="$1" interval="$2" pid_file run_dir existing_pid
  run_dir="$(run_dir_for_project "$project")"
  pid_file="$(ensure_manager_watchdog_pid_file "$project")"
  mkdir -p "$run_dir"

  if [[ -f "$pid_file" ]]; then
    existing_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if valid_ensure_manager_watchdog_pid_for_project "$project" "$existing_pid"; then
      log_info "ensure-manager watchdog already running (pid=$existing_pid)"
      return 0
    fi
  fi

  echo "$$" >"$pid_file"
  trap 'rm -f "$pid_file"' EXIT

  while true; do
    if [[ -f "$(stop_marker_file "$project")" ]]; then
      exit 0
    fi
    ensure_manager_once "$project"
    sleep "$interval"
  done
}

