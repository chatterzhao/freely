  _state_file="$(session_state_file "$project")"
  if [[ -f "$_state_file" ]]; then
    sed -i '' '/^LAST_TOOL_SESSION_ID=/d; /^LAST_TOOL_RESUME_TARGET=/d' "$_state_file" 2>/dev/null || true
    log_info "cross-tool switch: cleared session state for fresh launch"
