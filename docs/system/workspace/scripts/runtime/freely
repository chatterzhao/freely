sanitize_utf8_file_in_place() {
  local file="$1"
  [[ -f "$file" ]] || return 1
  python3 - "$file" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
data = path.read_bytes()
text = data.decode("utf-8", "replace")
invalid_count = text.count("\ufffd")
clean = text.encode("utf-8")
if clean != data:
    path.write_bytes(clean)
print(invalid_count)
PY
}

