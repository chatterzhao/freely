  return 0
}

attempt_local_same_tool_slot_recovery_after_failure() {
  local project="$1" tool="$2" failure_reason="$3"
  LOCAL_TOOL_AUTO_RECOVERY_SLOT=""
  tool_supports_auto_same_tool_slot_recovery "$tool" || return 1
  worker_runtime_should_self_recover_slot_local_failure "$project" || return 1
  local _current_slot; _current_slot="$(runtime_read_tool_current_slot "$project" "$tool" 2>/dev/null || true)"
  tool_select_ready_slot_for_manager_auto_recovery "$project" "$tool" "after_failure" || return 1
  LOCAL_TOOL_AUTO_RECOVERY_SLOT="${TOOL_AUTO_RECOVERY_SLOT:-}"
  # If the "new" slot is the same as current, same-tool recovery didn't actually
  # change anything — return failure so cross-tool switching can take over.
  [[ -n "$_current_slot" && "$LOCAL_TOOL_AUTO_RECOVERY_SLOT" != "$_current_slot" ]] || return 1
  record_tool_auto_switch_event "$project" "$tool" "$tool" "${LOCAL_TOOL_AUTO_RECOVERY_SLOT:-}" "same_tool_slot_recovery" "" "false" "selected" "" "active_runtime_supervisor"
  return 0
}

attempt_runtime_auto_recovery_after_failure() {
  local project="$1" current_tool="$2" failure_reason="$3"
  local candidate fallback_slot origin_tool
  RUNTIME_AUTO_RECOVERY_TOOL=""
  RUNTIME_AUTO_RECOVERY_SLOT=""
  RUNTIME_AUTO_RECOVERY_REASON="${failure_reason:-runtime_error_auto_recovery}"
  runtime_auto_recovery_mark_tool_attempted "$current_tool"
  origin_tool="$(runtime_auto_recovery_origin_tool)"

  if config_bool_enabled "${AUTO_SWITCH_SLOT:-true}" \
    && attempt_local_same_tool_slot_recovery_after_failure "$project" "$current_tool" "$failure_reason"; then
    RUNTIME_AUTO_RECOVERY_TOOL="$current_tool"
    RUNTIME_AUTO_RECOVERY_SLOT="${LOCAL_TOOL_AUTO_RECOVERY_SLOT:-}"
    return 0
  fi

  config_bool_enabled "${AUTO_SWITCH_TOOL:-false}" || return 1

  # Record current tool failure for dead-tool tracking
  local _base_cur; _base_cur="${current_tool%%-*}"
  local _cur_slot; _cur_slot="$(runtime_read_tool_current_slot "$project" "$_base_cur" 2>/dev/null || true)"
  _tool_failure_add "$_base_cur" "${_cur_slot:-}" "${failure_reason:-unknown}"

  # Always advance to the next tool in the fallback list; never reset.
  # The dead mechanism (3 failures/hour + test_command resurrection) is the
  # sole gate — a time-based cooldown that resets the index is harmful when
  # AI cycles outlast the cooldown window (e.g. opencode 900s idle timeout >
  # 600s cooldown).  Without resets, the index advances monotonically and
  # wraps naturally via modulo below.
  _read_cooldown_state
  local _now; _now="$(date +%s)"
  CROSS_TOOL_SWITCH_INDEX=$((CROSS_TOOL_SWITCH_INDEX + 1))

  local _fallback_list; _fallback_list="$(printf '%s,' $(runtime_builtin_auto_recovery_tool_priority))"
  IFS=',' read -ra _fallback_arr <<<"$_fallback_list"
  local _start_idx="$CROSS_TOOL_SWITCH_INDEX"
  local _found=0

  # Batch-test all dead tools once before iterating — saves tokens vs per-candidate testing.
  _resurrect_dead_tools_batch "$project"

  # Track resolved canonical names to deduplicate aliases (kiro-cli→claude etc.)
  local _seen_canonical=""
  for ((_i=0; _i<${#_fallback_arr[@]}; _i++)); do
    local _idx=$(( (_start_idx + _i) % ${#_fallback_arr[@]} ))
    local candidate="${_fallback_arr[$_idx]}"
    [[ -n "$candidate" ]] || continue
    # Resolve alias to canonical: cc-use-codex-cli → claude
    candidate="$(_resolve_tool_alias "$candidate")"
    # Deduplicate: skip if canonical already seen in this pass
    [[ "$_seen_canonical" == *"|$candidate|"* ]] && continue
    _seen_canonical="$_seen_canonical|$candidate|"
    [[ "$candidate" != "$_base_cur" ]] || continue
    runtime_auto_recovery_tool_was_attempted "$candidate" && continue
    # Skip dead tools (3 failures in 1 hour).  Resurrection was already attempted
    # in the batch scan above — if still dead, the tool is genuinely unavailable.
    local _cand_slot; _cand_slot="$(runtime_read_tool_current_slot "$project" "$candidate" 2>/dev/null || true)"
    if _tool_is_dead "$candidate" "${_cand_slot:-}"; then
      continue
    fi
    if ! tool_ready_for_manager_auto_recovery "$project" "$candidate"; then
      continue
    fi
    fallback_slot="${TOOL_AUTO_RECOVERY_SLOT:-}"
    persist_project_tool_selection "$project" "$candidate"
    runtime_clear_session_state_for_fresh_launch "$project"
    load_config "$project"
    record_tool_auto_switch_event "$project" "$current_tool" "$candidate" "${fallback_slot:-}" "${failure_reason:-runtime_error_auto_recovery}" "" "false" "selected" "" "active_runtime_supervisor"
    RUNTIME_AUTO_RECOVERY_TOOL="$candidate"
    RUNTIME_AUTO_RECOVERY_SLOT="${fallback_slot:-}"
    CROSS_TOOL_SWITCH_INDEX="$_idx"
    _write_cooldown_state "$_now" "$_idx"
    FRESH_LAUNCH_COUNT_CURRENT=0
    FRESH_LAUNCH_FIRST_AT=0
    _found=1
    return 0
  done

  # All tools exhausted: keep cooldown state, let watchdog wait
  _write_cooldown_state "$_now" "$CROSS_TOOL_SWITCH_INDEX"
  log_warn "all fallback tools exhausted or dead; will retry after cooldown"

  if [[ -n "$origin_tool" && "$origin_tool" != "$current_tool" ]]; then
    persist_project_tool_selection "$project" "$origin_tool"
    runtime_clear_session_state_for_fresh_launch "$project"
    load_config "$project"
    RUNTIME_AUTO_RECOVERY_TOOL="$origin_tool"
  fi
  return 1
}

runtime_clear_session_state_for_fresh_launch() {
