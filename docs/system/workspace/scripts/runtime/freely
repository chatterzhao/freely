# _resolve_type_expansion: resolve a name via `type`, return the expansion.
# Handles zsh ("is an alias for") and bash ("is aliased to") formats.
_resolve_type_expansion() {
  local name="$1" type_output
  type_output=$(${SHELL:-bash} -ic "type '$name' 2>&1" 2>/dev/null) || true
  if echo "$type_output" | grep -q 'is an alias for'; then
    echo "$type_output" | sed 's/.*is an alias for //'
  elif echo "$type_output" | grep -q 'is aliased to'; then
    echo "$type_output" | sed 's/.*is aliased to .//; s/.$//'
  fi
}

# _strip_env_prefix: strip leading VAR=val assignments from an alias expansion.
# Uses case-based prefix matching instead of bash regex for portability.
_strip_env_prefix() {
  local val="$1"
  while true; do
    # Trim leading whitespace
    val="${val#"${val%%[![:space:]]*}"}"
    # Check if the next token looks like an env var assignment (VAR=)
    case "$val" in
      [a-zA-Z_]*=*) ;;
      *) break ;;
    esac
    val="${val#*=}"
    if [[ "$val" == \"* ]]; then val="${val#\"}"; val="${val#*\"}"; val="${val# }"
    elif [[ "$val" == \'* ]]; then val="${val#\'}"; val="${val#*\'}"; val="${val# }"
    else val="${val#*[[:space:]]}"; fi
  done
  printf '%s\n' "$val"
}

# _resolve_shell_alias: resolve a shell alias to its expansion text.
# Uses `alias` builtin (via login shell for cross-shell compat).
# Prints the full alias expansion (everything after the '='), or empty if undefined.
_resolve_shell_alias() {
  local name="$1"
  ${SHELL:-bash} -ic "alias '$name' 2>/dev/null" 2>/dev/null \
    | sed -n "s/^${name}='\\(.*\\)'$/\\1/p"
}

# _resolve_tool_family: resolve any alias/function/binary to known tool family.
# Registry-driven: iterates [tool] sections from tool-registry.toml and matches
# by acp.binary / launch.direct.binary. No hardcoded tool names.
# Supports recursive aliases (alias → another alias → binary).
_resolve_tool_family() {
  local tool="$1"
  if _tool_is_registered "$tool"; then printf '%s\n' "$tool"; return 0; fi
  local expansion binary
  expansion=$(_resolve_type_expansion "$tool")
  if [[ -z "${expansion:-}" ]]; then
    local bin_output
    bin_output=$(${SHELL:-bash} -ic "type '$tool' 2>&1" 2>/dev/null) || true
    if echo "$bin_output" | grep -q ' is /'; then
      expansion=$(echo "$bin_output" | sed 's/.* is //')
    fi
  fi
  if [[ -n "${expansion:-}" ]]; then
    binary="$(_strip_env_prefix "$expansion")"
    binary="${binary%% *}"
    binary=$(basename "$binary" 2>/dev/null || echo "$binary")
    # Registry-driven: match binary name against every registered tool
    local _reg_tool
    for _reg_tool in $(_tool_registry_tools); do
      local _acp_bin _dir_bin
      _acp_bin="$(_tool_registry_get "$_reg_tool" "acp.binary" 2>/dev/null || true)"
      _dir_bin="$(_tool_registry_get "$_reg_tool" "launch.direct.binary" 2>/dev/null || true)"
      if [[ "$_acp_bin" == "$binary" || "$_dir_bin" == "$binary" ]]; then
        printf '%s\n' "$_reg_tool"; return 0
      fi
    done
    # Recursive: resolve binary itself through type, try again
    local rec_expansion rec_binary
    rec_expansion=$(_resolve_type_expansion "$binary")
    if [[ -n "${rec_expansion:-}" ]]; then
      rec_binary="$(_strip_env_prefix "$rec_expansion")"
      rec_binary="${rec_binary%% *}"
      rec_binary=$(basename "$rec_binary" 2>/dev/null || echo "$rec_binary")
      for _reg_tool in $(_tool_registry_tools); do
        local _acp_bin2 _dir_bin2
        _acp_bin2="$(_tool_registry_get "$_reg_tool" "acp.binary" 2>/dev/null || true)"
        _dir_bin2="$(_tool_registry_get "$_reg_tool" "launch.direct.binary" 2>/dev/null || true)"
        if [[ "$_acp_bin2" == "$rec_binary" || "$_dir_bin2" == "$rec_binary" ]]; then
          printf '%s\n' "$_reg_tool"; return 0
        fi
      done
    fi
  fi
  printf '%s\n' "$tool"
}

tool_uses_claude_session_id() {
