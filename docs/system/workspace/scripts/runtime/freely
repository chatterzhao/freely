retain_latest_global_restart_history() {
  local history_dir="$1" keep_count="${2:-20}" path total_count=0
  [[ -d "$history_dir" ]] || return 0
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    total_count=$((total_count + 1))
    if (( total_count > keep_count )); then
      rm -f "$path"
    fi
  done < <(find "$history_dir" -maxdepth 1 -type f -name '*.json' | sort -r)
}

