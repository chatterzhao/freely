# _write_chat_to_issue: write chat message to docs/B1-docs/ as new raw issue or comment
# If TARGET_ISSUE is set (via --issue flag), append as comment to that issue.
# Otherwise create a new raw issue.
_write_chat_to_issue() {
  local project="$1" intake_id="$2" author="$3" channel="$4" message="$5" session_refs="$6" created_at="$7"
  local target_issue chat_type issue_id db_path chat_id worktrees_root worktree_found conversation_id

  db_path=""$project/.freely/freely.db""
  target_issue="${FREELY_CHAT_TARGET_ISSUE:-}"
  conversation="${FREELY_CHAT_CONVERSATION:-}"
  new_conversation="${FREELY_CHAT_NEW_CONVERSATION:-}"

  if [[ "$conversation" == "true" ]]; then
    chat_type="chat-message"
    issue_id=""
    if [[ "$new_conversation" == "true" ]]; then
      conversation_id=0  # first message
    else
      # Check for active (unconsumed) conversation
      conversation_id=$(python3 "$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli" \
        --project "$project" chat.query-active-conversation 2>/dev/null || true)
      conversation_id="${conversation_id:-0}"
    fi
  elif [[ -n "$target_issue" ]]; then
    chat_type="comment"
    issue_id="$target_issue"
    conversation_id=0
  else
    log_error "[chat] Local raw issue creation is no longer supported."
    log_error "[chat] All raw issues must be created on a configured platform via 'freely feedback':"
    log_error "[chat]   freely feedback --title "fix|feat: <描述>" --kind fix --body "<详细描述>""
    log_error "[chat] Then create a worktree:"
    log_error "[chat]   freely wt-create --raw-key <returned-key> --source platform --kind fix --slug <slug>"
    return 1
  fi

  # Step 1: INSERT into freely.db chats table via daemon
  local cli="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli"
  chat_id=$(python3 "$cli" --project "$project" chat.add     --type "$chat_type"     --issue-id "${issue_id:-pending}"     --message "$message"     --author "$author"     --channel "$channel"     --session-refs "$session_refs"     --intake-id "$intake_id"     --conversation-id "$conversation_id" 2>/dev/null) || {
      log_error "failed to write chat to freely.db (daemon may be down, check db-daemon.log)"
      return 1
    }

  # For chat-message: if conversation_id was 0 (first message), the Python add_chat
  # already auto-updated conversation_id to the chat_id
  if [[ "$chat_type" == "chat-message" ]]; then
    if [[ "$conversation_id" -eq 0 ]]; then
      # Read back the auto-updated conversation_id
      conversation_id="$chat_id"
    fi
    issue_id="conv-$conversation_id"
  fi

  log_info "chat recorded: freely.db id=$chat_id type=$chat_type issue_id=$issue_id${conversation:+ conversation_id=$conversation_id}"


  # Step 2: Try direct sync if a worktree exists for this issue
  # Skip for chat-message — conversation messages need AI judgment before materialization
  worktrees_root="${project}-worktrees"
  if [[ "$chat_type" != "chat-message" && -d "$worktrees_root" ]]; then
    worktree_found=$(find "$worktrees_root" -maxdepth 1 -type d -name "*${issue_id}*" 2>/dev/null | head -1)
    if [[ -n "$worktree_found" && -d "$worktree_found/docs/B1-docs/$issue_id" ]]; then
      local cli="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli"
      python3 "$cli" --project "$project" chat.consume         --id "$chat_id" >/dev/null 2>&1         && log_info "chat comment synced directly to worktree: $worktree_found"
    fi
  fi

  # Step 3: No worktree found — signal daemon for later processing
  update_intake_pending_signal "$project"
}

# _check_issue_active_and_signal: if target issue is in dev-loop, update pending signal
_check_issue_active_and_signal() {
  local project="$1" target_issue="$2"
  local canonical_path phase
  canonical_path=""
  if [[ -f "$project/docs/B1-docs/$target_issue/issue.md" ]]; then
    canonical_path=$(sed -n 's/^canonical_issue_path: "\(.*\)"/\1/p' "$project/docs/B1-docs/$target_issue/issue.md" 2>/dev/null || :)
  fi
  if [[ -n "$canonical_path" && -f "$project/$canonical_path" ]]; then
    phase=$(sed -n 's/^- phase_state: `\([^`]*\)`/\1/p' "$project/$canonical_path" 2>/dev/null || :)
    case "$phase" in
      in_b2|in_b2_ibm|done_b2|done_b2_ibm|in_dev|blocked_dev|in_verification)
        log_info "target issue $target_issue is active ($phase), triggering urgent signal"
        update_intake_pending_signal "$project"
        ;;
    esac
  fi
}

# _route_chat_to_issue: determine which existing issue a chat message belongs to.
# Returns local_id if match found, empty string otherwise (→ create new raw issue).
# Script-based fast path: match keywords against open issue titles in ISSUES.md.
# AI fallback via chat-routing skill is deferred (adds token cost).
_route_chat_to_issue() {
  local project="$1" message="$2"
  local issues_index matched_id
  issues_index="$project/docs/B1-docs/ISSUES.md"

  [[ -f "$issues_index" ]] || { :; return 0; }

  # Script-based: extract significant words from message, match against issue titles
  local words
  words=$(echo "$message" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9-' '\n' | grep -v '^.$' | head -20)
  if [[ -z "$words" ]]; then
    :
    return 0
  fi

  # Search ISSUES.md for matching issue IDs where the title shares keywords
  matched_id=$(python3 -c "
import re, sys
msg = '''$message'''.lower()
# Extract potential issue references from message (raw-xxx, I-xxx, #number)
refs = re.findall(r'(?:raw-[\dTZ-]+|I-[\dTZ-]+[A-Za-z]*)', msg)
if refs:
    print(refs[0])
    sys.exit(0)

# Match against ISSUES.md: find issues whose title/ID shares words with message
try:
    with open('$issues_index') as f:
        index = f.read()
    # Look for issue IDs in the index
    ids = re.findall(r'local_id:\s*(\S+)', index)
    # Try exact ID match first
    for iid in ids:
        if iid.lower() in msg:
            print(iid)
            sys.exit(0)
except: pass
print('')
" 2>/dev/null)

  [[ -n "$matched_id" ]] && log_info "chat routed to existing issue: $matched_id"
  printf '%s\n' "$matched_id"
}

