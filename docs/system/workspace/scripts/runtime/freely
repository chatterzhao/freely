wait_for_daemon_supervisor_ready_or_fail() {
  local project="$1" launcher_pid="${2:-}" wait_secs="${3:-15}" started_at now supervisor_pid observed_supervisor_pid=""
  [[ "$wait_secs" =~ ^[0-9]+$ ]] || wait_secs=60
  started_at="$(date +%s)"
  while true; do
    supervisor_pid="$(manager_supervisor_pid_for_project "$project")"
    if [[ -n "$supervisor_pid" ]]; then
      observed_supervisor_pid="$supervisor_pid"
    fi
    if [[ -n "$observed_supervisor_pid" ]] && supervisor_startup_truth_ready_for_project "$project" "$observed_supervisor_pid"; then
      printf '%s\n' "$observed_supervisor_pid"
      return 0
    fi
    if [[ -n "$supervisor_pid" ]] && supervisor_startup_truth_ready_for_project "$project" "$supervisor_pid"; then
      printf '%s\n' "$supervisor_pid"
      return 0
    fi
    if [[ -n "$launcher_pid" ]] && ! kill -0 "$launcher_pid" 2>/dev/null && [[ -z "$observed_supervisor_pid" ]]; then
      break
    fi
    now="$(date +%s)"
    if (( now - started_at >= wait_secs )); then
      break
    fi
    sleep 0.2
  done
  return 1
}

launch_project_runtime_daemon_or_fail() {
  local project="$1" task_mode="${2:-}"
  local runtime_script launcher_log launcher_pid supervisor_pid wait_secs
  runtime_script="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely"
  wait_secs="${FREELY_DAEMON_READY_WAIT_SECS:-60}"
  [[ "$wait_secs" =~ ^[0-9]+$ ]] || wait_secs=60
  mkdir -p "$(logs_dir_for_project "$project")"
  launcher_log="$(logs_dir_for_project "$project")/daemon-launch.log"
  # Keep daemon-run in a separate session instead of a shell-owned background job.
  # We previously launched this with `nohup bash ... &`, which looked detached while
  # the caller shell stayed alive but still died when short-lived non-interactive
  # exec/PTY wrappers tore their session down. The daemon launcher must survive
  # after `freely daemon start` returns, so regressions here need a stronger guard
  # than ordinary shell job control.
  launcher_pid="$(
    python3 - "$project" "$runtime_script" "$launcher_log" "$task_mode" <<'PY'
import subprocess
import sys

project, runtime_script, launcher_log = sys.argv[1:4]
task_mode = sys.argv[4] if len(sys.argv) > 4 else ""
argv0 = f"runtime/freely daemon-run --project {project}"
cmd = [argv0, runtime_script, "daemon-run", "--project", project]
if task_mode:
    cmd.extend(["--task-mode", task_mode])
with open(launcher_log, "ab", buffering=0) as log_file:
    child = subprocess.Popen(
        cmd,
        executable="bash",
        cwd=project,
        stdin=subprocess.DEVNULL,
        stdout=log_file,
        stderr=subprocess.STDOUT,
        start_new_session=True,
        close_fds=True,
    )
print(child.pid)
PY
  )"
  if ! supervisor_pid="$(wait_for_daemon_supervisor_ready_or_fail "$project" "$launcher_pid" "$wait_secs")"; then
    log_error "daemon start did not materialize a live supervisor for project: $project"
    log_error "see: $launcher_log"
    if [[ -f "$launcher_log" ]]; then
      tail -n 20 "$launcher_log" >&2 || true
    fi
    exit 1
  fi
  echo "project: $project"
  echo "daemon_status: running"
  echo "supervisor_pid: $supervisor_pid"
  echo "launcher_log: $launcher_log"
}

cmd_daemon_start() {
  local project="" force="0" task_mode=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --task-mode) task_mode="${2:-}"; shift 2 ;;
      --force) force="1"; shift ;;
      --reason) reason="${2:-}"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done

  # --reason gate: --force bypass requires business justification
  # Placed BEFORE auto storm recovery so system auto-healing is not blocked
  if [[ "$force" == "1" && -z "${reason:-}" ]]; then
    cat >&2 <<'REASON_GATE'
[GATE] 检测到你试图违规绕过门禁: freely daemon start --force

  如果是因为实现没有达到门禁要求，请按要求去完成，而不是想着违规绕过。

  只有确实有合理的业务理由（守护进程状态损坏需强制重建等），才允许绕过。
  请按以下格式加上绕过理由:
    --reason "违规绕过门禁中，理由充分，是：<业务理由>"

  示例: freely daemon start --force --reason "违规绕过门禁中，理由充分，是：守护进程状态损坏导致无法正常调度，需强制重建运行时" --project /path/to/project
REASON_GATE
    exit 1
  fi

  project="$(resolve_project_or_fail "$project")"

  # Auto-detect platforms from git remotes and update FREELY_REPO_PLATFORMS in config.toml.
  # This field is auto-maintained by freely start / daemon start — do not edit manually.
  local _detected_platforms="" _found_gh=0 _found_gt=0
  while IFS= read -r _remote; do
    [[ -z "$_remote" || "$_remote" == "all" ]] && continue
    local _url; _url=$(git -C "$project" remote get-url "$_remote" 2>/dev/null || true)
    case "$_url" in
      *github.com*|*github-*|*github*) _found_gh=1 ;;
      *gitee.com*|*gitee-*|*gitee*)     _found_gt=1 ;;
    esac
  done < <(git -C "$project" remote 2>/dev/null)
  [[ "$_found_gh" == "1" ]] && _detected_platforms="$_detected_platforms,github"
  [[ "$_found_gt" == "1" ]] && _detected_platforms="$_detected_platforms,gitee"
  _detected_platforms="${_detected_platforms#,}"
  if [[ -n "$_detected_platforms" ]] && [[ "$_detected_platforms" != "${FREELY_REPO_PLATFORMS:-}" ]]; then
    upsert_config_key "$project" "FREELY_REPO_PLATFORMS" "$_detected_platforms"
    FREELY_REPO_PLATFORMS="$_detected_platforms"
  fi

  # Ensure DB daemon is running before write_task_mode writes to SQLite.
  # write_task_mode calls freely-db-cli which needs the DB daemon's Unix socket.
  ensure_freely_db "$project"
  if [[ -n "$task_mode" ]]; then
    write_task_mode "$project" "$task_mode"
  else
    write_task_mode "$project" "wait"
  fi
  startup_self_heal_machine_state_if_needed "$project" "daemon_start_command"
  acquire_project_start_lock_or_wait "$project" "freely_start" || exit 1
  trap "release_project_start_lock_for_runtime '$project'" EXIT
  append_lifecycle_trace "$project" "L001" "start_requested" \
    "entrypoint=daemon" \
    "force=$force" \
    "task_mode=${task_mode:-wait}" \
    "expected_next=L010"
  append_runtime_event "$project" "user_daemon_start_command_received" \
    "force=$force" \
    "task_mode=${task_mode:-default}"
  # Detect restart storm from previous run and auto-force clean start.
  if [[ "$force" != "1" ]]; then
    local _state_file _exit_reason _storm_count
    _state_file="$(workcell_state_file "$project")"
    if [[ -f "$_state_file" ]]; then
      unset LAST_EXIT_REASON LAST_RESTART_STORM_COUNT
      source "$_state_file" 2>/dev/null || true
      _exit_reason="${LAST_EXIT_REASON:-}"
      _storm_count="${LAST_RESTART_STORM_COUNT:-0}"
      if [[ "$_storm_count" =~ ^[0-9]+$ && "$_storm_count" -gt 0 ]] \
         || [[ "$_exit_reason" == "auth_or_rate_limit" ]]; then
        log_warn "detected prior restart storm (exit=$_exit_reason storm_count=$_storm_count); forcing clean daemon start"
        force="1"
      fi
    fi
  fi
  if [[ "$force" == "1" ]]; then
    log_info "forcing project-local runtime rebuild before daemon start"
    stop_project_runtime "$project" "daemon_start_force"
  else
    local run_dir sup_pid_file child_pid_file
    run_dir="$(run_dir_for_project "$project")"
    sup_pid_file="$run_dir/supervisor.pid"
    child_pid_file="$run_dir/ai.pid"
