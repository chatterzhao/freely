worker_prompt_targets_worktree() {
  local manager_project="$1" prompt_file="$2" target_worktree="$3"
  local resolved_worktree kind effective_target
  [[ -n "$target_worktree" ]] || return 1
  if [[ -d "$target_worktree" ]]; then
    target_worktree="$(normalize_runtime_worktree_path "$target_worktree")"
  fi
  kind="$(worker_prompt_normalized_intent_kind "$prompt_file")"
  case "$kind" in
    edit|cleanup|promotion) ;;
    *) return 1 ;;
  esac
  resolved_worktree="$(worker_prompt_resolved_worktree "$manager_project" "$prompt_file")"
  if [[ -n "$resolved_worktree" && "$resolved_worktree" == "$target_worktree" ]]; then
    return 0
  fi
  effective_target="$(worker_prompt_effective_intent_target "$manager_project" "$prompt_file")"
  [[ "$effective_target" == "$target_worktree" ]]
}

authoritative_worker_prompt_for_worktree_from_continuity() {
  local manager_project="$1" target_worktree="$2" continuity_file="$3"
  local prompt_file
  [[ -n "$target_worktree" && -d "$target_worktree" ]] || return 1
  [[ -n "$continuity_file" && -f "$continuity_file" ]] || return 1

  while IFS= read -r prompt_file; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
    worker_prompt_targets_worktree "$manager_project" "$prompt_file" "$target_worktree" || continue
    printf '%s\n' "$prompt_file"
    return 0
  done < <(latest_manager_worker_prompt_paths_from_continuity "$continuity_file")

  while IFS= read -r prompt_file; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
    worker_prompt_targets_worktree "$manager_project" "$prompt_file" "$target_worktree" || continue
    printf '%s\n' "$prompt_file"
    return 0
  done < <(latest_frozen_manager_worker_prompt_paths_from_continuity "$continuity_file")

  while IFS= read -r prompt_file; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
    worker_prompt_targets_worktree "$manager_project" "$prompt_file" "$target_worktree" || continue
    printf '%s\n' "$prompt_file"
    return 0
  done < <(latest_queued_manager_worker_prompt_paths_from_continuity "$continuity_file")

  return 1
}

worker_worktree_has_pending_non_cleanup_manager_prompt() {
  local manager_project="$1" target_worktree="$2" continuity_file="" prompt_file="" intent_kind="" route_kind="" target_branch=""
  [[ -n "$manager_project" && -n "$target_worktree" && -d "$target_worktree" ]] || return 1
  continuity_file="$(latest_generated_manager_continuity_file_for_project "$manager_project")"
  [[ -n "$continuity_file" && -f "$continuity_file" ]] || return 1
  prompt_file="$(authoritative_worker_prompt_for_worktree_from_continuity "$manager_project" "$target_worktree" "$continuity_file" || true)"
  [[ -n "$prompt_file" && -f "$prompt_file" ]] || return 1
  intent_kind="$(worker_prompt_normalized_intent_kind "$prompt_file")"
  route_kind="$(manager_continuity_resume_focus_route_kind "$continuity_file" || true)"
  if [[ "$route_kind" == "cleanup_governance" ]] && [[ "$intent_kind" == "edit" || "$intent_kind" == "promotion" ]]; then
    target_branch="$(worker_prompt_target_branch "$prompt_file")"
    if [[ -n "$target_branch" ]] && branch_is_merged_into_develop "$manager_project" "$target_branch"; then
      return 1
    fi
  fi
  [[ "$intent_kind" == "edit" || "$intent_kind" == "promotion" ]]
}

retire_ready_merged_worktree_can_reclaim_ownership() {
  local manager_project="$1" target_worktree="$2" branch="${3:-}" prompt_file=""
  [[ -n "$manager_project" && -n "$target_worktree" && -d "$target_worktree" ]] || return 1
  prompt_file="$(authoritative_worker_prompt_file_for_project "$target_worktree" || true)"
  if [[ -n "$prompt_file" && -f "$prompt_file" ]] \
    && [[ "$(worker_prompt_normalized_intent_kind "$prompt_file")" == "cleanup" ]] \
    && worker_prompt_has_verification_metadata "$prompt_file" \
    && worker_prompt_spans_external_cleanup_surfaces "$manager_project" "$prompt_file"; then
    return 1
  fi
  if worker_project_is_retire_ready_merged_followthrough "$manager_project" "$target_worktree" "$branch" "$prompt_file" || \
    worker_prompt_targets_retire_ready_merged_worktree "$manager_project" "$prompt_file"; then
    return 0
  fi
  return 1
}

status_intent_prompt_file_for_project() {
  local project="$1" prompt_file repo_root manager_project continuity_file
  prompt_file="$(find_latest_prompt_file_for_project "$project")"
  if [[ -n "$prompt_file" && -f "$prompt_file" ]]; then
    case "$(worker_prompt_normalized_intent_kind "$prompt_file")" in
      edit|cleanup|promotion)
        printf '%s\n' "$prompt_file"
        return 0
        ;;
    esac
  fi

  [[ "$(effective_runtime_role_for_project "$project")" == "worker" ]] || {
    printf '%s\n' "$prompt_file"
    return 0
  }

  repo_root="$(git -C "$project" rev-parse --show-toplevel 2>/dev/null || true)"
  manager_project="$(worktree_path_for_branch "$project" "develop")"
  if [[ -z "$manager_project" ]]; then
    manager_project="$repo_root"
  fi
  [[ -n "$manager_project" ]] || {
    printf '%s\n' "$prompt_file"
    return 0
  }
  continuity_file="$(latest_generated_manager_continuity_file_for_project "$manager_project")"
  if prompt_file="$(authoritative_worker_prompt_for_worktree_from_continuity "$manager_project" "$project" "$continuity_file")"; then
    printf '%s\n' "$prompt_file"
    return 0
  fi

  printf '%s\n' "$prompt_file"
}

