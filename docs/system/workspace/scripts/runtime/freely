      --tool-adapter-policy) tool_adapter_policy_arg="${2:-}"; shift 2 ;;
      --reasoning-effort) reasoning_effort="${2:-}"; shift 2 ;;
      --accept-default-autonomy) accept_default_autonomy="true"; shift ;;
      --force) force="true"; shift ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done

  [[ -n "$intent" && -n "$constitution" ]] || {
    usage
    exit 1
  }
  project="$(resolve_project_or_fail "$project" 1)"
  [[ -d "$project" ]] || { log_error "project not found: $project"; exit 1; }
  [[ -f "$intent" ]] || { log_error "intent file not found: $intent"; exit 1; }
  [[ -f "$constitution" ]] || { log_error "constitution file not found: $constitution"; exit 1; }
  ai_spec="$(resolve_ai_spec_for_project_or_global "$project" "$ai_spec")" || {
    log_error "missing --ai and no project/global default AI configured"
    log_error "set --ai explicitly, or define AI_TOOL/AI_MODEL/AI_MODE in $(global_config_file)"
    exit 1
  }

  local parsed tool model mode tool_adapter tool_adapter_policy tool_capabilities tool_policy
  local codex_capability_model codex_capability_sandbox codex_capability_approval_policy codex_capability_cwd_mode
  parsed="$(parse_ai_spec "$ai_spec")"
  IFS='|' read -r tool model mode <<<"$parsed"
  tool_adapter_policy="$(resolve_tool_adapter_policy_for_project_or_global "$project" "$tool" "$tool_adapter_policy_arg" "$tool_adapter_arg")"
  tool_adapter="$(resolve_tool_adapter_for_project_or_global "$project" "$tool" "$tool_adapter_arg" "$tool_adapter_policy")"
  tool_capabilities="$(tool_default_capabilities_for_runtime "$tool")"
  tool_policy="$(tool_default_policy_for_runtime "$tool")"
  codex_capability_model="$(codex_capability_default_model_for_runtime "$tool")"
  codex_capability_sandbox="$(codex_capability_default_sandbox_for_runtime "$tool")"
  codex_capability_approval_policy="$(codex_capability_default_approval_policy_for_runtime "$tool")"
  codex_capability_cwd_mode="$(codex_capability_default_cwd_mode_for_runtime "$tool")"
  if [[ "$tool" == "codex" ]]; then
    [[ -n "$model" ]] || model="gpt-5.4"
    [[ -n "$reasoning_effort" ]] || reasoning_effort="medium"
  elif [[ "$tool" == "cc" || "$tool" == "cc-use-codex-cli" ]]; then
    [[ -n "$reasoning_effort" ]] || reasoning_effort="medium"
  fi

  AI_TOOL="$tool"
  AI_MODE="$mode"
  AI_CAPABILITY_CODEX_SANDBOX="$codex_capability_sandbox"
  AI_CAPABILITY_CODEX_APPROVAL_POLICY="$codex_capability_approval_policy"
  AI_CAPABILITY_CODEX_CWD_MODE="$codex_capability_cwd_mode"
  require_default_autonomy_activation_consent "$project" "$accept_default_autonomy"

  ensure_project_agents_md "$project"
  ensure_install_lifecycle_allowlist_file "$project"
  ensure_repo_hooks_enabled_or_fail "$project"
  write_config "$project" "$intent" "$constitution" "$tool" "$model" "$mode" "$reasoning_effort" "$tool_adapter" "$tool_adapter_policy" "$tool_capabilities" "$tool_policy" "$codex_capability_model" "$codex_capability_sandbox" "$codex_capability_approval_policy" "$codex_capability_cwd_mode" "$force"
  record_default_autonomy_contract "$project" "$mode" "$FREELY_INIT_CONSENT_STATUS" "$FREELY_INIT_CONSENT_RECORDED_AT" "$FREELY_INIT_CONSENT_RECORDED_VIA"
  if tool_requires_project_codex_config "$tool" "$tool_capabilities"; then
    write_project_codex_config "$project" "$force" "$mode"
  fi
  load_config "$project"
  write_project_tool_wrapper_scripts "$project"
  write_project_tool_boundary_bootstrap_file "$project"
  register_project_in_registry "$project"
  rm -f "$(session_state_file "$project")" "$(handoff_file "$project")"
  write_workcell_state "$project" "stopped" "down" "down" "initialized"
  log_info "initialized: $(config_file "$project")"
  load_config "$project"
  echo "activation_consent_status: $(freely_activation_consent_status_for_loaded_config)"
  echo "activation_consent_recorded_at: $(format_timestamp_local_for_display "$(freely_activation_consent_recorded_at_for_loaded_config)")"
  echo "activation_consent_recorded_via: $(freely_activation_consent_recorded_via_for_loaded_config)"
  echo "autonomy_profile: ${FREELY_AUTONOMY_PROFILE:-$(freely_autonomy_profile_for_mode "${AI_MODE:-}")}"
  echo "interaction_posture: ${FREELY_INTERACTION_POSTURE:-$(freely_interaction_posture_for_mode "${AI_MODE:-}")}"
  echo "approval_posture: ${FREELY_APPROVAL_POSTURE:-$(freely_approval_posture_for_mode "${AI_MODE:-}")}"
  echo "safeguard_guidance_posture: $(freely_safeguard_guidance_posture_for_loaded_config)"
  echo "runtime_decision_posture: $(freely_runtime_decision_posture_for_loaded_config)"
  echo "minimal_risk_posture: $(freely_minimal_risk_posture_for_loaded_config)"
}

