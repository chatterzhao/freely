    [[ -n "$target_project" && -d "$target_project" ]] || return 1
    if csv_contains_exact_item "$launched_csv" "$prompt_file"; then
      if worker_project_is_actively_running "$target_project"; then
        continue
      fi
      return 1
    fi
    if worker_project_is_actively_running "$target_project" \
      && worker_project_busy_with_delegated_continuation "$target_project"; then
      saw_active_busy="1"
      continue
    fi
    return 1
  done < <(latest_manager_worker_prompt_paths_from_continuity "$continuity_file")
  [[ "$saw_active_busy" == "1" ]]
}

manager_continuity_is_launchable_for_project() {
  local project="$1" continuity_file="$2" prompt_file
  [[ -f "$continuity_file" ]] || return 1
  if manager_continuity_has_stale_runtime_worktree_refs "$project" "$continuity_file"; then
    return 1
  fi
  if ! manager_continuity_has_worker_prompts "$continuity_file"; then
    return 0
  fi
  while IFS= read -r prompt_file; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
    if worker_prompt_launchable_for_manager_project "$project" "$prompt_file"; then
      return 0
    fi
  done < <(latest_manager_worker_prompt_paths_from_continuity "$continuity_file")
  return 1
}

latest_launchable_manager_continuity_file_for_project() {
  local project="$1" continuity_file
  while IFS= read -r continuity_file; do
    [[ -f "$continuity_file" ]] || continue
    if manager_continuity_has_stale_runtime_worktree_refs "$project" "$continuity_file"; then
      continue
    fi
    if manager_continuity_is_launchable_for_project "$project" "$continuity_file"; then
      printf '%s\n' "$continuity_file"
      return 0
    fi
  done < <(find "$(run_dir_for_project "$project")" -maxdepth 1 -type f -name 'manager-continuity-*.md' | sort -r)
}

latest_manager_worker_prompt_csv_from_continuity() {
  local continuity_file="$1"
  local csv
  csv="$(latest_manager_worker_prompt_paths_from_continuity "$continuity_file" | paste -sd, -)"
  printf '%s\n' "${csv:-}"
}

manager_continuity_semantic_fingerprint() {
  local continuity_file="$1"
  [[ -f "$continuity_file" ]] || return 0
  awk '
    /^- timestamp: / { next }
    /^- timestamp_utc: / { next }
    /^- previous_manager_continuity: / { next }
    { print }
  ' "$continuity_file" | sed '/^[[:space:]]*$/d' | shasum -a 256 | awk '{print $1}'
}

manager_semantic_loop_repeat_state_for_project() {
  local project="$1" continuity_file latest_continuity latest_prompt_csv latest_consumed
  local continuity_prompt_csv repeat_count=0 active_running_workers max_parallel_workers
  local continuity_fingerprint latest_fingerprint="" oldest_repeat="" available_new_slots
  local threshold min_age oldest_mtime now desired_runtime_state="unknown"
  [[ "$(role_hint_for_project "$project")" == "manager" ]] || return 1
  if [[ -f "$(workcell_state_file "$project")" ]]; then
    # shellcheck disable=SC1090
    source "$(workcell_state_file "$project")"
    desired_runtime_state="${DESIRED_RUNTIME_STATE:-unknown}"
  fi
  [[ "$desired_runtime_state" != "stopped" ]] || return 1
  latest_continuity="$(latest_generated_manager_continuity_file_for_project "$project")"
  [[ -n "$latest_continuity" && -f "$latest_continuity" ]] || return 1
  if manager_continuity_has_stale_runtime_worktree_refs "$project" "$latest_continuity"; then
    return 1
  fi
  latest_prompt_csv="$(latest_manager_worker_prompt_csv_from_continuity "$latest_continuity")"
  [[ -n "$latest_prompt_csv" ]] || return 1
  manager_continuity_has_unconsumed_launchable_worker_prompt "$project" "$latest_continuity" || return 1
  active_running_workers="$(count_active_running_workers_for_manager_project "$project" 2>/dev/null || true)"
  [[ "$active_running_workers" =~ ^[0-9]+$ ]] || active_running_workers="0"
  (( active_running_workers == 0 )) || return 1
  available_new_slots="$(manager_worker_launch_available_slots "$project" 2>/dev/null || true)"
  if [[ "$available_new_slots" =~ ^[0-9]+$ ]]; then
    (( available_new_slots > 0 )) || return 1
  fi
  max_parallel_workers="$(manager_max_parallel_workers)"
  if [[ "$max_parallel_workers" != "unbounded" ]]; then
    [[ "$max_parallel_workers" =~ ^[0-9]+$ ]] || return 1
    (( max_parallel_workers > active_running_workers )) || return 1
  fi
  latest_consumed="unavailable"
  if [[ -f "$(manager_worker_launch_state_file "$project")" ]]; then
    # shellcheck disable=SC1090
    source "$(manager_worker_launch_state_file "$project")"
    latest_consumed="${LAST_MANAGER_CONTINUITY_CONSUMED:-unavailable}"
  fi
  [[ -n "$latest_consumed" && "$latest_consumed" != "unavailable" && "$latest_consumed" != "$latest_continuity" ]] || return 1
  latest_fingerprint="$(manager_continuity_semantic_fingerprint "$latest_continuity")"
  [[ -n "$latest_fingerprint" ]] || return 1
  while IFS= read -r continuity_file; do
    [[ -f "$continuity_file" ]] || continue
    if manager_continuity_has_stale_runtime_worktree_refs "$project" "$continuity_file"; then
      continue
    fi
    continuity_prompt_csv="$(latest_manager_worker_prompt_csv_from_continuity "$continuity_file")"
    [[ -n "$continuity_prompt_csv" && "$continuity_prompt_csv" == "$latest_prompt_csv" ]] || break
    manager_continuity_has_unconsumed_launchable_worker_prompt "$project" "$continuity_file" || break
    continuity_fingerprint="$(manager_continuity_semantic_fingerprint "$continuity_file")"
    [[ "$continuity_fingerprint" == "$latest_fingerprint" ]] || break
    repeat_count=$((repeat_count + 1))
    oldest_repeat="$continuity_file"
  done < <(find "$(run_dir_for_project "$project")" -maxdepth 1 -type f -name 'manager-continuity-*.md' | sort -r)
  threshold="${MANAGER_SEMANTIC_LOOP_REPEAT_THRESHOLD:-3}"
  [[ "$threshold" =~ ^[0-9]+$ ]] || return 1
  (( repeat_count >= threshold )) || return 1
  [[ -n "$oldest_repeat" ]] || return 1
  oldest_mtime="$(file_mtime_epoch "$oldest_repeat" 2>/dev/null || true)"
  [[ -n "$oldest_mtime" ]] || return 1
  now="$(date +%s)"
  min_age="${MANAGER_SEMANTIC_LOOP_MIN_AGE_SECS:-120}"
  [[ "$min_age" =~ ^[0-9]+$ ]] || return 1
  (( now - oldest_mtime >= min_age )) || return 1
  printf '%s|%s|%s|%s|%s\n' "$repeat_count" "$latest_continuity" "$latest_consumed" "$latest_prompt_csv" "$oldest_repeat"
}

manager_semantic_loop_signal_snapshot_for_project() {
  local project="$1" repeat_count latest_continuity latest_consumed latest_prompt_csv oldest_repeat
  IFS='|' read -r repeat_count latest_continuity latest_consumed latest_prompt_csv oldest_repeat \
    <<<"$(manager_semantic_loop_repeat_state_for_project "$project" 2>/dev/null || true)"
  [[ "$repeat_count" =~ ^[0-9]+$ ]] || return 1
  printf 'manager_continuity_rewrite_without_state_advance|%s|%s|%s|%s|%s\n' \
    "$repeat_count" \
    "$latest_continuity" \
    "$latest_consumed" \
    "$latest_prompt_csv" \
    "$oldest_repeat"
}

manager_continuity_explicitly_freezes_worker_project() {
  local manager_project="$1" target_project="$2" continuity_file="${3:-}" prompt_file resolved_worktree
  [[ -n "$target_project" && -d "$target_project" ]] || return 1
  [[ -n "$continuity_file" && -f "$continuity_file" ]] || return 1
  while IFS= read -r prompt_file; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
    resolved_worktree="$(worker_prompt_resolved_worktree "$manager_project" "$prompt_file")"
    [[ -n "$resolved_worktree" && "$resolved_worktree" == "$target_project" ]] || continue
    return 0
  done < <(latest_frozen_manager_worker_prompt_paths_from_continuity "$continuity_file")
  return 1
}

worker_prompt_target_worktree() {
  local prompt_file="$1"
  [[ -f "$prompt_file" ]] || return 0
  awk '
    /^You are the [^`]*worker for `/ && / in `\// {
      value=$0
      sub(/^You are the [^`]*worker for `/, "", value)
      split(value, parts, "` in `")
      value=parts[2]
      sub(/`\.$/, "", value)
      sub(/`$/, "", value)
      print value
      exit
    }
    /^你的 worktree：$/ { capture=1; next }
    /^Worktree:$/ { capture=1; next }
    capture && /^- / {
      sub(/^- /, "", $0)
      gsub(/`/, "", $0)
      print
      exit
    }
  ' "$prompt_file"
}

worker_prompt_dispatch_metadata_value() {
  local prompt_file="$1" key="$2"
  [[ -f "$prompt_file" && -n "$key" ]] || return 0
  awk -v desired_key="$key" '
    function trim(value) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      gsub(/`/, "", value)
      return value
    }
    {
      line=$0
      gsub(/^[[:space:]]*-[[:space:]]*/, "", line)
      if (line ~ /^[[:space:]]*$/) next
      split(line, parts, ":")
      if (length(parts) < 2) next
      key_part=trim(parts[1])
      gsub(/[[:space:]-]/, "_", key_part)
      if (tolower(key_part) != tolower(desired_key)) next
      sub(/^[^:]+:[[:space:]]*/, "", line)
      print trim(line)
      exit
    }
  ' "$prompt_file"
}

worker_prompt_dispatch_priority() {
  local prompt_file="$1" value
  value="$(worker_prompt_dispatch_metadata_value "$prompt_file" "dispatch_priority")"
  if [[ -z "$value" ]]; then
    value="$(worker_prompt_dispatch_metadata_value "$prompt_file" "priority")"
  fi
  value="$(printf '%s' "$value" | tr '[:lower:]' '[:upper:]')"
  case "$value" in
    P0) printf '0\n' ;;
    P1) printf '1\n' ;;
    P2) printf '2\n' ;;
    P3) printf '3\n' ;;
    P4) printf '4\n' ;;
    *) printf '5\n' ;;
  esac
}

worker_prompt_parallel_safe() {
  local prompt_file="$1" value
  value="$(worker_prompt_dispatch_metadata_value "$prompt_file" "parallel_safe")"
  value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
  case "$value" in
    false|no|0) printf 'false\n' ;;
    *) printf 'true\n' ;;
  esac
}

worker_prompt_write_scope() {
  local manager_project="$1" prompt_file="$2"
  local value resolved_worktree
  value="$(worker_prompt_dispatch_metadata_value "$prompt_file" "write_scope")"
  if [[ -n "$value" ]]; then
    printf '%s\n' "$value"
    return 0
  fi
  resolved_worktree="$(worker_prompt_resolved_worktree "$manager_project" "$prompt_file")"
  printf '%s\n' "${resolved_worktree:-$prompt_file}"
}

worker_prompt_intent_kind() {
  local prompt_file="$1" value
  value="$(worker_prompt_dispatch_metadata_value "$prompt_file" "intent_kind")"
  value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
  printf '%s\n' "$value"
}

worker_prompt_intent_target() {
  local manager_project="$1" prompt_file="$2"
  local value
  value="$(worker_prompt_dispatch_metadata_value "$prompt_file" "intent_target")"
  if [[ -n "$value" ]]; then
    printf '%s\n' "$value"
    return 0
  fi
  printf '%s\n' "$(worker_prompt_resolved_worktree "$manager_project" "$prompt_file")"
}

worker_prompt_normalized_intent_kind() {
  local prompt_file="$1" value
  value="$(worker_prompt_intent_kind "$prompt_file")"
  case "$value" in
    edit|cleanup|promotion) printf '%s\n' "$value" ;;
    *) printf 'unknown\n' ;;
  esac
}

worker_prompt_effective_intent_target() {
  local manager_project="$1" prompt_file="$2"
  local kind value integration_target resolved_worktree
  kind="$(worker_prompt_normalized_intent_kind "$prompt_file")"
  value="$(worker_prompt_intent_target "$manager_project" "$prompt_file")"
  resolved_worktree="$(worker_prompt_resolved_worktree "$manager_project" "$prompt_file")"
  case "$kind" in
    edit|cleanup)
      if [[ -n "$resolved_worktree" ]]; then
        printf '%s\n' "$resolved_worktree"
      elif [[ -n "$value" && "$value" != "$prompt_file" ]]; then
        printf '%s\n' "$value"
      else
        printf 'none\n'
      fi
      ;;
    promotion)
      if [[ -n "$value" && "$value" != "$prompt_file" ]]; then
        printf '%s\n' "$value"
      else
        integration_target="$(worker_prompt_dispatch_metadata_value "$prompt_file" "integration_target")"
        [[ -n "$integration_target" ]] || integration_target="develop"
        printf 'unknown -> %s\n' "$integration_target"
      fi
      ;;
    *)
      printf 'none\n'
      ;;
  esac
}

worker_prompt_blocking_intent_signature() {
  local manager_project="$1" prompt_file="$2"
  local kind target
  kind="$(worker_prompt_normalized_intent_kind "$prompt_file")"
  case "$kind" in
    edit|cleanup|promotion) ;;
    *)
      printf '\n'
      return 0
      ;;
  esac
  target="$(worker_prompt_effective_intent_target "$manager_project" "$prompt_file")"
  [[ -n "$target" && "$target" != "none" ]] || {
    printf '\n'
    return 0
  }
  printf '%s@%s\n' "$kind" "$target"
}

project_current_blocking_intent_signature() {
  local project="$1" prompt_file
  prompt_file="$(latest_prompt_file_for_project "$project")"
  [[ -n "$prompt_file" && -f "$prompt_file" ]] || {
    printf '\n'
    return 0
  }
  worker_prompt_blocking_intent_signature "$project" "$prompt_file"
}

worker_prompt_targets_worktree() {
  local manager_project="$1" prompt_file="$2" target_worktree="$3"
  local resolved_worktree kind effective_target
  [[ -n "$target_worktree" ]] || return 1
  kind="$(worker_prompt_normalized_intent_kind "$prompt_file")"
  case "$kind" in
    edit|cleanup|promotion) ;;
    *) return 1 ;;
  esac
  resolved_worktree="$(worker_prompt_resolved_worktree "$manager_project" "$prompt_file")"
  if [[ -n "$resolved_worktree" && "$resolved_worktree" == "$target_worktree" ]]; then
    return 0
  fi
  effective_target="$(worker_prompt_effective_intent_target "$manager_project" "$prompt_file")"
  [[ "$effective_target" == "$target_worktree" ]]
}

manager_active_blocking_intent_signatures_csv() {
  local project="$1" exclude_project="${2:-}"
