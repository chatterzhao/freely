  pid_file="$(interruption_dispatcher_pid_file "$project")"
  if [[ -f "$pid_file" ]]; then
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    if valid_interruption_dispatcher_pid_for_project "$project" "$pid"; then
      printf '%s\n' "$pid"
      return 0
    fi
  fi
}

