delegated_continuation_snapshot_for_project() {
  local project="$1" limit="${2:-3}"
  local intake_root item_dir meta_file message_file resolution_file status absorption_target delegated_worktree message summary count project_real delegated_real session_refs active_consumed_ids intake_id
  intake_root="$(intake_dir_for_project "$project")"
  [[ -d "$intake_root" ]] || return 0
  project_real="$(cd "$project" && pwd -P)"
  active_consumed_ids="$(active_prompt_consumed_delegation_ids_for_project "$project")"
  count=0
  while IFS= read -r item_dir; do
    meta_file="$item_dir/meta.env"
    message_file="$item_dir/message.txt"
    [[ -f "$meta_file" && -f "$message_file" ]] || continue
    status="$(meta_env_value "$meta_file" "STATUS")"
    absorption_target="$(meta_env_value "$meta_file" "ABSORPTION_TARGET")"
    delegated_worktree="$(meta_env_value "$meta_file" "DELEGATED_WORKTREE")"
    session_refs="$(meta_env_value "$meta_file" "SESSION_REFS")"
    [[ "$status" == "delegated" ]] || continue
    [[ "$absorption_target" == "handoff://continuation" ]] || continue
    delegated_real=""
    if [[ -n "$delegated_worktree" ]]; then
      delegated_real="$(cd "$delegated_worktree" 2>/dev/null && pwd -P || true)"
    fi
    if [[ -n "$delegated_real" && "$delegated_real" != "$project_real" ]]; then
      continue
    fi
    intake_id="$(basename "$item_dir")"
    if [[ -n "$active_consumed_ids" ]] && csv_contains_exact_item "$active_consumed_ids" "$intake_id"; then
      continue
    fi
    message="$(tr '\n' ' ' <"$message_file" | sed 's/  */ /g')"
    printf -- '- intake_id=%s message=%s\n' "$intake_id" "$message"
    if [[ -n "$session_refs" && "$session_refs" != "[]" ]]; then
      printf '  session_refs=%s\n' "$session_refs"
    fi
    resolution_file="$(meta_env_value "$meta_file" "RESOLUTION_ARTIFACT")"
    if [[ -n "$resolution_file" && -f "$resolution_file" ]]; then
      summary="$(tr '\n' ' ' <"$resolution_file" | sed 's/  */ /g')"
      printf '  resolution=%s\n' "$summary"
    fi
    count=$((count + 1))
    if (( count >= limit )); then
      break
    fi
  done < <(find "$intake_root" -mindepth 1 -maxdepth 1 -type d | sort -r)
}

