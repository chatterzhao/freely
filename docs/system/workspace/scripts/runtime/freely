csv_contains_exact_item() {
  local csv="$1" needle="$2"
  [[ -n "$csv" && -n "$needle" ]] || return 1
  local item
  IFS=',' read -r -a __csv_items <<<"$csv"
  for item in "${__csv_items[@]}"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

csv_append_unique_item() {
  local csv="$1" needle="$2"
  if csv_contains_exact_item "$csv" "$needle"; then
    printf '%s\n' "$csv"
  elif [[ -n "$csv" ]]; then
    printf '%s,%s\n' "$csv" "$needle"
  else
    printf '%s\n' "$needle"
  fi
}

csv_remove_exact_item() {
  local csv="$1" needle="$2" item result=""
  [[ -n "$csv" && -n "$needle" ]] || {
    printf '%s\n' "$csv"
    return 0
  }
  IFS=',' read -r -a __csv_remove_items <<<"$csv"
  for item in "${__csv_remove_items[@]}"; do
    [[ -n "$item" && "$item" == "$needle" ]] && continue
    if [[ -n "$item" ]]; then
      result="$(csv_append_unique_item "$result" "$item")"
    fi
  done
  printf '%s\n' "$result"
}

csv_retain_exact_items() {
  local csv="$1" allowed_csv="$2" item result=""
  [[ -n "$csv" && -n "$allowed_csv" ]] || {
    printf '\n'
    return 0
  }
  IFS=',' read -r -a __csv_retain_items <<<"$csv"
  for item in "${__csv_retain_items[@]}"; do
    [[ -n "$item" ]] || continue
    csv_contains_exact_item "$allowed_csv" "$item" || continue
    result="$(csv_append_unique_item "$result" "$item")"
  done
  printf '%s\n' "$result"
}

manager_worker_launch_state_reconcile_same_continuity_prompts() {
  local project="$1" continuity_file="$2"
  local state_file prompt_generated_csv launched_csv normalized_launched_csv queued_csv max_parallel_workers active_running_workers available_new_slots queued_prompt_blockers
  state_file="$(manager_worker_launch_state_file "$project")"
  [[ -f "$state_file" && -n "$continuity_file" && -f "$continuity_file" ]] || return 1
  # shellcheck disable=SC1090
  source "$state_file"
  [[ -n "${LAST_MANAGER_CONTINUITY_CONSUMED:-}" && "${LAST_MANAGER_CONTINUITY_CONSUMED:-}" == "$continuity_file" ]] || return 1

  prompt_generated_csv="$(latest_manager_worker_prompt_csv_from_continuity "$continuity_file")"
  launched_csv="${LAST_MANAGER_WORKER_PROMPTS_CONSUMED:-${LAUNCHED_WORKER_PROMPTS:-}}"
  normalized_launched_csv="$(csv_retain_exact_items "$launched_csv" "$prompt_generated_csv")"

  if [[ "$normalized_launched_csv" != "$launched_csv" || "${LAST_MANAGER_WORKER_PROMPTS_GENERATED:-}" != "$prompt_generated_csv" ]]; then
    queued_csv="${QUEUED_WORKER_PROMPTS:-}"
    queued_prompt_blockers="${QUEUED_WORKER_PROMPT_BLOCKERS:-}"
    max_parallel_workers="${MAX_PARALLEL_WORKERS:-}"
    active_running_workers="${ACTIVE_RUNNING_WORKER_COUNT:-}"
    available_new_slots="${AVAILABLE_NEW_WORKER_SLOTS:-}"
    write_manager_worker_launch_state \
      "$project" \
      "${LAST_MANAGER_CONTINUITY_GENERATED:-$continuity_file}" \
      "$prompt_generated_csv" \
      "${LAST_MANAGER_CONTINUITY_CONSUMED:-$continuity_file}" \
      "$normalized_launched_csv" \
      "$queued_csv" \
      "$max_parallel_workers" \
      "$active_running_workers" \
      "$available_new_slots" \
      "$queued_prompt_blockers"
  fi

  printf '%s\n' "$normalized_launched_csv"
}

manager_worker_launch_state_refresh_for_status() {
  local project="$1" continuity_file="" state_file
  local max_parallel_workers active_running_workers available_new_slots
  local generated_continuity generated_prompts consumed_continuity consumed_prompts queued_prompts queued_prompt_blockers
  state_file="$(manager_worker_launch_state_file "$project")"
  [[ -n "$project" && -f "$state_file" ]] || return 0
  continuity_file="$(latest_generated_manager_continuity_file_for_project "$project")"
  [[ -n "$continuity_file" && -f "$continuity_file" ]] || return 0
  manager_worker_launch_state_reconcile_same_continuity_prompts "$project" "$continuity_file" >/dev/null 2>&1 || true

  # Refresh runtime capacity truth on read so live-status reflects running worker lanes
  # even when the latest continuity did not itself enqueue or consume a prompt.
  # shellcheck disable=SC1090
  source "$state_file"
  generated_continuity="${LAST_MANAGER_CONTINUITY_GENERATED:-$continuity_file}"
  generated_prompts="${LAST_MANAGER_WORKER_PROMPTS_GENERATED:-}"
  consumed_continuity="${LAST_MANAGER_CONTINUITY_CONSUMED:-$continuity_file}"
  consumed_prompts="${LAST_MANAGER_WORKER_PROMPTS_CONSUMED:-${LAUNCHED_WORKER_PROMPTS:-}}"
  queued_prompts="${QUEUED_WORKER_PROMPTS:-}"
  queued_prompt_blockers="${QUEUED_WORKER_PROMPT_BLOCKERS:-}"
  max_parallel_workers="$(manager_max_parallel_workers)"
  active_running_workers="$(count_active_running_workers_for_manager_project "$project")"
  if [[ "$max_parallel_workers" == "unbounded" ]]; then
    available_new_slots="unbounded"
  else
    if ! [[ "$active_running_workers" =~ ^[0-9]+$ ]]; then
      active_running_workers="0"
    fi
    if (( active_running_workers >= max_parallel_workers )); then
      available_new_slots="0"
    else
      available_new_slots="$((max_parallel_workers - active_running_workers))"
    fi
  fi

  if [[ "${MAX_PARALLEL_WORKERS:-}" != "$max_parallel_workers" \
    || "${ACTIVE_RUNNING_WORKER_COUNT:-}" != "$active_running_workers" \
    || "${AVAILABLE_NEW_WORKER_SLOTS:-}" != "$available_new_slots" ]]; then
    write_manager_worker_launch_state \
      "$project" \
      "$generated_continuity" \
      "$generated_prompts" \
      "$consumed_continuity" \
      "$consumed_prompts" \
      "$queued_prompts" \
      "$max_parallel_workers" \
      "$active_running_workers" \
      "$available_new_slots" \
      "$queued_prompt_blockers"
  fi
}

