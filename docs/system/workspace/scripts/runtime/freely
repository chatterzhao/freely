# _persist_session_anchor_early: write session ID to disk immediately
# so SIGTERM-killed sessions can be resumed on next launch.
_persist_session_anchor_early() {
  local project="$1" tool="$2"
  if tool_uses_claude_session_id "$tool" && [[ -n "${TOOL_SESSION_ID_CURRENT:-}" ]]; then
    local state_file
    state_file="$(session_state_file "$project")"
    mkdir -p "$(dirname "$state_file")"
    # SESSION_PARENT_ID: for fresh = own ID (self-rooted), for fork = parent's ID.
    # This is immutable once set — resume does NOT change it.
    if [[ -z "${SESSION_PARENT_ID:-}" ]]; then
      SESSION_PARENT_ID="${TOOL_SESSION_ID_CURRENT:-}"
    fi
    # For fork: LAST_TOOL_RESUME_TARGET must be the PARENT UUID so the launch
    # passes --resume <parent>. After fork completes, subsequent resumes use own ID.
    local anchor_resume_target
    if [[ "${mode_name:-}" == "fork" ]]; then
      anchor_resume_target="${SESSION_PARENT_ID:-${TOOL_SESSION_ID_CURRENT:-}}"
    else
      anchor_resume_target="${TOOL_SESSION_ID_CURRENT:-}"
    fi
    # Append anchor fields without destroying other session state.
    # _persist_session_anchor_early runs every cycle, BEFORE the full state
    # write. Using cat > would truncate the 40+ field file down to 4 fields,
    # losing FRESH_LAUNCH_COUNT_CURRENT, RESUME_STREAK_CURRENT, etc.
    # Instead, write only the anchor fields to a temp file and merge.
    local anchor_tmp
    anchor_tmp="$(mktemp "${state_file}.anchor.XXXXXX")"
    cat >"$anchor_tmp" <<STATEEOF
LAST_TOOL_RESUME_TARGET="${anchor_resume_target}"
LAST_LAUNCH_KIND="${mode_name:-resume}"
SESSION_PARENT_ID="${SESSION_PARENT_ID:-}"
STATEEOF
    # Merge: read existing file, update anchor fields, write back.
    # If state file doesn't exist yet (first ever launch), just use the anchor.
    if [[ -f "$state_file" ]]; then
      local existing_anchor
      while IFS='=' read -r key value; do
        [[ -z "$key" || "$key" =~ ^[[:space:]]*# ]] && continue
        # Don't overwrite anchor fields — those are authoritative from this function.
        case "$key" in
          LAST_TOOL_RESUME_TARGET|LAST_LAUNCH_KIND|SESSION_PARENT_ID|FORCE_FRESH) ;;
          *) printf '%s=%s\n' "$key" "$value" >> "$anchor_tmp" ;;
        esac
      done < "$state_file"
    fi
    mv "$anchor_tmp" "$state_file"
    log_info "session anchor persisted early: ${TOOL_SESSION_ID_CURRENT}"
  fi

  # ── agent_working: register this agent's session ──
  # Every ACP session creation (new/fork/resume) writes to agent_working
  # so the table is the universal session registry for recovery.
  # Manager uses hardcoded raw_key "__manager__" (no raw issue to bind to).
  local _aw_role _aw_key _aw_agent_id
  _aw_role="$(effective_runtime_role_for_project "$project")"
  if [[ "$_aw_role" == "manager" ]]; then
    _aw_key="__manager__"
    _aw_agent_id="manager_01"
  else
    # Worker/reviewer: raw_key comes from the worktree's issue binding.
    # _handle_needs_worker/reviewer in watchdog_sse.py handles the initial
    # session/fork agent_assign; this call updates with current session_id.
    return 0
  fi
  # UPSERT: creates __manager__ row on first call, updates session_id on subsequent calls
  python3 -c "
import sys; sys.path.insert(0, '${project}/docs/system/workspace/scripts/runtime')
from agent_working import acp_session_register
acp_session_register('${project}', '${_aw_key}', '${_aw_role}', '${_aw_agent_id}',
                     session_id='${TOOL_SESSION_ID_CURRENT:-}',
                     slot='${AGENT_AI_TOOL:-}',
                     worktree='${project}', branch='develop')
" 2>/dev/null || true
}

# _tool_session_dir: return the session directory for a given tool family.
# Registry-driven: reads [tool].session.directory_template and expands
# {slug}, {project}, and shell variables like ${HOME}.
_tool_session_dir() {
  local resolved_tool="$1" project="$2"
  local _template
  _template="$(_tool_registry_get "$resolved_tool" "session.directory_template" 2>/dev/null || true)"
  [[ -n "$_template" ]] || return 1
  # Expand {slug}: absolute path with '/' → '-'
  local _slug; _slug=$(printf '%s' "$project" | sed 's|/|-|g')
  _template="${_template//\{slug\}/$_slug}"
  _template="${_template//\{project\}/$project}"
  # Expand shell variables: ${HOME}, ${CODEX_HOME:-$HOME/.codex}, etc.
  _template=$(eval echo "$_template" 2>/dev/null || true)
  printf '%s\n' "$_template"
}

# _find_recent_session_from_tool_dir: fallback when session-state.env has no valid ID.
# Scans the tool-specific session directory for the most recent JSONL file.
_find_recent_session_from_tool_dir() {
  local project="$1" tool="$2"
  local resolved_tool session_dir
  resolved_tool="$(_resolve_tool_family "$tool")"
  session_dir="$(_tool_session_dir "$resolved_tool" "$project" 2>/dev/null || true)"
  [[ -n "$session_dir" && -d "$session_dir" ]] || return 1

  local latest_jsonl session_id
  latest_jsonl=$(find "$session_dir" -name "*.jsonl" -type f 2>/dev/null | sort | tail -1)
  [[ -n "$latest_jsonl" && -f "$latest_jsonl" ]] || return 1

  session_id=$(basename "$latest_jsonl" .jsonl)
  # Different tools have different ID formats; accept any non-empty basename.
  [[ -n "$session_id" ]] || return 1
  printf '%s\n' "$session_id"
  return 0
}

ensure_runtime_tool_session_anchor() {
  local tool="$1" launch_kind="$2" project="${3:-}"
  if tool_uses_claude_session_id "$tool"; then
    local current_verified="0"
    if ! is_valid_uuid "${TOOL_SESSION_ID_CURRENT:-}"; then
      TOOL_SESSION_ID_CURRENT=""
    fi
    if ! is_valid_uuid "${TOOL_SESSION_ID_PREVIOUS:-}"; then
      TOOL_SESSION_ID_PREVIOUS=""
    fi
    # Fallback: if state file lost the session ID.
    # ACP mode: use session-store (SQLite), NOT tool directory scan.
    # Non-ACP mode: scan the tool's session dir for JSONL files.
    if [[ -z "${TOOL_SESSION_ID_CURRENT:-}" ]]; then
      if [[ "${AGENT_AI_TOOL_ADAPTER:-direct}" == "acp" ]]; then
        local _acp_sid
        _acp_sid=$(python3 "$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli" \
          --project "$project" session.get-active \
          --project "$project" \
          --role "${FREELY_ROLE_HINT:-manager}" 2>>"$project/.freely/run/db-daemon.log" || log_warn "session-store query failed")
        if [[ -n "$_acp_sid" ]] && is_valid_uuid "$_acp_sid"; then
          TOOL_SESSION_ID_CURRENT="$_acp_sid"
          log_info "session id recovered from session-store: $_acp_sid"
        fi
      else
        local fallback_id
        fallback_id="$(_find_recent_session_from_tool_dir "$project" "$tool" || true)"
        if [[ -n "$fallback_id" ]]; then
          TOOL_SESSION_ID_CURRENT="$fallback_id"
          log_info "session id recovered from tool directory: $fallback_id"
        fi
      fi
    fi
    # Resume evidence: ACP mode checks session-store (SQLite); non-ACP checks JSONL.
    if [[ "${AGENT_AI_TOOL_ADAPTER:-direct}" == "acp" ]]; then
      local _acp_evidence_sid
      _acp_evidence_sid=$(python3 "$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli" \
        --project "$project" session.get-active \
        --project "$project" \
        --role "${FREELY_ROLE_HINT:-manager}" 2>>"$project/.freely/run/db-daemon.log" || log_warn "session-store query failed")
      if [[ -n "$_acp_evidence_sid" ]] && is_valid_uuid "$_acp_evidence_sid"; then
        current_verified="1"
      fi
    elif claude_has_verified_resume_evidence "$project" "${TOOL_SESSION_ID_CURRENT:-}"; then
      current_verified="1"
    fi
    # Enforcement: if AI_RESUME_ON_START or AI_RESUME_ON_RESTART require resume,
    # and we cannot find ANY valid session ID after all fallbacks, this is a hard
    # error. Falling back to fresh would waste tokens re-sending the full prompt.
    # ACP mode: session-store is the authoritative evidence source; JSONL is irrelevant.
    local resume_required="false"
    if [[ "${AI_RESUME_ON_RESTART:-false}" == "true" || "${AI_RESUME_ON_START:-false}" == "true" ]]; then
      resume_required="true"
    fi
    if [[ "$resume_required" == "true" && "$launch_kind" == "resume" ]]; then
      if [[ -z "${TOOL_SESSION_ID_CURRENT:-}" ]]; then
        log_error "AI_RESUME_ON_START/RESTART=true but no valid session ID found. Cannot resume."
        log_error "To force a fresh session: freely new-session --project $project && freely daemon start --project $project"
        exit 1
      fi
      if [[ "$current_verified" != "1" ]]; then
        if [[ "${AGENT_AI_TOOL_ADAPTER:-direct}" != "acp" ]]; then
          log_error "AI_RESUME_ON_START/RESTART=true but session ${TOOL_SESSION_ID_CURRENT} has no verifiable JSONL evidence. Cannot resume."
        else
          log_error "AI_RESUME_ON_START/RESTART=true but no active session in session-store for ${TOOL_SESSION_ID_CURRENT}. Cannot resume."
        fi
        log_error "To force a fresh session: freely new-session --project $project && freely daemon start --project $project"
        exit 1
      fi
    fi

    # Generate new UUID for fresh/fork launches; resume keeps the existing ID.
    if [[ "$launch_kind" == "fresh" || "$launch_kind" == "fresh_with_handoff" ]]; then
      TOOL_SESSION_ID_PREVIOUS="${TOOL_SESSION_ID_CURRENT:-}"
      TOOL_SESSION_ID_CURRENT="$(generate_uuid_for_runtime)"
    elif [[ "$launch_kind" == "fork" ]]; then
      # Fork: generate new child UUID, parent stays as SESSION_PARENT_ID.
      # The parent's JSONL is NOT modified — child writes to its own file.
      TOOL_SESSION_ID_PREVIOUS="${TOOL_SESSION_ID_CURRENT:-}"
      TOOL_SESSION_ID_CURRENT="$(generate_uuid_for_runtime)"
      # SESSION_PARENT_ID already set by manager before worker launch; preserve it.
      log_info "forked new session ${TOOL_SESSION_ID_CURRENT} from parent ${SESSION_PARENT_ID:-unknown}"
    elif [[ -z "${TOOL_SESSION_ID_CURRENT:-}" ]]; then
      # No resume enforcement and no session → generate one (first-ever launch)
      TOOL_SESSION_ID_CURRENT="$(generate_uuid_for_runtime)"
    fi
  fi
}

