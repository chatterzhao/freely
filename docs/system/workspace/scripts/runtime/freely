ensure_task_mode_gate() {
  local project="$1" config_default="${2:-wait}"
  local init_mode
  case "$config_default" in
    auto) init_mode="auto" ;;
    wait) init_mode="wait" ;;
    id:*) init_mode="id" ;;
    *) init_mode="wait" ;;
  esac
  local cli="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli"
  python3 "$cli" --project "$project" task-mode.init --default "$init_mode" >/dev/null 2>&1 || true
}

read_task_mode() {
  local project="$1"
  local cli="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli"
  local result _retry
  for _retry in 1 2 3; do
    result=$(python3 "$cli" --project "$project" task-mode.read-with-scan 2>/dev/null) && break
  done
  if [[ -z "$result" ]]; then
    log_error "task_mode degraded to WAIT: DB query failed after 3 retries (freely-db daemon not ready or crashed). AI will not work in wait mode. After fixing the root cause, restart with --task-mode auto, or run: freely task-mode set --project <project> --task-mode auto"
    echo 'wait'; return 0
  fi
  local mode="${result%%|*}"
  local scan_id="${result#*|}"
  if [[ "$mode" == "id" && -n "$scan_id" ]]; then
    echo "id:${scan_id}"
  else
    echo "$mode"
  fi
}

write_task_mode() {
  local project="$1" mode="$2" scan_id="${3:-}"
  local task_mode task_scan_id
  case "$mode" in
    auto) task_mode="auto"; task_scan_id="" ;;
    wait) task_mode="wait"; task_scan_id="" ;;
    listen) task_mode="listen"; task_scan_id="" ;;
    id:*) task_mode="id"; task_scan_id="${mode#id:}" ;;
    *) log_error "invalid task-mode: $mode (expected auto|wait|listen|id:<scan-id>)"; return 1 ;;
  esac
  local cli="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli"
  python3 "$cli" --project "$project" task-mode.write --mode "$task_mode" --scan_id "$task_scan_id" >/dev/null 2>&1 || true
  append_runtime_event "$project" "task_mode_written" \
    "mode=$task_mode" \
    "task_scan_id=${task_scan_id:-none}"
}

