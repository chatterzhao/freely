manager_supervision_alerts() {
  local project="$1" repo_root wt_path branch desired_state role_hint exit_reason supervisor_state ai_state owner next_action anomaly
  repo_root="$(git -C "$project" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$repo_root" ]] || return 0
  while IFS='|' read -r wt_path branch; do
    [[ -n "$wt_path" ]] || continue
    [[ "$wt_path" == "$project" ]] && continue
    [[ -f "$(config_file "$wt_path")" ]] || continue
    desired_state=""
    role_hint=""
    exit_reason=""
    supervisor_state="down"
    ai_state="down"
    if [[ -f "$(workcell_state_file "$wt_path")" ]]; then
      # shellcheck disable=SC1090
      source "$(workcell_state_file "$wt_path")"
      desired_state="${DESIRED_RUNTIME_STATE:-}"
      role_hint="${LAST_ROLE_HINT:-}"
      exit_reason="${LAST_EXIT_REASON:-}"
    fi
    [[ "$desired_state" == "running" ]] || continue
    owner="runtime-owned"
    next_action="runtime_recovery_requested"
    if [[ -f "$(run_dir_for_project "$wt_path")/supervisor.pid" ]]; then
      local sp
      sp="$(cat "$(run_dir_for_project "$wt_path")/supervisor.pid" 2>/dev/null || true)"
      if valid_supervisor_pid_for_project "$wt_path" "$sp"; then
        supervisor_state="up"
      fi
    fi
    if [[ -f "$(run_dir_for_project "$wt_path")/ai.pid" ]]; then
      local ap
      ap="$(cat "$(run_dir_for_project "$wt_path")/ai.pid" 2>/dev/null || true)"
      if valid_ai_pid_for_project "$wt_path" "$ap"; then
        ai_state="up"
      fi
    fi
    if [[ "$supervisor_state" == "down" ]]; then
      anomaly="expected_running_worktree_down"
      printf -- '- %s: branch=%s role=%s owner=%s next_action=%s exit_reason=%s path=%s\n' "$anomaly" "${branch:-unknown}" "${role_hint:-worker}" "$owner" "$next_action" "${exit_reason:-unknown}" "$wt_path"
    elif [[ "$ai_state" == "down" ]]; then
      anomaly="expected_running_worktree_degraded"
      printf -- '- %s: branch=%s role=%s owner=%s next_action=%s exit_reason=%s path=%s\n' "$anomaly" "${branch:-unknown}" "${role_hint:-worker}" "$owner" "$next_action" "${exit_reason:-unknown}" "$wt_path"
    fi
  done < <(git -C "$repo_root" worktree list --porcelain | awk '
    /^worktree / { wt=substr($0, 10); br="" }
    /^branch / { br=$2; sub(/^refs\/heads\//, "", br); print wt "|" br }
  ')
}

manager_hygiene_alerts() {
  local project="$1" repo_root wt_path branch role_hint dirty_entries checkpoint_json checkpoint_required streak threshold
  repo_root="$(git -C "$project" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$repo_root" ]] || return 0
  threshold="${CHECKPOINT_DRIFT_STREAK_THRESHOLD:-2}"
  while IFS='|' read -r wt_path branch; do
    [[ -n "$wt_path" ]] || continue
    [[ "$wt_path" == "$project" ]] && continue
    [[ -f "$(config_file "$wt_path")" ]] || continue
    role_hint="${LAST_ROLE_HINT:-worker}"
    if [[ -f "$(workcell_state_file "$wt_path")" ]]; then
      # shellcheck disable=SC1090
      source "$(workcell_state_file "$wt_path")"
      role_hint="${LAST_ROLE_HINT:-worker}"
    fi
    [[ "${role_hint:-worker}" == "worker" ]] || continue
    dirty_entries="$(project_dirty_entries "$wt_path")"
    checkpoint_json="$(checkpoint_guard_json_for_project "$wt_path")"
    checkpoint_required="$(checkpoint_guard_value "$checkpoint_json" checkpoint_required)"
    streak="0"
    if [[ -f "$(session_state_file "$wt_path")" ]]; then
      # shellcheck disable=SC1090
      source "$(session_state_file "$wt_path")"
      streak="${CHECKPOINT_DRIFT_STREAK_CURRENT:-0}"
    fi
    [[ "$streak" =~ ^[0-9]+$ ]] || streak=0
    if [[ "$checkpoint_required" == "true" || "$dirty_entries" =~ ^[0-9]+$ && "$dirty_entries" -ge "${CHECKPOINT_WARN_DIRTY_ENTRIES:-40}" || "$streak" -ge "$threshold" ]]; then
      printf -- '- worktree_checkpoint_drift: branch=%s role=%s owner=manager-owned next_action=delegate_hygiene_worker dirty_entries=%s checkpoint_required=%s drift_streak=%s path=%s\n' \
        "${branch:-unknown}" "${role_hint:-worker}" "${dirty_entries:-0}" "${checkpoint_required:-false}" "${streak:-0}" "$wt_path"
    fi
  done < <(git -C "$repo_root" worktree list --porcelain | awk '
    /^worktree / { wt=substr($0, 10); br="" }
    /^branch / { br=$2; sub(/^refs\/heads\//, "", br); print wt "|" br }
  ')
}

manager_runtime_recover_workers_if_needed() {
  local project="$1" repo_root wt_path branch desired_state role_hint exit_reason supervisor_state recovered
  repo_root="$(git -C "$project" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$repo_root" ]] || return 0
  [[ "$(role_hint_for_project "$project")" == "manager" ]] || return 0

  recovered=0
  while IFS='|' read -r wt_path branch; do
    [[ -n "$wt_path" ]] || continue
    [[ "$wt_path" == "$project" ]] && continue
    [[ -f "$(config_file "$wt_path")" ]] || continue
    desired_state=""
    role_hint=""
    exit_reason=""
    supervisor_state="down"
    if [[ -f "$(workcell_state_file "$wt_path")" ]]; then
      # shellcheck disable=SC1090
      source "$(workcell_state_file "$wt_path")"
      desired_state="${DESIRED_RUNTIME_STATE:-}"
      role_hint="${LAST_ROLE_HINT:-}"
      exit_reason="${LAST_EXIT_REASON:-}"
    fi

    [[ "$desired_state" == "running" ]] || continue
    [[ "${role_hint:-worker}" == "worker" ]] || continue

    if [[ -f "$(run_dir_for_project "$wt_path")/supervisor.pid" ]]; then
      local sp
      sp="$(cat "$(run_dir_for_project "$wt_path")/supervisor.pid" 2>/dev/null || true)"
      if valid_supervisor_pid_for_project "$wt_path" "$sp"; then
        supervisor_state="up"
      fi
    fi
    [[ "$supervisor_state" == "down" ]] || continue

    log_info "manager runtime recovering expected-running worker: branch=${branch:-unknown} exit_reason=${exit_reason:-unknown} path=$wt_path"
    start_workcell_supervisor_async "$wt_path"
    recovered=$((recovered + 1))
  done < <(git -C "$repo_root" worktree list --porcelain | awk '
    /^worktree / { wt=substr($0, 10); br="" }
    /^branch / { br=$2; sub(/^refs\/heads\//, "", br); print wt "|" br }
  ')

  printf '%s\n' "$recovered"
}

