checkpoint_guard_value() {
  local json="$1" key="$2"
  local marker value
  marker="\"${key}\":"
  value="${json#*${marker}}"
  [[ "$value" != "$json" ]] || return 0
  case "$value" in
    true*) printf 'true\n' ;;
    false*) printf 'false\n' ;;
    \"*\") value="${value#\"}"; value="${value%%\"*}"; printf '%s\n' "$value" ;;
    [0-9]*) printf '%s\n' "${value%%[^0-9]*}" ;;
  esac
}

checkpoint_guard_reason_codes() {
  local json="$1"
  local value
  value="${json#*\"reason_codes\":[}"
  [[ "$value" != "$json" ]] || return 0
  value="${value%%]*}"
  value="${value//\"/}"
  value="${value//,/ }"
  printf '%s\n' "$value" | xargs
}

