load_config() {
  local project="$1"
  local cfg
  cfg="$(config_file "$project")"

  if [[ -f "$cfg" ]]; then
    source_config "$project" || {
      log_error "failed to load config: $cfg"
      exit 1
    }
  else
    log_error "config.toml not found in $(state_dir "$project")"
    log_error ""
    log_error "Freely requires config.toml to start. Create it:"
    log_error ""
    if [[ -f "$project/.freely/config.toml.example" ]]; then
      log_error "  cp $project/.freely/config.toml.example $cfg"
    else
      log_error "  cp templates/config.toml.example $cfg"
    fi
    log_error "  Then edit $cfg with your project settings"
    log_error ""
    log_error "Or generate a default config:"
    log_error "  freely init --project $project"
    exit 1
  fi

  # Validate PROJECT_ROOT — must be non-empty, absolute, and an existing directory.
  if [[ -z "${PROJECT_ROOT:-}" ]]; then
    log_error "PROJECT_ROOT is not set in config"
    log_error "Add: PROJECT_ROOT=\"<absolute-path-to-this-project>\""
    exit 1
  fi
  if [[ "${PROJECT_ROOT:0:1}" != "/" ]]; then
    log_error "PROJECT_ROOT must be an absolute path in config"
    log_error "Current value: PROJECT_ROOT=\"${PROJECT_ROOT}\""
    exit 1
  fi
  if [[ ! -d "$PROJECT_ROOT" ]]; then
    log_error "PROJECT_ROOT directory does not exist: ${PROJECT_ROOT}"
    log_error "Fix PROJECT_ROOT in config to point to the actual project directory"
    exit 1
  fi

  migrate_project_auto_recovery_defaults_if_needed "$project"

  # ── Agent-table: resolve AGENT_AI_TOOL for ALL agents ──────
  # AGENT_AI_TOOL is resolved from agent-table.toml slot (no fallback).
  # .freely/agent-table.toml at startup.  No config writes needed.
  #
  # Resolution order:
  #   1. agent-id.env → which agent (manager_01 / worker_03 / …) owns this worktree
  #   2. agent-table → get slot for that agent_id
  #   3. Validate slot is a registered tool
  if [[ -z "${AGENT_AI_TOOL:-}" ]]; then
    local _at="${PROJECT_ROOT}/.freely/agent-table.toml"
    local _aq="${PROJECT_ROOT}/bin/agent-table-query"
    local _agent_env="${PROJECT_ROOT}/.freely/agent-id.env"
    local _my_id=""

    # Resolve agent identity: agent-id.env maps worktree_path → agent_id
    # Anchor with = to avoid substring match: develop path (.../freely)
    # must not match worktree paths (.../freely-worktrees/...).
    if [[ -f "$_agent_env" ]]; then
      _my_id=$(grep -F "$(pwd)=" "$_agent_env" 2>/dev/null | grep -oE '(manager_[0-9]+|worker_[0-9]+)' | head -1 || true)
    fi
    # Manager runs on develop worktree — not in agent-id.env
    [[ -z "$_my_id" ]] && _my_id="manager_01"

    if [[ -f "$_at" && -x "$_aq" ]]; then
      local _slot; _slot=$("$_aq" --get-slot "$_my_id" 2>/dev/null || true)
      if [[ -n "$_slot" ]]; then
        local _tool="${_slot%%-*}"
        if _tool_is_registered "$_tool" 2>/dev/null; then
          export AGENT_AI_TOOL="$_slot"
          log_info "agent-table: $_my_id AGENT_AI_TOOL=$AGENT_AI_TOOL (pool=$("$SELF_ROOT/bin/agent-table-query" --pool-size worker 2>/dev/null || echo 10) workers)"
        else
          log_error "agent-table: $_my_id slot='$_slot' → tool='$_tool' not in registry"
          exit 1
        fi
      fi
    fi
    if [[ -z "${AGENT_AI_TOOL:-}" ]]; then
      log_error "AGENT_AI_TOOL not set. Configure .freely/agent-table.toml:"
      log_error "  [[agents]]"
      log_error "  manager_slot = \"<tool>-apikey-<slot>\""
      log_error "  worker_slot  = \"<tool>-apikey-<slot>\""
      log_error "  pool = N"
      exit 1
    fi
  fi

  # ── AGENT_AI_TOOL already set by _init_agent_table_slot_pin ──
}

