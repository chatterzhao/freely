task_source_scan_regeneration_reason_for_project() {
  local project="$1"
  local scan_mtime latest_intake_mtime latest_continuity_mtime
  local continuity_file active_running_workers state_path current_head anchored_head
  local prev_active_workers stale_minutes scan_age_minutes

  scan_mtime="$(latest_task_source_scan_json_mtime_for_project "$project" 2>/dev/null || true)"
  if [[ -z "$scan_mtime" ]]; then
    printf 'bootstrap_missing_scan\n'
    return 0
  fi

  active_running_workers="$(manager_semantic_loop_active_worker_count_for_project "$project" 2>/dev/null || true)"
  [[ "$active_running_workers" =~ ^[0-9]+$ ]] || active_running_workers="0"

  state_path="$(task_source_scan_state_file_for_project "$project")"
  prev_active_workers="0"
  if [[ -f "$state_path" ]]; then
    # shellcheck disable=SC1090
    source "$state_path"
    prev_active_workers="${LAST_TASK_SOURCE_SCAN_ACTIVE_WORKERS:-0}"
    anchored_head="${LAST_TASK_SOURCE_SCAN_PROJECT_HEAD:-}"
    [[ "$prev_active_workers" =~ ^[0-9]+$ ]] || prev_active_workers="0"
  fi

  # If workers are still running, block regeneration (avoid mid-flight churn).
  # But persist the current count so we can detect completion next cycle.
  if (( active_running_workers > 0 )); then
    if (( active_running_workers != prev_active_workers )); then
      _update_task_source_scan_state_active_workers "$project" "$active_running_workers"
    fi
    return 1
  fi

  # Worker-completion trigger: workers just finished (was >0, now 0).
  if (( prev_active_workers > 0 && active_running_workers == 0 )); then
    _update_task_source_scan_state_active_workers "$project" "0"
    printf 'workers_completed_since_last_scan\n'
    return 0
  fi

  current_head="$(task_source_scan_current_project_head_for_project "$project")"
  if [[ -n "$current_head" && -n "$anchored_head" && "$current_head" != "$anchored_head" ]]; then
    printf 'project_head_changed_since_last_scan\n'
    return 0
  fi

  latest_intake_mtime="$(latest_active_intake_meta_mtime_for_project "$project" 2>/dev/null || true)"
  if [[ "$latest_intake_mtime" =~ ^[0-9]+$ ]] && (( latest_intake_mtime > scan_mtime )); then
    printf 'new_active_intake_since_last_scan\n'
    return 0
  fi

  continuity_file="$(latest_generated_manager_continuity_file_for_project "$project")"
  if [[ -n "$continuity_file" && -f "$continuity_file" ]]; then
    latest_continuity_mtime="$(file_mtime_epoch "$continuity_file" 2>/dev/null || true)"
    if [[ "$latest_continuity_mtime" =~ ^[0-9]+$ ]] && (( latest_continuity_mtime > scan_mtime )); then
      printf 'continuity_advanced_since_last_scan\n'
      return 0
    fi
  fi

  # Time-based staleness: if scan is older than SCAN_MAX_STALE_MINUTES, force refresh.
  # This catches cases where no external trigger fired but the scan data is stale.
  stale_minutes="${SCAN_MAX_STALE_MINUTES:-15}"
  scan_age_minutes=$(( ($(date +%s) - scan_mtime) / 60 ))
  if (( scan_age_minutes >= stale_minutes )); then
    printf 'scan_stale_age_%d_minutes\n' "$scan_age_minutes"
    return 0
  fi

  return 1
}

_update_task_source_scan_state_active_workers() {
  local project="$1" count="$2"
  local state_path
  state_path="$(task_source_scan_state_file_for_project "$project")"
  if [[ -f "$state_path" ]]; then
    sed -i '' -E '/^LAST_TASK_SOURCE_SCAN_ACTIVE_WORKERS=/d' "$state_path" 2>/dev/null || true
  fi
  printf 'LAST_TASK_SOURCE_SCAN_ACTIVE_WORKERS=%s\n' "$count" >>"$state_path"
}

# ── PR scanning via configured repo platforms ─────────────────────
# Reads FREELY_REPO_PLATFORMS (comma-separated, e.g. "github,gitee").
# Each platform name maps to its CLI: "github"→gh, "gitee"→gitee, etc.
# Custom platforms can be added by ensuring their CLI supports:
#   <cli> pr list --json number,title,state,headRefName,baseRefName,url,createdAt
scan_repo_platform_prs() {
  local project="$1"
  local platforms_csv="${FREELY_REPO_PLATFORMS:-}"
  [[ -n "$platforms_csv" ]] || return 0

  local IFS=","
  for _platform in $platforms_csv; do
    [[ -n "$_platform" ]] || continue
    local _cli="$_platform"
    case "$_platform" in
      github) _cli="gh" ;;
      gitee)  _cli="gitee" ;;
    esac
    if ! command -v "$_cli" >/dev/null 2>&1; then
      continue
    fi
    "$_cli" pr list --json number,title,state,headRefName,baseRefName,url,createdAt \
      --jq '.[] | "\(.number)|\(.title)|\(.state)|\(.headRefName)|\(.baseRefName)|\(.url)|\(.createdAt)"' \
      2>/dev/null | while IFS= read -r _pr_line; do
      printf 'pr|%s|%s\n' "$_platform" "$_pr_line"
    done
  done
}

write_task_source_scan_json_for_project() {
  local project="$1" regeneration_reason="${2:-manual}" raw_key="${3:-}"
  local output_path state_path run_dir generated_at active_running_workers project_head
  local pr_snapshot pr_count

  run_dir="$(run_dir_for_project "$project")"
  output_path="$(task_source_scan_json_path_for_project "$project")"
  state_path="$(task_source_scan_state_file_for_project "$project")"
  mkdir -p "$run_dir"

  generated_at="$(current_timestamp_utc_for_machine)"
  pr_snapshot="$(scan_repo_platform_prs "$project")"
  pr_count="$(snapshot_item_count_from_prefix "$pr_snapshot" "pr|")"
  active_running_workers="$(manager_semantic_loop_active_worker_count_for_project "$project" 2>/dev/null || true)"
  [[ "$active_running_workers" =~ ^[0-9]+$ ]] || active_running_workers="0"
  project_head="$(task_source_scan_current_project_head_for_project "$project")"

  # pre-scan-fix: auto-fix terminal-phase local docs before scan.
  # Reduces scan noise by aligning frontmatter for issues that don't need AI attention.
  local _pre_scan_fix="$SELF_ROOT/docs/system/workspace/scripts/runtime/pre-scan-fix.sh"
  if [[ -x "$_pre_scan_fix" ]]; then
    "$_pre_scan_fix" --project "$project" --dry-run >/dev/null 2>&1 || true
  fi

  if [[ -f "$TASK_SOURCE_SCAN_SCRIPT" ]]; then
    local _scan_args=(--project "$project")
    [[ -n "$raw_key" ]] && _scan_args+=(--raw-key "$raw_key")
    local _scan_stderr
    _scan_stderr="$(mktemp "$run_dir/task-lifecycle-scan.stderr.XXXXXX")"
    if python3 "$TASK_SOURCE_SCAN_SCRIPT" "${_scan_args[@]}" >"$output_path" 2>"$_scan_stderr"; then
      rm -f "$_scan_stderr"
    else
      log_warn "lifecycle scan failed; stderr saved to $_scan_stderr"
      # Keep old scan if exists — never overwrite with empty on failure
      if [[ -f "$output_path" && -s "$output_path" ]]; then
        : # preserve existing scan
      else
        # First-time failure or empty old file: write minimal error marker
        printf '{"scan_version":"lifecycle-v2","generated_at":"%s","project_root":"%s","summary":{"total_incomplete":0,"by_stage":{},"ready":0},"scan_error":true,"error_log":"%s","items":[]}\n' \
          "$generated_at" "$project" "$_scan_stderr" >"$output_path"
      fi
    fi
  else
    printf '{"scan_version":"lifecycle-v2","generated_at":"%s","project_root":"%s","summary":{"total_incomplete":0,"by_stage":{},"ready":0},"items":[]}\n' \
      "$generated_at" "$project" >"$output_path"
  fi

  # Inject PR snapshot into scan output
  if [[ -n "$pr_snapshot" ]]; then
    _scan_pr_tmp="$(mktemp "${TMPDIR:-/tmp}/freely-scan-pr.XXXXXX" 2>/dev/null)"
    if [[ -n "$_scan_pr_tmp" ]]; then
      printf '%s\n' "$pr_snapshot" >"$_scan_pr_tmp"
      python3 - "$output_path" "$_scan_pr_tmp" <<'PRPY'
import json, sys
output_path = sys.argv[1]
pr_tmp_path = sys.argv[2]
with open(pr_tmp_path) as pf:
    pr_lines = [l.rstrip() for l in pf if l.rstrip()]
with open(output_path) as f:
    data = json.load(f)
surfaces = data.get('surfaces', [])
surfaces.append({
    "surface": "open_pull_requests",
    "source_class": "discovery",
    "active_count": len(pr_lines),
    "trust_level": "advisory_platform_snapshot",
    "needs_reconcile": False,
    "summary_lines": pr_lines,
})
data["surfaces"] = surfaces
with open(output_path, "w") as f:
    json.dump(data, f, indent=2, sort_keys=True, ensure_ascii=False)
    f.write("\n")
PRPY
      rm -f "$_scan_pr_tmp"
      # Post-process: filter scan items that have active workers
      local _a2a_task_py _db_path
      _a2a_task_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/a2a_task.py"
      _db_path="$project/.freely/freely.db"
      if [[ -f "$_a2a_task_py" && -f "$_db_path" ]]; then
        python3 - "$output_path" "$_a2a_task_py" "$_db_path" <<'SCANFILTER'
import json, sys, subprocess
output_path = sys.argv[1]
hp = sys.argv[2]
db = sys.argv[3]
with open(output_path) as f:
    data = json.load(f)
items = data.get('items', [])
filtered = []
for it in items:
    wt = it.get('worktree_path', '')
    raw_key = it.get('key', '')
    has_active = False
    # Check worktree first (most precise)
    if wt:
        r = subprocess.run([sys.executable, hp, 'has-active-worker', '--db', db, '--worktree', wt],
                          capture_output=True, text=True, timeout=5)
        has_active = (r.stdout.strip() == 'true')
    # Fallback: check raw_key
    if not has_active and raw_key:
        r = subprocess.run([sys.executable, hp, 'list-key', '--db', db, '--raw-key', raw_key],
                          capture_output=True, text=True, timeout=5)
        try:
            records = json.loads(r.stdout)
            has_active = any(rec.get('state') in ('working', 'submitted', 'launched') for rec in records)
        except: pass
    if not has_active:
        filtered.append(it)
# Update summary
by_stage = {}
ready = 0
for it in filtered:
    s = it.get('stage', 'unknown')
    by_stage[s] = by_stage.get(s, 0) + 1
    if it.get('ready'):
        ready += 1
data['items'] = filtered
data['summary'] = {'total_incomplete': len(filtered), 'by_stage': by_stage, 'ready': ready}
data['scan_filter'] = {'filtered_by_active_worker': len(items) - len(filtered)}
with open(output_path, 'w') as f:
    json.dump(data, f, indent=2, sort_keys=True, ensure_ascii=False)
    f.write('\n')
SCANFILTER
      fi
    fi
  fi
  cat >"$state_path" <<EOF
