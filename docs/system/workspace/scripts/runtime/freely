  if [[ "$(effective_runtime_role_for_project "$project")" == "manager" ]]; then
    log_info "agent_working: writing __manager__ record for project=$project"
    _aw_result=$(python3 -c "
import sys; sys.path.insert(0, '${project}/docs/system/workspace/scripts/runtime')
from agent_working import acp_session_register
acp_session_register('${project}', '__manager__', 'manager', 'manager_01',
                     slot='${AGENT_AI_TOOL:-}',
                     worktree='${project}', branch='develop')
print('ok')
" 2>&1)
