}

project_has_freely_config() {
  local project="$1"
  [[ -n "$project" && -f "$(config_file "$project")" ]]
}

looks_like_project_root() {
  local project="$1"
  [[ -n "$project" ]] || return 1
  [[ -f "$project/docs/PROJECT_INTENT.md" ]] || return 1
  [[ -f "$project/docs/CONSTITUTION.md" ]] || return 1
  [[ -f "$project/docs/LAWS.md" ]] || return 1
  [[ -f "$project/AGENTS.md" ]] || return 1
  [[ -d "$project/docs/pre-brainstorms" ]] || return 1
}

git_root_for_path() {
  local path="$1"
  git -C "$path" rev-parse --show-toplevel 2>/dev/null || true
}

register_project_in_registry() {
  local project="$1"
  local registry dir tmp now canonical_project
  registry="$(projects_registry_file)"
  dir="$(dirname "$registry")"
  now="$(current_timestamp_utc_for_machine)"
  if [[ -d "$project" ]]; then
    canonical_project="$(cd "$project" && pwd -P)"
  else
    canonical_project="$project"
  fi
  mkdir -p "$dir"
  tmp="$(mktemp "${dir}/projects.XXXXXX")"
  {
    printf '%s\t%s\n' "$canonical_project" "$now"
    if [[ -f "$registry" ]]; then
      awk -F '\t' -v project="$canonical_project" '$1 != project { print $0 }' "$registry"
    fi
  } >"$tmp"
  mv "$tmp" "$registry"
}

read_single_registered_project() {
  local registry first count
  registry="$(projects_registry_file)"
  [[ -f "$registry" ]] || return 0
  count="$(awk 'END { print NR }' "$registry")"
  [[ "$count" == "1" ]] || return 0
  awk -F '\t' 'NR==1 { print $1; exit }' "$registry"
}

registered_projects() {
  local registry
  registry="$(projects_registry_file)"
  [[ -f "$registry" ]] || return 0
  awk -F '\t' 'NF > 0 && $1 != "" { print $1 }' "$registry"
}

project_desired_runtime_state() {
  local project="$1"
  local state_file
  state_file="$(workcell_state_file "$project")"
  [[ -f "$state_file" ]] || { printf 'unknown\n'; return 0; }
  reconcile_delegated_runtime_handoff_state_if_needed "$project" >/dev/null 2>&1 || true
  unset DESIRED_RUNTIME_STATE
  # shellcheck disable=SC1090
  source "$state_file"
  printf '%s\n' "${DESIRED_RUNTIME_STATE:-unknown}"
}

project_cleanup_runtime_intent() {
  local project="$1" fallback_desired_state="$2" fallback_exit_reason="$3"
  local desired_state exit_reason state_file shared_desired_state shared_exit_reason

  desired_state="${fallback_desired_state:-stopped}"
  exit_reason="${fallback_exit_reason:-supervisor_exit}"
  if [[ -f "$(stop_marker_file "$project")" ]]; then
    printf 'stopped|%s\n' "$(runtime_stop_exit_reason "${fallback_exit_reason:-}")"
    return 0
  fi

  state_file="$(workcell_state_file "$project")"
  if [[ -f "$state_file" ]]; then
    unset DESIRED_RUNTIME_STATE LAST_EXIT_REASON
    # shellcheck disable=SC1090
    source "$state_file"
    shared_desired_state="${DESIRED_RUNTIME_STATE:-unknown}"
    shared_exit_reason="${LAST_EXIT_REASON:-}"
    if [[ "$shared_desired_state" == "stopped" || "$shared_exit_reason" == "operator_stop" ]]; then
      desired_state="stopped"
      exit_reason="${shared_exit_reason:-operator_stop}"
    fi
  fi

  printf '%s|%s\n' "$desired_state" "$exit_reason"
}

runtime_stop_exit_reason() {
  local current_reason="${1:-}"
  case "$current_reason" in
    manager_exit_contract_stop_ai|worker_exit_contract_stop_ai)
      printf '%s\n' "$current_reason"
      ;;
    *)
      printf 'operator_stop\n'
      ;;
  esac
}

runtime_pid_file_for_role() {
  local project="$1" role="$2"
  case "$role" in
    supervisor) printf '%s\n' "$(run_dir_for_project "$project")/supervisor.pid" ;;
    ai) printf '%s\n' "$(run_dir_for_project "$project")/ai.pid" ;;
    manager_watchdog) printf '%s\n' "$(ensure_manager_watchdog_pid_file "$project")" ;;
    interruption_dispatcher) printf '%s\n' "$(interruption_dispatcher_pid_file "$project")" ;;
    sse_watchdog) printf '%s\n' "$(sse_watchdog_pid_file "$project")" ;;
    acp_bridge) printf '%s\n' "/tmp/freely-acp-$(_acp_bridge_short_hash "$project")-"*.pid ;;
    *) return 1 ;;
  esac
}

runtime_pid_valid_for_role() {
  local project="$1" role="$2" pid="$3"
  case "$role" in
    supervisor) valid_supervisor_pid_for_project "$project" "$pid" ;;
    ai) valid_ai_pid_for_project "$project" "$pid" ;;
    manager_watchdog) valid_ensure_manager_watchdog_pid_for_project "$project" "$pid" ;;
    interruption_dispatcher) valid_interruption_dispatcher_pid_for_project "$project" "$pid" ;;
    sse_watchdog) valid_sse_watchdog_pid_for_project "$project" "$pid" ;;
    acp_bridge) kill -0 "$pid" 2>/dev/null ;;  # alive = valid
    *) return 1 ;;
  esac
}

clear_stale_runtime_pid_file_if_invalid() {
  local project="$1" role="$2" trigger="${3:-runtime_read}"
  local pid_file pid
  pid_file="$(runtime_pid_file_for_role "$project" "$role")" || return 1
  [[ -f "$pid_file" ]] || return 1
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  [[ -n "$pid" ]] || {
    rm -f "$pid_file"
    return 0
  }
  if runtime_pid_valid_for_role "$project" "$role" "$pid"; then
    return 1
  fi
  if [[ -n "$(pid_hint_from_file_without_process_inspection "$pid" 2>/dev/null || true)" ]]; then
    return 1
  fi
  rm -f "$pid_file"
  # ACP bridge owns a Unix socket — clean it alongside the stale PID.
  if [[ "$role" == "acp_bridge" ]]; then
    # Clean up all project bridge sockets (including per-tool variants)
    rm -f /tmp/freely-acp-$(_acp_bridge_short_hash "$project")*.sock /tmp/freely-acp-$(_acp_bridge_short_hash "$project")*.pid
  fi
  append_runtime_event "$project" "startup_self_heal_stale_pid_cleared" \
    "trigger=$trigger" \
    "role=$role" \
    "pid=$pid"
  return 0
}

startup_self_heal_clear_stale_pid_files_if_needed() {
  local project="$1" trigger="${2:-runtime_read}" role cleared_any=1
  for role in supervisor ai acp_bridge manager_watchdog interruption_dispatcher sse_watchdog; do
    if clear_stale_runtime_pid_file_if_invalid "$project" "$role" "$trigger"; then
      cleared_any=0
    fi
  done
  return "$cleared_any"
}

startup_self_heal_should_mark_runtime_down() {
  local project="$1" desired_state last_exit_reason last_state_updated_at state_epoch now_epoch grace_secs
  local supervisor_pid ai_pid dispatcher_pid watchdog_pid
  [[ -f "$(workcell_state_file "$project")" ]] || return 1

  unset DESIRED_RUNTIME_STATE LAST_EXIT_REASON LAST_STATE_UPDATED_AT
  # shellcheck disable=SC1090
  source "$(workcell_state_file "$project")"
  desired_state="${DESIRED_RUNTIME_STATE:-unknown}"
  last_exit_reason="${LAST_EXIT_REASON:-unknown}"
  last_state_updated_at="${LAST_STATE_UPDATED_AT:-}"

  [[ "$desired_state" == "running" ]] || return 1
  case "$last_exit_reason" in
    starting|up|already_running_attach|ai_launch_in_flight) ;;
    *) return 1 ;;
  esac

  cleanup_project_start_lock_if_stale_for_runtime "$project"
  project_start_lock_snapshot_for_runtime "$project"
  [[ "${CURRENT_PROJECT_START_LOCK_STATE:-idle}" != "active" ]] || return 1

  supervisor_pid="$(manager_supervisor_pid_for_project "$project")"
  ai_pid="$(runtime_ai_pid_hint_for_project "$project")"
  dispatcher_pid="$(interruption_dispatcher_pid_for_project "$project")"
  watchdog_pid="$(manager_watchdog_pid_for_project "$project")"
  sse_watchdog_pid="$(sse_watchdog_pid_for_project "$project")"
  [[ -z "$supervisor_pid" && -z "$ai_pid" && -z "$dispatcher_pid" && -z "$watchdog_pid" && -z "$sse_watchdog_pid" ]] || return 1
  [[ -z "$(runtime_unverified_pid_roles_for_project "$project")" ]] || return 1

  state_epoch="$(timestamp_epoch_or_zero "$last_state_updated_at")"
  [[ "$state_epoch" =~ ^[0-9]+$ ]] || state_epoch=0
  now_epoch="$(runtime_now_epoch)"
  grace_secs="${FREELY_STARTUP_SELF_HEAL_GRACE_SECS:-20}"
  [[ "$grace_secs" =~ ^[0-9]+$ ]] || grace_secs=20
  (( state_epoch > 0 )) || return 0
  (( now_epoch - state_epoch > grace_secs ))
}

startup_self_heal_machine_state_if_needed() {
  local project="$1" trigger="${2:-runtime_read}" stale_launch_state_rc=1
  [[ -n "$project" && -d "$project" ]] || return 0
  startup_self_heal_clear_stale_pid_files_if_needed "$project" "$trigger" || true
  manager_worker_launch_state_refresh_for_status "$project" >/dev/null 2>&1 || true

  # Clean cycle-specific failure markers (always stale on fresh start).
  local run_dir; run_dir="$(run_dir_for_project "$project")"
  rm -f "$run_dir/tool-runtime-failure.marker" \
        "$run_dir/network-failure.marker" \
        "$run_dir/bridge-lost.marker"

  # Clean stale project-start.lock if holder PID is dead.
  if [[ -f "$run_dir/project-start.lock" ]]; then
    local lock_pid
    lock_pid=$(grep -oE 'pid=[0-9]+' "$run_dir/project-start.lock" 2>/dev/null | cut -d= -f2)
    if [[ -z "$lock_pid" ]] || ! kill -0 "$lock_pid" 2>/dev/null; then
      rm -f "$run_dir/project-start.lock"
    fi
  fi

  # Auto-heal polluted session IDs in session-state.env.
  local state_file="$run_dir/session-state.env"
  if [[ -f "$state_file" ]]; then
    local last_sid
    last_sid=$(grep "^LAST_TOOL_SESSION_ID=" "$state_file" 2>/dev/null | cut -d= -f2- | tr -d '"')
    if [[ -n "$last_sid" ]] && ! is_valid_uuid "$last_sid"; then
      sed -i '' 's/^LAST_TOOL_SESSION_ID=.*/LAST_TOOL_SESSION_ID=""/' "$state_file"
    fi
  fi

  if startup_self_heal_should_mark_runtime_down "$project"; then
    stale_launch_state_rc=0
  else
    stale_launch_state_rc=$?
  fi
  if [[ "$stale_launch_state_rc" -eq 0 ]]; then
    write_workcell_state "$project" "stopped" "down" "down" "startup_self_heal_no_runtime"
    append_runtime_event "$project" "startup_self_heal_runtime_state_cleared" \
      "trigger=$trigger" \
      "reason=no_runtime_processes_after_startup_grace"
  fi
}

project_role_hint() {
  local project="$1"
  local state_file
  state_file="$(workcell_state_file "$project")"
  [[ -f "$state_file" ]] || { printf '%s\n' "$(effective_runtime_role_for_project "$project")"; return 0; }
  unset LAST_ROLE_HINT
  # shellcheck disable=SC1090
  source "$state_file"
  printf '%s\n' "${LAST_ROLE_HINT:-$(effective_runtime_role_for_project "$project")}"
}

effective_runtime_role_for_project() {
  local project="$1" role_hint
  role_hint="$(role_hint_for_project "$project")"
  if [[ "$role_hint" == "manager" ]] && worker_project_has_launchable_verification_contract "$project"; then
    printf 'worker\n'
    return 0
  fi
  printf '%s\n' "$role_hint"
