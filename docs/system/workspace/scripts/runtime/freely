      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project")"
  repo_root="$(git -C "$project" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$repo_root" ]] || { log_error "not a git repo: $project"; exit 1; }
  entries="$(git -C "$repo_root" worktree list --porcelain 2>/dev/null || true)"
  [[ -n "$entries" ]] || { log_error "no worktrees found for: $repo_root"; exit 1; }

  printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "branch" "tree" "sup" "ai" "dirty" "checkpoint" "path"
  printf "%s\n" "------------------------------------------------------------------------------------------------"
  while IFS='|' read -r wt_path wt_branch; do
