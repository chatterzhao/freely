find_codex_jsonl_path_for_session() {
  local session_id="$1"
  local sessions_root
  [[ -n "$session_id" ]] || return 0
  sessions_root="${CODEX_HOME:-$HOME/.codex}/sessions"
  [[ -d "$sessions_root" ]] || return 0
  find "$sessions_root" -type f -name "*${session_id}.jsonl" | sort | tail -n 1
}

extract_latest_codex_context_ratio_from_jsonl() {
  local jsonl_path="$1"
  local line total_tokens context_window
  [[ -f "$jsonl_path" ]] || return 0
  line="$(rg '"type":"token_count"' "$jsonl_path" | rg '"model_context_window"' | tail -n 1 || true)"
  [[ -n "$line" ]] || return 0
  total_tokens="$(printf '%s\n' "$line" | sed -n 's/.*"total_tokens":\([0-9][0-9]*\).*/\1/p' | tail -n 1)"
  context_window="$(printf '%s\n' "$line" | sed -n 's/.*"model_context_window":\([0-9][0-9]*\).*/\1/p' | tail -n 1)"
  [[ -n "$total_tokens" && -n "$context_window" && "$context_window" -gt 0 ]] || return 0
  awk -v total="$total_tokens" -v window="$context_window" 'BEGIN { printf "%.4f\n", total / window }'
}

extract_latest_codex_primary_rate_limit_used_percent_from_jsonl() {
  local jsonl_path="$1"
  local line
  [[ -f "$jsonl_path" ]] || return 0
  line="$(rg '"type":"token_count"' "$jsonl_path" | rg '"primary":\{"used_percent":' | tail -n 1 || true)"
  [[ -n "$line" ]] || return 0
  printf '%s\n' "$line" | sed -n 's/.*"primary":{"used_percent":\([0-9.][0-9.]*\).*/\1/p' | tail -n 1
}

extract_latest_codex_primary_rate_limit_reset_at_from_jsonl() {
  local jsonl_path="$1"
