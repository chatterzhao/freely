  case "$tool" in
    codex|cc|cc-use-codex-cli) printf 'medium\n' ;;
    *) printf '\n' ;;
  esac
}

runtime_cross_tool_fallback_order_for_current_tool() {
  local current_tool="$1"
  if [[ -n "${AI_FALLBACK_TOOLS:-}" ]]; then
    printf '%s\n' "$AI_FALLBACK_TOOLS"
    return 0
  fi
  if [[ "$current_tool" != "codex" ]]; then
    printf 'codex\n'
  fi
