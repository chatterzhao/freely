looks_like_project_root() {
  local project="$1"
  [[ -n "$project" ]] || return 1
  [[ -f "$project/docs/PROJECT_INTENT.md" ]] || return 1
  [[ -f "$project/docs/CONSTITUTION.md" ]] || return 1
  [[ -f "$project/docs/LAWS.md" ]] || return 1
  [[ -f "$project/AGENTS.md" ]] || return 1
  [[ -d "$project/docs/pre-brainstorms" ]] || return 1
}

git_root_for_path() {
  local path="$1"
  git -C "$path" rev-parse --show-toplevel 2>/dev/null || true
}

register_project_in_registry() {
  local project="$1"
  local registry dir tmp now canonical_project
  registry="$(projects_registry_file)"
  dir="$(dirname "$registry")"
  now="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  if [[ -d "$project" ]]; then
    canonical_project="$(cd "$project" && pwd -P)"
  else
    canonical_project="$project"
  fi
  mkdir -p "$dir"
  tmp="$(mktemp "${dir}/projects.XXXXXX")"
  {
    printf '%s\t%s\n' "$canonical_project" "$now"
    if [[ -f "$registry" ]]; then
      awk -F '\t' -v project="$canonical_project" '$1 != project { print $0 }' "$registry"
    fi
  } >"$tmp"
  mv "$tmp" "$registry"
}

read_single_registered_project() {
  local registry first count
  registry="$(projects_registry_file)"
  [[ -f "$registry" ]] || return 0
  count="$(awk 'END { print NR }' "$registry")"
  [[ "$count" == "1" ]] || return 0
  awk -F '\t' 'NR==1 { print $1; exit }' "$registry"
}

registered_projects() {
  local registry
  registry="$(projects_registry_file)"
  [[ -f "$registry" ]] || return 0
  awk -F '\t' 'NF > 0 && $1 != "" { print $1 }' "$registry"
}

project_desired_runtime_state() {
  local project="$1"
  local state_file
  state_file="$(workcell_state_file "$project")"
  [[ -f "$state_file" ]] || { printf 'unknown\n'; return 0; }
  unset DESIRED_RUNTIME_STATE
  # shellcheck disable=SC1090
  source "$state_file"
  printf '%s\n' "${DESIRED_RUNTIME_STATE:-unknown}"
}

project_role_hint() {
  local project="$1"
  local state_file
  state_file="$(workcell_state_file "$project")"
  [[ -f "$state_file" ]] || { printf '%s\n' "$(role_hint_for_project "$project")"; return 0; }
  unset LAST_ROLE_HINT
  # shellcheck disable=SC1090
  source "$state_file"
  printf '%s\n' "${LAST_ROLE_HINT:-$(role_hint_for_project "$project")}"
}

registered_projects_requiring_auth_change_wake() {
  local project desired_state role_hint
  while IFS= read -r project; do
    [[ -n "$project" && -d "$project" ]] || continue
    project_has_freely_config "$project" || continue
    desired_state="$(project_desired_runtime_state "$project")"
    [[ "$desired_state" == "running" ]] || continue
    role_hint="$(project_role_hint "$project")"
    [[ "$role_hint" == "manager" ]] || continue
    printf '%s\n' "$project"
  done < <(registered_projects)
}

append_global_auth_change_event() {
  local tool="$1" slot="$2" reason="$3"
  local log_file
  log_file="$(global_state_dir)/auth-change-events.log"
  mkdir -p "$(dirname "$log_file")"
  printf '%s event=auth_change tool=%q slot=%q reason=%q\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "${tool:-unknown}" "${slot:-}" "${reason:-unspecified}" >>"$log_file"
}

reset_project_auth_change_hold_state() {
  local project="$1" tool="$2"
  case "$tool" in
    codex)
      codex_clear_availability_state "$project"
      ;;
  esac
}

wake_registered_projects_for_auth_change() {
  local tool="$1" slot="$2" reason="$3"
  local project woke_count=0 skipped_count=0
  append_global_auth_change_event "$tool" "$slot" "$reason"
  while IFS= read -r project; do
    [[ -n "$project" ]] || continue
    if ! load_config "$project"; then
      skipped_count=$((skipped_count + 1))
      continue
    fi
    if [[ "${AI_TOOL:-}" != "${tool:-}" ]]; then
      skipped_count=$((skipped_count + 1))
      continue
    fi
    reset_project_auth_change_hold_state "$project" "$tool"
    if ! FREELY_FORCE_WATCHDOG_REPROBE=1 ensure_manager_once "$project"; then
      skipped_count=$((skipped_count + 1))
      continue
    fi
    woke_count=$((woke_count + 1))
  done < <(registered_projects_requiring_auth_change_wake)
  printf 'woke=%s skipped=%s\n' "$woke_count" "$skipped_count"
}

compose_ai_spec() {
  local tool="$1" model="$2" mode="$3"
  [[ -n "$tool" ]] || return 1
  if [[ -n "$model" ]]; then
    printf '%s:%s:%s\n' "$tool" "$model" "${mode:-auto}"
  else
    printf '%s:%s\n' "$tool" "${mode:-auto}"
  fi
}

resolve_ai_spec_for_project_or_global() {
  local project="$1" explicit_ai_spec="${2:-}"
  local cfg tool model mode

  if [[ -n "$explicit_ai_spec" ]]; then
    printf '%s\n' "$explicit_ai_spec"
    return 0
  fi

  cfg="$(config_file "$project")"
  if [[ -f "$cfg" ]]; then
    unset AI_TOOL AI_MODEL AI_MODE
    # shellcheck disable=SC1090
    source "$cfg"
    tool="${AI_TOOL:-}"
    model="${AI_MODEL:-}"
    mode="${AI_MODE:-auto}"
    if [[ -n "$tool" ]]; then
      compose_ai_spec "$tool" "$model" "$mode"
      return 0
    fi
  fi

  cfg="$(global_config_file)"
  if [[ -f "$cfg" ]]; then
    unset AI_TOOL AI_MODEL AI_MODE
    # shellcheck disable=SC1090
    source "$cfg"
    tool="${AI_TOOL:-}"
    model="${AI_MODEL:-}"
    mode="${AI_MODE:-auto}"
    if [[ -n "$tool" ]]; then
      compose_ai_spec "$tool" "$model" "$mode"
      return 0
    fi
  fi

  if [[ -n "${FREELY_DEFAULT_AI:-}" ]]; then
    printf '%s\n' "$FREELY_DEFAULT_AI"
    return 0
  fi

  return 1
}

resolve_tool_adapter_policy_for_project_or_global() {
  local project="$1" tool="$2" explicit_tool_adapter_policy="${3:-}" explicit_tool_adapter="${4:-}"
  local cfg current_tool current_policy current_adapter

  if [[ -n "$explicit_tool_adapter_policy" ]]; then
    printf '%s\n' "$explicit_tool_adapter_policy"
    return 0
  fi

  if [[ -n "$explicit_tool_adapter" ]]; then
    printf '%s\n' "$explicit_tool_adapter"
    return 0
  fi

  cfg="$(config_file "$project")"
  if [[ -f "$cfg" ]]; then
    resolve_project_tool_adapter_policy_selection "$project" "$tool" "$explicit_tool_adapter_policy" "$explicit_tool_adapter"
    return 0
  fi

  cfg="$(global_config_file)"
  if [[ -f "$cfg" ]]; then
    current_tool="$(
      (
        unset AI_TOOL AI_TOOL_ADAPTER AI_TOOL_ADAPTER_POLICY
        # shellcheck disable=SC1090
        source "$cfg"
        printf '%s' "${AI_TOOL:-}"
      )
    )"
    current_policy="$(
      (
        unset AI_TOOL AI_TOOL_ADAPTER AI_TOOL_ADAPTER_POLICY
        # shellcheck disable=SC1090
        source "$cfg"
        printf '%s' "${AI_TOOL_ADAPTER_POLICY:-}"
      )
    )"
    current_adapter="$(
      (
        unset AI_TOOL AI_TOOL_ADAPTER AI_TOOL_ADAPTER_POLICY
        # shellcheck disable=SC1090
        source "$cfg"
        printf '%s' "${AI_TOOL_ADAPTER:-}"
      )
    )"
    if [[ "$current_tool" == "$tool" ]]; then
      if [[ -n "$current_policy" ]]; then
        printf '%s\n' "$current_policy"
        return 0
      fi
      if [[ -n "$current_adapter" ]]; then
        printf '%s\n' "$current_adapter"
        return 0
      fi
    fi
  fi

  tool_default_adapter_policy_for_runtime "$tool"
}

resolve_tool_adapter_for_project_or_global() {
  local project="$1" tool="$2" explicit_tool_adapter="${3:-}" explicit_tool_adapter_policy="${4:-}"
  local cfg current_tool current_adapter resolved_policy

  if [[ -n "$explicit_tool_adapter" ]]; then
    printf '%s\n' "$explicit_tool_adapter"
    return 0
  fi

  cfg="$(config_file "$project")"
  if [[ -f "$cfg" ]]; then
    resolve_project_tool_adapter_selection "$project" "$tool"
    return 0
  fi

  cfg="$(global_config_file)"
  if [[ -f "$cfg" ]]; then
    current_tool="$(
      (
        unset AI_TOOL AI_TOOL_ADAPTER AI_TOOL_ADAPTER_POLICY
        # shellcheck disable=SC1090
        source "$cfg"
        printf '%s' "${AI_TOOL:-}"
      )
    )"
    current_adapter="$(
      (
        unset AI_TOOL AI_TOOL_ADAPTER AI_TOOL_ADAPTER_POLICY
        # shellcheck disable=SC1090
        source "$cfg"
        printf '%s' "${AI_TOOL_ADAPTER:-}"
      )
    )"
    if [[ -n "$current_adapter" && "$current_tool" == "$tool" ]]; then
      printf '%s\n' "$current_adapter"
      return 0
    fi
  fi

  resolved_policy="$(resolve_tool_adapter_policy_for_project_or_global "$project" "$tool" "$explicit_tool_adapter_policy" "$explicit_tool_adapter")"
  resolve_tool_adapter_from_policy_for_runtime "$tool" "$resolved_policy"
}

resolve_project_or_fail() {
  local project="${1:-}" allow_uninitialized="${2:-0}"
  local candidate git_root registered
  if [[ -n "$project" ]]; then
    candidate="$(abs_path_or_fail "$project")"
  elif [[ -n "${FREELY_PROJECT:-}" ]]; then
    candidate="$(abs_path_or_fail "$FREELY_PROJECT")"
  else
    git_root="$(git_root_for_path "$PWD")"
    if [[ -n "$git_root" && -f "$(config_file "$git_root")" ]]; then
      candidate="$git_root"
    elif [[ -f "$(config_file "$PWD")" ]]; then
      candidate="$PWD"
    fi

    if [[ -z "$candidate" && "$allow_uninitialized" == "1" ]]; then
      if [[ -n "$git_root" ]] && looks_like_project_root "$git_root"; then
        candidate="$git_root"
      elif looks_like_project_root "$PWD"; then
        candidate="$PWD"
      fi
    fi

    if [[ -z "$candidate" ]]; then
      registered="$(read_single_registered_project)"
      if [[ -n "$registered" && -f "$(config_file "$registered")" ]]; then
        candidate="$registered"
      fi
    fi
  fi

  [[ -n "$candidate" ]] || {
    log_error "unable to resolve project; use --project, set FREELY_PROJECT, or run inside an initialized repo"
    exit 1
  }
  [[ -d "$candidate" ]] || {
    log_error "project not found: $candidate"
    exit 1
  }
  if [[ "$allow_uninitialized" != "1" ]]; then
    project_has_freely_config "$candidate" || {
      log_error "project is not initialized for freely: $candidate"
      log_error "run: freely init --project $candidate --intent <abs_file> --constitution <abs_file> --ai <tool[:model][:mode]>"
      exit 1
    }
  fi
  printf '%s\n' "$candidate"
}

