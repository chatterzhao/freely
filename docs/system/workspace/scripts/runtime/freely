# manager_reconcile_agent_id_env — delegate to agent_working.cleanup_stale().
# Called before delegation when approaching pool limit, and by agent-table-query --reconcile.
manager_reconcile_agent_id_env() {
  local _aw_py="${PROJECT_ROOT}/docs/system/workspace/scripts/runtime/agent_working.py"
  if [[ -f "$_aw_py" ]]; then
    python3 -c "
import sys; sys.path.insert(0, '${PROJECT_ROOT}/docs/system/workspace/scripts/runtime')
from agent_working import agent_cleanup_stale
agent_cleanup_stale('${PROJECT_ROOT}')
" 2>/dev/null || true
    return 0
  fi
  # Fallback: old agent-id.env file-based cleanup
  local _agent_env="${1:-${PROJECT_ROOT}/.freely/agent-id.env}"
  [[ -f "$_agent_env" ]] || return 0
  local _cleaned=0 _line _wt_path
  while IFS= read -r _line; do
    [[ -n "$_line" ]] || continue
    _wt_path="${_line%%=*}"
    if [[ ! -d "$_wt_path" ]]; then
      sed -i.bak "|^$_line$|d" "$_agent_env" 2>/dev/null || true
      _cleaned=$((_cleaned + 1))
    fi
  done < "$_agent_env"
  [[ "$_cleaned" -gt 0 ]] && log_info "agent-id.env: cleaned $_cleaned zombie entries (fallback)"
  return 0
}


