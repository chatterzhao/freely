parse_ai_spec() {
  local spec="$1"
  local tool="" model="" mode="auto"
  local first="" second="" third=""

  IFS=':' read -r first second third <<<"$spec"
  tool="$first"
  [[ -n "${tool:-}" ]] || { log_error "invalid --ai spec: $spec"; exit 1; }

  if [[ -n "${third:-}" ]]; then
    model="$second"
    mode="$third"
  elif [[ "$second" == "auto" || "$second" == "step" ]]; then
    model=""
    mode="$second"
  else
    model="${second:-}"
    mode="auto"
  fi

  [[ "$mode" == "auto" || "$mode" == "step" ]] || {
    log_error "unsupported mode: $mode (supported: auto, step)"
    exit 1
  }

  local resolved_family
  resolved_family="$(_resolve_tool_family "$tool")"
  # Registry-driven: warn only if tool is not in registry at all
  if ! _tool_is_registered "$resolved_family"; then
    log_warn "tool '$tool' resolved to unknown family '$resolved_family', continuing anyway"
  fi

  echo "$tool|$model|$mode"
}

