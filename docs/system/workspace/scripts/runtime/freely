write_project_tool_boundary_bootstrap_file() {
  local project="$1"
  local file wrapper_dir worktrees_root manifest_block
  file="$(project_tool_boundary_bootstrap_file "$project")"
  wrapper_dir="$(project_tool_wrapper_dir "$project")"
  worktrees_root="$(project_worktrees_root_for_path "$project")"
  manifest_block="$(append_tool_boundary_manifest_markdown "$wrapper_dir" "$worktrees_root")"
  mkdir -p "$(dirname "$file")"
  cat >"$file" <<EOF
# Tool Boundary Bootstrap

- project_root: \`$project\`
- worktrees_root: \`$worktrees_root\`
- wrapper_bin_dir: \`$wrapper_dir\`

## Managed Surfaces

$manifest_block

## Use

- The project root remains the primary workspace and integration surface for the repository. These launch boundaries extend writable/trusted reach to the sibling worktrees root; they do not replace project-root access.
- Protected roots such as \`develop\` remain valid for read/merge/integration flows, but owner development and staged implementation work must move into a dedicated sibling worktree.
- Freely runtime will inject equivalent launch-time boundaries for supported tools.
- For manual CLI use, prepend \`$wrapper_dir\` to \`PATH\` or invoke the wrapper directly so sibling worktrees stay reachable without falling back to editing \`develop\`.
- Standard worktree creation paths call \`freely sync-tooling --source-project <root> --project <worktree>\`, so ignored or untracked local tool files do not have to be copied by Git.
EOF
}

materialize_project_tooling_for_loaded_config() {
  local project="$1" force="${2:-false}"
  local tool="${AI_TOOL:-}"
  local tool_capabilities="${AI_TOOL_CAPABILITIES:-$(tool_default_capabilities_for_runtime "$tool")}"
  local mode="${AI_MODE:-auto}"

  if tool_requires_project_codex_config "$tool" "$tool_capabilities"; then
    write_project_codex_config "$project" "$force" "$mode"
  fi
  write_project_tool_wrapper_scripts "$project"
  write_project_tool_boundary_bootstrap_file "$project"
}

sync_project_tooling_from_source() {
  local source_project="$1" target_project="$2"
  local source_cfg target_cfg
  source_cfg="$(config_file "$source_project")"
  target_cfg="$(config_file "$target_project")"

  [[ -d "$source_project" ]] || {
    log_error "source project not found: $source_project"
    return 1
  }
  [[ -d "$target_project" ]] || {
    log_error "target project not found: $target_project"
    return 1
  }
  [[ -f "$source_cfg" ]] || {
    log_warn "skip tooling sync: source config missing at $source_cfg"
    return 0
  }

  mkdir -p "$(dirname "$target_cfg")"
  cp "$source_cfg" "$target_cfg"
  load_config "$target_project"
  materialize_project_tooling_for_loaded_config "$target_project" "true"
  log_info "synced project-local tooling: $source_project -> $target_project"
}

write_project_codex_config() {
  local project="$1" force="${2:-false}" mode="${3:-step}"
  local cfg root approval_policy
  cfg="$(project_codex_config_file "$project")"
  root="$(project_worktrees_root_for_path "$project")"
  approval_policy="on-request"
  [[ "$mode" == "auto" ]] && approval_policy="never"
  mkdir -p "$(dirname "$cfg")"

  if [[ -f "$cfg" && "$force" != "true" ]]; then
    log_info "skip: $cfg already exists"
    log_info "manual: edit $cfg or rerun freely init --force to rewrite Freely-managed codex defaults"
    return 0
  fi

  local template
  template="$(cat <<'EOF'
# Freely project-level Codex config
# Reference: https://developers.openai.com/codex/config-reference/
#
# This file is versioned on purpose so every worktree inherits the same project
# defaults. `freely init` should create or update this file as a managed
# bootstrap artifact instead of mutating user-global `~/.codex/config.toml`.
#
# Why these keys exist:
# - `model_context_window`: keep the effective budget below the cost step-up zone
#   observed during dogfooding so Codex compacts earlier instead of drifting
#   into an expensive context shape.
# - `model_auto_compact_token_limit`: trigger compaction before the window cap so
#   long-running sessions compress predictably.
# - `project_doc_max_bytes`: bound auto-loaded project docs so startup context is
#   stable and large governance files do not dominate the prompt budget.
# - `approval_policy`: follow the Freely runtime posture for this project so
#   auto mode stays non-interactive by default.
# - `sandbox_mode`: keep the recommended workspace-write safeguard as a
#   project-local Codex baseline without making it a Freely hard prerequisite.
# - `sandbox_workspace_write.writable_roots`: allow direct access to the sibling
#   `{project}-worktrees` root, which is outside the project root by design.

# Context window governance
model_context_window = 200000
model_auto_compact_token_limit = 150000

# Project doc budget
project_doc_max_bytes = 32768

# Approval and sandbox defaults
approval_policy = "__FREELY_APPROVAL_POLICY__"
sandbox_mode = "workspace-write"

[sandbox_workspace_write]
network_access = false
writable_roots = ["__FREELY_WORKTREES_ROOT__"]
EOF
)"
  template="${template/__FREELY_APPROVAL_POLICY__/$approval_policy}"
  template="${template/__FREELY_WORKTREES_ROOT__/$root}"
  printf '%s\n' "$template" >"$cfg"

  log_info "manual: trust this project in ~/.codex/config.toml if Codex has not yet marked it trusted"
}

