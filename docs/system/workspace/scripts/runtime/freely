build_prompt() {
  local workspace_root
  if [[ "${FREELY_TEST_FAIL_BUILD_PROMPT:-0}" == "1" ]]; then
    return 1
  fi
  # Delta mode: ACP prompt turn — session remembers context, only send delta
  if [[ "${LAUNCH_KIND_SELECTED:-}" == "prompt" ]]; then
    cat <<'PROMPT_DELTA'
=== 本轮 delta（会话已记住你的角色和历史） ===
上一轮 state: ${LAST_WORKCELL_EXIT_REASON:-unknown}
请基于 session 历史继续工作。先读 a2a_tasks 更新，再决定下一步。
调用 a2a-exit 工具声明本轮状态
PROMPT_DELTA
    append_manager_task_context_if_needed "$PROJECT_ROOT"
    append_fleet_supervision_if_needed
    # Only inject scan data when it was regenerated. The session
    # stays alive across prompt cycles (session/close is skipped
    # in prompt mode), so it remembers the scan from the fresh cycle.
    local _delta_scan_reason
    _delta_scan_reason="$(task_source_scan_regeneration_reason_for_project "$PROJECT_ROOT" 2>/dev/null || true)"
    if [[ -n "$_delta_scan_reason" && "$_delta_scan_reason" != "reuse_existing_scan" ]]; then
      append_task_source_patrol_seed_if_needed skip_if_active
    fi
    append_manager_exit_contract_directive_if_needed "$PROJECT_ROOT"
    append_worker_exit_contract_directive_if_needed "$PROJECT_ROOT"
    return 0
  fi
  # Handoff-only mode: context exceeded rotation threshold.
  # Build a minimal prompt with ONLY the handoff content (few KB) instead of
  # the full 68KB system prompt. The new session starts clean with just enough
  # context to continue.
  if [[ "${LAUNCH_KIND_SELECTED:-}" == "fresh_with_handoff" && "${LAUNCH_ROTATION_REASON:-}" == "context_usage_threshold" ]]; then
    build_handoff_only_prompt "$PROJECT_ROOT"
    return 0
  fi
  workspace_root="$(workspace_root_for_project "$PROJECT_ROOT")"
  # Inject agent role definition at prompt start.
  # Fresh/fork: full definition. Prompt (multi-turn): session remembers, skip.
  if [[ "${LAUNCH_KIND_SELECTED:-}" != "resume" ]]; then
    local _prompt_role _agent_def
    _prompt_role="$(effective_runtime_role_for_project "$PROJECT_ROOT")"
    if [[ "$_prompt_role" == "manager" ]]; then
      _agent_def="$(cat "$workspace_root/agents/manager-agent.md" 2>/dev/null || true)"
    else
      _agent_def="$(cat "$workspace_root/agents/worker-agent.md" 2>/dev/null || true)"
    fi
    if [[ -n "$_agent_def" ]]; then
      cat <<PROMPT_AGENT
=== Agent 角色定义 ===
${_agent_def}
===

PROMPT_AGENT
    fi
  else
    cat <<PROMPT_AGENT
=== 本轮 delta（会话已记住你的角色和历史） ===

PROMPT_AGENT
  fi
  prepend_exit_contract_repair_focus_if_needed "$PROJECT_ROOT"
  if manager_exit_contract_repair_prompt_narrowing_active "$PROJECT_ROOT"; then
    build_manager_exit_contract_repair_fresh_with_handoff_prompt "$PROJECT_ROOT"
    append_task_source_patrol_seed_if_needed
  else
    AGENT_AI_TOOL_ADAPTER="${AGENT_AI_TOOL_ADAPTER:-$(tool_default_adapter_for_runtime "${AGENT_AI_TOOL:-}")}" \
    AGENT_AI_TOOL_ADAPTER_POLICY="${AGENT_AI_TOOL_ADAPTER_POLICY:-$(tool_default_adapter_policy_for_runtime "${AGENT_AI_TOOL:-}")}" \
    AGENT_AI_TOOL_CAPABILITIES="${AGENT_AI_TOOL_CAPABILITIES:-}" \
    AGENT_AI_TOOL_POLICY="${AGENT_AI_TOOL_POLICY:-}" \
    AI_CAPABILITY_CODEX_MODEL="${AI_CAPABILITY_CODEX_MODEL:-}" \
    AI_CAPABILITY_CODEX_SANDBOX="${AI_CAPABILITY_CODEX_SANDBOX:-}" \
    AI_CAPABILITY_CODEX_APPROVAL_POLICY="${AI_CAPABILITY_CODEX_APPROVAL_POLICY:-}" \
    AI_CAPABILITY_CODEX_CWD_MODE="${AI_CAPABILITY_CODEX_CWD_MODE:-}" \
    bash "$workspace_root/scripts/start-lead-agent.sh" \
      --project "$PROJECT_ROOT" \
      --intent "$INTENT_FILE" \
      --constitution "$CONSTITUTION_FILE" \
      --ai "${AGENT_AI_TOOL}:${AI_MODEL:-}:${AI_MODE:-auto}" \
      --workspace-root "$workspace_root" \
      --reasoning-effort "${AI_REASONING_EFFORT:-}" \
	      ${mode_name:+$( [[ "$mode_name" == "resume" ]] && printf "%s" "--delta" )}
    # ── SEMI-STABLE: fleet data (changes only when worktrees change) ──
    append_fleet_supervision_if_needed
    # ── STABLE: exit contract format (never changes). Skip for prompt (session remembers). ──
    if [[ "${LAUNCH_KIND_SELECTED:-}" != "resume" ]]; then
      append_manager_exit_contract_directive_if_needed "$PROJECT_ROOT"
      append_worker_exit_contract_directive_if_needed "$PROJECT_ROOT"
    fi
    # ── DYNAMIC: scan, intakes, alerts (changes each cycle) ──
    # Warn when pending delivery backlog but always include scan data
    if [[ "${MANAGER_TASK_BACKLOG_COUNT:-0}" -ge 5 ]] && [[ "$(read_task_mode "$PROJECT_ROOT")" != id:* ]]; then
      cat <<BACKLOG_NOTE

⚠️ 待送达消息 ${MANAGER_TASK_BACKLOG_COUNT} 条（≥5）。先处理上面的 Worker 汇报，再看 scan 决定是否委派新任务。
BACKLOG_NOTE
    fi
    append_task_source_patrol_seed_if_needed
    append_human_chat_intake_if_needed
    append_local_delegated_continuation_if_needed
    append_context_warning_if_needed
    append_checkpoint_governance_if_needed
    append_checkpoint_intervention_if_needed
    append_manager_supervision_alert_if_needed
    append_route_only_recovery_if_needed
  fi
  # ── AUTO-RETRY HINT: inject enrichment hint if present, then clean it up ──
  if [[ -f "$PROJECT_ROOT/.freely/run/auto-retry-hint.txt" ]]; then
    cat "$PROJECT_ROOT/.freely/run/auto-retry-hint.txt"
    rm -f "$PROJECT_ROOT/.freely/run/auto-retry-hint.txt"
  fi
  # ── MANAGER-ONLY: handoff context (thread history + unconsumed workers) ──
  append_manager_task_context_if_needed "$PROJECT_ROOT"
  # ── DYNAMIC: session handoff & continuity (changes each cycle, appended last) ──
  append_handoff_prompt_if_present "$PROJECT_ROOT"
  append_manager_consumed_continuity_resume_focus_if_needed "$PROJECT_ROOT"
  append_cleanup_governance_retirement_worker_directive_if_needed "$PROJECT_ROOT"
}

# append_manager_task_context_if_needed: inject thread history + unconsumed worker list for Manager patrol.
# Worker does NOT receive this — it only gets Task + agent doc + HANDOFF_INJECT.
# ── SSE Event Queue (Phase 2: Dual-Write Transition) ──────────────────

_sse_event_queue_path() {
  local project="$1"
  echo "$(run_dir_for_project "$project")/sse-events.jsonl"
}

# Append an SSE event to the queue (called when SSE events arrive)
sse_event_queue_append() {
  local project="$1" task_id="$2" state="$3" event_type="${4:-TaskStatusUpdateEvent}"
  local queue_file timestamp
  queue_file="$(_sse_event_queue_path "$project")"
  timestamp="$(current_timestamp_utc_for_machine)"
  mkdir -p "$(dirname "$queue_file")"
  printf '{"task_id":"%s","state":"%s","timestamp":"%s","event_type":"%s","consumed":false}\n' \
    "$task_id" "$state" "$timestamp" "$event_type" >> "$queue_file"
}

# Read unconsumed SSE events, return count of new events read
_sse_event_queue_read_unconsumed() {
  local project="$1" queue_file
  queue_file="$(_sse_event_queue_path "$project")"
  if [[ ! -f "$queue_file" || ! -s "$queue_file" ]]; then
    echo "0"
    return 0
  fi
  python3 -c "
import json, sys
queue_file = '$queue_file'
events = []
try:
    with open(queue_file) as f:
        for line in f:
            line = line.strip()
            if not line: continue
            try: ev = json.loads(line)
            except: continue
            if not ev.get('consumed'): events.append(ev)
except: pass
# Print unconsumed events (max 10) in prompt format
for ev in events[:10]:
    tid = ev.get('task_id','?')[:20]
    st = ev.get('state','?')
    ts = ev.get('timestamp','')[:19]
    print(f'- [SSE] {tid} state={st} at={ts}')
if events:
    print(f'SSE_EVENT_COUNT={len(events)}')
else:
    print(f'SSE_EVENT_COUNT=0')
# Mark as consumed
consumed_ids = [ev.get('task_id') for ev in events[:10]]
if consumed_ids:
    new_lines = []
    with open(queue_file) as f:
        for line in f:
            line = line.strip()
            if not line:
                new_lines.append('')
                continue
            try: ev = json.loads(line)
            except:
                new_lines.append(line)
                continue
            if ev.get('task_id') in consumed_ids and not ev.get('consumed'):
                ev['consumed'] = True
            new_lines.append(json.dumps(ev, ensure_ascii=False))
    with open(queue_file, 'w') as f:
        for l in new_lines:
            f.write(l + '\n')
" 2>/dev/null || echo "0"
}

append_manager_task_context_if_needed() {
  local project="$1"
  [[ "$(effective_runtime_role_for_project "$project")" == "manager" ]] || return 0
  local _a2a_task_py _db_path
  _a2a_task_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/a2a_task.py"
  _db_path="$project/.freely/freely.db"
  [[ -f "$_a2a_task_py" && -f "$_db_path" ]] || return 0

  # SSE Watchdog handles event ingestion (persistent connections + ACP injection).
  # Manager just reads the JSONL queue that the watchdog continuously populates.

  # ── SSE events: primary Worker status source (replaces list-pending-delivery) ──
  local sse_output sse_count
  sse_output="$(_sse_event_queue_read_unconsumed "$project")"
  sse_count=$(echo "$sse_output" | grep -o 'SSE_EVENT_COUNT=[0-9]*' | cut -d= -f2)
  [[ "${sse_count:-0}" =~ ^[0-9]+$ ]] || sse_count=0

  # Polling path removed — SSE is the sole Worker status source.
  # delivery_status column and list-pending-delivery are deleted in Phase 3.
  local pending_delivery="(SSE 实时推送中，无轮询 fallback)"
  local poll_count=0

  # Backlog gating uses SSE count
  MANAGER_TASK_BACKLOG_COUNT="${sse_count:-0}"
  [[ "${MANAGER_TASK_BACKLOG_COUNT:-0}" =~ ^[0-9]+$ ]] || MANAGER_TASK_BACKLOG_COUNT=0

  # Thread history: recent handoff records (all roles, grouped by raw_key)
  local thread_summary
  thread_summary=$(python3 -c "
import json,subprocess,sys
hp='$_a2a_task_py'; db='$_db_path'
rows=[]
for role in ['manager','worker']:
    for st in ['completed','consumed']:
        r=subprocess.run([sys.executable,hp,'list','--db',db,'--role',role,'--status',st],
                         capture_output=True,text=True,timeout=5)
        if r.returncode==0:
            rows.extend(json.loads(r.stdout))
rows.sort(key=lambda r: r.get('created_at',''), reverse=True)
for r in rows[:10]:
    print(f\"- {r.get('task_id','?')[:20]} role={r.get('agent_id','?')} exit={r.get('exit_kind','?')} status={r.get('state','?')} raw_key={r.get('raw_key','?')[:20]} reason={r.get('reason','')[:50]} created={r.get('created_at','')[:19]}\")
if not rows:
    print('(无线程历史)')
" 2>/dev/null || echo "(查询失败)")

  # Worker errors: recent blocked/rejected workers that need attention
  local worker_errors
  worker_errors=$(python3 -c "
import json,subprocess,sys
hp='$_a2a_task_py'; db='$_db_path'
rows=[]
for st in ['blocked','rejected']:
    r=subprocess.run([sys.executable,hp,'list','--db',db,'--role','worker','--status',st],
                     capture_output=True,text=True,timeout=5)
    if r.returncode==0:
        rows.extend(json.loads(r.stdout))
# Only recent (last 60 min) and not yet consumed by manager
recent=[r for r in rows if r.get('created_at','') >= '$(date -u -v-60M +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d \"60 minutes ago\" +%Y-%m-%dT%H:%M:%SZ)' and r.get('consumed_by','') != 'manager']
for r in recent[:8]:
    tid=r.get('task_id','')[:25]
    st=r.get('state','?')
    ek=r.get('exit_kind','?')
    reason=r.get('reason','')[:80]
    ts=r.get('created_at','')[:16]
    print(f'- \`{tid}\` → {ek}: {reason} ({ts})')
    print(f'  查询: a2a_task.py get --task-id {tid}')
if not recent:
    print('(无异常)')
" 2>/dev/null || echo "(查询失败)")

  cat <<EOF

## A2A Task 上下文（仅 Manager 可见）

### Worker 实时事件（SSE 推送）
${sse_output}

### Worker 异常（需处理）
${worker_errors}

### 近期 Worker 线程历史
${thread_summary}

处理原则：Worker 状态通过 SSE 实时推送，无需轮询。先读上面的 Worker 事件，读 completion_summary/reason/next_action 做决策。异常 Worker 要及时清理（stale_pid → 退休工位释放资源）。消息看完后如果无事可做再看 scan 找新任务。
EOF
}

cmd_init() {
  local project="" intent="" constitution="" tool_adapter_arg="" tool_adapter_policy_arg="" reasoning_effort="" force="false" accept_default_autonomy="false" auto_mode="false" reset_mode="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --reset) reset_mode="true"; shift ;;
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --intent) intent="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --constitution) constitution="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --tool-adapter) tool_adapter_arg="${2:-}"; shift 2 ;;
      --tool-adapter-policy) tool_adapter_policy_arg="${2:-}"; shift 2 ;;
      --reasoning-effort) reasoning_effort="${2:-}"; shift 2 ;;
      --auto) auto_mode="true"; shift ;;
      --accept-default-autonomy) accept_default_autonomy="true"; shift ;;
      --force) force="true"; shift ;;
      --reason) reason="${2:-}"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done

  # --reason gate
  if [[ "$force" == "true" && -z "${reason:-}" ]]; then
    cat >&2 <<'REASON_GATE'
[GATE] 检测到你试图违规绕过门禁: freely init --force

  如果是因为实现没有达到门禁要求，请按要求去完成，而不是想着违规绕过。

  只有确实有合理的业务理由（配置损坏需重建等），才允许绕过。
  请按以下格式加上绕过理由:
    --reason "违规绕过门禁中，理由充分，是：<业务理由>"

  示例: freely init --force --reason "违规绕过门禁中，理由充分，是：配置文件损坏无法修复，需重建初始化" ...
REASON_GATE
    exit 1
  fi

  [[ -n "$intent" && -n "$constitution" ]] || {
    usage
    exit 1
  }
  project="$(resolve_project_or_fail "$project" 1)"
  [[ -d "$project" ]] || { log_error "project not found: $project"; exit 1; }
  [[ -f "$intent" ]] || { log_error "intent file not found: $intent"; exit 1; }
  [[ -f "$constitution" ]] || { log_error "constitution file not found: $constitution"; exit 1; }
  validate_project_branch_names "$project"

  # ── Ensure config.toml exists ──────────────────────────────────────
  # Creates config.toml from example if missing.  Handles --reset.
  local _cfg="$project/.freely/config.toml"
  local _example_src="$SELF_ROOT/templates/config.toml.example"

  if [[ "$reset_mode" == "true" && -f "$_cfg" ]]; then
    # --reset: confirm, backup, overwrite from example
    local _confirm="n"
    if [[ "$auto_mode" == "true" ]]; then
      _confirm="y"
      log_info "--reset --auto: auto-confirming config.toml reset"
    elif [[ -t 0 ]]; then
      printf '\n⚠️  即将重置 config.toml（备份后从模板重建）。确认？ [y/N] '
      local _timed_out="false"
      read -t 30 _confirm 2>/dev/null || { _confirm="n"; _timed_out="true"; }
      if [[ "$_timed_out" == "true" ]]; then
        printf '\n交互输入超时（30秒），默认取消。如果要自动批准请加 --auto\n'
      fi
    else
      # Non-TTY (AI/pipe): cannot interact — print guidance and cancel
      log_info "--reset 需要交互确认，当前终端不支持。请加 --auto 自动批准。
如需手动操作，请先备份:
  cp .freely/config.toml .freely/config.toml.$(date -u +%Y%m%dT%H%M%SZ).bak && rm .freely/config.toml && freely init ..."
    fi
    case "$_confirm" in
      [yY]|[yY][eE][sS])
        local _ts; _ts=$(date -u +%Y%m%dT%H%M%SZ)
        cp "$_cfg" "$project/.freely/config.toml.${_ts}.bak"
        log_info "config.toml backed up to config.toml.${_ts}.bak"
        cp "$_example_src" "$_cfg"
        log_info "config.toml reset from template"
        ;;
      *)
        log_info "config.toml reset cancelled"
        ;;
    esac
  elif [[ ! -f "$_cfg" ]]; then
    # No config.toml: create from example
    if [[ -f "$_example_src" ]]; then
      cp "$_example_src" "$_cfg"
      log_info "config.toml created from template"
    else
      log_warn "config.toml.example not found at $_example_src — creating empty config"
      touch "$_cfg"
    fi
  else
    # Config exists but --reset not requested: block to prevent accidental modification
    cat >&2 <<CFG_EXISTS
╔══════════════════════════════════════════════════════════════╗
║  config.toml 已存在，init 不会修改已有配置                     ║
╠══════════════════════════════════════════════════════════════╣
║                                                              ║
║  如需重置配置（自动备份当前文件后从模板重建）:                  ║
║    freely init --reset --ai <tool:model:mode> ...              ║
║    freely init --reset --auto --ai <tool:model:mode> ...       ║
║                                                              ║
║  重置会自动备份:                                               ║
║    config.toml → config.toml.YYYYMMDDTHHMMSSZ.bak            ║
║                                                              ║
║  如果只是想补充缺失的 ACP 字段（不动已有值），可以:             ║
║    直接编辑 .freely/config.toml，参照 .freely/config.toml.example ║
║                                                              ║
╚══════════════════════════════════════════════════════════════╝
CFG_EXISTS
    exit 1
  fi

  # Auto-fill known values (both for new and reset configs)
  if [[ -f "$_cfg" ]]; then
    local _project_root; _project_root="$(git -C "$project" rev-parse --show-toplevel 2>/dev/null || echo "$project")"
    upsert_config_key "$project" "PROJECT_ROOT" "$_project_root"
    upsert_config_key "$project" "FREELY_HOME" "$SELF_ROOT"
    [[ -f "$project/docs/PROJECT_INTENT.md" ]] && upsert_config_key "$project" "INTENT_FILE" "$project/docs/PROJECT_INTENT.md"
    [[ -f "$project/docs/CONSTITUTION.md" ]] && upsert_config_key "$project" "CONSTITUTION_FILE" "$project/docs/CONSTITUTION.md"
  fi

  # Platform configuration gate (#3336)
  local _platforms _platforms_config
  _platforms="$(grep -E "^\s*FREELY_REPO_PLATFORMS\s*=" "$project/.freely/config.toml" 2>/dev/null | sed 's/^[^=]*=\s*"\?//;s/"\s*$//' | head -1 || true)"
  if [[ -z "$_platforms" ]]; then
    cat >&2 <<'PLATFORM_GATE'
[BLOCKED] 未配置仓库平台 (FREELY_REPO_PLATFORMS)。

  Freely 支持 GitHub 和 Gitee，至少需要配置一个。
  请在项目的 config.toml 中设置:

    FREELY_REPO_PLATFORMS = "github,gitee"  (两个都配置)
    FREELY_REPO_PLATFORMS = "github"         (仅 GitHub)
    FREELY_REPO_PLATFORMS = "gitee"          (仅 Gitee)

  然后重新运行 freely init。
PLATFORM_GATE
    exit 1
  fi
  IFS=',' read -ra _platform_arr <<< "$_platforms"
  for _p in "${_platform_arr[@]}"; do
    case "$_p" in
      github)
        if ! ssh -T -o StrictHostKeyChecking=no -o ConnectTimeout=5 git@github.com 2>&1 | grep -qE "successfully authenticated|Permission denied"; then
          log_warn "github: SSH key check failed — run: ssh -T git@github.com"
        fi
        if ! git ls-remote --heads git@github.com:$(git remote get-url origin 2>/dev/null | sed 's|.*github.com[:/]||;s|\.git$||') 2>/dev/null | grep -q "refs/heads/"; then
          log_warn "github: repo reachability check failed — verify the repo exists and SSH access is configured"
        fi
        ;;
      gitee)
        if ! ssh -T -o StrictHostKeyChecking=no -o ConnectTimeout=5 git@gitee.com 2>&1 | grep -qE "successfully|Welcome|Permission denied"; then
          log_warn "gitee: SSH key check failed — run: ssh -T git@gitee.com"
        fi
        # Gitee reachability: check via git remote
        if ! git ls-remote --heads git@gitee.com:$(git remote get-url origin 2>/dev/null | sed 's|.*gitee.com[:/]||;s|\.git$||') 2>/dev/null | grep -q "refs/heads/"; then
          log_warn "gitee: repo reachability check failed — verify the repo exists and SSH access is configured"
        fi
        ;;
    esac
  done

  # AI tool is now configured via agent-table.toml (slot per role).
  # Model and approval posture come from the slot's own config file.
  # init only sets up ACP binaries and project paths — not AI tool/model/mode.
  local tool_adapter tool_adapter_policy
  tool_adapter_policy="$(resolve_tool_adapter_policy_for_project_or_global "$project" "" "$tool_adapter_policy_arg" "$tool_adapter_arg")"
  tool_adapter="$(resolve_tool_adapter_for_project_or_global "$project" "" "$tool_adapter_arg" "$tool_adapter_policy")"

  # ── Unified config.toml reader ──────────────────────────────────────
  # Gracefully handles missing config.toml (returns empty string).
  # With existing config: reads field by field, never modifies existing values.
  _read_config_value() {
    local _key="$1"
    [[ -n "$_key" ]] || { echo ""; return 0; }
    local _cfg="$project/.freely/config.toml"
    [[ -f "$_cfg" ]] || { echo ""; return 0; }
    python3 -c "
import sys, re
key = sys.argv[1]
try:
    with open(sys.argv[2]) as f:
        for line in f:
            m = re.match(r'^\s*' + re.escape(key) + r'\s*=\s*\"(.+)\"\s*$', line)
            if m:
                print(m.group(1))
                sys.exit(0)
except Exception:
    pass
sys.exit(1)
" "$_key" "$_cfg" 2>/dev/null || true
  }

  # ── ACP tool setup: discover/download ACP binaries for all registered tools ──
  # Reads tool-registry.toml, searches system PATH/cache, prompts for download,
  # writes binary paths to config.toml for runtime use.
  _init_acp_tool_setup() {
    local _auto_mode="${1:-false}"    # --auto: skip interactive confirmation
    local _reset_mode="${2:-false}"   # --reset: overwrite all config fields
    local registry="$SELF_ROOT/docs/system/workspace/scripts/runtime/tool-registry.toml"
    local registry_query="$SELF_ROOT/docs/system/workspace/scripts/runtime/tool-registry-query.py"
    local ensure_script="$SELF_ROOT/docs/system/workspace/scripts/runtime/ensure-acp-binary"
    [[ -f "$registry" ]] || { log_warn "tool-registry.toml not found, skipping ACP tool setup"; return 0; }

    # Discover all tool names from registry
    local -a _all_tools=()
    local _t
    while IFS= read -r _t; do
      [[ -n "$_t" ]] && _all_tools+=("$_t")
    done < <(python3 "$registry_query" "$registry" "_list_tools" "" 2>/dev/null || grep '^\[[a-z]' "$registry" 2>/dev/null | sed 's/^\[//;s/\]$//' | grep -v '\.' | sort -u || true)

    [[ ${#_all_tools[@]} -gt 0 ]] || { log_warn "no tools found in registry"; return 0; }

    log_info "ACP tool setup: checking ${#_all_tools[@]} tool(s) from registry..."
    local _tool _binary _method _url _found_path _config_key
    for _tool in "${_all_tools[@]}"; do
      _binary="$("$registry_query" "$registry" "$_tool" "acp.binary" 2>/dev/null || true)"
      [[ -n "$_binary" ]] || continue

      _method="$("$registry_query" "$registry" "$_tool" "acp.install_method" 2>/dev/null || true)"
      _url="$("$registry_query" "$registry" "$_tool" "acp.download_url" 2>/dev/null || true)"
      _config_key="FREELY_ACP_$(echo "$_tool" | tr '[:lower:]' '[:upper:]')_BIN"

      # 1. Check config.toml cache first — already configured, skip (unless --reset)
      _found_path=""
      if [[ "$_reset_mode" != "true" ]]; then
        _found_path="$(_read_config_value "$_config_key")"
      fi
      if [[ -n "$_found_path" && -x "$_found_path" ]]; then
        log_info "  $_tool: $_binary → $_found_path (config.toml)"
        continue
      fi

      # 2. Search system (PATH + cache)
      _found_path=""
      if command -v "$_binary" >/dev/null 2>&1; then
        _found_path="$(command -v "$_binary")"
      elif [[ -x "$HOME/.cache/freely/acp/$_tool"/*/*/"$_binary" ]] 2>/dev/null; then
        _found_path="$(ls -1 "$HOME/.cache/freely/acp/$_tool"/*/*/"$_binary" 2>/dev/null | head -1)"
      fi

      if [[ -n "$_found_path" && -x "$_found_path" ]]; then
        log_info "  $_tool: found $_binary at $_found_path → updating config.toml"
        upsert_config_key "$project" "$_config_key" "$_found_path"
        continue
      fi

      # 3. Not found — need download
      if [[ -z "$_method" || -z "$_url" ]]; then
        log_warn "  $_tool: $_binary not found, registry missing install_method/download_url — skipping"
        continue
      fi

      # 4. Confirm download
      if [[ "$_auto_mode" == "true" ]]; then
        log_info "  $_tool: --auto mode, downloading $_binary..."
      elif [[ -t 0 ]]; then
        printf '\n%s\n' "  $_tool: $_binary 未安装。从 $_method 下载？ [y/N]"
        read -r _confirm
        case "$_confirm" in
          [yY]|[yY][eE][sS]) ;;
          *) log_info "  $_tool: skipped by user"; continue ;;
        esac
      else
        log_info "  $_tool: non-interactive, skipping (use --auto to auto-download)"
        continue
      fi

      # Download via ensure-acp-binary
      if [[ -x "$ensure_script" ]]; then
        _found_path="$("$ensure_script" --tool "$_tool" 2>/dev/null)" || true
        if [[ -n "$_found_path" && -x "$_found_path" ]]; then
          log_info "  $_tool: installed to $_found_path → config.toml"
          upsert_config_key "$project" "$_config_key" "$_found_path"
        else
          log_warn "  $_tool: download failed, retry: $ensure_script --tool $_tool"
        fi
      else
        log_warn "  $_tool: ensure-acp-binary not found at $ensure_script"
      fi
    done
  }

  # ACP SDK pre-flight check: agent-client-protocol must be installed.
  # The ACP adapter uses the official SDK to communicate with AI CLI tools
  # (claude-agent-acp, codex-acp, opencode). Without it, daemon start will fail.
  if [[ "$tool_adapter" == "acp" ]]; then
    if ! python3 -c "from acp import Agent" 2>/dev/null; then
      cat <<SDK_HELP >&2
[$(date -u +"%Y-%m-%dT%H:%M:%SZ")] [ERROR] agent-client-protocol SDK not installed

  Freely 使用 Agent Client Protocol (ACP) 与 AI 工具通信。
  ACP adapter 需要官方 Python SDK 才能启动 AI 会话。

  安装命令:
    pip3 install agent-client-protocol

  如果系统使用 externally-managed Python (PEP 668):
    pip3 install --break-system-packages agent-client-protocol

  验证安装:
    python3 -c "from acp import Agent; print('OK')"

  当前适配器: $tool_adapter

SDK_HELP
      exit 1
    fi

    # Run ACP tool setup (discover/download all registered tools)
    _init_acp_tool_setup "$auto_mode" "$reset_mode"
  fi

  require_default_autonomy_activation_consent "$project" "$accept_default_autonomy"

  ensure_project_agents_md "$project"
  ensure_install_lifecycle_allowlist_file "$project"
  ensure_repo_hooks_enabled_or_fail "$project"
  sync_repo_hook_assets_from_source "$SELF_ROOT" "$project"

  # Release config.toml.example for reference — config.toml already created above.
  local _example_src="$SELF_ROOT/templates/config.toml.example"
  local _example_dst="$project/.freely/config.toml.example"
  if [[ -f "$_example_src" ]]; then
    cp "$_example_src" "$_example_dst"
  fi

  # ── Agent table template ──────────────────────────────────
  # Always release agent-table.toml (not .example) — it is the
  # active config file.  Slots use placeholder values pointing
  # users to create matching ~/.ai-auth/ subfolders.
  local _at_src="$SELF_ROOT/templates/agent-table.toml.example"
  local _at_dst="$project/.freely/agent-table.toml"
  if [[ -f "$_at_src" ]]; then
    if [[ -f "$_at_dst" ]]; then
      log_info "agent-table.toml already exists, skipping"
    else
      cp "$_at_src" "$_at_dst"
      log_info "agent-table.toml created — edit slot values to match ~/.ai-auth/ subfolders"
    fi
  fi

  # Release ai-auth slot templates to .freely/ai-auth/ for user reference.
  # Users should read README.md and use the .example files as templates
  # when creating their own ~/.ai-auth/ slots.
  local _ai_auth_src="$SELF_ROOT/templates/ai-auth"
  local _ai_auth_dst="$project/.freely/ai-auth"
  if [[ -d "$_ai_auth_src" ]]; then
    rm -rf "$_ai_auth_dst"
    cp -r "$_ai_auth_src" "$_ai_auth_dst"
    log_info "ai-auth slot templates released to .freely/ai-auth/"
    log_info "→ read .freely/ai-auth/README.md to configure AI CLI slots"
    log_info "→ then set AGENT_AI_TOOL via agent-table.toml slot configuration"
  fi

  # ── Write project .gitignore with template ignore rule ──
  # .freely/ must be ignored from day 1 — all runtime state lives there.
  local gitignore="$project/.gitignore"
  local _need_freely_ignore=1
  if [[ -f "$gitignore" ]]; then
    if grep -q '^\.freely/' "$gitignore" 2>/dev/null; then
      _need_freely_ignore=0
    fi
  fi
  if [[ ! -f "$gitignore" || "$force" == "true" ]]; then
    cat >"$gitignore" <<'EOF'
# Runtime state (managed by freely, never commit)
.freely/
.memark/
corpus/

# Local environment files
.env
.env.local
.env.*
!.env.example

# Dependencies
node_modules/

# Build outputs
dist/
build/
target/

# Logs and temp
*.log
*.pid
*.tmp

# Editor/OS
.DS_Store
.vscode/
.idea/
__pycache__/
EOF
  elif [[ "$_need_freely_ignore" == "1" ]]; then
    # Existing .gitignore doesn't have .freely/ — append it
    printf '\n# Runtime state (managed by freely, never commit)\n.freely/\n' >>"$gitignore"
    log_info ".gitignore: .freely/ appended to existing file"
  fi

  # ── Copy project templates to docs/ ──
  local template_dir="$SELF_ROOT/templates"
  if [[ -d "$template_dir" ]]; then
    for tmpl in "$template_dir"/*.md.template; do
      [[ -f "$tmpl" ]] || continue
      base_name="${tmpl##*/}"
      target_name="${base_name%.template}"
      target_file="$project/docs/$target_name"
      if [[ -f "$target_file" && "$force" != "true" ]]; then
        log_info "skip: $target_file already exists (use --force to overwrite)"
      else
        cp "$tmpl" "$target_file"
        project_dir_name="$(basename "$project")"
        sed -i '' "s/\$(project_name)/$project_dir_name/g" "$target_file"
        log_info "created: $target_file from template"
      fi
    done
  fi

  # Initialize freely.db via daemon (handles all tables including a2a_tasks)
  local freely_db=""$project/.freely/freely.db""
  local cli="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli"
  local daemon_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely_db_manager.py"

  # Start daemon (auto-creates all tables on first start)
  if ! python3 "$cli" --project "$project" db.ping >/dev/null 2>&1; then
    python3 "$daemon_py" start --project "$project" --foreground </dev/null >>"$project/.freely/run/db-daemon.log" 2>&1 &
    local _pid=$!
    disown "$_pid"
    for _ in $(seq 1 50); do
      python3 "$cli" --project "$project" db.ping >/dev/null 2>&1 && break
      sleep 0.1
    done
  fi
  ensure_a2a_server_running "$project"
  ensure_task_mode_gate "$project" "wait"
  log_info "init complete"
  echo ""
  echo "┌─ 下一步 ──────────────────────────────────────────────┐"
  echo "│  config.toml 已就绪（含自动填入的项目路径）              │"
  echo "│                                                        │"
  echo "│  1. 请编辑 .freely/config.toml，检查并补充必要配置:      │"
  echo "│    vim .freely/config.toml"
  echo "│    至少需确认: FREELY_REPO_PLATFORMS"
  echo "│                                                        │"
  echo "│  2. AI 工具通过 agent-table.toml 配置（非 config.toml):  │"
  echo "│    编辑 .freely/agent-table.toml 设置各 role 的 slot:     │"
  echo "│      manager_slot  = \"your-tool-apikey-name\"             │"
  echo "│      worker_slot   = \"your-tool-apikey-name\"             │"
  echo "│      reviewer_slot = \"your-tool-apikey-name\"             │"
  echo "│    slot 名对应 ~/.ai-auth/ 下的配置目录                    │"
  echo "│                                                        │"
  echo "│  3. 启动 freely:                                        │"
  echo "│    freely start --project $project"
  echo "└────────────────────────────────────────────────────────┘"
}

cmd_set_tool() {
