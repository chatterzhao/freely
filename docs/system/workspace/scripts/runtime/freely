request_local_continuation_reentry() {
  local project="$1" intake_id="$2"
  local ai_pid waited=0
  ai_pid="$(runtime_ai_pid_hint_for_project "$project")"
  [[ -n "$ai_pid" ]] || return 0
  if ! kill -0 "$ai_pid" 2>/dev/null; then
    return 0
  fi

  kill "$ai_pid" 2>/dev/null || true
  while kill -0 "$ai_pid" 2>/dev/null; do
    if (( waited >= 30 )); then
      kill -9 "$ai_pid" 2>/dev/null || true
      write_preemption_state "$project" "hard_kill_fallback" "local_continuation_reentry" "$intake_id" "$ai_pid"
      log_warn "forced hard-kill fallback for local continuation re-entry: intake=$intake_id pid=$ai_pid"
      return 0
    fi
    sleep 0.1
    waited=$((waited + 1))
  done

  write_preemption_state "$project" "graceful_term" "local_continuation_reentry" "$intake_id" "$ai_pid"
  log_info "triggered graceful local continuation re-entry for intake: $intake_id (ai pid=$ai_pid)"
}

terminate_pid_with_graceful_wait() {
  local pid="$1" label="$2"
  local waited=0
  [[ -n "$pid" ]] || return 0
  kill -0 "$pid" 2>/dev/null || return 0

  kill "$pid" 2>/dev/null || true
  while kill -0 "$pid" 2>/dev/null; do
    if (( waited >= 30 )); then
      kill -9 "$pid" 2>/dev/null || true
      log_warn "forced hard-kill fallback while repairing ${label}: pid=$pid"
      return 0
    fi
    sleep 0.1
    waited=$((waited + 1))
  done
  return 0
}

