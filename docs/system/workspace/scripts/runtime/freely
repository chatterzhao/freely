delegated_worker_startup_grace_secs() {
  local grace_secs
  grace_secs="${FREELY_MANAGER_STARTUP_LIFECYCLE_GRACE_SECS:-120}"
  [[ "$grace_secs" =~ ^[0-9]+$ ]] || grace_secs=120
  printf '%s\n' "$grace_secs"
}

delegated_worker_starting_stuck_for_reclaim() {
  local project="$1" supervisor_pid="${2:-}" ai_pid="${3:-}"
  local desired_state last_exit_reason last_state_updated_at state_updated_epoch now_epoch grace_secs

  [[ "$(effective_runtime_role_for_project "$project")" == "worker" ]] || return 1
  worker_project_has_launchable_verification_contract "$project" || return 1
  [[ -f "$(workcell_state_file "$project")" ]] || return 1
  [[ -z "$ai_pid" ]] || return 1

  unset DESIRED_RUNTIME_STATE LAST_EXIT_REASON LAST_STATE_UPDATED_AT
  # shellcheck disable=SC1090
  source "$(workcell_state_file "$project")"
  desired_state="${DESIRED_RUNTIME_STATE:-unknown}"
  last_exit_reason="${LAST_EXIT_REASON:-}"
  last_state_updated_at="${LAST_STATE_UPDATED_AT:-}"
  [[ "$desired_state" == "running" ]] || return 1
  [[ "$last_exit_reason" == "starting" ]] || return 1

  if [[ -n "$supervisor_pid" ]] && project_bootstrap_launch_in_flight "$project" "$supervisor_pid" ""; then
    return 1
  fi

  state_updated_epoch="$(timestamp_epoch_or_zero "$last_state_updated_at")"
  [[ "$state_updated_epoch" =~ ^[0-9]+$ ]] || state_updated_epoch=0
  (( state_updated_epoch > 0 )) || return 1

  now_epoch="$(date +%s)"
  grace_secs="$(delegated_worker_startup_grace_secs)"
  (( now_epoch - state_updated_epoch > grace_secs ))
}

reclaim_delegated_worker_starting_stuck_runtime_if_needed() {
  local project="$1" prompt_file="${2:-}"
  local run_dir supervisor_pid ai_pid watchdog_pid dispatcher_pid

  run_dir="$(run_dir_for_project "$project")"
  supervisor_pid="$(manager_supervisor_pid_for_project "$project")"
  ai_pid="$(runtime_ai_pid_hint_for_project "$project")"
  delegated_worker_starting_stuck_for_reclaim "$project" "$supervisor_pid" "$ai_pid" || return 1

  if [[ -n "$ai_pid" ]]; then
    terminate_pid_with_graceful_wait "$ai_pid" "delegated worker starting-stuck ai reclaim"
  fi
  if [[ -n "$supervisor_pid" ]]; then
    terminate_pid_with_graceful_wait "$supervisor_pid" "delegated worker starting-stuck supervisor reclaim"
    clear_supervisor_identity_truth "$project" "$supervisor_pid"
  fi
  dispatcher_pid="$(interruption_dispatcher_pid_for_project "$project")"
  [[ -n "$dispatcher_pid" ]] && terminate_pid_with_graceful_wait "$dispatcher_pid" "delegated worker starting-stuck interruption dispatcher reclaim"
  watchdog_pid="$(manager_watchdog_pid_for_project "$project")"
  [[ -n "$watchdog_pid" ]] && terminate_pid_with_graceful_wait "$watchdog_pid" "delegated worker starting-stuck manager watchdog reclaim"
  sse_watchdog_pid="$(sse_watchdog_pid_for_project "$project")"
  [[ -n "$sse_watchdog_pid" ]] && terminate_pid_with_graceful_wait "$sse_watchdog_pid" "delegated worker starting-stuck SSE watchdog reclaim"

  rm -f \
    "$run_dir/supervisor.pid" \
    "$run_dir/ai.pid" \
    "$(interruption_dispatcher_pid_file "$project")" \
    "$(ensure_manager_watchdog_pid_file "$project")" \
    "$(sse_watchdog_pid_file "$project")" \
    "$(session_state_file "$project")" \
    "$(exit_contract_file "$project")" \
    "$(stop_marker_file "$project")"
  write_workcell_state "$project" "stopped" "down" "down" "starting_stuck_reclaimed"
  append_runtime_event "$project" "delegated_worker_starting_stuck_reclaimed" \
    "prompt_file=${prompt_file:-none}" \
    "supervisor_pid=${supervisor_pid:-none}" \
    "ai_pid=${ai_pid:-none}"
  return 0
}

manager_worker_launch_state_reconcile_prompt_liveness() {
  local project="$1" continuity_file="$2"
  local state_file prompt_generated_csv launched_csv normalized_launched_csv queued_csv max_parallel_workers active_running_workers available_new_slots queued_prompt_blockers
  local discovered_active_running_workers
  local generated_continuity generated_prompts consumed_continuity updated_launched_csv prompt_file target_project needs_writeback="0"
  local worker_terminal="0"

  state_file="$(manager_worker_launch_state_file "$project")"
  [[ -f "$state_file" && -n "$continuity_file" && -f "$continuity_file" ]] || return 0
  # shellcheck disable=SC1090
  source "$state_file"
  generated_continuity="${LAST_MANAGER_CONTINUITY_GENERATED:-$continuity_file}"
  generated_prompts="${LAST_MANAGER_WORKER_PROMPTS_GENERATED:-}"
  consumed_continuity="${LAST_MANAGER_CONTINUITY_CONSUMED:-$continuity_file}"
  prompt_generated_csv="$(latest_manager_worker_prompt_csv_from_continuity "$continuity_file" || true)"
  launched_csv="${LAST_MANAGER_WORKER_PROMPTS_CONSUMED:-${LAUNCHED_WORKER_PROMPTS:-}}"
  normalized_launched_csv="$(csv_retain_exact_items "$launched_csv" "$prompt_generated_csv" || true)"
  updated_launched_csv=""

  if [[ -n "$normalized_launched_csv" ]]; then
    while IFS= read -r prompt_file; do
      [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
      target_project="$(worker_prompt_resolved_worktree "$project" "$prompt_file")"
      if [[ -n "$target_project" && -d "$target_project" ]] && reclaim_delegated_worker_starting_stuck_runtime_if_needed "$target_project" "$prompt_file"; then
        needs_writeback="1"
        continue
      fi
      worker_terminal="0"
      if [[ -n "$target_project" && -d "$target_project" ]]; then
        if worker_project_has_terminal_exit_contract "$target_project"; then
          worker_terminal="1"
        elif ! worker_prompt_launchable_for_manager_project "$project" "$prompt_file" \
          && ! worker_project_is_actively_running "$target_project"; then
          worker_terminal="1"
        fi
      else
        worker_terminal="1"
      fi
      if [[ "$worker_terminal" == "1" ]]; then
        needs_writeback="1"
        continue
      fi
      updated_launched_csv="$(csv_append_unique_item "$updated_launched_csv" "$prompt_file")"
    done < <(printf '%s\n' "$normalized_launched_csv" | tr ',' '\n')
  fi

  queued_csv="${QUEUED_WORKER_PROMPTS:-}"
  queued_prompt_blockers="${QUEUED_WORKER_PROMPT_BLOCKERS:-}"
  max_parallel_workers="$(manager_max_parallel_workers || true)"
  # Parse max:warn format (e.g., "10:7")
  local _max_workers="${max_parallel_workers%%:*}"
  local _warn_workers="${max_parallel_workers##*:}"
  [[ "$_max_workers" =~ ^[0-9]+$ ]] || _max_workers="10"
  [[ "$_warn_workers" =~ ^[0-9]+$ ]] || _warn_workers="7"
  max_parallel_workers="$_max_workers"
  # Reconcile zombie agent-id.env entries before counting (worktree gone but entry remains)
	    _agent_env="$source_project/.freely/agent-id.env"
  manager_reconcile_agent_id_env 2>/dev/null || true
  discovered_active_running_workers="$(count_active_running_workers_for_manager_project "$project" 2>/dev/null || true)"
  [[ "$discovered_active_running_workers" =~ ^[0-9]+$ ]] || discovered_active_running_workers="0"
  active_running_workers="$(manager_semantic_loop_active_worker_count_for_project "$project" || true)"
  if [[ -n "$normalized_launched_csv" && -z "$updated_launched_csv" ]]; then
    active_running_workers="$discovered_active_running_workers"
  fi
  if ! [[ "$active_running_workers" =~ ^[0-9]+$ ]]; then
    active_running_workers="0"
  fi
  if (( active_running_workers >= _max_workers )); then
    available_new_slots="0"
  else
    available_new_slots="$((_max_workers - active_running_workers))"
  fi

  if [[ "$needs_writeback" == "1" || "$updated_launched_csv" != "$normalized_launched_csv" ]]; then
    write_manager_worker_launch_state \
      "$project" \
      "$generated_continuity" \
      "${generated_prompts:-$prompt_generated_csv}" \
      "$consumed_continuity" \
      "${updated_launched_csv:-none}" \
      "$queued_csv" \
      "$max_parallel_workers" \
      "$active_running_workers" \
      "$available_new_slots" \
      "$queued_prompt_blockers"
  fi

  printf '%s\n' "${updated_launched_csv:-}"
  return 0
}

registered_projects_requiring_auth_change_wake() {
  local project desired_state role_hint
  while IFS= read -r project; do
    [[ -n "$project" && -d "$project" ]] || continue
    project_has_freely_config "$project" || continue
    desired_state="$(project_desired_runtime_state "$project")"
    [[ "$desired_state" == "running" ]] || continue
    role_hint="$(project_role_hint "$project")"
    [[ "$role_hint" == "manager" ]] || continue
    printf '%s\n' "$project"
  done < <(registered_projects)
}

append_global_auth_change_event() {
  local tool="$1" slot="$2" reason="$3"
  local log_file
  log_file="$(global_state_dir)/auth-change-events.log"
  mkdir -p "$(dirname "$log_file")"
  printf '%s event=auth_change tool=%q slot=%q reason=%q\n' "$(current_timestamp_utc_for_machine)" "${tool:-unknown}" "${slot:-}" "${reason:-unspecified}" >>"$log_file"
}

reset_project_auth_change_hold_state() {
  local project="$1" tool="$2"
  case "$tool" in
    codex)
      codex_clear_availability_state "$project"
      ;;
  esac
}

wake_registered_projects_for_auth_change() {
  local tool="$1" slot="$2" reason="$3"
  local project woke_count=0 skipped_count=0
  append_global_auth_change_event "$tool" "$slot" "$reason"
  while IFS= read -r project; do
    [[ -n "$project" ]] || continue
    if ! load_config "$project"; then
      skipped_count=$((skipped_count + 1))
      continue
    fi
    if [[ "${AGENT_AI_TOOL:-}" != "${tool:-}" ]]; then
      skipped_count=$((skipped_count + 1))
      continue
    fi
    reset_project_auth_change_hold_state "$project" "$tool"
    if ! FREELY_FORCE_WATCHDOG_REPROBE=1 ensure_manager_once "$project"; then
      skipped_count=$((skipped_count + 1))
      continue
    fi
    woke_count=$((woke_count + 1))
  done < <(registered_projects_requiring_auth_change_wake)
  printf 'woke=%s skipped=%s\n' "$woke_count" "$skipped_count"
}

compose_ai_spec() {
  local tool="$1" model="$2" mode="$3"
  [[ -n "$tool" ]] || return 1
  if [[ -n "$model" ]]; then
    printf '%s:%s:%s\n' "$tool" "$model" "${mode:-auto}"
  else
    printf '%s:%s\n' "$tool" "${mode:-auto}"
  fi
}

resolve_ai_spec_for_project_or_global() {
  local project="$1" explicit_ai_spec="${2:-}"
  local cfg tool model mode

  if [[ -n "$explicit_ai_spec" ]]; then
    printf '%s\n' "$explicit_ai_spec"
    return 0
  fi

  cfg="$(config_file "$project")"
  if [[ -f "$cfg" ]]; then
    unset AI_MODEL AI_MODE
    source_config "$project"
    tool="${AGENT_AI_TOOL:-}"
    model="${AI_MODEL:-}"
    mode="${AI_MODE:-auto}"
    if [[ -n "$tool" ]]; then
      compose_ai_spec "$tool" "$model" "$mode"
      return 0
    fi
  fi

  if source_global_config; then
    tool="${AGENT_AI_TOOL:-}"
    model="${AI_MODEL:-}"
    mode="${AI_MODE:-auto}"
    if [[ -n "$tool" ]]; then
      compose_ai_spec "$tool" "$model" "$mode"
      return 0
    fi
  fi

  if [[ -n "${FREELY_DEFAULT_AI:-}" ]]; then
    printf '%s\n' "$FREELY_DEFAULT_AI"
    return 0
  fi

  return 1
}

resolve_tool_adapter_policy_for_project_or_global() {
  local project="$1" tool="$2" explicit_tool_adapter_policy="${3:-}" explicit_tool_adapter="${4:-}"
  local cfg current_tool current_policy current_adapter

  if [[ -n "$explicit_tool_adapter_policy" ]]; then
    printf '%s\n' "$explicit_tool_adapter_policy"
    return 0
  fi

  if [[ -n "$explicit_tool_adapter" ]]; then
    printf '%s\n' "$explicit_tool_adapter"
    return 0
  fi

  cfg="$(config_file "$project")"
  if [[ -f "$cfg" ]]; then
    resolve_project_tool_adapter_policy_selection "$project" "$tool" "$explicit_tool_adapter_policy" "$explicit_tool_adapter"
    return 0
  fi

  if [[ -f "$(global_config_file)" ]]; then
    current_tool="$(
      (
        unset AGENT_AI_TOOL AGENT_AI_TOOL_ADAPTER AGENT_AI_TOOL_ADAPTER_POLICY
        source_global_config
        printf '%s' "${AGENT_AI_TOOL:-}"
      )
    )"
    current_policy="$(
      (
        unset AGENT_AI_TOOL AGENT_AI_TOOL_ADAPTER AGENT_AI_TOOL_ADAPTER_POLICY
        source_global_config
        printf '%s' "${AGENT_AI_TOOL_ADAPTER_POLICY:-}"
      )
    )"
    current_adapter="$(
      (
        unset AGENT_AI_TOOL AGENT_AI_TOOL_ADAPTER AGENT_AI_TOOL_ADAPTER_POLICY
        source_global_config
        printf '%s' "${AGENT_AI_TOOL_ADAPTER:-}"
      )
    )"
    if [[ "$current_tool" == "$tool" ]]; then
      if [[ -n "$current_policy" ]]; then
        printf '%s\n' "$current_policy"
        return 0
      fi
      if [[ -n "$current_adapter" ]]; then
        printf '%s\n' "$current_adapter"
        return 0
      fi
    fi
  fi

  tool_default_adapter_policy_for_runtime "$tool"
}

resolve_tool_adapter_for_project_or_global() {
  local project="$1" tool="$2" explicit_tool_adapter="${3:-}" explicit_tool_adapter_policy="${4:-}"
  local cfg current_tool current_adapter resolved_policy

  if [[ -n "$explicit_tool_adapter" ]]; then
    printf '%s\n' "$explicit_tool_adapter"
    return 0
  fi

  cfg="$(config_file "$project")"
  if [[ -f "$cfg" ]]; then
    resolve_project_tool_adapter_selection "$project" "$tool"
    return 0
  fi

  if [[ -f "$(global_config_file)" ]]; then
    current_tool="$(
      (
        unset AGENT_AI_TOOL AGENT_AI_TOOL_ADAPTER AGENT_AI_TOOL_ADAPTER_POLICY
        source_global_config
        printf '%s' "${AGENT_AI_TOOL:-}"
      )
    )"
    current_adapter="$(
      (
        unset AGENT_AI_TOOL AGENT_AI_TOOL_ADAPTER AGENT_AI_TOOL_ADAPTER_POLICY
        source_global_config
        printf '%s' "${AGENT_AI_TOOL_ADAPTER:-}"
      )
    )"
    if [[ -n "$current_adapter" && "$current_tool" == "$tool" ]]; then
