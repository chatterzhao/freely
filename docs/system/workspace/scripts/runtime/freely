  if [[ -n "$supervisor_pid" ]]; then
    launch_interruption_dispatcher "$project"
    ensure_interruption_dispatcher_ready_or_fail "$project" && return 0
    log_error "freely interruption control plane did not become ready for project: $project"
    log_error "try: ./bin/freely ensure-interruption-dispatch --project \"$project\" --watch"
    exit 1
  fi

  launch_interruption_dispatcher "$project"
  ensure_interruption_dispatcher_ready_or_fail "$project" && return 0

  log_error "freely could not auto-prepare interruption handling for project: $project"
  log_error "try: ./bin/freely ensure-interruption-dispatch --project \"$project\" --watch"
  log_error "or:  ./bin/freely start --project \"$project\""
  exit 1
}

restart_manager_supervisor_preserving_handoff() {
  local project="$1" run_dir ai_pid supervisor_pid
  run_dir="$(run_dir_for_project "$project")"
  ai_pid="$(manager_ai_pid_for_project "$project")"
  supervisor_pid="$(manager_supervisor_pid_for_project "$project")"
  if [[ -n "$ai_pid" ]]; then
    kill "$ai_pid" 2>/dev/null || true
    rm -f "$run_dir/ai.pid"
  fi
  if [[ -n "$supervisor_pid" ]]; then
    kill "$supervisor_pid" 2>/dev/null || true
    rm -f "$run_dir/supervisor.pid"
  fi
  for _ in $(seq 1 20); do
    if [[ -n "$supervisor_pid" ]] && kill -0 "$supervisor_pid" 2>/dev/null; then
      sleep 0.2
      continue
    fi
    break
  done
}

ensure_manager_once() {
  local project="$1"
  local run_dir sup_pid_file current_pid current_ai_pid same_tool_blocked desired_state last_exit_reason

  load_config "$project"
  run_dir="$(run_dir_for_project "$project")"
  sup_pid_file="$run_dir/supervisor.pid"
  mkdir -p "$run_dir"
  current_pid=""
  if [[ -f "$sup_pid_file" ]]; then
    current_pid="$(cat "$sup_pid_file" 2>/dev/null || true)"
    if ! valid_supervisor_pid_for_project "$project" "$current_pid"; then
      current_pid=""
    fi
  fi
  if [[ -z "$current_pid" ]]; then
    current_pid="$(discover_supervisor_pid "$project")"
  fi
  if [[ -n "$current_pid" ]]; then
    current_pid="$(manager_recheck_wait_for_supervisor_teardown_if_needed "$project" "$current_pid")"
  fi

  desired_state="unknown"
  last_exit_reason=""
  if [[ -f "$(workcell_state_file "$project")" ]]; then
    unset DESIRED_RUNTIME_STATE LAST_EXIT_REASON
    # shellcheck disable=SC1090
    source "$(workcell_state_file "$project")"
    desired_state="${DESIRED_RUNTIME_STATE:-unknown}"
    last_exit_reason="${LAST_EXIT_REASON:-}"
  fi
  if [[ "$desired_state" == "running" ]] && execution_network_launch_block_active "$project" "$last_exit_reason"; then
    log_warn "manager bootstrap paused by bounded network-recovery gate (reason=${last_exit_reason})"
    return 0
  fi

  same_tool_blocked="0"
  current_ai_pid="$(manager_ai_pid_for_project "$project")"
  if [[ -n "$current_pid" ]] && [[ -n "$current_ai_pid" ]]; then
    if recover_stalled_manager_ai_if_needed "$project"; then
      current_pid=""
      current_ai_pid=""
    fi
  fi
  if tool_supports_auto_same_tool_slot_recovery "${AI_TOOL:-}"; then
    if ! prepare_manager_same_tool_slot_recovery_if_needed "$project"; then
      if [[ "${TOOL_AUTO_RECOVERY_SAME_TOOL_EXHAUSTED:-0}" == "1" ]]; then
        same_tool_blocked="1"
        log_warn "no ${AI_TOOL:-unknown} slot is ready for manager bootstrap; checking cross-tool fallback policy"
      elif [[ "${TOOL_AUTO_RECOVERY_ENTRY_BLOCKED:-0}" == "1" ]]; then
        same_tool_blocked="1"
        log_warn "current ${AI_TOOL:-unknown} slot entry is unavailable; holding manager bootstrap until recovery path is ready"
      fi
    fi
  fi
  current_ai_pid="$(manager_ai_pid_for_project "$project")"
  if [[ "$same_tool_blocked" != "1" && -n "$current_pid" ]] && [[ -z "$current_ai_pid" ]]; then
    log_warn "manager supervisor is idle after recovery gate passed; restarting manager with the latest handoff"
    restart_manager_supervisor_preserving_handoff "$project"
    current_pid=""
  fi

  prepare_manager_cross_tool_fallback_if_needed "$project" "$same_tool_blocked" >/dev/null || true

  if [[ "${TOOL_AUTO_RECOVERY_DECISION:-none}" == "waiting" ]]; then
    log_warn "manager bootstrap remains blocked while every configured recovery path is unavailable"
    return 0
  fi

  if [[ "$same_tool_blocked" == "1" && "${TOOL_AUTO_RECOVERY_DECISION:-none}" != "selected" ]]; then
    log_warn "manager bootstrap skipped because no recovery-capable tool is ready"
    current_pid=""
    return 0
  fi

  if [[ -n "$current_pid" ]]; then
    manager_runtime_recover_workers_if_needed "$project" >/dev/null || true
    log_info "manager supervisor already running (pid=$current_pid)"
    return 0
  fi

  launch_manager_supervisor "$project"
  log_info "manager bootstrap requested"
}

