upsert_config_key() {
  local project="$1" key="$2" value="${3:-}"
  local cfg tmp escaped
  cfg="$(config_file "$project")"
  tmp="$(mktemp "${cfg}.XXXXXX")"
  escaped="$(config_env_escaped_value "$value")"
  awk -v key="$key" -v value="$escaped" '
    BEGIN { written=0 }
    index($0, key "=") == 1 {
      print key "=\"" value "\""
      written=1
      next
    }
    { print }
    END {
      if (!written) {
        print key "=\"" value "\""
      }
    }
  ' "$cfg" >"$tmp"
  mv "$tmp" "$cfg"
}

