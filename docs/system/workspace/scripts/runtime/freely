manager_continuity_cleanup_followthrough_intake_id() {
  local continuity_file="$1"
  [[ -f "$continuity_file" ]] || return 1
  python3 - "$continuity_file" <<'PY'
import re
import sys
from pathlib import Path

text = Path(sys.argv[1]).read_text(encoding="utf-8")
in_truth = False
for line in text.splitlines():
    if "delegated continuation truth" in line:
        in_truth = True
        continue
    if in_truth and line.startswith("## "):
        break
    if not in_truth:
        continue
    match = re.search(r"`([^`]+)`", line)
    if match:
        print(match.group(1))
        raise SystemExit(0)
raise SystemExit(1)
PY
}

