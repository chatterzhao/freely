  local develop_push_snapshot develop_push_state develop_push_summary develop_push_urgency develop_push_resync_required prompt_file prompt_intent_kind prompt_intent_target manager_generated_intents manager_consumed_intents intent_prompt_file
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project")"
  repo_root="$(git -C "$project" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$repo_root" ]] || { log_error "not a git repo: $project"; exit 1; }
  entries="$(git -C "$repo_root" worktree list --porcelain 2>/dev/null || true)"
  [[ -n "$entries" ]] || { log_error "no worktrees found for: $repo_root"; exit 1; }

  printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "branch" "tree" "sup" "ai" "dirty" "checkpoint" "path"
  printf "%s\n" "------------------------------------------------------------------------------------------------"
  while IFS='|' read -r wt_path wt_branch; do
    [[ -n "$wt_path" ]] || continue
    if [[ -n "$(git_status_porcelain_with_runtime_hygiene "$wt_path")" ]]; then
      wt_state="DIRTY"
    else
      wt_state="CLEAN"
    fi
    cfg="$(config_file "$wt_path")"
    supervisor_pid="none"
    ai_pid="none"
    last_launch="-"
    last_dirty="-"
    checkpoint_required="false"
    prompt_intent_kind="none"
    prompt_intent_target="none"
    ownership_holder_status="none"
    manager_generated_intents="none"
    manager_consumed_intents="none"
    restart_signal_reason="-"
    restart_signal_at="-"
    restart_summary="-"
    semantic_loop_summary="-"
    blocked_supervision_state="none"
    blocked_supervision_reason="none"
    blocked_supervision_summary="none"
    blocked_supervision_artifact="none"
      manager_continuity_gap_state="none"
      manager_continuity_gap_reason="none"
      manager_continuity_gap_expected="none"
      manager_continuity_gap_latest_generated="none"
      manager_continuity_gap_prompt_file="none"
      manager_continuity_gap_age_secs="none"
      manager_continuity_gap_age_state="none"
      manager_continuity_gap_summary="none"
    ownership_conflict_summary="none"
    manager_pending_ownership_conflicts="none"
    role_hint="unknown"
    if [[ -f "$cfg" ]]; then
      run_dir="$(run_dir_for_project "$wt_path")"
      session_state="$(session_state_file "$wt_path")"
      role_hint="$(role_hint_for_project "$wt_path")"
      if [[ -f "$(manager_worker_launch_state_file "$wt_path")" ]]; then
        manager_worker_launch_state_refresh_for_status "$wt_path" >/dev/null 2>&1 || true
      fi
      if [[ -f "$run_dir/supervisor.pid" ]]; then
        supervisor_pid="$(cat "$run_dir/supervisor.pid" 2>/dev/null || echo none)"
        if ! valid_supervisor_pid_for_project "$wt_path" "$supervisor_pid"; then
          supervisor_pid="none"
        fi
      fi
      if [[ -f "$run_dir/ai.pid" ]]; then
        ai_pid="$(cat "$run_dir/ai.pid" 2>/dev/null || echo none)"
        if ! valid_ai_pid_for_project "$wt_path" "$ai_pid"; then
          ai_pid="none"
        fi
      fi
      if [[ -f "$session_state" ]]; then
        # shellcheck disable=SC1090
        source "$session_state"
        last_launch="${LAST_LAUNCH_KIND:--}"
        last_dirty="${LAST_PROJECT_DIRTY_ENTRIES:-0}"
        restart_signal_reason="${LAST_RESTART_STORM_SIGNAL_REASON:--}"
        restart_signal_at="${LAST_RESTART_STORM_SIGNAL_AT:--}"
        restart_summary="storm=${restart_signal_reason} window=${LAST_RESTART_STORM_WINDOW_SECS:-0}s count=${LAST_RESTART_STORM_COUNT:-0} peak=${LAST_PROCESS_CHURN_PEAK:-0}"
      fi
      semantic_loop_signal="$(manager_semantic_loop_signal_snapshot_for_project "$wt_path" 2>/dev/null || true)"
      if [[ -n "$semantic_loop_signal" ]]; then
        local semantic_loop_reason semantic_loop_repeat_count
        IFS='|' read -r semantic_loop_reason semantic_loop_repeat_count _ _ <<<"$semantic_loop_signal"
        semantic_loop_summary="loop=${semantic_loop_reason} repeats=${semantic_loop_repeat_count:-0}"
      fi
      IFS='|' read -r blocked_supervision_state blocked_supervision_reason blocked_supervision_summary blocked_supervision_artifact <<<"$(blocked_supervision_snapshot_for_project "$wt_path")"
      local manager_handoff_state manager_handoff_reason manager_handoff_expected manager_handoff_latest_generated manager_handoff_prompt_file manager_handoff_writer manager_handoff_summary
      IFS='|' read -r manager_handoff_state manager_handoff_reason manager_handoff_expected manager_handoff_latest_generated manager_handoff_prompt_file manager_handoff_writer manager_handoff_summary <<<"$(manager_session_snapshot_for_project "$wt_path")"
      IFS='|' read -r manager_continuity_gap_state manager_continuity_gap_reason manager_continuity_gap_expected manager_continuity_gap_latest_generated manager_continuity_gap_prompt_file manager_continuity_gap_age_secs manager_continuity_gap_age_state manager_continuity_gap_summary <<<"$(manager_continuity_gap_snapshot_for_project "$wt_path")"
      develop_push_snapshot="$(develop_push_followthrough_snapshot_for_project "$wt_path")"
      IFS='|' read -r develop_push_state develop_push_summary _ _ _ _ _ _ _ _ _ develop_push_urgency develop_push_resync_required <<<"$develop_push_snapshot"
      prompt_file="$(find_latest_prompt_file_for_project "$wt_path")"
      intent_prompt_file="$(status_intent_prompt_file_for_project "$wt_path")"
      if [[ -n "$intent_prompt_file" && -f "$intent_prompt_file" ]]; then
        prompt_intent_kind="$(worker_prompt_normalized_intent_kind "$intent_prompt_file")"
        prompt_intent_target="$(worker_prompt_effective_intent_target "$wt_path" "$intent_prompt_file")"
        if worker_project_is_actively_running "$wt_path"; then
          ownership_holder_status="active"
        elif [[ "$role_hint" == "worker" ]] && [[ -n "$(project_current_blocking_intent_signature "$wt_path")" ]]; then
          ownership_holder_status="$(recorded_worker_ownership_status "$wt_path")"
        fi
      fi
      if [[ -f "$(manager_worker_launch_state_file "$wt_path")" ]]; then
        # shellcheck disable=SC1090
        source "$(manager_worker_launch_state_file "$wt_path")"
        manager_generated_intents="$(worker_prompt_intent_summary_csv "$wt_path" "${LAST_MANAGER_WORKER_PROMPTS_GENERATED:-none}")"
        manager_consumed_intents="$(worker_prompt_intent_summary_csv "$wt_path" "${LAST_MANAGER_WORKER_PROMPTS_CONSUMED:-none}")"
        if [[ "$role_hint" == "manager" ]]; then
          manager_pending_ownership_conflicts="$(manager_pending_ownership_conflicts_summary "$wt_path" "$(latest_generated_manager_continuity_file_for_project "$wt_path")" "${QUEUED_WORKER_PROMPTS:-none}")"
        fi
      fi
      ownership_conflict_summary="$(project_active_ownership_conflict_summary "$wt_path")"
      [[ -n "$ownership_conflict_summary" ]] || ownership_conflict_summary="none"
    else
      develop_push_state="not_applicable"
      develop_push_summary="config_missing"
      develop_push_urgency="none"
      develop_push_resync_required="false"
    fi
    checkpoint_json="$(checkpoint_guard_json_for_project "$wt_path")"
    checkpoint_required="$(checkpoint_guard_value "$checkpoint_json" checkpoint_required)"
    printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "$wt_branch" "$wt_state" "$supervisor_pid" "$ai_pid" "$last_dirty" "${checkpoint_required:-false}" "$wt_path"
    if [[ "$prompt_intent_kind" != "unknown" && "$prompt_intent_kind" != "none" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "intent" "" "${prompt_intent_kind}@${prompt_intent_target}"
    fi
    if [[ "$ownership_holder_status" != "none" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "ownership_holder" "" "${ownership_holder_status}"
    fi
    if [[ "$manager_generated_intents" != "none" || "$manager_consumed_intents" != "none" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "manager_intent" "" "generated=${manager_generated_intents} consumed=${manager_consumed_intents}"
    fi
    if [[ "$manager_pending_ownership_conflicts" != "none" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "manager_pending_conflict" "" "${manager_pending_ownership_conflicts}"
    fi
    if [[ "$ownership_conflict_summary" != "none" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "ownership_conflict" "" "${ownership_conflict_summary}"
    fi
    if [[ "$last_launch" != "-" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "launch=$last_launch" "" ""
    fi
    if [[ "$restart_signal_at" != "-" && -n "$restart_signal_at" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "$restart_signal_reason" "" "$restart_summary"
    fi
    if [[ "$semantic_loop_summary" != "-" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "semantic_loop" "" "$semantic_loop_summary"
    fi
    if [[ "$blocked_supervision_state" == "active" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "blocked_supervision" "" "reason=${blocked_supervision_reason:-unknown} ${blocked_supervision_summary:-none} artifact=${blocked_supervision_artifact:-none}"
    fi
    if [[ "$manager_handoff_state" != "none" && "$manager_handoff_state" != "materialized" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "manager_handoff" "" "state=${manager_handoff_state:-none} reason=${manager_handoff_reason:-none} expected=${manager_handoff_expected:-none} writer=${manager_handoff_writer:-none}"
    fi
    if [[ "$manager_continuity_gap_state" == "active" ]]; then
      local continuity_gap_writer_state
      if [[ -n "$ai_pid" && "$ai_pid" != "none" ]]; then
        continuity_gap_writer_state="authoritative_ai_running"
      else
        continuity_gap_writer_state="no_ai_process_evidence"
      fi
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "continuity_gap" "" "reason=${manager_continuity_gap_reason:-unknown} expected=${manager_continuity_gap_expected:-none} latest_generated=${manager_continuity_gap_latest_generated:-none} prompt=${manager_continuity_gap_prompt_file:-none} age_secs=${manager_continuity_gap_age_secs:-none} age_state=${manager_continuity_gap_age_state:-none} writer=${continuity_gap_writer_state}"
    fi
    if [[ "$develop_push_state" != "not_applicable" || "$develop_push_resync_required" == "true" ]]; then
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "develop_push" "" "${develop_push_state} ${develop_push_summary}"
      printf "%-16s | %-8s | %-8s | %-8s | %-10s | %-10s | %s\n" "" "" "" "" "push_urgency" "" "${develop_push_urgency} resync_required=${develop_push_resync_required}"
    fi
  done < <(printf '%s\n' "$entries" | awk '
    BEGIN { wt=""; br="(detached)" }
    /^worktree / { wt=substr($0, 10); br="(detached)" }
    /^branch / { br=$2; sub(/^refs\/heads\//, "", br) }
    /^$/ { if (wt != "") { print wt "|" br; wt=""; br="(detached)" } }
    END { if (wt != "") print wt "|" br }
  ')
}

cmd_develop_push() {
  local subcmd="${1:-}"
  [[ -n "$subcmd" ]] || { log_error "missing develop-push subcommand"; usage; exit 1; }
  shift || true

  local project="" reason="" note=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --reason) reason="${2:-}"; shift 2 ;;
      --note) note="${2:-}"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project")"

  case "$subcmd" in
    status)
      local snapshot state summary upstream ahead behind defer_reason defer_updated_at blocked_reason blocked_updated_at blocked_head blocked_note push_urgency resync_required
      snapshot="$(develop_push_followthrough_snapshot_for_project "$project")"
      IFS='|' read -r state summary upstream ahead behind defer_reason defer_updated_at blocked_reason blocked_updated_at blocked_head blocked_note push_urgency resync_required <<<"$snapshot"
      echo "project: $project"
      echo "develop_push_followthrough_state: $state"
      echo "develop_push_followthrough_summary: $summary"
      echo "develop_push_followthrough_upstream: $upstream"
      echo "develop_push_followthrough_ahead: $ahead"
      echo "develop_push_followthrough_behind: $behind"
      echo "develop_push_followthrough_defer_reason: $defer_reason"
      echo "develop_push_followthrough_defer_updated_at: $(format_timestamp_local_for_display "$defer_updated_at")"
      echo "develop_push_followthrough_blocked_reason: $blocked_reason"
      echo "develop_push_followthrough_blocked_updated_at: $(format_timestamp_local_for_display "$blocked_updated_at")"
      echo "develop_push_followthrough_blocked_head: $blocked_head"
      echo "develop_push_followthrough_blocked_note: $blocked_note"
      echo "develop_push_followthrough_push_urgency: $push_urgency"
      echo "develop_push_followthrough_resync_required: $resync_required"
      ;;
    attempt)
      local snapshot branch state summary upstream ahead behind defer_reason defer_updated_at blocked_reason blocked_updated_at blocked_head blocked_note push_urgency resync_required head push_output attempt_reason attempt_note
      branch="$(branch_name_for_project "$project")"
      [[ "$branch" == "develop" ]] || {
        log_error "develop-push attempt only applies to canonical develop"
        exit 1
      }
      snapshot="$(develop_push_followthrough_snapshot_for_project "$project")"
      IFS='|' read -r state summary upstream ahead behind defer_reason defer_updated_at blocked_reason blocked_updated_at blocked_head blocked_note push_urgency resync_required <<<"$snapshot"
      if [[ "$state" == "push_deferred" ]]; then
        log_error "develop-push is explicitly deferred; clear defer before attempt"
        exit 1
      fi
      if [[ "$state" == "clean" || "$state" == "not_applicable" ]]; then
        echo "project: $project"
        echo "develop_push_followthrough_state: $state"
        echo "develop_push_followthrough_summary: $summary"
        echo "attempt_status: skipped"
        exit 0
      fi
      head="$(git -C "$project" rev-parse HEAD 2>/dev/null || true)"
      set +e
      push_output="$(git -C "$project" push 2>&1)"
      local push_rc=$?
      set -e
      if [[ "$push_rc" -eq 0 ]]; then
        develop_push_followthrough_refresh_upstream_tracking_ref_after_success "$project" "$head" || true
        clear_develop_push_attempt_state "$project"
        clear_develop_push_followthrough_state "$project"
        snapshot="$(develop_push_followthrough_snapshot_for_project "$project")"
        IFS='|' read -r state summary upstream ahead behind defer_reason defer_updated_at blocked_reason blocked_updated_at blocked_head blocked_note push_urgency resync_required <<<"$snapshot"
        echo "project: $project"
        echo "attempt_status: pushed"
        echo "develop_push_followthrough_state: $state"
        echo "develop_push_followthrough_summary: $summary"
        [[ -n "$push_output" ]] && echo "push_result: $(develop_push_followthrough_normalize_note "$push_output")"
        exit 0
      fi
      attempt_reason="$(develop_push_attempt_reason_from_output "$push_output")"
      attempt_note="$(develop_push_followthrough_normalize_note "$(printf '%s\n' "$push_output" | tail -n 20)")"
      write_develop_push_attempt_state "$project" "$attempt_reason" "$attempt_note" "$head"
      snapshot="$(develop_push_followthrough_snapshot_for_project "$project")"
      IFS='|' read -r state summary upstream ahead behind defer_reason defer_updated_at blocked_reason blocked_updated_at blocked_head blocked_note push_urgency resync_required <<<"$snapshot"
      echo "project: $project"
      echo "attempt_status: blocked"
      echo "develop_push_followthrough_state: $state"
      echo "develop_push_followthrough_summary: $summary"
      echo "develop_push_followthrough_blocked_reason: $blocked_reason"
      echo "develop_push_followthrough_blocked_updated_at: $(format_timestamp_local_for_display "$blocked_updated_at")"
      echo "develop_push_followthrough_blocked_head: $blocked_head"
      echo "develop_push_followthrough_blocked_note: $blocked_note"
      return 1
      ;;
    defer)
      if ! develop_push_defer_reason_is_valid "$reason"; then
        log_error "unsupported --reason: ${reason:-<empty>}"
        log_error "supported reasons: post_merge_acceptance cleanup_followthrough remote_delivery_hold"
        exit 1
      fi
      write_develop_push_followthrough_state "$project" "$reason" "$note"
      echo "project: $project"
      echo "defer_reason: $reason"
      echo "defer_note: ${note:-none}"
      echo "state_file: $(develop_push_followthrough_state_file "$project")"
      ;;
    clear)
      clear_develop_push_followthrough_state "$project"
      clear_develop_push_attempt_state "$project"
      echo "project: $project"
      echo "state_file: $(develop_push_followthrough_state_file "$project")"
      echo "attempt_state_file: $(develop_push_attempt_state_file "$project")"
      echo "status: cleared"
      ;;
    *)
      log_error "unknown develop-push subcommand: $subcmd"
      usage
      exit 1
      ;;
  esac
}

cmd_stop() {
  local project=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project")"
  stop_project_runtime "$project" "operator_stop"
  log_info "stopped (if running)"
}

