delegated_continuation_freshness_floor_epoch_for_project() {
  local project="$1" continuity_file continuity_epoch operator_stop_epoch
  if [[ "${FREELY_CACHED_DELEGATED_CONTINUITY_FLOOR_PROJECT:-}" == "$project" && "${FREELY_CACHED_DELEGATED_CONTINUITY_FLOOR_READY:-0}" == "1" ]]; then
    printf '%s\n' "${FREELY_CACHED_DELEGATED_CONTINUITY_FLOOR_EPOCH:-0}"
    return 0
  fi
  continuity_file="$(delegated_continuation_freshness_floor_file_for_project "$project")"
  continuity_epoch="0"
  if [[ -n "$continuity_file" && -f "$continuity_file" ]]; then
    continuity_epoch="$(file_mtime_epoch "$continuity_file" 2>/dev/null || true)"
  fi
  [[ "$continuity_epoch" =~ ^[0-9]+$ ]] || continuity_epoch="0"
  operator_stop_epoch="$(manager_operator_stop_boundary_epoch_for_project "$project")"
  [[ "$operator_stop_epoch" =~ ^[0-9]+$ ]] || operator_stop_epoch="0"
  if (( operator_stop_epoch > continuity_epoch )); then
    continuity_epoch="$operator_stop_epoch"
  fi
  FREELY_CACHED_DELEGATED_CONTINUITY_FLOOR_PROJECT="$project"
  FREELY_CACHED_DELEGATED_CONTINUITY_FLOOR_READY="1"
  FREELY_CACHED_DELEGATED_CONTINUITY_FLOOR_EPOCH="$continuity_epoch"
  printf '%s\n' "$continuity_epoch"
}

delegated_continuation_snapshot_for_project() {
  local project="$1" limit="${2:-3}"
  local intake_root item_dir meta_file message_file resolution_file status absorption_target delegated_worktree message summary count project_real delegated_real session_refs active_consumed_ids intake_id created_at item_epoch continuity_floor_epoch
  intake_root="$(intake_dir_for_project "$project")"
  [[ -d "$intake_root" ]] || return 0
  project_real="$(cd "$project" && pwd -P)"
  active_consumed_ids="$(active_prompt_consumed_delegation_ids_for_project "$project")"
  continuity_floor_epoch="$(delegated_continuation_freshness_floor_epoch_for_project "$project")"
  count=0
  while IFS= read -r item_dir; do
    meta_file="$item_dir/meta.env"
    message_file="$item_dir/message.txt"
    [[ -f "$meta_file" && -f "$message_file" ]] || continue
    load_meta_env_snapshot "$meta_file"
    status="$LOADED_META_STATUS"
    absorption_target="$LOADED_META_ABSORPTION_TARGET"
    delegated_worktree="$LOADED_META_DELEGATED_WORKTREE"
    session_refs="$LOADED_META_SESSION_REFS"
    [[ "$status" == "delegated" ]] || continue
    [[ "$absorption_target" == "handoff://continuation" ]] || continue
    # Older delegated continuations belong to earlier supervision rounds. They may
    # remain in durable intake history until explicitly absorbed, but they must not
    # be auto-reinjected into the current manager lane unless a newer continuity
    # or fresh claim carries them forward again.
    created_at="$LOADED_META_CREATED_AT"
    item_epoch="$(timestamp_epoch_or_zero "$created_at")"
    if [[ ! "$item_epoch" =~ ^[0-9]+$ || "$item_epoch" -le 0 ]]; then
      item_epoch="$(file_mtime_epoch "$meta_file" 2>/dev/null || true)"
    fi
    [[ "$item_epoch" =~ ^[0-9]+$ ]] || item_epoch="0"
    if (( continuity_floor_epoch > 0 && item_epoch > 0 && item_epoch <= continuity_floor_epoch )); then
      continue
    fi
    delegated_real=""
    if [[ -n "$delegated_worktree" ]]; then
      delegated_real="$(cd "$delegated_worktree" 2>/dev/null && pwd -P || true)"
    fi
    if [[ -n "$delegated_real" && "$delegated_real" != "$project_real" ]]; then
      continue
    fi
    intake_id="$(basename "$item_dir")"
    if [[ -n "$active_consumed_ids" ]] && csv_contains_exact_item "$active_consumed_ids" "$intake_id"; then
      continue
    fi
    message="$(tr '\n' ' ' <"$message_file" | sed 's/  */ /g')"
    printf -- '- intake_id=%s message=%s\n' "$intake_id" "$message"
    if [[ -n "$session_refs" && "$session_refs" != "[]" ]]; then
      printf '  session_refs=%s\n' "$session_refs"
    fi
    resolution_file="$LOADED_META_RESOLUTION_ARTIFACT"
    if [[ -n "$resolution_file" && -f "$resolution_file" ]]; then
      summary="$(tr '\n' ' ' <"$resolution_file" | sed 's/  */ /g')"
      printf '  resolution=%s\n' "$summary"
    fi
    count=$((count + 1))
    if (( count >= limit )); then
      break
    fi
  done < <(find "$intake_root" -mindepth 1 -maxdepth 1 -type d | sort -r)
}

