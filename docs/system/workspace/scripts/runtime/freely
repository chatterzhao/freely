discover_supervisor_pid() {
  local project="$1" excluded_pids="${2:-}"
  ps -axo pid=,command= | awk -v p="$project" -v excluded="$excluded_pids" '
    BEGIN {
      split(excluded, raw, ",")
      for (i in raw) {
        if (raw[i] != "") {
          skip[raw[i]] = 1
        }
      }
    }
    index($0, "runtime/freely start") {
      if (skip[$1]) {
        next
      }
      for (i = 1; i <= NF; i++) {
        if ($i == "--project" && (i + 1) <= NF && $(i + 1) == p) {
          print $1
          exit
        }
        if (index($i, "--project=") == 1 && substr($i, 11) == p) {
          print $1
          exit
        }
      }
    }
  '
}

pid_matches_project() {
  local pid="$1" project="$2" expected="$3"
  local cmd cwd project_real
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  cmd="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  [[ -n "$cmd" ]] || return 1
  project_real="$(cd "$project" 2>/dev/null && pwd -P || true)"
  if [[ -n "$expected" ]] && [[ "$cmd" != *"$expected"* ]]; then
    return 1
  fi
  awk -v p="$project" -v pr="$project_real" -v e="$expected" '
    index($0, e) {
      for (i = 1; i <= NF; i++) {
        if (($i == "--project" || $i == "-C") && (i + 1) <= NF && ($(i + 1) == p || (pr != "" && $(i + 1) == pr))) {
          found=1
        }
        if (index($i, "--project=") == 1 && (substr($i, 11) == p || (pr != "" && substr($i, 11) == pr))) {
          found=1
        }
      }
    }
    END { exit found ? 0 : 1 }
  ' <<<"$cmd" && return 0
  cwd="$(lsof -a -d cwd -p "$pid" -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1)"
  [[ "$cwd" == "$project" || (-n "$project_real" && "$cwd" == "$project_real") ]]
}

