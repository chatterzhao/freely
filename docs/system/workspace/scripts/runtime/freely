    return 0
  fi
  fallback_seconds="${CODEX_RATE_LIMIT_FALLBACK_COOLDOWN_SECS:-300}"
  [[ "$fallback_seconds" =~ ^[0-9]+$ ]] || fallback_seconds=300
  date -v+"${fallback_seconds}"S +%s 2>/dev/null || date -d "@$(( $(date +%s) + fallback_seconds ))" +%s 2>/dev/null || printf '%s\n' "$(( $(date +%s) + fallback_seconds ))"
