cmd_intake_resolve() {
  local project="" intake_id="" resolved_by="" reaction="" classification="" linked_artifact="pending://resolution-unlinked" delegated_worktree="" resolution_file="" absorption_target="" status="absorbed"
  local session_refs_override=""
  local meta_file claimed_by claimed_at reaction_existing classification_existing delegated_existing linked_existing resolution_content resolution_dir resolution_artifact
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --intake-id) intake_id="${2:-}"; shift 2 ;;
      --resolved-by) resolved_by="${2:-}"; shift 2 ;;
      --reaction) reaction="${2:-}"; shift 2 ;;
      --classification) classification="${2:-}"; shift 2 ;;
      --linked-artifact) linked_artifact="${2:-}"; shift 2 ;;
      --delegated-worktree) delegated_worktree="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --resolution-file) resolution_file="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --absorption-target) absorption_target="${2:-}"; shift 2 ;;
      --status) status="${2:-}"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  [[ -n "$intake_id" && -n "$resolved_by" && -n "$reaction" && -n "$resolution_file" && -n "$absorption_target" ]] || { usage; exit 1; }
  project="$(resolve_project_or_fail "$project" 1)"
  [[ -f "$resolution_file" ]] || { log_error "resolution file not found: $resolution_file"; exit 1; }
  validate_reaction_or_fail "$reaction"
  validate_absorption_classification_or_fail "$classification"
  validate_intake_status_or_fail "$status"
  load_config "$project"
  load_session_state_or_defaults "$project"
  case "$status" in
    delegated|absorbed|dropped) ;;
    *)
      log_error "intake resolve only supports --status delegated|absorbed|dropped"
      exit 1
      ;;
  esac
  meta_file="$(intake_item_meta_file "$project" "$intake_id")"
  [[ -f "$meta_file" ]] || { log_error "intake item not found: $intake_id"; exit 1; }
  claimed_by="$(meta_env_value "$meta_file" "CLAIMED_BY")"
  claimed_at="$(meta_env_value "$meta_file" "CLAIMED_AT")"
  reaction_existing="$(meta_env_value "$meta_file" "REACTION")"
  classification_existing="$(meta_env_value "$meta_file" "CLASSIFICATION")"
  delegated_existing="$(meta_env_value "$meta_file" "DELEGATED_WORKTREE")"
  linked_existing="$(meta_env_value "$meta_file" "LINKED_ARTIFACT")"
  [[ -n "$classification" ]] || classification="$classification_existing"
  [[ -n "$delegated_worktree" ]] || delegated_worktree="$delegated_existing"
  if [[ "$linked_artifact" == "pending://resolution-unlinked" && -n "$linked_existing" ]]; then
    linked_artifact="$linked_existing"
  fi
  if [[ -z "$reaction" && -n "$reaction_existing" ]]; then
    reaction="$reaction_existing"
  fi
  resolution_content="$(cat "$resolution_file")"
  resolution_dir="$(
    write_interruption_resolution_artifact \
      "$project" "$intake_id" "$resolved_by" "$reaction" "$classification" "$absorption_target" "$linked_artifact" "$delegated_worktree" "$status" "$resolution_content"
  )"
  resolution_artifact="$resolution_dir/resolution.md"
  if [[ "$status" == "delegated" && "$absorption_target" == "handoff://continuation" ]]; then
    session_refs_override="$(current_workcell_session_refs)"
  fi
  rewrite_existing_intake_item \
    "$project" "$intake_id" "$status" "$classification" "$linked_artifact" "$delegated_worktree" "$reaction" "${claimed_by:-$resolved_by}" "${claimed_at:-$(date -u '+%Y-%m-%dT%H:%M:%SZ')}" "$absorption_target" "$resolution_artifact" "$session_refs_override"
  if [[ "$status" == "delegated" && "$absorption_target" == "handoff://continuation" ]]; then
    local project_real delegated_real
    project_real="$(cd "$project" && pwd -P)"
    delegated_real=""
    if [[ -n "$delegated_worktree" ]]; then
      delegated_real="$(cd "$delegated_worktree" 2>/dev/null && pwd -P || true)"
    fi
    if [[ -z "$delegated_real" || "$delegated_real" == "$project_real" ]]; then
      request_local_continuation_reentry "$project" "$intake_id"
    fi
  fi
  log_info "intake resolved: $intake_id"
  echo "intake_id: $intake_id"
  echo "status: $status"
  echo "resolution_artifact: $resolution_artifact"
}

