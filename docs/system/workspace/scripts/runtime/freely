write_session_handoff() {
  local project="$1" rotation_reason="$2"
  local out_file branch tail_lines
  out_file="$(handoff_file "$project")"
  branch="$(git -C "$project" branch --show-current 2>/dev/null || true)"
  tail_lines="${SESSION_HANDOFF_TAIL_LINES:-80}"

  cat >"$out_file" <<EOF
# Session Handoff

- rotation_reason: $rotation_reason
- previous_launch_kind: ${LAST_LAUNCH_KIND:-unknown}
- previous_tool_session_id: ${LAST_TOOL_SESSION_ID:-unavailable}
- previous_tool_jsonl_path: ${LAST_TOOL_JSONL_PATH:-unavailable}
- previous_cycle_log: ${LAST_CYCLE_LOG:-unavailable}
- previous_context_compacted: ${LAST_CONTEXT_COMPACTED:-0}
- previous_context_ratio: ${LAST_CONTEXT_RATIO:-unavailable}
- previous_route_only_handoff: ${LAST_ROUTE_ONLY_HANDOFF:-0}
- previous_project_dirty_entries: ${LAST_PROJECT_DIRTY_ENTRIES:-0}
- previous_worktree_summary_total: ${LAST_WORKTREE_SUMMARY_TOTAL:-0}
- previous_worktree_summary_dirty: ${LAST_WORKTREE_SUMMARY_DIRTY:-0}
- previous_checkpoint_drift_streak: ${CHECKPOINT_DRIFT_STREAK_CURRENT:-0}
- branch: ${branch:-unknown}
- worktree_path: $project

## Continuity Guard
- If the previous cycle compacted or approached a local context threshold, update the phase-appropriate continuity artifact before expanding implementation.
- Treat explicit `context compacted` / compact / compression signals as a stop-and-summarize trigger, even for tools without structured context metrics.
- If the current issue boundary is already verified, prefer a checkpoint commit before adding more scope.

## Summary Target Hint
$(context_summary_target_hint "$project")

## Recent Output Excerpt
EOF

  if [[ -n "${LAST_CYCLE_LOG:-}" && -f "$LAST_CYCLE_LOG" ]]; then
    tail -n "$tail_lines" "$LAST_CYCLE_LOG" >>"$out_file"
  else
    printf 'unavailable://no-previous-cycle-log\n' >>"$out_file"
  fi

  if [[ "${LAST_ROUTE_ONLY_HANDOFF:-0}" == "1" ]]; then
    local extracted_next_prompt
    extracted_next_prompt="$(extract_route_only_next_prompt_from_log "$LAST_CYCLE_LOG")"
    cat >>"$out_file" <<EOF

## Route-Only Next Prompt
EOF
    if [[ -n "$extracted_next_prompt" ]]; then
      printf '%s\n' "$extracted_next_prompt" >>"$out_file"
    else
      printf 'unavailable://route-only-next-prompt-not-found\n' >>"$out_file"
    fi
  fi

  local fleet_snapshot
  fleet_snapshot="$(fleet_status_text_for_project "$project")"
  if [[ -n "$fleet_snapshot" ]]; then
    cat >>"$out_file" <<EOF

## Fleet Snapshot
\`\`\`
$fleet_snapshot
\`\`\`
EOF
  fi
}

