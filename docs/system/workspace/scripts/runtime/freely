#!/usr/bin/env bash
set -euo pipefail

TOOL_NAME="freely"
STATE_DIR_NAME=".freely"
SELF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"

log_info() { echo "[INFO] $*"; }
log_warn() { echo "[WARN] $*"; }
log_error() { echo "[ERROR] $*" >&2; }

WATCHDOG_CONTROL_PLANE_SKILL_ROOT="$SELF_ROOT/docs/system/workspace/skills/watchdog-control-plane"
WATCHDOG_AVAILABILITY_LIB="$WATCHDOG_CONTROL_PLANE_SKILL_ROOT/scripts/availability-watchdog.sh"
[[ -f "$WATCHDOG_AVAILABILITY_LIB" ]] || {
  echo "[ERROR] missing watchdog availability module: $WATCHDOG_AVAILABILITY_LIB" >&2
  exit 1
}
source "$WATCHDOG_AVAILABILITY_LIB"

usage() {
  cat <<'EOF'
Usage:
  freely init --project <abs_path> --intent <abs_file> --constitution <abs_file> --ai <tool[:model][:mode]> [--reasoning-effort <effort>]
  freely doctor --project <abs_path>
  freely ensure-manager --project <abs_path> [--watch] [--interval <seconds>]
  freely start --project <abs_path>
  freely status --project <abs_path>
  freely fleet-status --project <abs_path>
  freely stop --project <abs_path>

AI mode:
  auto  -> non-interactive, auto-approve (where supported)
  step  -> interactive/approval mode
EOF
}

check_doc_gate_or_fail() {
  local project="$1"
  local failed=0
  local required=(
    "docs/PROJECT_INTENT.md"
    "docs/CONSTITUTION.md"
    "docs/LAWS.md"
    "AGENTS.md"
    "docs/pre-brainstorms/README.md"
    "docs/pre-brainstorms/INDEX.md"
    "docs/pre-brainstorms/CONVERGENCE.md"
  )

  for rel in "${required[@]}"; do
    if [[ ! -f "$project/$rel" ]]; then
      log_error "doc gate failed: missing $project/$rel"
      failed=1
    fi
  done

  if [[ ! -d "$project/docs/pre-brainstorms" ]]; then
    log_error "doc gate failed: missing $project/docs/pre-brainstorms"
    failed=1
  fi

  if [[ "$failed" -ne 0 ]]; then
    return 1
  fi

  log_info "doc gate PASS"
}

abs_path_or_fail() {
  local p="$1"
  if [[ "$p" != /* ]]; then
    log_error "path must be absolute: $p"
    exit 1
  fi
  echo "$p"
}

parse_ai_spec() {
  local spec="$1"
  local tool="" model="" mode="auto"
  local first="" second="" third=""

  IFS=':' read -r first second third <<<"$spec"
  tool="$first"
  [[ -n "${tool:-}" ]] || { log_error "invalid --ai spec: $spec"; exit 1; }

  if [[ -n "${third:-}" ]]; then
    model="$second"
    mode="$third"
  elif [[ "$second" == "auto" || "$second" == "step" ]]; then
    model=""
    mode="$second"
  else
    model="${second:-}"
    mode="auto"
  fi

  [[ "$mode" == "auto" || "$mode" == "step" ]] || {
    log_error "unsupported mode: $mode (supported: auto, step)"
    exit 1
  }

  case "$tool" in
    codex|kiro-cli|iflow) ;;
    *)
      log_error "unsupported tool: $tool (supported: codex, kiro-cli, iflow)"
      exit 1
      ;;
  esac

  echo "$tool|$model|$mode"
}

