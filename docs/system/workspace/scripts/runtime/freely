manager_other_worker_holds_blocking_intent_signature() {
  local project="$1" exclude_project="$2" signature="$3" active_only="${4:-false}"
  local wt_path current_signature recorded_status
  [[ -n "$signature" ]] || return 1
  while IFS= read -r wt_path; do
    [[ -n "$wt_path" && -d "$wt_path" ]] || continue
    [[ "$wt_path" == "$exclude_project" ]] && continue
    [[ "$(role_hint_for_project "$wt_path")" == "worker" ]] || continue
    if [[ "$active_only" == "true" ]]; then
      worker_project_is_actively_running "$wt_path" || continue
    elif ! worker_project_is_actively_running "$wt_path"; then
      recorded_status="$(recorded_worker_ownership_status "$wt_path")"
      [[ "$recorded_status" == "hard_stale" ]] && continue
    fi
    current_signature="$(project_current_blocking_intent_signature "$wt_path")"
    [[ -n "$current_signature" && "$current_signature" == "$signature" ]] || continue
    return 0
  done < <(all_repo_worktrees_for_project "$project")
  return 1
}

manager_other_worker_project_for_blocking_intent_signature() {
