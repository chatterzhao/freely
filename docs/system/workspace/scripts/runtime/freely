reconcile_control_plane_processes_for_active_runtime() {
  local project="$1" role pid pid_file
  role="$(effective_runtime_role_for_project "$project")"

  pid_file="$(interruption_dispatcher_pid_file "$project")"
  if [[ -f "$pid_file" ]]; then
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && project_owned_interruption_dispatcher_pid_for_project "$project" "$pid" && ! valid_interruption_dispatcher_pid_for_project "$project" "$pid"; then
      terminate_pid_with_graceful_wait "$pid" "project interruption dispatcher runtime-source reconcile"
      rm -f "$pid_file"
    fi
  fi
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    valid_interruption_dispatcher_pid_for_project "$project" "$pid" && continue
    terminate_pid_with_graceful_wait "$pid" "project interruption dispatcher runtime-source reconcile"
  done < <(discover_interruption_dispatcher_pids "$project")

  pid_file="$(ensure_manager_watchdog_pid_file "$project")"
  if [[ -f "$pid_file" ]]; then
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && project_owned_manager_watchdog_pid_for_project "$project" "$pid"; then
      if [[ "$role" != "manager" ]] || ! valid_ensure_manager_watchdog_pid_for_project "$project" "$pid"; then
        terminate_pid_with_graceful_wait "$pid" "project manager watchdog runtime-source reconcile"
        rm -f "$pid_file"
      fi
    fi
  fi
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    if [[ "$role" == "manager" ]] && valid_ensure_manager_watchdog_pid_for_project "$project" "$pid"; then
      continue
    fi
    terminate_pid_with_graceful_wait "$pid" "project manager watchdog runtime-source reconcile"
  done < <(discover_manager_watchdog_pids "$project")

  pid_file="$(sse_watchdog_pid_file "$project")"
  if [[ -f "$pid_file" ]]; then
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && project_owned_sse_watchdog_pid_for_project "$project" "$pid" && ! valid_sse_watchdog_pid_for_project "$project" "$pid"; then
      terminate_pid_with_graceful_wait "$pid" "project SSE watchdog runtime-source reconcile"
      rm -f "$pid_file"
    fi
  fi
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    valid_sse_watchdog_pid_for_project "$project" "$pid" && continue
    terminate_pid_with_graceful_wait "$pid" "project SSE watchdog runtime-source reconcile"
  done < <(discover_sse_watchdog_pids "$project")
}

