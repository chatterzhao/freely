            "lock_path=${CURRENT_SLOT_SWITCH_LOCK_PATH:-unknown}" \
            "timeout_secs=$timeout_secs"
          return 1
        fi
        sleep "$interval_secs"
        ;;
      ambiguous)
        log_error "ambiguous codex slot-switch lock blocks freely start (detail=${CURRENT_SLOT_SWITCH_LOCK_DETAIL:-unknown} owner_pid=${CURRENT_SLOT_SWITCH_LOCK_OWNER_PID:-none} path=${CURRENT_SLOT_SWITCH_LOCK_PATH:-unknown})"
        append_runtime_event "$project" "startup_slot_switch_lock_ambiguous" \
          "lock_state=${CURRENT_SLOT_SWITCH_LOCK_STATE:-ambiguous}" \
          "lock_detail=${CURRENT_SLOT_SWITCH_LOCK_DETAIL:-unknown}" \
          "lock_owner_pid=${CURRENT_SLOT_SWITCH_LOCK_OWNER_PID:-none}" \
          "lock_started_at=${CURRENT_SLOT_SWITCH_LOCK_STARTED_AT:-none}" \
          "lock_reason=${CURRENT_SLOT_SWITCH_LOCK_REASON:-none}" \
          "lock_path=${CURRENT_SLOT_SWITCH_LOCK_PATH:-unknown}"
        return 1
        ;;
      *)
        log_error "unknown codex slot-switch lock state blocks freely start: ${CURRENT_SLOT_SWITCH_LOCK_STATE:-unknown}"
        return 1
        ;;
    esac
  done
}

