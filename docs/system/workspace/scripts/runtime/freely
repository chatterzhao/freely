check_doc_gate_or_fail() {
  local project="$1"
  local failed=0
  local required=(
    "docs/PROJECT_INTENT.md"
    "docs/CONSTITUTION.md"
    "docs/LAWS.md"
    "AGENTS.md"
    "docs/pre-brainstorms/README.md"
    "docs/pre-brainstorms/INDEX.md"
    "docs/pre-brainstorms/CONVERGENCE.md"
  )

  for rel in "${required[@]}"; do
    if [[ ! -f "$project/$rel" ]]; then
      log_error "doc gate failed: missing $project/$rel"
      failed=1
    fi
  done

  if [[ ! -d "$project/docs/pre-brainstorms" ]]; then
    log_error "doc gate failed: missing $project/docs/pre-brainstorms"
    failed=1
  fi

  if [[ "$failed" -ne 0 ]]; then
    return 1
  fi

  log_info "doc gate PASS"
}

check_hook_gate_or_fail() {
  local project="$1"
  local repo_root current_hooks_path

  repo_root="$(git_root_for_path "$project")"
  if [[ -z "$repo_root" ]]; then
    log_error "hook gate failed: not a git repo: $project"
    return 1
  fi

  if [[ ! -d "$repo_root/.githooks" ]]; then
    log_error "hook gate failed: missing $repo_root/.githooks"
    return 1
  fi

  current_hooks_path="$(git -C "$repo_root" config --get core.hooksPath 2>/dev/null || true)"
  if [[ "$current_hooks_path" != ".githooks" ]]; then
    log_error "hook gate failed: core.hooksPath is '${current_hooks_path:-<unset>}' (expected .githooks)"
    log_error "run: git -C \"$repo_root\" config core.hooksPath .githooks"
    return 1
  fi

  log_info "hook gate PASS"
}

check_build_artifact_gate_or_fail() {
  local project="$1"
  if [[ ! -x "$BUILD_ARTIFACT_AUDIT_SCRIPT" ]]; then
    log_error "build artifact gate failed: missing audit script $BUILD_ARTIFACT_AUDIT_SCRIPT"
    return 1
  fi
  bash "$BUILD_ARTIFACT_AUDIT_SCRIPT" --project "$project"
}

check_supply_chain_gate_or_fail() {
  local project="$1"
  if [[ ! -x "$SUPPLY_CHAIN_AUDIT_SCRIPT" ]]; then
    log_error "supply-chain gate failed: missing audit script $SUPPLY_CHAIN_AUDIT_SCRIPT"
    exit 1
  fi
  bash "$SUPPLY_CHAIN_AUDIT_SCRIPT" --project "$project"
}

ensure_repo_hooks_enabled_or_fail() {
  local project="$1"
  local repo_root

  repo_root="$(git_root_for_path "$project")"
  if [[ -z "$repo_root" ]]; then
    log_error "cannot enable hooks outside a git repo: $project"
    exit 1
  fi

  if [[ ! -d "$repo_root/.githooks" ]]; then
    log_error "cannot enable hooks: missing $repo_root/.githooks"
    exit 1
  fi

  git -C "$repo_root" config core.hooksPath .githooks
  log_info "enabled git hooks: $repo_root/.githooks"
}

abs_path_or_fail() {
  local p="$1"
  if [[ "$p" != /* ]]; then
    log_error "path must be absolute: $p"
    exit 1
  fi
  echo "$p"
}

parse_ai_spec() {
  local spec="$1"
  local tool="" model="" mode="auto"
  local first="" second="" third=""

  IFS=':' read -r first second third <<<"$spec"
  tool="$first"
  [[ -n "${tool:-}" ]] || { log_error "invalid --ai spec: $spec"; exit 1; }

  if [[ -n "${third:-}" ]]; then
    model="$second"
    mode="$third"
  elif [[ "$second" == "auto" || "$second" == "step" ]]; then
    model=""
    mode="$second"
  else
    model="${second:-}"
    mode="auto"
  fi

  [[ "$mode" == "auto" || "$mode" == "step" ]] || {
    log_error "unsupported mode: $mode (supported: auto, step)"
    exit 1
  }

  case "$tool" in
    codex|kiro-cli|iflow|cc|cc-use-codex-cli) ;;
    *)
      log_error "unsupported tool: $tool (supported: codex, kiro-cli, iflow, cc, cc-use-codex-cli)"
      exit 1
      ;;
  esac

  echo "$tool|$model|$mode"
}

