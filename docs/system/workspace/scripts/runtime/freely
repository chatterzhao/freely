  local project="" repo_root manifest_dir history_file latest_file manifest_timestamp rows_file
  local selection_output selected_csv="" blocked_csv=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project")"
  repo_root="$(git_root_for_path "$project")"
  [[ -n "$repo_root" ]] || {
    log_error "global restart requires a git-backed project root"
    exit 1
  }

  manifest_dir="$(global_restart_manifest_dir)"
  mkdir -p "$manifest_dir"
  rows_file="$(mktemp "$manifest_dir/rows.XXXXXX")"
  collect_global_restart_snapshot_rows "$repo_root" >"$rows_file"
  latest_file="$(global_restart_manifest_latest_file)"
  manifest_timestamp="$(global_restart_manifest_timestamp)"
  history_file="$(global_restart_manifest_history_file "$manifest_timestamp")"
  write_global_restart_manifest "$repo_root" "$manifest_timestamp" "$history_file" "$latest_file" "$rows_file"
  retain_latest_global_restart_history "$(global_restart_manifest_history_dir)" "$(global_restart_history_retention)"

  selection_output="$(python3 - "$rows_file" <<'PY'
import sys

rows_file = sys.argv[1]
selected = []
blocked = []
with open(rows_file, encoding="utf-8") as handle:
    for raw in handle:
        raw = raw.rstrip("\n")
        if not raw:
            continue
        fields = raw.split("\t")
        while len(fields) < 14:
            fields.append("")
        project_path = fields[0]
        restore_candidate = fields[11]
        restore_ready = fields[12]
        if restore_candidate == "1" and restore_ready == "1":
            selected.append(project_path)
        elif restore_candidate == "1":
            blocked.append(project_path)
print(",".join(selected))
print(",".join(blocked))
PY
)"
  selected_csv="$(printf '%s\n' "$selection_output" | sed -n '1p')"
  blocked_csv="$(printf '%s\n' "$selection_output" | sed -n '2p')"
  rm -f "$rows_file"

  if [[ -n "$blocked_csv" ]]; then
    log_error "global restart blocked: one or more previously-running projects are missing mandatory restore anchors"
    printf 'global_restart_manifest: %s\n' "$history_file"
    printf 'blocked_restore_projects: %s\n' "$blocked_csv"
    exit 1
  fi

  if [[ -z "$selected_csv" ]]; then
    log_info "global restart manifest recorded with no previously-running projects to restore"
    printf 'global_restart_manifest: %s\n' "$history_file"
    printf 'restored_projects: none\n'
    return 0
  fi

  IFS=',' read -r -a __restart_projects <<<"$selected_csv"
  for project_path in "${__restart_projects[@]}"; do
    [[ -n "$project_path" ]] || continue
    stop_project_runtime "$project_path" "global_restart"
  done
  for project_path in "${__restart_projects[@]}"; do
    [[ -n "$project_path" ]] || continue
    start_project_runtime "$project_path"
  done

  printf 'global_restart_manifest: %s\n' "$history_file"
  printf 'restored_projects: %s\n' "$selected_csv"
}

latest_interruption_resolution_file_for_project() {
  local project="$1" resolution_dir
  resolution_dir="$(interruption_resolution_dir_for_project "$project")"
  [[ -d "$resolution_dir" ]] || return 0
  find "$resolution_dir" -mindepth 2 -maxdepth 2 -type f -name 'resolution.md' | sort | tail -n 1
}

stop_project_runtime() {
  local project="$1" stop_reason="${2:-operator_stop}"
  local sdir run_dir
  sdir="$(state_dir "$project")"
  run_dir="$(run_dir_for_project "$project")"
  mkdir -p "$run_dir"
  : >"$(stop_marker_file "$project")"

  if [[ -f "$run_dir/ai.pid" ]]; then
    local ap
    ap="$(cat "$run_dir/ai.pid" 2>/dev/null || true)"
    if valid_ai_pid_for_project "$project" "$ap"; then
      terminate_pid_with_graceful_wait "$ap" "project ai pid during stop"
    elif [[ -n "$ap" ]]; then
      log_warn "ignoring stale ai.pid that is not owned by project: $ap"
    fi
    rm -f "$run_dir/ai.pid"
  fi
  if [[ -f "$(ensure_manager_watchdog_pid_file "$project")" ]]; then
    local wp
    wp="$(cat "$(ensure_manager_watchdog_pid_file "$project")" 2>/dev/null || true)"
    if valid_ensure_manager_watchdog_pid_for_project "$project" "$wp"; then
      terminate_pid_with_graceful_wait "$wp" "project manager watchdog during stop"
    fi
    rm -f "$(ensure_manager_watchdog_pid_file "$project")"
  fi
  if [[ -f "$(interruption_dispatcher_pid_file "$project")" ]]; then
    local dp
    dp="$(cat "$(interruption_dispatcher_pid_file "$project")" 2>/dev/null || true)"
    if valid_interruption_dispatcher_pid_for_project "$project" "$dp"; then
      terminate_pid_with_graceful_wait "$dp" "project interruption dispatcher during stop"
    fi
    rm -f "$(interruption_dispatcher_pid_file "$project")"
  fi
  if [[ -f "$run_dir/supervisor.pid" ]]; then
    local sp
    sp="$(cat "$run_dir/supervisor.pid" 2>/dev/null || true)"
    if valid_supervisor_pid_for_project "$project" "$sp"; then
      terminate_pid_with_graceful_wait "$sp" "project supervisor during stop"
    fi
    rm -f "$run_dir/supervisor.pid"
  else
    local sp
    sp="$(discover_supervisor_pid "$project")"
    terminate_pid_with_graceful_wait "$sp" "discovered project supervisor during stop"
  fi
  rm -f "$(session_state_file "$project")" "$(handoff_file "$project")"
  rm -f "$(stop_marker_file "$project")"
  write_workcell_state "$project" "stopped" "down" "down" "$stop_reason"
}

resolve_active_supervisor_pid_for_start() {
  local project="$1" sup_pid_file="$2"
  local candidate_pid="" excluded_pids=""
  LAST_ATTACH_REUSE_SUPERVISOR_SOURCE=""
  excluded_pids="${BASHPID:-$$},${PPID:-}"
  if [[ -f "$sup_pid_file" ]]; then
    candidate_pid="$(cat "$sup_pid_file" 2>/dev/null || true)"
    if valid_supervisor_pid_for_project "$project" "$candidate_pid"; then
      LAST_ATTACH_REUSE_SUPERVISOR_SOURCE="supervisor_pid_file"
      printf '%s\n' "$candidate_pid"
      return 0
    fi
    if [[ -n "$candidate_pid" ]]; then
      log_warn "ignoring stale supervisor.pid that is not owned by project: $candidate_pid"
      rm -f "$sup_pid_file"
    fi
  fi

  candidate_pid="$(discover_supervisor_pid "$project" "$excluded_pids")"
  if valid_supervisor_pid_for_project "$project" "$candidate_pid"; then
    log_warn "recovered live project supervisor after supervisor.pid drift: $candidate_pid"
    LAST_ATTACH_REUSE_SUPERVISOR_SOURCE="process_discovery"
    printf '%s\n' "$candidate_pid" >"$sup_pid_file"
    printf '%s\n' "$candidate_pid"
  fi
}

ensure_no_active_supervisor_conflict() {
  local project="$1" sup_pid_file="$2" child_pid_file="$3" allow_attach="${4:-0}"
  local old_pid="" attach_ai_pid_state="missing" role_hint
  LAST_ATTACH_REUSE_SUPERVISOR_PID=""
  LAST_ATTACH_REUSE_AI_PID_STATE="missing"
  old_pid="$(resolve_active_supervisor_pid_for_start "$project" "$sup_pid_file")"
  if [[ -n "$old_pid" ]]; then
    if [[ "$allow_attach" == "1" ]]; then
      role_hint="$(role_hint_for_project "$project")"
      if [[ -f "$child_pid_file" ]]; then
        local active_ai_pid
        active_ai_pid="$(cat "$child_pid_file" 2>/dev/null || true)"
        if [[ -n "$active_ai_pid" ]] && ! valid_ai_pid_for_project "$project" "$active_ai_pid"; then
          attach_ai_pid_state="stale_pid_cleared"
          log_warn "clearing stale ai.pid while reusing healthy project supervisor: $active_ai_pid"
          rm -f "$child_pid_file"
        elif [[ -n "$active_ai_pid" ]]; then
          attach_ai_pid_state="confirmed_running"
        fi
      fi
      if ! ensure_interruption_dispatcher_ready_or_fail "$project"; then
        log_warn "project supervisor pid=$old_pid is live but interruption dispatcher is not ready; falling back to project-local repair"
      elif [[ "$role_hint" == "manager" ]] && ! ensure_manager_watchdog_ready_or_fail "$project"; then
        log_warn "project supervisor pid=$old_pid is live but manager watchdog is not ready; falling back to project-local repair"
      elif [[ "$role_hint" == "manager" && "$attach_ai_pid_state" != "confirmed_running" ]]; then
        log_warn "project supervisor pid=$old_pid is live but manager ai pid is ${attach_ai_pid_state}; falling back to project-local repair"
      elif [[ "$role_hint" == "worker" && "$attach_ai_pid_state" != "confirmed_running" ]]; then
        log_warn "project supervisor pid=$old_pid is live but worker ai pid is ${attach_ai_pid_state}; falling back to project-local repair"
      else
        LAST_ATTACH_REUSE_SUPERVISOR_PID="$old_pid"
        LAST_ATTACH_REUSE_AI_PID_STATE="$attach_ai_pid_state"
        log_info "project runtime/control-plane already up; reusing supervisor pid=$old_pid"
        return 10
      fi
    fi
    log_warn "repairing partial project control-plane before supervisor restart: $old_pid"
    terminate_pid_with_graceful_wait "$old_pid" "partial project control-plane before supervisor restart"
    rm -f "$sup_pid_file"
  fi
  if [[ -f "$child_pid_file" ]]; then
    local active_ai_pid
    active_ai_pid="$(cat "$child_pid_file" 2>/dev/null || true)"
    if valid_ai_pid_for_project "$project" "$active_ai_pid"; then
      log_warn "repairing orphaned project ai pid before supervisor restart: $active_ai_pid"
      terminate_pid_with_graceful_wait "$active_ai_pid" "orphaned project ai pid before supervisor restart"
    elif [[ -n "$active_ai_pid" ]]; then
      log_warn "ignoring stale ai.pid before supervisor restart: $active_ai_pid"
    fi
    rm -f "$child_pid_file"
  fi
  return 0
}

start_project_runtime() {
  local project="$1"
  load_config "$project"
  register_project_in_registry "$project"
  check_doc_gate_or_fail "$project" || {
    log_error "start blocked by doc gate"
    exit 1
  }

  local sdir run_dir logs_dir sup_pid_file child_pid_file loop_log
  local stop_requested=0
  local LAST_WORKCELL_EXIT_REASON="supervisor_exit"
  local DESIRED_RUNTIME_STATE_VALUE="running"
  sdir="$(state_dir "$project")"
  run_dir="$(run_dir_for_project "$project")"
  logs_dir="$(logs_dir_for_project "$project")"
  sup_pid_file="$run_dir/supervisor.pid"
  child_pid_file="$run_dir/ai.pid"
  loop_log="$logs_dir/loop.log"
  mkdir -p "$run_dir" "$logs_dir"
  rm -f "$(stop_marker_file "$project")"
  LAST_ATTACH_REUSE_SUPERVISOR_PID=""
  LAST_ATTACH_REUSE_SUPERVISOR_SOURCE=""
  LAST_ATTACH_REUSE_AI_PID_STATE="missing"
  local supervisor_conflict_rc=0
  ensure_no_active_supervisor_conflict "$project" "$sup_pid_file" "$child_pid_file" "1" || supervisor_conflict_rc=$?
  if [[ "$supervisor_conflict_rc" -eq 10 ]]; then
    write_workcell_state "$project" "running" "up" "up" "already_running_attach"
    append_runtime_event "$project" "supervisor_attach_reuse" \
      "supervisor_pid=${LAST_ATTACH_REUSE_SUPERVISOR_PID:-unknown}" \
      "supervisor_pid_source=${LAST_ATTACH_REUSE_SUPERVISOR_SOURCE:-unknown}" \
      "ai_pid_state=${LAST_ATTACH_REUSE_AI_PID_STATE:-missing}" \
      "role_hint=$(role_hint_for_project "$project")"
    return 0
  elif [[ "$supervisor_conflict_rc" -ne 0 ]]; then
    exit "$supervisor_conflict_rc"
  fi

  request_stop() {
    stop_requested=1
    LAST_WORKCELL_EXIT_REASON="operator_stop"
    DESIRED_RUNTIME_STATE_VALUE="stopped"
    : >"$(stop_marker_file "$project")"
    append_runtime_event "$project" "operator_stop_requested" \
      "supervisor_pid=$$" \
      "child_pid_file=$child_pid_file"
    if [[ -f "$child_pid_file" ]]; then
      local active_child
      active_child="$(cat "$child_pid_file" 2>/dev/null || true)"
      append_runtime_event "$project" "operator_stop_signal_child" \
        "supervisor_pid=$$" \
        "child_pid=${active_child:-unknown}"
      [[ -n "$active_child" ]] && kill "$active_child" 2>/dev/null || true
    fi
  }

  cleanup_supervisor() {
    append_runtime_event "$project" "supervisor_cleanup" \
      "supervisor_pid=$$" \
      "desired_state=${DESIRED_RUNTIME_STATE_VALUE:-stopped}" \
      "exit_reason=${LAST_WORKCELL_EXIT_REASON:-supervisor_exit}" \
      "stop_requested=$stop_requested"
    rm -f "$sup_pid_file" "$child_pid_file" "$(stop_marker_file "$project")"
    write_workcell_state "$project" "${DESIRED_RUNTIME_STATE_VALUE:-stopped}" "down" "down" "${LAST_WORKCELL_EXIT_REASON:-supervisor_exit}"
    if [[ "${DESIRED_RUNTIME_STATE_VALUE:-stopped}" == "running" ]] && [[ "$(role_hint_for_project "$project")" == "manager" ]]; then
      launch_interruption_dispatcher "$project"
      launch_manager_control_plane_recheck "$project"
    fi
  }

  echo "$$" >"$sup_pid_file"
  append_runtime_event "$project" "supervisor_started" \
    "supervisor_pid=$$" \
    "project=$project" \
    "role_hint=$(role_hint_for_project "$project")"
  write_workcell_state "$project" "running" "up" "down" "starting"
  trap cleanup_supervisor EXIT
  trap request_stop INT TERM
  launch_interruption_dispatcher "$project"
  ensure_interruption_dispatcher_ready_or_fail "$project" || {
    log_error "freely interruption dispatcher did not become ready for project: $project"
    log_error "try: ./bin/freely ensure-interruption-dispatch --project \"$project\" --watch"
    exit 1
  }
  if [[ "$(role_hint_for_project "$project")" == "manager" ]]; then
    launch_manager_watchdog "$project"
    ensure_manager_watchdog_ready_or_fail "$project" || {
      log_error "freely manager watchdog did not become ready for project: $project"
      log_error "try: ./bin/freely ensure-manager --project \"$project\" --watch"
      exit 1
    }
  fi

  local restart_count=0
  local FIRST_ROUND=true
  local LAUNCH_KIND_SELECTED="" LAUNCH_ROTATION_REASON=""
  load_session_state_or_defaults "$project"
  while true; do
    local ts prompt_file cycle_log cycle_debug_log mode_name watchdog_script workspace_root
    local delegated_pending_ids delegated_pending_count delegated_consumed_ids delegated_consumed_at
    ts="$(date '+%Y%m%d-%H%M%S')"
    prompt_file="$run_dir/prompt-$ts.txt"
    cycle_log="$logs_dir/cycle-$ts.log"
    cycle_debug_log="$logs_dir/cycle-$ts.debug.log"
    workspace_root="$(workspace_root_for_project "$PROJECT_ROOT")"
    local recovered_workers
    watchdog_script="$workspace_root/scripts/runtime/manager-watchdog.sh"
    if [[ -x "$watchdog_script" ]]; then
      recovered_workers="$(bash "$watchdog_script" --project "$PROJECT_ROOT" --recover-expected-workers 2>/dev/null || true)"
    else
      recovered_workers="$(manager_runtime_recover_workers_if_needed "$PROJECT_ROOT")"
    fi
    if [[ "${recovered_workers:-0}" =~ ^[0-9]+$ ]] && (( recovered_workers > 0 )); then
      log_info "manager runtime auto-recovered $recovered_workers expected-running worker(s) before prompt build"
      append_runtime_event "$PROJECT_ROOT" "worker_auto_recovered" \
        "supervisor_pid=$$" \
        "recovered_workers=$recovered_workers"
      sleep "${RESTART_DELAY:-2}"
    fi
    select_launch_kind
    mode_name="$LAUNCH_KIND_SELECTED"
    ensure_runtime_tool_session_anchor "$AI_TOOL" "$mode_name"
    delegated_pending_ids="$(delegated_continuation_ids_for_project "$PROJECT_ROOT")"
    delegated_pending_count="$(csv_item_count "$delegated_pending_ids")"
    delegated_consumed_ids="${LAST_DELEGATED_CONTINUATION_CONSUMED_IDS:-}"
    delegated_consumed_at="${LAST_DELEGATED_CONTINUATION_CONSUMED_AT:-}"

    if [[ "$mode_name" == "fresh_with_handoff" ]]; then
      write_session_handoff "$PROJECT_ROOT" "$LAUNCH_ROTATION_REASON"
      log_info "rotating session via fresh_with_handoff (reason=$LAUNCH_ROTATION_REASON)"
    fi
    build_prompt >"$prompt_file"
    if [[ -n "$delegated_pending_ids" ]] && grep -q '^Delegated continuation handoff:' "$prompt_file" 2>/dev/null; then
      delegated_consumed_ids="$delegated_pending_ids"
      delegated_consumed_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    fi
    LAST_DELEGATED_CONTINUATION_PENDING_IDS="$delegated_pending_ids"
    LAST_DELEGATED_CONTINUATION_PENDING_COUNT="$delegated_pending_count"
    LAST_DELEGATED_CONTINUATION_CONSUMED_IDS="$delegated_consumed_ids"
    LAST_DELEGATED_CONTINUATION_CONSUMED_AT="$delegated_consumed_at"
    write_session_state "$project" "$LAST_TOOL_SESSION_ID" "$LAST_TOOL_RESUME_TARGET" "$LAST_TOOL_JSONL_PATH" "$LAST_LAUNCH_KIND" "$LAST_ROTATION_REASON" "$LAST_CYCLE_LOG" "$LAST_CONTEXT_COMPACTED" "$LAST_CONTEXT_RATIO" "$LAST_PRIMARY_RATE_LIMIT_USED_PERCENT" "$LAST_PRIMARY_RATE_LIMIT_RESETS_AT" "$LAST_SECONDARY_RATE_LIMIT_USED_PERCENT" "$LAST_SECONDARY_RATE_LIMIT_RESETS_AT" "$LAST_ROUTE_ONLY_HANDOFF" "$ROUTE_ONLY_STREAK_CURRENT" "$RESUME_STREAK_CURRENT" "$(runtime_read_tool_current_slot "$project" "$AI_TOOL")" "$LAST_SLOT_SWITCH_REASON" "$LAST_SLOT_SWITCH_AT" "$LAST_CYCLE_DEBUG_LOG" "$LAST_CLAUDE_JSONL_PATH" "$LAST_CODEX_MCP_USED" "$LAST_CODEX_MCP_THREAD_ID" "$LAST_CODEX_MCP_JSONL_PATH" "${CLAUDE_SESSION_ID_CURRENT:-}" "${CLAUDE_SESSION_ID_PREVIOUS:-}" "$LAST_PROJECT_DIRTY_ENTRIES" "$LAST_WORKTREE_SUMMARY_TOTAL" "$LAST_WORKTREE_SUMMARY_DIRTY" "$CHECKPOINT_DRIFT_STREAK_CURRENT" "$LAST_DELEGATED_CONTINUATION_PENDING_IDS" "$LAST_DELEGATED_CONTINUATION_PENDING_COUNT" "$LAST_DELEGATED_CONTINUATION_CONSUMED_IDS" "$LAST_DELEGATED_CONTINUATION_CONSUMED_AT" "${LAST_RESTART_STORM_WINDOW_SECS:-0}" "${LAST_RESTART_STORM_COUNT:-0}" "${LAST_PROCESS_CHURN_PEAK:-0}" "${LAST_RESTART_STORM_SIGNAL_AT:-}" "${LAST_RESTART_STORM_SIGNAL_REASON:-}" "${LAST_RESTART_STORM_ESCALATED_AT:-}" "${LAST_RESTART_STORM_ESCALATION_TARGET:-}"
    if [[ "$mode_name" == "fresh" || "$mode_name" == "fresh_with_handoff" ]]; then
      rm -f "$(handoff_file "$PROJECT_ROOT")"
    fi

    local tool_adapter
    tool_adapter="${AI_TOOL_ADAPTER:-$(tool_default_adapter_for_runtime "$AI_TOOL")}"
    log_info "launching $AI_TOOL via ${tool_adapter:-unknown} ($mode_name mode, ai_mode=$AI_MODE)"
    append_runtime_event "$project" "ai_launch_begin" \
      "supervisor_pid=$$" \
      "tool=$AI_TOOL" \
      "tool_adapter=${tool_adapter:-unknown}" \
      "launch_kind=$mode_name" \
      "rotation_reason=${LAUNCH_ROTATION_REASON:-none}" \
      "prompt_file=$prompt_file" \
      "cycle_log=$cycle_log"
    set +e
    {
      echo "===== $(date '+%F %T %Z') mode=$mode_name tool=$AI_TOOL adapter=${tool_adapter:-unknown} ai_mode=$AI_MODE rotation_reason=${LAUNCH_ROTATION_REASON:-none} ====="
      local workspace_root
      workspace_root="$(workspace_root_for_project "$PROJECT_ROOT")"
      bash "$workspace_root/scripts/monitor-ai-cli.sh" \
        --project "$PROJECT_ROOT" \
        --tool "$AI_TOOL" \
        --tool-adapter "${tool_adapter:-}" \
        --model "${AI_MODEL:-}" \
        --reasoning-effort "${AI_REASONING_EFFORT:-}" \
        --tool-capabilities "${AI_TOOL_CAPABILITIES:-}" \
        --tool-policy "${AI_TOOL_POLICY:-}" \
        --codex-capability-model "${AI_CAPABILITY_CODEX_MODEL:-}" \
        --codex-capability-sandbox "${AI_CAPABILITY_CODEX_SANDBOX:-}" \
        --codex-capability-approval-policy "${AI_CAPABILITY_CODEX_APPROVAL_POLICY:-}" \
        --codex-capability-cwd-mode "${AI_CAPABILITY_CODEX_CWD_MODE:-}" \
        --debug-log-file "$cycle_debug_log" \
        --claude-session-id "${CLAUDE_SESSION_ID_CURRENT:-}" \
        --tool-resume-target "$(tool_runtime_resume_target_before_launch "$AI_TOOL")" \
        --mode "$AI_MODE" \
        --prompt-file "$prompt_file" \
        --pid-file "$child_pid_file" \
        --log-file "$cycle_log" \
        --launch-kind "$mode_name"
    } >>"$loop_log" 2>&1
    local rc=$?
    set -e
    local child_pid tool_session_id tool_resume_target tool_jsonl_path context_compacted context_ratio route_only_handoff checkpoint_json checkpoint_required
    local codex_mcp_used codex_mcp_thread_id codex_mcp_jsonl_path
    local claude_jsonl_path
    local primary_rate_limit_used_percent primary_rate_limit_resets_at secondary_rate_limit_used_percent secondary_rate_limit_resets_at next_restart_delay
    local active_slot active_cooldown_identity slot_switch_reason network_failure_reason
    local rate_limit_reason rate_limit_reset_at
    local dirty_entries worktree_total worktree_dirty summary
    local launch_resume_target
    child_pid="$(cat "$child_pid_file" 2>/dev/null || true)"
    tool_session_id="$(extract_tool_session_id_from_log "$AI_TOOL" "$cycle_log")"
    tool_resume_target=""
    tool_jsonl_path=""
    context_ratio=""
    primary_rate_limit_used_percent=""
    primary_rate_limit_resets_at=""
    secondary_rate_limit_used_percent=""
    secondary_rate_limit_resets_at=""
    slot_switch_reason=""
    rate_limit_reason=""
    rate_limit_reset_at=""
    dirty_entries="0"
    worktree_total="0"
    worktree_dirty="0"
    next_restart_delay="${RESTART_DELAY:-2}"
    launch_resume_target="$(tool_runtime_resume_target_before_launch "$AI_TOOL")"
    if [[ "$AI_TOOL" == "codex" && -n "$tool_session_id" ]]; then
      tool_jsonl_path="$(find_codex_jsonl_path_for_session "$tool_session_id")"
      context_ratio="$(extract_latest_codex_context_ratio_from_jsonl "$tool_jsonl_path")"
      primary_rate_limit_used_percent="$(extract_latest_codex_primary_rate_limit_used_percent_from_jsonl "$tool_jsonl_path")"
      primary_rate_limit_resets_at="$(extract_latest_codex_primary_rate_limit_reset_at_from_jsonl "$tool_jsonl_path")"
      secondary_rate_limit_used_percent="$(extract_latest_codex_secondary_rate_limit_used_percent_from_jsonl "$tool_jsonl_path")"
      secondary_rate_limit_resets_at="$(extract_latest_codex_secondary_rate_limit_reset_at_from_jsonl "$tool_jsonl_path")"
    fi
    active_slot="$(runtime_read_tool_current_slot "$PROJECT_ROOT" "$AI_TOOL")"
    if [[ "$AI_TOOL" == "codex" ]]; then
      [[ -n "$active_slot" ]] || active_slot="$(codex_current_slot "$PROJECT_ROOT")"
      active_cooldown_identity="$(codex_current_cooldown_identity "$PROJECT_ROOT")"
    fi
    dirty_entries="$(project_dirty_entries "$PROJECT_ROOT")"
    summary="$(worktree_summary_for_project "$PROJECT_ROOT")"
    worktree_total="${summary%%|*}"
    worktree_dirty="${summary##*|}"
    context_compacted="0"
    if log_has_context_compacted "$cycle_log"; then
      context_compacted="1"
    fi
    route_only_handoff="0"
    claude_jsonl_path=""
    codex_mcp_used="0"
    codex_mcp_thread_id=""
    codex_mcp_jsonl_path=""
    if log_has_same_tool_route_only_handoff "$cycle_log" "$AI_TOOL"; then
      route_only_handoff="1"
    fi
    tool_resume_target="$(tool_runtime_resume_target_after_cycle "$AI_TOOL" "$tool_session_id" "$tool_jsonl_path" "$launch_resume_target" "${LAST_TOOL_JSONL_PATH:-}")"
    tool_session_id="$(tool_persisted_session_id_after_cycle "$AI_TOOL" "$tool_session_id" "$tool_resume_target")"
    if tool_uses_claude_session_id "$AI_TOOL" && [[ -n "${CLAUDE_SESSION_ID_CURRENT:-}" ]]; then
      local resolved_cc_evidence
      resolved_cc_evidence="$(resolve_cc_session_evidence "$PROJECT_ROOT" "${CLAUDE_SESSION_ID_CURRENT:-}")"
      if [[ -n "$resolved_cc_evidence" ]]; then
        unset CLAUDE_JSONL_PATH CODEX_MCP_USED CODEX_MCP_THREAD_ID CODEX_MCP_JSONL_PATH
        # shellcheck disable=SC1090
        source /dev/stdin <<<"$resolved_cc_evidence"
        claude_jsonl_path="${CLAUDE_JSONL_PATH:-}"
        if [[ "$AI_TOOL" == "cc-use-codex-cli" ]]; then
          codex_mcp_used="${CODEX_MCP_USED:-0}"
          codex_mcp_thread_id="${CODEX_MCP_THREAD_ID:-}"
          codex_mcp_jsonl_path="${CODEX_MCP_JSONL_PATH:-}"
        fi
      fi
    fi
    if [[ "$AI_TOOL" == "cc-use-codex-cli" && "$codex_mcp_used" != "1" ]] && cc_debug_log_has_codex_tool_call "$cycle_debug_log"; then
      codex_mcp_used="1"
      [[ -n "$codex_mcp_thread_id" ]] || codex_mcp_thread_id="unavailable://claude-jsonl-did-not-yet-expose-codex-thread-id"
      [[ -n "$codex_mcp_jsonl_path" ]] || codex_mcp_jsonl_path="unavailable://codex-thread-id-not-yet-resolved"
    fi
    LAST_TOOL_SESSION_ID="$tool_session_id"
    LAST_TOOL_RESUME_TARGET="$tool_resume_target"
    LAST_TOOL_JSONL_PATH="$tool_jsonl_path"
    LAST_LAUNCH_KIND="$mode_name"
    LAST_ROTATION_REASON="$LAUNCH_ROTATION_REASON"
    LAST_CYCLE_LOG="$cycle_log"
    LAST_CONTEXT_COMPACTED="$context_compacted"
    LAST_CONTEXT_RATIO="$context_ratio"
    LAST_PRIMARY_RATE_LIMIT_USED_PERCENT="$primary_rate_limit_used_percent"
    LAST_PRIMARY_RATE_LIMIT_RESETS_AT="$primary_rate_limit_resets_at"
    LAST_SECONDARY_RATE_LIMIT_USED_PERCENT="$secondary_rate_limit_used_percent"
    LAST_SECONDARY_RATE_LIMIT_RESETS_AT="$secondary_rate_limit_resets_at"
    LAST_ROUTE_ONLY_HANDOFF="$route_only_handoff"
    CURRENT_TOOL_SLOT="$active_slot"
    LAST_ACTIVE_SLOT="$active_slot"
    LAST_SLOT_SWITCH_REASON=""
    LAST_SLOT_SWITCH_AT=""
    LAST_CYCLE_DEBUG_LOG="$cycle_debug_log"
    LAST_CLAUDE_JSONL_PATH="$claude_jsonl_path"
    LAST_CODEX_MCP_USED="$codex_mcp_used"
    LAST_CODEX_MCP_THREAD_ID="$codex_mcp_thread_id"
    LAST_CODEX_MCP_JSONL_PATH="$codex_mcp_jsonl_path"
    LAST_PROJECT_DIRTY_ENTRIES="$dirty_entries"
    LAST_WORKTREE_SUMMARY_TOTAL="$worktree_total"
    LAST_WORKTREE_SUMMARY_DIRTY="$worktree_dirty"
    LAST_DELEGATED_CONTINUATION_PENDING_IDS="$delegated_pending_ids"
    LAST_DELEGATED_CONTINUATION_PENDING_COUNT="$delegated_pending_count"
    LAST_DELEGATED_CONTINUATION_CONSUMED_IDS="$delegated_consumed_ids"
    LAST_DELEGATED_CONTINUATION_CONSUMED_AT="$delegated_consumed_at"
    checkpoint_json="$(checkpoint_guard_json_for_project "$PROJECT_ROOT")"
    checkpoint_required="$(checkpoint_guard_value "$checkpoint_json" checkpoint_required)"
    if [[ "$checkpoint_required" == "true" || "$dirty_entries" =~ ^[0-9]+$ && "$dirty_entries" -ge "${CHECKPOINT_WARN_DIRTY_ENTRIES:-40}" ]]; then
      CHECKPOINT_DRIFT_STREAK_CURRENT=$(( ${CHECKPOINT_DRIFT_STREAK_CURRENT:-0} + 1 ))
    else
      CHECKPOINT_DRIFT_STREAK_CURRENT=0
    fi

    if [[ "$stop_requested" -eq 1 || -f "$(stop_marker_file "$project")" ]]; then
      LAST_WORKCELL_EXIT_REASON="operator_stop"
      DESIRED_RUNTIME_STATE_VALUE="stopped"
      rm -f "$child_pid_file" "$(session_state_file "$project")" "$(handoff_file "$project")"
      log_info "received stop signal, exiting supervisor"
      exit 0
    fi

    if [[ "$mode_name" == "resume" ]]; then
      RESUME_STREAK_CURRENT=$((RESUME_STREAK_CURRENT + 1))
    else
      RESUME_STREAK_CURRENT=0
    fi
    if [[ "$route_only_handoff" == "1" ]]; then
      ROUTE_ONLY_STREAK_CURRENT=$((ROUTE_ONLY_STREAK_CURRENT + 1))
    else
      ROUTE_ONLY_STREAK_CURRENT=0
    fi
    network_failure_reason=""
    if [[ "$AI_TOOL" == "codex" ]]; then
      rate_limit_reason="$(codex_rate_limit_reason_from_usage "${primary_rate_limit_used_percent:-}" "${secondary_rate_limit_used_percent:-}")"
      rate_limit_reset_at="$(codex_rate_limit_reset_at_for_reason "${rate_limit_reason:-}" "${primary_rate_limit_resets_at:-}" "${secondary_rate_limit_resets_at:-}")"
      if [[ -n "$rate_limit_reason" ]]; then
        slot_switch_reason="$rate_limit_reason"
        codex_record_slot_cooldown "$PROJECT_ROOT" "$active_cooldown_identity" "${rate_limit_reset_at:-}"
      elif log_has_codex_usage_limit "$cycle_log"; then
        slot_switch_reason="primary_rate_limit_exhausted"
        rate_limit_reset_at="$(log_codex_rate_limit_reset_at "$cycle_log" || true)"
        codex_record_slot_cooldown "$PROJECT_ROOT" "$active_cooldown_identity" "${rate_limit_reset_at:-}"
      elif log_has_auth_failure "$cycle_log"; then
        slot_switch_reason="auth_failure"
      fi
      if [[ -n "$slot_switch_reason" ]]; then
        LAST_SLOT_SWITCH_REASON="$slot_switch_reason"
        LAST_SLOT_SWITCH_AT="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
      fi
    elif [[ "$AI_TOOL" == "kiro-cli" ]]; then
      slot_switch_reason="$(kiro_availability_reason_from_log "$cycle_log" || true)"
      if [[ -n "$slot_switch_reason" ]]; then
        LAST_SLOT_SWITCH_REASON="$slot_switch_reason"
        LAST_SLOT_SWITCH_AT="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
      fi
    fi
    if [[ -z "$slot_switch_reason" && -z "$rate_limit_reason" ]]; then
      network_failure_reason="$(runtime_network_failure_reason_from_log "$PROJECT_ROOT" "$cycle_log" || true)"
    else
      clear_execution_network_state "$PROJECT_ROOT"
    fi

    local restart_signal_reason active_process_count now_epoch observe_delay restart_window_stats restart_window_count restart_window_peak
    restart_signal_reason=""
    active_process_count="$(runtime_active_process_count_for_project "$PROJECT_ROOT")"
    now_epoch="$(date +%s)"
    update_restart_storm_window "$PROJECT_ROOT" "$now_epoch" "${active_process_count:-0}"
    restart_window_stats="$(restart_storm_window_stats "$PROJECT_ROOT")"
    restart_window_count="${restart_window_stats%%|*}"
    restart_window_peak="${restart_window_stats##*|}"
    if restart_storm_signal_reason_for_window "${restart_window_count:-0}" "${restart_window_peak:-0}" >/dev/null 2>&1; then
      restart_signal_reason="$(restart_storm_signal_reason_for_window "${restart_window_count:-0}" "${restart_window_peak:-0}")"
      record_restart_storm_signal "$PROJECT_ROOT" "$restart_signal_reason" "${restart_window_count:-0}" "${restart_window_peak:-0}"
    fi

    write_session_state "$project" "$LAST_TOOL_SESSION_ID" "$LAST_TOOL_RESUME_TARGET" "$LAST_TOOL_JSONL_PATH" "$LAST_LAUNCH_KIND" "$LAST_ROTATION_REASON" "$LAST_CYCLE_LOG" "$LAST_CONTEXT_COMPACTED" "$LAST_CONTEXT_RATIO" "$LAST_PRIMARY_RATE_LIMIT_USED_PERCENT" "$LAST_PRIMARY_RATE_LIMIT_RESETS_AT" "$LAST_SECONDARY_RATE_LIMIT_USED_PERCENT" "$LAST_SECONDARY_RATE_LIMIT_RESETS_AT" "$LAST_ROUTE_ONLY_HANDOFF" "$ROUTE_ONLY_STREAK_CURRENT" "$RESUME_STREAK_CURRENT" "$(runtime_read_tool_current_slot "$project" "$AI_TOOL")" "$LAST_SLOT_SWITCH_REASON" "$LAST_SLOT_SWITCH_AT" "$LAST_CYCLE_DEBUG_LOG" "$LAST_CLAUDE_JSONL_PATH" "$LAST_CODEX_MCP_USED" "$LAST_CODEX_MCP_THREAD_ID" "$LAST_CODEX_MCP_JSONL_PATH" "${CLAUDE_SESSION_ID_CURRENT:-}" "${CLAUDE_SESSION_ID_PREVIOUS:-}" "$LAST_PROJECT_DIRTY_ENTRIES" "$LAST_WORKTREE_SUMMARY_TOTAL" "$LAST_WORKTREE_SUMMARY_DIRTY" "$CHECKPOINT_DRIFT_STREAK_CURRENT" "$LAST_DELEGATED_CONTINUATION_PENDING_IDS" "$LAST_DELEGATED_CONTINUATION_PENDING_COUNT" "$LAST_DELEGATED_CONTINUATION_CONSUMED_IDS" "$LAST_DELEGATED_CONTINUATION_CONSUMED_AT" "${LAST_RESTART_STORM_WINDOW_SECS:-0}" "${LAST_RESTART_STORM_COUNT:-0}" "${LAST_PROCESS_CHURN_PEAK:-0}" "${LAST_RESTART_STORM_SIGNAL_AT:-}" "${LAST_RESTART_STORM_SIGNAL_REASON:-}" "${LAST_RESTART_STORM_ESCALATED_AT:-}" "${LAST_RESTART_STORM_ESCALATION_TARGET:-}"
    LAST_WORKCELL_EXIT_REASON="${slot_switch_reason:-${rate_limit_reason:-${network_failure_reason:-ai_exit_rc_${rc}}}}"
    write_workcell_state "$project" "running" "up" "down" "$LAST_WORKCELL_EXIT_REASON"
    append_runtime_event "$project" "ai_cycle_finished" \
      "supervisor_pid=$$" \
      "tool=$AI_TOOL" \
      "launch_kind=$mode_name" \
      "rotation_reason=${LAUNCH_ROTATION_REASON:-none}" \
      "rc=$rc" \
      "child_pid=${child_pid:-unknown}" \
      "session_id=${tool_session_id:-unavailable}" \
      "resume_target=${tool_resume_target:-unavailable}" \
      "jsonl_path=${tool_jsonl_path:-unavailable}" \
      "cycle_log=$cycle_log" \
      "context_compacted=$context_compacted" \
      "context_ratio=${context_ratio:-unavailable}" \
      "route_only_handoff=$route_only_handoff" \
      "slot_switch_reason=${slot_switch_reason:-none}" \
      "rate_limit_reason=${rate_limit_reason:-none}" \
      "network_failure_reason=${network_failure_reason:-none}" \
      "exit_reason=$LAST_WORKCELL_EXIT_REASON"

    log_warn "ai process exited rc=$rc (pid=${child_pid:-unknown}, session_id=${tool_session_id:-unavailable}, context_compacted=$context_compacted, context_ratio=${context_ratio:-unavailable}, jsonl_path=${tool_jsonl_path:-unavailable}, primary_rate_limit_used_percent=${primary_rate_limit_used_percent:-unavailable}, primary_rate_limit_resets_at=${primary_rate_limit_resets_at:-unavailable}, secondary_rate_limit_used_percent=${secondary_rate_limit_used_percent:-unavailable}, secondary_rate_limit_resets_at=${secondary_rate_limit_resets_at:-unavailable}, route_only_handoff=${route_only_handoff})"
    rm -f "$child_pid_file"

    FIRST_ROUND=false
    restart_count=$((restart_count + 1))
    if [[ "${MAX_RESTARTS:-0}" -gt 0 && "$restart_count" -gt "${MAX_RESTARTS:-0}" ]]; then
      log_error "reached MAX_RESTARTS=${MAX_RESTARTS}, stopping"
      append_runtime_event "$project" "supervisor_stopping" \
        "supervisor_pid=$$" \
        "reason=max_restarts" \
        "restart_count=$restart_count"
      exit 1
    fi
    if [[ -n "$slot_switch_reason" ]]; then
      log_warn "${slot_switch_reason} detected for this workcell; local runtime is deferring availability recovery to the global watchdog / manager control plane and will now stop"
      append_runtime_event "$project" "supervisor_stopping" \
        "supervisor_pid=$$" \
        "reason=$slot_switch_reason"
      exit 0
    fi
    if [[ -n "$restart_signal_reason" ]]; then
      observe_delay="${RESTART_STORM_OBSERVE_DELAY_SECS:-30}"
      restart_count=0
      log_warn "restart storm / process churn detected for this workcell; pausing blind relaunch for ${observe_delay}s while waiting for manager auto-loop judgement (reason=$restart_signal_reason count=${LAST_RESTART_STORM_COUNT:-0} peak=${LAST_PROCESS_CHURN_PEAK:-0})"
      append_runtime_event "$project" "restart_storm_pause" \
        "supervisor_pid=$$" \
        "reason=$restart_signal_reason" \
        "count=${LAST_RESTART_STORM_COUNT:-0}" \
        "peak=${LAST_PROCESS_CHURN_PEAK:-0}" \
        "observe_delay=$observe_delay"
      sleep_with_rate_limit_recheck "$PROJECT_ROOT" "$observe_delay"
      continue
    fi
    sleep_with_rate_limit_recheck "$PROJECT_ROOT" "$next_restart_delay"
  done
}

cmd_start() {
  local project="" force="0"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --force) force="1"; shift ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project")"
  if [[ "$force" == "1" ]]; then
    log_info "forcing project-local runtime rebuild before start"
    stop_project_runtime "$project" "start_force"
  fi
  start_project_runtime "$project"
}

cmd_restart() {
  local project="" all_projects="0"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --all-projects) all_projects="1"; shift ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project")"
  if [[ "$all_projects" == "1" ]]; then
    cmd_global_restart --project "$project"
    return 0
  fi
  log_info "restarting current project runtime/control-plane without implicit work restore"
  stop_project_runtime "$project" "operator_restart"
  start_project_runtime "$project"
}

cmd_restore_work() {
  local project=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project")"
  load_config "$project"
  check_doc_gate_or_fail "$project" || {
    log_error "restore-work blocked by doc gate"
    exit 1
  }

  local workcell_state launch_state manager_continuity worker_continuity prompt_file resolution_file intake_count
  local anchor_lines="" operator_anchor_count=0 intake_output restore_message
  workcell_state="$(workcell_state_file "$project")"
  launch_state="$(manager_worker_launch_state_file "$project")"
  manager_continuity="$(latest_generated_manager_continuity_file_for_project "$project")"
  worker_continuity="$(latest_worker_continuity_file_for_project "$project")"
  prompt_file="$(find_latest_prompt_file_for_project "$project")"
  resolution_file="$(latest_interruption_resolution_file_for_project "$project")"
  intake_count="$(count_active_intake_items "$project")"

  [[ -f "$workcell_state" ]] || {
    log_error "restore-work requires mandatory project runtime intent anchor: $workcell_state"
    log_error "session-state/handoff are auxiliary only and cannot authorize restore-work by themselves"
    exit 1
  }
  anchor_lines="${anchor_lines}- workcell-state.env: $workcell_state"$'\n'

  if [[ -f "$launch_state" ]]; then
    operator_anchor_count=$((operator_anchor_count + 1))
    anchor_lines="${anchor_lines}- manager-worker-launch-state.env: $launch_state"$'\n'
  fi
  if [[ -n "$manager_continuity" && -f "$manager_continuity" ]]; then
    operator_anchor_count=$((operator_anchor_count + 1))
    anchor_lines="${anchor_lines}- manager continuity: $manager_continuity"$'\n'
  fi
  if [[ -n "$worker_continuity" && -f "$worker_continuity" ]]; then
    operator_anchor_count=$((operator_anchor_count + 1))
    anchor_lines="${anchor_lines}- worker continuity: $worker_continuity"$'\n'
  fi
  if [[ -n "$resolution_file" && -f "$resolution_file" ]]; then
    operator_anchor_count=$((operator_anchor_count + 1))
    anchor_lines="${anchor_lines}- interruption resolution: $resolution_file"$'\n'
  fi
  if [[ -n "$prompt_file" && -f "$prompt_file" ]]; then
    operator_anchor_count=$((operator_anchor_count + 1))
    anchor_lines="${anchor_lines}- delegated prompt evidence: $prompt_file"$'\n'
  fi
  if [[ "${intake_count:-0}" =~ ^[0-9]+$ ]] && (( intake_count > 0 )); then
    operator_anchor_count=$((operator_anchor_count + 1))
    anchor_lines="${anchor_lines}- active intake items: ${intake_count}"$'\n'
  fi

  if (( operator_anchor_count == 0 )); then
    log_error "restore-work requires explicit project continuity anchors in addition to workcell-state.env"
    log_error "expected at least one of: manager-worker launch state, continuity, interruption resolution, delegated prompt evidence, or intake"
    log_error "session-state/handoff remain auxiliary and are not enough on their own"
    exit 1
  fi

  restore_message="$(cat <<EOF
Explicit project-scoped restore-work requested.

Project: $project
Contract:
- restore only interrupted work for this project
- do not infer global restart/reset from this command
- project restart remains a fresh bootstrap surface; restore-work is the explicit operator intent

Mandatory restore anchors:
$anchor_lines
Auxiliary artifacts intentionally not required:
- $(session_state_file "$project")
- $(handoff_file "$project")
- $(run_dir_for_project "$project")/ai.pid
- $(run_dir_for_project "$project")/supervisor.pid
EOF
)"
  intake_output="$(submit_human_frontdoor_message "$project" operator restore-work "$restore_message")"
  printf '%s\n' "$intake_output"
  printf 'restore_anchor_count: %s\n' "$operator_anchor_count"
}

cmd_ensure_manager() {
  local project="" branch="" watch_mode="0" watch_interval="5"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --watch) watch_mode="1"; shift ;;
      --interval) watch_interval="${2:-}"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  project="$(resolve_project_or_fail "$project")"
  [[ "$watch_interval" =~ ^[0-9]+$ ]] || { log_error "ensure-manager --interval must be a positive integer"; exit 1; }
  load_config "$project"
  register_project_in_registry "$project"
  check_doc_gate_or_fail "$project" || {
    log_error "ensure-manager blocked by doc gate"
    exit 1
  }

  branch="$(git -C "$project" branch --show-current 2>/dev/null || true)"
  if [[ "$branch" == test-pre-merge-* ]]; then
    :
  else
  case "$branch" in
    develop|main) ;;
    *)
      log_error "ensure-manager only supports protected manager worktrees (current branch: ${branch:-unknown})"
      exit 1
      ;;
  esac
  fi

  if [[ "$watch_mode" == "1" ]]; then
    cmd_ensure_manager_watch "$project" "$watch_interval"
    return 0
  fi

  ensure_manager_once "$project"
}

