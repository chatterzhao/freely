  - wrapper: \`$wrapper_dir/${tool}\`
  - launch boundary: $(tool_boundary_launch_boundary_note "$tool" "$worktrees_root")
  - sync policy: $(tool_boundary_sync_policy_note "$tool")
EOF
  done < <(managed_tool_boundary_tools)
}

