  [[ -n "$continuity_file" && -f "$continuity_file" ]] || return 1

  worker_prompts_csv="$(latest_manager_worker_prompt_csv_from_continuity "$continuity_file")"
  if [[ -n "$worker_prompts_csv" ]] && manager_exit_contract_has_launchable_worker_prompt "$project" "$worker_prompts_csv"; then
    return 1
  fi

  route_kind="$(manager_continuity_resume_focus_route_kind "$continuity_file" || true)"
  restart_point="$(manager_continuity_backtick_field_value "$continuity_file" "restart_point")"
  next_action="$(manager_continuity_backtick_field_value "$continuity_file" "next_action")"
  [[ -n "$restart_point" ]] || restart_point="resume from authoritative manager continuity $(basename "$continuity_file")"
  [[ -n "$next_action" ]] || next_action="continue the current manager-owned lane from $(basename "$continuity_file") before widening patrol"

  local _a2a_task_py _db_path _raw_key
  _a2a_task_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/a2a_task.py"
  _db_path=""$project/.freely/freely.db""
  if [[ -f "$_a2a_task_py" && -f "$_db_path" ]]; then
    _raw_key=$(echo "$continuity_file" | grep -oE '[0-9]{8}T[0-9]{4,6}Z' | head -1 || echo "autofill")
    python3 "$_a2a_task_py" insert \
      --role manager --raw-key "$_raw_key" \
      --prompt-file "$continuity_file" --created-by manager --consumed-by manager \
      --intent-kind resume 2>/dev/null || true
  fi
  append_runtime_event "$project" "manager_exit_contract_autofilled_continuity_resume" \
    "continuity=$(basename "$continuity_file")" \
    "route_kind=${route_kind:-unknown}" \
    "missing_csv=${missing_csv:-none}"
  return 0
}

worker_exit_contract_kind() {
  local project="$1" _a2a_task_py _db_path
  _a2a_task_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/a2a_task.py"
  _db_path=""$project/.freely/freely.db""
  [[ -f "$_a2a_task_py" && -f "$_db_path" ]] || return 1
  python3 "$_a2a_task_py" list --role worker --status completed 2>/dev/null | python3 -c "
import json,sys
try:
    data=json.load(sys.stdin)
    r=data.get('rows',[])[0] if data.get('rows',[]) else {}
    kind=r.get('exit_kind','')
    print(kind) if kind else None
except: pass
" 2>/dev/null || return 1
}

worker_project_has_terminal_exit_contract() {
  local project="$1" kind
  kind="$(worker_exit_contract_kind "$project" || true)"
  case "$kind" in
    worker_done|worker_blocked|worker_handoff_needed) return 0 ;;
    *) return 1 ;;
  esac
}

validate_worker_exit_contract_for_project() {
  local project="$1" kind="" missing_csv=""
  local completion_summary evidence_paths_csv blocked_reason handoff_reason next_action_for_manager
  kind="$(_db_exit_contract_field "$project" worker exit_kind)"
  [[ -n "$kind" ]] || {
    printf 'missing_file\n'
    return 1
  }
  case "$kind" in
    worker_done|worker_blocked|worker_handoff_needed) ;;
    *)
      printf 'invalid_exit_kind\n'
      return 1
      ;;
  esac
  completion_summary="$(_db_exit_contract_field "$project" worker completion_summary)"
  evidence_paths_csv="$(_db_exit_contract_field "$project" worker evidence_paths)"
  blocked_reason="$(_db_exit_contract_field "$project" worker reason)"
  handoff_reason="$(_db_exit_contract_field "$project" worker reason)"
  next_action_for_manager="$(_db_exit_contract_field "$project" worker next_action)"
  case "$kind" in
    worker_done)
      [[ -n "$completion_summary" ]] || missing_csv="$(csv_append_unique_item "$missing_csv" "COMPLETION_SUMMARY")"
      [[ -n "$evidence_paths_csv" ]] || missing_csv="$(csv_append_unique_item "$missing_csv" "EVIDENCE_PATHS_CSV")"
      [[ -z "$next_action_for_manager" ]] || missing_csv="$(csv_append_unique_item "$missing_csv" "exclusive_fields_conflict")"
      ;;
    worker_blocked)
      [[ -n "$blocked_reason" ]] || missing_csv="$(csv_append_unique_item "$missing_csv" "BLOCKED_REASON")"
      [[ -n "$next_action_for_manager" ]] || missing_csv="$(csv_append_unique_item "$missing_csv" "NEXT_ACTION_FOR_MANAGER")"
      [[ -z "$completion_summary$evidence_paths_csv" ]] || missing_csv="$(csv_append_unique_item "$missing_csv" "exclusive_fields_conflict")"
      ;;
    worker_handoff_needed)
      [[ -n "$handoff_reason" ]] || missing_csv="$(csv_append_unique_item "$missing_csv" "HANDOFF_REASON")"
      [[ -n "$next_action_for_manager" ]] || missing_csv="$(csv_append_unique_item "$missing_csv" "NEXT_ACTION_FOR_MANAGER")"
      [[ -z "$completion_summary$evidence_paths_csv" ]] || missing_csv="$(csv_append_unique_item "$missing_csv" "exclusive_fields_conflict")"
      ;;
  esac
  if [[ -n "$missing_csv" ]]; then
    printf '%s\n' "$missing_csv"
    return 1
  fi
  printf '\n'
}

write_manager_exit_contract_repair_handoff() {
  local project="$1" reason="$2" details="$3" contract_file resume_target session_file
  contract_file="$(manager_exit_contract_file "$project")"
