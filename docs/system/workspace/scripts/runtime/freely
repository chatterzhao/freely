# Capture worker's ACP session ID from the cycle log and store it in the A2A task.
# This enables Manager to use session/prompt for intervention and SSE for streaming.
capture_worker_session_id_and_store() {
  local manager_project="$1" worker_cycle_log="$2" task_id="$3"
  [[ -n "$task_id" ]] || return 0
  (
    # Wait for session ID to appear in the log (first line = clean UUID)
    local _session_id="" _timeout=30 _elapsed=0
    while [[ $_elapsed -lt $_timeout ]]; do
      if [[ -f "$worker_cycle_log" && -s "$worker_cycle_log" ]]; then
        _session_id="$(head -n 1 "$worker_cycle_log" 2>/dev/null | tr -d '[:space:]' || true)"
        # Validate UUID format (with or without dashes)
        if [[ "$_session_id" =~ ^[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}$ ]]; then
          break
        fi
        _session_id=""
      fi
      sleep 1
      _elapsed=$((_elapsed + 1))
    done
    if [[ -n "$_session_id" ]]; then
      local _a2a_task_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/a2a_task.py"
      local _db_path="$manager_project/.freely/freely.db"
      if [[ -f "$_a2a_task_py" && -f "$_db_path" ]]; then
        python3 "$_a2a_task_py" update --task-id "$task_id" --session-id "$_session_id" >/dev/null 2>&1 || true
        log_info "worker session-id stored: task=$task_id session=$_session_id"
      fi
    else
      log_warn "worker session-id capture timed out after ${_timeout}s: task=$task_id"
    fi
  ) &
}

launch_worker_from_manager_prompt_if_needed() {
  # ── Worker AI launch ──────────────────────────────────────────────
  #
  # DESIGN (2026-05-01):
  #   If the worker worktree already has a running supervisor+AI → rebind/reentry.
  #   Otherwise → launch worker AI directly via manager's ACP bridge:
  #     run-acp-prompt.py --bridge-socket <manager_bridge> --cwd <worker_worktree>
  #     This creates a new ACP session (fork) sharing the manager's bridge.
  #     No separate freely daemon is started.
  #
  # PREVIOUS APPROACH (abandoned):
  #   start_workcell_supervisor_async spawned a full freely daemon per worker
  #   (nohup freely daemon-run --project <worker_worktree> &). This caused:
  #   - Multiple daemon instances competing for PID files and system resources
  #   - Orphan watchdog processes piling up (9+ concurrent observed)
  #   - Worker prompts never consumed because worker daemon couldn't start cleanly
  #
  # OBSERVATION:
  #   - Successful launch emits "worker_launched_directly" runtime event
  #   - Worker output goes to cycle-worker-*.log in the manager's log dir
  #   - Worker uses manager's bridge socket; bridge must be running
  #   - If bridge socket is missing, worker launch is blocked (return 1)
  #
  # CAPABILITIES THE OLD APPROACH HAD:
  #   - Independent worker lifecycle (worker daemon had its own supervisor loop)
  #   - Worker crash recovery (daemon would restart worker AI)
  #   - Worker state isolation (separate .freely/run/ per worktree)
  #   The new approach shares the manager's runtime. If the worker AI crashes,
  #   the manager's watchdog should detect and recover it.
  local manager_project="$1" prompt_file="$2" known_worktree="${3:-}" task_id="${4:-}"
  # Worker prompt paths in the exit contract are relative to the manager
  # project (e.g. .freely/run/worker-prompts/...).  The worker process cd's
  # to the target worktree before reading the prompt — and each worktree has
  # its own .freely directory.  Resolve to absolute so the worker can find it.
  [[ "$prompt_file" != /* ]] && prompt_file="$manager_project/$prompt_file"
  local target_project runtime_probe_project prompt_target_worktree
  local intake_id supervisor_pid ai_pid runtime_contract_file missing_fields_csv has_any_verification_metadata="0"
  local selected_tool
  # Prefer known_worktree from A2A DB (structured, reliable) over prompt text parsing.
  if [[ -n "$known_worktree" && -d "$known_worktree" ]]; then
    target_project="$known_worktree"
  else
    target_project="$(materialize_worker_prompt_worktree_if_needed "$manager_project" "$prompt_file")"
  fi
  if [[ -z "$target_project" || ! -d "$target_project" ]]; then
    log_warn "worker launch BLOCKED: worktree does not exist (target=$target_project)"
    log_warn "  Manager must create the worktree before delegating workers."
    log_warn "  Use: freely wt-create --raw-key <key> --source <source> --skill <skill> --slug <slug>"
    append_runtime_event "$manager_project" "worker_launch_blocked_worktree_missing" \
      "prompt_file=$prompt_file" \
      "target=$target_project"
    return 1
  fi
  if ! project_has_authoritative_worktree_path "$manager_project" "$target_project"; then
    log_warn "worker DIAG: $target_project not in authoritative fleet"
    return 1
  fi
  if ! ensure_runtime_workcell_initialized_for_launch "$manager_project" "$target_project"; then
    log_warn "worker DIAG: workcell init failed for $target_project"
    return 1
  fi
  runtime_probe_project="$target_project"
  prompt_target_worktree="$(worker_prompt_target_worktree "$prompt_file")"
  if [[ -n "$prompt_target_worktree" && -d "$prompt_target_worktree" ]] \
    && project_has_authoritative_worktree_path "$manager_project" "$prompt_target_worktree"; then
    runtime_probe_project="$prompt_target_worktree"
  fi
  selected_tool="$(worker_prompt_selected_tool "$prompt_file")"
  if [[ -n "$selected_tool" ]]; then
    persist_project_tool_selection "$target_project" "$selected_tool"
    runtime_clear_session_state_for_fresh_launch "$target_project"
  fi
  runtime_contract_file="$(worker_verification_contract_state_file "$target_project")"
  supervisor_pid="$(manager_supervisor_pid_for_project "$runtime_probe_project")"
  ai_pid="$(runtime_ai_pid_hint_for_project "$runtime_probe_project")"
  missing_fields_csv="$(worker_prompt_verification_metadata_missing_fields_csv "$prompt_file")"
  if worker_prompt_has_any_verification_metadata "$prompt_file"; then
    has_any_verification_metadata="1"
  fi
  if [[ -n "$missing_fields_csv" && "$has_any_verification_metadata" == "1" ]]; then
    log_warn "worker verification metadata incomplete: missing=$missing_fields_csv (prompt=$(basename "$prompt_file"))"
    # Write a chat-inbox entry so the AI learns what fields are needed
    local _db_path _chat_py
    _db_path=""$manager_project/.freely/freely.db""
    local cli="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli"
    python3 "$cli" --project "$manager_project" chat.add --type "comment" \
      --issue-id "raw-guidance" \
      --message "Worker prompt $(basename "$prompt_file") has incomplete verification metadata. Missing fields: $missing_fields_csv. Please add these fields or remove the verification metadata section." \
      --author "runtime" --channel "worker-guard" >/dev/null 2>&1 || true
    # Continue with launch — don't block on incomplete metadata
  fi
  intake_id="$(write_manager_worker_launch_intake "$target_project" "$prompt_file")"
  write_worker_verification_contract_file "$runtime_contract_file" "$prompt_file" "$intake_id" "$target_project"
  rm -f "$(exit_contract_file "$target_project")"
  refresh_workcell_state_projection "$target_project"
  if [[ -n "$supervisor_pid" && -n "$ai_pid" ]]; then
    if rebind_active_worker_runtime_control_plane_if_needed "$manager_project" "$target_project" "$prompt_file"; then
      return 0
    fi
    request_local_continuation_reentry "$target_project" "$intake_id"
    return 0
  fi
  # ── Direct worker AI launch (no separate daemon) ──────────────────
  # The worker AI process runs in the background, connected to the manager's
  # ACP bridge. This replaces start_workcell_supervisor_async which spawned
  # a full freely daemon per worker (nohup freely daemon-run &).
  #
  # Worker lifecycle:
  #   1. run-acp-prompt.py --bridge-socket <manager> --cwd <worker_worktree>
  #   2. ACP session/new (fork) — worker gets own session
  #   3. Worker AI reads prompt, executes task
  #   4. Worker AI writes exit_contract (worker_done|blocked|handoff_needed)
  #   5. Background process exits
  #   6. Manager watchdog/patrol detects completion
  #
  # OBSERVATION POINTS:
  #   - worker_launched_directly event in runtime-events.log
  #   - cycle-worker-*.log in manager's log directory
  #   - ai.pid file in worker's .freely/run/
  #   - If bridge socket missing → launch blocked (return 1)
  local worker_pid worker_rc worker_cycle_log worker_ts
  worker_ts="$(date '+%Y%m%d-%H%M%S')"
  worker_cycle_log="$(logs_dir_for_project "$manager_project")/cycle-worker-$worker_ts.log"

  write_workcell_state "$target_project" "running" "down" "down" "manager_worker_launch_linkage"
  if [[ -n "${TOOL_SESSION_ID_CURRENT:-}" ]]; then
    local worker_state_file
    worker_state_file="$(session_state_file "$target_project")"
    mkdir -p "$(dirname "$worker_state_file")"
    cat >"$worker_state_file" <<SESSIONEOF
SESSION_PARENT_ID="${TOOL_SESSION_ID_CURRENT:-}"
SESSION_PARENT_PROJECT="$manager_project"
LAST_LAUNCH_KIND="fork"
SESSIONEOF
    log_info "worker session parent set: ${TOOL_SESSION_ID_CURRENT} → $target_project"
  fi

  local _manager_bridge_socket _worker_pid
  # Resolve worker base_tool from agent-table
  local _worker_slot _worker_base
  _worker_slot=$("$PROJECT_ROOT/bin/agent-table-query" --get-slot worker_01 2>/dev/null || true)
  _worker_base="${_worker_slot%%-*}"
  _validate_base_tool_from_slot "$_worker_slot" "worker_launch"
  [[ -z "$_worker_base" ]] && _worker_base="opencode"

  _manager_bridge_socket="$(_acp_bridge_socket "$manager_project" "$_worker_base")"
  if [[ ! -S "$_manager_bridge_socket" ]]; then
    log_warn "manager bridge socket not found; falling back to --agent mode (opencode)"
    local _worker_next_file
    _worker_next_file="$(run_dir_for_project "$target_project")/worker-next-prompt.txt"
    rm -f "$_worker_next_file"
    (
      cd "$target_project" 2>/dev/null || cd "$manager_project"
      export FREELY_ROLE_HINT=worker
      export SESSION_PARENT_ID="${TOOL_SESSION_ID_CURRENT:-}"
      python3 "$SELF_ROOT/docs/system/workspace/scripts/runtime/run-acp-prompt.py" \
        --agent "$_worker_base" \
        --cwd "$target_project" \
        --prompt-file "$prompt_file" \
        --launch-kind fork \
        --mode auto \
        --loop \
        --next-prompt-file "$_worker_next_file"
    ) >> "$worker_cycle_log" 2>> "${worker_cycle_log}.debug" &
    _worker_pid=$!
    mkdir -p "$(run_dir_for_project "$target_project")"
    echo "$_worker_pid" > "$(run_dir_for_project "$target_project")/ai.pid"
    manager_record_worker_pid_for_launch "$target_project" "$_worker_pid" "$prompt_file"
    append_runtime_event "$manager_project" "worker_launched_directly_agent_fallback" \
      "worker_pid=$_worker_pid" \
      "target_project=$target_project" \
      "prompt_file=$prompt_file"
    capture_worker_session_id_and_store "$manager_project" "$worker_cycle_log" "$task_id"
    return 0
  fi

  log_info "launching worker AI via manager bridge (fork session): target=$target_project prompt=$(basename "$prompt_file")"
  local _worker_next_file
  _worker_next_file="$(run_dir_for_project "$target_project")/worker-next-prompt.txt"
  rm -f "$_worker_next_file"
  (
    cd "$target_project" 2>/dev/null || cd "$manager_project"
    export FREELY_ROLE_HINT=worker
    export SESSION_PARENT_ID="${TOOL_SESSION_ID_CURRENT:-}"
    export SESSION_PARENT_PROJECT="$manager_project"
    python3 "$SELF_ROOT/docs/system/workspace/scripts/runtime/run-acp-prompt.py" \
      --bridge-socket "$_manager_bridge_socket" \
      --cwd "$target_project" \
      --prompt-file "$prompt_file" \
      --launch-kind fork \
      --mode auto \
      --loop \
      --next-prompt-file "$_worker_next_file"
  ) >> "$worker_cycle_log" 2>> "${worker_cycle_log}.debug" &
  _worker_pid=$!

  # Record worker PID for liveness tracking
  mkdir -p "$(run_dir_for_project "$target_project")"
  echo "$_worker_pid" > "$(run_dir_for_project "$target_project")/ai.pid"
  manager_record_worker_pid_for_launch "$target_project" "$_worker_pid" "$prompt_file"

  append_runtime_event "$manager_project" "worker_launched_directly" \
    "worker_pid=$_worker_pid" \
    "target_project=$target_project" \
    "prompt_file=$prompt_file"
  capture_worker_session_id_and_store "$manager_project" "$worker_cycle_log" "$task_id"
  return 0
}

manager_runtime_launch_workers_from_latest_task() {
  local project="$1"
  local continuity_file continuity_generated prompt_generated_csv launched_csv queued_csv
  local launched_count prompt_file prompt_rank prompt_index target_project write_scope
  local parallel_safe active_running_workers available_new_slots max_parallel_workers
  local selected_write_scopes_csv selected_intent_signatures_csv frozen_intent_signatures_csv active_intent_signatures_csv recorded_intent_signatures_csv worker_is_active worker_is_busy prompt_queue_file prompt_signature queued_prompt_blockers terminal_kind

  # ── A2A path (NEW): launch Workers from submitted A2A tasks ──
  # Queries a2a_tasks for submitted worker tasks that haven't been launched yet.
  # Each task carries the full Worker prompt in its message field, plus
  # worktree/branch/raw_key metadata from the Manager's a2a-exit delegation.
  local _a2a_task_py _a2a_tasks_json _a2a_launched
  _a2a_task_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/a2a_task.py"
  _a2a_launched=0
  if [[ -f "$_a2a_task_py" ]]; then
    _a2a_tasks_json="$(python3 "$_a2a_task_py" list --state submitted --role worker 2>/dev/null || true)"
    if [[ -n "$_a2a_tasks_json" && "$_a2a_tasks_json" != "[]" ]]; then
      max_parallel_workers="$(manager_max_parallel_workers)"
      active_running_workers="$(manager_semantic_loop_active_worker_count_for_project "$project")"
      local _a2a_max_new=2
      local _a2a_new_count=0
      while IFS= read -r _a2a_row; do
        [[ -n "$_a2a_row" ]] || continue
        local _a2a_task_id _a2a_message _a2a_worktree _a2a_branch _a2a_raw_key _a2a_skill
        _a2a_task_id="$(echo "$_a2a_row" | python3 -c "import sys,json;print(json.loads(sys.stdin.read()).get('task_id',''))" 2>/dev/null || true)"
        _a2a_message="$(echo "$_a2a_row" | python3 -c "import sys,json;print(json.loads(sys.stdin.read()).get('message',''))" 2>/dev/null || true)"
        _a2a_worktree="$(echo "$_a2a_row" | python3 -c "import sys,json;print(json.loads(sys.stdin.read()).get('worktree',''))" 2>/dev/null || true)"
        _a2a_branch="$(echo "$_a2a_row" | python3 -c "import sys,json;print(json.loads(sys.stdin.read()).get('branch',''))" 2>/dev/null || true)"
        _a2a_raw_key="$(echo "$_a2a_row" | python3 -c "import sys,json;print(json.loads(sys.stdin.read()).get('raw_key',''))" 2>/dev/null || true)"
        _a2a_skill="$(echo "$_a2a_row" | python3 -c "import sys,json;print(json.loads(sys.stdin.read()).get('skill','freely-workflow-guarded-execution'))" 2>/dev/null || true)"
        [[ -n "$_a2a_task_id" && -n "$_a2a_message" ]] || continue
        # Write message to temp prompt file
        local _a2a_prompt_file
        _a2a_prompt_file="$(mktemp "${TMPDIR:-/tmp}/freely-a2a-worker-prompt.XXXXXX")"
        printf '%s\n' "$_a2a_message" > "$_a2a_prompt_file"
        # Launch Worker ACP session
        if launch_worker_from_manager_prompt_if_needed "$project" "$_a2a_prompt_file" "$_a2a_worktree" "$_a2a_task_id"; then
          # Update task state: submitted → working
          python3 "$_a2a_task_py" update --task-id "$_a2a_task_id" --state working 2>/dev/null || true
          _a2a_launched=$((_a2a_launched + 1))
          _a2a_new_count=$((_a2a_new_count + 1))
          log_info "A2A worker launched: task=$_a2a_task_id worktree=$_a2a_worktree raw_key=$_a2a_raw_key"
        else
          log_warn "A2A worker launch failed: task=$_a2a_task_id"
        fi
        # Clean up temp file
        rm -f "$_a2a_prompt_file"
        [[ $_a2a_new_count -ge $_a2a_max_new ]] && break
      done < <(echo "$_a2a_tasks_json" | python3 -c "
import sys,json
tasks=json.loads(sys.stdin.read()).get('rows',[])
for t in tasks: print(json.dumps(t))
" 2>/dev/null)
    fi
  fi
  # If A2A tasks were launched, return the count (skip old continuity path)
  if [[ $_a2a_launched -gt 0 ]]; then
    printf '%s\n' "$_a2a_launched"
    return 0
  fi

  continuity_file="$(latest_launchable_manager_worker_prompt_continuity_file_for_project "$project")"
  if [[ -z "$continuity_file" || ! -f "$continuity_file" ]]; then
    continuity_file="$(latest_generated_manager_continuity_file_for_project "$project")"
  fi
  [[ -n "$continuity_file" && -f "$continuity_file" ]] || {
    printf '0\n'
    return 0
  }
  continuity_generated="$continuity_file"
  if ! manager_continuity_has_worker_prompts "$continuity_file"; then
    materialize_cleanup_worker_prompt_from_manager_continuity_if_needed "$project" "$continuity_file" || true
  fi
  prompt_generated_csv="$(latest_manager_worker_prompt_csv_from_continuity "$continuity_file")"

  launched_csv=""
  queued_csv=""
  if [[ -f "$(manager_worker_launch_state_file "$project")" ]]; then
    # shellcheck disable=SC1090
    source "$(manager_worker_launch_state_file "$project")"
    launched_csv="${LAST_MANAGER_WORKER_PROMPTS_CONSUMED:-${LAUNCHED_WORKER_PROMPTS:-}}"
    if [[ -n "${LAST_MANAGER_CONTINUITY_CONSUMED:-}" && "${LAST_MANAGER_CONTINUITY_CONSUMED:-}" != "$continuity_file" ]]; then
      launched_csv=""
    else
      launched_csv="$(manager_worker_launch_state_reconcile_same_continuity_prompts "$project" "$continuity_file")"
    fi
  fi

  max_parallel_workers="$(manager_max_parallel_workers)"
  active_running_workers="$(manager_semantic_loop_active_worker_count_for_project "$project")"
  available_new_slots="$(manager_worker_launch_available_slots "$project")"
  local max_new_workers_per_cycle=2  # Phase 4: stagger worker creation to prevent session/new storms
  launched_count=0
  local new_worker_count=0
  queued_prompt_blockers="none"
  selected_write_scopes_csv=""
  active_intent_signatures_csv="$(manager_active_blocking_intent_signatures_csv "$project")"
  recorded_intent_signatures_csv="$(manager_recorded_blocking_intent_signatures_csv "$project")"
  frozen_intent_signatures_csv="$(manager_frozen_blocking_intent_signatures_csv "$project" "$continuity_file")"
  selected_intent_signatures_csv="$active_intent_signatures_csv"
  if [[ -n "$recorded_intent_signatures_csv" ]]; then
    IFS=',' read -r -a __freely_recorded_intents <<<"$recorded_intent_signatures_csv"
    local recorded_signature
    for recorded_signature in "${__freely_recorded_intents[@]}"; do
      [[ -n "$recorded_signature" ]] || continue
      selected_intent_signatures_csv="$(csv_append_unique_item "$selected_intent_signatures_csv" "$recorded_signature")"
    done
  fi
  if [[ -n "$frozen_intent_signatures_csv" ]]; then
    IFS=',' read -r -a __freely_frozen_intents <<<"$frozen_intent_signatures_csv"
    local frozen_signature
    for frozen_signature in "${__freely_frozen_intents[@]}"; do
      [[ -n "$frozen_signature" ]] || continue
      selected_intent_signatures_csv="$(csv_append_unique_item "$selected_intent_signatures_csv" "$frozen_signature")"
    done
  fi
  prompt_queue_file="$(mktemp "${TMPDIR:-/tmp}/freely-manager-launch-queue.XXXXXX")"
  prompt_index=0
  while IFS= read -r prompt_file; do
    [[ -n "$prompt_file" ]] || continue
    if [[ ! -f "$prompt_file" ]]; then
      record_manager_worker_launch_blocked_resolution \
        "$project" \
        "$prompt_file" \
        "manager_worker_launch_prompt_missing" \
        "continuity references a worker prompt path that no longer exists" >/dev/null
      queued_csv="$(csv_append_unique_item "$queued_csv" "$prompt_file")"
      continue
    fi
    prompt_rank="$(worker_prompt_dispatch_priority "$prompt_file")"
    printf '%s\t%06d\t%s\n' "$prompt_rank" "$prompt_index" "$prompt_file" >>"$prompt_queue_file"
    prompt_index=$((prompt_index + 1))
  done < <(latest_manager_worker_prompt_paths_from_continuity "$continuity_file")

  while IFS=$'\t' read -r _prompt_rank _prompt_index prompt_file; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
    target_project="$(worker_prompt_resolved_worktree "$project" "$prompt_file")"
    if [[ -z "$target_project" || ! -d "$target_project" ]]; then
      if worker_prompt_can_materialize_missing_worktree "$project" "$prompt_file"; then
        target_project="$(materialize_worker_prompt_worktree_if_needed "$project" "$prompt_file" || true)"
      fi
    fi
    if [[ -z "$target_project" || ! -d "$target_project" ]]; then
      record_manager_worker_launch_blocked_resolution \
        "$project" \
        "$prompt_file" \
        "manager_worker_launch_target_unresolved" \
        "worktree header or branch mapping did not resolve to a live worktree" >/dev/null
      queued_csv="$(csv_append_unique_item "$queued_csv" "$prompt_file")"
      continue
    fi
    if worker_project_has_terminal_exit_contract "$target_project"; then
      terminal_kind="$(worker_exit_contract_kind "$target_project" || true)"
      if [[ "$terminal_kind" == "worker_handoff_needed" ]]; then
        if launch_worker_from_manager_prompt_if_needed "$project" "$prompt_file"; then
          # contract cleanup deprecated
          append_runtime_event "$project" "worker_exit_contract_handoff_absorbed" \
            "worktree=$target_project" \
            "branch=$(worker_prompt_target_branch "$prompt_file")" \
            "followthrough_prompt=$prompt_file"
          launched_csv="$(csv_append_unique_item "$launched_csv" "$prompt_file")"
          selected_write_scopes_csv="$(csv_append_unique_item "$selected_write_scopes_csv" "$(worker_prompt_write_scope "$project" "$prompt_file")")"
          prompt_signature="$(worker_prompt_blocking_intent_signature "$project" "$prompt_file")"
          if [[ -n "$prompt_signature" ]]; then
            selected_intent_signatures_csv="$(csv_append_unique_item "$selected_intent_signatures_csv" "$prompt_signature")"
          fi
          launched_count=$((launched_count + 1))
          active_running_workers=$((active_running_workers + 1))
          continue
        fi
      fi
      continue
    fi
    if ! worker_prompt_launchable_for_manager_project "$project" "$prompt_file"; then
      if ! project_has_authoritative_worktree_path "$project" "$target_project"; then
        record_manager_worker_launch_blocked_resolution \
          "$project" \
          "$prompt_file" \
          "manager_worker_launch_target_unresolved" \
          "resolved worktree is outside the authoritative git worktree inventory" >/dev/null
        queued_csv="$(csv_append_unique_item "$queued_csv" "$prompt_file")"
        continue
      fi
      if worker_project_is_absorbed_merged_lane "$project" "$target_project" "$(worker_prompt_target_branch "$prompt_file")" || \
        worker_prompt_targets_retire_ready_merged_worktree "$project" "$prompt_file"; then
        settle_retire_ready_merged_worker_runtime_state \
          "$project" \
          "$target_project" \
          "$(worker_prompt_target_branch "$prompt_file")" >/dev/null 2>&1 || true
      fi
      continue
    fi
    if csv_contains_exact_item "$launched_csv" "$prompt_file"; then
      if worker_project_is_actively_running "$target_project"; then
        if rebind_active_worker_runtime_control_plane_if_needed "$project" "$target_project" "$prompt_file"; then
          launched_count=$((launched_count + 1))
        fi
        continue
      fi
      launched_csv="$(csv_remove_exact_item "$launched_csv" "$prompt_file")"
    fi
    write_scope="$(worker_prompt_write_scope "$project" "$prompt_file")"
    parallel_safe="$(worker_prompt_parallel_safe "$prompt_file")"
    worker_is_active="0"
    worker_is_busy="0"
    if worker_project_is_actively_running "$target_project"; then
      worker_is_active="1"
      if worker_project_busy_with_delegated_continuation "$target_project"; then
        worker_is_busy="1"
      fi
    fi
    if [[ "$worker_is_active" == "1" ]] \
      && worker_prompt_matches_active_authoritative_worker "$project" "$target_project" "$prompt_file"; then
      if rebind_active_worker_runtime_control_plane_if_needed "$project" "$target_project" "$prompt_file"; then
        launched_csv="$(csv_append_unique_item "$launched_csv" "$prompt_file")"
        selected_write_scopes_csv="$(csv_append_unique_item "$selected_write_scopes_csv" "$write_scope")"
        if [[ -n "$prompt_signature" ]]; then
          selected_intent_signatures_csv="$(csv_append_unique_item "$selected_intent_signatures_csv" "$prompt_signature")"
        fi
        launched_count=$((launched_count + 1))
        continue
      fi
      launched_csv="$(csv_append_unique_item "$launched_csv" "$prompt_file")"
      selected_write_scopes_csv="$(csv_append_unique_item "$selected_write_scopes_csv" "$write_scope")"
      if [[ -n "$prompt_signature" ]]; then
        selected_intent_signatures_csv="$(csv_append_unique_item "$selected_intent_signatures_csv" "$prompt_signature")"
      fi
      launched_count=$((launched_count + 1))
      continue
    fi

    if [[ "$worker_is_busy" == "1" ]]; then
      queued_csv="$(csv_append_unique_item "$queued_csv" "$prompt_file")"
      continue
    fi
    if [[ "$parallel_safe" != "true" && $launched_count -gt 0 ]]; then
      queued_csv="$(csv_append_unique_item "$queued_csv" "$prompt_file")"
      continue
    fi
    if csv_conflicts_with_item "$selected_write_scopes_csv" "$write_scope"; then
      queued_csv="$(csv_append_unique_item "$queued_csv" "$prompt_file")"
      continue
    fi
    prompt_signature="$(worker_prompt_blocking_intent_signature "$project" "$prompt_file")"
    if [[ -n "$prompt_signature" ]] && manager_other_worker_holds_blocking_intent_signature "$project" "$target_project" "$prompt_signature"; then
      queued_csv="$(csv_append_unique_item "$queued_csv" "$prompt_file")"
      continue
    fi
    if [[ -n "$prompt_signature" ]] && csv_conflicts_with_item "$selected_intent_signatures_csv" "$prompt_signature"; then
      if manager_prompt_may_reclaim_recorded_self_intent "$project" "$target_project" "$prompt_file" "$prompt_signature"; then
        :
      else
        queued_csv="$(csv_append_unique_item "$queued_csv" "$prompt_file")"
        continue
      fi
    fi
    # Phase 4: stagger new worker creation (max 2 per cycle)
    if [[ "$worker_is_active" != "1" ]] && (( new_worker_count >= max_new_workers_per_cycle )); then
      queued_csv="$(csv_append_unique_item "$queued_csv" "$prompt_file")"
      continue
    fi
    if launch_worker_from_manager_prompt_if_needed "$project" "$prompt_file"; then
      launched_csv="$(csv_append_unique_item "$launched_csv" "$prompt_file")"
      selected_write_scopes_csv="$(csv_append_unique_item "$selected_write_scopes_csv" "$write_scope")"
      if [[ -n "$prompt_signature" ]]; then
        selected_intent_signatures_csv="$(csv_append_unique_item "$selected_intent_signatures_csv" "$prompt_signature")"
      fi
      launched_count=$((launched_count + 1))
      if [[ "$worker_is_active" != "1" ]]; then
        new_worker_count=$((new_worker_count + 1))
        active_running_workers=$((active_running_workers + 1))
      fi
    else
      queued_csv="$(csv_append_unique_item "$queued_csv" "$prompt_file")"
    fi
  done < <(sort -t $'\t' -k1,1n -k2,2n "$prompt_queue_file")
  rm -f "$prompt_queue_file"

  queued_prompt_blockers="$(manager_pending_ownership_conflicts_summary "$project" "$continuity_file" "$queued_csv")"
  write_manager_worker_launch_state "$project" "$continuity_generated" "$prompt_generated_csv" "$continuity_file" "$launched_csv" "$queued_csv" "$max_parallel_workers" "$active_running_workers" "$available_new_slots" "$queued_prompt_blockers"
  printf '%s\n' "$launched_count"
}

worktree_has_active_worker() {
  local project="$1" worktree="$2"
  [[ -n "$worktree" && -d "$worktree" ]] || return 1
  local _a2a_task_py _db_path
  _a2a_task_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/a2a_task.py"
  _db_path="$project/.freely/freely.db"
  [[ -f "$_a2a_task_py" && -f "$_db_path" ]] || return 1
  # Check launched workers via has-active-worker first (fast path, no JSON parsing)
  local result sup_pid
  result=$(python3 "$_a2a_task_py" has-active-worker --worktree "$worktree" 2>/dev/null)
  [[ "$result" != "true" ]] && return 1
  # Collect matching task IDs for downstream processing
  local active_records matching
  active_records=$(python3 "$_a2a_task_py" list --role worker --status launched 2>/dev/null)
  matching=$(echo "$active_records" | python3 -c "
import json,sys
data = json.load(sys.stdin)
for r in data.get('rows', []):
    if r.get('worktree','') == '$worktree':
        print(r.get('task_id',''))
" 2>/dev/null)
  [[ -z "$matching" ]] && return 1
  sup_pid=$(cat "$worktree/.freely/run/supervisor.pid" 2>/dev/null || true)
  if [[ -n "$sup_pid" ]] && kill -0 "$sup_pid" 2>/dev/null; then
    # Update last_activity_at on liveness check
    local hid
    for hid in $matching; do
      [[ -n "$hid" ]] || continue
      python3 "$_a2a_task_py" update-last-activity --task-id "$hid" >/dev/null 2>&1 || true
    done
    return 0
  fi
  local hid raw_key_for_worker _w_cycle_log _w_extract_result _w_action _w_cs _w_reason _w_next
  for hid in $matching; do
    [[ -n "$hid" ]] || continue
    # Query A2A state first (authoritative) — skip if already terminal
    local _a2a_state
    _a2a_state=$(python3 "$_a2a_task_py" get --task-id "$hid" 2>/dev/null |       python3 -c "import json,sys; r=json.load(sys.stdin); print(r.get('state',''))" 2>/dev/null || echo "")
    if [[ "$_a2a_state" == "completed" || "$_a2a_state" == "failed" || "$_a2a_state" == "canceled" ]]; then
      continue  # Already terminal via a2a-exit
    fi
    # Extract raw_key from the DB record for this handoff
    raw_key_for_worker=$(python3 "$_a2a_task_py" get --task-id "$hid" 2>/dev/null | \
      python3 -c "import json,sys; r=json.load(sys.stdin); print(r.get('raw_key',''))" 2>/dev/null || echo "")
    # Try to parse worker handoff from cycle log before marking stale.
    # Find the cycle log whose session_id prefix appears in this worker's handoff record.
    # Fallback: search cycle-worker logs for the raw_key timestamp pattern.
    _w_cycle_log=""
    if [[ -n "$raw_key_for_worker" ]]; then
      _w_cycle_log="$(grep -l "$raw_key_for_worker" "$(logs_dir_for_project "$project")"/cycle-worker-*.log 2>/dev/null | tail -1)"
    fi
    # If not found by raw_key, use latest cycle-worker log as fallback
    [[ -z "$_w_cycle_log" || ! -f "$_w_cycle_log" ]] && \
      _w_cycle_log="$(ls -t "$(logs_dir_for_project "$project")"/cycle-worker-*.log 2>/dev/null | head -1)"
    if [[ -n "$_w_cycle_log" && -f "$_w_cycle_log" ]]; then
      _w_extract_result="$(python3 "$_a2a_task_py" extract --reply-text "$(tail -c 32768 "$_w_cycle_log" 2>/dev/null)" 2>/dev/null || true)"
      _w_action=$(echo "$_w_extract_result" | python3 -c "import json,sys; print(json.load(sys.stdin).get('action','error'))" 2>/dev/null || echo "error")
      if [[ "$_w_action" == "worker_done" ]]; then
        _w_cs=$(echo "$_w_extract_result" | python3 -c "import json,sys; print(json.load(sys.stdin).get('fields',{}).get('completion_summary',''))" 2>/dev/null || echo "")
        python3 "$_a2a_task_py" update --task-id "$hid" \
          --status completed --expected-status launched --exit-kind worker_done \
          --completion-summary "${_w_cs:0:2000}" \
          --reason "worker completed, handoff parsed from cycle log" >/dev/null 2>&1 || true
        continue
      elif [[ "$_w_action" == "worker_blocked" ]]; then
        _w_reason=$(echo "$_w_extract_result" | python3 -c "import json,sys; print(json.load(sys.stdin).get('fields',{}).get('reason',''))" 2>/dev/null || echo "")
        _w_next=$(echo "$_w_extract_result" | python3 -c "import json,sys; print(json.load(sys.stdin).get('fields',{}).get('next_action',''))" 2>/dev/null || echo "")
        python3 "$_a2a_task_py" update --task-id "$hid" \
          --status blocked --expected-status launched --exit-kind worker_blocked \
          --reason "${_w_reason:0:2000}" --next-action "${_w_next:0:2000}" >/dev/null 2>&1 || true
        continue
      elif [[ "$_w_action" == "worker_handoff_needed" ]]; then
        _w_reason=$(echo "$_w_extract_result" | python3 -c "import json,sys; print(json.load(sys.stdin).get('fields',{}).get('reason',''))" 2>/dev/null || echo "")
        _w_next=$(echo "$_w_extract_result" | python3 -c "import json,sys; print(json.load(sys.stdin).get('fields',{}).get('next_action',''))" 2>/dev/null || echo "")
        python3 "$_a2a_task_py" update --task-id "$hid" \
          --status completed --expected-status launched --exit-kind worker_handoff_needed \
          --reason "${_w_reason:0:2000}" --next-action "${_w_next:0:2000}" >/dev/null 2>&1 || true
        continue
      fi
    fi
    python3 "$_a2a_task_py" update --task-id "$hid" \
      --status blocked --expected-status launched --exit-kind stale_pid \
      --reason "worker process no longer alive" >/dev/null 2>&1 || true
  done
  return 1
}

manager_runtime_launch_workers_after_ai_cycle_if_needed() {
  # ── Worker launch after manager AI cycle ──────────────────────────
  #
  # DESIGN (2026-05-01):
  #   Worker prompt paths are read from the exit_contract's WORKER_PROMPTS_CSV
  #   field (env format, 100% machine-readable). Each worker is launched
  #   directly via the manager's ACP bridge — no separate freely daemon.
  #
  # PREVIOUS APPROACH (abandoned):
  #   manager_runtime_launch_workers_from_latest_task parsed worker
  #   prompts from continuity markdown (awk regex). This was fragile:
  #   - AI output format variations broke the regex parser
  #   - Multi-layer gate checks (stale refs, launchable, etc.) filtered
  #     out valid workers
  #   - start_workcell_supervisor_async spawned a full freely daemon per
  #     worker, causing resource conflicts and crash loops
  #
  # OBSERVATION:
  #   - Watch for "worker launched via exit_contract" log entries
  #   - If workers fail to launch, check exit_contract WORKER_PROMPTS_CSV
  #   - launch_worker_from_manager_prompt_if_needed writes worker_launched_directly
  #     event on success
  #
  # CAPABILITIES THE OLD APPROACH HAD:
  #   - continuity-based dedup (same worker not re-launched across cycles)
  #   - write_scope conflict detection (prevent parallel mutate conflicts)
  #   - intent_signature blocking (prevent duplicate intent execution)
  #   These are NOT implemented in the new path yet. Monitor for:
  #   - Same worker being re-launched across multiple cycles
  #   - Parallel workers mutating the same files
  #   Future iterations should add these guards back at the exit_contract level.
  local project="$1" exit_reason="${2:-}" launched_count="0"
  log_info "worker_launch: enter (project=$project exit_reason=$exit_reason)"
  [[ "$(effective_runtime_role_for_project "$project")" == "manager" ]] || {
    log_info "worker_launch: skip — role is not manager"
    printf '0\n'
    return 0
  }
  local _contract_kind
  _contract_kind="$(manager_exit_contract_kind "$project" 2>/dev/null || true)"
  log_info "worker_launch: contract_kind=$_contract_kind"
  if [[ "$_contract_kind" != "delegate_workers" ]]; then
    log_info "worker_launch: skip — contract kind is not delegate_workers"
    printf '0\n'
    return 0
  fi

  local _worker_tasks _prompt_file _launched_count _a2a_task_py _db_path _task_id
  local _prev_worker_id _prev_worker_summary _raw_key _parent_task_id _is_followthrough
  _a2a_task_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/a2a_task.py"
  _db_path=""$project/.freely/freely.db""
  # A2A-native: query submitted worker tasks with structured data.
  # Output: task_id<TAB>message<TAB>worktree<TAB>branch<TAB>raw_key<TAB>skill (one per task)
  # A2A-native: query submitted worker tasks with structured data.
  # Uses external Python script to avoid heredoc quoting issues in daemon context.
  local _consume_filter_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/consume_worker_tasks.py"
  _worker_tasks=$(python3 "$_a2a_task_py" list --role worker --status submitted 2>/dev/null | python3 "$_consume_filter_py" 2>/dev/null || true)
  # Get parent handoff_id (latest manager record)
  _parent_task_id=$(python3 "$_a2a_task_py" latest-manager 2>/dev/null | \
    python3 -c "import json,sys; print(json.load(sys.stdin).get('task_id',''))" 2>/dev/null || echo "")
  _launched_count=0
  log_info "worker_launch: _worker_tasks has $(echo "$_worker_tasks" | wc -l | tr -d ' ') lines"
  if [[ -n "$_worker_tasks" ]]; then
    while IFS=$'\t' read -r _task_id _task_msg _target_worktree _task_branch _raw_key _task_skill; do
      [[ -n "$_task_id" && -n "$_task_msg" ]] || continue
      # Save original A2A task_id before it gets overwritten by insert handoff record.
      # This is the A2A Server task that Manager monitors via SSE/polling.
      local _a2a_task_id="$_task_id"
      # Check worktree existence BEFORE creating prompt file or launching.
      # If the worktree doesn't exist, mark the task as input-required so
      # the Manager can create it on the next patrol (self-healing loop).
      if [[ ! -d "$_target_worktree" ]]; then
        log_warn "worker deferred: worktree missing — $_target_worktree"
        log_warn "  raw_key=$_raw_key branch=$_task_branch"
        if [[ -n "$_task_id" && -f "$_a2a_task_py" && -f "$_db_path" ]]; then
          python3 "$_a2a_task_py" update \
            --task-id "$_task_id" --status "input-required" \
            --reason "worktree_missing: raw_key=$_raw_key branch=$_task_branch worktree=$_target_worktree" \
            >/dev/null 2>&1 || true
        fi
        continue
      fi
      # Derive prompt file path from task_id (ACR layer concern, not A2A)
      local _prompts_dir="${_target_worktree:-$project}/.freely/run/a2a-prompts"
      mkdir -p "$_prompts_dir" 2>/dev/null || true
      _prompt_file="$_prompts_dir/task-${_task_id}.txt"
      printf '%s\n' "$_task_msg" > "$_prompt_file"
      # Guard: skip if worktree already has an active worker
      if worktree_has_active_worker "$project" "$_target_worktree"; then
        log_warn "worker skipped: worktree busy — $_target_worktree"
        continue
      fi
      # Compute previous_worker_task_id: latest completed worker for same raw_key
      _prev_worker_id=""
      _prev_worker_summary=""
      if [[ -n "$_raw_key" ]]; then
        local _prev_json
        _prev_json=$(python3 "$_a2a_task_py" latest-completed-worker --raw-key "$_raw_key" 2>/dev/null || true)
        _prev_worker_id=$(echo "$_prev_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('task_id',''))" 2>/dev/null || echo "")
        _prev_worker_summary=$(echo "$_prev_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('completion_summary',''))" 2>/dev/null || echo "")
      fi
      # Determine if followthrough (worktree had prior completed worker) or fresh fork
      _is_followthrough="false"
      if [[ -n "$_target_worktree" ]]; then
        local _existing_completed
        _existing_completed=$(python3 "$_a2a_task_py" active-workers --worktree "$_target_worktree" 2>/dev/null | \
          python3 -c "import json,sys; data=json.load(sys.stdin); print(len(data.get('rows',[])))" 2>/dev/null || echo "0")
        # Check if worktree has completed workers (not launched)
        local _completed_count
        _completed_count=$(python3 -c "
import json,subprocess,sys
r=subprocess.run([sys.executable,'$_a2a_task_py','list','--role','worker','--status','completed'],
                 capture_output=True,text=True,timeout=5)
data=json.loads(r.stdout) if r.returncode==0 else {}
print(sum(1 for r in data.get('rows', []) if r.get('worktree','')=='$_target_worktree'))
" 2>/dev/null || echo "0")
        [[ "${_completed_count:-0}" -gt 0 ]] && _is_followthrough="true"
      fi
      # INSERT pending handoff record with computed prev_worker
      _task_id=""
      if [[ -f "$_a2a_task_py" && -f "$_db_path" ]]; then
        _task_id=$(python3 "$_a2a_task_py" insert \
          --role worker --agent-id "$(grep -F "$_target_worktree" "${PROJECT_ROOT}/.freely/agent-id.env" 2>/dev/null | grep -oE 'worker_[0-9]+' | head -1 || echo "worker")" --raw-key "$_raw_key" \
          --prompt-file "$_prompt_file" --worktree "$_target_worktree" \
          --created-by manager --consumed-by manager \
          --parent "$_parent_task_id" --prev-worker "$_prev_worker_id" 2>/dev/null || true)
      fi
      # WORKER_HANDOFF_INJECT: prepend worker-agent.md role + skill context,
      # then append a2a-exit contract.
      if [[ -n "$_task_id" && -f "$_prompt_file" ]]; then
        local _prev_summary_truncated _worker_agent_md
        _prev_summary_truncated="${_prev_worker_summary:0:80}"
        # Inject worker-agent.md as role definition so the Worker knows its
        # capabilities, intent_kind→skill mapping, and completion contract.
        _worker_agent_md="$SELF_ROOT/docs/system/workspace/agents/worker-agent.md"
        if [[ -f "$_worker_agent_md" ]]; then
          local _tmp_prompt
          _tmp_prompt="$(mktemp "$_prompts_dir/tmp.XXXXXX")"
          cat "$_worker_agent_md" "$_prompt_file" > "$_tmp_prompt"
          mv "$_tmp_prompt" "$_prompt_file"
        fi
        cat >> "$_prompt_file" <<'WORKER_STATE_INJECT'

---

本轮结束时必须调用 a2a-exit 工具（见 worker-agent.md）。不要输出 JSON block：

```json
{
  "state": "completed",
  "summary": "...",
  "evidence": "..."
}
```

WORKER_STATE_INJECT
        cat >> "$_prompt_file" <<EOF

- task_id: ${_task_id}
- parent_task_id: ${_parent_task_id}
- 上轮产出: ${_prev_summary_truncated:-无}

EOF
      fi
      if launch_worker_from_manager_prompt_if_needed "$project" "$_prompt_file" "$_target_worktree" "$_a2a_task_id"; then
        _launched_count=$((_launched_count + 1))
        log_info "worker launched: $(basename "$_prompt_file")"
        if [[ -n "$_task_id" && -f "$_a2a_task_py" && -f "$_db_path" ]]; then
          python3 "$_a2a_task_py" update \
            --task-id "$_task_id" --status "launched" --expected-status "pending" >/dev/null 2>&1 || true
          # Also update A2A task with session_id if we didn't capture it in launch
          if [[ -n "$_a2a_task_id" && "$_a2a_task_id" != "$_task_id" ]]; then
            python3 "$_a2a_task_py" update \
              --task-id "$_a2a_task_id" --status "working" >/dev/null 2>&1 || true
          fi
        fi
      else
        log_warn "worker launch failed: $(basename "$_prompt_file") — ${LAUNCH_REJECT_REASON:-launchable check failed}"
        if [[ -n "$_task_id" && -f "$_a2a_task_py" && -f "$_db_path" ]]; then
          python3 "$_a2a_task_py" update \
            --task-id "$_task_id" --status "rejected" --expected-status "pending" --exit-kind "launch_failed" \
            --reason "${LAUNCH_REJECT_REASON:-launchable check failed}" >/dev/null 2>&1 || true
        fi
      fi
    done <<< "$_worker_tasks"
  fi
  launched_count="$_launched_count"
  [[ "$launched_count" =~ ^[0-9]+$ ]] || launched_count="0"
  if (( launched_count > 0 )); then
    append_runtime_event "$project" "manager_worker_launch_after_ai_cycle" \
      "launched_count=$launched_count" \
      "exit_reason=$exit_reason"
  fi
  printf '%s\n' "$launched_count"
}

# _ai_shows_liveness: adapter-aware AI liveness check.
# direct mode: check debug log mtime + process state (PID-based).
# acp mode:    check debug log mtime + bridge process + Unix socket heartbeat.
# Returns 0 (active) if any signal shows recent work; 1 (inactive) otherwise.
_ai_shows_liveness() {
  local project="$1" ai_pid="$2" cycle_log="$3" threshold_secs="${4:-90}"
  local adapter="${AGENT_AI_TOOL_ADAPTER:-direct}"

  case "$adapter" in
    acp)
      _ai_shows_liveness_acp "$project" "$ai_pid" "$cycle_log" "$threshold_secs"
      ;;
    *)
      _ai_shows_liveness_pid_signals "$ai_pid" "$cycle_log" "$threshold_secs"
      ;;
  esac
}

# _ai_shows_liveness_acp: ACP-native liveness check.
# Signal 1: debug log mtime (same as direct — server writes on stream chunks).
# Signal 2: bridge process alive (bridge PID = AI process handle).
# Signal 3: Unix socket exists and accepts connections (bridge is responsive).
_ai_shows_liveness_acp() {
  local project="$1" ai_pid="$2" cycle_log="$3" threshold_secs="${4:-90}"
  local now debug_log debug_mtime
  now="$(date +%s)"

  # Signal 1: debug log mtime
  debug_log="${cycle_log%.log}.debug.log"
  if [[ -f "$debug_log" ]]; then
    debug_mtime="$(file_mtime_epoch "$debug_log" 2>/dev/null || true)"
    if [[ -n "$debug_mtime" ]] && (( now - debug_mtime < threshold_secs )); then
      return 0
    fi
  fi

  # Signal 2: bridge process alive
  if [[ -n "$ai_pid" ]] && kill -0 "$ai_pid" 2>/dev/null; then
    local proc_state
    proc_state=$(ps -o state= -p "$ai_pid" 2>/dev/null | tr -d ' ')
    if [[ "$proc_state" == "R" || "$proc_state" == "S" ]]; then
      # Check for fatal errors before returning active — a process that
      # is technically alive but stuck on unrecoverable errors is not healthy.
      _acp_bridge_has_fatal_error "$project" && return 1
      return 0
    fi
  fi

  # Signal 3: ACP bridge socket responsive
  local bridge_socket; bridge_socket="$(_acp_bridge_socket "$project" "$base_tool")"
  if [[ -S "$bridge_socket" ]]; then
    # Quick socket probe: connect and disconnect (non-blocking check)
    if python3 -c "
import socket, sys
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(2)
    s.connect('$bridge_socket')
    s.close()
except Exception:
    sys.exit(1)
" 2>/dev/null; then
      # Check for fatal errors before returning active (same reason as Signal 2)
      _acp_bridge_has_fatal_error "$project" && return 1
      return 0
    fi
  fi

  # Signal 4: unified fatal error detection from bridge log.
  # (Fallback when neither process nor socket signals are available.)
  if _acp_bridge_has_fatal_error "$project"; then
    return 1
  fi

  # Signal 5: A2A worker liveness — if workers are alive, the AI may
  # be waiting (not dead). Query A2A task state before declaring dead.
  local _a2a_task_py _a2a_db _active
  _a2a_task_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/a2a_task.py"
  _a2a_db="$project/.freely/freely.db"
  if [[ -f "$_a2a_task_py" && -f "$_a2a_db" ]]; then
    _active=$(python3 "$_a2a_task_py" list --state working 2>/dev/null |       python3 -c "import json,sys; print(len(json.load(sys.stdin).get('rows',[])))" 2>/dev/null || echo "0")
    if [[ "${_active:-0}" -gt 0 ]]; then
      return 0  # Workers alive → Manager waiting, not dead
    fi
  fi

  return 1
}

# ── Unified ACP Fatal Error Detection ──────────────────────────────
# Single entry point for detecting unrecoverable errors in the bridge log.
# Used by Signal 4 (mid-cycle) and POST-cycle exit reason classification.
# Returns error_class: usage_limit | auth_failure | network_failure | unknown

_acp_bridge_has_fatal_error() {
  local project="$1"
  local bridge_log
  for bridge_log in "$(run_dir_for_project "$project")"/acp-bridge*.log; do
    [[ -f "$bridge_log" ]] && break
  done
  [[ -f "$bridge_log" ]] || return 1

  # Usage / quota limit (account-level hard cap)
  rg -qi 'UsageLimitExceeded|quota exceeded|billing hard limit|usage limit.*try again' "$bridge_log" 2>/dev/null && return 0

  # Auth failure (invalid/expired API key or token)
  rg -qi '403 Forbidden|401 Unauthorized|invalid.*api.?key|incorrect.*api.?key|api.?key.*invalid|Failed to refresh token' "$bridge_log" 2>/dev/null && return 0

  # Network / transport failure cascade (certificate, handshake, channel)
  rg -qi 'Transport channel closed|HandshakeFailure|received fatal alert|certificate not valid|certificate expired|worker quit with fatal' "$bridge_log" 2>/dev/null && return 0

  # Upstream API unreachable (common to all ACP tools)
  rg -qi 'stream disconnected before completion|error sending request for url|failed to refresh available models|server stdout closed' "$bridge_log" 2>/dev/null && return 0

  # Session lost (bridge restart, process death, or backend eviction)
  rg -qi 'Session not found|Internal error|Resource not found' "$bridge_log" 2>/dev/null && return 0

  return 1
}

# _ai_shows_liveness_pid_signals: PID-based liveness check (direct mode).
_ai_shows_liveness_pid_signals() {
  local ai_pid="$1" cycle_log="$2" threshold_secs="${3:-90}"
  local now debug_log debug_mtime
  now="$(date +%s)"

  # Signal 1: debug log mtime (updated on every stream chunk / tool dispatch)
  debug_log="${cycle_log%.log}.debug.log"
  if [[ -f "$debug_log" ]]; then
    debug_mtime="$(file_mtime_epoch "$debug_log" 2>/dev/null || true)"
    if [[ -n "$debug_mtime" ]] && (( now - debug_mtime < threshold_secs )); then
      return 0
    fi
  fi

  # Signal 2: AI process exists and is in Running/Sleeping state
  if [[ -n "$ai_pid" ]] && kill -0 "$ai_pid" 2>/dev/null; then
    local proc_state
    proc_state=$(ps -o state= -p "$ai_pid" 2>/dev/null | tr -d ' ')
    if [[ "$proc_state" == "R" || "$proc_state" == "S" ]]; then
      return 0
    fi
  fi

  return 1
}

# ── ACP Bridge lifecycle ─────────────────────────────────────────
# The ACP bridge (acp-bridge.py) keeps claude-agent-acp alive across AI cycles.
# Managed only when AGENT_AI_TOOL_ADAPTER=acp.

_acp_bridge_short_hash() {
  local project="$1"
  printf '%s' "$project" | shasum -a 256 | cut -c1-16
}

_acp_bridge_pid_file() {
  local project="$1" base_tool="${2:-}"
  local _suffix=""
  # Default to manager's base_tool when not specified (per-tool bridge naming)
  if [[ -z "$base_tool" ]]; then
    local _at="${PROJECT_ROOT}/.freely/agent-table.toml" _aq="${PROJECT_ROOT}/bin/agent-table-query"
    if [[ -f "$_at" && -x "$_aq" ]]; then
      local _mgr_slot; _mgr_slot=$("$_aq" --get-slot "manager_01" 2>/dev/null || true)
      [[ -n "$_mgr_slot" ]] && base_tool="${_mgr_slot%%-*}"
    fi
  fi
  [[ -n "$base_tool" ]] && _suffix="-${base_tool}"
  echo "/tmp/freely-acp-$(_acp_bridge_short_hash "$project")${_suffix}.pid"
}

_acp_bridge_socket() {
  local project="$1" base_tool="${2:-}"
  local _suffix=""
  # Default to manager's base_tool when not specified (per-tool bridge naming)
  if [[ -z "$base_tool" ]]; then
    local _at="${PROJECT_ROOT}/.freely/agent-table.toml" _aq="${PROJECT_ROOT}/bin/agent-table-query"
    if [[ -f "$_at" && -x "$_aq" ]]; then
      local _mgr_slot; _mgr_slot=$("$_aq" --get-slot "manager_01" 2>/dev/null || true)
      [[ -n "$_mgr_slot" ]] && base_tool="${_mgr_slot%%-*}"
    fi
  fi
  [[ -n "$base_tool" ]] && _suffix="-${base_tool}"
  echo "/tmp/freely-acp-$(_acp_bridge_short_hash "$project")${_suffix}.sock"
}

_acp_bridge_health_check() {
  local project="$1" timeout="${2:-5}" base_tool="${3:-}" socket
  socket="$(_acp_bridge_socket "$project" "$base_tool")"
  [[ -S "$socket" ]] || return 1
  FREELY_ACP_HEALTH_SOCKET="$socket" FREELY_ACP_HEALTH_TIMEOUT="$timeout" python3 -c "
import os, socket, json, sys
sp = os.environ.get('FREELY_ACP_HEALTH_SOCKET', '')
if not sp:
    sys.exit(1)
timeout = float(os.environ.get('FREELY_ACP_HEALTH_TIMEOUT', '5'))
sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.settimeout(timeout)
try:
    sock.connect(sp)
    sock.sendall(json.dumps({'jsonrpc':'2.0','id':9999,'method':'initialize','params':{'protocolVersion':1,'clientCapabilities':{}}}).encode() + b'\n')
    data = sock.recv(4096)
    for line in data.split(b'\n'):
        line = line.strip()
        if not line:
            continue
        resp = json.loads(line)
        if resp.get('id') == 9999 and 'result' in resp:
            sys.exit(0)
    sys.exit(1)
except Exception:
    sys.exit(1)
finally:
    sock.close()
" 2>/dev/null
}

