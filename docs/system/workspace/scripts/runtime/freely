    printf '%s\n' "$wt_path"
    return 0
  done < <(all_repo_worktrees_for_project "$project")
}

project_active_ownership_conflict_snapshot() {
  local project="$1"
  local summary signature repo_root continuity_file holder_state holder_branch conflicting_project holder_signature holder_status
  summary="$(project_active_ownership_conflict_summary "$project")"
  signature="$(project_current_blocking_intent_signature "$project")"
  if [[ -n "$summary" && -n "$signature" ]]; then
    repo_root="$(git -C "$project" rev-parse --show-toplevel 2>/dev/null || true)"
    continuity_file="$(latest_generated_manager_continuity_file_for_project "${repo_root:-$project}")"
    IFS='|' read -r holder_state holder_branch conflicting_project holder_signature holder_status <<<"$(ownership_holder_snapshot_for_blocking_intent_signature "${repo_root:-$project}" "$project" "$continuity_file" "" "$signature")"
    printf 'active|%s|%s|%s\n' "$summary" "$signature" "${conflicting_project:-none}"
    return 0
  fi
  printf 'none|none|none|none\n'
}

manager_frozen_blocking_intent_signatures_csv() {
  local project="$1" continuity_file="$2"
  local prompt_file signature csv=""
  [[ -n "$continuity_file" && -f "$continuity_file" ]] || {
    printf '\n'
    return 0
  }
  while IFS= read -r prompt_file; do
