        print substr(remaining, RSTART, RLENGTH)
        remaining=substr(remaining, RSTART + RLENGTH)
      }
    }
    /^## / {
      section=tolower(substr($0, 4))
      gsub(/[`[:space:]]+$/, "", section)
      gsub(/[[:space:]]+\/[[:space:]]+/, "|", section)
      capture_runtime_worker_prompt=0
      capture_worker_prompt_path_list=0
      worker_prompts_subsection=""
      # Normalize AI-written section header variations to canonical names.
      # The AI may write "Worker Prompt" (singular), "Worker Dispatch",
      # "Worker Delegation", "Worker Prompt References", etc.
      if (section == "worker prompt" || section == "worker dispatch" || section == "worker prompt references" || section == "worker prompts in force") {
        section = "worker prompts"
      }
      next
    }
    /^# / {
      section=""
      capture_runtime_worker_prompt=0
      capture_worker_prompt_path_list=0
      worker_prompts_subsection=""
      next
    }
