worker_ai_stalled_after_delegated_continuation_prompt() {
  local project="$1" threshold_secs="${2:-90}"
  local ai_pid cycle_log prompt_file log_mtime prompt_mtime now

  ai_pid="$(runtime_ai_pid_hint_for_project "$project")"
  [[ -n "$ai_pid" ]] || return 1
  cycle_log="$(latest_cycle_log_for_project "$project")"
  [[ -n "$cycle_log" && -f "$cycle_log" ]] || return 1
  prompt_file="$(latest_prompt_file_for_project "$project")"
  [[ -n "$prompt_file" && -f "$prompt_file" ]] || return 1
