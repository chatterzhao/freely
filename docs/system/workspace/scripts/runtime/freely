count_restore_operator_anchors_for_project() {
  local project="$1" launch_state manager_continuity worker_continuity resolution_file prompt_file intake_count count=0
  launch_state="$(manager_worker_launch_state_file "$project")"
  manager_continuity="$(latest_generated_manager_continuity_file_for_project "$project")"
  worker_continuity="$(latest_worker_continuity_file_for_project "$project")"
  resolution_file="$(latest_interruption_resolution_file_for_project "$project")"
  prompt_file="$(find_latest_prompt_file_for_project "$project")"
  intake_count="$(count_active_intake_items "$project")"

  [[ -f "$launch_state" ]] && count=$((count + 1))
  [[ -n "$manager_continuity" && -f "$manager_continuity" ]] && count=$((count + 1))
  [[ -n "$worker_continuity" && -f "$worker_continuity" ]] && count=$((count + 1))
  [[ -n "$resolution_file" && -f "$resolution_file" ]] && count=$((count + 1))
  [[ -n "$prompt_file" && -f "$prompt_file" ]] && count=$((count + 1))
  if [[ "${intake_count:-0}" =~ ^[0-9]+$ ]] && (( intake_count > 0 )); then
    count=$((count + 1))
  fi
  printf '%s\n' "$count"
}

global_restart_history_retention() {
  printf '20\n'
}

retain_latest_global_restart_history() {
  local history_dir="$1" keep_count="${2:-20}" path total_count=0
  [[ -d "$history_dir" ]] || return 0
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    total_count=$((total_count + 1))
    if (( total_count > keep_count )); then
      rm -f "$path"
    fi
  done < <(find "$history_dir" -maxdepth 1 -type f -name '*.json' | sort -r)
}

global_restart_manifest_timestamp() {
