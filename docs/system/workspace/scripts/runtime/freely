slugify_text() {
  local text="$1"
  printf '%s\n' "$text" \
    | tr '[:upper:]' '[:lower:]' \
    | tr -cs 'a-z0-9' '-' \
    | sed 's/^-//; s/-$//' \
    | cut -c1-32
}

next_intake_id() {
  local project="$1" message="$2"
  local ts slug base candidate n intake_root
  ts="$(date '+%Y%m%d-%H%M%S')"
  slug="$(slugify_text "$message")"
  [[ -n "$slug" ]] || slug="message"
  base="${ts}-${slug}"
  candidate="$base"
  n=1
  intake_root="$(intake_dir_for_project "$project")"
  mkdir -p "$intake_root"
  while [[ -e "$intake_root/$candidate" ]]; do
    n=$((n + 1))
    candidate="${base}-${n}"
  done
  printf '%s\n' "$candidate"
}

count_intake_items_by_status() {
  local project="$1" expected_status="$2"
  local intake_root meta_file count
  intake_root="$(intake_dir_for_project "$project")"
  [[ -d "$intake_root" ]] || {
    printf '0\n'
    return 0
  }
  count=0
  while IFS= read -r meta_file; do
    [[ -f "$meta_file" ]] || continue
    if awk -F '"' -v expected="$expected_status" '/^STATUS=/{ if ($2 == expected) found=1 } END { exit found ? 0 : 1 }' "$meta_file"; then
      count=$((count + 1))
    fi
  done < <(find "$intake_root" -mindepth 2 -maxdepth 2 -type f -name meta.env | sort)
  printf '%s\n' "$count"
}

count_active_intake_items() {
  local project="$1"
  local intake_root meta_file count
  intake_root="$(intake_dir_for_project "$project")"
  [[ -d "$intake_root" ]] || {
    printf '0\n'
    return 0
  }
  count=0
  while IFS= read -r meta_file; do
    [[ -f "$meta_file" ]] || continue
    if intake_item_counts_as_active_in_current_round "$project" "$meta_file"; then
      count=$((count + 1))
    fi
  done < <(find "$intake_root" -mindepth 2 -maxdepth 2 -type f -name meta.env | sort)
  printf '%s\n' "$count"
}

intake_item_counts_as_active_in_current_round() {
  local project="$1" meta_file="$2"
  local project_real status absorption_target delegated_worktree delegated_real
  local created_at item_epoch continuity_floor_epoch intake_id active_consumed_ids

  [[ -f "$meta_file" ]] || return 1
  status="$(meta_env_status_value "$meta_file")"
  case "$status" in
    absorbed|dropped) return 1 ;;
    new|classified) return 0 ;;
    delegated) ;;
    *)
      load_meta_env_snapshot "$meta_file"
      status="$LOADED_META_STATUS"
      case "$status" in
        absorbed|dropped) return 1 ;;
        delegated) ;;
        *) return 0 ;;
      esac
      ;;
  esac

  load_meta_env_snapshot "$meta_file"
  absorption_target="$LOADED_META_ABSORPTION_TARGET"
  [[ "$absorption_target" == "handoff://continuation" ]] || return 0

  continuity_floor_epoch="$(delegated_continuation_freshness_floor_epoch_for_project "$project")"
  created_at="$LOADED_META_CREATED_AT"
  item_epoch="$(timestamp_epoch_or_zero "$created_at")"
  if [[ ! "$item_epoch" =~ ^[0-9]+$ || "$item_epoch" -le 0 ]]; then
    item_epoch="$(file_mtime_epoch "$meta_file" 2>/dev/null || true)"
  fi
  [[ "$item_epoch" =~ ^[0-9]+$ ]] || item_epoch="0"
  if (( continuity_floor_epoch > 0 && item_epoch > 0 && item_epoch <= continuity_floor_epoch )); then
    return 1
  fi

  delegated_worktree="$LOADED_META_DELEGATED_WORKTREE"
  [[ -n "$delegated_worktree" ]] || return 0
  delegated_real="$(cd "$delegated_worktree" 2>/dev/null && pwd -P || true)"
  [[ -n "$delegated_real" ]] || return 0
  project_real="$(cd "$project" && pwd -P)"
  [[ "$delegated_real" == "$project_real" ]] || return 1

  intake_id="$LOADED_META_INTAKE_ID"
  [[ -n "$intake_id" ]] || intake_id="$(basename "$(dirname "$meta_file")")"
  active_consumed_ids="$(active_prompt_consumed_delegation_ids_for_project "$project")"
  if [[ -n "$active_consumed_ids" ]] && csv_contains_exact_item "$active_consumed_ids" "$intake_id"; then
    return 1
  fi
  return 0
}

has_local_delegated_worker_reactivation_target() {
  local project="$1"
  local intake_root meta_file status absorption_target delegated_worktree project_real delegated_real
  intake_root="$(intake_dir_for_project "$project")"
  [[ -d "$intake_root" ]] || return 1
  project_real="$(cd "$project" && pwd -P)"
  while IFS= read -r meta_file; do
    [[ -f "$meta_file" ]] || continue
    status="$(meta_env_value "$meta_file" "STATUS")"
    absorption_target="$(meta_env_value "$meta_file" "ABSORPTION_TARGET")"
    delegated_worktree="$(meta_env_value "$meta_file" "DELEGATED_WORKTREE")"
    [[ "$status" == "delegated" ]] || continue
    case "$absorption_target" in
      handoff://continuation|handoff://verification) ;;
      *) continue ;;
    esac
    delegated_real=""
    if [[ -n "$delegated_worktree" ]]; then
      delegated_real="$(cd "$delegated_worktree" 2>/dev/null && pwd -P || true)"
    fi
    if [[ -z "$delegated_real" || "$delegated_real" == "$project_real" ]]; then
      return 0
    fi
  done < <(find "$intake_root" -mindepth 2 -maxdepth 2 -type f -name meta.env | sort)
  return 1
}

meta_env_value() {
  local meta_file="$1" key="$2"
  [[ -f "$meta_file" ]] || return 0
  awk -F '"' -v key="$key" '$1 == key "=" { print $2; exit }' "$meta_file"
}

meta_env_status_value() {
  local meta_file="$1"
  [[ -f "$meta_file" ]] || return 0
  awk -F '"' '/^STATUS=/{ print $2; exit }' "$meta_file"
}

clear_loaded_meta_env_snapshot() {
  LOADED_META_INTAKE_ID=""
  LOADED_META_CREATED_AT=""
  LOADED_META_AUTHOR=""
  LOADED_META_CHANNEL=""
  LOADED_META_STATUS=""
  LOADED_META_CLASSIFICATION=""
  LOADED_META_REACTION=""
  LOADED_META_LINKED_ARTIFACT=""
  LOADED_META_DELEGATED_WORKTREE=""
  LOADED_META_SESSION_REFS=""
  LOADED_META_CLAIMED_BY=""
  LOADED_META_CLAIMED_AT=""
  LOADED_META_ABSORPTION_TARGET=""
  LOADED_META_RESOLUTION_ARTIFACT=""
  LOADED_META_RESOLVED_BY=""
}

load_meta_env_snapshot() {
  local meta_file="$1"
  local line key raw_value value
  clear_loaded_meta_env_snapshot
  [[ -f "$meta_file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"
    raw_value="${line#*=}"
    value="$(strip_simple_shell_quotes "$raw_value")"
    case "$key" in
      INTAKE_ID) LOADED_META_INTAKE_ID="$value" ;;
      CREATED_AT) LOADED_META_CREATED_AT="$value" ;;
      AUTHOR) LOADED_META_AUTHOR="$value" ;;
      CHANNEL) LOADED_META_CHANNEL="$value" ;;
      STATUS) LOADED_META_STATUS="$value" ;;
      CLASSIFICATION) LOADED_META_CLASSIFICATION="$value" ;;
      REACTION) LOADED_META_REACTION="$value" ;;
      LINKED_ARTIFACT) LOADED_META_LINKED_ARTIFACT="$value" ;;
      DELEGATED_WORKTREE) LOADED_META_DELEGATED_WORKTREE="$value" ;;
      SESSION_REFS) LOADED_META_SESSION_REFS="$value" ;;
      CLAIMED_BY) LOADED_META_CLAIMED_BY="$value" ;;
      CLAIMED_AT) LOADED_META_CLAIMED_AT="$value" ;;
      ABSORPTION_TARGET) LOADED_META_ABSORPTION_TARGET="$value" ;;
      RESOLUTION_ARTIFACT) LOADED_META_RESOLUTION_ARTIFACT="$value" ;;
      RESOLVED_BY) LOADED_META_RESOLVED_BY="$value" ;;
    esac
  done <"$meta_file"
}

