# Check ACP bridge log for usage/rate limit signals that cycle log may miss.
# codex-acp stderr goes to bridge log, not cycle log.
log_has_acp_usage_limit() {
  local project="$1"
  local bridge_log
  for bridge_log in "$(run_dir_for_project "$project")"/acp-bridge*.log; do
    [[ -f "$bridge_log" ]] || continue
    rg -qi 'UsageLimitExceeded|usage limit|rate_limit_exceeded|quota exceeded|billing.*limit|try again|insufficient.*(balance|credit|quota)|429.*Rate|Rate.*429' "$bridge_log" 2>/dev/null && return 0
  done
  return 1
}

log_acp_rate_limit_reset_at() {
  local project="$1" reset_at="" fallback_seconds bridge_log
  for bridge_log in "$(run_dir_for_project "$project")"/acp-bridge*.log; do
    [[ -f "$bridge_log" ]] || continue
    reset_at="$(rg -i 'try again at' "$bridge_log" 2>/dev/null | grep -oE '[0-9]{1,2}:[0-9]{2}\s*(AM|PM)' | head -1 || true)"
    [[ -n "$reset_at" ]] && break
  done
  [[ -n "$reset_at" ]] || return 1
  if [[ -n "$reset_at" ]]; then
    printf '%s\n' "$reset_at"
    return 0
  fi
  fallback_seconds="${CODEX_RATE_LIMIT_FALLBACK_COOLDOWN_SECS:-300}"
  [[ "$fallback_seconds" =~ ^[0-9]+$ ]] || fallback_seconds=300
  date -v+"${fallback_seconds}"S +%s 2>/dev/null || printf '%s\n' "$(( $(date +%s) + fallback_seconds ))"
}

