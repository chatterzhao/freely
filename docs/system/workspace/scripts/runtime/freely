stop_project_runtime() {
  local project="$1" stop_reason="${2:-operator_stop}"
  local sdir run_dir stop_marker supervisor_candidates sp watchdog_candidates dispatcher_candidates
  local stop_lock_acquired="0"
  sdir="$(state_dir "$project")"
  run_dir="$(run_dir_for_project "$project")"
  mkdir -p "$run_dir"
  # Clean stale start lock before acquiring — a force-killed daemon leaves
  # the lock behind, which would block stop with "start already in progress".
  cleanup_project_start_lock_if_stale_for_runtime "$project"
  acquire_project_start_lock_or_wait "$project" "freely_stop" || exit 1
  stop_lock_acquired="1"
  stop_marker="$(stop_marker_file "$project")"
  : >"$stop_marker"

  if [[ -f "$run_dir/ai.pid" ]]; then
    local ap
    ap="$(cat "$run_dir/ai.pid" 2>/dev/null || true)"
    if valid_ai_pid_for_project "$project" "$ap"; then
      terminate_pid_with_graceful_wait "$ap" "project ai pid during stop"
    elif [[ -n "$ap" ]]; then
      log_warn "ignoring stale ai.pid that is not owned by project: $ap"
    fi
    rm -f "$run_dir/ai.pid"
  fi
  if [[ -f "$(ensure_manager_watchdog_pid_file "$project")" ]]; then
    local wp
    wp="$(cat "$(ensure_manager_watchdog_pid_file "$project")" 2>/dev/null || true)"
    if project_owned_manager_watchdog_pid_for_project "$project" "$wp"; then
      watchdog_candidates="$wp"
    elif [[ -n "$(pid_hint_from_file_without_process_inspection "$wp" 2>/dev/null || true)" ]]; then
      log_warn "refusing to kill unverified manager watchdog pid without project ownership proof: $wp"
    elif [[ -n "$wp" ]]; then
      log_warn "ignoring stale ensure-manager.pid that is not owned by project: $wp"
    fi
    rm -f "$(ensure_manager_watchdog_pid_file "$project")"
  fi
  while IFS= read -r sp; do
    [[ -n "$sp" ]] || continue
    if [[ -n "$watchdog_candidates" ]]; then
      watchdog_candidates+=$'\n'
    fi
    watchdog_candidates+="$sp"
  done < <(discover_manager_watchdog_pids "$project")
  if [[ -f "$(interruption_dispatcher_pid_file "$project")" ]]; then
    local dp
    dp="$(cat "$(interruption_dispatcher_pid_file "$project")" 2>/dev/null || true)"
    if project_owned_interruption_dispatcher_pid_for_project "$project" "$dp"; then
      dispatcher_candidates="$dp"
    elif [[ -n "$(pid_hint_from_file_without_process_inspection "$dp" 2>/dev/null || true)" ]]; then
      log_warn "refusing to kill unverified interruption-dispatch.pid without project ownership proof: $dp"
    elif [[ -n "$dp" ]]; then
      log_warn "ignoring stale interruption-dispatch.pid that is not owned by project: $dp"
    fi
    rm -f "$(interruption_dispatcher_pid_file "$project")"
  fi
  while IFS= read -r sp; do
    [[ -n "$sp" ]] || continue
    if [[ -n "$dispatcher_candidates" ]]; then
      dispatcher_candidates+=$'\n'
    fi
    dispatcher_candidates+="$sp"
  done < <(discover_interruption_dispatcher_pids "$project")
  if [[ -n "$watchdog_candidates" ]]; then
    while IFS= read -r sp; do
      [[ -n "$sp" ]] || continue
      project_owned_manager_watchdog_pid_for_project "$project" "$sp" || continue
      terminate_pid_with_graceful_wait "$sp" "project manager watchdog during stop"
    done < <(printf '%s\n' "$watchdog_candidates" | awk '!seen[$0]++')
  fi
  if [[ -n "$dispatcher_candidates" ]]; then
    while IFS= read -r sp; do
      [[ -n "$sp" ]] || continue
      project_owned_interruption_dispatcher_pid_for_project "$project" "$sp" || continue
      terminate_pid_with_graceful_wait "$sp" "project interruption dispatcher during stop"
    done < <(printf '%s\n' "$dispatcher_candidates" | awk '!seen[$0]++')
  fi
  if [[ -f "$run_dir/supervisor.pid" ]]; then
    sp="$(cat "$run_dir/supervisor.pid" 2>/dev/null || true)"
    if valid_supervisor_pid_for_project "$project" "$sp"; then
      supervisor_candidates="$sp"
    fi
    rm -f "$run_dir/supervisor.pid"
  fi
  while IFS= read -r sp; do
    [[ -n "$sp" ]] || continue
    if [[ -n "$supervisor_candidates" ]]; then
      supervisor_candidates+=$'\n'
    fi
    supervisor_candidates+="$sp"
  done < <(discover_supervisor_pids "$project")
  if [[ -n "$supervisor_candidates" ]]; then
    while IFS= read -r sp; do
      [[ -n "$sp" ]] || continue
      valid_discovered_supervisor_pid_for_project "$project" "$sp" || continue
      : >"$stop_marker"
      terminate_pid_with_graceful_wait "$sp" "project supervisor during stop"
    done < <(printf '%s\n' "$supervisor_candidates" | awk '!seen[$0]++')
  fi
  # Stop all ACP bridges by tracked pid (per-tool naming)
  local _bridge_pid_file _bridge_pid
  for _bridge_pid_file in /tmp/freely-acp-$(_acp_bridge_short_hash "$project")-*.pid; do
    [[ -f "$_bridge_pid_file" ]] || continue
    _bridge_pid="$(cat "$_bridge_pid_file" 2>/dev/null || true)"
    if [[ -n "$_bridge_pid" ]] && kill -0 "$_bridge_pid" 2>/dev/null; then
      terminate_pid_with_graceful_wait "$_bridge_pid" "project acp bridge during stop"
    fi
    rm -f "$_bridge_pid_file"
  done
  # Clean up all per-tool bridge sockets
  rm -f /tmp/freely-acp-$(_acp_bridge_short_hash "$project")-*.sock
  # Stop A2A Server — multi-layer cleanup for zombie prevention
  local _a2a_socket _a2a_cached_pid _a2a_cached_pid_file
  _a2a_socket="$(_a2a_socket_path "$project")"
  _a2a_cached_pid_file="$(run_dir_for_project "$project")/a2a-server.pid"
  # Layer 1: graceful shutdown via a2a_server.py --stop (reads its own temp PID file)
  python3 "$SELF_ROOT/docs/system/workspace/scripts/runtime/a2a/a2a_server.py" \
    --project "$project" --stop >/dev/null 2>&1 || true
  # Layer 2: direct PID kill from cached file written by ensure_a2a_server_running
  if [[ -f "$_a2a_cached_pid_file" ]]; then
    _a2a_cached_pid="$(cat "$_a2a_cached_pid_file" 2>/dev/null || true)"
    if [[ -n "$_a2a_cached_pid" ]]; then
      terminate_pid_with_graceful_wait "$_a2a_cached_pid" "a2a server (cached pid)"
    fi
    rm -f "$_a2a_cached_pid_file"
  fi
  # Layer 3: pkill fallback for any remaining zombie processes
  pkill -f "python3.*a2a_server\.py.*--project.*${project}.*--start" 2>/dev/null || true
  rm -f "$_a2a_socket"
  # Stop DB daemon via PID file
  local _db_pid_file _db_pid
  _db_pid_file="$(python3 -c "
import hashlib,os
h=hashlib.sha256(os.path.abspath('$project').encode()).hexdigest()[:16]
print(f'/tmp/freely-db-{h}.pid')
" 2>/dev/null || true)"
  if [[ -n "$_db_pid_file" && -f "$_db_pid_file" ]]; then
    _db_pid="$(cat "$_db_pid_file" 2>/dev/null || true)"
    if [[ -n "$_db_pid" ]] && kill -0 "$_db_pid" 2>/dev/null; then
      terminate_pid_with_graceful_wait "$_db_pid" "freely-db daemon during stop"
    fi
    rm -f "$_db_pid_file"
  fi
  if [[ "$(role_hint_for_project "$project")" == "manager" ]]; then
    materialize_missing_required_manager_continuity_fallback "$project" "$stop_reason" || true
    if stop_reason_records_manager_operator_boundary "$stop_reason"; then
      record_manager_operator_stop_boundary "$project"
      clear_manager_worker_launch_state_for_fresh_restart "$project"
    fi
  fi
  # Preserve session state and ACP bridge on restart so next launch
  # can session/resume with cache hits instead of reprocessing from scratch.
  case "$stop_reason" in
    operator_restart|global_restart)
      # Keep session state and bridge alive for resume
      ;;
    *)
      rm -f "$(session_state_file "$project")" "$(exit_contract_file "$project")"
      if [[ "${AGENT_AI_TOOL_ADAPTER:-direct}" == "acp" ]]; then
        _stop_acp_bridge "$project" "${_cross_base_tool:-}"
      fi
      # Aggressively kill ALL project-related AI processes.
      # SIGTERM first, brief wait, then SIGKILL for any survivors.
      local _stop_patterns=(
        "monitor-ai-acp.sh.*--project.*${project}"
        "run-acp-prompt.py.*--bridge-socket"
        "claude.*--session-id.*--replay-user-messages"
        "claude.*--resume [a-f0-9-]\{36\}"
        "claude-agent-acp"
      )
      local _p
      for _p in "${_stop_patterns[@]}"; do
        pkill -f "$_p" 2>/dev/null || true
      done
      sleep 0.3
      for _p in "${_stop_patterns[@]}"; do
        pkill -9 -f "$_p" 2>/dev/null || true
      done
      # Clean up session persistence (Claude tool-homes)
      local _tool_home="${project}/.freely/tool-homes/claude"
      rm -rf "${_tool_home}/.claude/sessions" 2>/dev/null || true
      rm -rf "${_tool_home}/.claude/session-env" 2>/dev/null || true
      ;;
  esac
  # Last-resort cleanup: kill any remaining project processes that escaped
  # PID-file-based termination. Industry pattern: nginx -s quit + SIGTERM + SIGKILL.
  local _cleanup_patterns=(
    "freely.*daemon-run.*--project.*${project}"
    "freely.*ensure-manager.*--project.*${project}"
    "freely.*ensure-interruption.*--project.*${project}"
    "manager-watchdog.sh.*--project.*${project}"
    "acp-bridge.py.*start.*--project.*${project}"
    "monitor-ai-acp.sh.*--project.*${project}"
    "monitor-ai-cli.sh.*--project.*${project}"
    "watchdog_sse.py.*--project.*${project}"
    "sse-watchdog.sh.*--project.*${project}"
    "a2a_server.py.*--project.*${project}"
    "claude-agent-acp"
    "claude.*--session-id.*--replay-user-messages"
    "run-acp-prompt.py"
  )
  # Add current tool's base binary pattern (derived from registry, not hardcoded)
  local _stop_base_tool="${AGENT_AI_TOOL%%-*}"
  # Fallback: read from agent-table if AGENT_AI_TOOL not set (stop command in fresh shell)
  if [[ -z "$_stop_base_tool" && -x "$SELF_ROOT/bin/agent-table-query" ]]; then
    local _stop_slot; _stop_slot=$("$SELF_ROOT/bin/agent-table-query" --get-slot manager_01 2>/dev/null || true)
    [[ -n "$_stop_slot" ]] && _stop_base_tool="${_stop_slot%%-*}"
  fi
  [[ -n "$_stop_base_tool" && "$_stop_base_tool" != "claude" ]] && _cleanup_patterns+=("$_stop_base_tool")
  for _p in "${_cleanup_patterns[@]}"; do
    pkill -f "$_p" 2>/dev/null || true
  done
  sleep 0.3
  for _p in "${_cleanup_patterns[@]}"; do
    pkill -9 -f "$_p" 2>/dev/null || true
  done
  rm -f "$stop_marker"
  write_workcell_state "$project" "stopped" "down" "down" "$stop_reason"
  _update_test_gate "$project" "completed"
  if [[ "$stop_lock_acquired" == "1" ]]; then
    release_project_start_lock_for_runtime "$project"
  fi
}

project_has_active_runtime_processes() {
  local project="$1"
  [[ -n "$(manager_supervisor_pid_for_project "$project")" ]] && return 0
  [[ -n "$(manager_watchdog_pid_for_project "$project")" ]] && return 0
  [[ -n "$(interruption_dispatcher_pid_for_project "$project")" ]] && return 0
  [[ -n "$(runtime_ai_pid_hint_for_project "$project")" ]] && return 0
  return 1
}

project_has_authoritative_runtime_processes_for_user_precheck() {
  local project="$1" run_dir supervisor_pid
  run_dir="$(run_dir_for_project "$project")"

  cleanup_project_start_lock_if_stale_for_runtime "$project"
  project_start_lock_snapshot_for_runtime "$project"
  if [[ "${CURRENT_PROJECT_START_LOCK_STATE:-idle}" == "active" ]] \
    && [[ "${CURRENT_PROJECT_START_LOCK_REASON:-none}" == "freely_start" ]] \
    && [[ "${CURRENT_PROJECT_START_LOCK_OWNER_PID:-none}" != "$$" ]]; then
    return 0
  fi

  if [[ -f "$run_dir/supervisor.pid" ]]; then
    supervisor_pid="$(cat "$run_dir/supervisor.pid" 2>/dev/null || true)"
    if valid_supervisor_pid_for_project "$project" "$supervisor_pid"; then
      return 0
    fi
  fi
  [[ -n "$(authoritative_supervisor_pids_for_project "$project" | head -n 1)" ]] && return 0

  return 1
}

reject_repeated_user_start_if_running() {
  local project="$1" command_name="$2"
  if project_has_authoritative_runtime_processes_for_user_precheck "$project"; then
    append_runtime_event "$project" "user_start_rejected_already_running" \
      "command_name=$command_name"
    log_error "$command_name refused: project runtime is already running for $project"
    log_error "run: freely stop --project \"$project\""
    log_error "or:  freely $command_name --project \"$project\" --force"
    exit 2
  fi
}

resolve_active_supervisor_pid_for_start() {
  local project="$1" sup_pid_file="$2"
  local candidate_pid="" excluded_pids=""
  RESOLVED_ACTIVE_SUPERVISOR_PID=""
  LAST_ATTACH_REUSE_SUPERVISOR_SOURCE=""
  excluded_pids="$(current_runtime_discovery_excluded_pids_csv)"
  # Always exclude the current process itself from supervisor discovery.
  # macOS bash 3.2 lacks BASHPID, so the subshell-based exclusion chain may
  # not include $$ when the lookup starts from a command-substitution subshell.
  excluded_pids="${excluded_pids}${excluded_pids:+,}$$"
  if [[ -f "$sup_pid_file" ]]; then
    candidate_pid="$(cat "$sup_pid_file" 2>/dev/null || true)"
    if [[ "$candidate_pid" == "$$" ]]; then
      # supervisor.pid points to this process (written by a prior
      # write_supervisor_identity_truth); skip so we don't self-repair.
      :
    elif valid_supervisor_pid_for_project "$project" "$candidate_pid"; then
      LAST_ATTACH_REUSE_SUPERVISOR_SOURCE="supervisor_pid_file"
      RESOLVED_ACTIVE_SUPERVISOR_PID="$candidate_pid"
      return 0
    fi
    if [[ -n "$candidate_pid" && "$candidate_pid" != "$$" ]]; then
      log_warn "ignoring stale supervisor.pid that is not owned by project: $candidate_pid"
      rm -f "$sup_pid_file"
    fi
  fi

  candidate_pid="$(discover_supervisor_pid "$project" "$excluded_pids")"
  if valid_supervisor_pid_for_project "$project" "$candidate_pid"; then
    log_warn "recovered live project supervisor after supervisor.pid drift: $candidate_pid"
    LAST_ATTACH_REUSE_SUPERVISOR_SOURCE="process_discovery"
    printf '%s\n' "$candidate_pid" >"$sup_pid_file"
    RESOLVED_ACTIVE_SUPERVISOR_PID="$candidate_pid"
    return 0
  fi
  if valid_discovered_supervisor_pid_for_project "$project" "$candidate_pid" && { supervisor_startup_truth_ready_for_project "$project" "$candidate_pid" || project_bootstrap_launch_in_flight "$project" "$candidate_pid" ""; }; then
    log_warn "recovered live project supervisor after supervisor.pid drift: $candidate_pid"
    LAST_ATTACH_REUSE_SUPERVISOR_SOURCE="process_discovery"
    printf '%s\n' "$candidate_pid" >"$sup_pid_file"
    RESOLVED_ACTIVE_SUPERVISOR_PID="$candidate_pid"
    return 0
  fi
  return 1
}

project_runtime_should_keep_running() {
  local project="$1"
  local desired_state last_exit_reason
  [[ -f "$(workcell_state_file "$project")" ]] || return 1
  unset DESIRED_RUNTIME_STATE LAST_EXIT_REASON
  # shellcheck disable=SC1090
  source "$(workcell_state_file "$project")"
  desired_state="${DESIRED_RUNTIME_STATE:-unknown}"
  last_exit_reason="${LAST_EXIT_REASON:-}"
  [[ "$desired_state" == "running" ]] || return 1
  [[ "$last_exit_reason" != "operator_stop" ]]
}

active_runtime_attach_reusable_for_project() {
  local project="$1" sup_pid_file="$2" child_pid_file="$3"
  local old_pid="" attach_ai_pid_state="missing" role_hint
  local attach_ready_attempts="${FREELY_ATTACH_REUSE_READY_ATTEMPTS:-30}"

  LAST_ATTACH_REUSE_SUPERVISOR_PID=""
  LAST_ATTACH_REUSE_AI_PID_STATE="missing"
  resolve_active_supervisor_pid_for_start "$project" "$sup_pid_file" || return 1
  old_pid="${RESOLVED_ACTIVE_SUPERVISOR_PID:-}"
  [[ -n "$old_pid" ]] || return 1

  role_hint="$(role_hint_for_project "$project")"
  if [[ -f "$child_pid_file" ]]; then
    local active_ai_pid
    active_ai_pid="$(cat "$child_pid_file" 2>/dev/null || true)"
    if [[ -n "$active_ai_pid" ]] && ! valid_ai_pid_for_project "$project" "$active_ai_pid"; then
      attach_ai_pid_state="stale_pid_cleared"
      log_warn "clearing stale ai.pid while reusing healthy project supervisor: $active_ai_pid"
      rm -f "$child_pid_file"
    elif [[ -n "$active_ai_pid" ]]; then
      attach_ai_pid_state="confirmed_running"
    fi
  fi

  if [[ "$attach_ai_pid_state" != "confirmed_running" ]] && project_bootstrap_launch_in_flight "$project" "$old_pid" ""; then
    attach_ai_pid_state="bootstrap_in_flight"
    log_warn "project supervisor pid=$old_pid is still bootstrapping; attaching instead of repairing the in-flight startup"
  elif ! FREELY_INTERRUPTION_DISPATCHER_READY_ATTEMPTS="$attach_ready_attempts" ensure_interruption_dispatcher_ready_or_fail "$project"; then
    log_warn "project supervisor pid=$old_pid is live but interruption dispatcher is not ready; falling back to project-local repair"
    return 1
  elif [[ "$role_hint" == "manager" ]] && ! FREELY_MANAGER_WATCHDOG_READY_ATTEMPTS="$attach_ready_attempts" ensure_manager_watchdog_ready_or_fail "$project"; then
    log_warn "project supervisor pid=$old_pid is live but manager watchdog is not ready; falling back to project-local repair"
    return 1
  fi

  # Supervisor is running and healthy — daemon is already up, nothing to do
  log_info "project daemon already running (supervisor pid=$old_pid, ai=${attach_ai_pid_state})"
  return 0
}

emit_supervisor_attach_reuse_truth() {
  local project="$1"
  local ai_pid_state desired_state supervisor_state ai_state exit_reason
  ai_pid_state="${LAST_ATTACH_REUSE_AI_PID_STATE:-missing}"
  desired_state="running"
  supervisor_state="up"
  ai_state="up"
  exit_reason="already_running_attach"

  if [[ "$ai_pid_state" == "bootstrap_in_flight" ]]; then
    ai_state="down"
    exit_reason="starting"
  fi

  write_workcell_state "$project" "$desired_state" "$supervisor_state" "$ai_state" "$exit_reason"
  append_runtime_event "$project" "supervisor_attach_reuse" \
    "supervisor_pid=${LAST_ATTACH_REUSE_SUPERVISOR_PID:-unknown}" \
    "supervisor_pid_source=${LAST_ATTACH_REUSE_SUPERVISOR_SOURCE:-unknown}" \
    "ai_pid_state=$ai_pid_state" \
    "role_hint=$(role_hint_for_project "$project")"
}

ensure_no_active_supervisor_conflict() {
  local project="$1" sup_pid_file="$2" child_pid_file="$3" allow_attach="${4:-0}"
  local old_pid="" attach_ai_pid_state="missing" role_hint unverified_roles=""
  local attach_ready_attempts="${FREELY_ATTACH_REUSE_READY_ATTEMPTS:-30}"
  LAST_ATTACH_REUSE_SUPERVISOR_PID=""
  LAST_ATTACH_REUSE_AI_PID_STATE="missing"
  resolve_active_supervisor_pid_for_start "$project" "$sup_pid_file" || true
  old_pid="${RESOLVED_ACTIVE_SUPERVISOR_PID:-}"
  if [[ -z "$old_pid" ]]; then
    unverified_roles="$(runtime_unverified_pid_roles_for_project "$project")"
    if [[ -n "$unverified_roles" ]]; then
      log_error "process inspection is unavailable and runtime pid files remain unverified for: $unverified_roles"
      log_error "refusing to reuse or replace the runtime without project ownership proof; rerun where process inspection works or clear the stale pid files after confirming the old runtime is gone"
      return 12
    fi
  fi
  if [[ -n "$old_pid" ]]; then
    if [[ "$allow_attach" == "1" ]]; then
      role_hint="$(role_hint_for_project "$project")"
      if [[ -f "$child_pid_file" ]]; then
        local active_ai_pid
        active_ai_pid="$(cat "$child_pid_file" 2>/dev/null || true)"
        if [[ -n "$active_ai_pid" ]] && ! valid_ai_pid_for_project "$project" "$active_ai_pid"; then
          attach_ai_pid_state="stale_pid_cleared"
          log_warn "clearing stale ai.pid while reusing healthy project supervisor: $active_ai_pid"
          rm -f "$child_pid_file"
        elif [[ -n "$active_ai_pid" ]]; then
          attach_ai_pid_state="confirmed_running"
        fi
      fi
      if [[ "$attach_ai_pid_state" != "confirmed_running" ]] && project_bootstrap_launch_in_flight "$project" "$old_pid" ""; then
        attach_ai_pid_state="bootstrap_in_flight"
        log_warn "project supervisor pid=$old_pid is still bootstrapping; attaching instead of repairing the in-flight startup"
        LAST_ATTACH_REUSE_SUPERVISOR_PID="$old_pid"
        LAST_ATTACH_REUSE_AI_PID_STATE="$attach_ai_pid_state"
        log_info "project runtime/control-plane startup already in flight; reusing supervisor pid=$old_pid"
        return 10
      elif ! FREELY_INTERRUPTION_DISPATCHER_READY_ATTEMPTS="$attach_ready_attempts" ensure_interruption_dispatcher_ready_or_fail "$project"; then
        log_warn "project supervisor pid=$old_pid is live but interruption dispatcher is not ready; falling back to project-local repair"
      elif [[ "$role_hint" == "manager" ]] && ! FREELY_MANAGER_WATCHDOG_READY_ATTEMPTS="$attach_ready_attempts" ensure_manager_watchdog_ready_or_fail "$project"; then
        log_warn "project supervisor pid=$old_pid is live but manager watchdog is not ready; falling back to project-local repair"
      elif [[ "$role_hint" == "manager" && "$attach_ai_pid_state" != "confirmed_running" && "$attach_ai_pid_state" != "bootstrap_in_flight" ]]; then
        log_warn "project supervisor pid=$old_pid is live but manager ai pid is ${attach_ai_pid_state}; falling back to project-local repair"
      elif [[ "$role_hint" == "worker" && "$attach_ai_pid_state" != "confirmed_running" && "$attach_ai_pid_state" != "bootstrap_in_flight" ]]; then
        if supervisor_startup_truth_ready_for_project "$project" "$old_pid"; then
          log_warn "project supervisor pid=$old_pid is live, worker startup truth is ready, and ai pid is ${attach_ai_pid_state}; attaching to preserve the active runtime"
          attach_ai_pid_state="startup_truth_ready"
        else
          log_warn "project supervisor pid=$old_pid is live but worker ai pid is ${attach_ai_pid_state}; falling back to project-local repair"
        fi
      else
        LAST_ATTACH_REUSE_SUPERVISOR_PID="$old_pid"
        LAST_ATTACH_REUSE_AI_PID_STATE="$attach_ai_pid_state"
        log_info "project runtime/control-plane already up; reusing supervisor pid=$old_pid"
        return 10
      fi
    fi
    log_warn "repairing partial project control-plane before supervisor restart: $old_pid"
    terminate_pid_with_graceful_wait "$old_pid" "partial project control-plane before supervisor restart"
    rm -f "$sup_pid_file"
    # Also clean up stale dispatcher and watchdog to prevent repair loop
    local stale_dispatcher_pid stale_watchdog_pid
    stale_dispatcher_pid="$(cat "$(interruption_dispatcher_pid_file "$project")" 2>/dev/null || true)"
    if [[ -n "$stale_dispatcher_pid" ]]; then
      terminate_pid_with_graceful_wait "$stale_dispatcher_pid" "stale dispatcher during supervisor repair" 2>/dev/null || true
      rm -f "$(interruption_dispatcher_pid_file "$project")"
    fi
    stale_watchdog_pid="$(cat "$(ensure_manager_watchdog_pid_file "$project")" 2>/dev/null || true)"
    if [[ -n "$stale_watchdog_pid" ]]; then
      terminate_pid_with_graceful_wait "$stale_watchdog_pid" "stale watchdog during supervisor repair" 2>/dev/null || true
      rm -f "$(ensure_manager_watchdog_pid_file "$project")"
    fi
    stale_sse_watchdog_pid="$(cat "$(sse_watchdog_pid_file "$project")" 2>/dev/null || true)"
    if [[ -n "$stale_sse_watchdog_pid" ]]; then
      terminate_pid_with_graceful_wait "$stale_sse_watchdog_pid" "stale SSE watchdog during supervisor repair" 2>/dev/null || true
      rm -f "$(sse_watchdog_pid_file "$project")"
    fi
  fi
  if [[ -f "$child_pid_file" ]]; then
    local active_ai_pid
    active_ai_pid="$(cat "$child_pid_file" 2>/dev/null || true)"
    if valid_ai_pid_for_project "$project" "$active_ai_pid"; then
      log_warn "repairing orphaned project ai pid before supervisor restart: $active_ai_pid"
      terminate_pid_with_graceful_wait "$active_ai_pid" "orphaned project ai pid before supervisor restart"
    elif [[ -n "$(pid_hint_from_file_without_process_inspection "$active_ai_pid" 2>/dev/null || true)" ]]; then
      log_warn "refusing to kill unverified ai.pid before supervisor restart: $active_ai_pid"
    elif [[ -n "$active_ai_pid" ]]; then
      log_warn "ignoring stale ai.pid before supervisor restart: $active_ai_pid"
    fi
    rm -f "$child_pid_file"
  fi
  return 0
}

start_project_runtime() {
  local project="$1" entrypoint_mode="${2:-foreground}" task_mode="${3:-wait}"
  local WORKCELL_ENTRYPOINT_MODE_OVERRIDE="$entrypoint_mode"
  local sup_pid_file child_pid_file
  sup_pid_file="$(run_dir_for_project "$project")/supervisor.pid"
  child_pid_file="$(run_dir_for_project "$project")/ai.pid"
  append_runtime_event "$project" "start_project_runtime_enter" \
    "entrypoint_mode=$entrypoint_mode"
  # When process inspection is unavailable, runtime ownership falls back to cwd checks.
  # Anchor the supervisor itself to the target project so watchdog/attach logic can still
  # prove ownership in degraded environments.
  cd "$project" || {
    log_error "unable to enter project root before runtime start: $project"
    exit 1
  }
  append_runtime_event "$project" "start_project_runtime_after_cd" \
    "entrypoint_mode=$entrypoint_mode"
  load_config "$project"
  if worker_runtime_reconcile_selected_tool_from_contract_if_needed "$project"; then
    load_config "$project"
  fi
  append_runtime_event "$project" "start_project_runtime_after_load_config" \
    "entrypoint_mode=$entrypoint_mode"
  ensure_freely_db "$project"
  ensure_task_mode_gate "$project" "$task_mode"
  # Force fresh scan on daemon start — cached scan may be stale from prior run
  rm -f "$(run_dir_for_project "$project")/manager-task-source-scan-latest.json"
  register_project_in_registry "$project"
  append_runtime_event "$project" "start_project_runtime_after_registry" \
    "entrypoint_mode=$entrypoint_mode"

  # ── Sync develop working tree: verify all platforms are consistent ──
  # Multi-platform governance: every configured remote must agree on develop HEAD.
  # If platforms are out of sync, refuse to start — the operator must resolve.
  # Stashes dirty files instead of discarding. Uses git pull (respects hooks).
  if [[ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)" == "develop" ]]; then
    local _local_sha _first_sha="" _first_remote="" _consistent=1 _divergence_report=""
    _local_sha="$(git rev-parse HEAD 2>/dev/null || true)"

    # Detect dirty working tree — refuse to start, let user decide
    if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
      log_error "develop working tree is dirty — cannot start daemon."
      log_error ""
      log_error "Modified files:"
      git diff --name-only 2>/dev/null | while read -r _f; do echo "  (unstaged) $_f"; done
      git diff --cached --name-only 2>/dev/null | while read -r _f; do echo "  (staged)   $_f"; done
      log_error ""
      log_error "请检查以上 dirty 内容并选择合适的处理方式:"
      log_error ""
      log_error "  如果内容已在其他工位存在 → 丢弃:"
      log_error "    git checkout -- <file>"
      log_error ""
      log_error "  如果是无用的临时文件 → 丢弃:"
