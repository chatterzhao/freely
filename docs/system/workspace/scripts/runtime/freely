global_restart_manifest_history_file() {
  local timestamp="$1" history_dir candidate suffix=0
  history_dir="$(global_restart_manifest_history_dir)"
  mkdir -p "$history_dir"
  candidate="$history_dir/${timestamp}.json"
  while [[ -e "$candidate" ]]; do
    suffix=$((suffix + 1))
    candidate="$history_dir/${timestamp}-${suffix}.json"
  done
  echo "$candidate"
}

