  fi
}

fleet_active_ownership_conflicts_summary() {
  local project="$1" repo_root continuity_file wt_path signature holder_state holder_branch holder_ref holder_signature holder_status summary=""
  repo_root="$(git -C "$project" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$repo_root" ]] || {
    printf 'none\n'
    return 0
  }
  continuity_file="$(latest_generated_manager_continuity_file_for_project "$repo_root")"
  while IFS= read -r wt_path; do
    [[ -n "$wt_path" && -d "$wt_path" ]] || continue
    [[ "$(role_hint_for_project "$wt_path")" == "worker" ]] || continue
    signature="$(project_current_blocking_intent_signature "$wt_path")"
    [[ -n "$signature" ]] || continue
    IFS='|' read -r holder_state holder_branch holder_ref holder_signature holder_status <<<"$(ownership_holder_snapshot_for_blocking_intent_signature "$repo_root" "$wt_path" "$continuity_file" "" "$signature")"
    [[ -n "$holder_state" && "$holder_state" != "none" ]] || continue
    summary="${summary}${summary:+; }$(branch_name_for_project "$wt_path")=${signature} blocked_by=${holder_branch:-unknown}@${holder_ref} state=${holder_state} status=${holder_status:-unknown}"
  done < <(all_repo_worktrees_for_project "$repo_root")
  printf '%s\n' "${summary:-none}"
}

manager_frozen_prompt_for_blocking_intent_signature() {
  local project="$1" continuity_file="$2" exclude_prompt="$3" signature="$4"
  local prompt_file prompt_signature
  [[ -n "$continuity_file" && -f "$continuity_file" && -n "$signature" ]] || return 0
  while IFS= read -r prompt_file; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
    [[ -n "$exclude_prompt" && "$prompt_file" == "$exclude_prompt" ]] && continue
    prompt_signature="$(worker_prompt_blocking_intent_signature "$project" "$prompt_file")"
    [[ -n "$prompt_signature" && "$prompt_signature" == "$signature" ]] || continue
    printf '%s\n' "$prompt_file"
    return 0
  done < <(latest_frozen_manager_worker_prompt_paths_from_continuity "$continuity_file")
}

manager_queued_prompt_for_blocking_intent_signature() {
  local project="$1" continuity_file="$2" exclude_prompt="$3" signature="$4"
  local prompt_file prompt_signature
  [[ -n "$continuity_file" && -f "$continuity_file" && -n "$signature" ]] || return 0
  while IFS= read -r prompt_file; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
    [[ -n "$exclude_prompt" && "$prompt_file" == "$exclude_prompt" ]] && return 0
    prompt_signature="$(worker_prompt_blocking_intent_signature "$project" "$prompt_file")"
    [[ -n "$prompt_signature" && "$prompt_signature" == "$signature" ]] || continue
    printf '%s\n' "$prompt_file"
    return 0
  done < <(latest_queued_manager_worker_prompt_paths_from_continuity "$continuity_file")
}

ownership_holder_snapshot_for_blocking_intent_signature() {
  local project="$1" exclude_project="$2" continuity_file="$3" exclude_prompt="$4" signature="$5"
  local holder_project holder_prompt holder_branch holder_status
  [[ -n "$signature" ]] || {
    printf 'none||||\n'
    return 0
  }

  holder_project="$(manager_other_worker_project_for_blocking_intent_signature "$project" "$exclude_project" "$signature")"
  if [[ -n "$holder_project" ]]; then
    holder_branch="$(branch_name_for_project "$holder_project")"
    if worker_project_is_actively_running "$holder_project"; then
      printf 'active-owner|%s|%s|%s|active\n' "${holder_branch:-unknown}" "$holder_project" "$signature"
    else
      holder_status="$(recorded_worker_ownership_status "$holder_project")"
      printf 'recorded-owner|%s|%s|%s|%s\n' "${holder_branch:-unknown}" "$holder_project" "$signature" "${holder_status:-soft_stale}"
    fi
    return 0
  fi

  holder_prompt="$(manager_frozen_prompt_for_blocking_intent_signature "$project" "$continuity_file" "$exclude_prompt" "$signature")"
  if [[ -n "$holder_prompt" ]]; then
    holder_branch="$(worker_prompt_target_branch "$holder_prompt")"
    printf 'frozen-owner|%s|%s|%s|frozen\n' "${holder_branch:-unknown}" "$holder_prompt" "$signature"
    return 0
  fi

  printf 'none||||\n'
}

manager_prompt_ownership_conflict_summary() {
  local project="$1" prompt_file="$2" continuity_file="$3" queue_kind="${4:-queued}"
  local signature blocked_branch holder_branch holder_ref holder_state holder_signature holder_status target_project holder_prompt
  [[ -n "$prompt_file" && -f "$prompt_file" ]] || return 0
  signature="$(worker_prompt_blocking_intent_signature "$project" "$prompt_file")"
  [[ -n "$signature" ]] || return 0
  blocked_branch="$(worker_prompt_target_branch "$prompt_file")"
  target_project="$(worker_prompt_resolved_worktree "$project" "$prompt_file")"
  IFS='|' read -r holder_state holder_branch holder_ref holder_signature holder_status <<<"$(ownership_holder_snapshot_for_blocking_intent_signature "$project" "$target_project" "$continuity_file" "$prompt_file" "$signature")"
  if [[ -n "$holder_state" && "$holder_state" != "none" ]]; then
    printf '%s:%s=%s blocked_by=%s@%s state=%s status=%s\n' \
      "$queue_kind" "${blocked_branch:-unknown}" "$signature" "${holder_branch:-unknown}" "$holder_ref" "$holder_state" "${holder_status:-unknown}"
    return 0
  fi
  holder_prompt="$(manager_queued_prompt_for_blocking_intent_signature "$project" "$continuity_file" "$prompt_file" "$signature")"
  if [[ -n "$holder_prompt" ]]; then
    holder_branch="$(worker_prompt_target_branch "$holder_prompt")"
    printf '%s:%s=%s blocked_by=%s@%s state=%s status=%s\n' \
      "$queue_kind" "${blocked_branch:-unknown}" "$signature" "${holder_branch:-unknown}" "$holder_prompt" "queued-owner" "queued"
  fi
}

manager_pending_ownership_conflicts_summary() {
  local project="$1" continuity_file="$2" queued_csv="$3"
  local prompt_file summary="" prompt_summary
  if [[ -n "$queued_csv" && "$queued_csv" != "none" ]]; then
    while IFS= read -r prompt_file; do
      [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
      prompt_summary="$(manager_prompt_ownership_conflict_summary "$project" "$prompt_file" "$continuity_file" "queued")"
      [[ -n "$prompt_summary" ]] || continue
      summary="${summary}${summary:+; }${prompt_summary}"
    done < <(printf '%s\n' "$queued_csv" | tr ',' '\n')
  fi
  if [[ -n "$continuity_file" && -f "$continuity_file" ]]; then
    while IFS= read -r prompt_file; do
      [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
      prompt_summary="$(manager_prompt_ownership_conflict_summary "$project" "$prompt_file" "$continuity_file" "frozen")"
      [[ -n "$prompt_summary" ]] || continue
      summary="${summary}${summary:+; }${prompt_summary}"
    done < <(latest_frozen_manager_worker_prompt_paths_from_continuity "$continuity_file")
  fi
  printf '%s\n' "${summary:-none}"
}

manager_max_parallel_workers() {
  printf 'unbounded\n'
}

all_repo_worktrees_for_project() {
  local project="$1"
  git -C "$project" worktree list --porcelain 2>/dev/null | awk '
    /^worktree / { print substr($0, 10) }
  '
}

worker_project_is_actively_running() {
  local project="$1"
  local supervisor_pid ai_pid
  [[ "$(role_hint_for_project "$project")" == "worker" ]] || return 1
  supervisor_pid="$(manager_supervisor_pid_for_project "$project")"
  ai_pid="$(runtime_ai_pid_hint_for_project "$project")"
  [[ -n "$supervisor_pid" || -n "$ai_pid" ]]
}

count_active_running_workers_for_manager_project() {
  local project="$1" wt_path count=0
  while IFS= read -r wt_path; do
    [[ -n "$wt_path" && -d "$wt_path" ]] || continue
    [[ "$(role_hint_for_project "$wt_path")" == "worker" ]] || continue
    if worker_project_is_actively_running "$wt_path"; then
      count=$((count + 1))
    fi
  done < <(all_repo_worktrees_for_project "$project")
  printf '%s\n' "$count"
}

worker_project_busy_with_delegated_continuation() {
  local project="$1" prompt_file
  worker_project_is_actively_running "$project" || return 1
  prompt_file="$(latest_prompt_file_for_project "$project")"
  [[ -n "$prompt_file" && -f "$prompt_file" ]] || return 1
  prompt_file_has_delegated_continuation "$prompt_file"
}

manager_worker_launch_available_slots() {
  local _project="$1"
  printf 'unbounded\n'
}

manager_worker_launch_intake_id_for_prompt() {
  local prompt_file="$1"
  local base
  base="$(basename "$prompt_file" .txt | tr -cs 'A-Za-z0-9' '-' | sed 's/^-//; s/-$//')"
  printf '%s-manager-worker-%s\n' "$(date '+%Y%m%d-%H%M%S')" "${base:-prompt}"
}

write_manager_worker_launch_intake() {
  local target_project="$1" prompt_file="$2"
  local intake_id created_at claimed_at message
  intake_id="$(manager_worker_launch_intake_id_for_prompt "$prompt_file")"
  created_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  claimed_at="$created_at"
  message="$(cat "$prompt_file")"
  write_intake_item \
    "$target_project" \
    "$intake_id" \
    "manager-runtime-launcher" \
    "delegation" \
    "delegated" \
    "continuation" \
    "pending://manager-worker-launch" \
    "$target_project" \
    "[]" \
    "$message" \
    "followup" \
    "manager-runtime-launcher" \
    "$claimed_at" \
    "handoff://continuation" \
    "" \
    "$created_at" >/dev/null
  printf '%s\n' "$intake_id"
}

ensure_runtime_workcell_initialized_for_launch() {
  local target_project="$1"
  local tool_adapter tool_adapter_policy
  local freely_bin
  [[ -d "$target_project" ]] || return 1
  if [[ -f "$(config_file "$target_project")" ]]; then
    return 0
  fi
  tool_adapter="${AI_TOOL_ADAPTER:-$(tool_default_adapter_for_runtime "${AI_TOOL:-codex}")}"
  tool_adapter_policy="${AI_TOOL_ADAPTER_POLICY:-${tool_adapter:-$(tool_default_adapter_policy_for_runtime "${AI_TOOL:-codex}")}}"
  freely_bin="$(freely_bin_for_project "$target_project")"
  bash "$freely_bin" init \
    --project "$target_project" \
    --intent "$target_project/docs/PROJECT_INTENT.md" \
    --constitution "$target_project/docs/CONSTITUTION.md" \
    --ai "${AI_TOOL:-codex}:${AI_MODEL:-}:${AI_MODE:-auto}" >/dev/null
  upsert_config_key "$target_project" "AI_TOOL_ADAPTER" "$tool_adapter"
  upsert_config_key "$target_project" "AI_TOOL_ADAPTER_POLICY" "$tool_adapter_policy"
}

launch_worker_from_manager_prompt_if_needed() {
  local manager_project="$1" prompt_file="$2"
  local target_project intake_id supervisor_pid ai_pid
  target_project="$(worker_prompt_resolved_worktree "$manager_project" "$prompt_file")"
  [[ -n "$target_project" && -d "$target_project" ]] || return 1
  ensure_runtime_workcell_initialized_for_launch "$target_project" || return 1
  intake_id="$(write_manager_worker_launch_intake "$target_project" "$prompt_file")"
  supervisor_pid="$(manager_supervisor_pid_for_project "$target_project")"
  ai_pid="$(runtime_ai_pid_hint_for_project "$target_project")"
  if [[ -n "$supervisor_pid" && -n "$ai_pid" ]]; then
    request_local_continuation_reentry "$target_project" "$intake_id"
    return 0
  fi
  write_workcell_state "$target_project" "running" "down" "down" "manager_worker_launch_linkage"
  start_workcell_supervisor_async "$target_project"
}

manager_runtime_launch_workers_from_latest_handoff() {
  local project="$1"
  local continuity_file continuity_generated prompt_generated_csv launched_csv queued_csv
  local launched_count prompt_file prompt_rank prompt_index target_project write_scope
  local parallel_safe active_running_workers available_new_slots max_parallel_workers
  local selected_write_scopes_csv selected_intent_signatures_csv frozen_intent_signatures_csv active_intent_signatures_csv recorded_intent_signatures_csv worker_is_active worker_is_busy prompt_queue_file prompt_signature queued_prompt_blockers
  continuity_file="$(latest_manager_continuity_file_for_project "$project")"
  [[ -n "$continuity_file" && -f "$continuity_file" ]] || {
    printf '0\n'
    return 0
  }
  continuity_generated="$continuity_file"
  prompt_generated_csv="$(latest_manager_worker_prompt_csv_from_continuity "$continuity_file")"

  launched_csv=""
  queued_csv=""
  if [[ -f "$(manager_worker_launch_state_file "$project")" ]]; then
    # shellcheck disable=SC1090
    source "$(manager_worker_launch_state_file "$project")"
    launched_csv="${LAST_MANAGER_WORKER_PROMPTS_CONSUMED:-${LAUNCHED_WORKER_PROMPTS:-}}"
    if [[ -n "${LAST_MANAGER_CONTINUITY_CONSUMED:-}" && "${LAST_MANAGER_CONTINUITY_CONSUMED:-}" != "$continuity_file" ]]; then
      launched_csv=""
    else
      launched_csv="$(manager_worker_launch_state_reconcile_same_continuity_prompts "$project" "$continuity_file")"
    fi
  fi

  max_parallel_workers="$(manager_max_parallel_workers)"
  active_running_workers="$(count_active_running_workers_for_manager_project "$project")"
  available_new_slots="$(manager_worker_launch_available_slots "$project")"
  launched_count=0
  queued_prompt_blockers="none"
  selected_write_scopes_csv=""
  active_intent_signatures_csv="$(manager_active_blocking_intent_signatures_csv "$project")"
  recorded_intent_signatures_csv="$(manager_recorded_blocking_intent_signatures_csv "$project")"
  frozen_intent_signatures_csv="$(manager_frozen_blocking_intent_signatures_csv "$project" "$continuity_file")"
  selected_intent_signatures_csv="$active_intent_signatures_csv"
  if [[ -n "$recorded_intent_signatures_csv" ]]; then
    IFS=',' read -r -a __freely_recorded_intents <<<"$recorded_intent_signatures_csv"
    local recorded_signature
    for recorded_signature in "${__freely_recorded_intents[@]}"; do
      [[ -n "$recorded_signature" ]] || continue
      selected_intent_signatures_csv="$(csv_append_unique_item "$selected_intent_signatures_csv" "$recorded_signature")"
    done
  fi
  if [[ -n "$frozen_intent_signatures_csv" ]]; then
    IFS=',' read -r -a __freely_frozen_intents <<<"$frozen_intent_signatures_csv"
    local frozen_signature
    for frozen_signature in "${__freely_frozen_intents[@]}"; do
      [[ -n "$frozen_signature" ]] || continue
      selected_intent_signatures_csv="$(csv_append_unique_item "$selected_intent_signatures_csv" "$frozen_signature")"
    done
  fi
  prompt_queue_file="$(mktemp "${TMPDIR:-/tmp}/freely-manager-launch-queue.XXXXXX")"
  prompt_index=0
  while IFS= read -r prompt_file; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
    prompt_rank="$(worker_prompt_dispatch_priority "$prompt_file")"
    printf '%s\t%06d\t%s\n' "$prompt_rank" "$prompt_index" "$prompt_file" >>"$prompt_queue_file"
    prompt_index=$((prompt_index + 1))
  done < <(latest_manager_worker_prompt_paths_from_continuity "$continuity_file")

  while IFS=$'\t' read -r _prompt_rank _prompt_index prompt_file; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || continue
    target_project="$(worker_prompt_resolved_worktree "$project" "$prompt_file")"
    [[ -n "$target_project" && -d "$target_project" ]] || continue
    if csv_contains_exact_item "$launched_csv" "$prompt_file"; then
      if worker_project_is_actively_running "$target_project"; then
        continue
      fi
      launched_csv="$(csv_remove_exact_item "$launched_csv" "$prompt_file")"
    fi
    write_scope="$(worker_prompt_write_scope "$project" "$prompt_file")"
    parallel_safe="$(worker_prompt_parallel_safe "$prompt_file")"
    worker_is_active="0"
    worker_is_busy="0"
    if worker_project_is_actively_running "$target_project"; then
      worker_is_active="1"
      if worker_project_busy_with_delegated_continuation "$target_project"; then
        worker_is_busy="1"
      fi
    fi

    if [[ "$worker_is_busy" == "1" ]]; then
      queued_csv="$(csv_append_unique_item "$queued_csv" "$prompt_file")"
      continue
    fi
    if [[ "$parallel_safe" != "true" && $launched_count -gt 0 ]]; then
      queued_csv="$(csv_append_unique_item "$queued_csv" "$prompt_file")"
      continue
    fi
    if csv_conflicts_with_item "$selected_write_scopes_csv" "$write_scope"; then
      queued_csv="$(csv_append_unique_item "$queued_csv" "$prompt_file")"
      continue
    fi
    prompt_signature="$(worker_prompt_blocking_intent_signature "$project" "$prompt_file")"
    if [[ -n "$prompt_signature" ]] && manager_other_worker_holds_blocking_intent_signature "$project" "$target_project" "$prompt_signature"; then
      queued_csv="$(csv_append_unique_item "$queued_csv" "$prompt_file")"
      continue
    fi
    if [[ -n "$prompt_signature" ]] && csv_conflicts_with_item "$selected_intent_signatures_csv" "$prompt_signature"; then
      queued_csv="$(csv_append_unique_item "$queued_csv" "$prompt_file")"
      continue
    fi
    if launch_worker_from_manager_prompt_if_needed "$project" "$prompt_file"; then
      launched_csv="$(csv_append_unique_item "$launched_csv" "$prompt_file")"
      selected_write_scopes_csv="$(csv_append_unique_item "$selected_write_scopes_csv" "$write_scope")"
      if [[ -n "$prompt_signature" ]]; then
        selected_intent_signatures_csv="$(csv_append_unique_item "$selected_intent_signatures_csv" "$prompt_signature")"
      fi
      launched_count=$((launched_count + 1))
      if [[ "$worker_is_active" != "1" ]]; then
        active_running_workers=$((active_running_workers + 1))
      fi
    else
      queued_csv="$(csv_append_unique_item "$queued_csv" "$prompt_file")"
    fi
  done < <(sort -t $'\t' -k1,1n -k2,2n "$prompt_queue_file")
  rm -f "$prompt_queue_file"

  queued_prompt_blockers="$(manager_pending_ownership_conflicts_summary "$project" "$continuity_file" "$queued_csv")"
  write_manager_worker_launch_state "$project" "$continuity_generated" "$prompt_generated_csv" "$continuity_file" "$launched_csv" "$queued_csv" "$max_parallel_workers" "$active_running_workers" "$available_new_slots" "$queued_prompt_blockers"
  printf '%s\n' "$launched_count"
}

manager_ai_stalled_with_pending_intake() {
  local project="$1" threshold_secs="${2:-90}"
  local ai_pid cycle_log intake_signal log_mtime signal_mtime now
  ai_pid="$(manager_ai_pid_for_project "$project")"
  [[ -n "$ai_pid" ]] || return 1
  cycle_log="$(latest_cycle_log_for_project "$project")"
  [[ -n "$cycle_log" && -f "$cycle_log" ]] || return 1
  intake_signal="$(intake_pending_signal_file "$project")"
  [[ -f "$intake_signal" ]] || return 1
  log_mtime="$(file_mtime_epoch "$cycle_log" 2>/dev/null || true)"
  signal_mtime="$(file_mtime_epoch "$intake_signal" 2>/dev/null || true)"
  [[ -n "$log_mtime" && -n "$signal_mtime" ]] || return 1
  (( signal_mtime > log_mtime )) || return 1
  now="$(date +%s)"
  (( now - log_mtime >= threshold_secs )) || return 1
}

latest_active_intake_meta_mtime_for_project() {
  local project="$1"
  local intake_root meta_file status mtime latest_mtime=""
  intake_root="$(intake_dir_for_project "$project")"
  [[ -d "$intake_root" ]] || return 1
  while IFS= read -r meta_file; do
    [[ -f "$meta_file" ]] || continue
    status="$(meta_env_value "$meta_file" "STATUS")"
    case "$status" in
      absorbed|dropped) continue ;;
    esac
    mtime="$(file_mtime_epoch "$meta_file" 2>/dev/null || true)"
    [[ -n "$mtime" ]] || continue
    if [[ -z "$latest_mtime" ]] || (( mtime > latest_mtime )); then
      latest_mtime="$mtime"
    fi
  done < <(find "$intake_root" -mindepth 2 -maxdepth 2 -type f -name meta.env | sort)
  [[ -n "$latest_mtime" ]] || return 1
  printf '%s\n' "$latest_mtime"
}

prompt_file_has_delegated_continuation() {
  local prompt_file="$1"
  [[ -f "$prompt_file" ]] || return 1
  grep -q '^Delegated continuation handoff:' "$prompt_file" 2>/dev/null
}

manager_ai_prompt_superseded_by_new_intake() {
  local project="$1" threshold_secs="${2:-20}"
  local ai_pid prompt_file prompt_mtime latest_intake_mtime now
  ai_pid="$(manager_ai_pid_for_project "$project")"
  [[ -n "$ai_pid" ]] || return 1
  prompt_file="$(latest_prompt_file_for_project "$project")"
  [[ -n "$prompt_file" && -f "$prompt_file" ]] || return 1
  prompt_file_has_delegated_continuation "$prompt_file" || return 1
  prompt_mtime="$(file_mtime_epoch "$prompt_file" 2>/dev/null || true)"
  latest_intake_mtime="$(latest_active_intake_meta_mtime_for_project "$project" 2>/dev/null || true)"
  [[ -n "$prompt_mtime" && -n "$latest_intake_mtime" ]] || return 1
  (( latest_intake_mtime > prompt_mtime )) || return 1
  now="$(date +%s)"
  (( now - latest_intake_mtime >= threshold_secs )) || return 1
}

manager_ai_stalled_after_delegated_continuation_prompt() {
  local project="$1" threshold_secs="${2:-90}"
  local ai_pid cycle_log prompt_file continuity_file
  local log_mtime prompt_mtime continuity_mtime now

  ai_pid="$(manager_ai_pid_for_project "$project")"
  [[ -n "$ai_pid" ]] || return 1
  cycle_log="$(latest_cycle_log_for_project "$project")"
  [[ -n "$cycle_log" && -f "$cycle_log" ]] || return 1
  prompt_file="$(latest_prompt_file_for_project "$project")"
  [[ -n "$prompt_file" && -f "$prompt_file" ]] || return 1
  prompt_file_has_delegated_continuation "$prompt_file" || return 1

  log_mtime="$(file_mtime_epoch "$cycle_log" 2>/dev/null || true)"
  prompt_mtime="$(file_mtime_epoch "$prompt_file" 2>/dev/null || true)"
  [[ -n "$log_mtime" && -n "$prompt_mtime" ]] || return 1

  now="$(date +%s)"
  (( now - log_mtime >= threshold_secs )) || return 1
  (( now - prompt_mtime >= threshold_secs )) || return 1

  if manager_delegated_supervision_quiet_period_waiting_on_active_worker "$project" "$prompt_mtime"; then
    return 1
  fi

  continuity_file="$(latest_generated_manager_continuity_file_for_project "$project")"
  if [[ -n "$continuity_file" && -f "$continuity_file" ]]; then
    continuity_mtime="$(file_mtime_epoch "$continuity_file" 2>/dev/null || true)"
    if [[ -n "$continuity_mtime" ]] && (( continuity_mtime >= prompt_mtime )); then
      if manager_continuity_waiting_on_active_busy_worker "$project" "$continuity_file"; then
        return 1
      fi
      if manager_continuity_has_unconsumed_launchable_worker_prompt "$project" "$continuity_file"; then
        return 0
      fi
      return 1
    fi
  fi
  return 0
}

manager_delegated_supervision_quiet_period_waiting_on_active_worker() {
  local project="$1" prompt_mtime="$2"
  local continuity_file continuity_mtime state_file consumed_csv prompt_file target_project saw_busy="0"
  local active_running_workers

  continuity_file="$(latest_generated_manager_continuity_file_for_project "$project")"
  if [[ -n "$continuity_file" && -f "$continuity_file" ]]; then
    continuity_mtime="$(file_mtime_epoch "$continuity_file" 2>/dev/null || true)"
    if [[ -n "$continuity_mtime" ]] && (( continuity_mtime >= prompt_mtime )); then
      if manager_continuity_has_unconsumed_launchable_worker_prompt "$project" "$continuity_file"; then
        return 1
      fi
      if manager_continuity_has_stale_runtime_worktree_refs "$project" "$continuity_file"; then
        return 1
      fi
      if manager_continuity_waiting_on_active_busy_worker "$project" "$continuity_file"; then
        return 0
      fi
      return 1
    fi
  fi

  state_file="$(manager_worker_launch_state_file "$project")"
  [[ -f "$state_file" ]] || return 1
  # shellcheck disable=SC1090
  source "$state_file"
  active_running_workers="$(count_active_running_workers_for_manager_project "$project")"
  [[ "$active_running_workers" =~ ^[0-9]+$ ]] || return 1
  (( active_running_workers > 0 )) || return 1
  [[ -z "${QUEUED_WORKER_PROMPTS:-}" ]] || return 1

  consumed_csv="${LAST_MANAGER_WORKER_PROMPTS_CONSUMED:-${LAUNCHED_WORKER_PROMPTS:-}}"
  [[ -n "$consumed_csv" ]] || return 1

  IFS=',' read -r -a __quiet_period_consumed_prompts <<<"$consumed_csv"
  for prompt_file in "${__quiet_period_consumed_prompts[@]}"; do
    [[ -n "$prompt_file" && -f "$prompt_file" ]] || return 1
    target_project="$(worker_prompt_resolved_worktree "$project" "$prompt_file")"
    [[ -n "$target_project" && -d "$target_project" ]] || return 1
    worker_project_is_actively_running "$target_project" || return 1
    worker_project_busy_with_delegated_continuation "$target_project" || return 1
    saw_busy="1"
  done

  [[ "$saw_busy" == "1" ]]
}

resolve_manager_delegated_continuations_as_absorbed() {
  local project="$1" intake_ids_csv="$2" continuity_file="$3"
  local intake_id resolution_file
  [[ -n "$project" && -n "$intake_ids_csv" && -n "$continuity_file" ]] || return 0
  resolution_file="$(mktemp /tmp/freely-manager-delegated-absorption.XXXXXX)"
  cat >"$resolution_file" <<EOF
restart_point: \`continuation\`
ownership: \`manager\`
handoff_summary: 本轮 delegated continuation 已被主管吸收到新 continuity 中。
EOF
  IFS=',' read -r -a __manager_delegated_ids <<<"$intake_ids_csv"
  for intake_id in "${__manager_delegated_ids[@]}"; do
    [[ -n "$intake_id" ]] || continue
    cmd_intake_resolve \
      --project "$project" \
      --intake-id "$intake_id" \
      --resolved-by interruption-manager-agent \
      --reaction followup \
      --classification continuation \
      --resolution-file "$resolution_file" \
      --absorption-target "continuity://manager-supervision" \
      --status absorbed \
      --linked-artifact "$continuity_file" >/dev/null
  done
  rm -f "$resolution_file"
}

manager_ai_runtime_recovery_reason() {
