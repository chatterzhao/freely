develop_push_defer_reason_is_valid() {
  local reason="${1:-}"
  case "$reason" in
    post_merge_acceptance|cleanup_followthrough|remote_delivery_hold) return 0 ;;
    *) return 1 ;;
  esac
}

develop_push_attempt_reason_is_valid() {
  local reason="${1:-}"
  case "$reason" in
    push_rejected_by_gate|remote_rejected|transport_failure|auth_failure|unknown_failure) return 0 ;;
    *) return 1 ;;
  esac
}

develop_push_followthrough_push_urgency_for_state() {
  local state="${1:-}"
  case "$state" in
    push_pending|push_blocked) printf 'immediate\n' ;;
    push_deferred) printf 'deferred\n' ;;
    *) printf 'none\n' ;;
  esac
}

develop_push_followthrough_normalize_note() {
  local note="${1:-}"
  note="$(printf '%s\n' "$note" | tr '\n' ' ' | tr '\r' ' ' | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//')"
  note="${note//\"/\'}"
  printf '%.240s\n' "$note"
}

develop_push_attempt_reason_from_output() {
  local output="${1:-}"
  if printf '%s\n' "$output" | grep -Eqi 'governance-merge-gate|pretests-gate|pre-push|hook declined|pushes to .* are not allowed'; then
    printf 'push_rejected_by_gate\n'
  elif printf '%s\n' "$output" | grep -Eqi 'Authentication failed|Permission denied|\b403\b|\b401\b|denied'; then
    printf 'auth_failure\n'
  elif printf '%s\n' "$output" | grep -Eqi 'remote rejected|protected branch hook declined|non-fast-forward|failed to push some refs'; then
    printf 'remote_rejected\n'
  elif printf '%s\n' "$output" | grep -Eqi 'Could not resolve host|Connection timed out|Failed to connect|Network is unreachable|Connection reset|TLS|SSL|proxy'; then
    printf 'transport_failure\n'
  else
    printf 'unknown_failure\n'
  fi
}

develop_push_followthrough_upstream_for_project() {
  local project="$1"
  git -C "$project" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true
}

develop_push_followthrough_refresh_upstream_tracking_ref_after_success() {
  local project="$1" pushed_head="${2:-}" upstream_ref
  upstream_ref="$(git -C "$project" rev-parse --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  [[ "$upstream_ref" == refs/remotes/* ]] || return 0
  [[ -n "$pushed_head" ]] || pushed_head="$(git -C "$project" rev-parse HEAD 2>/dev/null || true)"
  [[ -n "$pushed_head" ]] || return 1
  git -C "$project" update-ref "$upstream_ref" "$pushed_head" >/dev/null 2>&1 || return 1
}

develop_push_followthrough_authoritative_develop_project() {
  local project="$1" repo_root entries wt_path wt_branch
  repo_root="$(git_root_for_path "$project")"
  [[ -n "$repo_root" ]] || return 0

  if [[ "$(branch_name_for_project "$repo_root")" == "develop" ]]; then
    printf '%s\n' "$repo_root"
    return 0
  fi

  entries="$(project_worktree_list_porcelain_cached "$project")"
  while IFS='|' read -r wt_path wt_branch; do
    [[ "$wt_branch" == "develop" ]] || continue
    printf '%s\n' "$wt_path"
    return 0
  done < <(printf '%s\n' "$entries" | awk '
    /^worktree / { wt=substr($0, 10); br="" }
    /^branch / { br=$2; sub(/^refs\/heads\//, "", br); print wt "|" br }
  ')
}

develop_push_followthrough_snapshot_for_develop_project() {
  local project="$1"
  local upstream counts ahead behind state summary defer_reason defer_note defer_updated_at state_file attempt_state_file head blocked_reason blocked_note blocked_updated_at blocked_head
  state="not_applicable"
  summary="branch_not_develop"
  upstream="none"
  ahead="0"
  behind="0"
  defer_reason="none"
  defer_note="none"
  defer_updated_at="unavailable"
  blocked_reason="none"
  blocked_note="none"
  blocked_updated_at="unavailable"
  blocked_head="none"
  state_file="$(develop_push_followthrough_state_file "$project")"
  attempt_state_file="$(develop_push_attempt_state_file "$project")"

  if [[ -f "$state_file" ]]; then
    # shellcheck disable=SC1090
    source "$state_file"
    defer_reason="${DEVELOP_PUSH_DEFER_REASON:-none}"
    defer_note="${DEVELOP_PUSH_DEFER_NOTE:-none}"
    defer_updated_at="${DEVELOP_PUSH_DEFER_UPDATED_AT:-unavailable}"
    if [[ -n "$defer_reason" ]] && ! develop_push_defer_reason_is_valid "$defer_reason"; then
      defer_reason="invalid:${defer_reason}"
    fi
    [[ -n "$defer_note" ]] || defer_note="none"
  fi
  if [[ -f "$attempt_state_file" ]]; then
    # shellcheck disable=SC1090
    source "$attempt_state_file"
    blocked_reason="${DEVELOP_PUSH_ATTEMPT_REASON:-none}"
    blocked_note="${DEVELOP_PUSH_ATTEMPT_NOTE:-none}"
    blocked_updated_at="${DEVELOP_PUSH_ATTEMPT_UPDATED_AT:-unavailable}"
    blocked_head="${DEVELOP_PUSH_ATTEMPT_HEAD:-none}"
    if [[ -n "$blocked_reason" ]] && ! develop_push_attempt_reason_is_valid "$blocked_reason"; then
      blocked_reason="invalid:${blocked_reason}"
    fi
    [[ -n "$blocked_note" ]] || blocked_note="none"
    [[ -n "$blocked_head" ]] || blocked_head="none"
  fi

  upstream="$(develop_push_followthrough_upstream_for_project "$project")"
  if [[ -z "$upstream" ]]; then
    state="not_applicable"
    summary="no_upstream"
    upstream="none"
  else
    counts="$(git -C "$project" rev-list --left-right --count "HEAD...$upstream" 2>/dev/null || true)"
    if [[ -n "$counts" ]]; then
      ahead="$(printf '%s\n' "$counts" | awk '{print $1}')"
      behind="$(printf '%s\n' "$counts" | awk '{print $2}')"
    fi
    head="$(git -C "$project" rev-parse HEAD 2>/dev/null || true)"
    [[ "$ahead" =~ ^[0-9]+$ ]] || ahead="0"
    [[ "$behind" =~ ^[0-9]+$ ]] || behind="0"
    if (( ahead > 0 )); then
      if develop_push_defer_reason_is_valid "${DEVELOP_PUSH_DEFER_REASON:-}"; then
        state="push_deferred"
        summary="ahead=${ahead} behind=${behind} upstream=${upstream} defer=${DEVELOP_PUSH_DEFER_REASON}"
      elif [[ "${DEVELOP_PUSH_ATTEMPT_STATUS:-}" == "blocked" && -n "$head" && "$blocked_head" == "$head" ]]; then
        state="push_blocked"
        summary="ahead=${ahead} behind=${behind} upstream=${upstream} blocked=${blocked_reason}"
      else
        state="push_pending"
        summary="ahead=${ahead} behind=${behind} upstream=${upstream} defer=none"
      fi
    else
      state="clean"
      summary="ahead=0 behind=${behind} upstream=${upstream}"
    fi
  fi

  printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' "$state" "$summary" "$upstream" "$ahead" "$behind" "$defer_reason" "$defer_updated_at" "$blocked_reason" "$blocked_updated_at" "$blocked_head" "$blocked_note"
}

