}

fleet_worktree_paths_for_project() {
  local project="$1"
  git -C "$project" worktree list --porcelain 2>/dev/null | awk '/^worktree / {print substr($0, 10)}'
}

global_restart_project_paths() {
  local project="$1"
  {
    fleet_worktree_paths_for_project "$project"
    registered_projects
  } | awk 'NF > 0 && !seen[$0]++ { print $0 }'
}

normalize_runtime_worktree_path() {
  local target_path="$1"
  [[ -n "$target_path" ]] || return 0
  if [[ -d "$target_path" ]]; then
    (
      cd "$target_path" 2>/dev/null && pwd -P
    ) || printf '%s\n' "$target_path"
  else
    printf '%s\n' "$target_path"
  fi
}

fleet_worktree_branch_rows_for_project() {
  local project="$1"
  git -C "$project" worktree list --porcelain 2>/dev/null | awk '
    BEGIN { wt=""; br="(detached)" }
    /^worktree / { wt=substr($0, 10); br="(detached)" }
    /^branch / { br=$2; sub(/^refs\/heads\//, "", br) }
    /^$/ {
      if (wt != "") {
        print wt "|" br
        wt=""
        br="(detached)"
      }
    }
    END {
      if (wt != "") {
        print wt "|" br
      }
    }
  '
}

manager_continuity_worktree_paths_from_runtime_sections() {
  local continuity_file="$1"
  [[ -f "$continuity_file" ]] || return 0
  awk '
    function extract_backtick_path(line, value, start_idx, remainder, end_idx) {
      start_idx=index(line, "`")
      if (start_idx == 0) {
        return
      }
      remainder=substr(line, start_idx + 1)
      end_idx=index(remainder, "`")
      if (end_idx == 0) {
        return
      }
      value=substr(remainder, 1, end_idx - 1)
      if (value ~ /^\/.*$/) {
        print value
      }
    }
    /^## / {
      section=tolower(substr($0, 4))
      gsub(/[`[:space:]]+$/, "", section)
      gsub(/[[:space:]]+\/[[:space:]]+/, "|", section)
      next
    }
    /^# / {
      section=""
      next
    }
    section == "fleet inventory" && $0 ~ /^[[:space:]]*-[[:space:]]*path:[[:space:]]*`\/.*`[[:space:]]*$/ {
      extract_backtick_path($0)
      next
    }
    (section == "queue" || section == "frozen queue" || section == "cleanup queue" || section == "queue|frozen|cleanup") && $0 ~ /^[[:space:]]*-[[:space:]]*target_worktree:[[:space:]]*`\/.*`[[:space:]]*$/ {
      extract_backtick_path($0)
      next
    }
  ' "$continuity_file" | sort -u
}

project_has_worktree_path() {
  local project="$1" target_path="$2" worktree_path normalized_target normalized_worktree
  [[ -n "$target_path" ]] || return 1
  normalized_target="$(normalize_runtime_worktree_path "$target_path")"
  while IFS= read -r worktree_path; do
    [[ -n "$worktree_path" ]] || continue
    normalized_worktree="$(normalize_runtime_worktree_path "$worktree_path")"
    if [[ "$normalized_worktree" == "$normalized_target" ]]; then
      return 0
    fi
  done < <(fleet_worktree_paths_for_project "$project")
  return 1
}

manager_continuity_has_stale_runtime_worktree_refs() {
  local project="$1" continuity_file="$2" target_path
  [[ -n "$project" && -f "$continuity_file" ]] || return 1
  while IFS= read -r target_path; do
    [[ -n "$target_path" ]] || continue
    project_has_worktree_path "$project" "$target_path" || return 0
  done < <(manager_continuity_worktree_paths_from_runtime_sections "$continuity_file")
  return 1
}

manager_continuity_missing_runtime_worktree_refs() {
  local project="$1" continuity_file="$2" target_path
  [[ -n "$project" && -f "$continuity_file" ]] || return 0
  while IFS= read -r target_path; do
    [[ -n "$target_path" ]] || continue
    project_has_worktree_path "$project" "$target_path" && continue
    printf '%s\n' "$target_path"
  done < <(manager_continuity_worktree_paths_from_runtime_sections "$continuity_file")
}

manager_prompt_fleet_truth_markdown_for_project() {
  local project="$1"
  local latest_generated_continuity latest_launchable_continuity generated_stale missing_refs wt_path wt_branch wt_state
  latest_generated_continuity="$(latest_generated_manager_continuity_file_for_project "$project")"
  latest_launchable_continuity="$(latest_manager_continuity_file_for_project "$project")"
  generated_stale="false"
  missing_refs=""

  if [[ -n "$latest_generated_continuity" && -f "$latest_generated_continuity" ]]; then
    if manager_continuity_has_stale_runtime_worktree_refs "$project" "$latest_generated_continuity"; then
      generated_stale="true"
      missing_refs="$(manager_continuity_missing_runtime_worktree_refs "$project" "$latest_generated_continuity")"
    fi
  fi

  cat <<EOF
项目级工位真相：
- authoritative_source: \`git worktree list --porcelain\`
- latest_generated_manager_continuity: \`${latest_generated_continuity:-none}\`
- latest_launchable_manager_continuity: \`${latest_launchable_continuity:-none}\`
- latest_generated_manager_continuity_stale: \`${generated_stale}\`

## Current Worktree Inventory
EOF

  while IFS='|' read -r wt_path wt_branch; do
    [[ -n "$wt_path" ]] || continue
    if [[ -n "$(git -C "$wt_path" status --porcelain 2>/dev/null)" ]]; then
      wt_state="DIRTY"
    else
      wt_state="CLEAN"
    fi
    cat <<EOF
- path: \`$wt_path\`
  - branch: \`${wt_branch:-unknown}\`
  - clean_state: \`${wt_state}\`
EOF
  done < <(fleet_worktree_branch_rows_for_project "$project")

  if [[ -n "$missing_refs" ]]; then
    cat <<EOF

## Stale Runtime Refs
EOF
    while IFS= read -r wt_path; do
      [[ -n "$wt_path" ]] || continue
      printf -- '- missing_worktree: `%s`\n' "$wt_path"
    done <<<"$missing_refs"
  fi

  cat <<'EOF'

Manager continuity truth guard:
- Treat `Current Worktree Inventory` as the authoritative active fleet for this round.
- If any continuity references a path absent from that inventory, treat it as stale history, not as current queue/fleet truth.
- Before writing a new manager continuity, rebuild fleet inventory / queue / cleanup sections from the current worktree inventory rather than copying stale historical paths.
EOF
}

manager_worker_prompt_paths_from_continuity_by_mode() {
  local continuity_file="$1" mode="${2:-launchable}"
  [[ -f "$continuity_file" ]] || return 0
  awk -v mode="$mode" '
    function emit_prompt_paths(line,    remaining) {
      remaining=line
      while (match(remaining, /\/[^` ]+\/\.freely\/run\/worker-prompts\/[^` ]+\.txt/)) {
        print substr(remaining, RSTART, RLENGTH)
        remaining=substr(remaining, RSTART + RLENGTH)
      }
    }
    /^## / {
      section=tolower(substr($0, 4))
      gsub(/[`[:space:]]+$/, "", section)
      capture_runtime_worker_prompt=0
      capture_worker_prompt_path_list=0
      worker_prompts_subsection=""
      next
    }
    /^# / {
      section=""
      capture_runtime_worker_prompt=0
      capture_worker_prompt_path_list=0
      worker_prompts_subsection=""
      next
    }
    {
      if (section == "worker prompts") {
        if ($0 ~ /^[[:space:]]*-[[:space:]]*launched:[[:space:]]*$/) {
          worker_prompts_subsection="launched"
          next
        }
        if ($0 ~ /^[[:space:]]*-[[:space:]]*queue:[[:space:]]*$/) {
          worker_prompts_subsection="queue"
          next
        }
        if ($0 ~ /^[[:space:]]*-[[:space:]]*frozen_queue:[[:space:]]*$/) {
          worker_prompts_subsection="frozen"
          next
        }
        if ($0 ~ /^[[:space:]]*-[[:space:]]*`?\/[^` ]+\/\.freely\/run\/worker-prompts\/[^` ]+\.txt`?[[:space:]]*$/) {
          if (worker_prompts_subsection == "frozen") {
            if (mode != "launchable") {
              emit_prompt_paths($0)
            }
          } else if (worker_prompts_subsection == "launched" || worker_prompts_subsection == "queue") {
            if (mode != "frozen") {
              emit_prompt_paths($0)
            }
          }
          next
        }
      }
      if (section == "queue") {
        if (($0 ~ /prompt_path:/ || $0 ~ /worker_prompt_path:/) && mode != "frozen") {
          emit_prompt_paths($0)
          next
        }
        if ($0 ~ /^[[:space:]]*-[[:space:]]*`?\/[^` ]+\/\.freely\/run\/worker-prompts\/[^` ]+\.txt`?[[:space:]]*$/ && mode != "frozen") {
          emit_prompt_paths($0)
        }
        next
      }
      if (section == "frozen queue") {
        if (($0 ~ /prompt_path:/ || $0 ~ /worker_prompt_path:/) && mode != "launchable") {
          emit_prompt_paths($0)
          next
        }
        if ($0 ~ /^[[:space:]]*-[[:space:]]*`?\/[^` ]+\/\.freely\/run\/worker-prompts\/[^` ]+\.txt`?[[:space:]]*$/ && mode != "launchable") {
          emit_prompt_paths($0)
        }
        next
      }
      if ($0 ~ /- worker_prompt: / || $0 ~ /- active_worker_prompt: / || $0 ~ /- queued_worker_prompt: / || $0 ~ /- refreshed_queued_worker_prompt: /) {
        if (mode != "frozen") {
          emit_prompt_paths($0)
        }
        next
      }
      if ($0 ~ /- delegated worker prompt:/) {
        capture_worker_prompt_path_list=(mode != "frozen")
        next
      }
      if ($0 ~ /- runtime worker prompt:/) {
        capture_runtime_worker_prompt=1
        next
      }
      if ($0 ~ /- worker_prompt_paths_created_this_round:/ || $0 ~ /- worker_prompt_paths_referenced_this_round:/ || $0 ~ /- worker_prompt_paths_referenced:/) {
        capture_worker_prompt_path_list=(mode != "frozen")
        next
      }
      if ($0 ~ /- worker_prompt_paths_superseded:/) {
        capture_worker_prompt_path_list=0
        next
      }
      if (capture_runtime_worker_prompt == 1) {
        if ($0 ~ /^[[:space:]]*-[[:space:]]*`?\/[^` ]+\/\.freely\/run\/worker-prompts\/[^` ]+\.txt`?[[:space:]]*$/) {
          if (mode != "frozen") {
            emit_prompt_paths($0)
          }
          capture_runtime_worker_prompt=0
          next
        }
        if ($0 !~ /^[[:space:]]*$/ && $0 !~ /^[[:space:]]*-[[:space:]]/) {
          capture_runtime_worker_prompt=0
        }
      }
      if (capture_worker_prompt_path_list == 1) {
        if ($0 ~ /^[[:space:]]*-[[:space:]]*`?\/[^` ]+\/\.freely\/run\/worker-prompts\/[^` ]+\.txt`?[[:space:]]*$/) {
          emit_prompt_paths($0)
          next
        }
        if ($0 ~ /^[[:space:]]*-[[:space:]]*`none`[[:space:]]*$/ || $0 ~ /^[[:space:]]*`none`[[:space:]]*$/) {
          capture_worker_prompt_path_list=0
          next
        }
        if ($0 !~ /^[[:space:]]*$/ && $0 !~ /^[[:space:]]*-[[:space:]]/) {
          capture_worker_prompt_path_list=0
        }
      }
    }
  ' "$continuity_file" | sort -u
}

