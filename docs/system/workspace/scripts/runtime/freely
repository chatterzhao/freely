manager_scan_stale_worker_pids() {
  local project="$1" _a2a_task_py _db_path raw_key scanned_count=0 marked_count=0
  _a2a_task_py="$SELF_ROOT/docs/system/workspace/scripts/runtime/a2a_task.py"
  _db_path="$project/.freely/freely.db"
  [[ -f "$_a2a_task_py" && -f "$_db_path" ]] || return 0
  raw_key="$(echo "$(git -C "$project" rev-parse --abbrev-ref HEAD 2>/dev/null)" | grep -oE '[0-9]{8}T[0-9]{4,6}Z' | head -1)"
  [[ -n "$raw_key" ]] || return 0

  local result
  result="$(python3 -c "
import json, os, subprocess, sys
raw_key = '''$raw_key'''
r = subprocess.run([sys.executable, '$_a2a_task_py', 'get-launched-pids', '--raw-key', raw_key],
                   capture_output=True, text=True, timeout=10)
data = json.loads(r.stdout) if r.returncode == 0 else {}
rows = data.get('rows', [])
marked = []
scanned = len(rows)
for row in rows:
  pid_str = row.get('worker_pid', '')
  if not pid_str or not pid_str.strip().isdigit():
    continue
  pid = int(pid_str.strip())
  try:
    os.kill(pid, 0)
  except OSError:
    marked.append(row.get('task_id', ''))
if marked:
  for tid in marked:
    subprocess.run([sys.executable, '$_a2a_task_py', 'update',
                    '--task-id', tid, '--status', 'blocked', '--exit-kind', 'stale_pid',
                    '--reason', 'Worker PID kill -0 failed, marking stale_pid'],
                   capture_output=True, timeout=10)
print(f'{scanned},{len(marked)}')
" 2>/dev/null || echo "0,0")"

  scanned_count="${result%,*}"
  marked_count="${result#*,}"
  [[ "$scanned_count" =~ ^[0-9]+$ ]] || scanned_count=0
  [[ "$marked_count" =~ ^[0-9]+$ ]] || marked_count=0

  if (( marked_count > 0 )); then
    log_warn "manager stale-pid scan: marked $marked_count stale worker(s) out of $scanned_count scanned"
    append_lifecycle_trace "$project" "L225" "manager_stale_pid_scan" \
      "scanned=$scanned_count" \
      "marked_stale=$marked_count" \
      "trigger=kill_zero_failed" \
      "next=re_evaluate_keepalive"
  fi
  return 0
}

