restart_storm_window_file() {
  local project="$1"
  echo "$(run_dir_for_project "$project")/restart-storm-window.tsv"
}

update_restart_storm_window() {
  local project="$1" now_epoch="$2" active_process_count="$3"
  local window_file tmp_file window_secs
  window_file="$(restart_storm_window_file "$project")"
  mkdir -p "$(dirname "$window_file")"
  tmp_file="$(mktemp "$(dirname "$window_file")/restart-storm-window.XXXXXX")"
  window_secs="${RESTART_STORM_WINDOW_SECS:-30}"
  {
    if [[ -f "$window_file" ]]; then
      awk -F '\t' -v now="$now_epoch" -v window="$window_secs" '
        NF >= 2 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ {
          if ((now - $1) <= window) {
            print $1 "\t" $2
          }
        }
      ' "$window_file"
    fi
    printf '%s\t%s\n' "$now_epoch" "${active_process_count:-0}"
  } >"$tmp_file"
  mv "$tmp_file" "$window_file"
}

restart_storm_window_stats() {
  local project="$1"
  local window_file count peak
  window_file="$(restart_storm_window_file "$project")"
  if [[ ! -f "$window_file" ]]; then
    printf '0|0\n'
    return 0
  fi
  read -r count peak < <(
    awk -F '\t' '
      NF >= 2 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ {
        count += 1
        if ($2 > peak) {
          peak = $2
        }
      }
      END {
        if (count == 0) {
          peak = 0
        }
        printf "%d %d\n", count, peak
      }
    ' "$window_file"
  )
  printf '%s|%s\n' "${count:-0}" "${peak:-0}"
}

restart_storm_signal_reason_for_window() {
  local restart_count="$1" process_peak="$2"
  if (( ${restart_count:-0} >= ${RESTART_STORM_COUNT:-4} )); then
    printf 'restart_storm_count_threshold\n'
    return 0
  fi
  if (( ${process_peak:-0} >= ${PROCESS_CHURN_PEAK:-3} )); then
    printf 'process_churn_peak_threshold\n'
    return 0
  fi
  return 1
}

