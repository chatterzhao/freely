# ── Validate base_tool extracted from slot against tool-registry ──
_validate_base_tool_from_slot() {
  local _v_slot="${1:-}" _v_caller="${2:-unknown}"
  [[ -n "$_v_slot" ]] || return 0

  # Check slot naming convention: {base_tool}-apikey|account-{name}
  if ! echo "$_v_slot" | grep -qE '^[a-z]+-(apikey|account)-'; then
    log_error "Slot naming convention violation: $_v_slot (caller=$_v_caller)"
    log_error ""
    log_error "Expected format: {base_tool}-apikey|account-{name}"
    log_error "  Examples: claude-apikey-ds-pro-auto, opencode-apikey-ds-flash-auto, cline-account-ds-flash-free-auto"
    log_error ""
    log_error "Fix:"
    log_error "  1. Check agent-table.toml slot field spelling"
    log_error "  2. The ~/.ai-auth/ directory name must follow this convention"
    exit 1
  fi

  local _v_bt="${_v_slot%%-*}"
  if ! _tool_is_registered "$_v_bt" 2>/dev/null; then
    local _v_supported
    _v_supported="$(_tool_registry_tools 2>/dev/null | tr '\n' ', ' | sed 's/, $//')"
    log_error "Unsupported base_tool: $_v_bt (from slot $_v_slot, caller=$_v_caller)"
    log_error ""
    log_error "Supported base_tools: $_v_supported"
    log_error ""
    log_error "Possible causes:"
    log_error "  1. agent-table.toml has a typo in the slot field"
    log_error "  2. The ~/.ai-auth/ directory name does not start with a supported base_tool"
    log_error "  3. This base_tool is genuinely not supported by freely"
    log_error ""
    log_error "  Check: bin/agent-table-query --get-slot <agent_id>"
    log_error "  Check: ls ~/.ai-auth/"
    exit 1
  fi
}

_tool_is_registered() {
  local tool="$1"
  _tool_registry_get "$tool" "acp.binary" >/dev/null 2>&1
}

# ── Dead tool tracking (SQLite via freely-db-cli) ─────────────────────

_tool_failure_add() {
  local tool="$1" slot="$2" reason="$3"
  python3 "$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli" \
    --project "$PROJECT_ROOT" tool.failure-add --tool "$tool" --slot "$slot" --reason "$reason" 2>>"$PROJECT_ROOT/.freely/run/db-daemon.log" || true
}

_tool_failure_count() {
  local tool="$1" slot="$2" window="${3:-3600}"
  python3 "$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli" \
    --project "$PROJECT_ROOT" tool.failure-count --tool "$tool" --slot "$slot" --window_secs "$window" 2>>"$PROJECT_ROOT/.freely/run/db-daemon.log" || echo "0"
}

_tool_failure_clear() {
  local tool="$1" slot="$2"
  python3 "$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli" \
    --project "$PROJECT_ROOT" tool.failure-clear --tool "$tool" --slot "$slot" 2>>"$PROJECT_ROOT/.freely/run/db-daemon.log" || true
}

_tool_is_dead() {
  local tool="$1" slot="$2"
  local count; count="$(_tool_failure_count "$tool" "${slot:-}" 3600)"
  [[ "$count" -ge 3 ]]
}

_tool_test_resurrect() {
  local tool="$1"
  local test_cmd; test_cmd="$(_tool_registry_get "$tool" "test_command" 2>/dev/null || true)"
  [[ -n "$test_cmd" ]] || return 1
  # Run test command with 30s timeout.  Cross-platform:
  # - Linux: timeout(1) from coreutils
  # - macOS: perl alarm (timeout not available by default)
  # - Windows Git Bash: timeout(1) usually available
  local _timeout_ok=0
  if timeout 30 bash -c "$test_cmd" >/dev/null 2>&1; then
    _timeout_ok=1
  elif perl -e 'alarm 30; exec @ARGV' -- bash -c "$test_cmd" >/dev/null 2>&1; then
    _timeout_ok=1
  fi
  if [[ "$_timeout_ok" == "1" ]]; then
    _tool_failure_clear "$tool" ""
    return 0
  fi
  return 1
}

# ai_cli_tool_with_auth_assemble: unified slot command builder.
#
# "slot" 是 Freely 内部叫法，指 ~/.ai-auth/ 下的鉴权目录名。
# 目录命名约定：{tool-name}-{apikey|account}-{custom}
#   例：claude-apikey-ds-pro-auto  →  tool=claude, auth=apikey, 自定义=ds-pro-auto
#       opencode-apikey-ds-flash-auto → tool=opencode
#       codex-account-user@example-com-1 → tool=codex, auth=account
#
# Usage: ai_cli_tool_with_auth_assemble <type> <slot_folder_name>
#   type: test → emit CLI command string (say-hi test)
#         work → emit bridge env vars + inline env + permission (ACP bridge launch)
#
# Tool extracted from slot folder name internally (first segment before -apikey- or -account-).
# Registry fields (discovery, config_file, bridge_config_env) control path injection format.
# No alias dependency — slot folder name maps directly to ~/.ai-auth/{slot_folder_name}/.
ai_cli_tool_with_auth_assemble() {
  local _type="$1" _slot_folder="$2"
  [[ -n "$_type" && -n "$_slot_folder" ]] || return 1

  # ── 1. Extract tool from slot folder name ────────────────
  local _tool="${_slot_folder%%-*}"
  _tool="$(_resolve_tool_family "$_tool")"

  # ── 2. Read registry ────────────────────────────────────
  local _discovery _alias_key _cfg_file _is_dir _bridge_env _test_base
  _discovery="$(_tool_registry_get "$_tool" "slot.discovery" 2>/dev/null || true)"
  _alias_key="$(_tool_registry_get "$_tool" "slot.alias_key" 2>/dev/null || true)"
  _cfg_file="$(_tool_registry_get "$_tool" "slot.config_file" 2>/dev/null || true)"
  _is_dir="$(_tool_registry_get "$_tool" "slot.is_dir" 2>/dev/null || echo "false")"
  _bridge_env="$(_tool_registry_get "$_tool" "slot.bridge_config_env" 2>/dev/null || true)"
  _test_base="$(_tool_registry_get "$_tool" "test_command" 2>/dev/null || true)"

  # ── 3. Resolve slot config path ─────────────────────────
  local _slot_dir="$HOME/.ai-auth/$_slot_folder"
  [[ -d "$_slot_dir" ]] || return 1

  local _slot_path="" _slot_type=""
  if [[ "$_is_dir" == "true" ]]; then
    _slot_path="$_slot_dir"; _slot_type="dir"
  elif [[ -n "$_cfg_file" && -f "$_slot_dir/$_cfg_file" ]]; then
    _slot_path="$_slot_dir/$_cfg_file"; _slot_type="file"
  else
    _slot_path="$_slot_dir"; _slot_type="file"
  fi
  [[ -e "$_slot_path" ]] || return 1

  # ── 4. Dispatch by type ─────────────────────────────────
  case "$_type" in
    test)
      [[ -n "$_test_base" ]] || return 1
      case "$_discovery" in
        alias_cli_arg)
          echo "${_test_base} ${_alias_key} ${_slot_path}" ;;
        alias_env_var)
          if [[ -n "$_bridge_env" ]]; then
            echo "${_bridge_env}=${_slot_path} ${_test_base}"
          else
            echo "$_test_base"
          fi
          ;;
        *) echo "$_test_base" ;;
      esac
      ;;
    work)
      # Emit bridge_config_env — dual mode by value prefix
      if [[ -n "$_bridge_env" ]]; then
        if [[ "$_bridge_env" == --* ]]; then
          echo "ACP_CLI:${_bridge_env}=$_slot_path"
        else
          echo "${_bridge_env}=$_slot_path"
        fi
      fi
      # Emit inline env vars + permission mode from config file
      local _full_path=""
      if [[ "$_slot_type" == "dir" && -n "$_cfg_file" ]]; then
        _full_path="$_slot_path/$_cfg_file"
      elif [[ "$_slot_type" == "file" ]]; then
        _full_path="$_slot_path"
      fi
      if [[ -n "$_full_path" && -f "$_full_path" ]]; then
        local _perm_field _perm_fallback
        _perm_field="$(_tool_registry_get "$_tool" "permission.config_field" 2>/dev/null || true)"
        _perm_fallback="$(_tool_registry_get "$_tool" "permission.fallback_field" 2>/dev/null || true)"
        python3 -c "
import json
with open('$_full_path') as f:
    d = json.load(f)
for k, v in d.get('env', {}).items():
    print(f'{k}={v}')
pm = ''
pf = '$_perm_field'
fb = '$_perm_fallback'
if pf:
    if pf in d:
        pm = d[pf]
    elif fb:
        parts = fb.split('.')
        cur = d
        for p in parts:
            if isinstance(cur, dict) and p in cur:
                cur = cur[p]
            else:
                cur = None
                break
        if cur is not None:
            pm = str(cur)
if pm:
    print(f'CLAUDE_CODE_PERMISSION_MODE={pm}')
" 2>/dev/null || true
      fi
      ;;
    *) return 1 ;;
  esac
}

