ai_process_snapshot_markdown() {
  local project="$1"
  local ai_pid session_state tool_session_id tool_resume_target tool_jsonl_path prompt_file ai_ps_line
  ai_pid="$(runtime_ai_pid_hint_for_project "$project")"
  load_session_state_or_defaults "$project"
  tool_session_id="${LAST_TOOL_SESSION_ID:-unavailable}"
  tool_resume_target="${LAST_TOOL_RESUME_TARGET:-unavailable}"
  tool_jsonl_path="${LAST_TOOL_JSONL_PATH:-unavailable}"
  prompt_file="$(latest_prompt_file_for_project "$project")"
  [[ -n "$prompt_file" ]] || prompt_file="unavailable"
  if [[ -n "$ai_pid" ]]; then
    if process_inspection_available; then
      ai_ps_line="$(ps -p "$ai_pid" -o pid=,etime=,state=,command= 2>/dev/null | sed 's/^ *//')"
    else
      ai_ps_line="unavailable://process-inspection-blocked"
    fi
    cat <<EOF
- direct_answer: 当前后台 AI 进程正在运行。
- ai_process:
  - pid: \`$ai_pid\`
  - snapshot: \`${ai_ps_line:-unavailable}\`
- last_tool_session_id: \`$tool_session_id\`
- last_tool_resume_target: \`$tool_resume_target\`
- last_tool_jsonl_path: \`$tool_jsonl_path\`
- latest_prompt_file: \`$prompt_file\`
EOF
  else
    cat <<EOF
- direct_answer: 当前没有运行中的后台 AI 进程。
- ai_process:
  - pid: \`none\`
  - snapshot: \`none\`
- last_tool_session_id: \`$tool_session_id\`
- last_tool_resume_target: \`$tool_resume_target\`
- last_tool_jsonl_path: \`$tool_jsonl_path\`
- latest_prompt_file: \`$prompt_file\`
EOF
  fi
}

validate_restart_point_or_fail() {
  local restart_point="$1"
  [[ -z "$restart_point" ]] && return 0
  case "$restart_point" in
    pre_brainstorm|candidate|milestone|ibm|dev|review|verification|continuation|runtime|cleanup) ;;
    *)
      log_error "unsupported restart point: $restart_point"
      exit 1
      ;;
  esac
}

validate_signal_ownership_or_fail() {
  local ownership="$1"
  [[ -z "$ownership" ]] && return 0
  case "$ownership" in
    manager|worker|runtime) ;;
    *)
      log_error "unsupported ownership: $ownership"
      exit 1
      ;;
  esac
}

normalize_interruption_manager_contract() {
  local classification="${1:-}" restart_point="${2:-}" ownership="${3:-}"
  local normalized_classification="$classification"
  local normalized_restart_point="$restart_point"
  local normalized_ownership="$ownership"

  # `runtime` is reserved for signals that directly manipulate runtime state.
  # Worker continuation work must stay on the continuation lane so the runtime
  # re-enters work instead of parking itself.
  if [[ "$normalized_restart_point" == "runtime" && "$normalized_classification" == "continuation" ]]; then
    normalized_restart_point="continuation"
  fi
  if [[ "$normalized_restart_point" == "runtime" && "$normalized_ownership" != "runtime" ]]; then
    normalized_restart_point="continuation"
  fi

  printf '%s|%s|%s\n' "$normalized_classification" "$normalized_restart_point" "$normalized_ownership"
}

