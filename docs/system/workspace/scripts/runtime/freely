merged_feature_worktree_entries_for_project() {
  local project="$1"
  local merged_branches wt_path branch line
  merged_branches="$(git -C "$project" branch --format='%(refname:short)' --merged develop 2>/dev/null | grep '^feature/' || true)"
  [[ -n "$merged_branches" ]] || return 0
  wt_path=""
  branch=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      "worktree "*)
        wt_path="${line#worktree }"
        ;;
      "branch refs/heads/"*)
        branch="${line#branch refs/heads/}"
        ;;
      "")
        if [[ -n "$wt_path" && -n "$branch" ]] && printf '%s\n' "$merged_branches" | grep -Fxq "$branch"; then
          printf '%s\t%s\n' "$wt_path" "$branch"
        fi
        wt_path=""
        branch=""
        ;;
    esac
  done < <(git -C "$project" worktree list --porcelain 2>/dev/null)
  if [[ -n "$wt_path" && -n "$branch" ]] && printf '%s\n' "$merged_branches" | grep -Fxq "$branch"; then
    printf '%s\t%s\n' "$wt_path" "$branch"
  fi
}

write_cleanup_followthrough_resolution_file() {
  local intake_id="$1" out_file="$2" cleaned="$3" retained="$4" blocked_reason="$5"
  cat >"$out_file" <<EOF
# Interruption Resolution
- intake_id: \`$intake_id\`
- intent_summary: 已检查 merged worktree 的 cleanup 收口状态。
- worker_action: \`cleanup-followthrough\`
- blocked_reason: ${blocked_reason:-none}
- cleaned_items:
$(if [[ -n "$cleaned" ]]; then printf '%s\n' "$cleaned" | sed 's/^/  - /'; else printf '  - none\n'; fi)
- retained_items:
$(if [[ -n "$retained" ]]; then printf '%s\n' "$retained" | sed 's/^/  - /'; else printf '  - none\n'; fi)
EOF
}

run_cleanup_followthrough() {
  local project="$1" intake_id="$2" classification="$3" reaction="$4" why_text="$5" handoff_text="$6"
  local resolution_file blocked_reason cleaned retained wt_path branch dirty supervisor ai
  blocked_reason=""
  cleaned=""
  retained=""

  while IFS=$'\t' read -r wt_path branch; do
    [[ -n "$wt_path" && -n "$branch" ]] || continue
    if [[ "$wt_path" == "$project" ]]; then
      continue
    fi
    dirty="$(git -C "$wt_path" status --porcelain 2>/dev/null || true)"
    if [[ -n "$dirty" ]]; then
      retained="${retained}${retained:+$'\n'}${branch} @ ${wt_path} (dirty)"
      continue
    fi
    supervisor=""
    ai=""
    if [[ -f "$wt_path/.freely/run/supervisor.pid" ]]; then
      supervisor="$(cat "$wt_path/.freely/run/supervisor.pid" 2>/dev/null || true)"
    fi
    if [[ -f "$wt_path/.freely/run/ai.pid" ]]; then
      ai="$(cat "$wt_path/.freely/run/ai.pid" 2>/dev/null || true)"
    fi
    if ([[ -n "$supervisor" ]] && kill -0 "$supervisor" 2>/dev/null) || ([[ -n "$ai" ]] && kill -0 "$ai" 2>/dev/null); then
      retained="${retained}${retained:+$'\n'}${branch} @ ${wt_path} (runtime-active)"
      continue
    fi
    if git -C "$project" worktree remove "$wt_path" >/dev/null 2>&1 && git -C "$project" branch -d "$branch" >/dev/null 2>&1; then
      cleaned="${cleaned}${cleaned:+$'\n'}${branch} @ ${wt_path}"
    else
      retained="${retained}${retained:+$'\n'}${branch} @ ${wt_path} (remove-failed)"
    fi
  done < <(merged_feature_worktree_entries_for_project "$project")

  resolution_file="$(mktemp /tmp/freely-interruption-cleanup-followthrough.XXXXXX)"
  write_cleanup_followthrough_resolution_file "$intake_id" "$resolution_file" "$cleaned" "$retained" "$blocked_reason"
  cmd_intake_resolve \
    --project "$project" \
    --intake-id "$intake_id" \
    --resolved-by interruption-cleanup-worker \
    --reaction "${reaction:-followup}" \
    --classification "${classification:-control}" \
    --resolution-file "$resolution_file" \
    --absorption-target cleanup://merged-worktree-followthrough \
    --linked-artifact cleanup://merged-worktree-followthrough >/dev/null
  rm -f "$resolution_file"
}

apply_interruption_manager_decision() {
  local project="$1" intake_id="$2" decision="$3" reaction="$4" classification="$5" why_text="$6" restart_point="$7" ownership="$8" handoff_text="$9" answer_text="${10}"
  local resolution_file
  validate_restart_point_or_fail "$restart_point"
  validate_signal_ownership_or_fail "$ownership"
  case "$decision" in
    answer)
      cmd_intake_claim --project "$project" --intake-id "$intake_id" --claimed-by interruption-manager-agent --reaction "${reaction:-followup}" --classification "${classification:-control}" --linked-artifact pending://interruption-manager-answer >/dev/null
      resolution_file="$(mktemp /tmp/freely-interruption-answer.XXXXXX)"
      write_manager_answer_resolution_file "$intake_id" "$resolution_file" "$answer_text" "$why_text" "$restart_point"
      cmd_intake_resolve \
        --project "$project" \
        --intake-id "$intake_id" \
        --resolved-by interruption-manager-agent \
        --reaction "${reaction:-followup}" \
        --classification "${classification:-control}" \
        --resolution-file "$resolution_file" \
        --absorption-target answer://manager-clarification \
        --linked-artifact answer://manager-clarification >/dev/null
      rm -f "$resolution_file"
      ;;
    delegate)
      cmd_intake_claim \
        --project "$project" \
        --intake-id "$intake_id" \
        --claimed-by interruption-manager-agent \
        --reaction "${reaction:-followup}" \
        --classification "${classification:-discovery}" \
        --linked-artifact pending://interruption-manager-delegation >/dev/null
      if [[ "$restart_point" == "cleanup" && "$ownership" == "worker" ]]; then
        run_cleanup_followthrough "$project" "$intake_id" "${classification:-control}" "${reaction:-followup}" "$why_text" "$handoff_text"
        return 0
      fi
      resolution_file="$(mktemp /tmp/freely-interruption-delegate.XXXXXX)"
      write_delegate_handoff_resolution_file "$intake_id" "$resolution_file" "$why_text" "${classification:-discovery}" "$restart_point" "$ownership" "$handoff_text"
      cmd_intake_resolve \
        --project "$project" \
        --intake-id "$intake_id" \
        --resolved-by interruption-manager-agent \
        --reaction "${reaction:-followup}" \
        --classification "${classification:-discovery}" \
        --resolution-file "$resolution_file" \
        --absorption-target "handoff://${restart_point:-pre_brainstorm}" \
        --status delegated \
        --linked-artifact pending://interruption-manager-delegation >/dev/null
      rm -f "$resolution_file"
      ;;
    *)
      return 1
      ;;
  esac
}

handle_interruption_intake_once() {
  local project="$1" intake_id="$2"
  local meta_file message_file status claimed_by handler_bin handler_output decision reaction classification why_text restart_point ownership handoff_text answer_text
  meta_file="$(intake_item_meta_file "$project" "$intake_id")"
  message_file="$(intake_item_message_file "$project" "$intake_id")"
  [[ -f "$meta_file" && -f "$message_file" ]] || return 1
  status="$(meta_env_value "$meta_file" "STATUS")"
  claimed_by="$(meta_env_value "$meta_file" "CLAIMED_BY")"
  [[ "$status" == "new" && -z "$claimed_by" ]] || return 1

  cmd_intake_claim \
    --project "$project" \
    --intake-id "$intake_id" \
    --claimed-by interruption-manager-agent \
    --reaction followup \
    --linked-artifact pending://interruption-manager-triage >/dev/null

  handler_bin="$(interruption_handler_bin_for_project "$project")"
  if [[ ! -x "$handler_bin" ]]; then
    log_warn "interruption handler missing or not executable; returning intake to new: $intake_id"
    reset_intake_claim_for_retry "$project" "$intake_id"
    return 0
  fi
  if ! handler_output="$("$handler_bin" --project "$project" --intake-id "$intake_id" 2>/dev/null)"; then
    log_warn "interruption handler exited non-zero; returning intake to new: $intake_id"
    reset_intake_claim_for_retry "$project" "$intake_id"
    return 0
  fi
  decision="$(printf '%s\n' "$handler_output" | awk -F= '/^DECISION=/{print substr($0,10); exit}')"
  reaction="$(printf '%s\n' "$handler_output" | awk -F= '/^REACTION=/{print substr($0,10); exit}')"
  classification="$(printf '%s\n' "$handler_output" | awk -F= '/^CLASSIFICATION=/{print substr($0,16); exit}')"
  restart_point="$(printf '%s\n' "$handler_output" | awk -F= '/^RESTART_POINT=/{print substr($0,15); exit}')"
  ownership="$(printf '%s\n' "$handler_output" | awk -F= '/^OWNERSHIP=/{print substr($0,11); exit}')"
  why_text="$(printf '%s\n' "$handler_output" | awk -F= '/^WHY=/{print substr($0,5); exit}')"
  handoff_text="$(printf '%s\n' "$handler_output" | awk -F= '/^HANDOFF=/{print substr($0,9); exit}')"
  answer_text="$(printf '%s\n' "$handler_output" | awk -F= '/^ANSWER=/{print substr($0,8); exit}')"
  if [[ -z "$decision" ]]; then
    log_warn "interruption handler returned no decision; returning intake to new: $intake_id"
    reset_intake_claim_for_retry "$project" "$intake_id"
    return 0
  fi
  apply_interruption_manager_decision "$project" "$intake_id" "$decision" "$reaction" "$classification" "$why_text" "$restart_point" "$ownership" "$handoff_text" "$answer_text"
}

ensure_interruption_dispatch_once() {
  local project="$1"
  local run_dir pid_file existing_pid item_dir intake_id handled_any
  run_dir="$(run_dir_for_project "$project")"
  mkdir -p "$run_dir"
  recover_stale_interruption_triage_claims "$project"
  handled_any="0"
  while IFS= read -r item_dir; do
    intake_id="$(basename "$item_dir")"
    if handle_interruption_intake_once "$project" "$intake_id"; then
      handled_any="1"
    fi
  done < <(find "$(intake_dir_for_project "$project")" -mindepth 1 -maxdepth 1 -type d | sort)
  if [[ "$handled_any" == "1" ]]; then
    log_info "interruption dispatcher handled intake(s)"
  fi
}

cmd_ensure_interruption_dispatch_watch() {
  local project="$1" interval="$2" pid_file existing_pid
  pid_file="$(interruption_dispatcher_pid_file "$project")"
  mkdir -p "$(dirname "$pid_file")"

  if [[ -f "$pid_file" ]]; then
    existing_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if valid_interruption_dispatcher_pid_for_project "$project" "$existing_pid"; then
      log_info "interruption dispatcher already running (pid=$existing_pid)"
      return 0
    fi
  fi

  echo "$$" >"$pid_file"
  trap "rm -f '$pid_file'" EXIT

  while true; do
    if [[ -f "$(stop_marker_file "$project")" ]]; then
      exit 0
    fi
    if [[ -f "$(intake_pending_signal_file "$project")" ]]; then
      ensure_interruption_dispatch_once "$project"
    fi
    sleep "$interval"
  done
}

cmd_ensure_manager_watch() {
  local project="$1" interval="$2" pid_file run_dir existing_pid
  run_dir="$(run_dir_for_project "$project")"
  pid_file="$(ensure_manager_watchdog_pid_file "$project")"
  mkdir -p "$run_dir"

  if [[ -f "$pid_file" ]]; then
    existing_pid="$(cat "$pid_file" 2>/dev/null || true)"
    if valid_ensure_manager_watchdog_pid_for_project "$project" "$existing_pid"; then
      log_info "ensure-manager watchdog already running (pid=$existing_pid)"
      return 0
    fi
  fi

  echo "$$" >"$pid_file"
  trap "rm -f '$pid_file'" EXIT

  while true; do
    if [[ -f "$(stop_marker_file "$project")" ]]; then
      exit 0
    fi
    ensure_manager_once "$project"
    sleep "$interval"
  done
}

