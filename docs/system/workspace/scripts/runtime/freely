materialize_blocked_supervision_truth_if_needed() {
  local project="$1" prompt_file="$2" exit_reason="$3" cycle_log="$4"
  local blocked_reason pending_ids prompt_epoch continuity_file continuity_epoch now session_refs
  local intake_id meta_file reaction classification claimed_by claimed_at resolution_dir resolution_artifact resolution_content
  [[ -f "$prompt_file" ]] || return 0
  blocked_reason="$(blocked_supervision_reason_from_exit_context "$exit_reason" "$cycle_log" || true)"
  [[ -n "$blocked_reason" ]] || return 0
  prompt_epoch="$(file_mtime_epoch "$prompt_file" 2>/dev/null || true)"
  [[ "$prompt_epoch" =~ ^[0-9]+$ ]] || return 0
  continuity_file="$(find_latest_manager_continuity_file_for_project "$project")"
  if [[ -n "$continuity_file" && -f "$continuity_file" ]]; then
    continuity_epoch="$(file_mtime_epoch "$continuity_file" 2>/dev/null || true)"
    if [[ "$continuity_epoch" =~ ^[0-9]+$ ]] && (( continuity_epoch > prompt_epoch )); then
      return 0
    fi
  fi
  pending_ids="$(prompt_visible_unclaimed_intake_ids_for_prompt "$project" "$prompt_file")"
  [[ -n "$pending_ids" ]] || return 0
  now="$(current_timestamp_utc_for_machine)"
  session_refs="$(current_workcell_session_refs)"
  IFS=',' read -r -a __blocked_pending_ids <<<"$pending_ids"
  for intake_id in "${__blocked_pending_ids[@]}"; do
    [[ -n "$intake_id" ]] || continue
    meta_file="$(intake_item_meta_file "$project" "$intake_id")"
    [[ -f "$meta_file" ]] || continue
    reaction="$(meta_env_value "$meta_file" "REACTION")"
    classification="$(meta_env_value "$meta_file" "CLASSIFICATION")"
    claimed_by="$(meta_env_value "$meta_file" "CLAIMED_BY")"
    claimed_at="$(meta_env_value "$meta_file" "CLAIMED_AT")"
    resolution_content="$(cat <<EOF
# Resolution
- blocked_supervision_state: active
- blocked_reason: ${blocked_reason}
- prompt_file: \`${prompt_file}\`
- cycle_log: \`${cycle_log}\`
- latest_manager_continuity: \`${continuity_file:-none}\`
- next_restart_point: \`continuation\`
- next_ownership: \`manager\`
- handoff_summary: 本轮 prompt 已生成，但 runtime 在 claim 或 continuity 写回前阻塞；该 intake 已保留给下一轮 manager continuation。
EOF
)"
    resolution_dir="$(
      write_interruption_resolution_artifact \
        "$project" "$intake_id" "${claimed_by:-interruption-manager-agent}" "${reaction:-followup}" "${classification:-continuation}" "handoff://continuation" "$prompt_file" "" "delegated" "$resolution_content"
    )"
    resolution_artifact="$resolution_dir/resolution.md"
    rewrite_existing_intake_item \
      "$project" "$intake_id" "delegated" "${classification:-continuation}" "$prompt_file" "" "${reaction:-followup}" "${claimed_by:-interruption-manager-agent}" "${claimed_at:-$now}" "handoff://continuation" "$resolution_artifact" "$session_refs"
    request_local_continuation_reentry "$project" "$intake_id"
    append_runtime_event "$project" "blocked_supervision_materialized" \
      "intake_id=$intake_id" \
      "blocked_reason=$blocked_reason" \
      "prompt_file=$prompt_file" \
      "resolution_artifact=$resolution_artifact"
  done
}

blocked_supervision_snapshot_for_project() {
  local project="$1"
  local resolution_root meta_file resolution_artifact status absorption_target delegated_worktree intake_id
  local project_real delegated_real blocked_reason prompt_file
  resolution_root="$(interruption_resolution_dir_for_project "$project")"
  [[ -d "$resolution_root" ]] || return 0
  project_real="$(cd "$project" && pwd -P)"
  while IFS= read -r resolution_artifact; do
    [[ -f "$resolution_artifact" ]] || continue
    meta_file="$(dirname "$resolution_artifact")/meta.env"
    [[ -f "$meta_file" ]] || continue
    load_meta_env_snapshot "$meta_file"
    status="$LOADED_META_STATUS"
    absorption_target="$LOADED_META_ABSORPTION_TARGET"
    delegated_worktree="$LOADED_META_DELEGATED_WORKTREE"
    [[ "$status" == "delegated" ]] || continue
    [[ "$absorption_target" == "handoff://continuation" ]] || continue
    delegated_real=""
    if [[ -n "$delegated_worktree" ]]; then
      delegated_real="$(cd "$delegated_worktree" 2>/dev/null && pwd -P || true)"
    fi
    if [[ -n "$delegated_real" && "$delegated_real" != "$project_real" ]]; then
      continue
    fi
    IFS='|' read -r blocked_reason prompt_file <<<"$(blocked_supervision_resolution_fields "$resolution_artifact")"
    intake_id="$LOADED_META_INTAKE_ID"
    [[ -n "$intake_id" ]] || intake_id="$(basename "$(dirname "$resolution_artifact")")"
    printf 'active|%s|intake_id=%s prompt=%s|%s\n' "${blocked_reason:-unknown}" "${intake_id:-unknown}" "${prompt_file:-none}" "$resolution_artifact"
    return 0
  done < <(blocked_supervision_candidate_resolution_artifacts "$resolution_root")
  printf 'none|none|none|none\n'
}

