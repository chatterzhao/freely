format_timestamp_local_for_display() {
  local value="${1:-}" epoch=""
  [[ -n "$value" ]] || return 1
  case "$value" in
    unknown|unavailable|none) printf '%s\n' "$value"; return 0 ;;
  esac
  if [[ "$value" =~ ^[0-9]+$ ]]; then
    format_epoch_local "$value"
    return 0
  fi
  epoch="$(codex_timestamp_to_epoch "$value" 2>/dev/null || true)"
  if [[ -n "$epoch" ]]; then
    format_epoch_local "$epoch"
    return 0
  fi
  printf '%s\n' "$value"
}

