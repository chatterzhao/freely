}

# _update_agent_table_slot: update {role}_slot in agent-table.toml.
# Usage: _update_agent_table_slot <agent_id> <new_slot>
#   e.g. _update_agent_table_slot manager_01 claude-apikey-ds-flash-auto
_update_agent_table_slot() {
  local _agent_id="$1" _new_slot="$2"
  local _at="${PROJECT_ROOT}/.freely/agent-table.toml"
  [[ -f "$_at" ]] || return 1
  python3 -c "
import sys
agent_id, new_slot = sys.argv[1], sys.argv[2]
with open('$_at', 'r') as f:
    lines = f.readlines()
# Find agent by matching _id = \"agent_id\" pattern (e.g. worker_id = \"worker_01\")
in_target = False
for i, line in enumerate(lines):
    s = line.strip()
    if s.startswith('[[agents]]'):
        in_target = False
    if f'_id = \"{agent_id}\"' in s:
        in_target = True
        continue
    if in_target and '_slot =' in s:
        old = lines[i].split('=', 1)[0]
        lines[i] = f'{old}= \"{new_slot}\"\n'
        break
with open('$_at', 'w') as f:
    f.writelines(lines)
print(f'updated {agent_id} slot → {new_slot}', file=sys.stderr)
" "$_agent_id" "$_new_slot"
}

