#!/usr/bin/env bash
set -euo pipefail

SELF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"

usage() {
  cat <<'EOF'
Usage:
  interruption-manager-handler --project <abs_path> --intake-id <id>
EOF
}

abs_path_or_fail() {
  local p="$1"
  [[ "$p" == /* ]] || {
    echo "[ERROR] path must be absolute: $p" >&2
    exit 1
  }
  printf '%s\n' "$p"
}

project=""
intake_id=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
    --intake-id) intake_id="${2:-}"; shift 2 ;;
    *) usage; exit 1 ;;
  esac
done

[[ -n "$project" && -n "$intake_id" ]] || {
  usage
  exit 1
}

meta_file="$project/.freely/intake/$intake_id/meta.env"
message_file="$project/.freely/intake/$intake_id/message.txt"
[[ -f "$meta_file" && -f "$message_file" ]] || exit 1
message="$(cat "$message_file")"

config_file="$project/.freely/config.env"
[[ -f "$config_file" ]] || exit 1
# shellcheck disable=SC1090
source "$config_file"

model="${AI_MODEL:-gpt-5.4}"
reasoning_effort="${AI_REASONING_EFFORT:-medium}"
prompt_file="$(mktemp /tmp/freely-interruption-manager-prompt.XXXXXX)"
trap 'rm -f "$prompt_file"' EXIT

cat >"$prompt_file" <<EOF
你现在承担 Freely 的 interruption manager agent。

目标：
- 第一时间注意到任意人类插话。
- 你只根据自己的职责做最小判断：
  - 是主管先做简短澄清/回答
  - 还是委派到后续专门处理链
- 不能靠关键词穷举，也不要发明很多问题类型。
- 可以参考少量示例，但示例不是硬编码规则：
  - 纯主管监督面事实查询，通常可由主管先澄清
  - 涉及分析、执行、清理、分支/worktree收口、文档补齐、实现/测试/review 的，通常应委派

若选择委派，必须同时判断：
- restart point 从哪里重新开始：
  - pre_brainstorm / candidate / milestone / ibm / dev / review / verification / continuation / runtime / cleanup
- ownership 属于 manager / worker / runtime 哪一侧
- 给出一行 handoff 摘要

只输出以下 KEY=VALUE 行，不要输出任何额外文本：
DECISION=answer 或 delegate
REACTION=followup
CLASSIFICATION=control 或 discovery 或 continuation 或 noise
RESTART_POINT=<pre_brainstorm|candidate|milestone|ibm|dev|review|verification|continuation|runtime|cleanup>
OWNERSHIP=<manager|worker|runtime>
WHY=<单行中文原因，最多 40 字>
HANDOFF=<单行中文交接摘要，最多 60 字；若是 answer 可留空>
ANSWER=<单行中文回答摘要，最多 60 字；若是 delegate 可留空>

插话：
$message
EOF

codex exec --skip-git-repo-check -C "$project" -m "$model" -c "model_reasoning_effort=\"$reasoning_effort\"" --dangerously-bypass-approvals-and-sandbox - <"$prompt_file" \
  | awk '/^(DECISION|REACTION|CLASSIFICATION|RESTART_POINT|OWNERSHIP|WHY|HANDOFF|ANSWER)=/' \
  | head -n 8
