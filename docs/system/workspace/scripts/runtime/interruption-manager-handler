#!/usr/bin/env bash
set -euo pipefail

SELF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
# shellcheck disable=SC1091
source "$SELF_ROOT/docs/system/workspace/scripts/runtime/tool-launchers.sh"

usage() {
  cat <<'EOF'
Usage:
  interruption-manager-handler --project <abs_path> --intake-id <id>
EOF
}

abs_path_or_fail() {
  local p="$1"
  [[ "$p" == /* ]] || {
    echo "[ERROR] path must be absolute: $p" >&2
    exit 1
  }
  printf '%s\n' "$p"
}

project=""
intake_id=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
    --intake-id) intake_id="${2:-}"; shift 2 ;;
    *) usage; exit 1 ;;
  esac
done

[[ -n "$project" && -n "$intake_id" ]] || {
  usage
  exit 1
}

meta_file="$project/.freely/intake/$intake_id/meta.env"
message_file="$project/.freely/intake/$intake_id/message.txt"
[[ -f "$meta_file" && -f "$message_file" ]] || exit 1
message="$(cat "$message_file")"

config_file="$project/.freely/config.env"
[[ -f "$config_file" ]] || exit 1
# shellcheck disable=SC1090
source "$config_file"

tool="${AI_TOOL:-codex}"
model="${AI_MODEL:-gpt-5.4}"
reasoning_effort="${AI_REASONING_EFFORT:-medium}"
tool_capabilities="${AI_TOOL_CAPABILITIES:-$(tool_default_capabilities "$tool")}"
tool_policy="${AI_TOOL_POLICY:-$(tool_default_policy "$tool")}"
codex_capability_model="${AI_CAPABILITY_CODEX_MODEL:-gpt-5.4}"
codex_capability_sandbox="${AI_CAPABILITY_CODEX_SANDBOX:-workspace-write}"
codex_capability_approval_policy="${AI_CAPABILITY_CODEX_APPROVAL_POLICY:-never}"
codex_capability_cwd_mode="${AI_CAPABILITY_CODEX_CWD_MODE:-project-root}"
prompt_file="$(mktemp /tmp/freely-interruption-manager-prompt.XXXXXX)"
trap 'rm -f "$prompt_file"' EXIT

cat >"$prompt_file" <<EOF
你现在承担 Freely 的 interruption manager agent。

目标：
- 第一时间注意到任意人类插话。
- 先在内部完成最小 intent understanding，再决定 routing。
- 你只根据自己的职责做最小判断：
  - 是主管先做简短澄清/回答
  - 还是委派到后续专门处理链
- 不能靠关键词穷举，也不要发明很多问题类型。
- 可以参考少量示例，但示例不是硬编码规则：
  - 纯主管监督面事实查询，通常可由主管先澄清
  - 涉及分析、执行、清理、分支/worktree收口、文档补齐、实现/测试/review 的，通常应委派
- 主管只负责 notice / claim / routing / 必要澄清，不直接承担需要实际执行的变更动作。
- 只要这条 signal 需要真正做文件修改、git 操作、worktree/branch cleanup、测试执行、review 整理、文档补齐，就不应把 ownership 留给 manager。
- 只要正确答案依赖“当前仓库/当前工位/当前运行态”的真实检查结果，也不要停在主管抽象回答；应委派到能读取并处理现场状态的后续链。
- OWNERSHIP=manager 只适用于：
  - 主管自己先回答或澄清
  - 或主管只需写自己的 continuity / routing note，而不需要执行实际变更
- 先在内部收敛这条 signal 的最小意图：
  - 它更像 clarify / audit / propose / fix / continue / recover 中哪一类
  - 是否需要 live inspection
  - 是否需要 execution
  - scope 更偏 manager-only / current-issue / fleet / runtime / project 哪一侧
  - complexity 更偏 direct 还是 multi-step
- 对 restart_point=cleanup：
  - 若要真正核对并执行 worktree / branch 收口，通常应给 OWNERSHIP=worker
- 如果用户问的是“这个现在应该怎么收口”，由于答案依赖 live fleet state，也通常应走 delegate + cleanup + worker

若选择委派，必须同时判断：
- restart point 从哪里重新开始：
  - pre_brainstorm / candidate / milestone / ibm / dev / review / verification / continuation / runtime / cleanup
- ownership 属于 manager / worker / runtime 哪一侧
- 给出一行 handoff 摘要

只输出以下 KEY=VALUE 行，不要输出任何额外文本：
DECISION=answer 或 delegate
REACTION=followup
CLASSIFICATION=control 或 discovery 或 continuation 或 noise
RESTART_POINT=<pre_brainstorm|candidate|milestone|ibm|dev|review|verification|continuation|runtime|cleanup>
OWNERSHIP=<manager|worker|runtime>
WHY=<单行中文原因，最多 40 字>
HANDOFF=<单行中文交接摘要，最多 60 字；若是 answer 可留空>
ANSWER=<单行中文回答摘要，最多 60 字；若是 delegate 可留空>

插话：
$message
EOF

(
  cd "$project"
  tool_run_from_prompt_file "$project" "$tool" "$model" "$reasoning_effort" "auto" "$prompt_file" "fresh" "$tool_capabilities" "$tool_policy" "$codex_capability_model" "$codex_capability_sandbox" "$codex_capability_approval_policy" "$codex_capability_cwd_mode"
) \
  | awk '/^(DECISION|REACTION|CLASSIFICATION|RESTART_POINT|OWNERSHIP|WHY|HANDOFF|ANSWER)=/' \
  | head -n 8
