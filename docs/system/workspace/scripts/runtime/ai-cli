_cmd_switch_auto_codex() {
  local project="${PROJECT_ROOT:-$(pwd)}"
  local tool="codex"
  local actual_account="" switched_provider="" switched_kind=""
  local result rc=0 notified_slot=""
  local live_auth_file live_auth_kind live_provider_id current_live_probe current_live_status current_live_reset
  local has_saved_slots=0

  if [[ "$DRY_RUN" == "true" ]]; then
    _cmd_switch_auto_codex_dry_run
    return 0
  fi

  codex_switch_lock_acquire "auto_probe_switch" "switch" "auto" || exit 1
  source_watchdog_script_or_fail "$project"
  live_auth_file="$(codex_live_auth_file)"
  live_auth_kind="$(codex_live_auth_kind "$live_auth_file")"
  live_provider_id="$(codex_effective_live_provider_id "$live_auth_file")"
  if [[ -n "$(codex_saved_slots "$project" || true)" ]]; then
    has_saved_slots=1
  fi

  if [[ "$live_auth_kind" == "apikey" ]] && ! codex_saved_slots_include_kind "$project" "apikey"; then
    current_live_probe="$(codex_probe_current_slot_now "$project" || true)"
    current_live_status="$(codex_probe_result_status "$current_live_probe")"
    case "$current_live_status" in
      usable)
        [[ "$FORMAT" != "json" ]] && echo -e "${GREEN}[READY]${NC} current live codex auth is usable (apikey)"
        if [[ "$FORMAT" == "json" ]]; then
          echo "{\"switched\": false, \"tool\": \"codex\", \"slot\": null, \"slot_kind\": \"apikey\", \"provider_id\": $(json_string_or_null "$live_provider_id"), \"auth_email\": null, \"account\": null, \"status\": \"usable_current_auth\", \"launch_blocked\": false}"
        fi
        codex_switch_lock_release
        return 0
        ;;
      rate_limited)
        current_live_reset="$(codex_probe_result_reset_at "$current_live_probe")"
        if [[ "$has_saved_slots" == "1" ]]; then
          log_warn "current live codex apikey is rate_limited; continuing saved-slot recovery sweep"
        else
          if [[ "$FORMAT" == "json" ]]; then
            echo "{\"switched\": false, \"tool\": \"codex\", \"slot\": null, \"slot_kind\": \"apikey\", \"provider_id\": $(json_string_or_null "$live_provider_id"), \"auth_email\": null, \"account\": null, \"status\": \"current_auth_rate_limited\", \"reset_at\": ${current_live_reset:-0}, \"launch_blocked\": true}"
          fi
          codex_switch_lock_release
          return 4
        fi
        ;;
      subscription_expired|unauthorized|deactivated_workspace|network_failure|timeout|error|unknown)
        if [[ "$has_saved_slots" == "1" ]]; then
          log_warn "current live codex auth probe returned ${current_live_status}; continuing saved-slot recovery sweep"
        else
          if [[ "$FORMAT" == "json" ]]; then
            echo "{\"switched\": false, \"tool\": \"codex\", \"slot\": null, \"slot_kind\": \"apikey\", \"provider_id\": $(json_string_or_null "$live_provider_id"), \"auth_email\": null, \"account\": null, \"status\": \"current_auth_unusable\", \"probe_status\": $(json_string_or_null "$current_live_status"), \"launch_blocked\": true}"
          fi
          codex_switch_lock_release
          return 4
        fi
        ;;
    esac
  fi

  result="$(probe_all_codex_slots_and_update_cooldown "$project" || true)"

  case "$result" in
    usable:*)
      local slot="${result#usable:}"
      _cmd_switch_codex_direct_unlocked "$tool" "$slot" "suppress_json"
      notified_slot="$slot"
      actual_account="$(extract_codex_account "$(codex_live_auth_file)")"
      switched_provider="$(codex_effective_live_provider_id "$(codex_live_auth_file)")"
      switched_kind="$(codex_saved_slot_kind "$slot")"
      [[ "$FORMAT" != "json" ]] && echo -e "${GREEN}[SWITCHED]${NC} -> $slot (usable)"
      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"switched\": true, \"tool\": \"codex\", \"slot\": \"$slot\", \"slot_kind\": $(json_string_or_null "$switched_kind"), \"provider_id\": $(json_string_or_null "$switched_provider"), \"auth_email\": $(json_string_or_null "$actual_account"), \"account\": $(json_string_or_null "$actual_account"), \"status\": \"usable\"}"
      fi
      ;;
    all_unavailable:*)
      local info="${result#all_unavailable:}"
      local earliest_slot="${info%%|*}"
      local reset_at="${info##*|}"
      local human_time
      human_time="$(format_epoch_local "$reset_at")"
      log_warn "No usable codex slot right now; leaving current auth untouched and keeping launch blocked. Earliest reset hint: $earliest_slot at $human_time"
      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"switched\": false, \"tool\": \"codex\", \"status\": \"all_unavailable\", \"earliest_slot\": $(json_string_or_null "$earliest_slot"), \"reset_at\": $reset_at, \"reset_at_human\": \"$human_time\", \"launch_blocked\": true}"
      fi
      rc=4
      ;;
    none)
      log_error "No slots found or all probing failed"
      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"switched\": false, \"status\": \"none\"}"
      fi
      rc=4
      ;;
    *)
      log_error "Unknown result: $result"
      rc=1
      ;;
  esac
  codex_switch_lock_release
  if [[ "$rc" -eq 0 && -n "$notified_slot" ]]; then
    notify_freely_auth_change "codex" "$notified_slot" "switch_success"
  fi
  return "$rc"
}

_cmd_switch_auto_codex_dry_run() {
  local auth_file active_slot current_slot candidate_slot slot slot_count=0
  local apikey_count=0 account_count=0 other_count=0
  local slots=() apikey_slots=() account_slots=()

  auth_file="$(codex_live_auth_file)"
  active_slot="$(read_tool_active_slot "codex")"
  while IFS= read -r slot; do
    [[ -n "$slot" ]] || continue
    slots+=("$slot")
    slot_count=$((slot_count + 1))
    case "$(codex_saved_slot_kind "$slot")" in
      apikey)
        apikey_slots+=("$slot")
        apikey_count=$((apikey_count + 1))
        ;;
      account)
        account_slots+=("$slot")
        account_count=$((account_count + 1))
        ;;
      *)
        other_count=$((other_count + 1))
        ;;
    esac
  done < <(list_tool_slots "codex")

  if [[ -f "$auth_file" ]]; then
    current_slot="$(codex_resolve_live_slot "$auth_file")"
  else
    current_slot=""
  fi
  candidate_slot="$current_slot"
  if [[ -z "$candidate_slot" && "${#slots[@]}" -gt 0 ]]; then
    candidate_slot="${slots[0]}"
  fi

  if [[ "$FORMAT" == "json" ]]; then
    printf '{'
    printf '"switched": false, '
    printf '"dry_run": true, '
    printf '"tool": "codex", '
    printf '"status": "dry_run_inventory", '
    printf '"current_slot": '
    json_string_or_null "$current_slot"
    printf ', "candidate_slot": '
    json_string_or_null "$candidate_slot"
    printf ', "saved_slot_count": %d, ' "$slot_count"
    printf '"saved_apikey_slot_count": %d, ' "$apikey_count"
    printf '"saved_account_slot_count": %d, ' "$account_count"
    printf '"saved_other_slot_count": %d, ' "$other_count"
    printf '"saved_slots": '
    json_array_from_values "${slots[@]}"
    printf ', "saved_apikey_slots": '
    json_array_from_values "${apikey_slots[@]}"
    printf ', "saved_account_slots": '
    json_array_from_values "${account_slots[@]}"
    printf '}\n'
    return 0
  fi

  log_info "[DRY-RUN] Would inspect saved codex slots without switching"
  log_info "Current slot: ${current_slot:-none}"
  log_info "Candidate slot: ${candidate_slot:-none}"
  log_info "Saved slots: $slot_count"
}

# 实际执行切换（不包含探测逻辑），由上层决定是否持有全局切号锁。
_cmd_switch_codex_direct_unlocked() {
  local tool="$1" slot="$2" suppress_json="${3:-}"
  local source_dir target_file switched_account switched_provider expected_kind actual_kind
  source_dir="$(auth_slot_dir "codex" "$slot")"
  target_file="$(codex_live_auth_file)"
  switched_account=""
  switched_provider=""
  expected_kind="$(codex_saved_slot_kind "$slot")"

  if [[ ! -d "$source_dir" ]]; then
    log_error "Slot '$slot' not found"
    log_info "Available: $(list_tool_slots "codex" | tr '\n' ' ')"
    exit 4
  fi

  if [[ -f "$target_file" ]]; then
    sync_current_auth "$tool"
  fi

  [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would switch to $slot"; return; }

  cp "$source_dir/auth.json" "$target_file"
  codex_apply_saved_slot_config_fragment "$slot"
  actual_kind="$(codex_live_auth_kind "$target_file")"
  if [[ "$expected_kind" == "apikey" && "$actual_kind" != "apikey" ]]; then
    log_error "Switch copied Codex bundle but active auth does not look like an apikey slot"
    exit 5
  fi
  if [[ "$expected_kind" != "apikey" && "$actual_kind" == "apikey" ]]; then
    log_error "Switch copied Codex bundle but active auth still looks like an apikey slot"
    exit 5
  fi
  switched_account="$(extract_codex_account "$target_file")"
  switched_provider="$(codex_effective_live_provider_id "$target_file")"

  write_tool_active_slot "codex" "$slot"
  log_info "Switched codex to slot: $slot"
  log_info "Switched codex slot kind: $expected_kind"
  [[ -n "$switched_account" ]] && log_info "Switched codex auth email: $switched_account"
  [[ -n "$switched_provider" ]] && log_info "Switched codex provider: $switched_provider"
  log_warn "Restart codex for the change to take effect"

  if [[ "$FORMAT" == "json" && "$suppress_json" != "suppress_json" ]]; then
    echo "{\"switched\": true, \"tool\": \"codex\", \"slot\": \"$slot\", \"slot_kind\": $(json_string_or_null "$expected_kind"), \"provider_id\": $(json_string_or_null "$switched_provider"), \"auth_email\": $(json_string_or_null "$switched_account"), \"account\": $(json_string_or_null "$switched_account")}"
  fi
}

# 列出 slots
cmd_list() {
  local tool="${1:-}"
  local accounts=()

  if [[ -z "$tool" || "$tool" == "all" ]]; then
    # List slots for all tools
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      accounts+=("$line")
    done < <(ls -1 "$AUTH_DIR" 2>/dev/null | grep -- '.-.' || true)

    if [[ ${#accounts[@]} -eq 0 ]]; then
      log_info "No slots found for any tool."
      return
    fi
  else
    if [[ "$tool" == "codex" ]]; then
      codex_switch_lock_wait_for_idle || exit 1
    fi

    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      accounts+=("$line")
    done < <(list_tool_slots "$tool")

    if [[ ${#accounts[@]} -eq 0 ]]; then
      log_info "No slots found for $tool."
      return
    fi
  fi

  case "$FORMAT" in
    json)
      echo -n "{\"accounts\": ["
      local first=true
      for a in "${accounts[@]}"; do
        [[ "$first" == "true" ]] && first=false || echo -n ", "
        echo -n "\"$a\""
      done
      echo "]}"
      ;;
    *)
      for a in "${accounts[@]}"; do
        echo "  $a"
      done
      ;;
  esac
}

# 显示当前 slot
cmd_whoami() {
  local tool="${1:-codex}"
  
  case "$tool" in
    codex)
      codex_switch_lock_wait_for_idle || exit 1
      local auth_file slot kind provider_id
      auth_file="$(codex_live_auth_file)"
      slot=""
      kind=""
      provider_id=""
      if [[ ! -f "$auth_file" ]]; then
        case "$FORMAT" in
          json) echo "{\"tool\": \"codex\", \"slot\": null, \"slot_kind\": null, \"provider_id\": null, \"auth_email\": null, \"account\": null}" ;;
          *) log_warn "Not logged in" ;;
        esac
        exit 0
      fi
      
      local account=$(extract_codex_account "$auth_file")
      slot="$(codex_resolve_live_slot "$auth_file")"
      kind="$(codex_saved_slot_kind "${slot:-}")"
      [[ -n "$slot" ]] || kind="$(codex_live_auth_kind "$auth_file")"
      provider_id="$(codex_effective_live_provider_id "$auth_file")"
      if [[ -z "$account" ]]; then
        case "$FORMAT" in
          json) echo "{\"tool\": \"codex\", \"slot\": $(json_string_or_null "$slot"), \"slot_kind\": $(json_string_or_null "$kind"), \"provider_id\": $(json_string_or_null "$provider_id"), \"auth_email\": null, \"account\": null}" ;;
          *) [[ -n "$slot" ]] && log_info "Current slot: $slot"; [[ -n "$kind" ]] && log_info "Current slot kind: $kind"; [[ -n "$provider_id" ]] && log_info "Current provider: $provider_id"; log_warn "Cannot determine auth email metadata" ;;
        esac
        exit 0
      fi
      
      case "$FORMAT" in
        json) echo "{\"tool\": \"codex\", \"slot\": $(json_string_or_null "$slot"), \"slot_kind\": $(json_string_or_null "$kind"), \"provider_id\": $(json_string_or_null "$provider_id"), \"auth_email\": \"$account\", \"account\": \"$account\"}" ;;
        *)
          [[ -n "$slot" ]] && log_info "Current slot: $slot"
          [[ -n "$kind" ]] && log_info "Current slot kind: $kind"
          [[ -n "$provider_id" ]] && log_info "Current provider: $provider_id"
          log_info "Current auth email: $account"
          ;;
      esac
      ;;
    iflow|kiro-cli|cc|cc-use-codex-cli|opencode)
      local slot=""
      slot="$(read_tool_active_slot "$tool")"
      case "$FORMAT" in
        json) echo "{\"tool\": \"$tool\", \"slot\": $(json_string_or_null "$slot"), \"auth_email\": null, \"account\": null}" ;;
        *)
          [[ -n "$slot" ]] && log_info "Current slot: $slot" || log_warn "No active slot selected for $tool"
          ;;
      esac
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 状态
cmd_status() {
  local tool="${1:-codex}"
  local project="${PROJECT_ROOT:-$(pwd)}"
  
  case "$tool" in
    codex)
      local auth_file
      auth_file="$(codex_live_auth_file)"
      local cache_file=""
      source_watchdog_script_or_fail "$project"
      cache_file="$(codex_availability_cache_file "$project")"
      if ! codex_availability_cache_is_fresh "$project"; then
        probe_all_codex_slots_and_update_cooldown "$project" "" "report_only" >/dev/null 2>&1 || true
      fi
      if [[ -f "$auth_file" ]]; then
        local mtime=$(stat -f "%Sm" "$auth_file" 2>/dev/null || stat -c "%y" "$auth_file" 2>/dev/null || echo "unknown")
        local account=$(extract_codex_account "$auth_file")
        local slot
        local slot_kind
        local provider_id
        local live_kind
        local current_auth_probe=""
        local current_auth_probe_method=""
        local current_auth_probe_status=""
        local current_auth_probe_reset="0"
        local current_auth_probe_reset_human=""
        slot="$(codex_resolve_live_slot "$auth_file")"
        live_kind="$(codex_live_auth_kind "$auth_file")"
        slot_kind="$(codex_saved_slot_kind "${slot:-}")"
        [[ -n "$slot" ]] || slot_kind="$live_kind"
        provider_id="$(codex_effective_live_provider_id "$auth_file")"
        local usable_count=""
        local limited_count=""
        local deactivated_count=""
        local unknown_count=""
        local cache_refreshed=""
        local cache_refreshed_human=""
        local earliest_slot=""
        local earliest_reset=""
        local earliest_reset_human=""
        if [[ -f "$cache_file" ]]; then
          usable_count="$(awk -F '\t' 'NR>1 && $2=="usable" {count++} END {print count+0}' "$cache_file")"
          limited_count="$(awk -F '\t' 'NR>1 && $2=="rate_limited" {count++} END {print count+0}' "$cache_file")"
          deactivated_count="$(awk -F '\t' 'NR>1 && $2=="deactivated_workspace" {count++} END {print count+0}' "$cache_file")"
          unknown_count="$(awk -F '\t' 'NR>1 && $2!="usable" && $2!="rate_limited" && $2!="deactivated_workspace" {count++} END {print count+0}' "$cache_file")"
          cache_refreshed="$(awk -F '\t' 'NR==2 {print $7}' "$cache_file")"
          read -r earliest_slot earliest_reset < <(awk -F '\t' '
            NR==1 {next}
            $2=="rate_limited" && $4 ~ /^[0-9]+$/ && $4 > 0 {
              if (best_reset == "" || $4 < best_reset) {
                best_slot = $1
                best_reset = $4
              }
            }
            END {
              print best_slot, best_reset
            }
          ' "$cache_file")
          if [[ -n "$earliest_reset" && "$earliest_reset" =~ ^[0-9]+$ && "$earliest_reset" -gt 0 ]]; then
            earliest_reset_human="$(format_epoch_local "$earliest_reset")"
          fi
          if [[ -n "$cache_refreshed" ]]; then
            cache_refreshed_human="$(format_timestamp_local "$cache_refreshed")"
          fi
        fi
        if [[ "$live_kind" == "apikey" ]]; then
          current_auth_probe_method="exec_current_auth"
          current_auth_probe="$(codex_probe_current_slot_now "$project" || true)"
          current_auth_probe_status="$(codex_probe_result_status "$current_auth_probe")"
          current_auth_probe_reset="$(codex_probe_result_reset_at "$current_auth_probe")"
          if [[ "$current_auth_probe_reset" =~ ^[0-9]+$ && "$current_auth_probe_reset" -gt 0 ]]; then
            current_auth_probe_reset_human="$(format_epoch_local "$current_auth_probe_reset")"
          fi
        fi
        
        case "$FORMAT" in
          json)
            echo "{\"tool\": \"codex\", \"auth\": \"present\", \"slot\": $(json_string_or_null "$slot"), \"slot_kind\": $(json_string_or_null "$slot_kind"), \"provider_id\": $(json_string_or_null "$provider_id"), \"auth_email\": $(json_string_or_null "$account"), \"account\": $(json_string_or_null "$account"), \"last_modified\": \"$mtime\", \"current_auth_probe\": {\"present\": $([[ "$live_kind" == "apikey" ]] && printf true || printf false), \"method\": $(json_string_or_null "$current_auth_probe_method"), \"status\": $(json_string_or_null "$current_auth_probe_status"), \"reset_at\": ${current_auth_probe_reset:-0}, \"reset_at_human\": $(json_string_or_null "$current_auth_probe_reset_human")}, \"availability_cache\": {\"present\": $([[ -f "$cache_file" ]] && printf true || printf false), \"usable\": ${usable_count:-0}, \"rate_limited\": ${limited_count:-0}, \"deactivated_workspace\": ${deactivated_count:-0}, \"other\": ${unknown_count:-0}, \"earliest_slot\": $(json_string_or_null "$earliest_slot"), \"earliest_reset_at\": ${earliest_reset:-0}, \"earliest_reset_human\": $(json_string_or_null "$earliest_reset_human"), \"refreshed_at\": $(json_string_or_null "$cache_refreshed"), \"refreshed_at_human\": $(json_string_or_null "$cache_refreshed_human")}}"
            ;;
          *)
            log_info "Tool: codex"
            log_info "Auth: present"
            [[ -n "$slot" ]] && log_info "Slot: $slot"
            [[ -n "$slot_kind" ]] && log_info "Slot kind: $slot_kind"
            [[ -n "$provider_id" ]] && log_info "Provider: $provider_id"
            log_info "Auth email: ${account:-unknown}"
            log_info "Last modified: $mtime"
            if [[ "$live_kind" == "apikey" ]]; then
              log_info "Current auth probe: ${current_auth_probe_status:-unknown} (method=exec_current_auth)"
              if [[ -n "$current_auth_probe_reset_human" ]]; then
                log_info "Current auth reset hint: $current_auth_probe_reset_human"
              fi
            fi
            if [[ -f "$cache_file" ]]; then
              log_info "Recovery ledger: usable=${usable_count:-0} rate_limited=${limited_count:-0} deactivated_workspace=${deactivated_count:-0} other=${unknown_count:-0}"
              if [[ -n "$earliest_slot" && -n "$earliest_reset_human" ]]; then
                log_info "Earliest reset: ${earliest_slot} at ${earliest_reset_human}"
              fi
              [[ -n "$cache_refreshed_human" ]] && log_info "Availability cache refreshed: $cache_refreshed_human"
            fi
            ;;
        esac
      else
        case "$FORMAT" in
          json) echo "{\"tool\": \"codex\", \"auth\": \"missing\"}" ;;
          *) log_warn "No codex auth found" ;;
        esac
      fi
      ;;
    iflow|kiro-cli|cc|cc-use-codex-cli|opencode)
      local slot path
      slot="$(read_tool_active_slot "$tool")"
      path=""
      [[ -n "$slot" ]] && path="$(auth_slot_dir "$tool" "$slot")"
      case "$FORMAT" in
        json)
          echo "{\"tool\": \"$tool\", \"auth\": $(json_string_or_null "${slot:+slot_inventory}"), \"slot\": $(json_string_or_null "$slot"), \"path\": $(json_string_or_null "$path")}"
          ;;
        *)
          log_info "Tool: $tool"
          if [[ -n "$slot" ]]; then
            log_info "Slot: $slot"
            log_info "Path: $path"
          else
            log_warn "No active slot selected for $tool"
          fi
          ;;
      esac
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 删除 slot
cmd_delete() {
  local tool="$1"
  local slot="$2"
  local target_dir
  target_dir="$(auth_slot_dir "$tool" "$slot")"

  if [[ ! -d "$target_dir" ]]; then
    log_error "Slot '$slot' not found"
    exit 4
  fi

  confirm "Delete slot '$slot'?" || exit 1

  [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would delete $target_dir"; return; }

  rm -rf "$target_dir"
  if [[ "$(read_tool_active_slot "$tool")" == "$slot" ]]; then
    clear_tool_active_slot "$tool"
  fi
  log_info "Deleted slot: $slot"

  if [[ "$FORMAT" == "json" ]]; then
    echo "{\"deleted\": true, \"tool\": \"$tool\", \"slot\": \"$slot\"}"
  fi
}

# 帮助
show_help() {
  cat <<'EOF'
Usage: freely ai <command> [options]

Commands:
  init                    Initialize slot manager
  login <tool> [mode]     Login and auto-save auth slot (`mode`: `account|apikey`)
  save <tool> [slot]      Save current login (auto-detect next slot if not specified)
  switch [slot]             Switch to slot (auto-extracts tool from name)
  list [tool]             List saved slots (default: all tools; specify a tool name to filter)
  whoami [tool]           Show current logged-in slot
  status [tool]           Show current status
  delete <tool> <slot>    Delete a slot

Options:
  --yes, -y               Skip confirmations (non-interactive)
  --format FORMAT         Output format: text|json|yaml
  --quiet, -q             Quiet mode
  --dry-run               Simulate without changes
  --name NAME             Provider id/name for `login <tool> apikey`
  --url URL               Base URL for `login <tool> apikey`
  --key KEY               API key for `login <tool> apikey`

Exit codes:
  0 = success
  1 = general error
  2 = parameter error
  3 = auth error
  4 = not found

Examples:
  freely ai init
  freely ai login codex
  freely ai login codex apikey
  freely ai login codex apikey --name custom --url https://api.openai.com/v1 --key sk-...
  freely ai whoami
  freely ai login claude apikey --name my-provider
  freely ai login opencode apikey --name my-provider
  freely ai switch claude claude-apikey-my-provider --project . --yes

  freely ai list --format json
EOF
}

# 主入口
main() {
  local COMMAND=""
  local ARGS=()
  
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) YES_MODE=true; shift ;;
      --format) FORMAT="$2"; shift 2 ;;
      --quiet|-q) QUIET=true; shift ;;
      --dry-run) DRY_RUN=true; shift ;;
      --name) LOGIN_PROVIDER_NAME="$2"; shift 2 ;;
      --url) LOGIN_BASE_URL="$2"; shift 2 ;;
      --key) LOGIN_API_KEY="$2"; shift 2 ;;
      --project) SWITCH_PROJECT="$2"; shift 2 ;;
      --help|-h) show_help; exit 0 ;;
      -*)
        log_error "Unknown option: $1"
        exit 2
        ;;
      *)
        if [[ -z "$COMMAND" ]]; then
          COMMAND="$1"
        else
          ARGS+=("$1")
        fi
        shift
        ;;
    esac
  done
  
  case "$COMMAND" in
    init) cmd_init ;;
    login) cmd_login "${ARGS[0]}" "${ARGS[1]:-}" ;;
    save) cmd_save "${ARGS[0]}" "${ARGS[1]:-}" ;;
    switch)
      # slot name is self-describing: {tool}-apikey-{name} or {tool}-account-{name}
      cmd_switch "${ARGS[0]:-}"
      ;;
    list) cmd_list "${ARGS[0]:-}" ;;
    whoami) cmd_whoami "${ARGS[0]:-codex}" ;;
    status) cmd_status "${ARGS[0]:-codex}" ;;
    delete) cmd_delete "${ARGS[0]}" "${ARGS[1]}" ;;
    ""|--help|-h) show_help ;;
    *)
      log_error "Unknown command: $COMMAND"
      show_help
      exit 2
      ;;
  esac
}

main "$@"
