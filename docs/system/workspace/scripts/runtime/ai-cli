#!/usr/bin/env bash
set -euo pipefail

# AI CLI Availability Manager
# Usage: freely ai-cli <command> [options]

# 配置
AUTH_DIR="$HOME/.ai-auth"
CONFIG_FILE="$HOME/.config/freely/ai-cli-profiles.yaml"

# 全局选项
YES_MODE=false
FORMAT="text"
QUIET=false
DRY_RUN=false

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 工具函数
log_info() {
  [[ "$QUIET" == "true" ]] && return
  echo -e "${GREEN}[INFO]${NC} $1"
}

log_error() {
  echo -e "${RED}[ERROR]${NC} $1" >&2
}

log_warn() {
  [[ "$QUIET" == "true" ]] && return
  echo -e "${YELLOW}[WARN]${NC} $1"
}

# 确认操作
confirm() {
  local msg="$1"
  [[ "$YES_MODE" == "true" ]] && return 0
  read -r -p "$msg [y/N] " response
  [[ "$response" =~ ^[Yy]$ ]]
}

# 初始化
cmd_init() {
  mkdir -p "$AUTH_DIR"
  chmod 700 "$AUTH_DIR"
  mkdir -p "$(dirname "$CONFIG_FILE")"
  
  if [[ ! -f "$CONFIG_FILE" ]]; then
    cat > "$CONFIG_FILE" << EOF
version: 1
default_tool: codex
tools:
  codex:
    method: copy_auth
    active: ""
    profiles: {}
  iflow:
    method: env_var
    active: ""
    profiles: {}
EOF
    log_info "Created config: $CONFIG_FILE"
  fi
  
  log_info "Initialized AI CLI profile manager"
  log_info "Auth directory: $AUTH_DIR"
}

# 保存当前登录
cmd_save() {
  local tool="$1"
  local profile="$2"
  
  case "$tool" in
    codex)
      local auth_file="$HOME/.codex/auth.json"
      if [[ ! -f "$auth_file" ]]; then
        log_error "No codex auth found. Run 'codex login' first."
        exit 3
      fi
      
      local target_dir="$AUTH_DIR/codex-$profile"
      
      if [[ -d "$target_dir" ]] && [[ "$YES_MODE" != "true" ]]; then
        confirm "Profile '$profile' exists. Overwrite?" || exit 1
      fi
      
      [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would save to $target_dir"; return; }
      
      mkdir -p "$target_dir"
      cp "$auth_file" "$target_dir/"
      chmod 600 "$target_dir/auth.json"
      
      log_info "Saved codex profile: $profile"
      log_info "Location: $target_dir"
      
      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"saved\": true, \"tool\": \"codex\", \"profile\": \"$profile\", \"path\": \"$target_dir\"}"
      fi
      ;;
    iflow)
      log_error "iflow uses environment variables. Set IFLOW_${profile^^}_KEY in your shell config."
      exit 2
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 切换 profile
cmd_switch() {
  local tool="$1"
  local profile="${2:-}"
  
  if [[ -z "$profile" ]]; then
    log_info "Available profiles:"
    ls -1 "$AUTH_DIR" 2>/dev/null | grep "^${tool}-" | sed "s/^${tool}-/  /" || true
    return
  fi
  
  case "$tool" in
    codex)
      local source_dir="$AUTH_DIR/codex-$profile"
      local target_file="$HOME/.codex/auth.json"
      
      if [[ ! -d "$source_dir" ]]; then
        log_error "Profile '$profile' not found"
        log_info "Available: $(ls -1 "$AUTH_DIR" 2>/dev/null | grep '^codex-' | sed 's/codex-//' | tr '\n' ' ')"
        exit 4
      fi
      
      if [[ -f "$target_file" ]]; then
        cp "$target_file" "$target_file.bak"
        log_info "Backed up current auth to: $target_file.bak"
      fi
      
      [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would switch to $profile"; return; }
      
      cp "$source_dir/auth.json" "$target_file"
      log_info "Switched codex to profile: $profile"
      log_warn "Restart codex for the change to take effect"
      
      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"switched\": true, \"tool\": \"codex\", \"profile\": \"$profile\"}"
      fi
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 列出 profiles
cmd_list() {
  local profiles=()
  
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    profiles+=("$line")
  done < <(ls -1 "$AUTH_DIR" 2>/dev/null || true)
  
  if [[ ${#profiles[@]} -eq 0 ]]; then
    log_info "No profiles found. Run 'freely ai-cli save <tool> <profile>' to create one."
    return
  fi
  
  case "$FORMAT" in
    json)
      echo -n "{\"profiles\": ["
      local first=true
      for p in "${profiles[@]}"; do
        [[ "$first" == "true" ]] && first=false || echo -n ", "
        echo -n "\"$p\""
      done
      echo "]}"
      ;;
    *)
      for p in "${profiles[@]}"; do
        echo "  $p"
      done
      ;;
  esac
}

# 状态
cmd_status() {
  local tool="${1:-codex}"
  
  case "$tool" in
    codex)
      local auth_file="$HOME/.codex/auth.json"
      if [[ -f "$auth_file" ]]; then
        local mtime=$(stat -f "%Sm" "$auth_file" 2>/dev/null || stat -c "%y" "$auth_file" 2>/dev/null || echo "unknown")
        
        case "$FORMAT" in
          json)
            echo "{\"tool\": \"codex\", \"auth\": \"present\", \"last_modified\": \"$mtime\"}"
            ;;
          *)
            log_info "Tool: codex"
            log_info "Auth: present"
            log_info "Last modified: $mtime"
            ;;
        esac
      else
        case "$FORMAT" in
          json) echo "{\"tool\": \"codex\", \"auth\": \"missing\"}" ;;
          *) log_warn "No codex auth found" ;;
        esac
      fi
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 删除 profile
cmd_delete() {
  local tool="$1"
  local profile="$2"
  local target_dir="$AUTH_DIR/${tool}-${profile}"
  
  if [[ ! -d "$target_dir" ]]; then
    log_error "Profile '$profile' not found"
    exit 4
  fi
  
  confirm "Delete profile '$profile'?" || exit 1
  
  [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would delete $target_dir"; return; }
  
  rm -rf "$target_dir"
  log_info "Deleted profile: $profile"
  
  if [[ "$FORMAT" == "json" ]]; then
    echo "{\"deleted\": true, \"tool\": \"$tool\", \"profile\": \"$profile\"}"
  fi
}

# 帮助
show_help() {
  cat << EOF
Usage: freely ai-cli <command> [options]

Commands:
  init                    Initialize profile manager
  save <tool> <profile>   Save current login as profile
  switch <tool> [profile] Switch to profile (interactive if no profile)
  list                    List all profiles
  status [tool]           Show current status
  delete <tool> <profile> Delete a profile

Options:
  --yes, -y               Skip confirmations (non-interactive)
  --format FORMAT         Output format: text|json|yaml
  --quiet, -q             Quiet mode
  --dry-run               Simulate without changes

Exit codes:
  0 = success
  1 = general error
  2 = parameter error
  3 = auth error
  4 = not found

Examples:
  freely ai-cli init
  codex login && freely ai-cli save codex personal
  freely ai-cli switch codex work --yes
  freely ai-cli list --format json
EOF
}

# 主入口
main() {
  local COMMAND=""
  local ARGS=()
  
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) YES_MODE=true; shift ;;
      --format) FORMAT="$2"; shift 2 ;;
      --quiet|-q) QUIET=true; shift ;;
      --dry-run) DRY_RUN=true; shift ;;
      --help|-h) show_help; exit 0 ;;
      -*)
        log_error "Unknown option: $1"
        exit 2
        ;;
      *)
        if [[ -z "$COMMAND" ]]; then
          COMMAND="$1"
        else
          ARGS+=("$1")
        fi
        shift
        ;;
    esac
  done
  
  case "$COMMAND" in
    init) cmd_init ;;
    save) cmd_save "${ARGS[0]}" "${ARGS[1]}" ;;
    switch) cmd_switch "${ARGS[0]}" "${ARGS[1]:-}" ;;
    list) cmd_list ;;
    status) cmd_status "${ARGS[0]:-codex}" ;;
    delete) cmd_delete "${ARGS[0]}" "${ARGS[1]}" ;;
    ""|--help|-h) show_help ;;
    *)
      log_error "Unknown command: $COMMAND"
      show_help
      exit 2
      ;;
  esac
}

main "$@"
