# _login_account_slot: create account-mode slot with interactive slot name prompt.
# Slot dir: ~/.ai-auth/{tool}-account-{name}/
# Alias:    {tool}-account-{name}="{tool}"
# For claude/opencode/cc/kiro-cli — account mode uses default tool auth (OAuth/keychain),
# so the slot is a named reference without a custom settings override.
_login_account_slot() {
  local tool="$1" slot_name slot_dir alias_name rc_file

  # Resolve slot name: --name flag or interactive prompt
  if [[ -n "${LOGIN_PROVIDER_NAME:-}" ]]; then
    slot_name="${tool}-account-${LOGIN_PROVIDER_NAME}"
  else
    if [[ "$YES_MODE" == "true" ]]; then
      log_error "--name is required in non-interactive (--yes) mode for $tool account login"
      exit 2
    fi
    local custom_name
    custom_name="$(prompt_value "Enter slot name for $tool account")"
    [[ -z "$custom_name" ]] && { log_error "Slot name is required — cannot be empty"; exit 2; }
    slot_name="${tool}-account-${custom_name}"
  fi

  slot_dir="$AUTH_DIR/$slot_name"
  alias_name="$slot_name"

  [[ "$DRY_RUN" == "true" ]] && {
    log_info "[DRY-RUN] Would create account slot: $slot_dir"
    log_info "[DRY-RUN] Would add alias: $alias_name"
    return 0
  }

  mkdir -p "$slot_dir"
  write_tool_active_slot "$tool" "$slot_name"

  # Add alias to shell rc — account mode points directly to the tool binary
  rc_file="${FREELY_SHELL_RC_FILE:-$HOME/.zshrc}"
  if ! grep -qF "alias $alias_name=" "$rc_file" 2>/dev/null; then
    echo "alias $alias_name=\"$tool\"" >> "$rc_file"
    log_info "Alias added: $alias_name"
  else
    log_info "Alias already exists: $alias_name"
  fi

  notify_freely_auth_change "$tool" "$slot_name" "login_success"

  echo ""
  log_info "============================================"
  log_info "Account slot created successfully!"
  log_info "  Tool:   $tool (account)"
  log_info "  Alias:  $alias_name"
  log_info "  Dir:    $slot_dir"
  log_info ""
  log_info "  Run '$alias_name' to use $tool with default auth."
  log_info "============================================"
  echo ""
}

# 保存当前登录
cmd_save() {
  local tool="$1"
  local slot="${2:-}"
  local explicit_slot_arg="$slot"
  
  case "$tool" in
    codex)
      local auth_file
      auth_file="$(codex_live_auth_file)"
      if [[ ! -f "$auth_file" ]]; then
        log_error "No codex auth found. Run 'freely ai login codex' first."
        exit 3
      fi

      local actual_account kind provider_id
      actual_account="$(extract_codex_account "$auth_file")"
      kind="$(codex_live_auth_kind "$auth_file")"
      provider_id="$(codex_effective_provider_id_for_kind "$kind" "$(codex_effective_live_provider_id "$auth_file")")"

      if [[ -z "$slot" && -z "$actual_account" && "$kind" != "apikey" ]]; then
        log_error "Cannot derive Codex slot identity from current auth. Please specify slot name."
          log_info "Usage: freely ai save codex <slot>"
          exit 2
      fi

      if [[ -n "$actual_account" ]]; then
        log_info "Detected auth email: $actual_account"
      fi

      slot="$(resolve_codex_slot_name "$auth_file" "$slot" "$tool")"
      local target_dir
      target_dir="$(auth_slot_dir "codex" "$slot")"

      if [[ -n "$explicit_slot_arg" ]] && [[ -d "$target_dir" ]] && [[ "$YES_MODE" != "true" ]]; then
        confirm "Slot '$slot' exists. Overwrite?" || exit 1
      fi

      [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would save to $target_dir"; return; }

      codex_save_live_bundle_to_slot "$slot" "$target_dir"
      write_tool_active_slot "codex" "$slot"

      log_info "Saved codex slot: $slot"
      log_info "Slot kind: $kind"
      [[ -n "$actual_account" ]] && log_info "Slot auth email: $actual_account"
      [[ -n "$provider_id" ]] && log_info "Provider: $provider_id"
      log_info "Slot: $slot"
      log_info "Location: $target_dir"

      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"saved\": true, \"tool\": \"codex\", \"slot\": \"$slot\", \"slot_kind\": $(json_string_or_null "$kind"), \"provider_id\": $(json_string_or_null "$provider_id"), \"auth_email\": $(json_string_or_null "$actual_account"), \"account\": $(json_string_or_null "$actual_account"), \"path\": \"$target_dir\"}"
      fi
      ;;
    iflow)
      tool_save_generic "$tool" "$slot"
      log_info "iflow auth material still comes from environment/config; saved slot container for scheduler compatibility."
      ;;
    kiro-cli|cc|cc-use-codex-cli|opencode)
      tool_save_generic "$tool" "$slot"
      ;;
    *)
      local _bt2="${tool%%-*}"
      case "$_bt2" in *-apikey-*) _bt2="${_bt2%%-apikey-*}" ;; *-account-*) _bt2="${_bt2%%-account-*}" ;; esac
      if _tool_is_registered "$_bt2" 2>/dev/null; then
        tool_save_generic "$tool" "$slot"
      else
        log_error "Unknown tool: $tool"
        exit 2
      fi
      ;;
  esac
}

# 同步当前 auth.json 到对应备份目录
sync_current_auth() {
  local tool="$1"
  local auth_file
  auth_file="$(codex_live_auth_file)"
  
  if [[ ! -f "$auth_file" ]]; then
    return 0
  fi
  
  local current_slot
  if [[ "$tool" == "codex" ]]; then
    current_slot="$(codex_resolve_live_slot "$auth_file")"
  else
    current_slot="$(read_tool_active_slot "$tool")"
  fi
  if [[ -z "$current_slot" ]]; then
    return 0
  fi

  local backup_dir
  backup_dir="$(auth_slot_dir "$tool" "$current_slot")"

  # 只在当前活跃槽位已存在时同步，避免创建意外槽位
  if [[ -d "$backup_dir" ]]; then
    codex_save_live_bundle_to_slot "$current_slot" "$backup_dir"
    log_info "Auto-synced current token to slot: $current_slot"
  fi
}

# Extract tool from full slot name (e.g. claude-apikey-xxx → claude)
_extract_tool_from_slot() {
  local slot="$1"
  if [[ "$slot" == *-apikey-* ]]; then
    printf '%s\n' "${slot%%-apikey-*}"
  elif [[ "$slot" == *-account-* ]]; then
    printf '%s\n' "${slot%%-account-*}"
  else
    printf '%s\n' "${slot%%-*}"
  fi
}

# 切换 slot
# Usage:
#   switch <tool> <slot>  - 切换到指定 slot
#   switch <tool>         - 自动探测，切换到可用的或最早恢复的
cmd_switch() {
  local slot="${1:-}"
  local tool=""

  if [[ -z "$slot" ]]; then
    _cmd_switch_auto
    return $?
  fi

  # Auto-detect project from PWD when --project not specified
  if [[ -z "${SWITCH_PROJECT:-}" ]]; then
    local _pwd="$PWD"
    while [[ "$_pwd" != "/" ]]; do
      if [[ -f "$_pwd/.freely/config.toml" ]]; then
        SWITCH_PROJECT="$_pwd"
        break
      fi
      _pwd="$(dirname "$_pwd")"
    done
  fi

  tool="$(_extract_tool_from_slot "$slot")"
  _require_acp_binary "$tool" || exit 1

  case "$tool" in
    codex)
      codex_switch_lock_acquire "explicit_switch" "switch" "$slot" || exit 1
      _cmd_switch_codex_direct_unlocked "$tool" "$slot"
      local rc=$?
      codex_switch_lock_release
      if [[ "$rc" -eq 0 ]]; then
        notify_freely_auth_change "codex" "$slot" "switch_success"
        if [[ -n "${SWITCH_PROJECT:-}" ]]; then
          local _cfg="${SWITCH_PROJECT}/.freely/config.toml"
          local _ai_tool_val="$slot"
          if [[ -f "$_cfg" ]]; then
            local _old_tool
            _old_tool=$("$SELF_ROOT/bin/toml2env" --project "${SWITCH_PROJECT}" 2>/dev/null | grep "^export AI_TOOL=" | sed 's/^export AI_TOOL=//; s/^"//; s/"$//') || true
            "$SELF_ROOT/docs/system/workspace/scripts/runtime/freely_config.py" upsert \
              --project "${SWITCH_PROJECT}" --key "AI_TOOL" --value "$_ai_tool_val"
            log_info "Updated AI_TOOL in config: $_ai_tool_val"
            # Record switch in tool_switch_events table
            local cli="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli"
            python3 "$cli" --project "${SWITCH_PROJECT}" session.tool-switch-write \
              --trigger_error switch_command --old_tool "$_old_tool" \
              --new_tool "$_ai_tool_val" 2>/dev/null || true
          fi
        fi
      fi
      return "$rc"
      ;;
    claude|cc|cc-use-codex-cli|opencode|iflow|kiro-cli)
      tool_switch_direct_generic "$tool" "$slot"
      if [[ "$slot" == *-apikey-* && -n "${SWITCH_PROJECT:-}" ]]; then
        local cfg="${SWITCH_PROJECT}/.freely/config.toml"
        if [[ -f "$cfg" ]]; then
          local _old_tool
          _old_tool=$("$SELF_ROOT/bin/toml2env" --project "${SWITCH_PROJECT}" 2>/dev/null | grep "^export AI_TOOL=" | sed 's/^export AI_TOOL=//; s/^"//; s/"$//') || true
          "$SELF_ROOT/docs/system/workspace/scripts/runtime/freely_config.py" upsert \
            --project "${SWITCH_PROJECT}" --key "AI_TOOL" --value "$slot"
          log_info "Updated AI_TOOL in config: $slot"
          local cli="$SELF_ROOT/docs/system/workspace/scripts/runtime/freely-db-cli"
          python3 "$cli" --project "${SWITCH_PROJECT}" session.tool-switch-write \
            --trigger_error switch_command --old_tool "$_old_tool" \
            --new_tool "$slot" 2>/dev/null || true
        fi
      fi
      ;;
    *)
      if _tool_is_registered "$tool" 2>/dev/null; then
        tool_switch_direct_generic "$tool" "$slot"
      else
        log_error "Unknown tool '"'"'$tool'"'"' extracted from slot '"'"'$slot'"'"'"
        exit 2
      fi
      ;;
  esac
}
# Auto-switch: probe all tools in priority order, switch to first usable slot
_cmd_switch_auto() {
  local project="${PROJECT_ROOT:-$(pwd)}"
  [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would auto-detect and switch to best available slot"; return 0; }

  # Build tool priority: current tool first, then fallback list
  local current_tool priority_list
  current_tool="$(_extract_tool_from_slot "$(read_tool_active_slot "${AI_TOOL%%-*}")" 2>/dev/null || true)"
  [[ -z "$current_tool" ]] && current_tool="${AI_TOOL%%-*}"
  [[ -z "$current_tool" || "$current_tool" == "oc" ]] && current_tool="codex"

  local fallback="${AI_FALLBACK_TOOLS:-codex,claude,opencode,kiro-cli,cc-use-codex-cli}"
  priority_list="$current_tool"
  local _visited=" $current_tool "
  IFS=',' read -ra _fb <<< "$fallback"
  for _t in "${_fb[@]}"; do
    _t="$(echo "$_t" | xargs)"
    [[ "$_visited" == *" $_t "* ]] && continue
    priority_list+=" $_t"
    _visited+="$_t "
  done

  local _attempted_slots=""
  for tool in $priority_list; do
    local slots
    slots=$(list_tool_slots "$tool" 2>/dev/null || true)
    [[ -z "$slots" ]] && continue
    for slot in $slots; do
      [[ -z "$slot" ]] && continue
      # Skip previously attempted
      [[ "$_attempted_slots" == *"|$slot|"* ]] && continue
      _attempted_slots+="|$slot|"

      local slot_dir; slot_dir="$(auth_slot_dir "$tool" "$slot")"
      [[ -d "$slot_dir" ]] || continue

      local result
      probe_ok=0; _out="$(mktemp)"
      case "$tool" in
        claude|cc|cc-use-codex-cli)
          echo "say hi" | perl -e '"'"'alarm 10; exec @ARGV'"'"' claude -p --settings "$slot_dir/settings.json" >"$_out" 2>&1 && probe_ok=1 ;;
        opencode)
          perl -e '"'"'alarm 10; exec @ARGV'"'"' bash -c "OPENCODE_CONFIG='"'"'$slot_dir/settings.json'"'"' opencode run '"'"'say hi'"'"'" >"$_out" 2>&1 && probe_ok=1 ;;
        codex)
          perl -e '"'"'alarm 10; exec @ARGV'"'"' bash -c "CODEX_HOME='"'"'"'"'"\$slot_dir'"'"'"'"'" codex exec '"'"'"'"say hi'"'"'"'" --skip-git-repo-check" >"\$_out" 2>&1 && probe_ok=1 ;;
        *)
          # Registry-driven: use test_command for unknown tools
          local _test_cmd
          _test_cmd=$(_tool_registry_get "$tool" "test_command" 2>/dev/null || true)
          if [[ -n "$_test_cmd" ]]; then
            perl -e '"'"'alarm 10; exec @ARGV'"'"' bash -c "$_test_cmd" >"$_out" 2>&1 && probe_ok=1
          fi
          ;;
      esac
      rm -f "$_out"
      if [[ "$probe_ok" == "1" ]]; then
        log_info "Auto-switch: $slot (usable)"
        cmd_switch "$slot"
        return 0
      else
        log_warn "Auto-switch: $slot skipped"
      fi
    done
  done

  log_error "No usable slot found across tools: $priority_list"
  return 4
}

