# 登录
cmd_login() {
  local tool="$1" auth_mode="${2:-}"

  # ── Registry check: warn if base tool not registered ──────────
  # Strip slot suffix to get base tool (opencode-apikey-ds → opencode)
  local _base_tool="$tool"
  case "$_base_tool" in
    *-apikey-*) _base_tool="${_base_tool%%-apikey-*}" ;;
    *-account-*) _base_tool="${_base_tool%%-account-*}" ;;
  esac
  if ! _tool_registry_get "$_base_tool" "slot.discovery" >/dev/null 2>&1; then
    log_warn "Tool '$_base_tool' is not registered in tool-registry.json5."
    log_warn "Login will create the slot + alias, but the ACP bridge won't know"
    log_warn "how to discover its config.  You MUST add a registry entry first:"
    log_warn ""
    log_warn "  File: docs/system/workspace/scripts/runtime/tool-registry.json5"
    log_warn ""
    log_warn "  Add a block like this (adjust fields for your tool):"
    log_warn '  "{                                                "'
    log_warn '  "  \"$_base_tool\": {                                   "'
    log_warn '  "    \"acp\":        { \"binary\": \"...\", \"args\": [] }, "'
    log_warn '  "    \"permission\": { \"mechanism\": \"...\", ... },     "'
    log_warn '  "    \"slot\": {                                       "'
    log_warn '  "      \"discovery\":  \"alias_env_var\",              "'
    log_warn '  "      \"alias_key\":  \"NEWTOOL_CONFIG\",             "'
    log_warn '  "      \"config_file\": \"settings.json\",             "'
    log_warn '  "      \"is_dir\":       false,                        "'
    log_warn '  "      \"bridge_config_env\": \"NEWTOOL_CONFIG\",     "'
    log_warn '  "      \"post_init\":    \"\"                          "'
    log_warn '  "    },                                               "'
    log_warn '  "    \"session\":     { ... },                         "'
    log_warn '  "    \"model_default\": \"...\",                       "'
    log_warn '  "    \"test_command\": \"...\"                         "'
    log_warn '  "  }                                                 "'
    log_warn ""
    log_warn "  See existing entries (claude, opencode, codex) for reference."
    log_warn "  Then re-run: freely ai login $tool $auth_mode"
    log_warn ""
    if [[ "${FREELY_STRICT_NEW_TOOL:-}" == "true" ]]; then
      log_error "Aborting: FREELY_STRICT_NEW_TOOL=true (set to false to proceed anyway)"
      exit 3
    fi
  fi

  # ── apikey: unified across ALL tools ──
  if [[ "$auth_mode" == "apikey" ]]; then
    _require_acp_binary "$tool" || exit 1
    _login_apikey_alias "$tool"
    return 0
  fi

  # ── account (or default): per-tool ──
  case "$tool" in
    codex)
      if [[ -z "$auth_mode" ]]; then
        auth_mode="$(codex_prompt_login_mode)"
      fi
      if [[ "$auth_mode" != "account" ]]; then
        log_error "Unsupported codex auth mode: $auth_mode (use: account, apikey)"
        exit 2
      fi
      log_info "Launching codex login..."
      codex login
      if [[ -f "$(codex_live_auth_file)" ]]; then
        local auth_file slot target_dir account kind provider_id
        auth_file="$(codex_live_auth_file)"
        kind="$(codex_live_auth_kind "$auth_file")"
        slot="$(resolve_codex_slot_name "$auth_file" "" "$tool")"
        target_dir="$(auth_slot_dir "$tool" "$slot")"
        account="$(extract_codex_account "$auth_file")"
        provider_id="$(codex_effective_provider_id_for_kind "$kind" "$(codex_effective_live_provider_id "$auth_file")")"
        codex_save_live_bundle_to_slot "$slot" "$target_dir"
        write_tool_active_slot "codex" "$slot"
        [[ -n "$account" ]] && log_info "Auto-saved auth email: $account"
        [[ -n "$provider_id" ]] && log_info "Provider: $provider_id"
        log_info "Slot kind: $kind"
        log_info "Slot: $slot"
        log_info "Location: $target_dir"
        notify_freely_auth_change "codex" "$slot" "login_success"

        # Generate shell alias for account mode (same format as apikey mode)
        local _rc_file _alias_name
        _rc_file="${FREELY_SHELL_RC_FILE:-$HOME/.zshrc}"
        _alias_name="$slot"
        if ! grep -qF "alias $_alias_name=" "$_rc_file" 2>/dev/null; then
          echo "alias $_alias_name='CODEX_HOME=\"$target_dir\" codex'" >> "$_rc_file"
          log_info "Alias added: $_alias_name"
        else
          log_info "Alias already exists: $_alias_name"
        fi

        # Auto-detect project from PWD and update AI_TOOL in config
        local _project_dir="$PWD"
        while [[ "$_project_dir" != "/" ]]; do
          if [[ -f "$_project_dir/.freely/config.toml" ]]; then
            local _ai_tool_val="$slot"
            "$SELF_ROOT/docs/system/workspace/scripts/runtime/freely_config.py" upsert \
              --project "$_project_dir" --key "AI_TOOL" --value "$_ai_tool_val"
            log_info "Updated AI_TOOL in config: $_ai_tool_val"
            break
          fi
          _project_dir="$(dirname "$_project_dir")"
        done

        if [[ "$FORMAT" == "json" ]]; then
          echo "{\"logged_in\": true, \"tool\": \"codex\", \"slot\": \"$slot\", \"slot_kind\": $(json_string_or_null "$kind"), \"provider_id\": $(json_string_or_null "$provider_id"), \"auth_email\": $(json_string_or_null "$account"), \"account\": $(json_string_or_null "$account"), \"saved\": true}"
        fi
      fi
      ;;
    iflow)
      tool_login_generic "$tool"
      log_info "iflow auth material still comes from environment/config; slot container created for scheduler compatibility."
      ;;
    kiro-cli|cc|cc-use-codex-cli|opencode|claude)
      # If no auth_mode given → prompt interactively (like codex)
      if [[ -z "$auth_mode" ]]; then
        auth_mode="$(_prompt_generic_login_mode "$tool")"
      fi
      # Route to the right handler
      if [[ "$auth_mode" == "apikey" ]]; then
        _require_acp_binary "$tool" || exit 1
        _login_apikey_alias "$tool"
      elif [[ "$auth_mode" == "account" ]]; then
        _login_account_slot "$tool"
      else
        log_error "Unsupported auth mode for $tool: $auth_mode (use: account, apikey)"
        exit 2
      fi
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

