#!/usr/bin/env bash
set -euo pipefail

# AI CLI Slot Manager
# Usage: freely ai <command> [options]

# 配置
AUTH_DIR="$HOME/.ai-auth"
CONFIG_FILE="$HOME/.config/freely/ai-cli-profiles.yaml"
SELF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"

# 全局选项
YES_MODE=false
FORMAT="text"
QUIET=false
DRY_RUN=false

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 工具函数
log_info() {
  [[ "$QUIET" == "true" ]] && return
  echo -e "${GREEN}[INFO]${NC} $1"
}

log_error() {
  echo -e "${RED}[ERROR]${NC} $1" >&2
}

log_warn() {
  [[ "$QUIET" == "true" ]] && return
  echo -e "${YELLOW}[WARN]${NC} $1"
}

# 确认操作
confirm() {
  local msg="$1"
  [[ "$YES_MODE" == "true" ]] && return 0
  read -r -p "$msg [y/N] " response
  [[ "$response" =~ ^[Yy]$ ]]
}

auth_slot_prefix() {
  local tool="$1"
  printf '%s\n' "$AUTH_DIR/${tool}-"
}

auth_slot_dir() {
  local tool="$1" slot="$2"
  printf '%s\n' "$(auth_slot_prefix "$tool")$slot"
}

list_tool_slots() {
  local tool="$1" prefix
  prefix="$(basename "$(auth_slot_prefix "$tool")")"
  ls -1 "$AUTH_DIR" 2>/dev/null | grep "^${prefix}" | sed "s/^${prefix}//" || true
}

tool_active_slot_file() {
  local tool="$1"
  printf '%s\n' "$AUTH_DIR/.${tool}-current-slot"
}

read_tool_active_slot() {
  local tool="$1" file
  file="$(tool_active_slot_file "$tool")"
  if [[ -f "$file" ]]; then
    tr -d '\n' <"$file"
    return 0
  fi
  if [[ "$tool" == "codex" ]]; then
    read_codex_active_slot
  fi
}

write_tool_active_slot() {
  local tool="$1" slot="$2" file
  file="$(tool_active_slot_file "$tool")"
  mkdir -p "$(dirname "$file")"
  printf '%s\n' "$slot" >"$file"
  if [[ "$tool" == "codex" ]]; then
    write_codex_active_slot "$slot"
  fi
}

clear_tool_active_slot() {
  local tool="$1"
  rm -f "$(tool_active_slot_file "$tool")"
  if [[ "$tool" == "codex" ]]; then
    rm -f "$(codex_active_slot_file)"
  fi
}

codex_active_slot_file() {
  printf '%s\n' "$HOME/.codex/active-slot"
}

read_codex_active_slot() {
  local file
  file="$(codex_active_slot_file)"
  [[ -f "$file" ]] || return 0
  tr -d '\n' <"$file"
}

write_codex_active_slot() {
  local slot="$1"
  local file
  file="$(codex_active_slot_file)"
  mkdir -p "$(dirname "$file")"
  printf '%s\n' "$slot" >"$file"
}

format_epoch_local() {
  local epoch="$1"
  [[ -n "$epoch" ]] || return 1
  date -r "$epoch" '+%Y.%m.%d %H:%M:%S %Z' 2>/dev/null || date -d "@$epoch" '+%Y.%m.%d %H:%M:%S %Z' 2>/dev/null || printf '%s\n' "$epoch"
}

notify_freely_auth_change() {
  local tool="$1" slot="${2:-}" reason="${3:-auth_change}"
  local freely_bin
  [[ "${AI_CLI_SUPPRESS_AUTH_CHANGE_WAKE:-0}" == "1" ]] && return 0
  freely_bin="${FREELY_AUTH_CHANGE_WAKE_BIN:-$SELF_ROOT/bin/freely}"
  [[ -x "$freely_bin" ]] || return 0
  case "${AI_CLI_AUTH_CHANGE_WAKE_MODE:-async}" in
    sync)
      "$freely_bin" auth-change-wake --tool "$tool" --slot "$slot" --reason "$reason" >/dev/null 2>&1 || true
      ;;
    off|disabled)
      return 0
      ;;
    *)
      "$freely_bin" auth-change-wake --tool "$tool" --slot "$slot" --reason "$reason" >/dev/null 2>&1 </dev/null &
      disown || true
      ;;
  esac
}

codex_switch_lock_dir() {
  printf '%s\n' "${AI_CLI_SWITCH_LOCK_DIR:-$HOME/.codex/slot-switch.lock}"
}

codex_switch_lock_state_file() {
  printf '%s\n' "$(codex_switch_lock_dir)/state.env"
}

codex_switch_lock_owner_pid() {
  local state_file
  state_file="$(codex_switch_lock_state_file)"
  [[ -f "$state_file" ]] || return 0
  sed -n 's/^owner_pid=//p' "$state_file" | tail -n 1
}

codex_switch_lock_cleanup_if_stale() {
  local lock_dir owner_pid
  lock_dir="$(codex_switch_lock_dir)"
  [[ -d "$lock_dir" ]] || return 0
  owner_pid="$(codex_switch_lock_owner_pid)"
  if [[ -z "$owner_pid" ]] || ! kill -0 "$owner_pid" 2>/dev/null; then
    rm -rf "$lock_dir"
  fi
}

codex_switch_lock_acquire() {
  local reason="$1" command_name="${2:-switch}" target="${3:-}"
  local lock_dir state_file timeout_secs start_ts now owner_pid inherited_owner_pid
  lock_dir="$(codex_switch_lock_dir)"
  state_file="$(codex_switch_lock_state_file)"
  inherited_owner_pid="${AI_CLI_SWITCH_LOCK_OWNER_PID:-}"
  timeout_secs="${AI_CLI_SWITCH_LOCK_WAIT_SECS:-60}"
  [[ "$timeout_secs" =~ ^[0-9]+$ ]] || timeout_secs=60
  mkdir -p "$(dirname "$lock_dir")"
  start_ts="$(date +%s)"

  while true; do
    codex_switch_lock_cleanup_if_stale
    if mkdir "$lock_dir" 2>/dev/null; then
      cat >"$state_file" <<EOF
owner_pid=$$
started_at=$(date +%s)
reason=$reason
command=$command_name
target=$target
EOF
      export AI_CLI_SWITCH_LOCK_OWNER_PID="$$"
      return 0
    fi

    owner_pid="$(codex_switch_lock_owner_pid)"
    if [[ -n "$owner_pid" && ( "$owner_pid" == "$$" || ( -n "$inherited_owner_pid" && "$owner_pid" == "$inherited_owner_pid" ) ) ]]; then
      export AI_CLI_SWITCH_LOCK_OWNER_PID="$owner_pid"
      return 0
    fi

    now="$(date +%s)"
    if (( now - start_ts >= timeout_secs )); then
      log_error "timed out waiting for an existing codex slot switch to finish"
      return 1
    fi
    sleep 1
  done
}

codex_switch_lock_release() {
  local lock_dir owner_pid inherited_owner_pid
  lock_dir="$(codex_switch_lock_dir)"
  [[ -d "$lock_dir" ]] || return 0
  owner_pid="$(codex_switch_lock_owner_pid)"
  inherited_owner_pid="${AI_CLI_SWITCH_LOCK_OWNER_PID:-}"
  if [[ -z "$owner_pid" || "$owner_pid" == "$$" ]]; then
    rm -rf "$lock_dir"
  elif [[ -n "$inherited_owner_pid" && "$owner_pid" == "$inherited_owner_pid" && "$$" == "$inherited_owner_pid" ]]; then
    rm -rf "$lock_dir"
  fi
}

codex_switch_lock_wait_for_idle() {
  local timeout_secs="${AI_CLI_SWITCH_LOCK_WAIT_SECS:-60}"
  local lock_dir start_ts now owner_pid inherited_owner_pid
  lock_dir="$(codex_switch_lock_dir)"
  inherited_owner_pid="${AI_CLI_SWITCH_LOCK_OWNER_PID:-}"
  [[ "$timeout_secs" =~ ^[0-9]+$ ]] || timeout_secs=60
  start_ts="$(date +%s)"

  while true; do
    codex_switch_lock_cleanup_if_stale
    [[ -d "$lock_dir" ]] || return 0
    owner_pid="$(codex_switch_lock_owner_pid)"
    if [[ -n "$owner_pid" && ( "$owner_pid" == "$$" || ( -n "$inherited_owner_pid" && "$owner_pid" == "$inherited_owner_pid" ) ) ]]; then
      return 0
    fi
    now="$(date +%s)"
    if (( now - start_ts >= timeout_secs )); then
      log_error "timed out waiting for an existing codex slot switch to finish"
      return 1
    fi
    sleep 1
  done
}

json_string_or_null() {
  local value="${1:-}"
  if [[ -n "$value" ]]; then
    printf '"%s"' "$value"
  else
    printf 'null'
  fi
}

next_slot_name() {
  local tool="$1" base="$2"
  local slot="${base}-1" i=2
  while [[ -d "$(auth_slot_dir "$tool" "$slot")" ]]; do
    slot="${base}-${i}"
    ((i++))
  done
  printf '%s\n' "$slot"
}

resolve_codex_slot_name() {
  local auth_file="$1" requested_slot="${2:-}"
  local account base_slot
  if [[ -n "$requested_slot" ]]; then
    printf '%s\n' "$requested_slot"
    return 0
  fi
  account="$(extract_codex_account "$auth_file")"
  [[ -n "$account" ]] || return 1
  base_slot="$(printf '%s' "$account" | sed 's/\./-/g')"
  next_slot_name "codex" "$base_slot"
}

json_string_or_null() {
  local value="${1-}"
  if [[ -z "${value}" ]]; then
    printf 'null'
  else
    python3 - <<'PY' "$value"
import json
import sys
print(json.dumps(sys.argv[1]))
PY
  fi
}

# 从 auth.json 提取账号信息
extract_codex_account() {
  local auth_file="$1"
  local email=""
  
  if command -v python3 &>/dev/null; then
    email=$(python3 -c "
import json, sys, base64
try:
    data = json.load(open('$auth_file'))
    id_token = data.get('tokens', {}).get('id_token', '')
    if id_token:
        payload = id_token.split('.')[1]
        payload += '=' * (4 - len(payload) % 4)
        decoded = base64.urlsafe_b64decode(payload)
        claims = json.loads(decoded)
        print(claims.get('email', ''))
except:
    pass
" 2>/dev/null)
  fi
  
  echo "$email"
}

# 初始化
cmd_init() {
  mkdir -p "$AUTH_DIR"
  chmod 700 "$AUTH_DIR"
  mkdir -p "$(dirname "$CONFIG_FILE")"
  mkdir -p "$HOME/.codex"
  
  if [[ ! -f "$CONFIG_FILE" ]]; then
    cat > "$CONFIG_FILE" << EOF
version: 1
default_tool: codex
tools:
  codex:
    method: copy_auth
    active: ""
    accounts: {}
  iflow:
    method: env_var
    active: ""
    accounts: {}
EOF
    log_info "Created config: $CONFIG_FILE"
  fi
  
  log_info "Initialized AI CLI slot manager"
  log_info "Auth directory: $AUTH_DIR"
}

tool_default_singleton_slot() {
  printf 'default-1\n'
}

ensure_tool_singleton_slot_dir() {
  local tool="$1" slot target_dir
  slot="$(tool_default_singleton_slot)"
  target_dir="$(auth_slot_dir "$tool" "$slot")"
  [[ -d "$target_dir" ]] || mkdir -p "$target_dir"
  printf '%s\n' "$slot"
}

first_tool_slot_or_singleton() {
  local tool="$1" first_slot
  first_slot="$(list_tool_slots "$tool" | head -n 1)"
  if [[ -n "$first_slot" ]]; then
    printf '%s\n' "$first_slot"
    return 0
  fi
  ensure_tool_singleton_slot_dir "$tool"
}

tool_switch_direct_generic() {
  local tool="$1" slot="$2" target_dir
  target_dir="$(auth_slot_dir "$tool" "$slot")"
  if [[ ! -d "$target_dir" ]]; then
    log_error "Slot '$slot' not found for $tool"
    log_info "Available: $(list_tool_slots "$tool" | tr '\n' ' ')"
    exit 4
  fi
  [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would switch $tool to $slot"; return 0; }
  write_tool_active_slot "$tool" "$slot"
  log_info "Switched $tool to slot: $slot"
  if [[ "$FORMAT" == "json" ]]; then
    echo "{\"switched\": true, \"tool\": \"$tool\", \"slot\": \"$slot\", \"auth_email\": null, \"account\": null}"
  fi
}

tool_switch_auto_generic() {
  local tool="$1" slot
  slot="$(read_tool_active_slot "$tool")"
  [[ -n "$slot" ]] || slot="$(first_tool_slot_or_singleton "$tool")"
  tool_switch_direct_generic "$tool" "$slot"
}

tool_login_generic() {
  local tool="$1" slot target_dir
  slot="$(first_tool_slot_or_singleton "$tool")"
  target_dir="$(auth_slot_dir "$tool" "$slot")"
  [[ "$DRY_RUN" == "true" ]] && {
    log_info "[DRY-RUN] Would create $tool slot container at $target_dir"
    return 0
  }
  mkdir -p "$target_dir"
  write_tool_active_slot "$tool" "$slot"
  log_info "Created $tool slot container: $slot"
  log_info "Location: $target_dir"
  if [[ "$FORMAT" == "json" ]]; then
    echo "{\"logged_in\": false, \"tool\": \"$tool\", \"slot\": \"$slot\", \"auth_email\": null, \"account\": null, \"saved\": false, \"path\": \"$target_dir\"}"
  fi
}

tool_save_generic() {
  local tool="$1" slot="${2:-}" target_dir
  if [[ -n "$slot" ]]; then
    target_dir="$(auth_slot_dir "$tool" "$slot")"
  else
    slot="$(read_tool_active_slot "$tool")"
    [[ -n "$slot" ]] || slot="$(first_tool_slot_or_singleton "$tool")"
    target_dir="$(auth_slot_dir "$tool" "$slot")"
  fi
  [[ "$DRY_RUN" == "true" ]] && {
    log_info "[DRY-RUN] Would save $tool slot container at $target_dir"
    return 0
  }
  mkdir -p "$target_dir"
  write_tool_active_slot "$tool" "$slot"
  log_info "Saved $tool slot container: $slot"
  log_info "Location: $target_dir"
  if [[ "$FORMAT" == "json" ]]; then
    echo "{\"saved\": true, \"tool\": \"$tool\", \"slot\": \"$slot\", \"auth_email\": null, \"account\": null, \"path\": \"$target_dir\"}"
  fi
}

# 登录
cmd_login() {
  local tool="$1"
  
  case "$tool" in
    codex)
      log_info "Launching codex login..."
      codex login
      
      # 登录成功后自动保存
      if [[ -f "$HOME/.codex/auth.json" ]]; then
        local account=$(extract_codex_account "$HOME/.codex/auth.json")
        if [[ -n "$account" ]]; then
          local slot
          slot="$(resolve_codex_slot_name "$HOME/.codex/auth.json")"
          local target_dir
          target_dir="$(auth_slot_dir "codex" "$slot")"
          mkdir -p "$target_dir"
          cp "$HOME/.codex/auth.json" "$target_dir/"
          chmod 600 "$target_dir/auth.json"
          write_tool_active_slot "codex" "$slot"
          log_info "Auto-saved auth email: $account"
          log_info "Slot: $slot"
          log_info "Location: $target_dir"
          notify_freely_auth_change "codex" "$slot" "login_success"
          
          if [[ "$FORMAT" == "json" ]]; then
            echo "{\"logged_in\": true, \"tool\": \"codex\", \"slot\": \"$slot\", \"auth_email\": \"$account\", \"account\": \"$account\", \"saved\": true}"
          fi
        fi
      fi
      ;;
    iflow)
      tool_login_generic "$tool"
      log_info "iflow auth material still comes from environment/config; slot container created for scheduler compatibility."
      ;;
    kiro-cli|cc|cc-use-codex-cli|opencode)
      tool_login_generic "$tool"
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 保存当前登录
cmd_save() {
  local tool="$1"
  local slot="${2:-}"
  local explicit_slot_arg="$slot"
  
  case "$tool" in
    codex)
      local auth_file="$HOME/.codex/auth.json"
      if [[ ! -f "$auth_file" ]]; then
        log_error "No codex auth found. Run 'freely ai login codex' first."
        exit 3
      fi

      local actual_account
      actual_account="$(extract_codex_account "$auth_file")"

      if [[ -z "$slot" && -z "$actual_account" ]]; then
        log_error "Cannot extract account from auth.json. Please specify slot name."
          log_info "Usage: freely ai save codex <slot>"
          exit 2
      fi

      if [[ -n "$actual_account" ]]; then
        log_info "Detected auth email: $actual_account"
      fi

      slot="$(resolve_codex_slot_name "$auth_file" "$slot")"
      local target_dir
      target_dir="$(auth_slot_dir "codex" "$slot")"

      if [[ -n "$explicit_slot_arg" ]] && [[ -d "$target_dir" ]] && [[ "$YES_MODE" != "true" ]]; then
        confirm "Slot '$slot' exists. Overwrite?" || exit 1
      fi

      [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would save to $target_dir"; return; }

      mkdir -p "$target_dir"
      cp "$auth_file" "$target_dir/"
      chmod 600 "$target_dir/auth.json"
      write_tool_active_slot "codex" "$slot"

      log_info "Saved codex slot: $slot"
      [[ -n "$actual_account" ]] && log_info "Slot auth email: $actual_account"
      log_info "Slot: $slot"
      log_info "Location: $target_dir"

      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"saved\": true, \"tool\": \"codex\", \"slot\": \"$slot\", \"auth_email\": $(json_string_or_null "$actual_account"), \"account\": $(json_string_or_null "$actual_account"), \"path\": \"$target_dir\"}"
      fi
      ;;
    iflow)
      tool_save_generic "$tool" "$slot"
      log_info "iflow auth material still comes from environment/config; saved slot container for scheduler compatibility."
      ;;
    kiro-cli|cc|cc-use-codex-cli|opencode)
      tool_save_generic "$tool" "$slot"
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 同步当前 auth.json 到对应备份目录
sync_current_auth() {
  local tool="$1"
  local auth_file="$HOME/.codex/auth.json"
  
  if [[ ! -f "$auth_file" ]]; then
    return 0
  fi
  
  local current_slot
  current_slot="$(read_tool_active_slot "$tool")"
  if [[ -z "$current_slot" ]]; then
    return 0
  fi

  local backup_dir
  backup_dir="$(auth_slot_dir "$tool" "$current_slot")"

  # 只在当前活跃槽位已存在时同步，避免创建意外槽位
  if [[ -d "$backup_dir" ]]; then
    cp "$auth_file" "$backup_dir/"
    chmod 600 "$backup_dir/auth.json"
    log_info "Auto-synced current token to slot: $current_slot"
  fi
}

# 切换 slot
# Usage:
#   switch <tool> <slot>  - 切换到指定 slot
#   switch <tool>         - 自动探测，切换到可用的或最早恢复的
cmd_switch() {
  local tool="$1"
  local slot="${2:-}"
  local rc=0

  case "$tool" in
    codex)
      # 如果没有指定 slot，自动探测
      if [[ -z "$slot" ]]; then
        _cmd_switch_auto_codex
        rc=$?
        return "$rc"
      fi
      codex_switch_lock_acquire "explicit_switch" "switch" "$slot" || exit 1
      _cmd_switch_codex_direct_unlocked "$tool" "$slot"
      rc=$?
      codex_switch_lock_release
      if [[ "$rc" -eq 0 ]]; then
        notify_freely_auth_change "codex" "$slot" "switch_success"
      fi
      return "$rc"
      ;;
    iflow|kiro-cli|cc|cc-use-codex-cli|opencode)
      if [[ -z "$slot" ]]; then
        tool_switch_auto_generic "$tool"
      else
        tool_switch_direct_generic "$tool" "$slot"
      fi
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 自动探测并切换 codex slot
run_dir_for_project() {
  local project="$1"
  printf '%s\n' "$project/.freely/run"
}

codex_availability_cache_file() {
  local project="$1"
  printf '%s\n' "$(run_dir_for_project "$project")/codex-availability-cache.tsv"
}

codex_slot_cooldown_file() {
  local project="$1"
  printf '%s\n' "$(run_dir_for_project "$project")/codex-slot-cooldowns.tsv"
}

ai_cli_bin_for_project() {
  local project="$1"
  if [[ -x "$project/bin/ai" ]]; then
    printf '%s\n' "$project/bin/ai"
    return 0
  fi
  printf '%s\n' "$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)/bin/ai"
}

source_watchdog_script_or_fail() {
  local project="$1"
  local watchdog_script=""
  if [[ -f "$project/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh" ]]; then
    watchdog_script="$project/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"
  elif [[ -f "$(dirname "$0")/../docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh" ]]; then
    watchdog_script="$(dirname "$0")/../docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"
  fi

  if [[ -z "$watchdog_script" ]]; then
    log_error "Cannot find availability-watchdog.sh"
    exit 3
  fi

  # shellcheck source=/dev/null
  source "$watchdog_script"
}

_cmd_switch_auto_codex() {
  local project="${PROJECT_ROOT:-$(pwd)}"
  local tool="codex"
  local actual_account=""
  local result rc=0 notified_slot=""

  codex_switch_lock_acquire "auto_probe_switch" "switch" "auto" || exit 1
  source_watchdog_script_or_fail "$project"

  result="$(codex_inventory_truth "$project" "refresh" || true)"
  case "$result" in
    oauth_unreachable)
      if freely_network_proxy_has_effective_explicit_config "$project"; then
        log_error "OAuth inventory refresh failed even though Freely proxy config is explicit. Check the configured proxy endpoint and network reachability."
      else
        log_error "OAuth inventory refresh failed before any slot could be classified. Configure proxy settings in $project/.freely/config.env or \$FREELY_HOME/config.env instead of relying on an outer shell."
      fi
      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"switched\": false, \"tool\": \"codex\", \"status\": \"oauth_unreachable\", \"launch_blocked\": true}"
      fi
      codex_switch_lock_release
      return 5
      ;;
    none)
      result="$(probe_all_codex_slots_and_update_cooldown "$project" || true)"
      ;;
  esac

  case "$result" in
    usable:*)
      local slot="${result#usable:}"
      echo -e "${GREEN}[SWITCHED]${NC} -> $slot (usable)"
      _cmd_switch_codex_direct_unlocked "$tool" "$slot"
      notified_slot="$slot"
      actual_account="$(extract_codex_account "$HOME/.codex/auth.json")"
      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"switched\": true, \"tool\": \"codex\", \"account\": $(json_string_or_null "$actual_account"), \"slot\": \"$slot\", \"status\": \"usable\"}"
      fi
      ;;
    all_unavailable:*)
      local info="${result#all_unavailable:}"
      local earliest_slot="${info%%|*}"
      local reset_at="${info##*|}"
      local human_time
      human_time="$(format_epoch_local "$reset_at")"
      log_warn "No usable codex slot right now; leaving current auth untouched and keeping launch blocked. Earliest reset hint: $earliest_slot at $human_time"
      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"switched\": false, \"tool\": \"codex\", \"status\": \"all_unavailable\", \"earliest_slot\": $(json_string_or_null "$earliest_slot"), \"reset_at\": $reset_at, \"reset_at_human\": \"$human_time\", \"launch_blocked\": true}"
      fi
      rc=4
      ;;
    none)
      log_error "No slots found or all probing failed"
      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"switched\": false, \"status\": \"none\"}"
      fi
      rc=4
      ;;
    *)
      log_error "Unknown result: $result"
      rc=1
      ;;
  esac
  codex_switch_lock_release
  if [[ "$rc" -eq 0 && -n "$notified_slot" ]]; then
    notify_freely_auth_change "codex" "$notified_slot" "switch_success"
  fi
  return "$rc"
}

# 实际执行切换（不包含探测逻辑），由上层决定是否持有全局切号锁。
_cmd_switch_codex_direct_unlocked() {
  local tool="$1" slot="$2"
  local source_dir target_file switched_account
  source_dir="$(auth_slot_dir "codex" "$slot")"
  target_file="$HOME/.codex/auth.json"
  switched_account=""

  if [[ ! -d "$source_dir" ]]; then
    log_error "Slot '$slot' not found"
    log_info "Available: $(list_tool_slots "codex" | tr '\n' ' ')"
    exit 4
  fi

  if [[ -f "$target_file" ]]; then
    sync_current_auth "$tool"
  fi

  [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would switch to $slot"; return; }

  cp "$source_dir/auth.json" "$target_file"
  switched_account="$(extract_codex_account "$target_file")"
  if [[ -z "$switched_account" ]]; then
    log_error "Switch copied auth.json but could not verify the active codex slot auth"
    exit 5
  fi

  write_tool_active_slot "codex" "$slot"
  log_info "Switched codex to slot: $slot"
  log_info "Switched codex auth email: $switched_account"
  log_warn "Restart codex for the change to take effect"

  if [[ "$FORMAT" == "json" ]]; then
    echo "{\"switched\": true, \"tool\": \"codex\", \"slot\": \"$slot\", \"auth_email\": \"$switched_account\", \"account\": \"$switched_account\"}"
  fi
}

# 列出 slots
cmd_list() {
  local tool="${1:-codex}"
  local accounts=()
  if [[ "$tool" == "codex" ]]; then
    codex_switch_lock_wait_for_idle || exit 1
  fi
  
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    accounts+=("$tool-$line")
  done < <(list_tool_slots "$tool")
  
  if [[ ${#accounts[@]} -eq 0 ]]; then
    log_info "No slots found for $tool."
    return
  fi
  
  case "$FORMAT" in
    json)
      echo -n "{\"accounts\": ["
      local first=true
      for a in "${accounts[@]}"; do
        [[ "$first" == "true" ]] && first=false || echo -n ", "
        echo -n "\"$a\""
      done
      echo "]}"
      ;;
    *)
      for a in "${accounts[@]}"; do
        echo "  $a"
      done
      ;;
  esac
}

# 显示当前 slot
cmd_whoami() {
  local tool="${1:-codex}"
  
  case "$tool" in
    codex)
      codex_switch_lock_wait_for_idle || exit 1
      local auth_file="$HOME/.codex/auth.json"
      local slot=""
      if [[ ! -f "$auth_file" ]]; then
        case "$FORMAT" in
          json) echo "{\"tool\": \"codex\", \"slot\": null, \"auth_email\": null, \"account\": null}" ;;
          *) log_warn "Not logged in" ;;
        esac
        exit 0
      fi
      
      local account=$(extract_codex_account "$auth_file")
      slot="$(read_tool_active_slot "codex")"
      if [[ -z "$account" ]]; then
        case "$FORMAT" in
          json) echo "{\"tool\": \"codex\", \"slot\": $(json_string_or_null "$slot"), \"auth_email\": null, \"account\": null}" ;;
          *) [[ -n "$slot" ]] && log_info "Current slot: $slot"; log_warn "Cannot determine auth email metadata" ;;
        esac
        exit 0
      fi
      
      case "$FORMAT" in
        json) echo "{\"tool\": \"codex\", \"slot\": $(json_string_or_null "$slot"), \"auth_email\": \"$account\", \"account\": \"$account\"}" ;;
        *)
          [[ -n "$slot" ]] && log_info "Current slot: $slot"
          log_info "Current auth email: $account"
          ;;
      esac
      ;;
    iflow|kiro-cli|cc|cc-use-codex-cli|opencode)
      local slot=""
      slot="$(read_tool_active_slot "$tool")"
      case "$FORMAT" in
        json) echo "{\"tool\": \"$tool\", \"slot\": $(json_string_or_null "$slot"), \"auth_email\": null, \"account\": null}" ;;
        *)
          [[ -n "$slot" ]] && log_info "Current slot: $slot" || log_warn "No active slot selected for $tool"
          ;;
      esac
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 状态
cmd_status() {
  local tool="${1:-codex}"
  local project="${PROJECT_ROOT:-$(pwd)}"
  
  case "$tool" in
    codex)
      local auth_file="$HOME/.codex/auth.json"
      local cache_file=""
      source_watchdog_script_or_fail "$project"
      cache_file="$(codex_availability_cache_file "$project")"
      if ! codex_availability_cache_is_fresh "$project"; then
        codex_inventory_truth "$project" >/dev/null 2>&1 || true
      fi
      if [[ -f "$auth_file" ]]; then
        local mtime=$(stat -f "%Sm" "$auth_file" 2>/dev/null || stat -c "%y" "$auth_file" 2>/dev/null || echo "unknown")
        local account=$(extract_codex_account "$auth_file")
        local slot
        slot="$(read_tool_active_slot "codex")"
        local usable_count=""
        local limited_count=""
        local deactivated_count=""
        local unknown_count=""
        local cache_refreshed=""
        local earliest_slot=""
        local earliest_reset=""
        local earliest_reset_human=""
        if [[ -f "$cache_file" ]]; then
          usable_count="$(awk -F '\t' 'NR>1 && $2=="usable" {count++} END {print count+0}' "$cache_file")"
          limited_count="$(awk -F '\t' 'NR>1 && $2=="rate_limited" {count++} END {print count+0}' "$cache_file")"
          deactivated_count="$(awk -F '\t' 'NR>1 && $2=="deactivated_workspace" {count++} END {print count+0}' "$cache_file")"
          unknown_count="$(awk -F '\t' 'NR>1 && $2!="usable" && $2!="rate_limited" && $2!="deactivated_workspace" {count++} END {print count+0}' "$cache_file")"
          cache_refreshed="$(awk -F '\t' 'NR==2 {print $7}' "$cache_file")"
          read -r earliest_slot earliest_reset < <(awk -F '\t' '
            NR==1 {next}
            $2=="rate_limited" && $4 ~ /^[0-9]+$/ && $4 > 0 {
              if (best_reset == "" || $4 < best_reset) {
                best_slot = $1
                best_reset = $4
              }
            }
            END {
              print best_slot, best_reset
            }
          ' "$cache_file")
          if [[ -n "$earliest_reset" && "$earliest_reset" =~ ^[0-9]+$ && "$earliest_reset" -gt 0 ]]; then
            earliest_reset_human="$(format_epoch_local "$earliest_reset")"
          fi
        fi
        
        case "$FORMAT" in
          json)
            echo "{\"tool\": \"codex\", \"auth\": \"present\", \"slot\": $(json_string_or_null "$slot"), \"auth_email\": $(json_string_or_null "$account"), \"account\": $(json_string_or_null "$account"), \"last_modified\": \"$mtime\", \"availability_cache\": {\"present\": $([[ -f "$cache_file" ]] && printf true || printf false), \"usable\": ${usable_count:-0}, \"rate_limited\": ${limited_count:-0}, \"deactivated_workspace\": ${deactivated_count:-0}, \"other\": ${unknown_count:-0}, \"earliest_slot\": $(json_string_or_null "$earliest_slot"), \"earliest_reset_at\": ${earliest_reset:-0}, \"earliest_reset_human\": $(json_string_or_null "$earliest_reset_human"), \"refreshed_at\": $(json_string_or_null "$cache_refreshed")}}"
            ;;
          *)
            log_info "Tool: codex"
            log_info "Auth: present"
            [[ -n "$slot" ]] && log_info "Slot: $slot"
            log_info "Auth email: ${account:-unknown}"
            log_info "Last modified: $mtime"
            if [[ -f "$cache_file" ]]; then
              log_info "Recovery ledger: usable=${usable_count:-0} rate_limited=${limited_count:-0} deactivated_workspace=${deactivated_count:-0} other=${unknown_count:-0}"
              if [[ -n "$earliest_slot" && -n "$earliest_reset_human" ]]; then
                log_info "Earliest reset: ${earliest_slot} at ${earliest_reset_human}"
              fi
              [[ -n "$cache_refreshed" ]] && log_info "Availability cache refreshed: $cache_refreshed"
            fi
            ;;
        esac
      else
        case "$FORMAT" in
          json) echo "{\"tool\": \"codex\", \"auth\": \"missing\"}" ;;
          *) log_warn "No codex auth found" ;;
        esac
      fi
      ;;
    iflow|kiro-cli|cc|cc-use-codex-cli|opencode)
      local slot path
      slot="$(read_tool_active_slot "$tool")"
      path=""
      [[ -n "$slot" ]] && path="$(auth_slot_dir "$tool" "$slot")"
      case "$FORMAT" in
        json)
          echo "{\"tool\": \"$tool\", \"auth\": $(json_string_or_null "${slot:+slot_inventory}"), \"slot\": $(json_string_or_null "$slot"), \"path\": $(json_string_or_null "$path")}"
          ;;
        *)
          log_info "Tool: $tool"
          if [[ -n "$slot" ]]; then
            log_info "Slot: $slot"
            log_info "Path: $path"
          else
            log_warn "No active slot selected for $tool"
          fi
          ;;
      esac
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 删除 slot
cmd_delete() {
  local tool="$1"
  local slot="$2"
  local target_dir
  target_dir="$(auth_slot_dir "$tool" "$slot")"

  if [[ ! -d "$target_dir" ]]; then
    log_error "Slot '$slot' not found"
    exit 4
  fi

  confirm "Delete slot '$slot'?" || exit 1

  [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would delete $target_dir"; return; }

  rm -rf "$target_dir"
  if [[ "$(read_tool_active_slot "$tool")" == "$slot" ]]; then
    clear_tool_active_slot "$tool"
  fi
  log_info "Deleted slot: $slot"

  if [[ "$FORMAT" == "json" ]]; then
    echo "{\"deleted\": true, \"tool\": \"$tool\", \"slot\": \"$slot\"}"
  fi
}

# 帮助
show_help() {
  cat << EOF
Usage: freely ai <command> [options]

Commands:
  init                    Initialize slot manager
  login <tool>            Login and auto-save auth slot
  save <tool> [slot]      Save current login (auto-detect next slot if not specified)
  switch [tool] [slot]    Switch to slot. No slot = auto-probe and switch only to a usable slot
  list                    List all saved slots
  whoami [tool]           Show current logged-in slot
  status [tool]           Show current status
  delete <tool> <slot>    Delete a slot

Options:
  --yes, -y               Skip confirmations (non-interactive)
  --format FORMAT         Output format: text|json|yaml
  --quiet, -q             Quiet mode
  --dry-run               Simulate without changes

Exit codes:
  0 = success
  1 = general error
  2 = parameter error
  3 = auth error
  4 = not found

Examples:
  freely ai init
  freely ai login codex
  freely ai whoami
  freely ai switch codex                    # Refresh saved auth inventory, then switch if a slot is currently usable
  freely ai switch codex other@email-com-2  # Switch to specific slot
  freely ai switch other@email-com-2 --yes  # Switch to specific slot (default tool: codex)
  freely ai list --format json
EOF
}

# 主入口
main() {
  local COMMAND=""
  local ARGS=()
  
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) YES_MODE=true; shift ;;
      --format) FORMAT="$2"; shift 2 ;;
      --quiet|-q) QUIET=true; shift ;;
      --dry-run) DRY_RUN=true; shift ;;
      --help|-h) show_help; exit 0 ;;
      -*)
        log_error "Unknown option: $1"
        exit 2
        ;;
      *)
        if [[ -z "$COMMAND" ]]; then
          COMMAND="$1"
        else
          ARGS+=("$1")
        fi
        shift
        ;;
    esac
  done
  
  case "$COMMAND" in
    init) cmd_init ;;
    login) cmd_login "${ARGS[0]}" ;;
    save) cmd_save "${ARGS[0]}" "${ARGS[1]:-}" ;;
    switch)
      case "${ARGS[0]:-}" in
        codex|iflow|kiro-cli|cc|cc-use-codex-cli|opencode)
          cmd_switch "${ARGS[0]}" "${ARGS[1]:-}"
          ;;
        "")
          cmd_switch "codex" ""
          ;;
        *)
          log_warn "No ai tool name provided; defaulting to codex. If the target slot belongs to another tool, switch may fail."
          cmd_switch "codex" "${ARGS[0]}"
          ;;
      esac
      ;;
    list) cmd_list "${ARGS[0]:-codex}" ;;
    whoami) cmd_whoami "${ARGS[0]:-codex}" ;;
    status) cmd_status "${ARGS[0]:-codex}" ;;
    delete) cmd_delete "${ARGS[0]}" "${ARGS[1]}" ;;
    ""|--help|-h) show_help ;;
    *)
      log_error "Unknown command: $COMMAND"
      show_help
      exit 2
      ;;
  esac
}

main "$@"
