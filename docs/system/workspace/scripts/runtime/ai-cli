#!/usr/bin/env bash
set -euo pipefail

# AI CLI Slot Manager
# Usage: freely ai <command> [options]

# 配置
AUTH_DIR="$HOME/.ai-auth"
CONFIG_FILE="$HOME/.config/freely/ai-cli-profiles.yaml"
SELF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
FILE_BACKUP_LIB="$SELF_ROOT/docs/system/workspace/scripts/runtime/file-backup.sh"

[[ -f "$FILE_BACKUP_LIB" ]] || {
  echo "[ERROR] missing file backup helper: $FILE_BACKUP_LIB" >&2
  exit 1
}
source "$FILE_BACKUP_LIB"

# 全局选项
YES_MODE=false
FORMAT="text"
QUIET=false
DRY_RUN=false

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 工具函数
log_info() {
  [[ "$QUIET" == "true" ]] && return
  echo -e "${GREEN}[INFO]${NC} $1"
}

log_error() {
  echo -e "${RED}[ERROR]${NC} $1" >&2
}

log_warn() {
  [[ "$QUIET" == "true" ]] && return
  echo -e "${YELLOW}[WARN]${NC} $1"
}

# 确认操作
confirm() {
  local msg="$1"
  [[ "$YES_MODE" == "true" ]] && return 0
  read -r -p "$msg [y/N] " response
  [[ "$response" =~ ^[Yy]$ ]]
}

auth_slot_prefix() {
  local tool="$1"
  printf '%s\n' "$AUTH_DIR/${tool}-"
}

auth_slot_dir() {
  local tool="$1" slot="$2"
  printf '%s\n' "$(auth_slot_prefix "$tool")$slot"
}

list_tool_slots() {
  local tool="$1" prefix
  prefix="$(basename "$(auth_slot_prefix "$tool")")"
  ls -1 "$AUTH_DIR" 2>/dev/null | grep "^${prefix}" | sed "s/^${prefix}//" || true
}

tool_active_slot_file() {
  local tool="$1"
  printf '%s\n' "$AUTH_DIR/.${tool}-current-slot"
}

read_tool_active_slot() {
  local tool="$1" file
  file="$(tool_active_slot_file "$tool")"
  if [[ -f "$file" ]]; then
    tr -d '\n' <"$file"
    return 0
  fi
  if [[ "$tool" == "codex" ]]; then
    read_codex_active_slot
  fi
}

write_tool_active_slot() {
  local tool="$1" slot="$2" file
  file="$(tool_active_slot_file "$tool")"
  mkdir -p "$(dirname "$file")"
  printf '%s\n' "$slot" >"$file"
  if [[ "$tool" == "codex" ]]; then
    write_codex_active_slot "$slot"
  fi
}

clear_tool_active_slot() {
  local tool="$1"
  rm -f "$(tool_active_slot_file "$tool")"
  if [[ "$tool" == "codex" ]]; then
    rm -f "$(codex_active_slot_file)"
  fi
}

codex_active_slot_file() {
  printf '%s\n' "$HOME/.codex/active-slot"
}

read_codex_active_slot() {
  local file
  file="$(codex_active_slot_file)"
  [[ -f "$file" ]] || return 0
  tr -d '\n' <"$file"
}

write_codex_active_slot() {
  local slot="$1"
  local file
  file="$(codex_active_slot_file)"
  mkdir -p "$(dirname "$file")"
  printf '%s\n' "$slot" >"$file"
}

format_epoch_local() {
  local epoch="$1"
  [[ -n "$epoch" ]] || return 1
  date -r "$epoch" '+%Y.%m.%d %H:%M:%S %Z' 2>/dev/null || date -d "@$epoch" '+%Y.%m.%d %H:%M:%S %Z' 2>/dev/null || printf '%s\n' "$epoch"
}

format_timestamp_local() {
  local value="${1:-}" epoch=""
  [[ -n "$value" ]] || return 1
  case "$value" in
    unknown|unavailable|none) printf '%s\n' "$value"; return 0 ;;
  esac
  if [[ "$value" =~ ^[0-9]+$ ]]; then
    format_epoch_local "$value"
    return 0
  fi
  epoch="$(python3 - <<'PY' "$value" 2>/dev/null || true
from datetime import datetime
import sys

value = sys.argv[1]
if value.endswith("Z"):
    value = value[:-1] + "+00:00"
try:
    print(int(datetime.fromisoformat(value).timestamp()))
except Exception:
    pass
PY
)"
  if [[ -n "$epoch" ]]; then
    format_epoch_local "$epoch"
    return 0
  fi
  printf '%s\n' "$value"
}

notify_freely_auth_change() {
  local tool="$1" slot="${2:-}" reason="${3:-auth_change}"
  local freely_bin
  [[ "${AI_CLI_SUPPRESS_AUTH_CHANGE_WAKE:-0}" == "1" ]] && return 0
  freely_bin="${FREELY_AUTH_CHANGE_WAKE_BIN:-$SELF_ROOT/bin/freely}"
  [[ -x "$freely_bin" ]] || return 0
  case "${AI_CLI_AUTH_CHANGE_WAKE_MODE:-async}" in
    sync)
      "$freely_bin" auth-change-wake --tool "$tool" --slot "$slot" --reason "$reason" >/dev/null 2>&1 || true
      ;;
    off|disabled)
      return 0
      ;;
    *)
      "$freely_bin" auth-change-wake --tool "$tool" --slot "$slot" --reason "$reason" >/dev/null 2>&1 </dev/null &
      disown || true
      ;;
  esac
}

codex_switch_lock_dir() {
  printf '%s\n' "${AI_CLI_SWITCH_LOCK_DIR:-$HOME/.codex/slot-switch.lock}"
}

codex_switch_lock_state_file() {
  printf '%s\n' "$(codex_switch_lock_dir)/state.env"
}

codex_switch_lock_owner_pid() {
  local state_file
  state_file="$(codex_switch_lock_state_file)"
  [[ -f "$state_file" ]] || return 0
  sed -n 's/^owner_pid=//p' "$state_file" | tail -n 1
}

codex_switch_lock_cleanup_if_stale() {
  local lock_dir owner_pid
  lock_dir="$(codex_switch_lock_dir)"
  [[ -d "$lock_dir" ]] || return 0
  owner_pid="$(codex_switch_lock_owner_pid)"
  if [[ -z "$owner_pid" ]] || ! kill -0 "$owner_pid" 2>/dev/null; then
    rm -rf "$lock_dir"
  fi
}

codex_switch_lock_acquire() {
  local reason="$1" command_name="${2:-switch}" target="${3:-}"
  local lock_dir state_file timeout_secs start_ts now owner_pid inherited_owner_pid
  lock_dir="$(codex_switch_lock_dir)"
  state_file="$(codex_switch_lock_state_file)"
  inherited_owner_pid="${AI_CLI_SWITCH_LOCK_OWNER_PID:-}"
  timeout_secs="${AI_CLI_SWITCH_LOCK_WAIT_SECS:-60}"
  [[ "$timeout_secs" =~ ^[0-9]+$ ]] || timeout_secs=60
  mkdir -p "$(dirname "$lock_dir")"
  start_ts="$(date +%s)"

  while true; do
    codex_switch_lock_cleanup_if_stale
    if mkdir "$lock_dir" 2>/dev/null; then
      cat >"$state_file" <<EOF
owner_pid=$$
started_at=$(date +%s)
reason=$reason
command=$command_name
target=$target
EOF
      export AI_CLI_SWITCH_LOCK_OWNER_PID="$$"
      return 0
    fi

    owner_pid="$(codex_switch_lock_owner_pid)"
    if [[ -n "$owner_pid" && ( "$owner_pid" == "$$" || ( -n "$inherited_owner_pid" && "$owner_pid" == "$inherited_owner_pid" ) ) ]]; then
      export AI_CLI_SWITCH_LOCK_OWNER_PID="$owner_pid"
      return 0
    fi

    now="$(date +%s)"
    if (( now - start_ts >= timeout_secs )); then
      log_error "timed out waiting for an existing codex slot switch to finish"
      return 1
    fi
    sleep 1
  done
}

codex_switch_lock_release() {
  local lock_dir owner_pid inherited_owner_pid
  lock_dir="$(codex_switch_lock_dir)"
  [[ -d "$lock_dir" ]] || return 0
  owner_pid="$(codex_switch_lock_owner_pid)"
  inherited_owner_pid="${AI_CLI_SWITCH_LOCK_OWNER_PID:-}"
  if [[ -z "$owner_pid" || "$owner_pid" == "$$" ]]; then
    rm -rf "$lock_dir"
  elif [[ -n "$inherited_owner_pid" && "$owner_pid" == "$inherited_owner_pid" && "$$" == "$inherited_owner_pid" ]]; then
    rm -rf "$lock_dir"
  fi
}

codex_switch_lock_wait_for_idle() {
  local timeout_secs="${AI_CLI_SWITCH_LOCK_WAIT_SECS:-60}"
  local lock_dir start_ts now owner_pid inherited_owner_pid
  lock_dir="$(codex_switch_lock_dir)"
  inherited_owner_pid="${AI_CLI_SWITCH_LOCK_OWNER_PID:-}"
  [[ "$timeout_secs" =~ ^[0-9]+$ ]] || timeout_secs=60
  start_ts="$(date +%s)"

  while true; do
    codex_switch_lock_cleanup_if_stale
    [[ -d "$lock_dir" ]] || return 0
    owner_pid="$(codex_switch_lock_owner_pid)"
    if [[ -n "$owner_pid" && ( "$owner_pid" == "$$" || ( -n "$inherited_owner_pid" && "$owner_pid" == "$inherited_owner_pid" ) ) ]]; then
      return 0
    fi
    now="$(date +%s)"
    if (( now - start_ts >= timeout_secs )); then
      log_error "timed out waiting for an existing codex slot switch to finish"
      return 1
    fi
    sleep 1
  done
}

next_slot_name() {
  local tool="$1" base="$2"
  local slot="${base}-1" i=2
  while [[ -d "$(auth_slot_dir "$tool" "$slot")" ]]; do
    slot="${base}-${i}"
    ((i++))
  done
  printf '%s\n' "$slot"
}

resolve_codex_slot_name() {
  local auth_file="$1" requested_slot="${2:-}"
  local kind account provider_id base_slot
  if [[ -n "$requested_slot" ]]; then
    printf '%s\n' "$requested_slot"
    return 0
  fi
  kind="$(codex_live_auth_kind "$auth_file")"
  case "$kind" in
    apikey)
      provider_id="$(codex_live_provider_id)"
      [[ -n "$provider_id" ]] || provider_id="custom"
      base_slot="apikey-$(printf '%s' "$provider_id" | sed 's/[^A-Za-z0-9._-]/-/g; s/\./-/g')"
      ;;
    *)
      account="$(extract_codex_account "$auth_file")"
      [[ -n "$account" ]] || return 1
      base_slot="account-$(printf '%s' "$account" | sed 's/[^A-Za-z0-9._@-]/-/g; s/\./-/g')"
      ;;
  esac
  next_slot_name "codex" "$base_slot"
}

json_string_or_null() {
  local value="${1-}"
  if [[ -z "${value}" ]]; then
    printf 'null'
  else
    python3 - <<'PY' "$value"
import json
import sys
print(json.dumps(sys.argv[1]))
PY
  fi
}

# 从 auth.json 提取账号信息
extract_codex_account() {
  local auth_file="$1"
  local email=""
  
  if command -v python3 &>/dev/null; then
    email=$(python3 -c "
import json, sys, base64
try:
    data = json.load(open('$auth_file'))
    id_token = data.get('tokens', {}).get('id_token', '')
    if id_token:
        payload = id_token.split('.')[1]
        payload += '=' * (4 - len(payload) % 4)
        decoded = base64.urlsafe_b64decode(payload)
        claims = json.loads(decoded)
        print(claims.get('email', ''))
except:
    pass
" 2>/dev/null)
  fi
  
  echo "$email"
}

codex_live_auth_file() {
  printf '%s\n' "$HOME/.codex/auth.json"
}

codex_live_config_file() {
  printf '%s\n' "$HOME/.codex/config.toml"
}

codex_slot_manifest_file() {
  local slot="$1"
  printf '%s\n' "$(auth_slot_dir "codex" "$slot")/manifest.json"
}

codex_slot_config_fragment_file() {
  local slot="$1"
  printf '%s\n' "$(auth_slot_dir "codex" "$slot")/config-auth.toml"
}

codex_live_auth_kind() {
  local auth_file="$1"
  python3 - <<'PY' "$auth_file" 2>/dev/null || true
import json
import os
import sys

path = sys.argv[1]
if not os.path.exists(path):
    print("")
    raise SystemExit(0)
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)
if isinstance(data.get("OPENAI_API_KEY"), str) and data.get("OPENAI_API_KEY"):
    print("apikey")
elif isinstance(data.get("tokens"), dict) or isinstance(data.get("access_token"), str):
    print("account")
else:
    print("legacy")
PY
}

codex_live_provider_id() {
  local config_file
  config_file="$(codex_live_config_file)"
  python3 - <<'PY' "$config_file" 2>/dev/null || true
import os
import sys
import tomllib

path = sys.argv[1]
if not os.path.exists(path):
    print("")
    raise SystemExit(0)
with open(path, "rb") as f:
    data = tomllib.load(f)
value = data.get("model_provider", "")
print(value if isinstance(value, str) else "")
PY
}

codex_infer_slot_kind_from_slot() {
  local slot="${1:-}"
  case "$slot" in
    account-*) printf 'account\n' ;;
    apikey-*) printf 'apikey\n' ;;
    *) printf 'legacy\n' ;;
  esac
}

codex_saved_slot_kind() {
  local slot="$1"
  local manifest_file auth_file kind=""
  manifest_file="$(codex_slot_manifest_file "$slot")"
  if [[ -f "$manifest_file" ]]; then
    kind="$(python3 - <<'PY' "$manifest_file" 2>/dev/null || true
import json
import sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    data = json.load(f)
value = data.get("slot_kind", "")
print(value if isinstance(value, str) else "")
PY
)"
  fi
  if [[ -n "$kind" ]]; then
    printf '%s\n' "$kind"
    return 0
  fi
  kind="$(codex_infer_slot_kind_from_slot "$slot")"
  if [[ "$kind" != "legacy" ]]; then
    printf '%s\n' "$kind"
    return 0
  fi
  auth_file="$(auth_slot_dir "codex" "$slot")/auth.json"
  kind="$(codex_live_auth_kind "$auth_file")"
  [[ -n "$kind" ]] || kind="legacy"
  printf '%s\n' "$kind"
}

codex_saved_slot_provider_id() {
  local slot="$1" manifest_file
  manifest_file="$(codex_slot_manifest_file "$slot")"
  [[ -f "$manifest_file" ]] || return 0
  python3 - <<'PY' "$manifest_file" 2>/dev/null || true
import json
import sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    data = json.load(f)
value = data.get("provider_id", "")
print(value if isinstance(value, str) else "")
PY
}

codex_write_slot_manifest() {
  local slot="$1" slot_dir="$2" kind="$3" account="$4" provider_id="$5"
  python3 - <<'PY' "$slot_dir/manifest.json" "$slot" "$kind" "$account" "$provider_id"
import json
import os
import sys

path, slot, kind, account, provider_id = sys.argv[1:6]
payload = {
    "manifest_version": "codex-slot-v1",
    "tool": "codex",
    "slot_id": slot,
    "slot_kind": kind,
}
if account:
    payload["auth_email"] = account
if provider_id:
    payload["provider_id"] = provider_id
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "w", encoding="utf-8") as f:
    json.dump(payload, f, indent=2, sort_keys=True)
    f.write("\n")
PY
}

codex_write_fragment_toml_from_live_config() {
  local target_file="$1"
  local config_file
  config_file="$(codex_live_config_file)"
  python3 - <<'PY' "$config_file" "$target_file"
import json
import os
import sys
import tomllib

config_path, target_path = sys.argv[1:3]

def dump_value(value):
    if isinstance(value, str):
        return json.dumps(value)
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, list):
        return "[" + ", ".join(dump_value(item) for item in value) + "]"
    raise TypeError(type(value))

def render_key(key):
    if isinstance(key, str) and key and all(ch.isalnum() or ch in "-_" for ch in key):
        return key
    return json.dumps(key)

def render_path(path):
    return ".".join(render_key(segment) for segment in path)

def emit_table(lines, path, mapping):
    scalar_items = []
    table_items = []
    for key, value in mapping.items():
        if isinstance(value, dict):
            table_items.append((key, value))
        else:
            scalar_items.append((key, value))
    if path:
        lines.append(f"[{render_path(path)}]")
    for key, value in scalar_items:
        lines.append(f"{render_key(key)} = {dump_value(value)}")
    if scalar_items and table_items:
        lines.append("")
    for idx, (key, value) in enumerate(table_items):
        emit_table(lines, [*path, key], value)
        if idx != len(table_items) - 1:
            lines.append("")

fragment = {}
if os.path.exists(config_path) and os.path.getsize(config_path) > 0:
    with open(config_path, "rb") as f:
        data = tomllib.load(f)
    provider_id = data.get("model_provider")
    if isinstance(provider_id, str) and provider_id:
        fragment["model_provider"] = provider_id
        providers = data.get("model_providers", {})
        if isinstance(providers, dict) and isinstance(providers.get(provider_id), dict):
            fragment["model_providers"] = {provider_id: providers[provider_id]}
    preferred_auth_method = data.get("preferred_auth_method")
    if isinstance(preferred_auth_method, str) and preferred_auth_method:
        fragment["preferred_auth_method"] = preferred_auth_method

os.makedirs(os.path.dirname(target_path), exist_ok=True)
lines = []
emit_table(lines, [], fragment)
with open(target_path, "w", encoding="utf-8") as f:
    if lines:
        f.write("\n".join(lines).rstrip() + "\n")
PY
}

codex_apply_saved_slot_config_fragment() {
  local slot="$1"
  local live_config fragment_file slot_kind
  live_config="$(codex_live_config_file)"
  fragment_file="$(codex_slot_config_fragment_file "$slot")"
  slot_kind="$(codex_saved_slot_kind "$slot")"
  backup_file_with_timestamp "$live_config"
  python3 - <<'PY' "$live_config" "$fragment_file" "$slot_kind"
import json
import os
import sys
import tomllib

live_path, fragment_path, slot_kind = sys.argv[1:4]

def load_toml(path):
    if not os.path.exists(path) or os.path.getsize(path) == 0:
        return {}
    with open(path, "rb") as f:
        return tomllib.load(f)

def dump_value(value):
    if isinstance(value, str):
        return json.dumps(value)
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, list):
        return "[" + ", ".join(dump_value(item) for item in value) + "]"
    raise TypeError(type(value))

def render_key(key):
    if isinstance(key, str) and key and all(ch.isalnum() or ch in "-_" for ch in key):
        return key
    return json.dumps(key)

def render_path(path):
    return ".".join(render_key(segment) for segment in path)

def emit_table(lines, path, mapping):
    scalar_items = []
    table_items = []
    for key, value in mapping.items():
        if isinstance(value, dict):
            table_items.append((key, value))
        else:
            scalar_items.append((key, value))
    if path:
        lines.append(f"[{render_path(path)}]")
    for key, value in scalar_items:
        lines.append(f"{render_key(key)} = {dump_value(value)}")
    if scalar_items and table_items:
        lines.append("")
    for idx, (key, value) in enumerate(table_items):
        emit_table(lines, [*path, key], value)
        if idx != len(table_items) - 1:
            lines.append("")

data = load_toml(live_path)
previous_provider = data.get("model_provider") if isinstance(data.get("model_provider"), str) else ""
data.pop("model_provider", None)
data.pop("preferred_auth_method", None)
fragment = load_toml(fragment_path)
fragment_provider = fragment.get("model_provider") if isinstance(fragment.get("model_provider"), str) else ""
providers = data.get("model_providers")
if previous_provider and isinstance(providers, dict):
    if slot_kind != "apikey" or not fragment_provider or fragment_provider != previous_provider:
        providers.pop(previous_provider, None)
        if not providers:
            data.pop("model_providers", None)
for key in ("model_provider", "preferred_auth_method"):
    value = fragment.get(key)
    if isinstance(value, str) and value:
        data[key] = value
if isinstance(fragment.get("model_providers"), dict):
    existing = data.get("model_providers")
    if not isinstance(existing, dict):
        existing = {}
    for key, value in fragment["model_providers"].items():
        existing[key] = value
    if existing:
        data["model_providers"] = existing

os.makedirs(os.path.dirname(live_path), exist_ok=True)
lines = []
emit_table(lines, [], data)
with open(live_path, "w", encoding="utf-8") as f:
    f.write("\n".join(lines).rstrip() + ("\n" if lines else ""))
PY
}

codex_save_live_bundle_to_slot() {
  local slot="$1" target_dir="$2"
  local auth_file config_fragment kind account provider_id
  auth_file="$(codex_live_auth_file)"
  config_fragment="$target_dir/config-auth.toml"
  kind="$(codex_live_auth_kind "$auth_file")"
  account="$(extract_codex_account "$auth_file")"
  provider_id=""

  mkdir -p "$target_dir"
  cp "$auth_file" "$target_dir/"
  chmod 600 "$target_dir/auth.json"

  if [[ "$kind" == "apikey" ]]; then
    provider_id="$(codex_live_provider_id)"
    codex_write_fragment_toml_from_live_config "$config_fragment"
  else
    : >"$config_fragment"
  fi

  codex_write_slot_manifest "$slot" "$target_dir" "$kind" "$account" "$provider_id"
}

# 初始化
cmd_init() {
  mkdir -p "$AUTH_DIR"
  chmod 700 "$AUTH_DIR"
  mkdir -p "$(dirname "$CONFIG_FILE")"
  mkdir -p "$HOME/.codex"
  
  if [[ ! -f "$CONFIG_FILE" ]]; then
    cat > "$CONFIG_FILE" << EOF
version: 1
default_tool: codex
tools:
  codex:
    method: copy_auth
    active: ""
    accounts: {}
  iflow:
    method: env_var
    active: ""
    accounts: {}
EOF
    log_info "Created config: $CONFIG_FILE"
  fi
  
  log_info "Initialized AI CLI slot manager"
  log_info "Auth directory: $AUTH_DIR"
}

tool_default_singleton_slot() {
  printf 'default-1\n'
}

ensure_tool_singleton_slot_dir() {
  local tool="$1" slot target_dir
  slot="$(tool_default_singleton_slot)"
  target_dir="$(auth_slot_dir "$tool" "$slot")"
  [[ -d "$target_dir" ]] || mkdir -p "$target_dir"
  printf '%s\n' "$slot"
}

first_tool_slot_or_singleton() {
  local tool="$1" first_slot
  first_slot="$(list_tool_slots "$tool" | head -n 1)"
  if [[ -n "$first_slot" ]]; then
    printf '%s\n' "$first_slot"
    return 0
  fi
  ensure_tool_singleton_slot_dir "$tool"
}

tool_switch_direct_generic() {
  local tool="$1" slot="$2" target_dir
  target_dir="$(auth_slot_dir "$tool" "$slot")"
  if [[ ! -d "$target_dir" ]]; then
    log_error "Slot '$slot' not found for $tool"
    log_info "Available: $(list_tool_slots "$tool" | tr '\n' ' ')"
    exit 4
  fi
  [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would switch $tool to $slot"; return 0; }
  write_tool_active_slot "$tool" "$slot"
  log_info "Switched $tool to slot: $slot"
  if [[ "$FORMAT" == "json" ]]; then
    echo "{\"switched\": true, \"tool\": \"$tool\", \"slot\": \"$slot\", \"auth_email\": null, \"account\": null}"
  fi
}

tool_switch_auto_generic() {
  local tool="$1" slot
  slot="$(read_tool_active_slot "$tool")"
  [[ -n "$slot" ]] || slot="$(first_tool_slot_or_singleton "$tool")"
  tool_switch_direct_generic "$tool" "$slot"
}

tool_login_generic() {
  local tool="$1" slot target_dir
  slot="$(first_tool_slot_or_singleton "$tool")"
  target_dir="$(auth_slot_dir "$tool" "$slot")"
  [[ "$DRY_RUN" == "true" ]] && {
    log_info "[DRY-RUN] Would create $tool slot container at $target_dir"
    return 0
  }
  mkdir -p "$target_dir"
  write_tool_active_slot "$tool" "$slot"
  log_info "Created $tool slot container: $slot"
  log_info "Location: $target_dir"
  if [[ "$FORMAT" == "json" ]]; then
    echo "{\"logged_in\": false, \"tool\": \"$tool\", \"slot\": \"$slot\", \"auth_email\": null, \"account\": null, \"saved\": false, \"path\": \"$target_dir\"}"
  fi
}

tool_save_generic() {
  local tool="$1" slot="${2:-}" target_dir
  if [[ -n "$slot" ]]; then
    target_dir="$(auth_slot_dir "$tool" "$slot")"
  else
    slot="$(read_tool_active_slot "$tool")"
    [[ -n "$slot" ]] || slot="$(first_tool_slot_or_singleton "$tool")"
    target_dir="$(auth_slot_dir "$tool" "$slot")"
  fi
  [[ "$DRY_RUN" == "true" ]] && {
    log_info "[DRY-RUN] Would save $tool slot container at $target_dir"
    return 0
  }
  mkdir -p "$target_dir"
  write_tool_active_slot "$tool" "$slot"
  log_info "Saved $tool slot container: $slot"
  log_info "Location: $target_dir"
  if [[ "$FORMAT" == "json" ]]; then
    echo "{\"saved\": true, \"tool\": \"$tool\", \"slot\": \"$slot\", \"auth_email\": null, \"account\": null, \"path\": \"$target_dir\"}"
  fi
}

# 登录
cmd_login() {
  local tool="$1" auth_mode="${2:-}"
  
  case "$tool" in
    codex)
      if [[ "$auth_mode" == "apikey" ]]; then
        local auth_file
        auth_file="$(codex_live_auth_file)"
        if [[ ! -f "$auth_file" ]]; then
          log_error "No codex auth found. Configure Codex API-key mode first, then rerun 'freely ai login codex apikey'."
          exit 3
        fi
        cmd_save "codex"
        return 0
      fi

      log_info "Launching codex login..."
      codex login
      
      # 登录成功后自动保存
      if [[ -f "$(codex_live_auth_file)" ]]; then
        local auth_file slot target_dir account kind provider_id
        auth_file="$(codex_live_auth_file)"
        kind="$(codex_live_auth_kind "$auth_file")"
        slot="$(resolve_codex_slot_name "$auth_file")"
        target_dir="$(auth_slot_dir "codex" "$slot")"
        account="$(extract_codex_account "$auth_file")"
        provider_id="$(codex_live_provider_id)"
        codex_save_live_bundle_to_slot "$slot" "$target_dir"
        write_tool_active_slot "codex" "$slot"
        [[ -n "$account" ]] && log_info "Auto-saved auth email: $account"
        [[ -n "$provider_id" ]] && log_info "Provider: $provider_id"
        log_info "Slot kind: $kind"
        log_info "Slot: $slot"
        log_info "Location: $target_dir"
        notify_freely_auth_change "codex" "$slot" "login_success"

        if [[ "$FORMAT" == "json" ]]; then
          echo "{\"logged_in\": true, \"tool\": \"codex\", \"slot\": \"$slot\", \"slot_kind\": $(json_string_or_null "$kind"), \"provider_id\": $(json_string_or_null "$provider_id"), \"auth_email\": $(json_string_or_null "$account"), \"account\": $(json_string_or_null "$account"), \"saved\": true}"
        fi
      fi
      ;;
    iflow)
      tool_login_generic "$tool"
      log_info "iflow auth material still comes from environment/config; slot container created for scheduler compatibility."
      ;;
    kiro-cli|cc|cc-use-codex-cli|opencode)
      tool_login_generic "$tool"
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 保存当前登录
cmd_save() {
  local tool="$1"
  local slot="${2:-}"
  local explicit_slot_arg="$slot"
  
  case "$tool" in
    codex)
      local auth_file
      auth_file="$(codex_live_auth_file)"
      if [[ ! -f "$auth_file" ]]; then
        log_error "No codex auth found. Run 'freely ai login codex' first."
        exit 3
      fi

      local actual_account kind provider_id
      actual_account="$(extract_codex_account "$auth_file")"
      kind="$(codex_live_auth_kind "$auth_file")"
      provider_id="$(codex_live_provider_id)"

      if [[ -z "$slot" && -z "$actual_account" && "$kind" != "apikey" ]]; then
        log_error "Cannot derive Codex slot identity from current auth. Please specify slot name."
          log_info "Usage: freely ai save codex <slot>"
          exit 2
      fi

      if [[ -n "$actual_account" ]]; then
        log_info "Detected auth email: $actual_account"
      fi

      slot="$(resolve_codex_slot_name "$auth_file" "$slot")"
      local target_dir
      target_dir="$(auth_slot_dir "codex" "$slot")"

      if [[ -n "$explicit_slot_arg" ]] && [[ -d "$target_dir" ]] && [[ "$YES_MODE" != "true" ]]; then
        confirm "Slot '$slot' exists. Overwrite?" || exit 1
      fi

      [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would save to $target_dir"; return; }

      codex_save_live_bundle_to_slot "$slot" "$target_dir"
      write_tool_active_slot "codex" "$slot"

      log_info "Saved codex slot: $slot"
      log_info "Slot kind: $kind"
      [[ -n "$actual_account" ]] && log_info "Slot auth email: $actual_account"
      [[ -n "$provider_id" ]] && log_info "Provider: $provider_id"
      log_info "Slot: $slot"
      log_info "Location: $target_dir"

      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"saved\": true, \"tool\": \"codex\", \"slot\": \"$slot\", \"slot_kind\": $(json_string_or_null "$kind"), \"provider_id\": $(json_string_or_null "$provider_id"), \"auth_email\": $(json_string_or_null "$actual_account"), \"account\": $(json_string_or_null "$actual_account"), \"path\": \"$target_dir\"}"
      fi
      ;;
    iflow)
      tool_save_generic "$tool" "$slot"
      log_info "iflow auth material still comes from environment/config; saved slot container for scheduler compatibility."
      ;;
    kiro-cli|cc|cc-use-codex-cli|opencode)
      tool_save_generic "$tool" "$slot"
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 同步当前 auth.json 到对应备份目录
sync_current_auth() {
  local tool="$1"
  local auth_file
  auth_file="$(codex_live_auth_file)"
  
  if [[ ! -f "$auth_file" ]]; then
    return 0
  fi
  
  local current_slot
  current_slot="$(read_tool_active_slot "$tool")"
  if [[ -z "$current_slot" ]]; then
    return 0
  fi

  local backup_dir
  backup_dir="$(auth_slot_dir "$tool" "$current_slot")"

  # 只在当前活跃槽位已存在时同步，避免创建意外槽位
  if [[ -d "$backup_dir" ]]; then
    codex_save_live_bundle_to_slot "$current_slot" "$backup_dir"
    log_info "Auto-synced current token to slot: $current_slot"
  fi
}

# 切换 slot
# Usage:
#   switch <tool> <slot>  - 切换到指定 slot
#   switch <tool>         - 自动探测，切换到可用的或最早恢复的
cmd_switch() {
  local tool="$1"
  local slot="${2:-}"
  local rc=0

  case "$tool" in
    codex)
      # 如果没有指定 slot，自动探测
      if [[ -z "$slot" ]]; then
        _cmd_switch_auto_codex
        rc=$?
        return "$rc"
      fi
      codex_switch_lock_acquire "explicit_switch" "switch" "$slot" || exit 1
      _cmd_switch_codex_direct_unlocked "$tool" "$slot"
      rc=$?
      codex_switch_lock_release
      if [[ "$rc" -eq 0 ]]; then
        notify_freely_auth_change "codex" "$slot" "switch_success"
      fi
      return "$rc"
      ;;
    iflow|kiro-cli|cc|cc-use-codex-cli|opencode)
      if [[ -z "$slot" ]]; then
        tool_switch_auto_generic "$tool"
      else
        tool_switch_direct_generic "$tool" "$slot"
      fi
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 自动探测并切换 codex slot
run_dir_for_project() {
  local project="$1"
  printf '%s\n' "$project/.freely/run"
}

codex_availability_cache_file() {
  local project="$1"
  printf '%s\n' "$(run_dir_for_project "$project")/codex-availability-cache.tsv"
}

codex_slot_cooldown_file() {
  local project="$1"
  printf '%s\n' "$(run_dir_for_project "$project")/codex-slot-cooldowns.tsv"
}

ai_cli_bin_for_project() {
  local project="$1"
  if [[ -x "$project/bin/ai" ]]; then
    printf '%s\n' "$project/bin/ai"
    return 0
  fi
  printf '%s\n' "$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)/bin/ai"
}

source_watchdog_script_or_fail() {
  local project="$1"
  local watchdog_script=""
  if [[ -f "$project/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh" ]]; then
    watchdog_script="$project/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"
  elif [[ -f "$(dirname "$0")/../docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh" ]]; then
    watchdog_script="$(dirname "$0")/../docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"
  fi

  if [[ -z "$watchdog_script" ]]; then
    log_error "Cannot find availability-watchdog.sh"
    exit 3
  fi

  # shellcheck source=/dev/null
  source "$watchdog_script"
}

_cmd_switch_auto_codex() {
  local project="${PROJECT_ROOT:-$(pwd)}"
  local tool="codex"
  local actual_account="" switched_provider="" switched_kind=""
  local result rc=0 notified_slot=""

  codex_switch_lock_acquire "auto_probe_switch" "switch" "auto" || exit 1
  source_watchdog_script_or_fail "$project"

  result="$(codex_inventory_truth "$project" "refresh" || true)"
  case "$result" in
    oauth_unreachable)
      if codex_saved_slots_include_kind "$project" "apikey"; then
        log_warn "OAuth inventory refresh failed, but saved apikey slots exist; falling back to exec-only slot probing"
        result="$(probe_all_codex_slots_and_update_cooldown "$project" || true)"
      else
        if freely_network_proxy_has_effective_explicit_config "$project"; then
          log_error "OAuth inventory refresh failed even though Freely proxy config is explicit. Check the configured proxy endpoint and network reachability."
        else
          log_error "OAuth inventory refresh failed before any slot could be classified. Configure proxy settings in $project/.freely/config.env or \$FREELY_HOME/config.env instead of relying on an outer shell."
        fi
        if [[ "$FORMAT" == "json" ]]; then
          echo "{\"switched\": false, \"tool\": \"codex\", \"status\": \"oauth_unreachable\", \"launch_blocked\": true}"
        fi
        codex_switch_lock_release
        return 5
      fi
      ;;
    none)
      result="$(probe_all_codex_slots_and_update_cooldown "$project" || true)"
      ;;
  esac

  case "$result" in
    usable:*)
      local slot="${result#usable:}"
      _cmd_switch_codex_direct_unlocked "$tool" "$slot" "suppress_json"
      notified_slot="$slot"
      actual_account="$(extract_codex_account "$(codex_live_auth_file)")"
      switched_provider="$(codex_live_provider_id)"
      switched_kind="$(codex_saved_slot_kind "$slot")"
      [[ "$FORMAT" != "json" ]] && echo -e "${GREEN}[SWITCHED]${NC} -> $slot (usable)"
      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"switched\": true, \"tool\": \"codex\", \"slot\": \"$slot\", \"slot_kind\": $(json_string_or_null "$switched_kind"), \"provider_id\": $(json_string_or_null "$switched_provider"), \"auth_email\": $(json_string_or_null "$actual_account"), \"account\": $(json_string_or_null "$actual_account"), \"status\": \"usable\"}"
      fi
      ;;
    all_unavailable:*)
      local info="${result#all_unavailable:}"
      local earliest_slot="${info%%|*}"
      local reset_at="${info##*|}"
      local human_time
      human_time="$(format_epoch_local "$reset_at")"
      log_warn "No usable codex slot right now; leaving current auth untouched and keeping launch blocked. Earliest reset hint: $earliest_slot at $human_time"
      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"switched\": false, \"tool\": \"codex\", \"status\": \"all_unavailable\", \"earliest_slot\": $(json_string_or_null "$earliest_slot"), \"reset_at\": $reset_at, \"reset_at_human\": \"$human_time\", \"launch_blocked\": true}"
      fi
      rc=4
      ;;
    none)
      log_error "No slots found or all probing failed"
      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"switched\": false, \"status\": \"none\"}"
      fi
      rc=4
      ;;
    *)
      log_error "Unknown result: $result"
      rc=1
      ;;
  esac
  codex_switch_lock_release
  if [[ "$rc" -eq 0 && -n "$notified_slot" ]]; then
    notify_freely_auth_change "codex" "$notified_slot" "switch_success"
  fi
  return "$rc"
}

# 实际执行切换（不包含探测逻辑），由上层决定是否持有全局切号锁。
_cmd_switch_codex_direct_unlocked() {
  local tool="$1" slot="$2" suppress_json="${3:-}"
  local source_dir target_file switched_account switched_provider expected_kind actual_kind
  source_dir="$(auth_slot_dir "codex" "$slot")"
  target_file="$(codex_live_auth_file)"
  switched_account=""
  switched_provider=""
  expected_kind="$(codex_saved_slot_kind "$slot")"

  if [[ ! -d "$source_dir" ]]; then
    log_error "Slot '$slot' not found"
    log_info "Available: $(list_tool_slots "codex" | tr '\n' ' ')"
    exit 4
  fi

  if [[ -f "$target_file" ]]; then
    sync_current_auth "$tool"
  fi

  [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would switch to $slot"; return; }

  cp "$source_dir/auth.json" "$target_file"
  codex_apply_saved_slot_config_fragment "$slot"
  actual_kind="$(codex_live_auth_kind "$target_file")"
  if [[ "$expected_kind" == "apikey" && "$actual_kind" != "apikey" ]]; then
    log_error "Switch copied Codex bundle but active auth does not look like an apikey slot"
    exit 5
  fi
  if [[ "$expected_kind" != "apikey" && "$actual_kind" == "apikey" ]]; then
    log_error "Switch copied Codex bundle but active auth still looks like an apikey slot"
    exit 5
  fi
  switched_account="$(extract_codex_account "$target_file")"
  switched_provider="$(codex_live_provider_id)"

  write_tool_active_slot "codex" "$slot"
  log_info "Switched codex to slot: $slot"
  log_info "Switched codex slot kind: $expected_kind"
  [[ -n "$switched_account" ]] && log_info "Switched codex auth email: $switched_account"
  [[ -n "$switched_provider" ]] && log_info "Switched codex provider: $switched_provider"
  log_warn "Restart codex for the change to take effect"

  if [[ "$FORMAT" == "json" && "$suppress_json" != "suppress_json" ]]; then
    echo "{\"switched\": true, \"tool\": \"codex\", \"slot\": \"$slot\", \"slot_kind\": $(json_string_or_null "$expected_kind"), \"provider_id\": $(json_string_or_null "$switched_provider"), \"auth_email\": $(json_string_or_null "$switched_account"), \"account\": $(json_string_or_null "$switched_account")}"
  fi
}

# 列出 slots
cmd_list() {
  local tool="${1:-codex}"
  local accounts=()
  if [[ "$tool" == "codex" ]]; then
    codex_switch_lock_wait_for_idle || exit 1
  fi
  
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    accounts+=("$tool-$line")
  done < <(list_tool_slots "$tool")
  
  if [[ ${#accounts[@]} -eq 0 ]]; then
    log_info "No slots found for $tool."
    return
  fi
  
  case "$FORMAT" in
    json)
      echo -n "{\"accounts\": ["
      local first=true
      for a in "${accounts[@]}"; do
        [[ "$first" == "true" ]] && first=false || echo -n ", "
        echo -n "\"$a\""
      done
      echo "]}"
      ;;
    *)
      for a in "${accounts[@]}"; do
        echo "  $a"
      done
      ;;
  esac
}

# 显示当前 slot
cmd_whoami() {
  local tool="${1:-codex}"
  
  case "$tool" in
    codex)
      codex_switch_lock_wait_for_idle || exit 1
      local auth_file slot kind provider_id
      auth_file="$(codex_live_auth_file)"
      slot=""
      kind=""
      provider_id=""
      if [[ ! -f "$auth_file" ]]; then
        case "$FORMAT" in
          json) echo "{\"tool\": \"codex\", \"slot\": null, \"slot_kind\": null, \"provider_id\": null, \"auth_email\": null, \"account\": null}" ;;
