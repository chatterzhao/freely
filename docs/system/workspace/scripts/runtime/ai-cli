#!/usr/bin/env bash
set -euo pipefail

# AI CLI Slot Manager
# Usage: freely ai <command> [options]

# 配置
AUTH_DIR="$HOME/.ai-auth"
CONFIG_FILE="$HOME/.config/freely/ai-cli-profiles.yaml"
SELF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
FILE_BACKUP_LIB="$SELF_ROOT/docs/system/workspace/scripts/runtime/file-backup.sh"

[[ -f "$FILE_BACKUP_LIB" ]] || {
  echo "[ERROR] missing file backup helper: $FILE_BACKUP_LIB" >&2
  exit 1
}
source "$FILE_BACKUP_LIB"

TOOL_LAUNCHERS_LIB="$SELF_ROOT/docs/system/workspace/scripts/runtime/tool-launchers.sh"
[[ -f "$TOOL_LAUNCHERS_LIB" ]] && source "$TOOL_LAUNCHERS_LIB"

# 全局选项
YES_MODE=false
FORMAT="text"
QUIET=false
DRY_RUN=false
LOGIN_PROVIDER_NAME=""
LOGIN_BASE_URL=""
LOGIN_API_KEY=""
SWITCH_PROJECT=""

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 工具函数
log_info() {
  [[ "$QUIET" == "true" ]] && return
  echo -e "${GREEN}[INFO]${NC} $1"
}

log_error() {
  echo -e "${RED}[ERROR]${NC} $1" >&2
}

log_warn() {
  [[ "$QUIET" == "true" ]] && return
  echo -e "${YELLOW}[WARN]${NC} $1"
}

prompt_value() {
  local prompt="$1" default_value="${2:-}" value=""
  if [[ -n "$default_value" ]]; then
    read -r -p "$prompt [$default_value]: " value
    if [[ -z "$value" ]]; then
      value="$default_value"
    fi
  else
    read -r -p "$prompt: " value
  fi
  printf '%s\n' "$value"
}

codex_prompt_login_mode() {
  local selected
  selected="$(prompt_value "Codex auth mode (account/apikey)" "account")"
  case "$selected" in
    account|apikey)
      printf '%s\n' "$selected"
      ;;
    *)
      log_error "Unsupported codex auth mode: $selected"
      exit 2
      ;;
  esac
}

# Prompt auth mode for claude/opencode/cc/kiro-cli (non-codex tools).
# Same shape as codex_prompt_login_mode but with tool-specific prompt.
_prompt_generic_login_mode() {
  local tool="$1" selected
  selected="$(prompt_value "$tool auth mode (account/apikey)" "account")"
  case "$selected" in
    account|apikey)
      printf '%s\n' "$selected"
      ;;
    *)
      log_error "Unsupported auth mode for $tool: $selected (use: account, apikey)"
      exit 2
      ;;
  esac
}

# 确认操作
confirm() {
  local msg="$1"
  [[ "$YES_MODE" == "true" ]] && return 0
  read -r -p "$msg [y/N] " response
  [[ "$response" =~ ^[Yy]$ ]]
}

auth_slot_prefix() {
  local tool="$1"
  printf '%s\n' "$AUTH_DIR/${tool}-"
}

auth_slot_dir() {
  local tool="$1" slot="$2"
  # slot already includes tool prefix (full name) → use as-is
  if [[ "$slot" == ${tool}-* ]]; then
    printf '%s\n' "$AUTH_DIR/$slot"
  else
    printf '%s\n' "$(auth_slot_prefix "$tool")$slot"
  fi
}

list_tool_slots() {
  local tool="$1" prefix
  prefix="$(basename "$(auth_slot_prefix "$tool")")"
  # Return full directory names (no prefix strip)
  ls -1 "$AUTH_DIR" 2>/dev/null | grep "^${prefix}" || true
}

tool_active_slot_file() {
  local tool="$1"
  printf '%s\n' "$AUTH_DIR/.${tool}-current-slot"
}

read_tool_active_slot() {
  local tool="$1" file
  file="$(tool_active_slot_file "$tool")"
  if [[ -f "$file" ]]; then
    tr -d '\n' <"$file"
    return 0
  fi
  if [[ "$tool" == "codex" ]]; then
    read_codex_active_slot
  fi
}

write_tool_active_slot() {
  local tool="$1" slot="$2" file
  file="$(tool_active_slot_file "$tool")"
  mkdir -p "$(dirname "$file")"
  printf '%s\n' "$slot" >"$file"
  if [[ "$tool" == "codex" ]]; then
    write_codex_active_slot "$slot"
  fi
}

clear_tool_active_slot() {
  local tool="$1"
  rm -f "$(tool_active_slot_file "$tool")"
  if [[ "$tool" == "codex" ]]; then
    rm -f "$(codex_active_slot_file)"
  fi
}

codex_active_slot_file() {
  printf '%s\n' "$HOME/.codex/active-slot"
}

read_codex_active_slot() {
  local file
  file="$(codex_active_slot_file)"
  [[ -f "$file" ]] || return 0
  tr -d '\n' <"$file"
}

write_codex_active_slot() {
  local slot="$1"
  local file
  file="$(codex_active_slot_file)"
  mkdir -p "$(dirname "$file")"
  printf '%s\n' "$slot" >"$file"
}

format_epoch_local() {
  local epoch="$1"
  [[ -n "$epoch" ]] || return 1
  date -r "$epoch" '+%Y.%m.%d %H:%M:%S %Z' 2>/dev/null || date -d "@$epoch" '+%Y.%m.%d %H:%M:%S %Z' 2>/dev/null || printf '%s\n' "$epoch"
}

format_timestamp_local() {
  local value="${1:-}" epoch=""
  [[ -n "$value" ]] || return 1
  case "$value" in
    unknown|unavailable|none) printf '%s\n' "$value"; return 0 ;;
  esac
  if [[ "$value" =~ ^[0-9]+$ ]]; then
    format_epoch_local "$value"
    return 0
  fi
  epoch="$(python3 - <<'PY' "$value" 2>/dev/null || true
from datetime import datetime
import sys

value = sys.argv[1]
if value.endswith("Z"):
    value = value[:-1] + "+00:00"
try:
    print(int(datetime.fromisoformat(value).timestamp()))
except Exception:
    pass
PY
)"
  if [[ -n "$epoch" ]]; then
    format_epoch_local "$epoch"
    return 0
  fi
  printf '%s\n' "$value"
}

notify_freely_auth_change() {
  local tool="$1" slot="${2:-}" reason="${3:-auth_change}"
  local freely_bin
  [[ "${AI_CLI_SUPPRESS_AUTH_CHANGE_WAKE:-0}" == "1" ]] && return 0
  freely_bin="${FREELY_AUTH_CHANGE_WAKE_BIN:-$SELF_ROOT/bin/freely}"
  [[ -x "$freely_bin" ]] || return 0
  case "${AI_CLI_AUTH_CHANGE_WAKE_MODE:-async}" in
    sync)
      "$freely_bin" auth-change-wake --tool "$tool" --slot "$slot" --reason "$reason" >/dev/null 2>&1 || true
      ;;
    off|disabled)
      return 0
      ;;
    *)
      "$freely_bin" auth-change-wake --tool "$tool" --slot "$slot" --reason "$reason" >/dev/null 2>&1 </dev/null &
      disown || true
      ;;
  esac
}

codex_switch_lock_dir() {
  printf '%s\n' "${AI_CLI_SWITCH_LOCK_DIR:-$HOME/.codex/slot-switch.lock}"
}

codex_switch_lock_state_file() {
  printf '%s\n' "$(codex_switch_lock_dir)/state.env"
}

codex_switch_lock_owner_pid() {
  local state_file
  state_file="$(codex_switch_lock_state_file)"
  [[ -f "$state_file" ]] || return 0
  sed -n 's/^owner_pid=//p' "$state_file" | tail -n 1
}

codex_switch_lock_cleanup_if_stale() {
  local lock_dir owner_pid
  lock_dir="$(codex_switch_lock_dir)"
  [[ -d "$lock_dir" ]] || return 0
  owner_pid="$(codex_switch_lock_owner_pid)"
  if [[ -z "$owner_pid" ]] || ! kill -0 "$owner_pid" 2>/dev/null; then
    rm -rf "$lock_dir"
  fi
}

codex_switch_lock_acquire() {
  local reason="$1" command_name="${2:-switch}" target="${3:-}"
  local lock_dir state_file timeout_secs start_ts now owner_pid inherited_owner_pid
  lock_dir="$(codex_switch_lock_dir)"
  state_file="$(codex_switch_lock_state_file)"
  inherited_owner_pid="${AI_CLI_SWITCH_LOCK_OWNER_PID:-}"
  timeout_secs="${AI_CLI_SWITCH_LOCK_WAIT_SECS:-60}"
  [[ "$timeout_secs" =~ ^[0-9]+$ ]] || timeout_secs=60
  mkdir -p "$(dirname "$lock_dir")"
  start_ts="$(date +%s)"

  while true; do
    codex_switch_lock_cleanup_if_stale
    if mkdir "$lock_dir" 2>/dev/null; then
      cat >"$state_file" <<EOF
owner_pid=$$
started_at=$(date +%s)
reason=$reason
command=$command_name
target=$target
EOF
      export AI_CLI_SWITCH_LOCK_OWNER_PID="$$"
      return 0
    fi

    owner_pid="$(codex_switch_lock_owner_pid)"
    if [[ -n "$owner_pid" && ( "$owner_pid" == "$$" || ( -n "$inherited_owner_pid" && "$owner_pid" == "$inherited_owner_pid" ) ) ]]; then
      export AI_CLI_SWITCH_LOCK_OWNER_PID="$owner_pid"
      return 0
    fi

    now="$(date +%s)"
    if (( now - start_ts >= timeout_secs )); then
      log_error "timed out waiting for an existing codex slot switch to finish"
      return 1
    fi
    sleep 1
  done
}

codex_switch_lock_release() {
  local lock_dir owner_pid inherited_owner_pid
  lock_dir="$(codex_switch_lock_dir)"
  [[ -d "$lock_dir" ]] || return 0
  owner_pid="$(codex_switch_lock_owner_pid)"
  inherited_owner_pid="${AI_CLI_SWITCH_LOCK_OWNER_PID:-}"
  if [[ -z "$owner_pid" || "$owner_pid" == "$$" ]]; then
    rm -rf "$lock_dir"
  elif [[ -n "$inherited_owner_pid" && "$owner_pid" == "$inherited_owner_pid" && "$$" == "$inherited_owner_pid" ]]; then
    rm -rf "$lock_dir"
  fi
}

codex_switch_lock_wait_for_idle() {
  local timeout_secs="${AI_CLI_SWITCH_LOCK_WAIT_SECS:-60}"
  local lock_dir start_ts now owner_pid inherited_owner_pid
  lock_dir="$(codex_switch_lock_dir)"
  inherited_owner_pid="${AI_CLI_SWITCH_LOCK_OWNER_PID:-}"
  [[ "$timeout_secs" =~ ^[0-9]+$ ]] || timeout_secs=60
  start_ts="$(date +%s)"

  while true; do
    codex_switch_lock_cleanup_if_stale
    [[ -d "$lock_dir" ]] || return 0
    owner_pid="$(codex_switch_lock_owner_pid)"
    if [[ -n "$owner_pid" && ( "$owner_pid" == "$$" || ( -n "$inherited_owner_pid" && "$owner_pid" == "$inherited_owner_pid" ) ) ]]; then
      return 0
    fi
    now="$(date +%s)"
    if (( now - start_ts >= timeout_secs )); then
      log_error "timed out waiting for an existing codex slot switch to finish"
      return 1
    fi
    sleep 1
  done
}

next_slot_name() {
  local tool="$1" base="$2"
  local slot="${base}-1" i=2
  while [[ -d "$(auth_slot_dir "$tool" "$slot")" ]]; do
    slot="${base}-${i}"
    ((i++))
  done
  printf '%s\n' "$slot"
}

resolve_codex_slot_name() {
  local auth_file="$1" requested_slot="${2:-}" tool="${3:-codex}"
  local kind account provider_id base_slot
  if [[ -n "$requested_slot" ]]; then
    printf '%s\n' "$requested_slot"
    return 0
  fi
  kind="$(codex_live_auth_kind "$auth_file")"
  case "$kind" in
    apikey)
      provider_id="$(codex_effective_provider_id_for_kind "$kind" "$(codex_effective_live_provider_id "$auth_file")")"
      base_slot="${tool}-apikey-$(printf '%s' "$provider_id" | sed 's/[^A-Za-z0-9._-]/-/g; s/\./-/g')"
      ;;
    *)
      account="$(extract_codex_account "$auth_file")"
      [[ -n "$account" ]] || return 1
      base_slot="${tool}-account-$(printf '%s' "$account" | sed 's/[^A-Za-z0-9._@-]/-/g; s/\./-/g')"
      ;;
  esac
  next_slot_name "$tool" "$base_slot"
}

json_string_or_null() {
  local value="${1-}"
  if [[ -z "${value}" ]]; then
    printf 'null'
  else
    python3 - <<'PY' "$value"
import json
import sys
print(json.dumps(sys.argv[1]))
PY
  fi
}

json_array_from_values() {
  local first=true value
  printf '['
  for value in "$@"; do
    [[ "$first" == "true" ]] && first=false || printf ', '
    json_string_or_null "$value"
  done
  printf ']'
}

# 从 auth.json 提取账号信息
extract_codex_account() {
  local auth_file="$1"
  local email=""
  
  if command -v python3 &>/dev/null; then
    email=$(python3 -c "
import json, sys, base64
try:
    data = json.load(open('$auth_file'))
    id_token = data.get('tokens', {}).get('id_token', '')
    if id_token:
        payload = id_token.split('.')[1]
        payload += '=' * (4 - len(payload) % 4)
        decoded = base64.urlsafe_b64decode(payload)
        claims = json.loads(decoded)
        print(claims.get('email', ''))
except:
    pass
" 2>/dev/null)
  fi
  
  echo "$email"
}

codex_live_auth_file() {
  printf '%s\n' "$HOME/.codex/auth.json"
}

codex_live_config_file() {
  printf '%s\n' "$HOME/.codex/config.toml"
}

codex_slot_manifest_file() {
  local slot="$1"
  printf '%s\n' "$(auth_slot_dir "codex" "$slot")/manifest.json"
}

codex_slot_config_fragment_file() {
  local slot="$1"
  printf '%s\n' "$(auth_slot_dir "codex" "$slot")/config.toml"
}

codex_live_auth_kind() {
  local auth_file="$1"
  python3 - <<'PY' "$auth_file" 2>/dev/null || true
import json
import os
import sys

path = sys.argv[1]
if not os.path.exists(path):
    print("")
    raise SystemExit(0)
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)
if isinstance(data.get("OPENAI_API_KEY"), str) and data.get("OPENAI_API_KEY"):
    print("apikey")
elif isinstance(data.get("tokens"), dict) or isinstance(data.get("access_token"), str):
    print("account")
else:
    print("legacy")
PY
}

codex_live_provider_id() {
  local config_file
  config_file="$(codex_live_config_file)"
  python3 - <<'PY' "$config_file" 2>/dev/null || true
import os
import sys
import tomllib

path = sys.argv[1]
if not os.path.exists(path):
    print("")
    raise SystemExit(0)
with open(path, "rb") as f:
    data = tomllib.load(f)
value = data.get("model_provider", "")
print(value if isinstance(value, str) else "")
PY
}

codex_effective_provider_id_for_kind() {
  local kind="$1" provider_id="${2:-}"
  if [[ -n "$provider_id" ]]; then
    printf '%s\n' "$provider_id"
    return 0
  fi
  if [[ "$kind" == "apikey" ]]; then
    printf 'custom\n'
    return 0
  fi
  printf '\n'
}

codex_effective_live_provider_id() {
  local auth_file="${1:-}" kind provider_id
  [[ -n "$auth_file" ]] || auth_file="$(codex_live_auth_file)"
  kind="$(codex_live_auth_kind "$auth_file")"
  provider_id="$(codex_live_provider_id)"
  if [[ "$kind" == "apikey" ]]; then
    printf '%s\n' "$provider_id"
    return 0
  fi
  printf '\n'
}

codex_infer_slot_kind_from_slot() {
  local slot="${1:-}"
  case "$slot" in
    *-account-*|account-*) printf 'account\n' ;;
    *-apikey-*|apikey-*) printf 'apikey\n' ;;
    *) printf 'legacy\n' ;;
  esac
}

codex_saved_slot_kind() {
  local slot="$1"
  local manifest_file auth_file kind=""
  manifest_file="$(codex_slot_manifest_file "$slot")"
  if [[ -f "$manifest_file" ]]; then
    kind="$(python3 - <<'PY' "$manifest_file" 2>/dev/null || true
import json
import sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    data = json.load(f)
value = data.get("slot_kind", "")
print(value if isinstance(value, str) else "")
PY
)"
  fi
  if [[ -n "$kind" ]]; then
    printf '%s\n' "$kind"
    return 0
  fi
  kind="$(codex_infer_slot_kind_from_slot "$slot")"
  if [[ "$kind" != "legacy" ]]; then
    printf '%s\n' "$kind"
    return 0
  fi
  auth_file="$(auth_slot_dir "codex" "$slot")/auth.json"
  kind="$(codex_live_auth_kind "$auth_file")"
  [[ -n "$kind" ]] || kind="legacy"
  printf '%s\n' "$kind"
}

codex_saved_slot_provider_id() {
  local slot="$1" manifest_file kind provider_id
  manifest_file="$(codex_slot_manifest_file "$slot")"
  [[ -f "$manifest_file" ]] || return 0
  provider_id="$(python3 - <<'PY' "$manifest_file" 2>/dev/null || true
import json
import sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    data = json.load(f)
value = data.get("provider_id", "")
print(value if isinstance(value, str) else "")
PY
)"
  kind="$(codex_saved_slot_kind "$slot")"
  codex_effective_provider_id_for_kind "$kind" "$provider_id"
}

codex_probe_result_status() {
  local probe_result="${1:-}"
  case "$probe_result" in
    rate_limited:*) printf 'rate_limited\n' ;;
    error:*) printf 'error\n' ;;
    "") printf 'unknown\n' ;;
    *) printf '%s\n' "$probe_result" ;;
  esac
}

codex_probe_result_reset_at() {
  local probe_result="${1:-}"
  case "$probe_result" in
    rate_limited:*) printf '%s\n' "${probe_result#rate_limited:}" ;;
    *) printf '0\n' ;;
  esac
}

codex_saved_slot_matches_live_bundle() {
  local slot="$1" auth_file="$2" live_kind="$3" live_account="$4" live_provider="$5"
  local slot_dir saved_auth_file saved_kind saved_account saved_provider
  [[ -n "$slot" && -f "$auth_file" ]] || return 1
  slot_dir="$(auth_slot_dir "codex" "$slot")"
  [[ -d "$slot_dir" ]] || return 1
  saved_kind="$(codex_saved_slot_kind "$slot")"
  [[ "$saved_kind" == "$live_kind" ]] || return 1
  saved_auth_file="$slot_dir/auth.json"
  [[ -f "$saved_auth_file" ]] || return 1

  case "$live_kind" in
    apikey)
      saved_provider="$(codex_saved_slot_provider_id "$slot")"
      if [[ -n "$live_provider" || -n "$saved_provider" ]]; then
        [[ "$saved_provider" == "$live_provider" ]] || return 1
      fi
      ;;
    account)
      if [[ -n "$live_account" ]]; then
        saved_account="$(extract_codex_account "$saved_auth_file")"
        [[ -n "$saved_account" && "$saved_account" == "$live_account" ]] || return 1
      fi
      ;;
  esac

  cmp -s "$saved_auth_file" "$auth_file"
}

codex_resolve_live_slot() {
  local auth_file="$1" live_kind live_account live_provider
  local preferred_slots=() candidate matched_slot="" match_count=0
  [[ -f "$auth_file" ]] || return 0
  live_kind="$(codex_live_auth_kind "$auth_file")"
  [[ -n "$live_kind" ]] || return 0
  live_account="$(extract_codex_account "$auth_file")"
  if [[ "$live_kind" == "apikey" ]]; then
    live_provider="$(codex_live_provider_id)"
  else
    live_provider=""
  fi

  if [[ -f "$(tool_active_slot_file "codex")" ]]; then
    candidate="$(tr -d '\n' <"$(tool_active_slot_file "codex")" 2>/dev/null || true)"
    [[ -n "$candidate" ]] && preferred_slots+=("$candidate")
  fi
  candidate="$(read_codex_active_slot)"
  if [[ -n "$candidate" ]]; then
    local seen=false existing
    if [[ ${#preferred_slots[@]} -gt 0 ]]; then
      for existing in "${preferred_slots[@]}"; do
        if [[ "$existing" == "$candidate" ]]; then
          seen=true
          break
        fi
      done
    fi
    [[ "$seen" == "true" ]] || preferred_slots+=("$candidate")
  fi

  if [[ ${#preferred_slots[@]} -gt 0 ]]; then
    for candidate in "${preferred_slots[@]}"; do
      if codex_saved_slot_matches_live_bundle "$candidate" "$auth_file" "$live_kind" "$live_account" "$live_provider"; then
        printf '%s\n' "$candidate"
        return 0
      fi
    done
  fi

  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    if ! codex_saved_slot_matches_live_bundle "$candidate" "$auth_file" "$live_kind" "$live_account" "$live_provider"; then
      continue
    fi
    matched_slot="$candidate"
    match_count=$((match_count + 1))
  done < <(list_tool_slots "codex")

  if [[ "$match_count" -eq 1 ]]; then
    printf '%s\n' "$matched_slot"
  fi
}

codex_write_slot_manifest() {
  local slot="$1" slot_dir="$2" kind="$3" account="$4" provider_id="$5"
  python3 - <<'PY' "$slot_dir/manifest.json" "$slot" "$kind" "$account" "$provider_id"
import json
import os
import sys

path, slot, kind, account, provider_id = sys.argv[1:6]
payload = {
    "manifest_version": "codex-slot-v1",
    "tool": "codex",
    "slot_id": slot,
    "slot_kind": kind,
}
if account:
    payload["auth_email"] = account
if provider_id:
    payload["provider_id"] = provider_id
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "w", encoding="utf-8") as f:
    json.dump(payload, f, indent=2, sort_keys=True)
    f.write("\n")
PY
}

codex_write_fragment_toml_from_live_config() {
  local target_file="$1"
  local config_file
  config_file="$(codex_live_config_file)"
  python3 - <<'PY' "$config_file" "$target_file"
import json
import os
import sys
import tomllib

config_path, target_path = sys.argv[1:3]

def dump_value(value):
    if isinstance(value, str):
        return json.dumps(value)
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, list):
        return "[" + ", ".join(dump_value(item) for item in value) + "]"
    raise TypeError(type(value))

def render_key(key):
    if isinstance(key, str) and key and all(ch.isalnum() or ch in "-_" for ch in key):
        return key
    return json.dumps(key)

def render_path(path):
    return ".".join(render_key(segment) for segment in path)

def emit_table(lines, path, mapping):
    scalar_items = []
    table_items = []
    for key, value in mapping.items():
        if isinstance(value, dict):
            table_items.append((key, value))
        else:
            scalar_items.append((key, value))
    if path:
        lines.append(f"[{render_path(path)}]")
    for key, value in scalar_items:
        lines.append(f"{render_key(key)} = {dump_value(value)}")
    if scalar_items and table_items:
        lines.append("")
    for idx, (key, value) in enumerate(table_items):
        emit_table(lines, [*path, key], value)
        if idx != len(table_items) - 1:
            lines.append("")

fragment = {}
if os.path.exists(config_path) and os.path.getsize(config_path) > 0:
    with open(config_path, "rb") as f:
        data = tomllib.load(f)
    provider_id = data.get("model_provider")
    if isinstance(provider_id, str) and provider_id:
        fragment["model_provider"] = provider_id
        providers = data.get("model_providers", {})
        if isinstance(providers, dict) and isinstance(providers.get(provider_id), dict):
            fragment["model_providers"] = {provider_id: providers[provider_id]}
