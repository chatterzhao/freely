        exit 0
      fi
      
      local account=$(extract_codex_account "$auth_file")
      slot="$(read_tool_active_slot "codex")"
      kind="$(codex_saved_slot_kind "${slot:-}")"
      [[ -n "$slot" ]] || kind="$(codex_live_auth_kind "$auth_file")"
      provider_id="$(codex_live_provider_id)"
      if [[ -z "$account" ]]; then
        case "$FORMAT" in
          json) echo "{\"tool\": \"codex\", \"slot\": $(json_string_or_null "$slot"), \"slot_kind\": $(json_string_or_null "$kind"), \"provider_id\": $(json_string_or_null "$provider_id"), \"auth_email\": null, \"account\": null}" ;;
          *) [[ -n "$slot" ]] && log_info "Current slot: $slot"; [[ -n "$kind" ]] && log_info "Current slot kind: $kind"; [[ -n "$provider_id" ]] && log_info "Current provider: $provider_id"; log_warn "Cannot determine auth email metadata" ;;
        esac
        exit 0
      fi
      
      case "$FORMAT" in
        json) echo "{\"tool\": \"codex\", \"slot\": $(json_string_or_null "$slot"), \"slot_kind\": $(json_string_or_null "$kind"), \"provider_id\": $(json_string_or_null "$provider_id"), \"auth_email\": \"$account\", \"account\": \"$account\"}" ;;
        *)
          [[ -n "$slot" ]] && log_info "Current slot: $slot"
          [[ -n "$kind" ]] && log_info "Current slot kind: $kind"
          [[ -n "$provider_id" ]] && log_info "Current provider: $provider_id"
          log_info "Current auth email: $account"
          ;;
      esac
      ;;
    iflow|kiro-cli|cc|cc-use-codex-cli|opencode)
      local slot=""
      slot="$(read_tool_active_slot "$tool")"
      case "$FORMAT" in
        json) echo "{\"tool\": \"$tool\", \"slot\": $(json_string_or_null "$slot"), \"auth_email\": null, \"account\": null}" ;;
        *)
          [[ -n "$slot" ]] && log_info "Current slot: $slot" || log_warn "No active slot selected for $tool"
          ;;
      esac
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 状态
cmd_status() {
  local tool="${1:-codex}"
  local project="${PROJECT_ROOT:-$(pwd)}"
  
  case "$tool" in
    codex)
      local auth_file
      auth_file="$(codex_live_auth_file)"
      local cache_file=""
      source_watchdog_script_or_fail "$project"
      cache_file="$(codex_availability_cache_file "$project")"
      if ! codex_availability_cache_is_fresh "$project"; then
        codex_inventory_truth "$project" >/dev/null 2>&1 || true
      fi
      if [[ -f "$auth_file" ]]; then
        local mtime=$(stat -f "%Sm" "$auth_file" 2>/dev/null || stat -c "%y" "$auth_file" 2>/dev/null || echo "unknown")
        local account=$(extract_codex_account "$auth_file")
        local slot
        local slot_kind
        local provider_id
        slot="$(read_tool_active_slot "codex")"
        slot_kind="$(codex_saved_slot_kind "${slot:-}")"
        [[ -n "$slot" ]] || slot_kind="$(codex_live_auth_kind "$auth_file")"
        provider_id="$(codex_live_provider_id)"
        local usable_count=""
        local limited_count=""
        local deactivated_count=""
        local unknown_count=""
        local cache_refreshed=""
        local cache_refreshed_human=""
        local earliest_slot=""
        local earliest_reset=""
        local earliest_reset_human=""
        if [[ -f "$cache_file" ]]; then
          usable_count="$(awk -F '\t' 'NR>1 && $2=="usable" {count++} END {print count+0}' "$cache_file")"
          limited_count="$(awk -F '\t' 'NR>1 && $2=="rate_limited" {count++} END {print count+0}' "$cache_file")"
          deactivated_count="$(awk -F '\t' 'NR>1 && $2=="deactivated_workspace" {count++} END {print count+0}' "$cache_file")"
          unknown_count="$(awk -F '\t' 'NR>1 && $2!="usable" && $2!="rate_limited" && $2!="deactivated_workspace" {count++} END {print count+0}' "$cache_file")"
          cache_refreshed="$(awk -F '\t' 'NR==2 {print $7}' "$cache_file")"
          read -r earliest_slot earliest_reset < <(awk -F '\t' '
            NR==1 {next}
            $2=="rate_limited" && $4 ~ /^[0-9]+$/ && $4 > 0 {
              if (best_reset == "" || $4 < best_reset) {
                best_slot = $1
                best_reset = $4
              }
            }
            END {
              print best_slot, best_reset
            }
          ' "$cache_file")
          if [[ -n "$earliest_reset" && "$earliest_reset" =~ ^[0-9]+$ && "$earliest_reset" -gt 0 ]]; then
            earliest_reset_human="$(format_epoch_local "$earliest_reset")"
          fi
          if [[ -n "$cache_refreshed" ]]; then
            cache_refreshed_human="$(format_timestamp_local "$cache_refreshed")"
          fi
        fi
        
        case "$FORMAT" in
          json)
            echo "{\"tool\": \"codex\", \"auth\": \"present\", \"slot\": $(json_string_or_null "$slot"), \"slot_kind\": $(json_string_or_null "$slot_kind"), \"provider_id\": $(json_string_or_null "$provider_id"), \"auth_email\": $(json_string_or_null "$account"), \"account\": $(json_string_or_null "$account"), \"last_modified\": \"$mtime\", \"availability_cache\": {\"present\": $([[ -f "$cache_file" ]] && printf true || printf false), \"usable\": ${usable_count:-0}, \"rate_limited\": ${limited_count:-0}, \"deactivated_workspace\": ${deactivated_count:-0}, \"other\": ${unknown_count:-0}, \"earliest_slot\": $(json_string_or_null "$earliest_slot"), \"earliest_reset_at\": ${earliest_reset:-0}, \"earliest_reset_human\": $(json_string_or_null "$earliest_reset_human"), \"refreshed_at\": $(json_string_or_null "$cache_refreshed"), \"refreshed_at_human\": $(json_string_or_null "$cache_refreshed_human")}}"
            ;;
          *)
            log_info "Tool: codex"
            log_info "Auth: present"
            [[ -n "$slot" ]] && log_info "Slot: $slot"
            [[ -n "$slot_kind" ]] && log_info "Slot kind: $slot_kind"
            [[ -n "$provider_id" ]] && log_info "Provider: $provider_id"
            log_info "Auth email: ${account:-unknown}"
            log_info "Last modified: $mtime"
            if [[ -f "$cache_file" ]]; then
              log_info "Recovery ledger: usable=${usable_count:-0} rate_limited=${limited_count:-0} deactivated_workspace=${deactivated_count:-0} other=${unknown_count:-0}"
              if [[ -n "$earliest_slot" && -n "$earliest_reset_human" ]]; then
                log_info "Earliest reset: ${earliest_slot} at ${earliest_reset_human}"
              fi
              [[ -n "$cache_refreshed_human" ]] && log_info "Availability cache refreshed: $cache_refreshed_human"
            fi
            ;;
        esac
      else
        case "$FORMAT" in
          json) echo "{\"tool\": \"codex\", \"auth\": \"missing\"}" ;;
          *) log_warn "No codex auth found" ;;
        esac
      fi
      ;;
    iflow|kiro-cli|cc|cc-use-codex-cli|opencode)
      local slot path
      slot="$(read_tool_active_slot "$tool")"
      path=""
      [[ -n "$slot" ]] && path="$(auth_slot_dir "$tool" "$slot")"
      case "$FORMAT" in
        json)
          echo "{\"tool\": \"$tool\", \"auth\": $(json_string_or_null "${slot:+slot_inventory}"), \"slot\": $(json_string_or_null "$slot"), \"path\": $(json_string_or_null "$path")}"
          ;;
        *)
          log_info "Tool: $tool"
          if [[ -n "$slot" ]]; then
            log_info "Slot: $slot"
            log_info "Path: $path"
          else
            log_warn "No active slot selected for $tool"
          fi
          ;;
      esac
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 删除 slot
cmd_delete() {
  local tool="$1"
  local slot="$2"
  local target_dir
  target_dir="$(auth_slot_dir "$tool" "$slot")"

  if [[ ! -d "$target_dir" ]]; then
    log_error "Slot '$slot' not found"
    exit 4
  fi

  confirm "Delete slot '$slot'?" || exit 1

  [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would delete $target_dir"; return; }

  rm -rf "$target_dir"
  if [[ "$(read_tool_active_slot "$tool")" == "$slot" ]]; then
    clear_tool_active_slot "$tool"
  fi
  log_info "Deleted slot: $slot"

  if [[ "$FORMAT" == "json" ]]; then
    echo "{\"deleted\": true, \"tool\": \"$tool\", \"slot\": \"$slot\"}"
  fi
}

# 帮助
show_help() {
  cat <<'EOF'
Usage: freely ai <command> [options]

Commands:
  init                    Initialize slot manager
  login <tool> [mode]     Login and auto-save auth slot (`mode`: `account|apikey`)
  save <tool> [slot]      Save current login (auto-detect next slot if not specified)
  switch [tool] [slot]    Switch to slot. No slot = auto-probe and switch only to a usable slot
  list                    List all saved slots
  whoami [tool]           Show current logged-in slot
  status [tool]           Show current status
  delete <tool> <slot>    Delete a slot

Options:
  --yes, -y               Skip confirmations (non-interactive)
  --format FORMAT         Output format: text|json|yaml
  --quiet, -q             Quiet mode
  --dry-run               Simulate without changes

Exit codes:
  0 = success
  1 = general error
  2 = parameter error
  3 = auth error
  4 = not found

Examples:
  freely ai init
  freely ai login codex
  freely ai login codex apikey
  freely ai whoami
  freely ai switch codex                    # Refresh saved auth inventory, then switch if a slot is currently usable
  freely ai switch codex other@email-com-2  # Switch to specific slot
  freely ai switch other@email-com-2 --yes  # Switch to specific slot (default tool: codex)
  freely ai list --format json
EOF
}

# 主入口
main() {
  local COMMAND=""
  local ARGS=()
  
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) YES_MODE=true; shift ;;
      --format) FORMAT="$2"; shift 2 ;;
      --quiet|-q) QUIET=true; shift ;;
      --dry-run) DRY_RUN=true; shift ;;
      --help|-h) show_help; exit 0 ;;
      -*)
        log_error "Unknown option: $1"
        exit 2
        ;;
      *)
        if [[ -z "$COMMAND" ]]; then
          COMMAND="$1"
        else
          ARGS+=("$1")
        fi
        shift
        ;;
    esac
  done
  
  case "$COMMAND" in
    init) cmd_init ;;
    login) cmd_login "${ARGS[0]}" "${ARGS[1]:-}" ;;
    save) cmd_save "${ARGS[0]}" "${ARGS[1]:-}" ;;
    switch)
      case "${ARGS[0]:-}" in
        codex|iflow|kiro-cli|cc|cc-use-codex-cli|opencode)
          cmd_switch "${ARGS[0]}" "${ARGS[1]:-}"
          ;;
        "")
          cmd_switch "codex" ""
          ;;
        *)
          log_warn "No ai tool name provided; defaulting to codex. If the target slot belongs to another tool, switch may fail."
          cmd_switch "codex" "${ARGS[0]}"
          ;;
      esac
      ;;
    list) cmd_list "${ARGS[0]:-codex}" ;;
    whoami) cmd_whoami "${ARGS[0]:-codex}" ;;
    status) cmd_status "${ARGS[0]:-codex}" ;;
    delete) cmd_delete "${ARGS[0]}" "${ARGS[1]}" ;;
    ""|--help|-h) show_help ;;
    *)
      log_error "Unknown command: $COMMAND"
      show_help
      exit 2
      ;;
  esac
}

main "$@"
