#!/usr/bin/env bash
set -euo pipefail

# AI CLI Availability Manager
# Usage: freely ai <command> [options]

# 配置
AUTH_DIR="$HOME/.ai-auth"
CONFIG_FILE="$HOME/.config/freely/ai-cli-profiles.yaml"

# 全局选项
YES_MODE=false
FORMAT="text"
QUIET=false
DRY_RUN=false

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 工具函数
log_info() {
  [[ "$QUIET" == "true" ]] && return
  echo -e "${GREEN}[INFO]${NC} $1"
}

log_error() {
  echo -e "${RED}[ERROR]${NC} $1" >&2
}

log_warn() {
  [[ "$QUIET" == "true" ]] && return
  echo -e "${YELLOW}[WARN]${NC} $1"
}

# 确认操作
confirm() {
  local msg="$1"
  [[ "$YES_MODE" == "true" ]] && return 0
  read -r -p "$msg [y/N] " response
  [[ "$response" =~ ^[Yy]$ ]]
}

# 账号名转安全目录名
account_to_dirname() {
  echo "$1" | sed 's/\./-/g'
}

auth_slot_prefix() {
  local tool="$1"
  printf '%s\n' "$AUTH_DIR/${tool}-"
}

auth_slot_dir() {
  local tool="$1" slot="$2"
  printf '%s\n' "$(auth_slot_prefix "$tool")$slot"
}

list_tool_slots() {
  local tool="$1" prefix
  prefix="$(basename "$(auth_slot_prefix "$tool")")"
  ls -1 "$AUTH_DIR" 2>/dev/null | grep "^${prefix}" | sed "s/^${prefix}//" || true
}

codex_active_slot_file() {
  printf '%s\n' "$HOME/.codex/active-slot"
}

read_codex_active_slot() {
  local file
  file="$(codex_active_slot_file)"
  [[ -f "$file" ]] || return 0
  tr -d '\n' <"$file"
}

write_codex_active_slot() {
  local slot="$1"
  local file
  file="$(codex_active_slot_file)"
  mkdir -p "$(dirname "$file")"
  printf '%s\n' "$slot" >"$file"
}

codex_switch_lock_dir() {
  printf '%s\n' "${AI_CLI_SWITCH_LOCK_DIR:-$HOME/.codex/account-switch.lock}"
}

codex_switch_lock_state_file() {
  printf '%s\n' "$(codex_switch_lock_dir)/state.env"
}

codex_switch_lock_owner_pid() {
  local state_file
  state_file="$(codex_switch_lock_state_file)"
  [[ -f "$state_file" ]] || return 0
  sed -n 's/^owner_pid=//p' "$state_file" | tail -n 1
}

codex_switch_lock_cleanup_if_stale() {
  local lock_dir owner_pid
  lock_dir="$(codex_switch_lock_dir)"
  [[ -d "$lock_dir" ]] || return 0
  owner_pid="$(codex_switch_lock_owner_pid)"
  if [[ -z "$owner_pid" ]] || ! kill -0 "$owner_pid" 2>/dev/null; then
    rm -rf "$lock_dir"
  fi
}

codex_switch_lock_acquire() {
  local reason="$1" command_name="${2:-switch}" target="${3:-}"
  local lock_dir state_file timeout_secs start_ts now owner_pid inherited_owner_pid
  lock_dir="$(codex_switch_lock_dir)"
  state_file="$(codex_switch_lock_state_file)"
  inherited_owner_pid="${AI_CLI_SWITCH_LOCK_OWNER_PID:-}"
  timeout_secs="${AI_CLI_SWITCH_LOCK_WAIT_SECS:-60}"
  [[ "$timeout_secs" =~ ^[0-9]+$ ]] || timeout_secs=60
  mkdir -p "$(dirname "$lock_dir")"
  start_ts="$(date +%s)"

  while true; do
    codex_switch_lock_cleanup_if_stale
    if mkdir "$lock_dir" 2>/dev/null; then
      cat >"$state_file" <<EOF
owner_pid=$$
started_at=$(date +%s)
reason=$reason
command=$command_name
target=$target
EOF
      export AI_CLI_SWITCH_LOCK_OWNER_PID="$$"
      return 0
    fi

    owner_pid="$(codex_switch_lock_owner_pid)"
    if [[ -n "$owner_pid" && ( "$owner_pid" == "$$" || ( -n "$inherited_owner_pid" && "$owner_pid" == "$inherited_owner_pid" ) ) ]]; then
      export AI_CLI_SWITCH_LOCK_OWNER_PID="$owner_pid"
      return 0
    fi

    now="$(date +%s)"
    if (( now - start_ts >= timeout_secs )); then
      log_error "timed out waiting for an existing codex account switch to finish"
      return 1
    fi
    sleep 1
  done
}

codex_switch_lock_release() {
  local lock_dir owner_pid inherited_owner_pid
  lock_dir="$(codex_switch_lock_dir)"
  [[ -d "$lock_dir" ]] || return 0
  owner_pid="$(codex_switch_lock_owner_pid)"
  inherited_owner_pid="${AI_CLI_SWITCH_LOCK_OWNER_PID:-}"
  if [[ -z "$owner_pid" || "$owner_pid" == "$$" ]]; then
    rm -rf "$lock_dir"
  elif [[ -n "$inherited_owner_pid" && "$owner_pid" == "$inherited_owner_pid" && "$$" == "$inherited_owner_pid" ]]; then
    rm -rf "$lock_dir"
  fi
}

codex_switch_lock_wait_for_idle() {
  local timeout_secs="${AI_CLI_SWITCH_LOCK_WAIT_SECS:-60}"
  local lock_dir start_ts now owner_pid inherited_owner_pid
  lock_dir="$(codex_switch_lock_dir)"
  inherited_owner_pid="${AI_CLI_SWITCH_LOCK_OWNER_PID:-}"
  [[ "$timeout_secs" =~ ^[0-9]+$ ]] || timeout_secs=60
  start_ts="$(date +%s)"

  while true; do
    codex_switch_lock_cleanup_if_stale
    [[ -d "$lock_dir" ]] || return 0
    owner_pid="$(codex_switch_lock_owner_pid)"
    if [[ -n "$owner_pid" && ( "$owner_pid" == "$$" || ( -n "$inherited_owner_pid" && "$owner_pid" == "$inherited_owner_pid" ) ) ]]; then
      return 0
    fi
    now="$(date +%s)"
    if (( now - start_ts >= timeout_secs )); then
      log_error "timed out waiting for an existing codex account switch to finish"
      return 1
    fi
    sleep 1
  done
}

json_string_or_null() {
  local value="${1:-}"
  if [[ -n "$value" ]]; then
    printf '"%s"' "$value"
  else
    printf 'null'
  fi
}

next_slot_name() {
  local tool="$1" base="$2"
  local slot="$base" i=1
  while [[ -d "$(auth_slot_dir "$tool" "$slot")" ]]; do
    slot="${base}-${i}"
    ((i++))
  done
  printf '%s\n' "$slot"
}

resolve_codex_slot_name() {
  local auth_file="$1" requested_slot="${2:-}"
  local account base_slot
  if [[ -n "$requested_slot" ]]; then
    printf '%s\n' "$(account_to_dirname "$requested_slot")"
    return 0
  fi
  account="$(extract_codex_account "$auth_file")"
  [[ -n "$account" ]] || return 1
  base_slot="$(account_to_dirname "$account")"
  next_slot_name "codex" "$base_slot"
}

# 从 auth.json 提取账号信息
extract_codex_account() {
  local auth_file="$1"
  local email=""
  
  if command -v python3 &>/dev/null; then
    email=$(python3 -c "
import json, sys, base64
try:
    data = json.load(open('$auth_file'))
    id_token = data.get('tokens', {}).get('id_token', '')
    if id_token:
        payload = id_token.split('.')[1]
        payload += '=' * (4 - len(payload) % 4)
        decoded = base64.urlsafe_b64decode(payload)
        claims = json.loads(decoded)
        print(claims.get('email', ''))
except:
    pass
" 2>/dev/null)
  fi
  
  echo "$email"
}

# 初始化
cmd_init() {
  mkdir -p "$AUTH_DIR"
  chmod 700 "$AUTH_DIR"
  mkdir -p "$(dirname "$CONFIG_FILE")"
  mkdir -p "$HOME/.codex"
  
  if [[ ! -f "$CONFIG_FILE" ]]; then
    cat > "$CONFIG_FILE" << EOF
version: 1
default_tool: codex
tools:
  codex:
    method: copy_auth
    active: ""
    accounts: {}
  iflow:
    method: env_var
    active: ""
    accounts: {}
EOF
    log_info "Created config: $CONFIG_FILE"
  fi
  
  log_info "Initialized AI CLI account manager"
  log_info "Auth directory: $AUTH_DIR"
}

# 登录
cmd_login() {
  local tool="$1"
  
  case "$tool" in
    codex)
      log_info "Launching codex login..."
      codex login
      
      # 登录成功后自动保存
      if [[ -f "$HOME/.codex/auth.json" ]]; then
        local account=$(extract_codex_account "$HOME/.codex/auth.json")
        if [[ -n "$account" ]]; then
          local slot
          slot="$(resolve_codex_slot_name "$HOME/.codex/auth.json")"
          local target_dir
          target_dir="$(auth_slot_dir "codex" "$slot")"
          mkdir -p "$target_dir"
          cp "$HOME/.codex/auth.json" "$target_dir/"
          chmod 600 "$target_dir/auth.json"
          write_codex_active_slot "$slot"
          log_info "Auto-saved account: $account"
          log_info "Slot: $slot"
          log_info "Location: $target_dir"
          
          if [[ "$FORMAT" == "json" ]]; then
            echo "{\"logged_in\": true, \"tool\": \"codex\", \"account\": \"$account\", \"slot\": \"$slot\", \"saved\": true}"
          fi
        fi
      fi
      ;;
    iflow)
      log_info "iflow uses environment variables."
      log_info "Set IFLOW_API_KEY in your shell config, then run: freely ai save iflow <account>"
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 保存当前登录
cmd_save() {
  local tool="$1"
  local account="${2:-}"
  
  case "$tool" in
    codex)
      local auth_file="$HOME/.codex/auth.json"
      if [[ ! -f "$auth_file" ]]; then
        log_error "No codex auth found. Run 'freely ai login codex' first."
        exit 3
      fi

      local actual_account slot
      actual_account="$(extract_codex_account "$auth_file")"

      if [[ -z "$account" && -z "$actual_account" ]]; then
        log_error "Cannot extract account from auth.json. Please specify account name."
          log_info "Usage: freely ai save codex <account>"
          exit 2
      fi

      if [[ -n "$actual_account" ]]; then
        log_info "Detected account: $actual_account"
      fi

      slot="$(resolve_codex_slot_name "$auth_file" "$account")"
      local target_dir
      target_dir="$(auth_slot_dir "codex" "$slot")"

      if [[ -n "$account" ]] && [[ -d "$target_dir" ]] && [[ "$YES_MODE" != "true" ]]; then
        confirm "Account slot '$slot' exists. Overwrite?" || exit 1
      fi

      [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would save to $target_dir"; return; }

      mkdir -p "$target_dir"
      cp "$auth_file" "$target_dir/"
      chmod 600 "$target_dir/auth.json"
      write_codex_active_slot "$slot"

      log_info "Saved codex account: ${actual_account:-$slot}"
      log_info "Slot: $slot"
      log_info "Location: $target_dir"

      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"saved\": true, \"tool\": \"codex\", \"account\": $(json_string_or_null "$actual_account"), \"slot\": \"$slot\", \"path\": \"$target_dir\"}"
      fi
      ;;
    iflow)
      log_error "iflow uses environment variables. Set IFLOW_${account^^}_KEY in your shell config."
      exit 2
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 同步当前 auth.json 到对应备份目录
sync_current_auth() {
  local tool="$1"
  local auth_file="$HOME/.codex/auth.json"
  
  if [[ ! -f "$auth_file" ]]; then
    return 0
  fi
  
  local current_slot
  current_slot="$(read_codex_active_slot)"
  if [[ -z "$current_slot" ]]; then
    return 0
  fi

  local backup_dir
  backup_dir="$(auth_slot_dir "$tool" "$current_slot")"

  # 只在当前活跃槽位已存在时同步，避免创建意外槽位
  if [[ -d "$backup_dir" ]]; then
    cp "$auth_file" "$backup_dir/"
    chmod 600 "$backup_dir/auth.json"
    log_info "Auto-synced current token to slot: $current_slot"
  fi
}

# 切换 account
# Usage:
#   switch <tool> <account>  - 切换到指定账号
#   switch <tool>            - 自动探测，切换到可用的或最早恢复的
cmd_switch() {
  local tool="$1"
  local account="${2:-}"

  case "$tool" in
    codex)
      # 如果没有指定账号，自动探测
      if [[ -z "$account" ]]; then
        _cmd_switch_auto_codex
        return $?
      fi
      codex_switch_lock_acquire "explicit_switch" "switch" "$account" || exit 1
      _cmd_switch_codex_direct_unlocked "$tool" "$account"
      local rc=$?
      codex_switch_lock_release
      return "$rc"
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 自动探测并切换 codex 账号
run_dir_for_project() {
  local project="$1"
  printf '%s\n' "$project/.freely/run"
}

codex_account_cooldown_file() {
  local project="$1"
  printf '%s\n' "$(run_dir_for_project "$project")/codex-account-cooldowns.tsv"
}

ai_cli_bin_for_project() {
  local project="$1"
  if [[ -x "$project/bin/ai" ]]; then
    printf '%s\n' "$project/bin/ai"
    return 0
  fi
  printf '%s\n' "$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)/bin/ai"
}

_cmd_switch_auto_codex() {
  local project="${PROJECT_ROOT:-$(pwd)}"
  local tool="codex"
  local actual_account=""
  local result rc=0

  # Source watchdog functions
  local watchdog_script=""
  if [[ -f "$project/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh" ]]; then
    watchdog_script="$project/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"
  elif [[ -f "$(dirname "$0")/../docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh" ]]; then
    watchdog_script="$(dirname "$0")/../docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"
  fi

  if [[ -z "$watchdog_script" ]]; then
    log_error "Cannot find availability-watchdog.sh"
    exit 3
  fi

  codex_switch_lock_acquire "auto_probe_switch" "switch" "auto" || exit 1

  # shellcheck source=/dev/null
  source "$watchdog_script"

  result="$(probe_all_codex_accounts_and_update_cooldown "$project" || true)"

  case "$result" in
    usable:*)
      local slot="${result#usable:}"
      echo -e "${GREEN}[SWITCHED]${NC} -> $slot (usable)"
      _cmd_switch_codex_direct_unlocked "$tool" "$slot"
      actual_account="$(extract_codex_account "$HOME/.codex/auth.json")"
      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"switched\": true, \"tool\": \"codex\", \"account\": $(json_string_or_null "$actual_account"), \"slot\": \"$slot\", \"status\": \"usable\"}"
      fi
      ;;
    earliest:*)
      local info="${result#earliest:}"
      local slot="${info%%|*}"
      local reset_at="${info##*|}"
      local human_time
      human_time="$(date -r "$reset_at" '+%Y.%m.%d %H:%M:%S' 2>/dev/null || date -d "@$reset_at" '+%Y.%m.%d %H:%M:%S' 2>/dev/null || echo "$reset_at")"
      echo -e "${YELLOW}[SWITCHED]${NC} -> $slot (rate limited, resets at $human_time)"
      _cmd_switch_codex_direct_unlocked "$tool" "$slot"
      actual_account="$(extract_codex_account "$HOME/.codex/auth.json")"
      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"switched\": true, \"tool\": \"codex\", \"account\": $(json_string_or_null "$actual_account"), \"slot\": \"$slot\", \"status\": \"rate_limited\", \"reset_at\": $reset_at, \"reset_at_human\": \"$human_time\"}"
      fi
      ;;
    none)
      log_error "No accounts found or all probing failed"
      if [[ "$FORMAT" == "json" ]]; then
        echo "{\"switched\": false, \"status\": \"none\"}"
      fi
      rc=4
      ;;
    *)
      log_error "Unknown result: $result"
      rc=1
      ;;
  esac
  codex_switch_lock_release
  return "$rc"
}

# 实际执行切换（不包含探测逻辑），由上层决定是否持有全局切号锁。
_cmd_switch_codex_direct_unlocked() {
  local tool="$1" account="$2"
  local slot source_dir target_file switched_account
  slot="$(account_to_dirname "$account")"
  source_dir="$(auth_slot_dir "codex" "$slot")"
  target_file="$HOME/.codex/auth.json"
  switched_account=""

  if [[ ! -d "$source_dir" ]]; then
    log_error "Account '$account' not found"
    log_info "Available: $(list_tool_slots "codex" | tr '\n' ' ')"
    exit 4
  fi

  if [[ -f "$target_file" ]]; then
    sync_current_auth "$tool"
  fi

  [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would switch to $account"; return; }

  cp "$source_dir/auth.json" "$target_file"
  switched_account="$(extract_codex_account "$target_file")"
  if [[ -z "$switched_account" ]]; then
    log_error "Switch copied auth.json but could not verify the active codex account"
    exit 5
  fi

  write_codex_active_slot "$slot"
  log_info "Switched codex to slot: $slot"
  log_info "Active codex account: $switched_account"
  log_warn "Restart codex for the change to take effect"

  if [[ "$FORMAT" == "json" ]]; then
    echo "{\"switched\": true, \"tool\": \"codex\", \"account\": \"$switched_account\", \"slot\": \"$slot\"}"
  fi
}

# 列出 accounts
cmd_list() {
  local accounts=()
  codex_switch_lock_wait_for_idle || exit 1
  
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    accounts+=("codex-$line")
  done < <(list_tool_slots "codex")
  
  if [[ ${#accounts[@]} -eq 0 ]]; then
    log_info "No accounts found. Run 'freely ai login codex' to create one."
    return
  fi
  
  case "$FORMAT" in
    json)
      echo -n "{\"accounts\": ["
      local first=true
      for a in "${accounts[@]}"; do
        [[ "$first" == "true" ]] && first=false || echo -n ", "
        echo -n "\"$a\""
      done
      echo "]}"
      ;;
    *)
      for a in "${accounts[@]}"; do
        echo "  $a"
      done
      ;;
  esac
}

# 显示当前账号
cmd_whoami() {
  local tool="${1:-codex}"
  
  case "$tool" in
    codex)
      codex_switch_lock_wait_for_idle || exit 1
      local auth_file="$HOME/.codex/auth.json"
      local slot=""
      if [[ ! -f "$auth_file" ]]; then
        case "$FORMAT" in
          json) echo "{\"tool\": \"codex\", \"account\": null, \"slot\": null}" ;;
          *) log_warn "Not logged in" ;;
        esac
        exit 0
      fi
      
      local account=$(extract_codex_account "$auth_file")
      slot="$(read_codex_active_slot)"
      if [[ -z "$account" ]]; then
        case "$FORMAT" in
          json) echo "{\"tool\": \"codex\", \"account\": null, \"slot\": $(json_string_or_null "$slot")}" ;;
          *) log_warn "Cannot determine account" ;;
        esac
        exit 0
      fi
      
      case "$FORMAT" in
        json) echo "{\"tool\": \"codex\", \"account\": \"$account\", \"slot\": $(json_string_or_null "$slot")}" ;;
        *) log_info "Current account: $account"; [[ -n "$slot" ]] && log_info "Current slot: $slot" ;;
      esac
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 状态
cmd_status() {
  local tool="${1:-codex}"
  
  case "$tool" in
    codex)
      local auth_file="$HOME/.codex/auth.json"
      if [[ -f "$auth_file" ]]; then
        local mtime=$(stat -f "%Sm" "$auth_file" 2>/dev/null || stat -c "%y" "$auth_file" 2>/dev/null || echo "unknown")
        local account=$(extract_codex_account "$auth_file")
        local slot
        slot="$(read_codex_active_slot)"
        
        case "$FORMAT" in
          json)
            echo "{\"tool\": \"codex\", \"auth\": \"present\", \"account\": \"$account\", \"slot\": $(json_string_or_null "$slot"), \"last_modified\": \"$mtime\"}"
            ;;
          *)
            log_info "Tool: codex"
            log_info "Auth: present"
            log_info "Account: ${account:-unknown}"
            [[ -n "$slot" ]] && log_info "Slot: $slot"
            log_info "Last modified: $mtime"
            ;;
        esac
      else
        case "$FORMAT" in
          json) echo "{\"tool\": \"codex\", \"auth\": \"missing\"}" ;;
          *) log_warn "No codex auth found" ;;
        esac
      fi
      ;;
    *)
      log_error "Unknown tool: $tool"
      exit 2
      ;;
  esac
}

# 删除 account
cmd_delete() {
  local tool="$1"
  local account="$2"
  local slot
  slot="$(account_to_dirname "$account")"
  local target_dir
  target_dir="$(auth_slot_dir "$tool" "$slot")"

  if [[ ! -d "$target_dir" ]]; then
    log_error "Account '$account' not found"
    exit 4
  fi

  confirm "Delete account '$slot'?" || exit 1

  [[ "$DRY_RUN" == "true" ]] && { log_info "[DRY-RUN] Would delete $target_dir"; return; }

  rm -rf "$target_dir"
  if [[ "$tool" == "codex" ]] && [[ "$(read_codex_active_slot)" == "$slot" ]]; then
    rm -f "$(codex_active_slot_file)"
  fi
  log_info "Deleted account: $slot"

  if [[ "$FORMAT" == "json" ]]; then
    echo "{\"deleted\": true, \"tool\": \"$tool\", \"slot\": \"$slot\"}"
  fi
}

# 帮助
show_help() {
  cat << EOF
Usage: freely ai <command> [options]

Commands:
  init                    Initialize account manager
  login <tool>            Login and auto-save account
  save <tool> [account]   Save current login (auto-detect account if not specified)
  switch [tool] [account] Switch to account. No account = auto-probe and switch to usable/earliest
  list                    List all accounts
  whoami [tool]           Show current logged-in account
  status [tool]           Show current status
  delete <tool> <account> Delete an account

Options:
  --yes, -y               Skip confirmations (non-interactive)
  --format FORMAT         Output format: text|json|yaml
  --quiet, -q             Quiet mode
  --dry-run               Simulate without changes

Exit codes:
  0 = success
  1 = general error
  2 = parameter error
  3 = auth error
  4 = not found

Examples:
  freely ai init
  freely ai login codex
  freely ai whoami
  freely ai switch codex                    # Auto-probe, switch to usable/earliest
  freely ai switch codex other@email.com    # Switch to specific account
  freely ai switch other@email.com --yes    # Switch to specific account (default tool: codex)
  freely ai list --format json
EOF
}

# 主入口
main() {
  local COMMAND=""
  local ARGS=()
  
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) YES_MODE=true; shift ;;
      --format) FORMAT="$2"; shift 2 ;;
      --quiet|-q) QUIET=true; shift ;;
      --dry-run) DRY_RUN=true; shift ;;
      --help|-h) show_help; exit 0 ;;
      -*)
        log_error "Unknown option: $1"
        exit 2
        ;;
      *)
        if [[ -z "$COMMAND" ]]; then
          COMMAND="$1"
        else
          ARGS+=("$1")
        fi
        shift
        ;;
    esac
  done
  
  case "$COMMAND" in
    init) cmd_init ;;
    login) cmd_login "${ARGS[0]}" ;;
    save) cmd_save "${ARGS[0]}" "${ARGS[1]:-}" ;;
    switch)
      case "${ARGS[0]:-}" in
        codex|iflow)
          cmd_switch "${ARGS[0]}" "${ARGS[1]:-}"
          ;;
        "")
          cmd_switch "codex" ""
          ;;
        *)
          log_warn "No ai tool name provided; defaulting to codex. If the target account belongs to another tool, switch may fail."
          cmd_switch "codex" "${ARGS[0]}"
          ;;
      esac
      ;;
    list) cmd_list ;;
    whoami) cmd_whoami "${ARGS[0]:-codex}" ;;
    status) cmd_status "${ARGS[0]:-codex}" ;;
    delete) cmd_delete "${ARGS[0]}" "${ARGS[1]}" ;;
    ""|--help|-h) show_help ;;
    *)
      log_error "Unknown command: $COMMAND"
      show_help
      exit 2
      ;;
  esac
}

main "$@"
