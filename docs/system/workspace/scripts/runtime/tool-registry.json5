{
  // ===========================================================================
  // Freely Tool Capability Registry
  // ===========================================================================
  // Each tool entry defines:
  //   acp        - ACP server binary, args, and resolution strategy
  //   permission - how permissions are read from slot config and applied
  //   session    - session lifecycle capabilities (fork, resume)
  //   model_default - default model when slot config doesn't specify one
  //   binary_resolution - how to find the ACP binary ("path" or "cache")
  //
  // To add a new tool: add one entry here, create slot config in ~/.ai-auth/.
  // No code changes needed.
  // ===========================================================================

  "claude": {
    "acp": {
      "binary": "claude-agent-acp",
      "args": [],
    },
    "permission": {
      // Field in slot settings.json: top-level "permissionMode" or nested "permissions.defaultMode"
      "config_field": "permissionMode",
      "fallback_field": "permissions.defaultMode",
      // How to apply: via ACP session/set_mode RPC (claude-agent-acp specific)
      "mechanism": "session_set_mode",
    },
    // How bridge env vars are discovered and passed for this tool
    "slot": {
      // alias_cli_arg: config path is a CLI flag (--settings <path>) in the alias
      "discovery": "alias_cli_arg",
      "alias_key": "--settings",
      "config_file": "settings.json",
      "is_dir": false,
      // claude-agent-acp receives config via --settings CLI arg; no extra env var needed
      "bridge_config_env": "",
      "post_init": "",
    },
    "session": {
      "supports_fork": true,
      "supports_resume": true,
    },
    "model_default": "claude-sonnet-4-6",
    // Binary is found via PATH (e.g. npm install -g @anthropic-ai/claude-code)
    "binary_resolution": "path",
    // CLI command to verify tool health for dead list resurrection
    "test_command": "claude -p 'say hi' --output-format text --dangerously-skip-permissions",
  },

  "codex": {
    "acp": {
      "binary": "codex-acp",
      "args": [],
      // Auto-download from GitHub releases if not cached
      "auto_download": true,
      "download_version": "0.15.0",
      "download_repo": "zed-industries/codex-acp",
    },
    "permission": {
      // Codex reads approval_policy + sandbox_mode from config.toml in slot dir.
      // CODEX_HOME env var already redirects to the slot directory.
      "mechanism": "slot_config_toml",
      "config_fields": ["approval_policy", "sandbox_mode"],
    },
    "slot": {
      // alias_env_var: config dir is an env var (CODEX_HOME="<dir>") in the alias
      "discovery": "alias_env_var",
      "alias_key": "CODEX_HOME",
      // No JSON config file to read for inline env vars (uses config.toml for sandbox)
      "config_file": "",
      "is_dir": true,
      // Bridge must export CODEX_HOME so the ACP subprocess finds its config dir
      "bridge_config_env": "CODEX_HOME",
      // Post-init: patch sandbox writable_roots in config.toml
      "post_init": "ensure_writable_roots",
    },
    "session": {
      "supports_fork": true,
      "supports_resume": true,
    },
    "model_default": "gpt-5.5",
    // Binary is cached at ~/.cache/freely/acp/codex-acp/<ver>/<triplet>/
    "binary_resolution": "cache",
    // CLI command to verify tool health for dead list resurrection
    "test_command": "codex exec 'say hi'",
  },

  "opencode": {
    "acp": {
      "binary": "opencode",
      "args": ["acp"],
    },
    "permission": {
      // opencode reads "permission" field from settings.json.
      // OPENCODE_CONFIG env var points to slot settings.json.
      "config_field": "permission",
      "mechanism": "env_var",
      "env_var": "OPENCODE_CONFIG",
    },
    "slot": {
      // alias_env_var: config path is an env var (OPENCODE_CONFIG="<path>") in the alias
      "discovery": "alias_env_var",
      "alias_key": "OPENCODE_CONFIG",
      "config_file": "settings.json",
      "is_dir": false,
      // Bridge MUST export OPENCODE_CONFIG so opencode acp finds its slot config at runtime
      "bridge_config_env": "OPENCODE_CONFIG",
      "post_init": "",
    },
    "session": {
      "supports_fork": true,
      "supports_resume": true,
    },
    "model_default": "deepseek-v4-flash-free",
    "binary_resolution": "path",
    // CLI command to verify tool health for dead list resurrection
    "test_command": "opencode run 'say hi'",
  },

  // Aliases: map alternative tool names to canonical entries above.
  // These tools share the same ACP binary and config as "claude".
  "_aliases": {
    "cc": "claude",
    "cc-use-codex-cli": "claude",
    "kiro-cli": "claude",
    "iflow": "claude",
  },
}

