#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-monitor-ai-codex-apikey-refresh-noise.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
HOME_DIR="$TMP_DIR/home"
MOCK_BIN="$TMP_DIR/mock-bin"
PROMPT_FILE="$TMP_DIR/prompt.txt"
PID_FILE="$TMP_DIR/child.pid"
LOG_FILE="$TMP_DIR/monitor.log"
MARKER_FILE="$TMP_DIR/failure.marker"

mkdir -p "$PROJECT" "$HOME_DIR/.codex" "$MOCK_BIN"
printf 'hi\n' >"$PROMPT_FILE"
cat >"$HOME_DIR/.codex/auth.json" <<'EOF'
{"OPENAI_API_KEY":"sk-test"}
EOF

cat >"$MOCK_BIN/codex" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "exec" ]]; then
  printf '2026-04-23T01:17:02.603724Z ERROR codex_login::auth::manager: Failed to refresh token: 401 Unauthorized: {\n' >&2
  printf 'codex\n'
  printf 'ok\n'
  exit 0
fi
exit 98
EOF
chmod +x "$MOCK_BIN/codex"

HOME="$HOME_DIR" \
PATH="$MOCK_BIN:$PATH" \
  bash "$ROOT_DIR/docs/system/workspace/scripts/monitor-ai-cli.sh" \
    --project "$PROJECT" \
    --tool codex \
    --tool-adapter direct \
    --model gpt-5.4 \
    --reasoning-effort medium \
    --tool-capabilities "" \
    --tool-policy "" \
    --codex-capability-model gpt-5.4 \
    --codex-capability-sandbox workspace-write \
    --codex-capability-approval-policy never \
    --codex-capability-cwd-mode project-root \
    --debug-log-file "$TMP_DIR/debug.log" \
    --claude-session-id "" \
    --tool-resume-target "" \
    --mode auto \
    --prompt-file "$PROMPT_FILE" \
    --pid-file "$PID_FILE" \
    --log-file "$LOG_FILE" \
    --failure-marker-file "$MARKER_FILE" \
    --launch-kind fresh >/dev/null 2>&1

[[ ! -f "$MARKER_FILE" ]]
grep -q 'Failed to refresh token: 401 Unauthorized' "$LOG_FILE"
grep -q '^codex$' "$LOG_FILE"
grep -q '^ok$' "$LOG_FILE"

echo "[PASS] monitor-ai-cli ignores Codex OAuth refresh 401 noise for live apikey auth"
