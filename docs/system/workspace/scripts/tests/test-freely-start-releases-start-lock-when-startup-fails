#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../../../../.." && pwd -P)"
FREELY_SCRIPT="$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"
PROJECT_DIR="/tmp/test-freely-start-lock"
LOCK_DIR="$PROJECT_DIR/.freely/run/project-start.lock"
HARNESS="/tmp/freely-test-harness.sh"

# Ensure we have a working freely script
[[ -f "$FREELY_SCRIPT" ]] || {
  echo "[ERROR] freely script not found: $FREELY_SCRIPT" >&2
  exit 1
}

cleanup() {
  rm -f "$HARNESS"
  rm -rf "$PROJECT_DIR"
}
trap cleanup EXIT

mkdir -p "$PROJECT_DIR/.freely/run"
export TEST_FREELY_SCRIPT="$FREELY_SCRIPT"

# Create test harness that overrides freely functions
cat > "$HARNESS" <<'HARNESS_EOF'
#!/usr/bin/env bash
set -euo pipefail
FREELY="${TEST_FREELY_SCRIPT:?}"
PROJECT="/tmp/test-freely-start-lock"
LOG="/tmp/harness-inner.log"

echo "HARNESS START PID=$$" > "$LOG"
BASH_SOURCE[0]="$FREELY"
echo "BASH_SOURCE set" >> "$LOG"

echo "sourcing freely..." >> "$LOG"
source "$FREELY" >> "$LOG" 2>&1
echo "sourced, $$=$$, SHELL_PID=$SHELL_PID" >> "$LOG"

resolve_project_or_fail() {
  echo "resolve_project_or_fail called" >> "$LOG"
  printf "%s\n" "$PROJECT"
}
append_runtime_event() { echo "append_runtime_event: $*" >> "$LOG"; return 0; }

# Mock start_project_runtime to fail after releasing lock
start_project_runtime() {
  echo "start_project_runtime called, releasing lock..." >> "$LOG"
  release_project_start_lock_for_runtime "$1" >> "$LOG" 2>&1
  echo "release done, returning 1" >> "$LOG"
  return 1
}

# Now call start command directly
cmd_start() {
  echo "cmd_start enter" >> "$LOG"
  local project="" force="0"
  project="$(resolve_project_or_fail "$project")"
  echo "project=$project" >> "$LOG"
  echo "acquiring lock..." >> "$LOG"
  acquire_project_start_lock_or_wait "$project" "freely_start" || exit 1
  echo "lock acquired" >> "$LOG"
  trap "release_project_start_lock_for_runtime '$project'" EXIT
  echo "trap set, calling start_project_runtime..." >> "$LOG"
  start_project_runtime "$project" "foreground"
  echo "start_project_runtime returned, exit now" >> "$LOG"
}

echo "calling cmd_start..." >> "$LOG"
cmd_start >> "$LOG" 2>&1
echo "cmd_start done, RC=$?" >> "$LOG"
echo "HARNESS END" >> "$LOG"
HARNESS_EOF

chmod +x "$HARNESS"
bash "$HARNESS" > /tmp/harness-outer.log 2>&1 &
child_pid=$!

# Wait with timeout
for _ in 1 2 3 4 5 6 7 8; do
  sleep 0.5
  if ! kill -0 "$child_pid" 2>/dev/null; then
    echo "[TEST] child exited naturally" >&2
    break
  fi
done

if kill -0 "$child_pid" 2>/dev/null; then
  echo "[TEST] child still running, killing..." >&2
  kill -9 "$child_pid" 2>/dev/null || true
  exit 1
fi

wait $child_pid 2>/dev/null || rc=$?
echo "[TEST] child exit code: $rc"
echo "=== outer log ===" >&2
cat /tmp/harness-outer.log >&2
echo "=== inner log ===" >&2
cat /tmp/harness-inner.log >&2

# Verify behavior
if [[ "$rc" -eq 0 || "$rc" -eq 1 ]]; then
  if [[ -d "$LOCK_DIR" ]]; then
    echo "FAIL: start lock not released (rc=$rc)"
    exit 1
  fi
  echo "[PASS] freely start releases start lock when startup fails"
else
  echo "FAIL: unexpected exit code $rc"
  exit 1
fi
