#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-stale-manager-continuity.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
mkdir -p "$PROJECT/docs/pre-brainstorms/20260322-0000--sample" "$PROJECT/.freely/run/worker-prompts"

git init -q -b develop "$PROJECT"
git -C "$PROJECT" config user.name "Freely Test"
git -C "$PROJECT" config user.email "freely@example.com"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/pre-brainstorms/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/pre-brainstorms/INDEX.md" <<'EOF'
# INDEX
- 20260322-0000--sample
EOF
cat >"$PROJECT/docs/pre-brainstorms/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/docs/pre-brainstorms/20260322-0000--sample/brainstorms.md" <<'EOF'
# Brainstorms
EOF
cat >"$PROJECT/docs/pre-brainstorms/20260322-0000--sample/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

git -C "$PROJECT" add .
git -C "$PROJECT" commit -q -m "init"

STALE_PROMPT="$PROJECT/.freely/run/worker-prompts/20260323-stale-worker-codex.txt"
cat >"$STALE_PROMPT" <<'EOF'
你现在运行在 Freely 的 worker 工位，不是主管工位。

你的 worktree：
- branch: `feature/missing-worker`

继续处理 delegated continuation。
EOF

STALE_CONT="$PROJECT/.freely/run/manager-continuity-20260323-stale.md"
cat >"$STALE_CONT" <<EOF
# Manager Continuity

- delegated worker prompt:
  - $STALE_PROMPT
EOF

NONWORKER_CONT="$PROJECT/.freely/run/manager-continuity-20260323-fresh.md"
cat >"$NONWORKER_CONT" <<'EOF'
# Manager Continuity

- no worker launch yet; first refresh patrol and regenerate continuity.
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

LATEST="$(latest_manager_continuity_file_for_project "$PROJECT")"
[[ "$LATEST" == "$NONWORKER_CONT" ]] || {
  echo "[FAIL] expected stale continuity with only missing worker targets to be skipped" >&2
  echo "latest=$LATEST" >&2
  exit 1
}

echo "[PASS] stale manager continuity is skipped when all worker prompts target missing worktrees"
