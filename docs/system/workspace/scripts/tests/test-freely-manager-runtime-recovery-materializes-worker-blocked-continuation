#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"

OUTPUT="$(
  bash -lc '
    set -euo pipefail
    source "'"$ROOT_DIR"'/docs/system/workspace/scripts/runtime/freely"

    root="$(mktemp -d /tmp/freely-worker-blocked-continuation.XXXXXX)"
    trap "rm -rf \"$root\"" EXIT
    project="$root/repo"
    worker="$root/feature-worker"
    mkdir -p "$project/.freely/run" "$project/.freely/logs" "$project/.freely/intake" "$project/.freely/interruption-resolutions"
    mkdir -p "$worker/.freely/run" "$worker/.freely/logs"
    : >"$project/.freely/config.env"
    : >"$worker/.freely/config.env"

    cat >"$worker/.freely/run/workcell-state.env" <<EOF
DESIRED_RUNTIME_STATE="running"
LAST_ROLE_HINT="worker"
LAST_EXIT_REASON="worker_exit_contract_blocked"
LAST_SUPERVISOR_STATE="down"
LAST_AI_STATE="down"
LAST_STATE_UPDATED_AT="2026-04-25T00:00:00Z"
EOF

    cat >"$worker/.freely/run/worker-verification-contract.env" <<EOF
OWNER_ISSUE="$worker/docs/B2-docs/sample/issues/sample.md"
VERIFICATION_ARTIFACT_DIR="$worker/docs/B2-docs/sample/code-reviews"
CLOSEOUT_GATE_COMMAND="./bin/freely daemon start --project $project"
CLOSEOUT_TARGET_LANE="manager review"
CLOSEOUT_PROMOTION_GATE="manager unblock decision"
EOF

    cat >"$worker/.freely/run/worker-exit-contract.env" <<EOF
EXIT_KIND="worker_blocked"
BLOCKED_REASON="verification artifact missing residual_risk"
EOF

    git() {
      if [[ "$1" == "-C" && "$3" == "rev-parse" && "$4" == "--show-toplevel" ]]; then
        printf "%s\n" "$project"
        return 0
      fi
      if [[ "$1" == "-C" && "$3" == "worktree" && "$4" == "list" && "$5" == "--porcelain" ]]; then
        cat <<EOF
worktree $project
branch refs/heads/develop

worktree $worker
branch refs/heads/feature-sample
EOF
        return 0
      fi
      command git "$@"
    }

    config_file() { printf "%s\n" "$1/.freely/config.env"; }
    intake_dir_for_project() { printf "%s\n" "$1/.freely/intake"; }
    interruption_resolution_dir_for_project() { printf "%s\n" "$1/.freely/interruption-resolutions"; }
    run_dir_for_project() { printf "%s\n" "$1/.freely/run"; }
    workcell_state_file() { printf "%s\n" "$1/.freely/run/workcell-state.env"; }
    worker_exit_contract_file() { printf "%s\n" "$1/.freely/run/worker-exit-contract.env"; }
    worker_verification_contract_file() { printf "%s\n" "$1/.freely/run/worker-verification-contract.env"; }
    manager_supervisor_pid_for_project() { return 1; }
    runtime_ai_pid_hint_for_project() { return 1; }
    reset_project_runtime_discovery_cache() { :; }
    effective_runtime_role_for_project() { [[ "$1" == "$project" ]] && printf "manager\n" || printf "worker\n"; }
    normalize_runtime_worktree_path() { printf "%s\n" "$1"; }
    latest_generated_manager_continuity_file_for_project() { return 0; }
    latest_patrol_authoritative_manager_continuity_file_for_project() { return 0; }
    manager_operator_stop_boundary_epoch_for_project() { printf "1714055970\n"; }
    manager_runtime_launch_workers_from_latest_handoff() { echo "0"; }
    project_has_authoritative_worktree_path() { return 0; }
    worker_project_is_absorbed_merged_lane() { return 1; }
    worker_project_is_retire_ready_merged_followthrough() { return 1; }
    worker_prompt_targets_retire_ready_merged_worktree() { return 1; }
    recover_stalled_worker_ai_if_needed() { return 1; }
    settle_retire_ready_merged_worker_runtime_state() { return 1; }
    manager_continuity_explicitly_freezes_worker_project() { return 1; }
    log_info() { :; }

    manager_runtime_recover_workers_if_needed "$project" >/dev/null

    intake_dir="$(find "$project/.freely/intake" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
    cat "$intake_dir/message.txt"
    cat "$intake_dir/meta.env"
  ' 2>&1
)"

[[ "$OUTPUT" == *"worker_terminal_kind: \`worker_blocked\`"* ]]
[[ "$OUTPUT" == *"verification artifact missing residual_risk"* ]]
[[ "$OUTPUT" == *'ABSORPTION_TARGET="handoff://continuation"'* ]]
[[ "$OUTPUT" == *'CLASSIFICATION="continuation"'* ]]

echo "[PASS] manager runtime materializes worker_blocked as a manager delegated continuation"
