#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
TARGET="$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

if rg -n "date '\\+(%F %T %Z|%Y-%m-%d %H:%M:%S %Z)'" "$TARGET" >/dev/null; then
  echo "[FAIL] runtime script still contains direct human display time formatting; use the shared helper instead" >&2
  exit 1
fi

echo "[PASS] runtime human display time formatting uses the shared helper"
