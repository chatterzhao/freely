#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-generated-handoff-stall.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
WORKER="$TMP_DIR/project-worktrees/feature-worker"
mkdir -p \
  "$PROJECT/docs/B1-docs/raw-20260322-0000" \
  "$PROJECT/.freely/run/worker-prompts" \
  "$PROJECT/.freely/logs" \
  "$WORKER/.freely/run"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
- 20260322-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260322-0000/brainstorms.md" <<'EOF'
# Brainstorms
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260322-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

sleep 999 >/dev/null 2>&1 &
AI_PID=$!
echo "$AI_PID" >"$PROJECT/.freely/run/ai.pid"
echo "$$" >"$PROJECT/.freely/run/supervisor.pid"

cat >"$PROJECT/.freely/run/prompt-20260323-170436.txt" <<'EOF'
主管模式提示

Delegated continuation handoff:
- intake_id=20260323-170455-loop-feature-manager-primary-han message=cleanup then continue
EOF
touch -t 202603231704 "$PROJECT/.freely/run/prompt-20260323-170436.txt"

WORKER_PROMPT="$PROJECT/.freely/run/worker-prompts/20260323-170438-worker-manager-delegated-continuation-stall-materialization-codex.txt"
cat >"$WORKER_PROMPT" <<EOF
You are the worker for candidate C-20260323-1705-A.

Branch:
- \`feature/manager-delegated-continuation-stall-materialization-20260323\`

你的 worktree：
- \`$WORKER\`
EOF
touch -t 202603231707 "$WORKER_PROMPT"

cat >"$PROJECT/.freely/run/manager-continuity-20260323-170438.md" <<EOF
# Manager Continuity
- fresh continuity after prompt
- worker_prompt: \`$WORKER_PROMPT\`
EOF
touch -t 202603231707 "$PROJECT/.freely/run/manager-continuity-20260323-170438.md"

touch "$PROJECT/.freely/logs/cycle-20260323-170436.log"
touch -t 202603231707 "$PROJECT/.freely/logs/cycle-20260323-170436.log"

cat >"$PROJECT/.freely/run/manager-worker-launch-state.env" <<'EOF'
LAST_MANAGER_CONTINUITY_GENERATED="/tmp/old-manager-continuity.md"
LAST_MANAGER_WORKER_PROMPTS_GENERATED="none"
LAST_MANAGER_CONTINUITY_CONSUMED="/tmp/old-manager-continuity.md"
LAST_MANAGER_WORKER_PROMPTS_CONSUMED="none"
LAUNCHED_WORKER_PROMPTS="none"
UPDATED_AT="2026-03-23T23:07:31Z"
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

PREEMPT_LOG="$TMP_DIR/preempt.log"
RESTART_LOG="$TMP_DIR/restart.log"
manager_ai_pid_for_project() {
  echo "$AI_PID"
}
request_local_continuation_reentry() {
  echo "$1|$2" >>"$PREEMPT_LOG"
  write_preemption_state "$1" "graceful_term" "local_continuation_reentry" "$2" "$AI_PID"
  kill "$AI_PID" 2>/dev/null || true
}
restart_manager_supervisor_preserving_handoff() {
  echo "$1" >>"$RESTART_LOG"
}
write_manager_bootstrap_handoff() {
  printf '%s|%s|%s\n' "$1" "$5" "$6" >>"$TMP_DIR/handoff.log"
}
codex_current_account() {
  echo "test@example.com"
}

if ! recover_stalled_manager_ai_if_needed "$PROJECT"; then
  echo "[FAIL] expected generated handoff stall recovery to trigger" >&2
  exit 1
fi

grep -q "$PROJECT|runtime-stalled-ai-recovery" "$PREEMPT_LOG"
grep -q "$PROJECT" "$RESTART_LOG"
grep -q 'manager_ai_stalled_after_delegated_continuation_prompt|relaunch-manager-after-stall-recovery' "$TMP_DIR/handoff.log"

echo "[PASS] generated handoff stall triggers runtime recovery"
