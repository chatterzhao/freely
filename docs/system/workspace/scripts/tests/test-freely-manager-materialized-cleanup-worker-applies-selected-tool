#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-materialized-cleanup-worker-selected-tool.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
WT_ROOT="$TMP_DIR/worktrees"
FEATURE_WT="$WT_ROOT/feature-cleanup"
PREMERGE_WT="$WT_ROOT/test-pre-merge-cleanup"
FEATURE_WT_REAL=""

mkdir -p "$PROJECT/.freely/run" "$PROJECT/.freely/logs" "$PROJECT/docs/B1-docs/raw-20260421-0000" "$WT_ROOT"
git init -q -b develop "$PROJECT"
git -C "$PROJECT" config user.name tester
git -C "$PROJECT" config user.email tester@example.com

cat >"$PROJECT/.gitignore" <<'EOF'
.freely/
EOF
cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
- 20260421-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260421-0000/brainstorms.md" <<'EOF'
# Brainstorms
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260421-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

mkdir -p "$PROJECT/docs/B2-docs/demo/cleanup-governance/issues" "$PROJECT/docs/B2-docs/demo/cleanup-governance/code-reviews" "$PROJECT/docs/progress/demo"
cat >"$PROJECT/docs/B2-docs/demo/cleanup-governance/issues/cleanup-governance.md" <<'EOF'
# Issue: cleanup-governance

- issue_id: `I-20260421-1330-A`
- pre_tests_path: `docs/B2-docs/demo/cleanup-governance/pre-tests.md`
- progress_path: `docs/progress/demo/p-cleanup-governance.md`
- verification_artifact_dir: `docs/B2-docs/demo/cleanup-governance/code-reviews`
EOF
cat >"$PROJECT/docs/B2-docs/demo/cleanup-governance/pre-tests.md" <<'EOF'
# Pre-tests
EOF
cat >"$PROJECT/docs/progress/demo/p-cleanup-governance.md" <<'EOF'
# Progress
EOF

echo base >"$PROJECT/README.md"
git -C "$PROJECT" add .
git -C "$PROJECT" commit -q -m init

git -C "$PROJECT" worktree add -q -b feature/cleanup "$FEATURE_WT" develop
git -C "$PROJECT" worktree add -q -b test-pre-merge-cleanup "$PREMERGE_WT" develop
FEATURE_WT_REAL="$(cd "$FEATURE_WT" && pwd -P)"

echo cleanup >"$FEATURE_WT/cleanup.txt"
git -C "$FEATURE_WT" add cleanup.txt
git -C "$FEATURE_WT" commit -q -m "cleanup fixture"
git -C "$PROJECT" merge --no-ff -m "merge cleanup fixture" feature/cleanup >/dev/null

mkdir -p "$PROJECT/.freely/run" "$PROJECT/.freely/logs" "$FEATURE_WT/.freely/run" "$FEATURE_WT/.freely/logs" "$PREMERGE_WT/.freely/run" "$PREMERGE_WT/.freely/logs"
cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF
cat >"$FEATURE_WT/.freely/config.env" <<EOF
PROJECT_ROOT="$FEATURE_WT"
INTENT_FILE="$FEATURE_WT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$FEATURE_WT/docs/CONSTITUTION.md"
AI_TOOL="cc-use-codex-cli"
AI_MODEL=""
AI_MODE="auto"
AI_REASONING_EFFORT="medium"
AI_TOOL_ADAPTER="direct"
AI_TOOL_ADAPTER_POLICY="direct"
AI_TOOL_CAPABILITIES="codex-cli"
AI_TOOL_POLICY="prefer-codex-for-repo-work"
EOF
cat >"$PREMERGE_WT/.freely/config.env" <<EOF
PROJECT_ROOT="$PREMERGE_WT"
INTENT_FILE="$PREMERGE_WT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PREMERGE_WT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

cat >"$PROJECT/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="up"
LAST_AI_STATE="up"
LAST_EXIT_REASON="ai_exit_rc_0"
LAST_ROLE_HINT="manager"
LAST_STATE_UPDATED_AT="2026-04-21T18:49:39Z"
EOF

for wt in "$FEATURE_WT" "$PREMERGE_WT"; do
  cat >"$wt/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="stopped"
LAST_SUPERVISOR_STATE="down"
LAST_AI_STATE="down"
LAST_EXIT_REASON="operator_stop"
LAST_ROLE_HINT="worker"
LAST_STATE_UPDATED_AT="2026-04-21T18:49:39Z"
EOF
done

CONTINUITY="$PROJECT/.freely/run/manager-continuity-20260421-184939.md"
cat >"$CONTINUITY" <<EOF
# Manager Continuity

## Primary Judgement

- route_kind: \`cleanup_governance\`
- selected_tool: \`codex\`
- next_action: \`decide retirement handoff for retained merged worktrees\`

## Why This Route

- selected_source: \`I-20260421-1330-A\`

## Evidence

- issue_truth: \`docs/B2-docs/demo/cleanup-governance/issues/cleanup-governance.md\`
- progress_truth: \`docs/progress/demo/p-cleanup-governance.md\`

## Fleet Inventory

- manager_lane:
  - path: \`$PROJECT\`
    branch: \`develop\`
    clean_state: \`CLEAN\`
    desired: \`running\`
    role: \`manager\`
- selected_cleanup_family:
  - path: \`$FEATURE_WT\`
    branch: \`feature/cleanup\`
    clean_state: \`CLEAN\`
    desired: \`stopped\`
    role_hint: \`cleanup\`
  - path: \`$PREMERGE_WT\`
    branch: \`test-pre-merge-cleanup\`
    clean_state: \`CLEAN\`
    desired: \`stopped\`
    role_hint: \`manager/premerge\`

## Queue

- cleanup_queue:
  - lane_slug: \`cleanup-governance\`
    issue_id: \`I-20260421-1330-A\`
    status: \`manager_reconcile_required\`
    next_action: \`materialize cleanup followthrough worker\`

## Worker Prompts

- launched: \`none\`
- prompt_paths: \`none\`
- reason: \`cleanup worker has not been materialized yet\`
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

START_LOG="$TMP_DIR/start.log"
start_workcell_supervisor_async() {
  printf '%s\n' "$1" >>"$START_LOG"
  return 0
}

LAUNCHED="$(manager_runtime_launch_workers_from_latest_handoff "$PROJECT")"
[[ "$LAUNCHED" == "1" ]] || {
  echo "[FAIL] expected one materialized cleanup worker launch, got $LAUNCHED" >&2
  exit 1
}

PROMPT_FILE="$(find "$PROJECT/.freely/run/worker-prompts" -type f | head -n 1)"
[[ -n "$PROMPT_FILE" && -f "$PROMPT_FILE" ]] || {
  echo "[FAIL] expected a materialized cleanup worker prompt" >&2
  exit 1
}

grep -Fq -- '- selected_tool: `codex`' "$PROMPT_FILE"
grep -q '^AI_TOOL="codex"$' "$FEATURE_WT/.freely/config.env"
grep -q '^AI_MODEL="gpt-5.4"$' "$FEATURE_WT/.freely/config.env"
grep -q '^VERIFICATION_METADATA_PRESENT="true"$' "$FEATURE_WT/.freely/run/worker-verification-contract.env"
grep -q '^OWNER_ISSUE="'"$FEATURE_WT"'/docs/B2-docs/demo/cleanup-governance/issues/cleanup-governance.md"$' "$FEATURE_WT/.freely/run/worker-verification-contract.env"
grep -q '^'"$FEATURE_WT_REAL"'$' "$START_LOG"

echo "[PASS] materialized cleanup worker prompt carries selected_tool and corrects stale worker tool state before launch"
