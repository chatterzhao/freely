#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-sync-tooling-into-worktree.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

make_project() {
  local project="$1"
  mkdir -p "$project/docs/B1-docs/raw-20260320-0018"
  git init -q -b develop "$project"
  mkdir -p "$project/.githooks"
  cat >"$project/.githooks/pre-commit" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
  chmod +x "$project/.githooks/pre-commit"

  cat >"$project/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF

  cat >"$project/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF

  cat >"$project/docs/LAWS.md" <<'EOF'
# Laws
EOF

  cat >"$project/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF

  cat >"$project/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260320-0018--sample
EOF

  cat >"$project/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF

  cat >"$project/docs/B1-docs/raw-20260320-0018/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF

  cat >"$project/docs/B1-docs/raw-20260320-0018/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

  cat >"$project/.gitignore" <<'EOF'
.freely/
.codex/
.claude/
.iflow/
EOF

  git -C "$project" add .
  git -C "$project" -c user.name="Freely Test" -c user.email="freely-test@example.com" commit -q -m "Initial test project"
}

FREELY_HOME="$TMP_DIR/freely-home"
mkdir -p "$FREELY_HOME"

PROJECT="$TMP_DIR/project"
WORKTREES_ROOT="${PROJECT}-worktrees"
WORKTREE="$WORKTREES_ROOT/20260403-feature-sync-proof"
make_project "$PROJECT"

FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" init \
  --project "$PROJECT" \
  --intent "$PROJECT/docs/PROJECT_INTENT.md" \
  --constitution "$PROJECT/docs/CONSTITUTION.md" \
  --ai codex:gpt-5.4:auto \
  --accept-default-autonomy \
  >/dev/null

git -C "$PROJECT" worktree add -q -b feature/sync-proof "$WORKTREE" develop

test ! -e "$WORKTREE/.freely/config.env"
test ! -e "$WORKTREE/.freely/bin/codex"
test ! -e "$WORKTREE/.freely/tool-boundary-bootstrap.md"

FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" sync-tooling \
  --source-project "$PROJECT" \
  --project "$WORKTREE" \
  >/dev/null

WORKTREE_CONFIG="$WORKTREE/.freely/config.env"
WORKTREE_CODEX_CONFIG="$WORKTREE/.codex/config.toml"
WORKTREE_BOOTSTRAP="$WORKTREE/.freely/tool-boundary-bootstrap.md"
WORKTREE_WRAPPER_DIR="$WORKTREE/.freely/bin"

test -f "$WORKTREE_CONFIG"
test -f "$WORKTREE_CODEX_CONFIG"
test -f "$WORKTREE_BOOTSTRAP"
test -x "$WORKTREE_WRAPPER_DIR/codex"
test -x "$WORKTREE_WRAPPER_DIR/claude"
test -x "$WORKTREE_WRAPPER_DIR/iflow"
grep -q '^AI_TOOL="codex"$' "$WORKTREE_CONFIG"
grep -Fq "writable_roots = [\"$WORKTREES_ROOT\"]" "$WORKTREE_CODEX_CONFIG"
grep -Fq -- "--add-dir \"$WORKTREES_ROOT\"" "$WORKTREE_WRAPPER_DIR/codex"
grep -Fq "\`$WORKTREE\`" "$WORKTREE_BOOTSTRAP"
grep -Fq "\`$WORKTREES_ROOT\`" "$WORKTREE_BOOTSTRAP"

echo "[PASS] freely sync-tooling rematerializes managed tool boundaries into a new worktree even when local tool dirs are ignored"
