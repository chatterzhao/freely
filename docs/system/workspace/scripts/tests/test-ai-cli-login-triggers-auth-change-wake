#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/ai-cli-login-auth-change.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

HOME_DIR="$TMP_DIR/home"
MOCK_BIN="$TMP_DIR/mock-bin"
WAKE_LOG="$TMP_DIR/wake.log"
mkdir -p "$HOME_DIR/.codex" "$HOME_DIR/.ai-auth" "$MOCK_BIN"

cat >"$MOCK_BIN/codex" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "login" ]]; then
  cat >"$HOME/.codex/auth.json" <<'JSON'
{"tokens":{"access_token":"token","id_token":"x.eyJlbWFpbCI6ImxvZ2luQGV4YW1wbGUuY29tIn0.y"}}
JSON
  exit 0
fi
echo "{}"
EOF
chmod +x "$MOCK_BIN/codex"

cat >"$MOCK_BIN/freely-auth-wake" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${WAKE_LOG:?}"
EOF
chmod +x "$MOCK_BIN/freely-auth-wake"

HOME="$HOME_DIR" WAKE_LOG="$WAKE_LOG" FREELY_AUTH_CHANGE_WAKE_BIN="$MOCK_BIN/freely-auth-wake" PATH="$MOCK_BIN:$PATH" \
  bash "$ROOT_DIR/bin/ai" --yes login codex >/dev/null

for _ in $(seq 1 20); do
  [[ -f "$WAKE_LOG" ]] && break
  sleep 0.1
done

test -f "$HOME_DIR/.ai-auth/codex-login@example-com-1/auth.json"
grep -q '^auth-change-wake --tool codex --slot login@example-com-1 --reason login_success$' "$WAKE_LOG"

echo "[PASS] ai login codex emits auth-change wake after saving the new slot"
