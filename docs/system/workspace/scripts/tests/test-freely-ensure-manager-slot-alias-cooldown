printf '%s\n' "$*" >>"$log_file"

slot_to_account() {
  python3 - "$1" <<'PY'
import re
import sys

slot = sys.argv[1]
base = re.sub(r'-[0-9]+$', '', slot)
if '@' not in base:
    print(base)
    raise SystemExit(0)

local_part, domain_part = base.split('@', 1)
if '-' not in domain_part:
    print(base)
    raise SystemExit(0)

domain_name, tld = domain_part.rsplit('-', 1)
print(f"{local_part}@{domain_name}.{tld}")
PY
}

cmd=""
for arg in "$@"; do
  case "$arg" in
    switch|whoami|list)
      cmd="$arg"
      break
      ;;
  esac
done

  case "$cmd" in
  whoami)
    active_slot="$(cat "$state_file" 2>/dev/null || true)"
    echo "{\"tool\":\"codex\",\"account\":\"$(slot_to_account "$active_slot")\",\"slot\":\"$active_slot\"}"
    ;;
  list)
    echo '{"accounts":["codex-same@example-com-1","codex-same@example-com-2"]}'
    ;;
  switch)
    args=("$@")
    for ((i=0; i<${#args[@]}; i++)); do
      if [[ "${args[$i]}" == "switch" ]]; then
        requested_slot="${args[$((i+2))]}"
        printf '%s' "$requested_slot" >"$state_file"
        requested_account="$(slot_to_account "$requested_slot")"
        echo "{\"switched\": true, \"tool\": \"${args[$((i+1))]}\", \"account\": \"$requested_account\", \"slot\": \"$requested_slot\"}"
        exit 0
      fi
    done
    ;;
esac

echo '{}'
EOF
chmod +x "$PROJECT/bin/ai"

