cat >"$MOCK_BIN/curl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

output_file=""
auth_header=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --connect-timeout|--max-time)
      shift 2
      ;;
    -o)
      output_file="$2"
      shift 2
      ;;
    -H)
      if [[ "$2" == Authorization:\ Bearer* ]]; then
        auth_header="$2"
      fi
      shift 2
      ;;
    -w)
      shift 2
      ;;
    -s|-S|-sS)
      shift
      ;;
    *)
      shift
      ;;
  esac
done

token="${auth_header#Authorization: Bearer }"
case "$token" in
