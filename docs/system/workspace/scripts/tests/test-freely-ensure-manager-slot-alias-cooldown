export AI_SWITCH_LOG="$AI_SWITCH_LOG"

log_info() { :; }
log_warn() { :; }
log_error() { printf '%s\n' "$*" >&2; }

ai_cli_bin_for_project() {
  printf '%s/bin/ai\n' "$1"
}

codex_slot_cooldown_file() {
  printf '%s/.freely/run/codex-slot-cooldowns.tsv\n' "$1"
}

seconds_until_epoch() {
  local target="$1" now
  now="$(date +%s)"
  if (( target <= now )); then
    printf '0\n'
  else
    printf '%s\n' "$((target - now))"
  fi
}

source "$ROOT_DIR/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"

current_identity="$(codex_current_cooldown_identity "$PROJECT")"
[[ "$current_identity" == "same@example-com-1" ]]

selector_result="$(select_any_available_codex_slot "$PROJECT" "$current_identity")"
[[ "$selector_result" == "same@example-com-2" ]]

codex_record_slot_cooldown "$PROJECT" "$current_identity" "4102444800"
grep -q '^same@example-com-1[[:space:]]' "$PROJECT/.freely/run/codex-slot-cooldowns.tsv"

AI_SWITCH_STATE="$AI_STATE" \
AI_SWITCH_LOG="$AI_SWITCH_LOG" \
LAUNCH_LOG="$LAUNCH_LOG" \
FREELY_ENSURE_MANAGER_LAUNCH_BIN="$MOCK_BIN/launch-freely" \
PATH="$MOCK_BIN:$PATH" \
  bash "$ROOT_DIR/bin/freely" ensure-manager --project "$PROJECT" >/dev/null

grep -q 'switch codex same@example-com-2 --yes' "$AI_SWITCH_LOG"
grep -q "start --project $PROJECT" "$LAUNCH_LOG"
grep -q '^same@example-com-2$' "$AI_STATE"

echo "[PASS] freely ensure-manager keeps cooldown identity slot-first and slot-only"
