#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-wt-fleet-status.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

REPO="$TMP_DIR/repo"
mkdir -p "$REPO"
cd "$REPO"

git init -q -b develop
git config user.name tester
git config user.email tester@example.com

echo base > README.md
git add README.md
git commit -q -m "init"

mkdir -p "$REPO/bin"
cp "$ROOT_DIR/bin/checkpoint-guard" "$REPO/bin/checkpoint-guard"
chmod +x "$REPO/bin/checkpoint-guard"

git worktree add -q -b feature/demo-a "$TMP_DIR/repo-worktrees/feature-demo-a" develop
git worktree add -q -b feature/demo-b "$TMP_DIR/repo-worktrees/feature-demo-b" develop

echo dirty > "$TMP_DIR/repo-worktrees/feature-demo-a/demo.txt"

mkdir -p "$TMP_DIR/repo-worktrees/feature-demo-a/.freely/run" "$TMP_DIR/repo-worktrees/feature-demo-b/.freely/run"
cat >"$TMP_DIR/repo-worktrees/feature-demo-a/.freely/run/session-state.env" <<'EOF'
LAST_PHASE_HINT="in_dev"
LAST_ISSUE_HINT="Probe Bridge"
EOF
cat >"$TMP_DIR/repo-worktrees/feature-demo-a/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_ROLE_HINT="worker"
LAST_EXIT_REASON="ai_exit_rc_0"
EOF
cat >"$TMP_DIR/repo-worktrees/feature-demo-b/.freely/run/session-state.env" <<'EOF'
LAST_PHASE_HINT="done_ibm"
LAST_ISSUE_HINT="Boundary Contract"
EOF
cat >"$TMP_DIR/repo-worktrees/feature-demo-b/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="stopped"
LAST_ROLE_HINT="worker"
LAST_EXIT_REASON="operator_stop"
EOF

OUTPUT="$(bash "$ROOT_DIR/bin/wt-fleet-status" --project "$REPO")"
printf '%s\n' "$OUTPUT" | grep -q 'CHECKPOINT'
printf '%s\n' "$OUTPUT" | grep -q 'feature/demo-a'
printf '%s\n' "$OUTPUT" | grep -q 'feature/demo-b'
printf '%s\n' "$OUTPUT" | grep -q 'DIRTY'
printf '%s\n' "$OUTPUT" | grep -q 'running'
printf '%s\n' "$OUTPUT" | grep -q 'worker'
printf '%s\n' "$OUTPUT" | grep -q 'Probe Bridge'
printf '%s\n' "$OUTPUT" | grep -q 'Boundary Contract'

echo "[PASS] wt-fleet-status reports runtime-backed phase, issue, and desired runtime hints"
