#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-start-ps-unverified.XXXXXX)"
cleanup() {
  set +e
  kill "${SUP_PID:-}" "${DISPATCH_PID:-}" "${WATCHDOG_PID:-}" "${AI_PID:-}" 2>/dev/null || true
  wait "${SUP_PID:-}" 2>/dev/null || true
  wait "${DISPATCH_PID:-}" 2>/dev/null || true
  wait "${WATCHDOG_PID:-}" 2>/dev/null || true
  wait "${AI_PID:-}" 2>/dev/null || true
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

PROJECT="$TMP_DIR/repo"
FAKE_BIN_DIR="$TMP_DIR/fake-bin"
mkdir -p "$PROJECT/.freely/run" "$PROJECT/docs/pre-brainstorms" "$FAKE_BIN_DIR"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
AI_REASONING_EFFORT="medium"
EOF
cat >"$PROJECT/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="up"
LAST_AI_STATE="up"
LAST_EXIT_REASON="none"
LAST_ROLE_HINT="manager"
LAST_STATE_UPDATED_AT="2026-04-03T22:55:00Z"
EOF

bash -c "cd '$PROJECT' && exec -a 'runtime/freely start --project $PROJECT' sleep 30" >/dev/null 2>&1 &
SUP_PID=$!
bash -c "cd '$PROJECT' && exec -a 'runtime/freely ensure-interruption-dispatch --project $PROJECT --watch' sleep 30" >/dev/null 2>&1 &
DISPATCH_PID=$!
bash -c "cd '$PROJECT' && exec -a 'runtime/freely ensure-manager --project $PROJECT --watch' sleep 30" >/dev/null 2>&1 &
WATCHDOG_PID=$!
bash -c "cd '$PROJECT' && exec -a 'codex exec -C $PROJECT -m gpt-5.4' sleep 30" >/dev/null 2>&1 &
AI_PID=$!

printf '%s' "$SUP_PID" >"$PROJECT/.freely/run/supervisor.pid"
printf '%s' "$DISPATCH_PID" >"$PROJECT/.freely/run/interruption-dispatch.pid"
printf '%s' "$WATCHDOG_PID" >"$PROJECT/.freely/run/ensure-manager.pid"
printf '%s' "$AI_PID" >"$PROJECT/.freely/run/ai.pid"

cat >"$FAKE_BIN_DIR/ps" <<'EOF'
#!/usr/bin/env bash
exit 1
EOF
chmod +x "$FAKE_BIN_DIR/ps"

cat >"$FAKE_BIN_DIR/lsof" <<'EOF'
#!/usr/bin/env bash
exit 1
EOF
chmod +x "$FAKE_BIN_DIR/lsof"

if PATH="$FAKE_BIN_DIR:$PATH" bash "$ROOT_DIR/bin/freely" start --project "$PROJECT" >"$TMP_DIR/start.out" 2>&1; then
  echo "[FAIL] freely start should refuse unverified pid-file reuse when ps and cwd inspection are unavailable" >&2
  cat "$TMP_DIR/start.out" >&2
  exit 1
fi

grep -q 'runtime pid files remain unverified' "$TMP_DIR/start.out"
grep -q 'supervisor' "$TMP_DIR/start.out"
grep -q 'manager_watchdog' "$TMP_DIR/start.out"
grep -q 'interruption_dispatcher' "$TMP_DIR/start.out"
grep -q 'ai' "$TMP_DIR/start.out"
grep -q 'LAST_EXIT_REASON="none"' "$PROJECT/.freely/run/workcell-state.env"

echo "[PASS] freely start refuses unverified pid-file reuse when process ownership proof is unavailable"
