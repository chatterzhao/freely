#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-init-ai-default-precedence.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

make_project() {
  local project="$1"
  mkdir -p "$project/docs/B1-docs/raw-20260320-0018"
  git init -q -b develop "$project"
  mkdir -p "$project/.githooks"
  cat >"$project/.githooks/pre-commit" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
  chmod +x "$project/.githooks/pre-commit"

  cat >"$project/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF

  cat >"$project/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF

  cat >"$project/docs/LAWS.md" <<'EOF'
# Laws
EOF

  cat >"$project/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF

  cat >"$project/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260320-0018--sample
EOF

  cat >"$project/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF

  cat >"$project/docs/B1-docs/raw-20260320-0018/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF

  cat >"$project/docs/B1-docs/raw-20260320-0018/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF
}

FREELY_HOME="$TMP_DIR/freely-home"
mkdir -p "$FREELY_HOME"

cat >"$FREELY_HOME/config.env" <<'EOF'
AGENT_AI_TOOL="cc"
AI_MODEL=""
AI_MODE="auto"
AI_TOOL_ADAPTER="acp"
AI_TOOL_ADAPTER_POLICY="acp"
EOF

PROJECT_GLOBAL="$TMP_DIR/project-global"
make_project "$PROJECT_GLOBAL"
cd "$PROJECT_GLOBAL"
FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" init \
  --project "$PROJECT_GLOBAL" \
  --intent "$PROJECT_GLOBAL/docs/PROJECT_INTENT.md" \
  --constitution "$PROJECT_GLOBAL/docs/CONSTITUTION.md" \
  --accept-default-autonomy \
  >"$TMP_DIR/project-global-init.stdout" 2>"$TMP_DIR/project-global-init.stderr"
PROJECT_GLOBAL_CANON="$(cd "$PROJECT_GLOBAL" && pwd -P)"

test -f "$PROJECT_GLOBAL_CANON/AGENTS.md"
grep -q '^# Project Agent Entry$' "$PROJECT_GLOBAL_CANON/AGENTS.md"
grep -q '^security_review_policy: advisory-on-high-risk-or-uncertainty$' "$TMP_DIR/project-global-init.stdout"
grep -q '^security_review_scope: execution-boundary-and-reviewer-support$' "$TMP_DIR/project-global-init.stdout"
grep -q '^AGENT_AI_TOOL="cc"$' "$PROJECT_GLOBAL_CANON/.freely/config.env"
grep -q '^AI_TOOL_ADAPTER="acp"$' "$PROJECT_GLOBAL_CANON/.freely/config.env"
grep -q '^AI_TOOL_ADAPTER_POLICY="acp"$' "$PROJECT_GLOBAL_CANON/.freely/config.env"
grep -q '^FREELY_SECURITY_REVIEW_POLICY="advisory-on-high-risk-or-uncertainty"$' "$PROJECT_GLOBAL_CANON/.freely/config.env"
grep -q '^FREELY_SECURITY_REVIEW_SCOPE="execution-boundary-and-reviewer-support"$' "$PROJECT_GLOBAL_CANON/.freely/config.env"
grep -q '^AI_TOOL_CAPABILITIES=""$' "$PROJECT_GLOBAL_CANON/.freely/config.env"

PROJECT_OVERRIDE="$TMP_DIR/project-override"
make_project "$PROJECT_OVERRIDE"
cd "$PROJECT_OVERRIDE"
FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" init \
  --project "$PROJECT_OVERRIDE" \
  --intent "$PROJECT_OVERRIDE/docs/PROJECT_INTENT.md" \
  --constitution "$PROJECT_OVERRIDE/docs/CONSTITUTION.md" \
  --ai iflow:auto \
  --accept-default-autonomy \
  >/dev/null
PROJECT_OVERRIDE_CANON="$(cd "$PROJECT_OVERRIDE" && pwd -P)"

grep -q '^AGENT_AI_TOOL="iflow"$' "$PROJECT_OVERRIDE_CANON/.freely/config.env"
grep -q '^AI_TOOL_ADAPTER="direct"$' "$PROJECT_OVERRIDE_CANON/.freely/config.env"
grep -q '^AI_TOOL_ADAPTER_POLICY="direct"$' "$PROJECT_OVERRIDE_CANON/.freely/config.env"
grep -q '^AI_TOOL_CAPABILITIES=""$' "$PROJECT_OVERRIDE_CANON/.freely/config.env"

PROJECT_REINIT="$TMP_DIR/project-reinit"
make_project "$PROJECT_REINIT"
cd "$PROJECT_REINIT"
FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" init \
  --project "$PROJECT_REINIT" \
  --intent "$PROJECT_REINIT/docs/PROJECT_INTENT.md" \
  --constitution "$PROJECT_REINIT/docs/CONSTITUTION.md" \
  --ai codex:gpt-5.4:auto \
  --tool-adapter acp \
  --accept-default-autonomy \
  >/dev/null
FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" init \
  --project "$PROJECT_REINIT" \
  --intent "$PROJECT_REINIT/docs/PROJECT_INTENT.md" \
  --constitution "$PROJECT_REINIT/docs/CONSTITUTION.md" \
  --force \
  --accept-default-autonomy \
  >/dev/null
PROJECT_REINIT_CANON="$(cd "$PROJECT_REINIT" && pwd -P)"

grep -q '^AGENT_AI_TOOL="codex"$' "$PROJECT_REINIT_CANON/.freely/config.env"
grep -q '^AI_MODEL="gpt-5.4"$' "$PROJECT_REINIT_CANON/.freely/config.env"
grep -q '^AI_TOOL_ADAPTER="acp"$' "$PROJECT_REINIT_CANON/.freely/config.env"
grep -q '^AI_TOOL_ADAPTER_POLICY="acp"$' "$PROJECT_REINIT_CANON/.freely/config.env"

echo "[PASS] freely init resolves AI defaults with precedence: explicit > project > global"
