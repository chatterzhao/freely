#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-delegated-stall.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
mkdir -p "$PROJECT/docs/B1-docs/raw-20260322-0000" "$PROJECT/.freely/run" "$PROJECT/.freely/logs"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
- 20260322-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260322-0000/brainstorms.md" <<'EOF'
# Brainstorms
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260322-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

sleep 999 >/dev/null 2>&1 &
AI_PID=$!
echo "$AI_PID" >"$PROJECT/.freely/run/ai.pid"
echo "$$" >"$PROJECT/.freely/run/supervisor.pid"

cat >"$PROJECT/.freely/run/prompt-20260323-164204.txt" <<'EOF'
主管模式提示

Delegated continuation handoff:
- intake_id=20260323-080430-feature-three-loop-lifecycle-dic message=cleanup followthrough
EOF
touch -t 202603231640 "$PROJECT/.freely/run/prompt-20260323-164204.txt"

cat >"$PROJECT/.freely/run/manager-continuity-20260322-015940.md" <<'EOF'
# Manager Continuity
- old continuity
EOF
touch -t 202603221600 "$PROJECT/.freely/run/manager-continuity-20260322-015940.md"

touch "$PROJECT/.freely/logs/cycle-20260323-164204.log"
touch -t 202603231641 "$PROJECT/.freely/logs/cycle-20260323-164204.log"

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

PREEMPT_LOG="$TMP_DIR/preempt.log"
RESTART_LOG="$TMP_DIR/restart.log"
manager_ai_pid_for_project() {
  echo "$AI_PID"
}
request_local_continuation_reentry() {
  echo "$1|$2" >>"$PREEMPT_LOG"
  write_preemption_state "$1" "graceful_term" "local_continuation_reentry" "$2" "$AI_PID"
  kill "$AI_PID" 2>/dev/null || true
}
restart_manager_supervisor_preserving_handoff() {
  echo "$1" >>"$RESTART_LOG"
}
write_manager_bootstrap_handoff() {
  printf '%s|%s|%s\n' "$1" "$5" "$6" >>"$TMP_DIR/handoff.log"
}
codex_current_account() {
  echo "test@example.com"
}

if ! recover_stalled_manager_ai_if_needed "$PROJECT"; then
  echo "[FAIL] expected delegated continuation stall recovery to trigger" >&2
  exit 1
fi

grep -q "$PROJECT|runtime-stalled-ai-recovery" "$PREEMPT_LOG"
grep -q "$PROJECT" "$RESTART_LOG"
grep -q 'manager_ai_stalled_after_delegated_continuation_prompt|relaunch-manager-after-stall-recovery' "$TMP_DIR/handoff.log"
grep -q '^LAST_PREEMPTION_REASON="local_continuation_reentry"$' "$PROJECT/.freely/run/preemption-state.env"

echo "[PASS] delegated continuation prompt stall triggers runtime recovery"
