#!/usr/bin/env bash
# TC-11: worker_pid survives handoff re-entry / re-launch (state persistence)
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
HANDOFF_PY="$ROOT_DIR/docs/system/workspace/scripts/runtime/handoff.py"

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
db="$tmpdir/test.db"

python3 "$HANDOFF_PY" init --db "$db"

# Insert a handoff record with worker_pid
python3 -c "
import sqlite3
from datetime import datetime, timezone
conn = sqlite3.connect('$db')
now = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')

conn.execute(\"\"\"INSERT INTO handoffs (handoff_id, role, raw_key, prompt_file, status, worker_pid, created_at, updated_at)
  VALUES ('PIDTEST', 'worker', 'test-raw', '/tmp/pidtest', 'launched', '12345', ?, ?)\"\"\", (now, now))
conn.commit()
conn.close()
"

# Simulate session rotation: close and reopen the DB
python3 -c "
import sqlite3
conn = sqlite3.connect('$db')
row = conn.execute('SELECT worker_pid FROM handoffs WHERE handoff_id=?', ('PIDTEST',)).fetchone()
conn.close()
assert row is not None, 'Record not found after re-connect'
assert row[0] == '12345', f'Expected 12345, got {row[0]}'
print(f'worker_pid={row[0]} (persisted)')
"

echo "[PASS] worker_pid survives DB re-connect / session rotation"
