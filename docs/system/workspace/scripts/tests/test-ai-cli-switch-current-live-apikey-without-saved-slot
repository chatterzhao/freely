#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-ai-switch-current-live-apikey.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
HOME_DIR="$TMP_DIR/home"
mkdir -p "$PROJECT/.freely" "$PROJECT/.ai-auth/codex" "$HOME_DIR/.codex"

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
AGENT_AI_TOOL="codex"
EOF

cat >"$HOME_DIR/.codex/auth.json" <<'EOF'
{
  "OPENAI_API_KEY": "sk-live"
}
EOF

cat >"$HOME_DIR/.codex/config.toml" <<'EOF'
model_provider = "custom"

[model_providers.custom]
name = "custom"
base_url = "https://api.openai.com/v1"
wire_api = "responses"
requires_openai_auth = false
EOF

bash -lc '
  set -euo pipefail
  source "'"$ROOT_DIR"'/docs/system/workspace/scripts/runtime/ai-cli"
  export HOME="'"$HOME_DIR"'"
  export PROJECT_ROOT="'"$PROJECT"'"
  codex_probe_current_slot_now() { echo usable; }
  source_watchdog_script_or_fail() { return 0; }
  codex_saved_slots_include_kind() { return 1; }
  output="$(FORMAT=json _cmd_switch_auto_codex)"
  printf "%s" "$output" | rg -q "\"status\": \"usable_current_auth\""
  printf "%s" "$output" | rg -q "\"slot\": null"
'

echo "[PASS] ai switch codex accepts a usable current live apikey auth without saved-slot inventory"
