#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-codex-first-usable.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
HOME_DIR="$TMP_DIR/home"
mkdir -p "$PROJECT/.freely/run" "$HOME_DIR/.codex"

bash -lc '
  set -euo pipefail
  export HOME="'"$HOME_DIR"'"
  log_info() { :; }
  log_warn() { :; }
  log_error() { :; }
  source "'"$ROOT_DIR"'/docs/system/workspace/skills/freely-freely-watchdog-control-plane/scripts/availability-watchdog.sh"
  attempts_log="'"$TMP_DIR"'/attempts.log"
  codex_current_slot() { echo "slot-current"; }
  read_codex_active_slot() { echo "slot-current"; }
  codex_active_auth_file() { echo "'"$TMP_DIR"'/auth.json"; }
  codex_saved_slots() {
    printf "%s\n" "slot-bad" "slot-good" "slot-later"
  }
  switch_to_codex_slot() {
    local _project="$1" slot="$2"
    printf "%s\n" "$slot" >>"$attempts_log"
    printf "%s\n" "$slot" >"'"$TMP_DIR"'/current-slot"
    return 0
  }
  codex_probe_current_slot_now() {
    local current
    current="$(cat "'"$TMP_DIR"'/current-slot")"
    case "$current" in
      slot-bad) echo network_failure ;;
      slot-good) echo usable ;;
      slot-later)
        echo "[FAIL] exec-truth recovery should stop once the first usable slot is found" >&2
        exit 1
        ;;
    esac
  }
  result="$(codex_exec_saved_slot_truth "'"$PROJECT"'" "slot-current")"
  [[ "$result" == "usable:slot-good" ]] || {
    echo "[FAIL] expected first usable slot to be selected, got: $result" >&2
    exit 1
  }
  [[ "$(cat "$attempts_log")" == $'"'"'slot-bad\nslot-good'"'"' ]] || {
    echo "[FAIL] expected attempts to stop after the first usable slot" >&2
    cat "$attempts_log" >&2
    exit 1
  }
'

echo "[PASS] codex exec-truth recovery stops at the first usable slot instead of sweeping the entire inventory"
