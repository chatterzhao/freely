#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-worker-restart-selected-tool.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
WORKER_WT="$TMP_DIR/worker-wt"
mkdir -p "$PROJECT/docs/B1-docs/raw-20260322-0000"

git init -q -b develop "$PROJECT"
git -C "$PROJECT" config user.name "Freely Test"
git -C "$PROJECT" config user.email "freely@example.com"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
- 20260322-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260322-0000/brainstorms.md" <<'EOF'
# Brainstorms
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260322-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

git -C "$PROJECT" add .
git -C "$PROJECT" commit -q -m "init"
git -C "$PROJECT" worktree add -q -b feature/test-worker "$WORKER_WT" develop

mkdir -p "$PROJECT/.freely/run/worker-prompts" "$WORKER_WT/.freely/run"
cat >"$WORKER_WT/.freely/config.env" <<EOF
PROJECT_ROOT="$WORKER_WT"
INTENT_FILE="$WORKER_WT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$WORKER_WT/docs/CONSTITUTION.md"
AI_TOOL="cc-use-codex-cli"
AI_MODEL=""
AI_MODE="auto"
AI_REASONING_EFFORT="medium"
AI_TOOL_ADAPTER="direct"
AI_TOOL_ADAPTER_POLICY="direct"
AI_TOOL_CAPABILITIES="codex-cli"
AI_TOOL_POLICY="prefer-codex-for-repo-work"
EOF

PROMPT_FILE="$PROJECT/.freely/run/worker-prompts/20260323-selected-tool-codex.txt"
cat >"$PROMPT_FILE" <<EOF
Worktree:
- \`$WORKER_WT\`
Branch:
- \`feature/test-worker\`
dispatch_priority: P0
parallel_safe: false
write_scope: \`$WORKER_WT\`
intent_kind: cleanup
intent_target: \`$WORKER_WT\`
- selected_tool: \`codex\`
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

write_worker_verification_contract_file \
  "$(worker_verification_contract_state_file "$WORKER_WT")" \
  "$PROMPT_FILE" \
  "intake-123" \
  "$WORKER_WT"

grep -q '^AI_TOOL="cc-use-codex-cli"$' "$WORKER_WT/.freely/config.env"

worker_runtime_reconcile_selected_tool_from_contract_if_needed "$WORKER_WT"

grep -q '^AI_TOOL="codex"$' "$WORKER_WT/.freely/config.env"
grep -q '^AI_MODEL="gpt-5.4"$' "$WORKER_WT/.freely/config.env"

echo "[PASS] worker restart reapplies selected_tool from verification contract"
