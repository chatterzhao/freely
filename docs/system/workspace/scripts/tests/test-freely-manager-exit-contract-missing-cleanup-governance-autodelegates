LAST_RESTART_STORM_ESCALATED_AT=""
LAST_RESTART_STORM_ESCALATION_TARGET=""
AUTO_RECOVERY_ATTEMPTED_TOOLS_CSV=""
EOF

for wt in "$FEATURE_WT" "$PREMERGE_WT"; do
  cat >"$wt/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="stopped"
LAST_SUPERVISOR_STATE="down"
LAST_AI_STATE="down"
LAST_EXIT_REASON="operator_stop"
LAST_ROLE_HINT="worker"
LAST_STATE_UPDATED_AT="2026-04-21T18:49:39Z"
EOF
done

CONTINUITY="$PROJECT/.freely/run/manager-continuity-20260421-184939.md"
cat >"$CONTINUITY" <<EOF
# Manager Continuity

## Primary Judgement

- route_kind: \`cleanup_governance\`
- selected_tool: \`codex\`
- next_action: \`decide retirement handoff for retained merged worktrees\`

## Why This Route

- selected_source: \`I-20260421-1330-A\`

## Evidence

- issue_truth: \`docs/B2-docs/demo/cleanup-governance/issues/cleanup-governance.md\`
- progress_truth: \`docs/progress/demo/p-cleanup-governance.md\`

## Fleet Inventory

- manager_lane:
  - path: \`$PROJECT\`
    branch: \`develop\`
    clean_state: \`CLEAN\`
    desired: \`running\`
    role: \`manager\`
- selected_cleanup_family:
  - path: \`$FEATURE_WT\`
    branch: \`feature/cleanup\`
    clean_state: \`CLEAN\`
    desired: \`stopped\`
    role_hint: \`cleanup\`
  - path: \`$PREMERGE_WT\`
    branch: \`test-pre-merge-cleanup\`
    clean_state: \`CLEAN\`
    desired: \`stopped\`
    role_hint: \`manager/premerge\`

## Queue

- cleanup_queue:
  - lane_slug: \`cleanup-governance\`
    issue_id: \`I-20260421-1330-A\`
    status: \`manager_reconcile_required\`
    next_action: \`materialize cleanup followthrough worker\`

## Worker Prompts

- launched: \`none\`
- prompt_paths: \`none\`
- reason: \`cleanup worker has not been materialized yet\`
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

ACTION="$(manager_runtime_handle_exit_contract_after_ai_cycle "$PROJECT" "ai_exit_rc_0")"
[[ "$ACTION" == "delegate_workers" ]] || {
  echo "[FAIL] expected cleanup governance fallback to delegate workers, got $ACTION" >&2
  exit 1
}

grep -q '^EXIT_KIND="delegate_workers"$' "$(manager_exit_contract_file "$PROJECT")"
PROMPT_FILE="$(find "$PROJECT/.freely/run/worker-prompts" -type f | head -n 1)"
[[ -n "$PROMPT_FILE" && -f "$PROMPT_FILE" ]] || {
  echo "[FAIL] expected materialized cleanup worker prompt" >&2
  exit 1
}
grep -q "^WORKER_PROMPTS_CSV=\"$PROMPT_FILE\"$" "$(manager_exit_contract_file "$PROJECT")"
grep -q 'manager_exit_contract_autofilled_cleanup_delegate_workers' "$PROJECT/.freely/logs/runtime-events.log"

echo "[PASS] missing manager exit contract auto-delegates cleanup governance via materialized worker prompt"
