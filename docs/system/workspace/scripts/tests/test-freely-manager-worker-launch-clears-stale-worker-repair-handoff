#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-worker-launch-clears-repair-handoff.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
WORKER_WT="$TMP_DIR/worker-wt"
mkdir -p "$PROJECT/docs/B1-docs/raw-20260322-0000"

git init -q -b develop "$PROJECT"
git -C "$PROJECT" config user.name "Freely Test"
git -C "$PROJECT" config user.email "freely@example.com"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
- 20260322-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260322-0000/brainstorms.md" <<'EOF'
# Brainstorms
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260322-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

git -C "$PROJECT" add .
git -C "$PROJECT" commit -q -m "init"
git -C "$PROJECT" worktree add -q -b feature/test-worker "$WORKER_WT" develop

mkdir -p "$PROJECT/.freely/run/worker-prompts" "$PROJECT/.freely/logs" "$WORKER_WT/.freely/run" "$WORKER_WT/.freely/logs"
cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF
cat >"$WORKER_WT/.freely/config.env" <<EOF
PROJECT_ROOT="$WORKER_WT"
INTENT_FILE="$WORKER_WT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$WORKER_WT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

PROMPT_FILE="$PROJECT/.freely/run/worker-prompts/20260322-0412-worker-cleanup-codex.txt"
cat >"$PROMPT_FILE" <<EOF
Worktree:
- \`$WORKER_WT\`
Branch:
- \`feature/test-worker\`
dispatch_priority: P0
parallel_safe: true
write_scope: \`$WORKER_WT\`
intent_kind: cleanup
intent_target: \`$WORKER_WT\`
Owner-Issue:
- \`I-20260322-0412-A\`
Pre-Tests-Path:
- \`docs/B2-docs/sample/story/pre-tests.md\`
Verification-Artifact-Dir:
- \`docs/B2-docs/sample/story/code-reviews\`
Required-Test-Lanes:
- \`feature-local\`
Required-Acceptance-Item-Ids:
- \`cleanup-followthrough\`
Minimum-Evidence-Level:
- \`artifact-plus-human-observation\`
Target-Environment:
- \`feature/test-worker\`
Closeout-Gate:
- \`cleanup closeout\`
Closeout-Gate-Command:
- \`./bin/checkpoint-guard\`
Closeout-Target-Lane:
- \`feature/test-worker\`
Closeout-Promotion-Gate:
- \`manager_review_only\`
Closeout-Requires-Adequacy:
- \`false\`
Closeout-Review-Artifact-Policy:
- \`append-only\`
EOF

cat >"$WORKER_WT/.freely/run/session-handoff.txt" <<EOF
# Session Handoff

- rotation_reason: worker_exit_contract_repair
- previous_launch_kind: resume
- previous_tool_resume_target: worker-repair-demo
- worktree_path: $WORKER_WT

## Repair Contract
- reason: worker_exit_contract_invalid
- contract_file: $WORKER_WT/.freely/run/worker-exit-contract.env
- details: missing_file
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

START_LOG="$TMP_DIR/started.log"
start_workcell_supervisor_async() {
  echo "$1" >>"$START_LOG"
}
manager_supervisor_pid_for_project() {
  return 0
}
runtime_ai_pid_hint_for_project() {
  return 0
}

launch_worker_from_manager_prompt_if_needed "$PROJECT" "$PROMPT_FILE" >/dev/null

if [[ -f "$WORKER_WT/.freely/run/session-handoff.txt" ]]; then
  echo "[FAIL] stale worker repair handoff should be cleared by authoritative manager launch" >&2
  exit 1
fi

[[ "$(prepend_exit_contract_repair_focus_if_needed "$WORKER_WT")" == "" ]]
grep -q "$WORKER_WT" "$START_LOG"
grep -q "^SOURCE_PROMPT_FILE=\"$PROMPT_FILE\"$" "$WORKER_WT/.freely/run/worker-verification-contract.env"

echo "[PASS] authoritative manager worker launch clears stale worker repair handoff before the next worker round"
