python3 - <<'PY' "$MOCK_HOME"
import base64
import json
import os
import sys

home = sys.argv[1]
slots = {
    "worahe3971@outlook-com": "token-3971",
    "worahe3972@outlook-com": "token-3972",
    "worahe3973@outlook-com": "token-3973",
}
for email, token in slots.items():
    payload = base64.urlsafe_b64encode(json.dumps({"email": email}).encode()).decode().rstrip("=")
    path = os.path.join(home, ".ai-auth", f"codex-{email}", "auth.json")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump({"tokens": {"id_token": f"x.{payload}.y", "access_token": token}}, f)
PY

