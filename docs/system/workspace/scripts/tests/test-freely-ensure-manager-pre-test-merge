cat >"$MOCK_BIN/curl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

output_file=""
auth_header=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --connect-timeout|--max-time)
      shift 2
      ;;
    -o)
      output_file="$2"
      shift 2
      ;;
    -H)
      if [[ "$2" == Authorization:\ Bearer* ]]; then
        auth_header="$2"
      fi
      shift 2
      ;;
    -w)
      shift 2
      ;;
    -s|-S|-sS)
      shift
      ;;
    *)
      shift
      ;;
  esac
done

token="${auth_header#Authorization: Bearer }"
case "$token" in
  token-3971)
    printf '{"rate_limits":{"primary":{"used_percent":5.0,"resets_at":0},"secondary":{"used_percent":0.0,"resets_at":0}}}\n' >"$output_file"
    printf '200'
    ;;
  token-3972)
    printf '{"rate_limits":{"primary":{"used_percent":100.0,"resets_at":4102444800},"secondary":{"used_percent":0.0,"resets_at":0}}}\n' >"$output_file"
    printf '200'
    ;;
  token-3973)
    printf '{"rate_limits":{"primary":{"used_percent":100.0,"resets_at":4102444800},"secondary":{"used_percent":0.0,"resets_at":0}}}\n' >"$output_file"
    printf '200'
    ;;
  *)
    printf '{"detail":"unexpected"}\n' >"$output_file"
    printf '500'
    ;;
esac
EOF

chmod +x "$PROJECT/bin/ai" "$MOCK_BIN/launch-freely"
