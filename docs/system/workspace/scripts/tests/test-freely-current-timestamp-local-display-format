#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

OUTPUT="$(TZ="America/Los_Angeles" current_timestamp_local_for_display)"

printf '%s\n' "$OUTPUT" | grep -Eq '^20[0-9]{2}\.[0-9]{2}\.[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} (PST|PDT)$'

echo "[PASS] current_timestamp_local_for_display emits the unified local display format"
