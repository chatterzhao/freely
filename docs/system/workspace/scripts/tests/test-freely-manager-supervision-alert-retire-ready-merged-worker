#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-supervision-alert-retire-ready.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/freely"
WT_ROOT="$TMP_DIR/freely-worktrees"
WORKER="$WT_ROOT/feature-worker"

mkdir -p "$PROJECT/docs/B1-docs/raw-20260309-0000" "$PROJECT/.freely/run" "$PROJECT/.freely/logs" "$WT_ROOT"
cd "$PROJECT"
git init -q -b develop
git config user.name tester
git config user.email tester@example.com
cat >".gitignore" <<'EOF'
.freely/
EOF
for wt in "$PROJECT"; do
  mkdir -p "$wt/docs/B1-docs/raw-20260309-0000" "$wt/.freely/run" "$wt/.freely/logs"
  cat >"$wt/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
  cat >"$wt/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
  cat >"$wt/docs/LAWS.md" <<'EOF'
# Laws
EOF
  cat >"$wt/AGENTS.md" <<'EOF'
# Agents
EOF
  cat >"$wt/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF
  cat >"$wt/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260309-0000--sample
EOF
  cat >"$wt/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF
  cat >"$wt/docs/B1-docs/raw-20260309-0000/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF
  cat >"$wt/docs/B1-docs/raw-20260309-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF
done
echo base > README.md
git add README.md .gitignore AGENTS.md docs
git commit -q -m "init"
git worktree add -q -b feature/worker "$WORKER" develop
echo feature > "$WORKER/feature.txt"
git -C "$WORKER" add feature.txt
git -C "$WORKER" commit -q -m "feature"
git -C "$PROJECT" merge --no-ff feature/worker -m "merge feature" >/dev/null

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

mkdir -p "$WORKER/.freely"
cat >"$WORKER/.freely/config.env" <<EOF
PROJECT_ROOT="$WORKER"
INTENT_FILE="$WORKER/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$WORKER/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

mkdir -p "$WORKER/.freely/run"
cat >"$WORKER/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="down"
LAST_AI_STATE="down"
LAST_EXIT_REASON="already_running_attach"
LAST_ROLE_HINT="worker"
LAST_STATE_UPDATED_AT="2026-03-18T00:00:00Z"
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

OUTPUT="$(manager_supervision_alerts "$PROJECT")"
grep -q 'retire_ready_merged_worktree_retained:' <<<"$OUTPUT"
grep -q 'owner=manager-owned' <<<"$OUTPUT"
grep -q 'next_action=cleanup_followthrough' <<<"$OUTPUT"
grep -q "$WORKER" <<<"$OUTPUT"

echo "[PASS] manager supervision alerts route retire-ready merged workers to cleanup followthrough"
