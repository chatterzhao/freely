#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-init-codex-project-config-force.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

make_project() {
  local project="$1"
  mkdir -p "$project/docs/B1-docs/raw-20260320-0018"
  git init -q -b develop "$project"
  mkdir -p "$project/.githooks"
  cat >"$project/.githooks/pre-commit" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
  chmod +x "$project/.githooks/pre-commit"

  cat >"$project/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF

  cat >"$project/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF

  cat >"$project/docs/LAWS.md" <<'EOF'
# Laws
EOF

  cat >"$project/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF

  cat >"$project/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260320-0018--sample
EOF

  cat >"$project/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF

  cat >"$project/docs/B1-docs/raw-20260320-0018/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF

  cat >"$project/docs/B1-docs/raw-20260320-0018/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

  git -C "$project" add .
  git -C "$project" -c user.name="Freely Test" -c user.email="freely-test@example.com" commit -q -m "Initial test project"
}

FREELY_HOME="$TMP_DIR/freely-home"
mkdir -p "$FREELY_HOME"

PROJECT="$TMP_DIR/project"
make_project "$PROJECT"
cd "$PROJECT"
FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" init \
  --project "$PROJECT" \
  --intent "$PROJECT/docs/PROJECT_INTENT.md" \
  --constitution "$PROJECT/docs/CONSTITUTION.md" \
  --ai codex:gpt-5.4:auto \
  --accept-default-autonomy \
  >/dev/null

CONFIG_FILE="$PROJECT/.freely/config.env"
CODEX_CONFIG_FILE="$PROJECT/.codex/config.toml"
TOOL_BOOTSTRAP_FILE="$PROJECT/.freely/tool-boundary-bootstrap.md"
WRAPPER_DIR="$PROJECT/.freely/bin"
PROJECT_WORKTREES_ROOT="${PROJECT}-worktrees"

test -f "$CONFIG_FILE"
test -f "$CODEX_CONFIG_FILE"
test -f "$TOOL_BOOTSTRAP_FILE"
test -x "$WRAPPER_DIR/codex"
test -x "$WRAPPER_DIR/claude"
test -x "$WRAPPER_DIR/iflow"
test -x "$WRAPPER_DIR/kiro-cli"
grep -q '^AI_TOOL="codex"$' "$CONFIG_FILE"
grep -q '^AI_MODEL="gpt-5.4"$' "$CONFIG_FILE"
grep -q '^AI_REASONING_EFFORT="medium"$' "$CONFIG_FILE"
grep -q '^FREELY_NETWORK_PROXY_MODE="inherit"$' "$CONFIG_FILE"
grep -q '^FREELY_NETWORK_PROXY_URL=""$' "$CONFIG_FILE"
grep -q '^FREELY_ALL_PROXY=""$' "$CONFIG_FILE"
grep -q '^FREELY_HTTP_PROXY=""$' "$CONFIG_FILE"
grep -q '^FREELY_HTTPS_PROXY=""$' "$CONFIG_FILE"
grep -q '^FREELY_NO_PROXY=""$' "$CONFIG_FILE"
grep -Fq "writable_roots = [\"$PROJECT_WORKTREES_ROOT\"]" "$CODEX_CONFIG_FILE"
grep -Fq -- "--add-dir \"$PROJECT_WORKTREES_ROOT\"" "$WRAPPER_DIR/codex"
grep -Fq -- "--add-dir \"$PROJECT_WORKTREES_ROOT\"" "$WRAPPER_DIR/claude"
grep -Fq -- "--add-dir \"$PROJECT_WORKTREES_ROOT\"" "$WRAPPER_DIR/iflow"
grep -Fq "\`$PROJECT_WORKTREES_ROOT\`" "$TOOL_BOOTSTRAP_FILE"

cat >"$CONFIG_FILE" <<'EOF'
AI_TOOL="sentinel"
EOF

cat >"$CODEX_CONFIG_FILE" <<'EOF'
model_context_window = 111111
model_auto_compact_token_limit = 22222
project_doc_max_bytes = 1
approval_policy = "never"
sandbox_mode = "read-only"
[sandbox_workspace_write]
network_access = true
writable_roots = ["/tmp/sentinel"]
EOF

REINIT_OUTPUT="$(FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" init \
  --project "$PROJECT" \
  --intent "$PROJECT/docs/PROJECT_INTENT.md" \
  --constitution "$PROJECT/docs/CONSTITUTION.md" \
  --ai codex:gpt-5.4:auto \
  --accept-default-autonomy \
  2>&1)"

printf '%s\n' "$REINIT_OUTPUT" | grep -Fq "skip: $CONFIG_FILE already exists"
printf '%s\n' "$REINIT_OUTPUT" | grep -Fq "skip: $CODEX_CONFIG_FILE already exists"
grep -q '^AI_TOOL="sentinel"$' "$CONFIG_FILE"
grep -q '^model_context_window = 111111$' "$CODEX_CONFIG_FILE"
grep -Fq 'writable_roots = ["/tmp/sentinel"]' "$CODEX_CONFIG_FILE"

FORCE_OUTPUT="$(FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" init \
  --project "$PROJECT" \
  --intent "$PROJECT/docs/PROJECT_INTENT.md" \
  --constitution "$PROJECT/docs/CONSTITUTION.md" \
  --ai codex:gpt-5.4:auto \
  --accept-default-autonomy \
  --force \
  2>&1)"

grep -q '^AI_TOOL="codex"$' "$CONFIG_FILE"
grep -q '^AI_MODEL="gpt-5.4"$' "$CONFIG_FILE"
grep -q '^AI_REASONING_EFFORT="medium"$' "$CONFIG_FILE"
grep -q '^FREELY_NETWORK_PROXY_MODE="inherit"$' "$CONFIG_FILE"
grep -q '^FREELY_NETWORK_PROXY_URL=""$' "$CONFIG_FILE"
grep -q '^FREELY_ALL_PROXY=""$' "$CONFIG_FILE"
grep -q '^FREELY_HTTP_PROXY=""$' "$CONFIG_FILE"
grep -q '^FREELY_HTTPS_PROXY=""$' "$CONFIG_FILE"
grep -q '^FREELY_NO_PROXY=""$' "$CONFIG_FILE"
grep -q '^model_context_window = 200000$' "$CODEX_CONFIG_FILE"
grep -q '^model_auto_compact_token_limit = 150000$' "$CODEX_CONFIG_FILE"
grep -q '^project_doc_max_bytes = 32768$' "$CODEX_CONFIG_FILE"
grep -q '^approval_policy = "never"$' "$CODEX_CONFIG_FILE"
grep -q '^sandbox_mode = "workspace-write"$' "$CODEX_CONFIG_FILE"
grep -q '^network_access = false$' "$CODEX_CONFIG_FILE"
grep -Fq "writable_roots = [\"$PROJECT_WORKTREES_ROOT\"]" "$CODEX_CONFIG_FILE"

printf '%s\n' "$FORCE_OUTPUT" | grep -Fq "initialized: $CONFIG_FILE"

CANONICAL_PROJECT="$TMP_DIR/canonical-project"
make_project "$CANONICAL_PROJECT"
CANONICAL_WORKTREES_ROOT="${CANONICAL_PROJECT}-worktrees"
CANONICAL_WORKTREE="$CANONICAL_WORKTREES_ROOT/20260402-feature-init-proof"
mkdir -p "$CANONICAL_WORKTREES_ROOT"
git -C "$CANONICAL_PROJECT" worktree add -q -b feature/init-proof "$CANONICAL_WORKTREE" develop

FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" init \
  --project "$CANONICAL_WORKTREE" \
  --intent "$CANONICAL_WORKTREE/docs/PROJECT_INTENT.md" \
  --constitution "$CANONICAL_WORKTREE/docs/CONSTITUTION.md" \
  --ai codex:gpt-5.4:auto \
  --accept-default-autonomy \
  >/dev/null

WORKTREE_CODEX_CONFIG_FILE="$CANONICAL_WORKTREE/.codex/config.toml"
WORKTREE_BOOTSTRAP_FILE="$CANONICAL_WORKTREE/.freely/tool-boundary-bootstrap.md"
WORKTREE_WRAPPER_DIR="$CANONICAL_WORKTREE/.freely/bin"
grep -Fq "writable_roots = [\"$CANONICAL_WORKTREES_ROOT\"]" "$WORKTREE_CODEX_CONFIG_FILE"
grep -Fq -- "--add-dir \"$CANONICAL_WORKTREES_ROOT\"" "$WORKTREE_WRAPPER_DIR/codex"
grep -Fq "\`$CANONICAL_WORKTREES_ROOT\`" "$WORKTREE_BOOTSTRAP_FILE"

echo "[PASS] freely init keeps project config non-destructive by default and rewrites it with --force"
