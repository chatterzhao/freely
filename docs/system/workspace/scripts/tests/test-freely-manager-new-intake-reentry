#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-new-intake-reentry.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
mkdir -p "$PROJECT/docs/B1-docs/raw-20260323-0000" "$PROJECT/.freely/run" "$PROJECT/.freely/logs" "$PROJECT/.freely/intake/intake-newer"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
- 20260323-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260323-0000/brainstorms.md" <<'EOF'
# Brainstorms
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260323-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

sleep 999 >/dev/null 2>&1 &
AI_PID=$!
echo "$AI_PID" >"$PROJECT/.freely/run/ai.pid"
echo "$$" >"$PROJECT/.freely/run/supervisor.pid"

cat >"$PROJECT/.freely/run/prompt-20260323-172904.txt" <<'EOF'
Manager prompt

Delegated continuation handoff:
- intake_id=test-old
EOF
touch -t 202603231729.04 "$PROJECT/.freely/run/prompt-20260323-172904.txt"

touch "$PROJECT/.freely/logs/cycle-20260323-172904.log"
touch -t 202603231730.39 "$PROJECT/.freely/logs/cycle-20260323-172904.log"

cat >"$PROJECT/.freely/intake/intake-newer/meta.env" <<'EOF'
INTAKE_ID="intake-newer"
CREATED_AT="2026-03-24T00:29:18Z"
AUTHOR="human"
CHANNEL="chat"
STATUS="delegated"
CLASSIFICATION="control"
REACTION="followup"
LINKED_ARTIFACT="pending://interruption-manager-delegation"
DELEGATED_WORKTREE=""
SESSION_REFS="[]"
CLAIMED_BY="interruption-manager-agent"
CLAIMED_AT="2026-03-24T00:29:32Z"
ABSORPTION_TARGET="handoff://cleanup"
RESOLUTION_ARTIFACT="/tmp/resolution.md"
EOF
cat >"$PROJECT/.freely/intake/intake-newer/message.txt" <<'EOF'
new cleanup handoff
EOF
touch -t 202603231729.18 "$PROJECT/.freely/intake/intake-newer/meta.env"
touch -t 202603231729.18 "$PROJECT/.freely/intake/intake-newer/message.txt"
cat >"$PROJECT/.freely/run/intake.pending" <<'EOF'
PENDING_INTAKE_ITEMS="1"
UPDATED_AT="2026-03-24T00:29:32Z"
EOF
touch -t 202603231729.18 "$PROJECT/.freely/run/intake.pending"

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

PREEMPT_LOG="$TMP_DIR/preempt.log"
RESTART_LOG="$TMP_DIR/restart.log"
manager_ai_pid_for_project() {
  echo "$AI_PID"
}
latest_prompt_file_for_project() {
  echo "$PROJECT/.freely/run/prompt-20260323-172904.txt"
}
request_local_continuation_reentry() {
  echo "$1|$2" >>"$PREEMPT_LOG"
  write_preemption_state "$1" "graceful_term" "local_continuation_reentry" "$2" "$AI_PID"
  kill "$AI_PID" 2>/dev/null || true
}
restart_manager_supervisor_preserving_handoff() {
  echo "$1" >>"$RESTART_LOG"
}
write_manager_bootstrap_handoff() {
  :
}
codex_current_account() {
  echo "test@example.com"
}

REASON="$(manager_ai_runtime_recovery_reason "$PROJECT" 90)"
[[ "$REASON" == "manager_ai_prompt_superseded_by_new_intake" ]] || {
  echo "[FAIL] expected superseded prompt recovery reason, got: ${REASON:-none}" >&2
  exit 1
}

if ! recover_stalled_manager_ai_if_needed "$PROJECT"; then
  echo "[FAIL] expected new-intake reentry recovery to trigger" >&2
  exit 1
fi

grep -q "$PROJECT|runtime-stalled-ai-recovery" "$PREEMPT_LOG"
grep -q "$PROJECT" "$RESTART_LOG"
grep -q '^LAST_PREEMPTION_REASON="local_continuation_reentry"$' "$PROJECT/.freely/run/preemption-state.env"

echo "[PASS] manager prompt is reentered when a newer active intake supersedes delegated continuation work"
