  mkdir -p "$repo/docs/system/workspace/skills/doc-ibm-execution"
  mkdir -p "$repo/docs/system/workspace/skills/doc-pre-brainstorm-execution"
  mkdir -p "$repo/docs/system/workspace/skills/freely-dev-loop-execution"
  mkdir -p "$repo/docs/system/workspace/skills/freely-auto-loop-orchestrator"
  mkdir -p "$repo/docs/system/workspace/skills"
  mkdir -p "$repo/docs/system/workspace/agents"
  mkdir -p "$repo/docs/B1-docs/raw-20260402-1111"
  mkdir -p "$repo/docs/B2-docs/sample/issues"

  cat > "$repo/AGENTS.md" <<'EOF'
# Agent entry
EOF
  cat > "$repo/docs/PROJECT_INTENT.md" <<'EOF'
# Project Intent
See docs/system/workspace/three-loop-capability-lifecycle.md
EOF
  cat > "$repo/docs/CONSTITUTION.md" <<'EOF'
# Constitution
See docs/system/workspace/three-loop-capability-lifecycle.md
EOF
