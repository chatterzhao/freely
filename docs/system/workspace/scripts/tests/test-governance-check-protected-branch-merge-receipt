#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-governance-protected-merge-receipt.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

make_repo() {
  local repo="$1"
  mkdir -p "$repo/bin" "$repo/docs/system/workspace/scripts/quality" "$repo/docs/system/workspace/hooks"
  cd "$repo"

  cp "$ROOT_DIR/bin/governance-check" "$repo/bin/governance-check"
  cp "$ROOT_DIR/docs/system/workspace/scripts/quality/governance-check" "$repo/docs/system/workspace/scripts/quality/governance-check"
  chmod +x "$repo/bin/governance-check" "$repo/docs/system/workspace/scripts/quality/governance-check"

