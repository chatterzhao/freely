REPO_BAD="$TMP_DIR/repo-bad"
make_repo "$REPO_BAD"
cd "$REPO_BAD"
git init -q -b develop
git config user.name tester
git config user.email tester@example.com
echo base > README.md
git add .
git commit -q -m "init"
git checkout -q -b feature/raw
echo raw > RAW.txt
git add RAW.txt
git commit -q -m "raw feature"
git checkout -q develop
git merge --no-ff --no-edit feature/raw >/dev/null

if ./bin/governance-check >"$TMP_DIR/bad.out" 2>&1; then
  echo "[FAIL] governance-check should reject protected-branch merge commits without Freely receipt trailers" >&2
  cat "$TMP_DIR/bad.out" >&2
  exit 1
fi
grep -q "missing Freely-Merge-Path receipt" "$TMP_DIR/bad.out"

REPO_GOOD="$TMP_DIR/repo-good"
make_repo "$REPO_GOOD"
cd "$REPO_GOOD"
git init -q -b develop
git config user.name tester
git config user.email tester@example.com
echo base > README.md
git add .
git commit -q -m "init"
git checkout -q -b test-pre-merge-20260402-receipt
echo receipt > RECEIPT.txt
git add RECEIPT.txt
git commit -q -m "receipt feature"
git checkout -q develop
git merge --no-ff -m "$(cat <<'EOF'
Merge branch 'test-pre-merge-20260402-receipt' into develop

Freely-Merge-Path: merge-guarded
Freely-Bypass-Mode: forbidden
Freely-Source-Branch: test-pre-merge-20260402-receipt
EOF
)" test-pre-merge-20260402-receipt >/dev/null

if ! ./bin/governance-check >"$TMP_DIR/good.out" 2>&1; then
  cat "$TMP_DIR/good.out" >&2
  exit 1
fi
grep -q "Governance check passed" "$TMP_DIR/good.out"

