git add LEGACY.txt
git commit -q -m "legacy feature"
git checkout -q develop
git merge --no-ff --no-edit test-pre-merge-20260402-legacy >/dev/null

LEGACY_COMMIT="$(git rev-parse HEAD)"
cat > "$REPO_LEGACY/docs/system/workspace/hooks/protected-branch-breakglass-receipts.md" <<EOF
# Protected Branch Break-Glass Receipts

- audit_effective_date: \`2026-04-02\`

## Receipt: $LEGACY_COMMIT

