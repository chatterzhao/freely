make_repo "$REPO_BREAK"
cd "$REPO_BREAK"
git init -q -b develop
git config user.name tester
git config user.email tester@example.com
echo base > README.md
git add .
git commit -q -m "init"
git checkout -q -b test-pre-merge-20260402-breakglass
echo breakglass > BREAKGLASS.txt
git add BREAKGLASS.txt
git commit -q -m "breakglass feature"
git checkout -q develop
git merge --no-ff -m "$(cat <<'EOF'
Merge branch 'test-pre-merge-20260402-breakglass' into develop

Freely-Merge-Path: merge-guarded-break-glass
Freely-Bypass-Mode: break_glass
Freely-Source-Branch: test-pre-merge-20260402-breakglass
Freely-Break-Glass-Reason: verified_false_negative
Freely-Blocked-Gate: pre-merge-commit
Freely-Operation-Scope: merge_completion_only
Freely-Evidence-Ref: docs/B2-docs/sample/code-reviews/r-breakglass.md
Freely-Follow-On-Issue: I-20260402-0020-A
EOF
)" test-pre-merge-20260402-breakglass >/dev/null

