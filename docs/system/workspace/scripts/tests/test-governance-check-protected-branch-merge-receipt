EOF
  cat > "$repo/docs/system/workspace/skills/README.md" <<'EOF'
# Skills
See docs/system/workspace/three-loop-capability-lifecycle.md
EOF
  cat > "$repo/docs/system/workspace/agents/lead-agent.md" <<'EOF'
# Lead Agent
See docs/system/workspace/three-loop-capability-lifecycle.md
EOF
  cat > "$repo/docs/system/workspace/agents/manager-agent.md" <<'EOF'
# Manager Agent
See docs/system/workspace/three-loop-capability-lifecycle.md
EOF
  cat > "$repo/docs/system/workspace/agents/worker-agent.md" <<'EOF'
# Worker Agent
See docs/system/workspace/three-loop-capability-lifecycle.md
EOF
  cat > "$repo/docs/system/workspace/skills/freely-auto-loop-orchestrator/SKILL.md" <<'EOF'
# Skill
See docs/system/workspace/three-loop-capability-lifecycle.md
EOF
  cat > "$repo/docs/system/workspace/skills/doc-pre-brainstorm-execution/SKILL.md" <<'EOF'
# Skill
See docs/system/workspace/three-loop-capability-lifecycle.md
EOF
  cat > "$repo/docs/system/workspace/skills/doc-ibm-execution/SKILL.md" <<'EOF'
# Skill
See docs/system/workspace/three-loop-capability-lifecycle.md
references/prd-quality-bar.md
pre-tests.md` 和 `tasks.md` 必须从 `prd.md` 自然派生
EOF
  cat > "$repo/docs/system/workspace/skills/freely-dev-loop-execution/SKILL.md" <<'EOF'
# Skill
See docs/system/workspace/three-loop-capability-lifecycle.md
EOF
  cat > "$repo/docs/system/workspace/skills/doc-ibm-execution/references/prd-quality-bar.md" <<'EOF'
# PRD Quality Bar
## Minimum structure
## Bar for `done_ibm`
EOF
  cat > "$repo/docs/system/workspace/skills/doc-ibm-execution/references/ibm-completion-gate.md" <<'EOF'
# IBM Completion Gate
prd-quality-bar.md
EOF
  cat > "$repo/docs/system/workspace/skills/doc-ibm-execution/references/issue-materialization-checklist.md" <<'EOF'
# Issue Materialization Checklist
prd-quality-bar.md
EOF
