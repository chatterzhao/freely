EOF
  cat > "$repo/docs/system/workspace/three-loop-capability-lifecycle.md" <<'EOF'
# Three Loop Capability Lifecycle
EOF
  cat > "$repo/docs/system/workspace/hooks/README.md" <<'EOF'
# Workspace Hooks
EOF
  cat > "$repo/docs/system/workspace/hooks/protected-branch-breakglass-receipts.md" <<'EOF'
# Protected Branch Break-Glass Receipts

- audit_effective_date: `2099-01-01`
- source_policy_effective_date: `2099-01-01`
EOF
