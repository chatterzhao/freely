- ok
EOF
  cat > "$repo/docs/B1-docs/raw-20260402-1111/candidates.md" <<'EOF'
# Candidates
- id: C-20260402-1111-A
- candidate_format_version: v2
- title: sample
- status: promoted
- decision_reason: sample
- acceptance_criteria:
  - protected branch receipt exists
- promotion_gate:
  - issue is materialized
- open_questions: []
- acceptance_reviews:
  - reviewer: codex-mini
  - mode: subagent
  - summary: good enough
  - verdict: pass
- promoted_issue_path: docs/B2-docs/sample/issues/sample.md
- milestone: M-20260402-1111-sample
- session_refs: []
EOF
