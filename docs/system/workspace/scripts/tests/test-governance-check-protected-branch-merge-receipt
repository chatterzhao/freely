- follow_on_owner: \`I-20260402-0020-A\`
- evidence_refs:
  - \`docs/B2-docs/sample/issues/sample.md\`
EOF

git checkout -q -b test-pre-merge-20260402-legacy-head-receipt
echo head > HEAD.txt
git add HEAD.txt
git commit -q -m "head receipt feature"
git checkout -q develop
git merge --no-ff -m "$(cat <<'EOF'
Merge branch 'test-pre-merge-20260402-legacy-head-receipt' into develop

Freely-Merge-Path: merge-guarded
Freely-Bypass-Mode: forbidden
Freely-Source-Branch: test-pre-merge-20260402-legacy-head-receipt
EOF
)" test-pre-merge-20260402-legacy-head-receipt >/dev/null

if ! ./bin/governance-check >"$TMP_DIR/legacy.out" 2>&1; then
  cat "$TMP_DIR/legacy.out" >&2
  exit 1
fi
grep -q "Governance check passed" "$TMP_DIR/legacy.out"

REPO_MISMATCH="$TMP_DIR/repo-mismatch"
make_repo "$REPO_MISMATCH"
cd "$REPO_MISMATCH"
git init -q -b develop
git config user.name tester
git config user.email tester@example.com
echo base > README.md
git add .
git commit -q -m "init"
git checkout -q -b test-pre-merge-20260402-mismatch
echo mismatch > MISMATCH.txt
