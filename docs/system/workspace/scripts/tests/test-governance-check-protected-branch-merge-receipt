- bypass_mode: \`break_glass\`
- break_glass_reason: \`verified_false_negative\`
- blocked_gate: \`pre-merge-commit\`
- operation_scope: \`merge_completion_only\`
- follow_on_owner: \`I-20260402-0020-A\`
- evidence_refs:
  - \`docs/B2-docs/sample/code-reviews/r-breakglass.md\`
EOF

if ! ./bin/governance-check >"$TMP_DIR/break.out" 2>&1; then
  cat "$TMP_DIR/break.out" >&2
  exit 1
fi
grep -q "Governance check passed" "$TMP_DIR/break.out"

