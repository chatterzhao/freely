#!/usr/bin/env bash
# TC-9: scan with process_inspection_available=false (degraded mode)
# The scanning function uses Python os.kill, not ps, so it works independently.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
HANDOFF_PY="$ROOT_DIR/docs/system/workspace/scripts/runtime/handoff.py"

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
db="$tmpdir/test.db"

python3 "$HANDOFF_PY" init --db "$db"

# Insert a launched worker with a dead PID
python3 -c "
import sqlite3
from datetime import datetime, timezone
conn = sqlite3.connect('$db')
now = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')

conn.execute(\"\"\"INSERT INTO handoffs (handoff_id, role, raw_key, prompt_file, status, worker_pid, created_at, updated_at)
  VALUES ('DG-1', 'worker', 'test-raw', '/tmp/dg', 'launched', '99999999', ?, ?)\"\"\", (now, now))
conn.commit()
conn.close()
"

# Run scan logic (same as manager_scan_stale_worker_pids does — pure Python os.kill)
python3 -c "
import sqlite3, os
from datetime import datetime, timezone
conn = sqlite3.connect('$db')
rows = conn.execute(
  \"SELECT handoff_id, worker_pid FROM handoffs \"
  \"WHERE role='worker' AND status='launched' AND worker_pid != '' AND worker_pid IS NOT NULL \"
).fetchall()
marked = []
for hid, pid_str in rows:
  if not pid_str or not pid_str.strip().isdigit():
    continue
  pid = int(pid_str.strip())
  try:
    os.kill(pid, 0)
  except OSError:
    marked.append(hid)
if marked:
  now = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
  for hid in marked:
    conn.execute(
      \"UPDATE handoffs SET status='blocked', exit_kind='stale_pid', \"
      \"reason='Worker PID kill -0 failed, marking stale_pid', \"
      \"completed_at=?, updated_at=? \"
      \"WHERE handoff_id=? AND status='launched'\",
      (now, now, hid)
    )
conn.commit()

# Verify stale PID is marked
row = conn.execute('SELECT status, exit_kind FROM handoffs WHERE handoff_id=?', ('DG-1',)).fetchone()
assert row[0] == 'blocked', f'Expected blocked, got {row[0]}'
assert row[1] == 'stale_pid', f'Expected stale_pid, got {row[1]}'
print('DG-1 correctly marked as blocked/stale_pid via os.kill')
conn.close()
"

echo "[PASS] scan works in degraded mode (os.kill independent of process_inspection_available)"
