#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-hook-gate.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

make_project() {
  local project="$1"
  mkdir -p "$project/docs/pre-brainstorms/20260320-0018--sample" "$project/.githooks"
  git init -q -b develop "$project"

  cat >"$project/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF

  cat >"$project/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF

  cat >"$project/docs/LAWS.md" <<'EOF'
# Laws
EOF

  cat >"$project/AGENTS.md" <<'EOF'
# Agents
EOF

  cat >"$project/docs/pre-brainstorms/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF

  cat >"$project/docs/pre-brainstorms/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260320-0018--sample
EOF

  cat >"$project/docs/pre-brainstorms/CONVERGENCE.md" <<'EOF'
# 收敛
EOF

  cat >"$project/docs/pre-brainstorms/20260320-0018--sample/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF

  cat >"$project/docs/pre-brainstorms/20260320-0018--sample/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF
}

PROJECT_DOCTOR="$TMP_DIR/project-doctor"
make_project "$PROJECT_DOCTOR"
if bash "$ROOT_DIR/bin/freely" doctor --project "$PROJECT_DOCTOR" >"$TMP_DIR/doctor.stdout" 2>"$TMP_DIR/doctor.stderr"; then
  echo "[FAIL] freely doctor unexpectedly passed without hooksPath configured" >&2
  exit 1
fi
grep -q "hook gate failed: core.hooksPath is '<unset>'" "$TMP_DIR/doctor.stderr"

git -C "$PROJECT_DOCTOR" config core.hooksPath .githooks
bash "$ROOT_DIR/bin/freely" doctor --project "$PROJECT_DOCTOR" >"$TMP_DIR/doctor-fixed.stdout" 2>"$TMP_DIR/doctor-fixed.stderr"
grep -q '\[INFO\] hook gate PASS' "$TMP_DIR/doctor-fixed.stdout" || \
  grep -q '\[INFO\] hook gate PASS' "$TMP_DIR/doctor-fixed.stderr"

PROJECT_INIT="$TMP_DIR/project-init"
FREELY_HOME="$TMP_DIR/freely-home"
mkdir -p "$FREELY_HOME"
make_project "$PROJECT_INIT"
bash "$ROOT_DIR/bin/freely" init \
  --project "$PROJECT_INIT" \
  --intent "$PROJECT_INIT/docs/PROJECT_INTENT.md" \
  --constitution "$PROJECT_INIT/docs/CONSTITUTION.md" \
  --ai codex:gpt-5.4:auto \
  >"$TMP_DIR/init.stdout" 2>"$TMP_DIR/init.stderr"
test "$(git -C "$PROJECT_INIT" config --get core.hooksPath)" = ".githooks"
grep -q '\[INFO\] enabled git hooks:' "$TMP_DIR/init.stdout" || \
  grep -q '\[INFO\] enabled git hooks:' "$TMP_DIR/init.stderr"

echo "[PASS] freely doctor enforces hook gate and init enables repo hooks"
