LAST_RESTART_STORM_ESCALATION_TARGET=""
AUTO_RECOVERY_ATTEMPTED_TOOLS_CSV=""
EOF

cat >"$PROJECT/.freely/config.env" <<'EOF'
PROJECT_ROOT=""
AGENT_AI_TOOL="codex"
EOF

cat >"$PROJECT/.freely/run/manager-continuity-20260425-151900.md" <<'EOF'
# Manager Continuity

## Primary Judgement

- route_kind: `cleanup_governance`
- restart_point: `resume the cleanup judgement`
- ownership: `manager`
- next_action: `decide retire or promote-prep`

## Worker Delegation

- none in this round
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

ACTION="$(manager_runtime_handle_exit_contract_after_ai_cycle "$PROJECT" "ai_exit_rc_0")"
[[ "$ACTION" == "resume_invalid" ]] || {
  echo "[FAIL] expected empty success cycle to force resume_invalid, got $ACTION" >&2
  exit 1
}

if [[ -f "$PROJECT/.freely/run/manager-exit-contract.env" ]]; then
  echo "[FAIL] empty success cycle should not autofill manager exit contract" >&2
  exit 1
fi

grep -q '^LAST_EXIT_REASON="manager_empty_success_cycle"$' "$PROJECT/.freely/run/workcell-state.env"
grep -q 'manager_empty_success_cycle_detected' "$PROJECT/.freely/logs/runtime-events.log"
if grep -q 'manager_exit_contract_autofilled_continuity_resume' "$PROJECT/.freely/logs/runtime-events.log"; then
  echo "[FAIL] empty success cycle must not trigger continuity resume autofill" >&2
  exit 1
fi
grep -q 'rotation_reason: manager_exit_contract_repair' "$PROJECT/.freely/run/session-handoff.txt"
grep -q 'reason: manager_empty_success_cycle' "$PROJECT/.freely/run/session-handoff.txt"

echo "[PASS] input-only manager rc=0 session does not auto-resume from stale continuity"
