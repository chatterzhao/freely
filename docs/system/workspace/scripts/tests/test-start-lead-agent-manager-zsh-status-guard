#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-start-lead-agent-manager-zsh-guard.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
mkdir -p "$PROJECT/docs"

cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF

cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF

cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF

cat >"$PROJECT/docs/milestones.md" <<'EOF'
# Milestones
EOF

git init -q "$PROJECT"
git -C "$PROJECT" config user.name test
git -C "$PROJECT" config user.email test@example.com
git -C "$PROJECT" add AGENTS.md docs
git -C "$PROJECT" commit -qm "init"
git -C "$PROJECT" branch -M develop

PROMPT="$(
  bash "$ROOT_DIR/docs/system/workspace/scripts/start-lead-agent.sh" \
    --project "$PROJECT" \
    --intent "$PROJECT/docs/PROJECT_INTENT.md" \
    --constitution "$PROJECT/docs/CONSTITUTION.md" \
    --workspace-root "$ROOT_DIR/docs/system/workspace" \
    --ai codex:auto
)"

printf '%s\n' "$PROMPT" | grep -q '不要把 `status` 当作临时变量名'
printf '%s\n' "$PROMPT" | grep -q '统一改用 `exit_code`、`cmd_status`'

echo "[PASS] manager prompt warns against zsh status variable collisions"
