#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-restart-preserving-handoff.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
mkdir -p "$PROJECT/.freely/run"

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

run_dir="$(run_dir_for_project "$PROJECT")"
mkdir -p "$run_dir"

(
  trap '' TERM
  while true; do
    sleep 1
  done
) &
SUPERVISOR_PID=$!

(
  while true; do
    sleep 1
  done
) &
AI_PID=$!

cleanup_pids() {
  kill -9 "$SUPERVISOR_PID" "$AI_PID" 2>/dev/null || true
}
trap 'cleanup_pids; rm -rf "$TMP_DIR"' EXIT

printf '%s\n' "$SUPERVISOR_PID" >"$run_dir/supervisor.pid"
printf '%s\n' "$AI_PID" >"$run_dir/ai.pid"

manager_supervisor_pid_for_project() {
  printf '%s\n' "$SUPERVISOR_PID"
}

manager_ai_pid_for_project() {
  printf '%s\n' "$AI_PID"
}

clear_supervisor_identity_truth() {
  return 0
}

restart_manager_supervisor_preserving_handoff "$PROJECT"

if kill -0 "$SUPERVISOR_PID" 2>/dev/null; then
  echo "[FAIL] expected restart path to fully terminate supervisor that ignores TERM" >&2
  exit 1
fi

if kill -0 "$AI_PID" 2>/dev/null; then
  echo "[FAIL] expected restart path to terminate AI child before supervisor relaunch" >&2
  exit 1
fi

[[ ! -f "$run_dir/supervisor.pid" ]] || {
  echo "[FAIL] expected supervisor.pid to be cleared after forced restart teardown" >&2
  exit 1
}

[[ ! -f "$run_dir/ai.pid" ]] || {
  echo "[FAIL] expected ai.pid to be cleared after forced restart teardown" >&2
  exit 1
}

echo "[PASS] manager restart preserving handoff force-stops daemon supervisor that ignores naked TERM"
