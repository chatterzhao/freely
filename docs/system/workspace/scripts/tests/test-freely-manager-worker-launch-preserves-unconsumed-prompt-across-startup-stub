#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-launch-preserve-stub.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/freely"
WT_ROOT="$TMP_DIR/freely-worktrees"
WORKER="$WT_ROOT/feature-worker"

mkdir -p "$PROJECT/.freely/run/worker-prompts" "$PROJECT/.freely/logs" "$WT_ROOT"
git init -q -b develop "$PROJECT"
git -C "$PROJECT" config user.name tester
git -C "$PROJECT" config user.email tester@example.com
echo base >"$PROJECT/README.md"
git -C "$PROJECT" add README.md
git -C "$PROJECT" commit -q -m init
git -C "$PROJECT" branch feature/worker
git -C "$PROJECT" worktree add "$WORKER" feature/worker >/dev/null

mkdir -p "$PROJECT/docs/B1-docs/raw-20260420-0000" "$WORKER/.freely/run" "$WORKER/.freely/logs"
cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
- 20260420-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260420-0000/brainstorms.md" <<'EOF'
# Brainstorms
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260420-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

cat >"$WORKER/.freely/config.env" <<EOF
PROJECT_ROOT="$WORKER"
INTENT_FILE="$WORKER/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$WORKER/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

PROMPT="$PROJECT/.freely/run/worker-prompts/20260420-071010-worker-startup-task-source-patrol-and-reconcile-codex.txt"
cat >"$PROMPT" <<EOF
Dispatch metadata:
- dispatch_priority: P0
- parallel_safe: false
- write_scope: $WORKER

Branch:
- \`feature/worker\`

Worktree:
- \`$WORKER\`
EOF

LAUNCHABLE_CONTINUITY="$PROJECT/.freely/run/manager-continuity-20260420-071010.md"
cat >"$LAUNCHABLE_CONTINUITY" <<EOF
# Manager Continuity
- worker_prompt: \`$PROMPT\`
EOF
touch -t 202604201410.10 "$LAUNCHABLE_CONTINUITY"

STUB_CONTINUITY="$PROJECT/.freely/run/manager-continuity-20260420-071445.md"
cat >"$STUB_CONTINUITY" <<'EOF'
# Manager Continuity
- continuity_written_by: `freely-runtime-startup-stub`

## Worker Delegation
- referenced_worker_prompts: `none`
- authoritative_worker_prompts: `none`
EOF
touch -t 202604201415.45 "$STUB_CONTINUITY"

cat >"$PROJECT/.freely/run/manager-worker-launch-state.env" <<EOF
LAST_MANAGER_CONTINUITY_GENERATED="$LAUNCHABLE_CONTINUITY"
LAST_MANAGER_WORKER_PROMPTS_GENERATED="$PROMPT"
LAST_MANAGER_CONTINUITY_CONSUMED="$LAUNCHABLE_CONTINUITY"
LAST_MANAGER_WORKER_PROMPTS_CONSUMED=""
LAUNCHED_WORKER_PROMPTS=""
QUEUED_WORKER_PROMPTS=""
QUEUED_WORKER_PROMPT_BLOCKERS="none"
MAX_PARALLEL_WORKERS="unbounded"
ACTIVE_RUNNING_WORKER_COUNT="0"
AVAILABLE_NEW_WORKER_SLOTS="unbounded"
UPDATED_AT="2026-04-20T14:10:40Z"
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

manager_worker_launch_state_refresh_for_status "$PROJECT"

# shellcheck disable=SC1090
source "$PROJECT/.freely/run/manager-worker-launch-state.env"
[[ "${LAST_MANAGER_CONTINUITY_GENERATED:-}" == "$LAUNCHABLE_CONTINUITY" ]]
[[ "${LAST_MANAGER_WORKER_PROMPTS_GENERATED:-}" == "$PROMPT" ]]

LAUNCH_LOG="$TMP_DIR/launch.log"
launch_worker_from_manager_prompt_if_needed() {
  local _manager_project="$1" prompt_file="$2"
  basename "$prompt_file" >>"$LAUNCH_LOG"
  return 0
}

COUNT="$(manager_runtime_launch_workers_from_latest_handoff "$PROJECT")"
[[ "$COUNT" == "1" ]]
grep -q '^20260420-071010-worker-startup-task-source-patrol-and-reconcile-codex.txt$' "$LAUNCH_LOG"

# shellcheck disable=SC1090
source "$PROJECT/.freely/run/manager-worker-launch-state.env"
[[ "${LAST_MANAGER_CONTINUITY_GENERATED:-}" == "$LAUNCHABLE_CONTINUITY" ]]
[[ "${LAST_MANAGER_WORKER_PROMPTS_GENERATED:-}" == "$PROMPT" ]]
[[ "${LAST_MANAGER_CONTINUITY_CONSUMED:-}" == "$LAUNCHABLE_CONTINUITY" ]]
[[ "${LAST_MANAGER_WORKER_PROMPTS_CONSUMED:-}" == "$PROMPT" ]]

echo "[PASS] manager launch preserves an older unconsumed worker prompt across a newer startup stub continuity"
