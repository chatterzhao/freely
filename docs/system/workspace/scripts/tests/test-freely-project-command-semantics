RESTART_PREFLIGHT_FAIL_OUTPUT="$TMP_DIR/restart-preflight-fail.out"
if bash -lc '
  set -euo pipefail
  source "'"$ROOT_DIR"'/docs/system/workspace/scripts/runtime/freely"
  resolve_project_or_fail() { printf "%s\n" "$1"; }
  log_info() { :; }
  load_config() { printf "load:%s\n" "$1"; }
  ensure_codex_slot_switch_startup_ready_or_fail() { printf "preflight:%s\n" "$1"; return 1; }
  stop_project_runtime() { printf "stop:%s|reason:%s\n" "$1" "$2"; }
  start_project_runtime() { printf "start:%s\n" "$1"; }
  main restart --project /tmp/freely-project
' >"$RESTART_PREFLIGHT_FAIL_OUTPUT" 2>&1; then
  echo "[FAIL] restart should fail before stop when restart preflight fails" >&2
  cat "$RESTART_PREFLIGHT_FAIL_OUTPUT" >&2
  exit 1
fi

grep -q '^load:/tmp/freely-project$' "$RESTART_PREFLIGHT_FAIL_OUTPUT"
grep -q '^preflight:/tmp/freely-project$' "$RESTART_PREFLIGHT_FAIL_OUTPUT"
if grep -q '^stop:/tmp/freely-project|reason:operator_restart$' "$RESTART_PREFLIGHT_FAIL_OUTPUT"; then
  echo "[FAIL] restart preflight failure should not stop the current runtime" >&2
  cat "$RESTART_PREFLIGHT_FAIL_OUTPUT" >&2
  exit 1
fi
if grep -q '^start:/tmp/freely-project$' "$RESTART_PREFLIGHT_FAIL_OUTPUT"; then
  echo "[FAIL] restart preflight failure should not continue into startup" >&2
  cat "$RESTART_PREFLIGHT_FAIL_OUTPUT" >&2
  exit 1
fi

