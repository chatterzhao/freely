#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-project-command-semantics.XXXXXX)"
export FREELY_HOME="$TMP_DIR/freely-home"
mkdir -p "$FREELY_HOME"
PROJECT=""
START_ATTACH_TMP=""
STALE_PID_TMP=""
FOREIGN_PID=""
SAME_PROJECT_SHELL_PID=""
FOREIGN_HINT_PID=""

cleanup_with_code() {
  local exit_code="${1:-$?}"
  trap - EXIT INT TERM HUP ALRM
  if [[ -n "${PROJECT:-}" && -d "${PROJECT:-}" ]]; then
    bash "$ROOT_DIR/bin/freely" stop --project "$PROJECT" >/dev/null 2>&1 || true
  fi
  if [[ -n "${FOREIGN_PID:-}" ]]; then
    kill "$FOREIGN_PID" 2>/dev/null || true
  fi
  if [[ -n "${SAME_PROJECT_SHELL_PID:-}" ]]; then
    kill "$SAME_PROJECT_SHELL_PID" 2>/dev/null || true
  fi
  if [[ -n "${FOREIGN_HINT_PID:-}" ]]; then
    kill "$FOREIGN_HINT_PID" 2>/dev/null || true
  fi
  rm -rf "$TMP_DIR"
  if [[ -n "${START_ATTACH_TMP:-}" ]]; then
    rm -rf "$START_ATTACH_TMP"
  fi
  if [[ -n "${STALE_PID_TMP:-}" ]]; then
    rm -rf "$STALE_PID_TMP"
  fi
  exit "$exit_code"
}

cleanup() {
  cleanup_with_code "$?"
}

signal_cleanup() {
  local signal_name="${1:-TERM}"
  case "$signal_name" in
    ALRM) cleanup_with_code 142 ;;
    *) cleanup_with_code 130 ;;
  esac
}

trap cleanup EXIT
trap 'signal_cleanup INT' INT
trap 'signal_cleanup TERM' TERM
trap 'signal_cleanup HUP' HUP
trap 'signal_cleanup ALRM' ALRM

RESTART_OUTPUT="$(
  bash -lc '
    set -euo pipefail
    source "'"$ROOT_DIR"'/docs/system/workspace/scripts/runtime/freely"
    resolve_project_or_fail() { printf "%s\n" "$1"; }
    log_info() { :; }
    load_config() { :; }
    ensure_codex_slot_switch_startup_ready_or_fail() { :; }
    stop_project_runtime() { printf "stop:%s|reason:%s\n" "$1" "$2"; }
    start_project_runtime() { printf "start:%s\n" "$1"; }
    main restart --project /tmp/freely-project
  '
)"

