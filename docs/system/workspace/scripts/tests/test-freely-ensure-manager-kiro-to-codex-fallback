#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-ensure-manager-kiro-fallback.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
mkdir -p "$PROJECT/docs/B1-docs/raw-20260331-0000" "$PROJECT/.freely/run" "$PROJECT/.freely/logs"

git init -q -b develop "$PROJECT"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260331-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260331-0000/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260331-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="kiro-cli"
AI_MODEL="auto"
AI_MODE="auto"
AI_REASONING_EFFORT=""
AUTO_SWITCH_TOOL="true"
AUTO_SWITCH_SLOT="true"
AI_FALLBACK_TOOLS="codex"
EOF

cat >"$PROJECT/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
SUPERVISOR_STATE="down"
AI_STATE="down"
LAST_EXIT_REASON="kiro_monthly_request_limit"
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

launch_log="$TMP_DIR/launch.log"
readiness_log="$TMP_DIR/readiness.log"

valid_supervisor_pid_for_project() { return 1; }
discover_supervisor_pid() { return 0; }
manager_ai_pid_for_project() { return 0; }
manager_supervisor_pid_for_project() { return 0; }
recover_stalled_manager_ai_if_needed() { return 1; }
ensure_codex_slot_ready_for_manager() {
  printf '%s\n' "$1" >>"$readiness_log"
  return 0
}
manager_runtime_recover_workers_if_needed() { return 0; }
launch_manager_supervisor() {
  printf '%s tool=%s\n' "$1" "$AI_TOOL" >>"$launch_log"
}
log_info() { :; }
log_warn() { :; }
log_error() { :; }

if ! ensure_manager_once "$PROJECT" >/dev/null; then
  echo "[FAIL] ensure-manager should absorb kiro tool-local failure via codex fallback" >&2
  exit 1
fi

grep -q '^AGENT_AI_TOOL="codex"$' "$PROJECT/.freely/config.env" || {
  echo "[FAIL] expected config to switch active tool to codex" >&2
  cat "$PROJECT/.freely/config.env" >&2
  exit 1
}
grep -q '^AI_TOOL_ADAPTER="direct"$' "$PROJECT/.freely/config.env" || {
  echo "[FAIL] expected config to persist the codex default adapter during fallback" >&2
  cat "$PROJECT/.freely/config.env" >&2
  exit 1
}
grep -q '^AI_MODEL="gpt-5.4"$' "$PROJECT/.freely/config.env" || {
  echo "[FAIL] expected config to install codex default model during fallback" >&2
  cat "$PROJECT/.freely/config.env" >&2
  exit 1
}
grep -q '^AI_REASONING_EFFORT="medium"$' "$PROJECT/.freely/config.env" || {
  echo "[FAIL] expected config to install codex default reasoning effort during fallback" >&2
  cat "$PROJECT/.freely/config.env" >&2
  exit 1
}
grep -q "^$PROJECT$" "$readiness_log" || {
  echo "[FAIL] expected ensure-manager to run codex readiness after fallback selection" >&2
  exit 1
}
grep -q "^$PROJECT tool=codex$" "$launch_log" || {
  echo "[FAIL] expected manager launch to occur with codex after fallback selection" >&2
  cat "$launch_log" >&2
  exit 1
}
grep -q 'event=tool_auto_switch_selected' "$PROJECT/.freely/logs/runtime-events.log" || {
  echo "[FAIL] expected runtime event log to record tool_auto_switch_selected" >&2
  cat "$PROJECT/.freely/logs/runtime-events.log" >&2
  exit 1
}
grep -q 'previous_tool=kiro-cli' "$PROJECT/.freely/logs/runtime-events.log" || {
  echo "[FAIL] expected runtime event log to preserve previous tool identity" >&2
  cat "$PROJECT/.freely/logs/runtime-events.log" >&2
  exit 1
}
grep -q 'active_tool=codex' "$PROJECT/.freely/logs/runtime-events.log" || {
  echo "[FAIL] expected runtime event log to preserve new tool identity" >&2
  cat "$PROJECT/.freely/logs/runtime-events.log" >&2
  exit 1
}

echo "[PASS] ensure-manager promotes kiro tool-local failures into codex fresh_with_handoff fallback when auto switch is enabled"
