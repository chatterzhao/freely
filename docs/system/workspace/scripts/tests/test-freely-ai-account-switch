#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-ai-account-switch.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

setup_project() {
  local project="$1"
  mkdir -p \
    "$project/.freely/run" \
    "$project/docs/system/workspace/skills/freely-freely-watchdog-control-plane/scripts" \
    "$project/docs/system/workspace/scripts/runtime"
  ln -sf \
    "$ROOT_DIR/docs/system/workspace/skills/freely-freely-watchdog-control-plane/scripts/availability-watchdog.sh" \
    "$project/docs/system/workspace/skills/freely-freely-watchdog-control-plane/scripts/availability-watchdog.sh"
  ln -sf \
    "$ROOT_DIR/docs/system/workspace/scripts/runtime/network-proxy-resolver.sh" \
    "$project/docs/system/workspace/scripts/runtime/network-proxy-resolver.sh"
  cat >"$project/.freely/config.env" <<'EOF'
FREELY_NETWORK_PROXY_MODE="inherit"
EOF
}

setup_home() {
  local home_dir="$1"
  mkdir -p "$home_dir/.ai-auth" "$home_dir/.codex"
}

make_auth_json() {
  local email="$1" target="$2" access_token="$3"
  local payload
  payload="$(python3 - <<'PY' "$email"
import base64
import json
import sys

payload = base64.urlsafe_b64encode(json.dumps({"email": sys.argv[1]}).encode()).decode().rstrip("=")
print(payload)
PY
)"
  printf '{"tokens":{"id_token":"x.%s.y","access_token":"%s","refresh_token":"refresh-%s"}}\n' "$payload" "$access_token" "$access_token" >"$target"
}

write_mock_tools() {
  local mock_bin="$1" codex_log="$2" curl_log="$3"
  mkdir -p "$mock_bin"
  cat >"$mock_bin/curl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'curl-called\n' >>"${CURL_LOG:?}"
exit 7
EOF
  cat >"$mock_bin/codex" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${CODEX_LOG:?}"
if [[ "${1:-}" != "exec" ]]; then
  exit 99
fi
python3 - <<'PY' "${HOME:?}/.codex/auth.json"
import json
import sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    data = json.load(f)
token = data.get("tokens", {}).get("access_token", "")
if token == "token-work":
    raise SystemExit(0)
if token == "token-fast":
    print("usage limit reached, try again at Jan 12th, 2100 12:00 AM.", file=sys.stderr)
    raise SystemExit(1)
if token == "token-slow":
    print("usage limit reached, try again at Jan 13th, 2100 12:00 AM.", file=sys.stderr)
    raise SystemExit(1)
print(f"unexpected token: {token}", file=sys.stderr)
raise SystemExit(1)
PY
EOF
  chmod +x "$mock_bin/curl" "$mock_bin/codex"
}

PROJECT_USABLE="$TMP_DIR/project-usable"
HOME_USABLE="$TMP_DIR/home-usable"
MOCK_BIN_USABLE="$TMP_DIR/mock-bin-usable"
CODEX_LOG_USABLE="$TMP_DIR/codex-usable.log"
CURL_LOG_USABLE="$TMP_DIR/curl-usable.log"

setup_project "$PROJECT_USABLE"
setup_home "$HOME_USABLE"
write_mock_tools "$MOCK_BIN_USABLE" "$CODEX_LOG_USABLE" "$CURL_LOG_USABLE"

mkdir -p "$HOME_USABLE/.ai-auth/codex-fast@example-com-1" "$HOME_USABLE/.ai-auth/codex-work@example-com-2"
make_auth_json "fast@example.com" "$HOME_USABLE/.ai-auth/codex-fast@example-com-1/auth.json" "token-fast"
make_auth_json "work@example.com" "$HOME_USABLE/.ai-auth/codex-work@example-com-2/auth.json" "token-work"
make_auth_json "old@example.com" "$HOME_USABLE/.codex/auth.json" "token-old"

HOME="$HOME_USABLE" \
PROJECT_ROOT="$PROJECT_USABLE" \
PATH="$MOCK_BIN_USABLE:$PATH" \
CODEX_LOG="$CODEX_LOG_USABLE" \
CURL_LOG="$CURL_LOG_USABLE" \
  bash "$ROOT_DIR/bin/ai" --quiet --format json switch codex >"$TMP_DIR/usable.out"

python3 - <<'PY' "$TMP_DIR/usable.out"
import json
import pathlib
import sys

data = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
assert data["switched"] is True
assert data["slot"] == "work@example-com-2"
assert data["auth_email"] == "work@example.com"
assert data["status"] == "usable"
PY
grep -q '"slot": "work@example-com-2"' <(HOME="$HOME_USABLE" bash "$ROOT_DIR/bin/ai" --quiet --format json whoami codex)
grep -q '^exec ' "$CODEX_LOG_USABLE"
[[ "$(grep -c '^exec ' "$CODEX_LOG_USABLE")" -ge 2 ]]
[[ ! -e "$CURL_LOG_USABLE" || ! -s "$CURL_LOG_USABLE" ]]

HOME="$HOME_USABLE" \
PROJECT_ROOT="$PROJECT_USABLE" \
PATH="$MOCK_BIN_USABLE:$PATH" \
CODEX_LOG="$CODEX_LOG_USABLE" \
CURL_LOG="$CURL_LOG_USABLE" \
  bash "$ROOT_DIR/bin/ai" --quiet --format json status codex >"$TMP_DIR/status.out"

python3 - <<'PY' "$TMP_DIR/status.out"
import json
import pathlib
import sys

data = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
assert data["availability_cache"]["present"] is True
assert data["availability_cache"]["usable"] == 1
assert data["availability_cache"]["rate_limited"] == 1
assert data["availability_cache"]["refreshed_at"]
PY
[[ ! -e "$CURL_LOG_USABLE" || ! -s "$CURL_LOG_USABLE" ]]

echo "[PASS] freely ai switch/status for saved account slots use exec-only probing and never depend on curl inventory"

PROJECT_STATUS_REPORT_ONLY="$TMP_DIR/project-status-report-only"
HOME_STATUS_REPORT_ONLY="$TMP_DIR/home-status-report-only"
MOCK_BIN_STATUS_REPORT_ONLY="$TMP_DIR/mock-bin-status-report-only"
CODEX_LOG_STATUS_REPORT_ONLY="$TMP_DIR/codex-status-report-only.log"
CURL_LOG_STATUS_REPORT_ONLY="$TMP_DIR/curl-status-report-only.log"

setup_project "$PROJECT_STATUS_REPORT_ONLY"
setup_home "$HOME_STATUS_REPORT_ONLY"
write_mock_tools "$MOCK_BIN_STATUS_REPORT_ONLY" "$CODEX_LOG_STATUS_REPORT_ONLY" "$CURL_LOG_STATUS_REPORT_ONLY"

mkdir -p "$HOME_STATUS_REPORT_ONLY/.ai-auth/codex-fast@example-com-1" "$HOME_STATUS_REPORT_ONLY/.ai-auth/codex-work@example-com-2"
make_auth_json "fast@example.com" "$HOME_STATUS_REPORT_ONLY/.ai-auth/codex-fast@example-com-1/auth.json" "token-fast"
make_auth_json "work@example.com" "$HOME_STATUS_REPORT_ONLY/.ai-auth/codex-work@example-com-2/auth.json" "token-work"
make_auth_json "old@example.com" "$HOME_STATUS_REPORT_ONLY/.codex/auth.json" "token-old"

HOME="$HOME_STATUS_REPORT_ONLY" \
PROJECT_ROOT="$PROJECT_STATUS_REPORT_ONLY" \
PATH="$MOCK_BIN_STATUS_REPORT_ONLY:$PATH" \
CODEX_LOG="$CODEX_LOG_STATUS_REPORT_ONLY" \
CURL_LOG="$CURL_LOG_STATUS_REPORT_ONLY" \
  bash "$ROOT_DIR/bin/ai" --quiet --format json status codex >"$TMP_DIR/status-report-only.out"

python3 - <<'PY' "$TMP_DIR/status-report-only.out"
import json
import pathlib
import sys

data = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
assert data["availability_cache"]["present"] is True
assert data["availability_cache"]["usable"] == 1
assert data["availability_cache"]["rate_limited"] == 1
PY
grep -q '"auth_email": "old@example.com"' <(HOME="$HOME_STATUS_REPORT_ONLY" bash "$ROOT_DIR/bin/ai" --quiet --format json whoami codex)
[[ "$(grep -c '^exec ' "$CODEX_LOG_STATUS_REPORT_ONLY")" -ge 2 ]]
[[ ! -e "$CURL_LOG_STATUS_REPORT_ONLY" || ! -s "$CURL_LOG_STATUS_REPORT_ONLY" ]]

echo "[PASS] freely ai status refreshes exec availability without mutating the current auth slot"

PROJECT_ALL_UNAVAILABLE="$TMP_DIR/project-all-unavailable"
HOME_ALL_UNAVAILABLE="$TMP_DIR/home-all-unavailable"
MOCK_BIN_ALL_UNAVAILABLE="$TMP_DIR/mock-bin-all-unavailable"
CODEX_LOG_ALL_UNAVAILABLE="$TMP_DIR/codex-all-unavailable.log"
CURL_LOG_ALL_UNAVAILABLE="$TMP_DIR/curl-all-unavailable.log"

setup_project "$PROJECT_ALL_UNAVAILABLE"
setup_home "$HOME_ALL_UNAVAILABLE"
write_mock_tools "$MOCK_BIN_ALL_UNAVAILABLE" "$CODEX_LOG_ALL_UNAVAILABLE" "$CURL_LOG_ALL_UNAVAILABLE"

mkdir -p "$HOME_ALL_UNAVAILABLE/.ai-auth/codex-slow@example-com-3" "$HOME_ALL_UNAVAILABLE/.ai-auth/codex-fast@example-com-1"
make_auth_json "slow@example.com" "$HOME_ALL_UNAVAILABLE/.ai-auth/codex-slow@example-com-3/auth.json" "token-slow"
make_auth_json "fast@example.com" "$HOME_ALL_UNAVAILABLE/.ai-auth/codex-fast@example-com-1/auth.json" "token-fast"
make_auth_json "old@example.com" "$HOME_ALL_UNAVAILABLE/.codex/auth.json" "token-old"

set +e
HOME="$HOME_ALL_UNAVAILABLE" \
PROJECT_ROOT="$PROJECT_ALL_UNAVAILABLE" \
PATH="$MOCK_BIN_ALL_UNAVAILABLE:$PATH" \
CODEX_LOG="$CODEX_LOG_ALL_UNAVAILABLE" \
CURL_LOG="$CURL_LOG_ALL_UNAVAILABLE" \
  bash "$ROOT_DIR/bin/ai" --quiet --format json switch codex >"$TMP_DIR/all-unavailable.out"
rc=$?
set -e

[[ "$rc" == "4" ]]
python3 - <<'PY' "$TMP_DIR/all-unavailable.out"
import json
import pathlib
import sys

data = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
assert data["switched"] is False
assert data["status"] == "all_unavailable"
assert data["earliest_slot"] == "fast@example-com-1"
PY
[[ "$(grep -c '^exec ' "$CODEX_LOG_ALL_UNAVAILABLE")" -ge 2 ]]
[[ ! -e "$CURL_LOG_ALL_UNAVAILABLE" || ! -s "$CURL_LOG_ALL_UNAVAILABLE" ]]

echo "[PASS] freely ai switch codex sweeps all saved slots with exec-only probing and reports the earliest reset when none are usable"
