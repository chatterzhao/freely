#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-ai-account-switch.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

make_auth_json() {
  local email="$1" target="$2" access_token="${3:-token-$1}"
  local payload
  payload="$(python3 - <<'PY' "$email"
import base64
import json
import sys

payload = base64.urlsafe_b64encode(json.dumps({"email": sys.argv[1]}).encode()).decode().rstrip("=")
print(payload)
PY
)"
  printf '{"tokens":{"id_token":"x.%s.y","access_token":"%s"}}\n' "$payload" "$access_token" >"$target"
}

setup_project() {
  local project="$1"
  mkdir -p \
    "$project/.freely/run" \
    "$project/docs/system/workspace/skills/watchdog-control-plane/scripts" \
    "$project/docs/system/workspace/scripts/runtime"
  ln -sf \
    "$ROOT_DIR/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh" \
    "$project/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"
  ln -sf \
    "$ROOT_DIR/docs/system/workspace/scripts/runtime/network-proxy-resolver.sh" \
    "$project/docs/system/workspace/scripts/runtime/network-proxy-resolver.sh"
}

write_proxy_config() {
  local project="$1" mode="$2" all_proxy="$3" http_proxy="$4" https_proxy="$5" no_proxy="$6"
  mkdir -p "$project/.freely"
  cat >"$project/.freely/config.env" <<EOF
FREELY_NETWORK_PROXY_MODE="$mode"
FREELY_ALL_PROXY="$all_proxy"
FREELY_HTTP_PROXY="$http_proxy"
FREELY_HTTPS_PROXY="$https_proxy"
FREELY_NO_PROXY="$no_proxy"
EOF
}

setup_home() {
  local home_dir="$1"
  mkdir -p "$home_dir/.ai-auth" "$home_dir/.codex"
}

current_codex_email() {
  local auth_file="$1"
  python3 - <<'PY' "$auth_file"
import base64
import json
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)
token = data["tokens"]["id_token"].split(".")[1]
token += "=" * (-len(token) % 4)
payload = json.loads(base64.urlsafe_b64decode(token.encode()))
print(payload["email"])
PY
}

MOCK_BIN="$TMP_DIR/mock-bin"
mkdir -p "$MOCK_BIN"
cat >"$MOCK_BIN/curl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

scenario="${MOCK_OAUTH_SCENARIO:?}"
log_file="${MOCK_OAUTH_LOG:?}"
output_file=""
auth_header=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --connect-timeout|--max-time)
      shift 2
      ;;
    -o)
      output_file="$2"
      shift 2
      ;;
    -H)
      if [[ "$2" == Authorization:\ Bearer* ]]; then
        auth_header="$2"
      fi
      shift 2
      ;;
    -w)
      shift 2
      ;;
    -s|-S|-sS)
      shift
      ;;
    *)
      shift
      ;;
  esac
done

token="${auth_header#Authorization: Bearer }"
printf '%s|%s|%s|%s|%s|%s\n' "${ALL_PROXY:-}" "${HTTP_PROXY:-}" "${HTTPS_PROXY:-}" "${NO_PROXY:-}" "$scenario" "$token" >>"$log_file"

case "$scenario:$token" in
  usable:token-limited)
    printf '{"rate_limits":{"primary":{"used_percent":100.0,"resets_at":4102444800},"secondary":{"used_percent":0.0,"resets_at":0}}}\n' >"$output_file"
    printf '200'
    ;;
  usable:token-work)
    printf '{"rate_limits":{"primary":{"used_percent":25.0,"resets_at":0},"secondary":{"used_percent":0.0,"resets_at":0}}}\n' >"$output_file"
    printf '200'
    ;;
  earliest:token-slow)
    printf '{"rate_limits":{"primary":{"used_percent":100.0,"resets_at":4102531200},"secondary":{"used_percent":0.0,"resets_at":0}}}\n' >"$output_file"
    printf '200'
    ;;
  earliest:token-fast)
    printf '{"rate_limits":{"primary":{"used_percent":100.0,"resets_at":4102358400},"secondary":{"used_percent":0.0,"resets_at":0}}}\n' >"$output_file"
    printf '200'
    ;;
  *)
    printf '{"detail":"unexpected"}\n' >"$output_file"
    printf '500'
    exit 7
    ;;
esac
EOF
chmod +x "$MOCK_BIN/curl"

PROJECT_USABLE="$TMP_DIR/project-usable"
HOME_USABLE="$TMP_DIR/home-usable"
LOG_USABLE="$TMP_DIR/probe-usable.log"
setup_project "$PROJECT_USABLE"
write_proxy_config "$PROJECT_USABLE" "explicit" "socks5://proxy.example:1080" "http://proxy.example:8080" "http://proxy.example:8443" "localhost,127.0.0.1"
setup_home "$HOME_USABLE"
mkdir -p "$HOME_USABLE/.ai-auth/codex-limited@example-com-1" "$HOME_USABLE/.ai-auth/codex-work@example-com-2"
make_auth_json "limited@example.com" "$HOME_USABLE/.ai-auth/codex-limited@example-com-1/auth.json" "token-limited"
make_auth_json "work@example.com" "$HOME_USABLE/.ai-auth/codex-work@example-com-2/auth.json" "token-work"
make_auth_json "old@example.com" "$HOME_USABLE/.codex/auth.json" "token-old"
cat >"$PROJECT_USABLE/.freely/run/codex-availability-cache.tsv" <<'EOF'
slot	status	auth_email	reset_at	http_code	detail	refreshed_at
limited@example-com-1	usable	limited@example.com	0	200	stale_cache_hit	2099-01-01T00:00:00Z
work@example-com-2	rate_limited	work@example.com	4102444800	200	stale_cache_limit	2099-01-01T00:00:00Z
EOF

HOME="$HOME_USABLE" \
PROJECT_ROOT="$PROJECT_USABLE" \
PATH="$MOCK_BIN:$PATH" \
MOCK_OAUTH_SCENARIO="usable" \
MOCK_OAUTH_LOG="$LOG_USABLE" \
  bash "$ROOT_DIR/bin/ai" --quiet --format json switch codex >"$TMP_DIR/usable.out"

grep -q '"switched": true' "$TMP_DIR/usable.out"
grep -q '"auth_email": "work@example.com"' "$TMP_DIR/usable.out"
grep -q '"slot": "work@example-com-2"' "$TMP_DIR/usable.out"
grep -q '"status": "usable"' "$TMP_DIR/usable.out"
grep -q '"slot": "work@example-com-2"' <(HOME="$HOME_USABLE" bash "$ROOT_DIR/bin/ai" --quiet --format json whoami codex)
grep -q '"auth_email": "work@example.com"' <(HOME="$HOME_USABLE" bash "$ROOT_DIR/bin/ai" --quiet --format json whoami codex)
grep -q 'socks5://proxy.example:1080|http://proxy.example:8080|http://proxy.example:8443|localhost,127.0.0.1|usable|token-limited' "$LOG_USABLE"
grep -q 'socks5://proxy.example:1080|http://proxy.example:8080|http://proxy.example:8443|localhost,127.0.0.1|usable|token-work' "$LOG_USABLE"
grep -Eq '"availability_cache":[[:space:]]*\{"present":[[:space:]]*true' <(HOME="$HOME_USABLE" PROJECT_ROOT="$PROJECT_USABLE" bash "$ROOT_DIR/bin/ai" --quiet --format json status codex)

echo "[PASS] freely ai switch codex refreshes saved auth inventory and switches to the current usable account through project-scoped proxy config"

PROJECT_STATUS="$TMP_DIR/project-status"
HOME_STATUS="$TMP_DIR/home-status"
LOG_STATUS="$TMP_DIR/probe-status.log"
setup_project "$PROJECT_STATUS"
write_proxy_config "$PROJECT_STATUS" "explicit" "socks5://proxy.example:1080" "http://proxy.example:8080" "http://proxy.example:8443" "localhost,127.0.0.1"
setup_home "$HOME_STATUS"
mkdir -p "$HOME_STATUS/.ai-auth/codex-limited@example-com-1" "$HOME_STATUS/.ai-auth/codex-work@example-com-2"
make_auth_json "limited@example.com" "$HOME_STATUS/.ai-auth/codex-limited@example-com-1/auth.json" "token-limited"
make_auth_json "work@example.com" "$HOME_STATUS/.ai-auth/codex-work@example-com-2/auth.json" "token-work"
make_auth_json "old@example.com" "$HOME_STATUS/.codex/auth.json" "token-old"

TZ="America/Los_Angeles" \
HOME="$HOME_STATUS" \
PROJECT_ROOT="$PROJECT_STATUS" \
PATH="$MOCK_BIN:$PATH" \
MOCK_OAUTH_SCENARIO="usable" \
MOCK_OAUTH_LOG="$LOG_STATUS" \
  bash "$ROOT_DIR/bin/ai" --quiet --format json status codex >"$TMP_DIR/status.out"

grep -Eq '"availability_cache":[[:space:]]*\{"present":[[:space:]]*true' "$TMP_DIR/status.out"
grep -q '"usable": 1' "$TMP_DIR/status.out"
grep -q '"rate_limited": 1' "$TMP_DIR/status.out"
grep -Eq '"refreshed_at": ".*Z"' "$TMP_DIR/status.out"
grep -Eq '"refreshed_at_human": ".*(PST|PDT)"' "$TMP_DIR/status.out"
grep -q 'socks5://proxy.example:1080|http://proxy.example:8080|http://proxy.example:8443|localhost,127.0.0.1|usable|token-limited' "$LOG_STATUS"
grep -q 'socks5://proxy.example:1080|http://proxy.example:8080|http://proxy.example:8443|localhost,127.0.0.1|usable|token-work' "$LOG_STATUS"
[[ -f "$PROJECT_STATUS/.freely/run/codex-availability-cache.tsv" ]]

echo "[PASS] freely ai status refreshes stale codex inventory through project-scoped proxy config before reporting cache summary"

PROJECT_EARLIEST="$TMP_DIR/project-earliest"
HOME_EARLIEST="$TMP_DIR/home-earliest"
LOG_EARLIEST="$TMP_DIR/probe-earliest.log"
setup_project "$PROJECT_EARLIEST"
setup_home "$HOME_EARLIEST"
mkdir -p "$HOME_EARLIEST/.ai-auth/codex-slow@example-com-3" "$HOME_EARLIEST/.ai-auth/codex-fast@example-com-1"
make_auth_json "slow@example.com" "$HOME_EARLIEST/.ai-auth/codex-slow@example-com-3/auth.json" "token-slow"
make_auth_json "fast@example.com" "$HOME_EARLIEST/.ai-auth/codex-fast@example-com-1/auth.json" "token-fast"
make_auth_json "old@example.com" "$HOME_EARLIEST/.codex/auth.json" "token-old"

TZ="America/Los_Angeles" \
HOME="$HOME_EARLIEST" \
PROJECT_ROOT="$PROJECT_EARLIEST" \
PATH="$MOCK_BIN:$PATH" \
MOCK_OAUTH_SCENARIO="earliest" \
MOCK_OAUTH_LOG="$LOG_EARLIEST" \
  bash "$ROOT_DIR/bin/ai" --quiet --format json switch codex >"$TMP_DIR/earliest.out" || true

grep -q '"switched": false' "$TMP_DIR/earliest.out"
grep -q '"status": "all_unavailable"' "$TMP_DIR/earliest.out"
grep -q '"earliest_slot": "fast@example-com-1"' "$TMP_DIR/earliest.out"
grep -q '"reset_at_human": "2099.12.30 16:00:00 PST"' "$TMP_DIR/earliest.out"
grep -q '"launch_blocked": true' "$TMP_DIR/earliest.out"
grep -q '"slot": null' <(HOME="$HOME_EARLIEST" bash "$ROOT_DIR/bin/ai" --quiet --format json whoami codex)
grep -q 'earliest|token-slow' "$LOG_EARLIEST"
grep -q 'earliest|token-fast' "$LOG_EARLIEST"
grep -q 'old@example.com' <(current_codex_email "$HOME_EARLIEST/.codex/auth.json")
grep -Fq $'fast@example-com-1\t4102358400\t2099.12.30 16:00:00 PST' "$PROJECT_EARLIEST/.freely/run/codex-slot-cooldowns.tsv"

echo "[PASS] freely ai switch codex keeps launch blocked and leaves the current auth untouched when all slots are unavailable"
