#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-ai-account-switch.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

make_auth_json() {
  local email="$1" target="$2"
  local payload
  payload="$(python3 - <<'PY' "$email"
import base64
import json
import sys

payload = base64.urlsafe_b64encode(json.dumps({"email": sys.argv[1]}).encode()).decode().rstrip("=")
print(payload)
PY
)"
  printf '{"tokens":{"id_token":"x.%s.y"}}\n' "$payload" >"$target"
}

setup_project() {
  local project="$1"
  mkdir -p \
    "$project/.freely/run" \
    "$project/docs/system/workspace/skills/watchdog-control-plane/scripts"
  ln -sf \
    "$ROOT_DIR/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh" \
    "$project/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"
}

setup_home() {
  local home_dir="$1"
  mkdir -p "$home_dir/.ai-auth" "$home_dir/.codex"
}

current_codex_email() {
  local auth_file="$1"
  python3 - <<'PY' "$auth_file"
import base64
import json
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)
token = data["tokens"]["id_token"].split(".")[1]
token += "=" * (-len(token) % 4)
payload = json.loads(base64.urlsafe_b64decode(token.encode()))
print(payload["email"])
PY
}

MOCK_BIN="$TMP_DIR/mock-bin"
mkdir -p "$MOCK_BIN"
cat >"$MOCK_BIN/codex" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

auth_file="${HOME:?}/.codex/auth.json"
scenario="${MOCK_CODEX_SCENARIO:?}"
log_file="${MOCK_CODEX_LOG:?}"

if [[ "${ALL_PROXY:-}" != "http://127.0.0.1:7890" || "${HTTP_PROXY:-}" != "http://127.0.0.1:7890" || "${HTTPS_PROXY:-}" != "http://127.0.0.1:7890" ]]; then
  echo "proxy-missing"
  exit 9
fi

email="$(python3 - <<'PY' "$auth_file"
import base64
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as f:
    data = json.load(f)
token = data["tokens"]["id_token"].split(".")[1]
token += "=" * (-len(token) % 4)
payload = json.loads(base64.urlsafe_b64decode(token.encode()))
print(payload["email"])
PY
)"

printf '%s|%s|%s|%s\n' "$scenario" "$email" "${ALL_PROXY:-}" "${HTTP_PROXY:-}" >>"$log_file"

case "$scenario:$email" in
  usable:limited@example.com)
    echo "You've hit your usage limit. Please try again at Jan 2nd, 2100 12:00 AM."
    exit 1
    ;;
  usable:work@example.com)
    echo "hi"
    exit 0
    ;;
  earliest:slow@example.com)
    echo "You've hit your usage limit. Please try again at Jan 3rd, 2100 12:00 AM."
    exit 1
    ;;
  earliest:fast@example.com)
    echo "You've hit your usage limit. Please try again at Jan 1st, 2100 12:00 AM."
    exit 1
    ;;
  *)
    echo "unexpected:$scenario:$email"
    exit 7
    ;;
esac
EOF
chmod +x "$MOCK_BIN/codex"

PROJECT_USABLE="$TMP_DIR/project-usable"
HOME_USABLE="$TMP_DIR/home-usable"
LOG_USABLE="$TMP_DIR/probe-usable.log"
setup_project "$PROJECT_USABLE"
setup_home "$HOME_USABLE"
mkdir -p "$HOME_USABLE/.ai-auth/codex-limited@example-com-1" "$HOME_USABLE/.ai-auth/codex-work@example-com-2"
make_auth_json "limited@example.com" "$HOME_USABLE/.ai-auth/codex-limited@example-com-1/auth.json"
make_auth_json "work@example.com" "$HOME_USABLE/.ai-auth/codex-work@example-com-2/auth.json"
make_auth_json "old@example.com" "$HOME_USABLE/.codex/auth.json"

HOME="$HOME_USABLE" \
PROJECT_ROOT="$PROJECT_USABLE" \
PATH="$MOCK_BIN:$PATH" \
MOCK_CODEX_SCENARIO="usable" \
MOCK_CODEX_LOG="$LOG_USABLE" \
  bash "$ROOT_DIR/bin/ai" --quiet --format json switch codex >"$TMP_DIR/usable.out"

grep -q '"switched": true' "$TMP_DIR/usable.out"
grep -q '"auth_email": "work@example.com"' "$TMP_DIR/usable.out"
grep -q '"slot": "work@example-com-2"' "$TMP_DIR/usable.out"
grep -q '"status": "usable"' "$TMP_DIR/usable.out"
grep -q '"slot": "work@example-com-2"' <(HOME="$HOME_USABLE" bash "$ROOT_DIR/bin/ai" --quiet --format json whoami codex)
grep -q '"auth_email": "work@example.com"' <(HOME="$HOME_USABLE" bash "$ROOT_DIR/bin/ai" --quiet --format json whoami codex)
grep -q 'usable|limited@example.com|http://127.0.0.1:7890|http://127.0.0.1:7890' "$LOG_USABLE"
grep -q 'usable|work@example.com|http://127.0.0.1:7890|http://127.0.0.1:7890' "$LOG_USABLE"

echo "[PASS] freely ai switch codex auto-probes and switches to a usable account"

PROJECT_EARLIEST="$TMP_DIR/project-earliest"
HOME_EARLIEST="$TMP_DIR/home-earliest"
LOG_EARLIEST="$TMP_DIR/probe-earliest.log"
setup_project "$PROJECT_EARLIEST"
setup_home "$HOME_EARLIEST"
mkdir -p "$HOME_EARLIEST/.ai-auth/codex-slow@example-com-3" "$HOME_EARLIEST/.ai-auth/codex-fast@example-com-1"
make_auth_json "slow@example.com" "$HOME_EARLIEST/.ai-auth/codex-slow@example-com-3/auth.json"
make_auth_json "fast@example.com" "$HOME_EARLIEST/.ai-auth/codex-fast@example-com-1/auth.json"
make_auth_json "old@example.com" "$HOME_EARLIEST/.codex/auth.json"

HOME="$HOME_EARLIEST" \
PROJECT_ROOT="$PROJECT_EARLIEST" \
PATH="$MOCK_BIN:$PATH" \
MOCK_CODEX_SCENARIO="earliest" \
MOCK_CODEX_LOG="$LOG_EARLIEST" \
  bash "$ROOT_DIR/bin/ai" --quiet --format json switch codex >"$TMP_DIR/earliest.out" || true

grep -q '"switched": false' "$TMP_DIR/earliest.out"
grep -q '"status": "all_unavailable"' "$TMP_DIR/earliest.out"
grep -q '"earliest_slot": "fast@example-com-1"' "$TMP_DIR/earliest.out"
grep -q '"launch_blocked": true' "$TMP_DIR/earliest.out"
grep -q '"slot": null' <(HOME="$HOME_EARLIEST" bash "$ROOT_DIR/bin/ai" --quiet --format json whoami codex)
grep -q 'earliest|slow@example.com|http://127.0.0.1:7890|http://127.0.0.1:7890' "$LOG_EARLIEST"
grep -q 'earliest|fast@example.com|http://127.0.0.1:7890|http://127.0.0.1:7890' "$LOG_EARLIEST"
grep -q 'old@example.com' <(current_codex_email "$HOME_EARLIEST/.codex/auth.json")

echo "[PASS] freely ai switch codex keeps launch blocked and leaves the current auth untouched when all slots are unavailable"
