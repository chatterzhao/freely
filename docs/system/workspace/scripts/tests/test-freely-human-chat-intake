#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-human-chat-intake.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
mkdir -p "$PROJECT/docs/B1-docs/raw-20260319-0000"
mkdir -p "$PROJECT/.freely"

git init -q -b develop "$PROJECT"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF

cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF

cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF

cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF

cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF

cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260319-0000--sample
EOF

cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF

cat >"$PROJECT/docs/B1-docs/raw-20260319-0000/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF

cat >"$PROJECT/docs/B1-docs/raw-20260319-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
AI_REASONING_EFFORT="medium"
EOF

INTAKE_OUTPUT="$(TZ="America/Los_Angeles" bash "$ROOT_DIR/bin/freely" intake chat --project "$PROJECT" --message "现在需要检查前端技术栈，并研究 human chat intake 闭环")"
INTAKE_ID="$(printf '%s\n' "$INTAKE_OUTPUT" | sed -n 's/^intake_id: //p')"
INTAKE_PATH="$(printf '%s\n' "$INTAKE_OUTPUT" | sed -n 's/^intake_path: //p')"

[[ -n "$INTAKE_ID" ]] || {
  echo "[FAIL] missing intake_id output" >&2
  exit 1
}
[[ -f "$INTAKE_PATH/meta.env" ]] || {
  echo "[FAIL] missing intake meta file" >&2
  exit 1
}
[[ -f "$INTAKE_PATH/message.txt" ]] || {
  echo "[FAIL] missing intake message file" >&2
  exit 1
}

grep -q 'STATUS="new"' "$INTAKE_PATH/meta.env"
grep -q 'CHANNEL="chat"' "$INTAKE_PATH/meta.env"
grep -q '现在需要检查前端技术栈' "$INTAKE_PATH/message.txt"

STATUS_OUTPUT="$(TZ="America/Los_Angeles" bash "$ROOT_DIR/bin/freely" intake status --project "$PROJECT")"
printf '%s\n' "$STATUS_OUTPUT" | grep -q 'active_items: 1'
printf '%s\n' "$STATUS_OUTPUT" | grep -q 'new_items: 1'
printf '%s\n' "$STATUS_OUTPUT" | grep -q "$INTAKE_ID"
printf '%s\n' "$STATUS_OUTPUT" | grep -Eq 'created_at=.*(PST|PDT)'

PROMPT_OUTPUT="$(
  PROJECT_ROOT="$PROJECT" \
  INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md" \
  CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md" \
  AGENT_AI_TOOL="codex" \
  AI_MODEL="gpt-5.4" \
  AI_MODE="auto" \
  AI_REASONING_EFFORT="medium" \
    bash -lc '
      source "$1"
      build_prompt
    ' _ "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"
)"

printf '%s\n' "$PROMPT_OUTPUT" | grep -q 'Human chat intake queue:'
printf '%s\n' "$PROMPT_OUTPUT" | grep -q "$INTAKE_ID"
printf '%s\n' "$PROMPT_OUTPUT" | grep -q '现在需要检查前端技术栈'
printf '%s\n' "$PROMPT_OUTPUT" | grep -q 'skill:freely-human-interruption-handling'

CLAIM_OUTPUT="$(bash "$ROOT_DIR/bin/freely" intake claim --project "$PROJECT" --intake-id "$INTAKE_ID" --claimed-by manager --reaction followup --classification discovery --linked-artifact 'pending://brainstorm-handoff')"
printf '%s\n' "$CLAIM_OUTPUT" | grep -q 'status: classified'
grep -q 'STATUS="classified"' "$INTAKE_PATH/meta.env"
grep -q 'REACTION="followup"' "$INTAKE_PATH/meta.env"
grep -q 'CLASSIFICATION="discovery"' "$INTAKE_PATH/meta.env"
grep -q 'CLAIMED_BY="manager"' "$INTAKE_PATH/meta.env"

RESOLUTION_FILE="$TMP_DIR/resolution.md"
cat >"$RESOLUTION_FILE" <<'EOF'
# Interruption Resolution
- intent_summary: 研究前端技术栈与 human chat intake 如何进入 pre-brainstorm
- why_this_reaction: 当前 run 可自然结束，下一轮应立即处理
- absorption_recommendation: discovery -> doc-pre-brainstorm-execution
EOF

RESOLVE_OUTPUT="$(bash "$ROOT_DIR/bin/freely" intake resolve --project "$PROJECT" --intake-id "$INTAKE_ID" --resolved-by interruption-worker --reaction followup --classification discovery --resolution-file "$RESOLUTION_FILE" --absorption-target 'docs/B1-docs/raw-20260319-0000' --linked-artifact 'docs/B1-docs/raw-20260319-0000/brainstorms.md')"
RESOLUTION_ARTIFACT="$(printf '%s\n' "$RESOLVE_OUTPUT" | sed -n 's/^resolution_artifact: //p')"
[[ -f "$RESOLUTION_ARTIFACT" ]] || {
  echo "[FAIL] missing interruption resolution artifact" >&2
  exit 1
}
grep -q 'STATUS="absorbed"' "$INTAKE_PATH/meta.env"
grep -q 'ABSORPTION_TARGET="docs/B1-docs/raw-20260319-0000"' "$INTAKE_PATH/meta.env"
grep -q 'RESOLUTION_ARTIFACT="' "$INTAKE_PATH/meta.env"
grep -q 'absorption_recommendation' "$RESOLUTION_ARTIFACT"

STATUS_AFTER_RESOLVE="$(TZ="America/Los_Angeles" bash "$ROOT_DIR/bin/freely" intake status --project "$PROJECT")"
printf '%s\n' "$STATUS_AFTER_RESOLVE" | grep -q 'active_items: 0'
printf '%s\n' "$STATUS_AFTER_RESOLVE" | grep -q 'absorbed_items: 1'

echo "[PASS] freely human chat intake supports record, claim, resolution artifact, and completion writeback"
