#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-ensure-manager-teardown-race.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
mkdir -p "$PROJECT/docs/B1-docs/raw-20260331-0000" "$PROJECT/.freely/run" "$PROJECT/.freely/logs"

git init -q -b develop "$PROJECT"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260331-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260331-0000/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260331-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="kiro-cli"
AI_MODEL="auto"
AI_MODE="auto"
AI_REASONING_EFFORT=""
AUTO_SWITCH_TOOL="true"
AUTO_SWITCH_SLOT="true"
AI_FALLBACK_TOOLS="codex,iflow"
EOF

cat >"$PROJECT/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
SUPERVISOR_STATE="down"
AI_STATE="down"
LAST_EXIT_REASON="kiro_monthly_request_limit"
EOF

printf '11111\n' >"$PROJECT/.freely/run/supervisor.pid"

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

launch_log="$TMP_DIR/launch.log"
valid_supervisor_counter_file="$TMP_DIR/valid-supervisor-checks"
printf '0\n' >"$valid_supervisor_counter_file"

valid_supervisor_pid_for_project() {
  local checks
  [[ "$2" == "11111" ]] || return 1
  checks="$(cat "$valid_supervisor_counter_file")"
  checks=$((checks + 1))
  printf '%s\n' "$checks" >"$valid_supervisor_counter_file"
  if (( checks < 3 )); then
    return 0
  fi
  return 1
}
discover_supervisor_pid() { return 0; }
manager_ai_pid_for_project() { return 0; }
recover_stalled_manager_ai_if_needed() { return 1; }
ensure_codex_slot_ready_for_manager() { return 0; }
manager_runtime_recover_workers_if_needed() { return 0; }
launch_manager_supervisor() {
  printf '%s tool=%s\n' "$1" "$AI_TOOL" >>"$launch_log"
}
sleep() { :; }
log_info() { :; }
log_warn() { :; }
log_error() { :; }

if ! ensure_manager_once "$PROJECT" >/dev/null; then
  echo "[FAIL] ensure-manager should survive a supervisor teardown race and continue into fallback selection" >&2
  exit 1
fi

grep -q '^AI_TOOL="codex"$' "$PROJECT/.freely/config.env" || {
  echo "[FAIL] expected config to switch to codex after teardown race cleared" >&2
  cat "$PROJECT/.freely/config.env" >&2
  exit 1
}
grep -q "^$PROJECT tool=codex$" "$launch_log" || {
  echo "[FAIL] expected manager launch to proceed once teardown finished" >&2
  cat "$launch_log" >&2
  exit 1
}
grep -q 'event=manager_recheck_waiting_for_supervisor_teardown' "$PROJECT/.freely/logs/runtime-events.log" || {
  echo "[FAIL] expected runtime events to record teardown wait during recheck" >&2
  cat "$PROJECT/.freely/logs/runtime-events.log" >&2
  exit 1
}
grep -q 'event=manager_recheck_supervisor_teardown_observed' "$PROJECT/.freely/logs/runtime-events.log" || {
  echo "[FAIL] expected runtime events to record observed teardown completion" >&2
  cat "$PROJECT/.freely/logs/runtime-events.log" >&2
  exit 1
}

echo "[PASS] ensure-manager waits for an in-flight supervisor teardown before entering ordered fallback recovery"
