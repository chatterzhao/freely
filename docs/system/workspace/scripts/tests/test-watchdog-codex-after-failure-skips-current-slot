#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-watchdog-after-failure.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
HOME_DIR="$TMP_DIR/home"
mkdir -p "$PROJECT/.freely/run" "$HOME_DIR/.codex"

cat >"$HOME_DIR/.codex/auth.json" <<'EOF'
{"tokens":{"access_token":"token-current"}}
EOF

bash -lc '
  set -euo pipefail
  export HOME="'"$HOME_DIR"'"
  probe_log="'"$TMP_DIR"'/probe.log"
  confirm_log="'"$TMP_DIR"'/confirm.log"
  handoff_log="'"$TMP_DIR"'/handoff.log"
  log_info() { :; }
  log_warn() { :; }
  log_error() { printf "%s\n" "$*" >&2; }
  source "'"$ROOT_DIR"'/docs/system/workspace/skills/freely-freely-watchdog-control-plane/scripts/availability-watchdog.sh"
  codex_current_slot() { echo "same@example-com-1"; }
  codex_current_slot_kind() { echo "account"; }
  codex_current_identity_hint() { echo "same@example-com-1"; }
  codex_saved_slots_fingerprint() { echo "fp-1"; }
  codex_load_availability_state() { return 1; }
  should_defer_all_unavailable_reprobe() { return 1; }
  watchdog_force_reprobe_requested() { return 1; }
  codex_write_availability_state() { :; }
  codex_clear_availability_state() { :; }
  codex_cached_slot_status() { echo "usable"; }
  codex_live_auth_kind() { echo "account"; }
  wait_for_codex_slot_switch_idle() { return 0; }
  codex_probe_current_slot_now() {
    echo current >>"$probe_log"
    echo usable
  }
  codex_exec_saved_slot_truth() {
    local _project="$1" excluded_identity="${2:-}"
    [[ "$excluded_identity" == "same@example-com-1" ]] || {
      echo "[FAIL] expected after-failure exclusion identity to be propagated" >&2
      exit 1
    }
    echo "usable:same@example-com-2"
  }
  write_manager_bootstrap_handoff() {
    local _project="$1" _trigger="$2" _previous_slot="$3" active_slot="$4"
    printf "%s\n" "$active_slot" >"$handoff_log"
  }
  ensure_codex_slot_ready_for_manager "'"$PROJECT"'" after_failure
  [[ ! -f "$probe_log" ]] || [[ ! -s "$probe_log" ]]
  grep -q "^same@example-com-2$" "$handoff_log"
'

echo "[PASS] watchdog skips the failed current slot during after-failure recovery"
