#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-human-chat-routing.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

with_issue_chat="$TMP_DIR/human-chat-with-issue.txt"
no_issue_chat="$TMP_DIR/human-chat-no-issue.txt"
with_issue_milestone="$TMP_DIR/milestone-with-issue.md"
no_issue_milestone="$TMP_DIR/milestone-no-issue.md"

cat >"$with_issue_chat" <<'EOF'
我们已经有这条 manager / freely-context-source-skill 路线了，继续把它补成正式 issue 产物，优先走现有 issue 的文档收敛。
EOF

cat >"$no_issue_chat" <<'EOF'
我只是想到一个新问题：human chat 输入如何进入 auto-loop 首段编排，并正确路由到 doc-loop 或 dev-loop？这个还没有现成 issue，先帮我研究和收敛。
EOF

cat >"$with_issue_milestone" <<'EOF'
## M-test-with-issue

### committed_issues
1. `C-test-001`
- title: `manager-agent.md`
- milestone_state: committed
- promoted_issue_path: `pending://issue-materialization`
EOF

cat >"$no_issue_milestone" <<'EOF'
## M-test-no-issue

### committed_issues
- none currently

### candidate_issues
- none currently
EOF

prompt_with_issue="$(
  bash "$ROOT_DIR/docs/system/workspace/scripts/compose-context-source-prompt.sh" \
    --project "$ROOT_DIR" \
    --source-input-file "$with_issue_chat" \
    --milestone "$with_issue_milestone" \
    2>"$TMP_DIR/with-issue.stderr"
)"

prompt_no_issue="$(
  bash "$ROOT_DIR/docs/system/workspace/scripts/compose-context-source-prompt.sh" \
    --project "$ROOT_DIR" \
    --source-input-file "$no_issue_chat" \
    --milestone "$no_issue_milestone" \
    2>"$TMP_DIR/no-issue.stderr"
)"

printf '%s\n' "$prompt_with_issue" | grep -q "$with_issue_chat"
printf '%s\n' "$prompt_with_issue" | grep -q 'workspace/skills/doc-ibm-execution/SKILL.md'
printf '%s\n' "$prompt_with_issue" | grep -q 'issue-bound 文档收敛'
printf '%s\n' "$prompt_with_issue" | grep -q 'workspace/skills/freely-dev-loop-execution/SKILL.md'
test ! -s "$TMP_DIR/with-issue.stderr"

printf '%s\n' "$prompt_no_issue" | grep -q "$no_issue_chat"
printf '%s\n' "$prompt_no_issue" | grep -q 'workspace/skills/doc-pre-brainstorm-execution/SKILL.md'
printf '%s\n' "$prompt_no_issue" | grep -q '不要把路由理解成脚本硬编码分支'
test ! -s "$TMP_DIR/no-issue.stderr"

echo "[PASS] human chat routing prompt assembly scenarios are connected"
