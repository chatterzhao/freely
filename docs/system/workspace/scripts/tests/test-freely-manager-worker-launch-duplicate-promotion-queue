#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-duplicate-promotion.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/freely"
WT_ROOT="$TMP_DIR/freely-worktrees"
WORKER_A="$WT_ROOT/feature-a"
WORKER_B="$WT_ROOT/feature-b"

mkdir -p "$PROJECT/.freely/run/worker-prompts" "$PROJECT/.freely/logs" "$WT_ROOT"
cd "$PROJECT"
git init -q -b develop
git config user.name tester
git config user.email tester@example.com
echo base > README.md
git add README.md
git commit -q -m init
git branch feature/a
git branch feature/b
git worktree add "$WORKER_A" feature/a >/dev/null
git worktree add "$WORKER_B" feature/b >/dev/null

mkdir -p "$WORKER_A/.freely/run" "$WORKER_B/.freely/run"

PROMPT_A="$PROJECT/.freely/run/worker-prompts/20260402-130001-worker-promotion-a-codex.txt"
cat >"$PROMPT_A" <<EOF
Dispatch metadata:
- dispatch_priority: P0
- parallel_safe: true
- write_scope: $WORKER_A
- intent_kind: promotion
- intent_target: \`I-20260402-0455-A -> develop\`

Branch:
- \`feature/a\`

Worktree:
- \`$WORKER_A\`
EOF

PROMPT_B="$PROJECT/.freely/run/worker-prompts/20260402-130002-worker-promotion-b-codex.txt"
cat >"$PROMPT_B" <<EOF
Dispatch metadata:
- dispatch_priority: P1
- parallel_safe: true
- write_scope: $WORKER_B
- intent_kind: promotion
- intent_target: \`I-20260402-0455-A -> develop\`

Branch:
- \`feature/b\`

Worktree:
- \`$WORKER_B\`
EOF

CONTINUITY="$PROJECT/.freely/run/manager-continuity-20260402-130000.md"
cat >"$CONTINUITY" <<EOF
# Manager Continuity
- worker_prompt: \`$PROMPT_A\`
- worker_prompt: \`$PROMPT_B\`
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

LAUNCH_LOG="$TMP_DIR/launch.log"
launch_worker_from_manager_prompt_if_needed() {
  local _manager_project="$1" prompt_file="$2"
  basename "$prompt_file" >>"$LAUNCH_LOG"
  return 0
}

COUNT="$(manager_runtime_launch_workers_from_latest_handoff "$PROJECT")"
[[ "$COUNT" == "1" ]]
[[ "$(cat "$LAUNCH_LOG")" == "$(basename "$PROMPT_A")" ]]

# shellcheck disable=SC1090
source "$PROJECT/.freely/run/manager-worker-launch-state.env"
[[ "${LAST_MANAGER_WORKER_PROMPTS_CONSUMED:-}" == "$PROMPT_A" ]]
[[ "${QUEUED_WORKER_PROMPTS:-}" == "$PROMPT_B" ]]

echo "[PASS] duplicate promotion prompts queue the later owner instead of launching both"
