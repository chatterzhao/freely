#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-interruption-direct-answer.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
FREELY_HOME="$TMP_DIR/freely-home"
HANDLER_FIXTURE="$TMP_DIR/interruption-handler-fixture"
mkdir -p "$PROJECT/docs/pre-brainstorms/20260320-0000--sample"

git init -q -b develop "$PROJECT"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF

cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF

cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF

cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF

cat >"$PROJECT/docs/pre-brainstorms/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF

cat >"$PROJECT/docs/pre-brainstorms/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260320-0000--sample
EOF

cat >"$PROJECT/docs/pre-brainstorms/CONVERGENCE.md" <<'EOF'
# 收敛
EOF

cat >"$PROJECT/docs/pre-brainstorms/20260320-0000--sample/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF

cat >"$PROJECT/docs/pre-brainstorms/20260320-0000--sample/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$HANDLER_FIXTURE" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
project=""
intake_id=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) project="${2:-}"; shift 2 ;;
    --intake-id) intake_id="${2:-}"; shift 2 ;;
    *) shift ;;
  esac
done
message="$(cat "$project/.freely/intake/$intake_id/message.txt")"
if [[ "$message" == *后台* ]]; then
  cat <<'OUT'
DECISION=manager_answer_ai_process_status
REACTION=followup
CLASSIFICATION=control
WHY=这是主管监督面可直接回答的问题
OUT
else
  cat <<'OUT'
DECISION=delegate_general
REACTION=followup
CLASSIFICATION=discovery
WHY=这不属于主管直接回答范围
OUT
fi
EOF
chmod +x "$HANDLER_FIXTURE"

cd "$PROJECT"
FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" init --intent "$PROJECT/docs/PROJECT_INTENT.md" --constitution "$PROJECT/docs/CONSTITUTION.md" --ai codex:gpt-5.4:auto >/dev/null
FREELY_HOME="$FREELY_HOME" FREELY_INTERRUPTION_HANDLER_BIN="$HANDLER_FIXTURE" bash "$ROOT_DIR/bin/freely" ensure-interruption-dispatch --watch --interval 1 >/tmp/freely-interruption-dispatch.log 2>&1 &
DISPATCH_PID=$!
trap 'kill "$DISPATCH_PID" 2>/dev/null || true; wait "$DISPATCH_PID" 2>/dev/null || true; rm -rf "$TMP_DIR"' EXIT

for _ in $(seq 1 10); do
  if [[ -f ".freely/run/interruption-dispatch.pid" ]]; then
    READY_PID="$(cat ".freely/run/interruption-dispatch.pid" 2>/dev/null || true)"
    if [[ -n "$READY_PID" ]] && kill -0 "$READY_PID" 2>/dev/null; then
      break
    fi
  fi
  sleep 1
done
[[ -f ".freely/run/interruption-dispatch.pid" ]] || {
  echo "[FAIL] interruption dispatcher did not become ready" >&2
  exit 1
}

CHAT_OUTPUT="$(FREELY_HOME="$FREELY_HOME" FREELY_INTERRUPTION_HANDLER_BIN="$HANDLER_FIXTURE" bash "$ROOT_DIR/bin/freely" chat "看看后台进程都在做什么？")"
INTAKE_ID="$(printf '%s\n' "$CHAT_OUTPUT" | sed -n 's/^intake_id: //p')"
[[ -n "$INTAKE_ID" ]] || {
  echo "[FAIL] missing intake id" >&2
  exit 1
}

for _ in $(seq 1 10); do
  STATUS="$(awk -F '\"' '/^STATUS=/{print $2; exit}' ".freely/intake/$INTAKE_ID/meta.env")"
  if [[ "$STATUS" == "absorbed" ]]; then
    break
  fi
  sleep 1
done

[[ "$(awk -F '\"' '/^STATUS=/{print $2; exit}' ".freely/intake/$INTAKE_ID/meta.env")" == "absorbed" ]] || {
  echo "[FAIL] direct-answer intake was not absorbed" >&2
  exit 1
}
grep -q '^CLASSIFICATION="control"$' ".freely/intake/$INTAKE_ID/meta.env"
grep -q '^CLAIMED_BY="interruption-manager-agent"$' ".freely/intake/$INTAKE_ID/meta.env"
grep -q 'direct_answer: 当前没有运行中的后台 AI 进程。' ".freely/run/interruption-resolution/$INTAKE_ID/resolution.md"

bash -c 'exec -a "node /Users/test/.bun/bin/codex exec --skip-git-repo-check -C '"$PROJECT"' -m gpt-5.4 -" sleep 30' &
FAKE_AI_PID=$!
trap 'kill "$FAKE_AI_PID" 2>/dev/null || true; kill "$DISPATCH_PID" 2>/dev/null || true; wait "$FAKE_AI_PID" 2>/dev/null || true; wait "$DISPATCH_PID" 2>/dev/null || true; rm -rf "$TMP_DIR"' EXIT
printf '%s\n' "$FAKE_AI_PID" >".freely/run/ai.pid"

CHAT_OUTPUT_RUNNING="$(FREELY_HOME="$FREELY_HOME" FREELY_INTERRUPTION_HANDLER_BIN="$HANDLER_FIXTURE" bash "$ROOT_DIR/bin/freely" chat "看看后台AI进程都在做什么？")"
INTAKE_ID_RUNNING="$(printf '%s\n' "$CHAT_OUTPUT_RUNNING" | sed -n 's/^intake_id: //p')"
[[ -n "$INTAKE_ID_RUNNING" ]] || {
  echo "[FAIL] missing running intake id" >&2
  exit 1
}

for _ in $(seq 1 10); do
  STATUS_RUNNING="$(awk -F '\"' '/^STATUS=/{print $2; exit}' ".freely/intake/$INTAKE_ID_RUNNING/meta.env")"
  if [[ "$STATUS_RUNNING" == "absorbed" ]]; then
    break
  fi
  sleep 1
done

[[ "$(awk -F '\"' '/^STATUS=/{print $2; exit}' ".freely/intake/$INTAKE_ID_RUNNING/meta.env")" == "absorbed" ]] || {
  echo "[FAIL] running direct-answer intake was not absorbed" >&2
  exit 1
}
grep -q '正在运行' ".freely/run/interruption-resolution/$INTAKE_ID_RUNNING/resolution.md"
grep -q "$FAKE_AI_PID" ".freely/run/interruption-resolution/$INTAKE_ID_RUNNING/resolution.md"

CHAT_OUTPUT_DELEGATE="$(FREELY_HOME="$FREELY_HOME" FREELY_INTERRUPTION_HANDLER_BIN="$HANDLER_FIXTURE" bash "$ROOT_DIR/bin/freely" chat "去重新设计一下 TUI 输入体验")"
INTAKE_ID_DELEGATE="$(printf '%s\n' "$CHAT_OUTPUT_DELEGATE" | sed -n 's/^intake_id: //p')"
[[ -n "$INTAKE_ID_DELEGATE" ]] || {
  echo "[FAIL] missing delegate intake id" >&2
  exit 1
}
for _ in $(seq 1 10); do
  STATUS_DELEGATE="$(awk -F '\"' '/^STATUS=/{print $2; exit}' ".freely/intake/$INTAKE_ID_DELEGATE/meta.env")"
  if [[ "$STATUS_DELEGATE" == "classified" ]]; then
    break
  fi
  sleep 1
done
[[ "$(awk -F '\"' '/^STATUS=/{print $2; exit}' ".freely/intake/$INTAKE_ID_DELEGATE/meta.env")" == "classified" ]] || {
  echo "[FAIL] delegate intake was not classified" >&2
  exit 1
}
grep -q '^CLAIMED_BY="interruption-manager-agent"$' ".freely/intake/$INTAKE_ID_DELEGATE/meta.env"
grep -q '^CLASSIFICATION="discovery"$' ".freely/intake/$INTAKE_ID_DELEGATE/meta.env"
grep -q '^LINKED_ARTIFACT="pending://interruption-manager-delegation"$' ".freely/intake/$INTAKE_ID_DELEGATE/meta.env"

echo "[PASS] interruption manager triage answers manager-owned queries and claims delegate cases"
