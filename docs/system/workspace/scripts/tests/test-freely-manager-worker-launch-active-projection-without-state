#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-worker-active-projection.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
WORKER_WT="$TMP_DIR/worker-wt"
mkdir -p "$PROJECT/docs/B1-docs/raw-20260322-0000"

git init -q -b develop "$PROJECT"
git -C "$PROJECT" config user.name "Freely Test"
git -C "$PROJECT" config user.email "freely@example.com"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
- 20260322-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260322-0000/brainstorms.md" <<'EOF'
# Brainstorms
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260322-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

git -C "$PROJECT" add .
git -C "$PROJECT" commit -q -m "init"
git -C "$PROJECT" worktree add -q -b feature/test-worker "$WORKER_WT" develop
PROJECT="$(cd "$PROJECT" && pwd -P)"
WORKER_WT="$(cd "$WORKER_WT" && pwd -P)"

mkdir -p "$PROJECT/.freely/run/worker-prompts" "$PROJECT/.freely/logs" "$WORKER_WT/.freely/run" "$WORKER_WT/.freely/logs"
cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF
cat >"$WORKER_WT/.freely/config.env" <<EOF
PROJECT_ROOT="$WORKER_WT"
INTENT_FILE="$WORKER_WT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$WORKER_WT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

PROMPT_FILE="$PROJECT/.freely/run/worker-prompts/20260322-0412-worker-three-loop-continue-dev-codex.txt"
cat >"$PROMPT_FILE" <<EOF
Worktree:
- \`$WORKER_WT\`
Branch:
- \`feature/test-worker\`
dispatch_priority: P0
parallel_safe: true
write_scope: \`$WORKER_WT\`
intent_kind: edit
intent_target: \`$WORKER_WT\`
Owner-Issue:
- \`I-20260408-1205-A\`
Pre-Tests-Path:
- \`docs/B2-docs/sample/story/pre-tests.md\`
Verification-Artifact-Dir:
- \`docs/B2-docs/sample/story/code-reviews\`
Required-Test-Lanes:
- \`feature-local\`
Required-Acceptance-Item-Ids:
- \`worker-launch-linkage\`
Minimum-Evidence-Level:
- \`artifact-plus-human-observation\`
Target-Environment:
- \`develop\`
Closeout-Gate:
- \`owner-issue verification closeout\`
Closeout-Gate-Command:
- \`owner-issue verification closeout\`
Closeout-Target-Lane:
- \`post-merge-followthrough\`
Closeout-Promotion-Gate:
- \`completion\`
Closeout-Requires-Adequacy:
- \`false\`
Closeout-Review-Artifact-Policy:
- \`none\`
EOF

CONT_FILE="$PROJECT/.freely/run/manager-continuity-20260322-0412.md"
cat >"$CONT_FILE" <<EOF
# Manager Continuity

- delegated worker prompt:
  - $PROMPT_FILE
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

rm -f "$WORKER_WT/.freely/run/workcell-state.env"

REENTRY_LOG="$TMP_DIR/reentry.log"
START_LOG="$TMP_DIR/started.log"
request_local_continuation_reentry() {
  printf '%s|%s\n' "$1" "$2" >>"$REENTRY_LOG"
}
start_workcell_supervisor_async() {
  echo "$1" >>"$START_LOG"
}
manager_supervisor_pid_for_project() {
  local project="$1"
  if [[ "$project" == "$WORKER_WT" ]]; then
    echo "12345"
  fi
}
runtime_ai_pid_hint_for_project() {
  local project="$1"
  if [[ "$project" == "$WORKER_WT" ]]; then
    echo "54321"
  fi
}

LAUNCHED="$(manager_runtime_launch_workers_from_latest_handoff "$PROJECT")"
[[ "$LAUNCHED" == "1" ]] || {
  echo "[FAIL] expected one handled worker, got $LAUNCHED" >&2
  exit 1
}
[[ -f "$WORKER_WT/.freely/run/workcell-state.env" ]] || {
  echo "[FAIL] active worker path must recreate workcell state projection" >&2
  exit 1
}
grep -q '^DESIRED_RUNTIME_STATE="unknown"$' "$WORKER_WT/.freely/run/workcell-state.env"
grep -q '^LAST_WORKER_VERIFICATION_METADATA_PRESENT="true"$' "$WORKER_WT/.freely/run/workcell-state.env"
grep -q '^LAST_WORKER_OWNER_ISSUE="I-20260408-1205-A"$' "$WORKER_WT/.freely/run/workcell-state.env"
grep -q '^LAST_WORKER_CLOSEOUT_GATE_COMMAND="owner-issue verification closeout"$' "$WORKER_WT/.freely/run/workcell-state.env"
grep -q "$WORKER_WT|" "$REENTRY_LOG"
[[ ! -f "$START_LOG" ]]

echo "[PASS] active worker launch recreates state projection before reentry"
