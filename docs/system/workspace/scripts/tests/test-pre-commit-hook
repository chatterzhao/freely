#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-pre-commit-test.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

REPO="$TMP_DIR/repo"
mkdir -p "$REPO/bin" "$REPO/docs/system/workspace/hooks"
cd "$REPO"

git init -q -b develop
git config user.name tester
git config user.email tester@example.com
cp -R "$ROOT_DIR/.githooks" "$REPO/.githooks"
cp "$ROOT_DIR/docs/system/workspace/scripts/worktree/worktree-common.sh" "$REPO/bin/worktree-common.sh"
cp "$ROOT_DIR/docs/system/workspace/hooks/pre-commit.sh" "$REPO/docs/system/workspace/hooks/pre-commit.sh"
chmod +x "$REPO/.githooks/"* "$REPO/bin/worktree-common.sh"

echo base > README.md
git add README.md
git commit -q -m "init"

git checkout -q -b test-pre-merge-20260327-demo
echo test >> README.md
git add README.md

if "$REPO/.githooks/pre-commit" >"$TMP_DIR/stdout" 2>"$TMP_DIR/stderr"; then
  echo "[FAIL] pre-commit unexpectedly allowed direct commit on test-pre-merge batch" >&2
  exit 1
fi

cat "$TMP_DIR/stdout" "$TMP_DIR/stderr" | grep -q "ephemeral verification surfaces"
echo "[PASS] pre-commit blocks direct commit on test-pre-merge batches"
