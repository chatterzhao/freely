#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-pre-commit-test.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

REPO="$TMP_DIR/repo"
mkdir -p "$REPO/bin" "$REPO/docs/system/workspace/hooks"
cd "$REPO"

git init -q -b develop
git config user.name tester
git config user.email tester@example.com
cp -R "$ROOT_DIR/.githooks" "$REPO/.githooks"
cp "$ROOT_DIR/docs/system/workspace/scripts/worktree/worktree-common.sh" "$REPO/bin/worktree-common.sh"
cp "$ROOT_DIR/bin/pretests-gate" "$REPO/bin/pretests-gate"
cp "$ROOT_DIR/docs/system/workspace/hooks/pre-commit.sh" "$REPO/docs/system/workspace/hooks/pre-commit.sh"
mkdir -p "$REPO/docs/system/workspace/scripts/quality"
cp "$ROOT_DIR/docs/system/workspace/scripts/quality/pretests-gate" "$REPO/docs/system/workspace/scripts/quality/pretests-gate"
chmod +x "$REPO/.githooks/"* "$REPO/bin/worktree-common.sh" "$REPO/bin/pretests-gate" "$REPO/docs/system/workspace/scripts/quality/pretests-gate"

echo base > README.md
git add README.md
git commit -q -m "init"

git add .githooks docs/system/workspace/hooks/pre-commit.sh docs/system/workspace/scripts/quality/pretests-gate bin/worktree-common.sh bin/pretests-gate
git commit -q -m "seed hook tooling"

git checkout -q -b test-pre-merge-20260327-demo
echo test >> README.md
git add README.md

if "$REPO/.githooks/pre-commit" >"$TMP_DIR/stdout" 2>"$TMP_DIR/stderr"; then
  echo "[FAIL] pre-commit unexpectedly allowed direct commit on test-pre-merge batch" >&2
  exit 1
fi

cat "$TMP_DIR/stdout" "$TMP_DIR/stderr" | grep -q "ephemeral verification surfaces"
echo "[PASS] pre-commit blocks direct commit on test-pre-merge batches"

git checkout -q develop
git checkout -q -b feature/merge-completion
printf 'feature-side\n' > merge-conflict.txt
git add merge-conflict.txt
git commit -q -m "feature merge payload"

git checkout -q develop
printf 'develop-side\n' > merge-conflict.txt
git add merge-conflict.txt
git commit -q -m "develop merge payload"

set +e
git merge --no-commit feature/merge-completion >/dev/null 2>&1
merge_rc=$?
set -e
if [[ "$merge_rc" -eq 0 ]]; then
  echo "[FAIL] expected a conflict to keep MERGE_HEAD active for raw completion test" >&2
  exit 1
fi
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1

if "$REPO/.githooks/pre-commit" >"$TMP_DIR/stdout-merge" 2>"$TMP_DIR/stderr-merge"; then
  echo "[FAIL] pre-commit should block raw protected-branch merge completion" >&2
  exit 1
fi
cat "$TMP_DIR/stdout-merge" "$TMP_DIR/stderr-merge" | grep -q "raw merge completion"

FREELY_GUARDED_MERGE_COMPLETION=1 "$REPO/.githooks/pre-commit" >"$TMP_DIR/stdout-merge-allow" 2>"$TMP_DIR/stderr-merge-allow"
git merge --abort >/dev/null 2>&1

echo "[PASS] pre-commit only allows protected-branch merge completion through guarded path"

git checkout -q develop
git worktree add -q -b feature/pretests ../repo-worktrees/feature-pretests develop
FEATURE_WT="$(cd ../repo-worktrees/feature-pretests && pwd -P)"
mkdir -p "$FEATURE_WT/docs/epics/sample/story/issues" "$FEATURE_WT/docs/epics/sample/story"

cat > "$FEATURE_WT/docs/epics/sample/story/issues/sample.md" <<'EOF'
# Issue: sample

- issue_id: `I-sample`
- phase_state: `in_dev`
- pre_tests_path: `docs/epics/sample/story/pre-tests.md`
- verification_artifact_dir: `docs/epics/sample/story/code-reviews`
EOF

cat > "$FEATURE_WT/docs/epics/sample/story/pre-tests.md" <<'EOF'
# Pre-tests: sample

## Acceptance Items

### PT-1
- id: `PT-1`
- requirement: `sample`
- evidence_level: `integration`
- status: `pending`
- artifact_ref: `pending://pt-1`
EOF

(cd "$FEATURE_WT" && git add docs/epics/sample/story/issues/sample.md docs/epics/sample/story/pre-tests.md && git commit -q -m "seed sample issue")

cat > "$FEATURE_WT/docs/epics/sample/story/issues/sample.md" <<'EOF'
# Issue: sample

- issue_id: `I-sample`
- phase_state: `completed`
- pre_tests_path: `docs/epics/sample/story/pre-tests.md`
- verification_artifact_dir: `docs/epics/sample/story/code-reviews`
EOF

(cd "$FEATURE_WT" && git add docs/epics/sample/story/issues/sample.md)
if (cd "$FEATURE_WT" && "$REPO/.githooks/pre-commit" >"$TMP_DIR/stdout2" 2>"$TMP_DIR/stderr2"); then
  echo "[FAIL] pre-commit should block completed issue with pending acceptance items" >&2
  exit 1
fi
cat "$TMP_DIR/stdout2" "$TMP_DIR/stderr2" | grep -q "staged issue completion does not satisfy bound pre-tests evidence"

cat > "$FEATURE_WT/feature-note.md" <<'EOF'
note
EOF
(cd "$FEATURE_WT" && git restore --staged docs/epics/sample/story/issues/sample.md && git checkout -- docs/epics/sample/story/issues/sample.md && git add feature-note.md)
(cd "$FEATURE_WT" && "$REPO/.githooks/pre-commit" >"$TMP_DIR/stdout3" 2>"$TMP_DIR/stderr3")

echo "[PASS] pre-commit enforces completed issue gate without blocking unrelated feature commits"
