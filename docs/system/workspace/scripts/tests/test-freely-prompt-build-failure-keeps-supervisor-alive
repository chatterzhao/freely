#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-prompt-build-failure.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
mkdir -p \
  "$PROJECT/docs/B1-docs/raw-20260419-0000" \
  "$PROJECT/.freely/run" \
  "$PROJECT/.freely/logs"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF

cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF

cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF

cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF

cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF

cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
- 20260419-0000--sample
EOF

cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF

cat >"$PROJECT/docs/B1-docs/raw-20260419-0000/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF

cat >"$PROJECT/docs/B1-docs/raw-20260419-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="test-sleep"
AI_MODEL=""
AI_MODE="auto"
AI_REASONING_EFFORT=""
CHECK_INTERVAL=1
RESTART_DELAY=1
MAX_RESTARTS=0
IFLOW_MAX_TURNS=100
EOF

FREELY_TEST_FAIL_BUILD_PROMPT=1 bash "$ROOT_DIR/bin/freely" daemon start --project "$PROJECT" >/dev/null

SUPERVISOR_PID=""
for _ in $(seq 1 50); do
  if [[ -f "$PROJECT/.freely/run/supervisor.pid" ]]; then
    SUPERVISOR_PID="$(cat "$PROJECT/.freely/run/supervisor.pid" 2>/dev/null || true)"
  fi
  if [[ -n "$SUPERVISOR_PID" ]] && kill -0 "$SUPERVISOR_PID" 2>/dev/null; then
    break
  fi
  sleep 0.2
done
[[ -n "$SUPERVISOR_PID" ]] || {
  echo "[FAIL] daemon start did not materialize a live supervisor" >&2
  exit 1
}

event_log="$PROJECT/.freely/logs/runtime-events.log"
for _ in $(seq 1 30); do
  if [[ -f "$event_log" ]] && grep -q 'event=prompt_build_failed' "$event_log"; then
    break
  fi
  sleep 0.2
done

grep -q 'event=prompt_build_failed' "$event_log"
kill -0 "$SUPERVISOR_PID" 2>/dev/null
grep -q 'LAST_EXIT_REASON="prompt_build_failed"' "$PROJECT/.freely/run/workcell-state.env"

STATUS_OUTPUT="$(
  FREELY_STARTUP_SELF_HEAL_GRACE_SECS=1 \
  bash "$ROOT_DIR/bin/freely" live-status --project "$PROJECT"
)"

grep -q 'desired_runtime_state: running' <<<"$STATUS_OUTPUT"
grep -q 'last_supervisor_state: up' <<<"$STATUS_OUTPUT"
grep -q 'last_ai_state: down' <<<"$STATUS_OUTPUT"
grep -q 'last_exit_reason: prompt_build_failed' <<<"$STATUS_OUTPUT"
grep -q "role=supervisor pid=$SUPERVISOR_PID " <<<"$STATUS_OUTPUT"
! grep -q 'startup_self_heal_no_runtime' "$event_log"

bash "$ROOT_DIR/bin/freely" daemon stop --project "$PROJECT" >/dev/null

echo "[PASS] prompt build failure keeps supervisor alive and surfaces retryable state instead of self-healing runtime down"
