#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-live-status-manager-handoff.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

REPO="$TMP_DIR/repo"
mkdir -p "$REPO/.freely/run" "$REPO/docs"

git init -q "$REPO"
git -C "$REPO" config user.email "test@example.com"
git -C "$REPO" config user.name "Test User"
cat >"$REPO/README.md" <<'EOF'
# repo
EOF
git -C "$REPO" add README.md
git -C "$REPO" commit -q -m "init"
git -C "$REPO" branch -m develop

cat >"$REPO/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$REPO/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$REPO/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$REPO/.freely/config.env" <<EOF
PROJECT_ROOT="$REPO"
INTENT_FILE="$REPO/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$REPO/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF
cat >"$REPO/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="up"
LAST_AI_STATE="up"
LAST_EXIT_REASON="none"
LAST_ROLE_HINT="manager"
LAST_STATE_UPDATED_AT="2026-04-13T05:53:48Z"
EOF

EXPECTED_CONTINUITY="$REPO/.freely/run/manager-continuity-20260413-055348.md"
PROMPT="$REPO/.freely/run/prompt-20260413-055346.txt"

cat >"$PROMPT" <<EOF
你现在进入 Freely 的首跳闭环。
19. 至少创建一个 manager continuity 文件：\`$EXPECTED_CONTINUITY\`。
EOF
cat >"$EXPECTED_CONTINUITY" <<EOF
# Manager Continuity
- continuity_id: \`20260413-055348\`
- continuity_written_by: \`freely-runtime-startup-stub\`
EOF

LIVE_OUTPUT="$(bash "$ROOT_DIR/bin/freely" live-status --project "$REPO")"
FLEET_OUTPUT="$(bash "$ROOT_DIR/bin/freely" fleet-status --project "$REPO")"

printf '%s\n' "$LIVE_OUTPUT" | grep -q 'manager_handoff_state: seeded_stub'
printf '%s\n' "$LIVE_OUTPUT" | grep -q 'manager_handoff_reason: runtime_seeded_startup_stub'
printf '%s\n' "$LIVE_OUTPUT" | grep -q "manager_handoff_expected_path: $EXPECTED_CONTINUITY"
printf '%s\n' "$LIVE_OUTPUT" | grep -q "manager_handoff_prompt_file: $PROMPT"
printf '%s\n' "$LIVE_OUTPUT" | grep -q 'manager_handoff_writer: freely-runtime-startup-stub'
printf '%s\n' "$FLEET_OUTPUT" | grep -q 'manager_handoff'
printf '%s\n' "$FLEET_OUTPUT" | grep -q "state=seeded_stub reason=runtime_seeded_startup_stub expected=$EXPECTED_CONTINUITY writer=freely-runtime-startup-stub"

echo "[PASS] live-status and fleet-status surface machine-readable manager handoff state"
