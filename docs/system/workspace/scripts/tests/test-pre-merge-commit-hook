#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-pre-merge-commit-hook.XXXXXX)"
PIDS=()
cleanup() {
  local pid
  for pid in "${PIDS[@]:-}"; do
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  done
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

REPO="$TMP_DIR/repo"
mkdir -p \
  "$REPO/bin" \
  "$REPO/.githooks" \
  "$REPO/docs/system/workspace/hooks" \
  "$REPO/docs/system/workspace/scripts/quality" \
  "$REPO/docs/system/workspace/scripts/runtime" \
  "$REPO/docs/system/workspace/skills/watchdog-control-plane/scripts"
cd "$REPO"

git init -q -b develop
git config user.name tester
git config user.email tester@example.com
git config core.hooksPath .githooks

cp "$ROOT_DIR/.githooks/pre-merge-commit" "$REPO/.githooks/pre-merge-commit"
cp "$ROOT_DIR/bin/governance-merge-gate" "$REPO/bin/governance-merge-gate"
cp "$ROOT_DIR/bin/governance-promotion-gate" "$REPO/bin/governance-promotion-gate"
cp "$ROOT_DIR/docs/system/workspace/hooks/pre-merge-commit.sh" "$REPO/docs/system/workspace/hooks/pre-merge-commit.sh"
cp "$ROOT_DIR/docs/system/workspace/scripts/quality/governance-merge-gate" "$REPO/docs/system/workspace/scripts/quality/governance-merge-gate"
cp "$ROOT_DIR/docs/system/workspace/scripts/quality/governance-promotion-gate" "$REPO/docs/system/workspace/scripts/quality/governance-promotion-gate"
cp "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely" "$REPO/docs/system/workspace/scripts/runtime/freely"
cp "$ROOT_DIR/docs/system/workspace/scripts/runtime/session-evidence-resolver.sh" "$REPO/docs/system/workspace/scripts/runtime/session-evidence-resolver.sh"
cp "$ROOT_DIR/docs/system/workspace/scripts/runtime/network-proxy-resolver.sh" "$REPO/docs/system/workspace/scripts/runtime/network-proxy-resolver.sh"
cp "$ROOT_DIR/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh" "$REPO/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"
chmod +x \
  "$REPO/.githooks/pre-merge-commit" \
  "$REPO/bin/governance-merge-gate" \
  "$REPO/bin/governance-promotion-gate" \
  "$REPO/docs/system/workspace/hooks/pre-merge-commit.sh" \
  "$REPO/docs/system/workspace/scripts/quality/governance-merge-gate" \
  "$REPO/docs/system/workspace/scripts/quality/governance-promotion-gate" \
  "$REPO/docs/system/workspace/scripts/runtime/freely" \
  "$REPO/docs/system/workspace/scripts/runtime/session-evidence-resolver.sh" \
  "$REPO/docs/system/workspace/scripts/runtime/network-proxy-resolver.sh" \
  "$REPO/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"

write_guarded_state() {
  local target="$1"
  local source_branch="$2"
  local bypass_mode="${3:-forbidden}"
  cat >"$REPO/.git/freely-guarded-merge-state" <<EOF
target_branch=$target
source_branch=$source_branch
bypass_mode=$bypass_mode
EOF
}

mkdir -p "$REPO/docs"
cat > "$REPO/docs/milestones.md" <<'EOF'
# Milestones

## M-sample

- status: active

### candidate_issues
1. `C-20260327-2205-A`

### committed_issues
1. `I-20260327-2205-A`
   - issue_path: `docs/epics/sample/story/issues/sample.md`
   - source_candidates:
     - `docs/pre-brainstorms/sample/candidates.md#c-20260327-2205-a`

### completed_issues
EOF

mkdir -p "$REPO/docs/pre-brainstorms/sample"
cat > "$REPO/docs/pre-brainstorms/sample/candidates.md" <<'EOF'
# Candidates

### C-20260327-2205-A
- status: proposed
- milestone: `M-sample`
- next_action: keep researching the same candidate
- revisit_trigger: new evidence arrives
EOF

mkdir -p "$REPO/docs/epics/sample/story/issues"
cat > "$REPO/docs/epics/sample/story/issues/sample.md" <<'EOF'
# Issue: sample

- issue_id: `I-20260327-2205-A`
- phase_state: `in_dev`
- milestone: `M-sample`
- source_candidate: `docs/pre-brainstorms/sample/candidates.md#c-20260327-2205-a`
EOF

echo base > README.md
git add \
  README.md \
  .githooks/pre-merge-commit \
  bin/governance-merge-gate \
  bin/governance-promotion-gate \
  docs/milestones.md \
  docs/pre-brainstorms/sample/candidates.md \
  docs/epics/sample/story/issues/sample.md \
  docs/system/workspace/hooks/pre-merge-commit.sh \
  docs/system/workspace/scripts/quality/governance-merge-gate \
  docs/system/workspace/scripts/quality/governance-promotion-gate \
  docs/system/workspace/scripts/runtime/freely \
  docs/system/workspace/scripts/runtime/session-evidence-resolver.sh \
  docs/system/workspace/scripts/runtime/network-proxy-resolver.sh \
  docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh
git commit -q -m "init"

git checkout -q -b feature/runtime-only-change
mkdir -p docs/system/workspace/scripts/runtime
cat > docs/system/workspace/scripts/runtime/freely <<'EOF'
#!/usr/bin/env bash
echo runtime
EOF
chmod +x docs/system/workspace/scripts/runtime/freely
git add docs/system/workspace/scripts/runtime/freely
git commit -q -m "runtime-only change"

git checkout -q develop
if git merge --no-ff feature/runtime-only-change >"$TMP_DIR/stdout" 2>"$TMP_DIR/stderr"; then
  echo "[FAIL] pre-merge-commit hook should block raw develop merge without guarded handshake" >&2
  exit 1
fi

cat "$TMP_DIR/stdout" "$TMP_DIR/stderr" >"$TMP_DIR/raw-merge-output"
grep -q "Raw develop merges are not an allowed entrypoint" "$TMP_DIR/raw-merge-output"
grep -q "./bin/merge-guarded" "$TMP_DIR/raw-merge-output"
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1
git merge --abort >/dev/null 2>&1

git merge --no-commit --no-ff feature/runtime-only-change >/dev/null 2>&1
write_guarded_state develop feature/runtime-only-change
if FREELY_GUARDED_MERGE_COMPLETION=1 .githooks/pre-merge-commit >"$TMP_DIR/guarded-governance-stdout" 2>"$TMP_DIR/guarded-governance-stderr"; then
  echo "[FAIL] guarded develop merge should still fail governance materialization without candidate evidence" >&2
  exit 1
fi
cat "$TMP_DIR/guarded-governance-stdout" "$TMP_DIR/guarded-governance-stderr" >"$TMP_DIR/guarded-governance-output"
grep -q "Merge blocked: develop-bound governance materialization gate failed" "$TMP_DIR/guarded-governance-output"
grep -q "no candidate-driven lifecycle evidence" "$TMP_DIR/guarded-governance-output"
git merge --abort >/dev/null 2>&1
rm -f "$REPO/.git/freely-guarded-merge-state"

git checkout -q -b feature/promotion-owner
mkdir -p docs/epics/sample/story/code-reviews src
cat > docs/pre-brainstorms/sample/candidates.md <<'EOF'
# Candidates

### C-20260327-2205-A
- status: promoted
- milestone: `M-sample`
- promoted_issue_id: `I-20260327-2205-A`
- promoted_issue_path: `docs/epics/sample/story/issues/sample.md`
EOF
cat > docs/epics/sample/story/issues/sample.md <<'EOF'
# Issue: sample

- issue_id: `I-20260327-2205-A`
- phase_state: `in_verification`
- milestone: `M-sample`
- source_candidate: `docs/pre-brainstorms/sample/candidates.md#c-20260327-2205-a`
- verification_artifact_dir: `docs/epics/sample/story/code-reviews`
EOF
cat > docs/epics/sample/story/code-reviews/r-sample.md <<'EOF'
# Review: sample

- issue_id: `I-20260327-2205-A`

## Implementation Decision Note

- decision: `Keep the develop promotion bound to a single active owner.`
- why_this: `Promotion followthrough is stateful and duplicate owners stomp each other at merge time.`
- alternatives_considered: `Relying on a clean worktree alone would not distinguish duplicate promotion intents.`
- boundary_non_goals: `This does not arbitrate unrelated worktrees or non-develop merges.`
- residual_risk: `Dormant prompts can still exist, but only active workers block phase-1 promotion replay.`
EOF
echo "console.log('promotion owner');" > src/sample.js
git add docs/pre-brainstorms/sample/candidates.md docs/epics/sample/story/issues/sample.md docs/epics/sample/story/code-reviews/r-sample.md src/sample.js
git commit -q -m "promotion owner payload"

git checkout -q develop
SOURCE_WT="$TMP_DIR/source-worker"
CONFLICT_WT="$TMP_DIR/conflict-worker"
git worktree add -q "$SOURCE_WT" feature/promotion-owner
git worktree add -q -b feature/promotion-conflict "$CONFLICT_WT" develop

mkdir -p "$SOURCE_WT/.freely/run" "$CONFLICT_WT/.freely/run"
cat > "$SOURCE_WT/.freely/run/prompt-20260402-080000.txt" <<EOF
Worktree:
- \`$SOURCE_WT\`
Branch:
- \`feature/promotion-owner\`
- intent_kind: promotion
- intent_target: \`I-20260327-2205-A -> develop\`
EOF
cat > "$CONFLICT_WT/.freely/run/prompt-20260402-080100.txt" <<EOF
Worktree:
- \`$CONFLICT_WT\`
Branch:
- \`feature/promotion-conflict\`
- intent_kind: promotion
- intent_target: \`I-20260327-2205-A -> develop\`
EOF

(
  cd "$SOURCE_WT"
  exec bash -lc 'exec -a "codex exec" sleep 300'
) &
SOURCE_PID=$!
PIDS+=("$SOURCE_PID")
printf '%s\n' "$SOURCE_PID" > "$SOURCE_WT/.freely/run/ai.pid"

(
  cd "$CONFLICT_WT"
  exec bash -lc 'exec -a "codex exec" sleep 300'
) &
CONFLICT_PID=$!
PIDS+=("$CONFLICT_PID")
printf '%s\n' "$CONFLICT_PID" > "$CONFLICT_WT/.freely/run/ai.pid"

set +e
git merge --no-commit --no-ff feature/promotion-owner >/dev/null 2>&1
merge_prepare_rc=$?
set -e
if [[ "$merge_prepare_rc" -ne 0 ]] && ! git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  echo "[FAIL] could not prepare duplicate-ownership merge for pre-merge-commit hook" >&2
  exit 1
fi
write_guarded_state develop feature/promotion-owner
if FREELY_GUARDED_MERGE_COMPLETION=1 .githooks/pre-merge-commit >"$TMP_DIR/promotion-stdout" 2>"$TMP_DIR/promotion-stderr"; then
  echo "[FAIL] pre-merge-commit hook should block duplicate develop promotion ownership" >&2
  exit 1
fi

cat "$TMP_DIR/promotion-stdout" "$TMP_DIR/promotion-stderr" >"$TMP_DIR/promotion-output"
grep -q "promotion ownership gate failed" "$TMP_DIR/promotion-output" || {
  cat "$TMP_DIR/promotion-output" >&2
  exit 1
}
grep -q "duplicate develop promotion ownership is already active" "$TMP_DIR/promotion-output" || {
  cat "$TMP_DIR/promotion-output" >&2
  exit 1
}
git merge --abort >/dev/null 2>&1
rm -f "$REPO/.git/freely-guarded-merge-state"

kill "$CONFLICT_PID" 2>/dev/null || true
wait "$CONFLICT_PID" 2>/dev/null || true
rm -f "$CONFLICT_WT/.freely/run/ai.pid"

git merge --no-commit --no-ff feature/promotion-owner >/dev/null 2>&1
write_guarded_state develop feature/promotion-owner
FREELY_GUARDED_MERGE_COMPLETION=1 .githooks/pre-merge-commit >"$TMP_DIR/promotion-success-stdout" 2>"$TMP_DIR/promotion-success-stderr"
FREELY_GUARDED_MERGE_COMPLETION=1 git commit -q --no-edit
git merge-base --is-ancestor feature/promotion-owner develop
rm -f "$REPO/.git/freely-guarded-merge-state"

echo "[PASS] pre-merge-commit hook enforces guarded develop entrypoint, governance materialization, and duplicate promotion ownership"
