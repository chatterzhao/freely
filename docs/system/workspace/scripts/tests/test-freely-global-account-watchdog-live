#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
MANAGER_PROJECT="/Users/zhaoyu/Downloads/code/my-freely/freely"
GOOD_ACCOUNT=""
BAD_ACCOUNTS=()
TIMEOUT_SECONDS=90
LOG_ROOT="${TMPDIR:-/tmp}/freely-global-account-watchdog-live-$$"
mkdir -p "$LOG_ROOT"
TRACE_FILE="$LOG_ROOT/trace.log"

usage() {
  cat <<'EOF'
Usage:
  test-freely-global-account-watchdog-live \
    [--manager-project <abs_path>] \
    [--good-account <email>] \
    [--bad-account <email>]...

Purpose:
  - start the global ensure-manager watchdog first
  - then intentionally switch the global codex account to known-bad accounts
  - if --good-account is omitted, probe saved accounts and discover a currently usable one
  - verify the watchdog/runtime automatically switches back to the usable account
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --manager-project) MANAGER_PROJECT="${2:?}"; shift 2 ;;
    --good-account) GOOD_ACCOUNT="${2:?}"; shift 2 ;;
    --bad-account) BAD_ACCOUNTS+=("${2:?}"); shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown arg: $1" >&2; usage >&2; exit 1 ;;
  esac
done

saved_codex_accounts() {
  bash "$ROOT_DIR/bin/ai" list 2>/dev/null | sed -n 's/^  codex-//p'
}

normalize_account() {
  printf '%s\n' "$1" | sed 's/\./-/g'
}

probe_current_account_now() {
  local prompt_file output_file rc
  prompt_file="$(mktemp)"
  output_file="$(mktemp)"
  printf 'Reply with exactly: OK\n' >"$prompt_file"
  rc=0
  (
    cd "$MANAGER_PROJECT"
    codex exec --skip-git-repo-check -C "$MANAGER_PROJECT" --dangerously-bypass-approvals-and-sandbox - <"$prompt_file"
  ) >"$output_file" 2>&1 || rc=$?
  rm -f "$prompt_file"
  if [[ "$rc" -eq 0 ]] && rg -q '^OK$' "$output_file"; then
    rm -f "$output_file"
    return 0
  fi
  rm -f "$output_file"
  return 1
}

discover_good_account() {
  local candidate
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    if [[ " ${BAD_ACCOUNTS[*]} " == *" ${candidate} "* ]]; then
      continue
    fi
    switch_account "$candidate" >/dev/null 2>&1 || continue
    if probe_current_account_now; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(saved_codex_accounts)
  return 1
}

whoami_auth_email() {
  local output
  output="$(bash "$ROOT_DIR/bin/ai" whoami 2>/dev/null || true)"
  printf '%s\n' "$output" | sed -n 's/.*Current auth email: //p'
}

status_field() {
  local field="$1" output
  output="$(bash "$ROOT_DIR/bin/freely" baseline-status --project "$MANAGER_PROJECT" 2>/dev/null || true)"
  printf '%s\n' "$output" | sed -n "s/^${field}: //p"
}

latest_cycle_log() {
  local latest
  latest="$(python3 - <<'PY' "$MANAGER_PROJECT/.freely/logs"
from pathlib import Path
import sys
root = Path(sys.argv[1])
paths = sorted(root.glob("cycle-*.log"), key=lambda p: p.stat().st_mtime, reverse=True)
print(paths[0] if paths else "")
PY
)"
  [[ -n "$latest" ]] || return 1
  printf '%s\n' "$latest"
}

latest_cycle_session_id() {
  local latest
  latest="$(latest_cycle_log || true)"
  [[ -n "$latest" ]] || return 0
  sed -n 's/^session id: //p' "$latest" | sed -n '1p'
}

loop_launch_count() {
  local loop_log
  loop_log="$MANAGER_PROJECT/.freely/logs/loop.log"
  [[ -f "$loop_log" ]] || {
    printf '0\n'
    return 0
  }
  rg -c '^=====' "$loop_log"
}

trace_event() {
  local event="$1"
  local account supervisor_pid ai_pid latest_log latest_session launch_count
  account="$(whoami_auth_email || true)"
  supervisor_pid="$(status_field supervisor_pid)"
  ai_pid="$(status_field ai_pid)"
  latest_log="$(latest_cycle_log || true)"
  latest_session="$(latest_cycle_session_id || true)"
  launch_count="$(loop_launch_count)"
  printf '%s event=%s account=%s supervisor_pid=%s ai_pid=%s latest_cycle=%s latest_session=%s launch_count=%s\n' \
    "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
    "$event" \
    "${account:-unavailable}" \
    "${supervisor_pid:-none}" \
    "${ai_pid:-none}" \
    "${latest_log:-none}" \
    "${latest_session:-none}" \
    "${launch_count:-0}" >>"$TRACE_FILE"
}

switch_account() {
  local account="$1"
  bash "$ROOT_DIR/bin/ai" switch codex "$account" --yes >/dev/null
}

stop_manager() {
  bash "$ROOT_DIR/bin/freely" stop --project "$MANAGER_PROJECT" >/dev/null 2>&1 || true
}

wait_for_manager_stopped() {
  local timeout="$1"
  local start_ts now supervisor_pid
  start_ts="$(date +%s)"
  while true; do
    supervisor_pid="$(status_field supervisor_pid)"
    if [[ -z "$supervisor_pid" || "$supervisor_pid" == "none" ]]; then
      return 0
    fi
    if ! kill -0 "$supervisor_pid" 2>/dev/null; then
      return 0
    fi
    now="$(date +%s)"
    if (( now - start_ts >= timeout )); then
      return 1
    fi
    sleep 2
  done
}

start_manager() {
  local log_file="$1"
  bash "$ROOT_DIR/bin/freely" ensure-manager --watch --interval 2 --project "$MANAGER_PROJECT" >"$log_file" 2>&1 &
  printf '%s\n' "$!"
}

wait_for_pid_gone() {
  local pid="$1" timeout="$2"
  local start_ts now
  [[ -n "$pid" ]] || return 0
  start_ts="$(date +%s)"
  while kill -0 "$pid" 2>/dev/null; do
    now="$(date +%s)"
    if (( now - start_ts >= timeout )); then
      return 1
    fi
    sleep 1
  done
  return 0
}

wait_for_manager_supervisor() {
  local timeout="$1"
  local start_ts now supervisor_pid
  start_ts="$(date +%s)"
  while true; do
    supervisor_pid="$(status_field supervisor_pid)"
    if [[ -n "$supervisor_pid" && "$supervisor_pid" != "none" ]] && kill -0 "$supervisor_pid" 2>/dev/null; then
      return 0
    fi
    now="$(date +%s)"
    if (( now - start_ts >= timeout )); then
      return 1
    fi
    sleep 2
  done
}

latest_cycle_has_usage_limit() {
  local latest
  latest="$(latest_cycle_log || true)"
  [[ -n "$latest" ]] || return 1
  rg -q "usage limit|try again at" "$latest"
}

wait_for_manager_session_ready() {
  local timeout="$1"
  local start_ts now latest_session
  start_ts="$(date +%s)"
  while true; do
    latest_session="$(latest_cycle_session_id || true)"
    if [[ -n "$latest_session" ]]; then
      return 0
    fi
    if latest_cycle_has_usage_limit && [[ "$(whoami_auth_email)" == "$GOOD_ACCOUNT" ]]; then
      return 2
    fi
    now="$(date +%s)"
    if (( now - start_ts >= timeout )); then
      return 1
    fi
    sleep 2
  done
}

wait_for_good_account() {
  local timeout="$1"
  local start_ts now
  start_ts="$(date +%s)"
  while true; do
    if [[ "$(normalize_account "$(whoami_auth_email)")" == "$(normalize_account "$GOOD_ACCOUNT")" ]]; then
      return 0
    fi
    now="$(date +%s)"
    if (( now - start_ts >= timeout )); then
      return 1
    fi
    sleep 2
  done
}

wait_for_manager_status() {
  local previous_launch_count="$1" timeout="$2"
  local start_ts now supervisor_pid launch_count
  start_ts="$(date +%s)"
  while true; do
    supervisor_pid="$(status_field supervisor_pid)"
    launch_count="$(loop_launch_count)"
    if [[ "$(normalize_account "$(whoami_auth_email)")" == "$(normalize_account "$GOOD_ACCOUNT")" ]] &&
      [[ -n "$supervisor_pid" && "$supervisor_pid" != "none" ]] &&
      kill -0 "$supervisor_pid" 2>/dev/null &&
      [[ "$launch_count" =~ ^[0-9]+$ ]] &&
      (( launch_count > previous_launch_count )); then
      return 0
    fi
    if latest_cycle_has_usage_limit && [[ "$(whoami_auth_email)" == "$GOOD_ACCOUNT" ]]; then
      return 2
    fi
    now="$(date +%s)"
    if (( now - start_ts >= timeout )); then
      return 1
    fi
    sleep 2
  done
}

manager_ai_pid() {
  status_field ai_pid
}

trigger_current_manager_ai_exit() {
  local ai_pid
  ai_pid="$(manager_ai_pid)"
  if [[ -n "$ai_pid" && "$ai_pid" != "none" ]]; then
    kill "$ai_pid" 2>/dev/null || true
  fi
}

wait_for_relaunched_manager_launch() {
  local previous_launch_count="$1" timeout="$2"
  local start_ts now launch_count
  start_ts="$(date +%s)"
  while true; do
    launch_count="$(loop_launch_count)"
    if [[ "$launch_count" =~ ^[0-9]+$ ]] && (( launch_count > previous_launch_count )); then
      printf '%s\n' "$launch_count"
      return 0
    fi
    if latest_cycle_has_usage_limit && [[ "$(whoami_auth_email)" == "$GOOD_ACCOUNT" ]]; then
      return 2
    fi
    now="$(date +%s)"
    if (( now - start_ts >= timeout )); then
      return 1
    fi
    sleep 2
  done
}

dump_failure_context() {
  echo "[DEBUG] whoami_auth_email=$(whoami_auth_email)" >&2
  echo "[DEBUG] freely baseline-status:" >&2
  bash "$ROOT_DIR/bin/freely" baseline-status --project "$MANAGER_PROJECT" >&2 || true
  echo "[DEBUG] trace:" >&2
  cat "$TRACE_FILE" >&2 2>/dev/null || true
  echo "[DEBUG] recent loop log:" >&2
  tail -n 80 "$MANAGER_PROJECT/.freely/logs/loop.log" >&2 2>/dev/null || true
}

cleanup() {
  stop_manager
  switch_account "$GOOD_ACCOUNT" || true
}
trap cleanup EXIT

[[ -d "$MANAGER_PROJECT" ]] || { echo "manager project not found: $MANAGER_PROJECT" >&2; exit 1; }
if [[ -z "$GOOD_ACCOUNT" ]]; then
  GOOD_ACCOUNT="$(discover_good_account || true)"
fi

[[ -n "$GOOD_ACCOUNT" ]] || { echo "could not discover a usable good account" >&2; exit 1; }
[[ "${#BAD_ACCOUNTS[@]}" -gt 0 ]] || { echo "need at least one --bad-account" >&2; exit 1; }

stop_manager
wait_for_manager_stopped "$TIMEOUT_SECONDS" || true
trace_event "manager_stopped"

echo "[INFO] forcing good account baseline: $GOOD_ACCOUNT"
switch_account "$GOOD_ACCOUNT"
trace_event "forced_good_account"

baseline_log="$LOG_ROOT/manager-baseline.log"
baseline_pid="$(start_manager "$baseline_log")"
trace_event "manager_watchdog_requested"
if ! wait_for_manager_supervisor "$TIMEOUT_SECONDS"; then
  echo "[FAIL] manager supervisor did not start before bad-account switching" >&2
  dump_failure_context
  exit 1
fi
trace_event "manager_supervisor_up"
if ! wait_for_manager_session_ready "$TIMEOUT_SECONDS"; then
  rc=$?
  if [[ "$rc" -eq 2 ]]; then
    echo "[FAIL] configured good account $GOOD_ACCOUNT cannot currently launch the manager chain (usage limit hit during baseline)" >&2
  else
    echo "[FAIL] manager did not launch an initial codex session before bad-account switching" >&2
  fi
  dump_failure_context
  exit 1
fi
trace_event "manager_ai_ready"

for bad in "${BAD_ACCOUNTS[@]}"; do
current_after_bad_switch=""
  [[ "$bad" == "$GOOD_ACCOUNT" ]] && continue
  previous_launch_count="$(loop_launch_count)"
  echo "[INFO] testing recovery from bad account: $bad"
  trace_event "before_switch_to_${bad//@/_}"
  switch_account "$bad"
  trace_event "after_switch_to_${bad//@/_}"

  current_after_bad_switch="$(whoami_auth_email)"
  if [[ "$(normalize_account "$current_after_bad_switch")" == "$(normalize_account "$bad")" ]]; then
    :
  elif [[ "$(normalize_account "$current_after_bad_switch")" == "$(normalize_account "$GOOD_ACCOUNT")" ]]; then
    trace_event "immediate_recovery_after_switch_to_${bad//@/_}"
  else
    echo "[FAIL] expected current account to be either $bad or immediate recovery to $GOOD_ACCOUNT, got $current_after_bad_switch" >&2
    dump_failure_context
    exit 1
  fi

  trigger_current_manager_ai_exit
  trace_event "manager_ai_exit_triggered_from_${bad//@/_}"

  trace_event "watchdog_waiting_for_recovery_from_${bad//@/_}"

  if ! wait_for_good_account "$TIMEOUT_SECONDS"; then
    echo "[FAIL] did not auto-switch back to $GOOD_ACCOUNT after switching to $bad with manager already running" >&2
    dump_failure_context
    exit 1
  fi
  trace_event "good_account_restored_from_${bad//@/_}"

  if ! wait_for_relaunched_manager_launch "${previous_launch_count:-0}" "$TIMEOUT_SECONDS" >/dev/null; then
    rc=$?
    if [[ "$rc" -eq 2 ]]; then
      echo "[FAIL] switched back to $GOOD_ACCOUNT, but the relaunched codex session still hit usage limit before supervision could recover" >&2
    else
      echo "[FAIL] manager did not launch a new codex session after switching back to $GOOD_ACCOUNT" >&2
    fi
    dump_failure_context
    exit 1
  fi
  trace_event "relaunch_ai_ready_from_${bad//@/_}"

  if ! wait_for_manager_status "${previous_launch_count:-0}" "$TIMEOUT_SECONDS"; then
    rc=$?
    if [[ "$rc" -eq 2 ]]; then
      echo "[FAIL] manager resumed under $GOOD_ACCOUNT but the new codex session immediately hit usage limit" >&2
    else
      echo "[FAIL] manager chain did not become healthy after switching back to $GOOD_ACCOUNT" >&2
    fi
    dump_failure_context
    exit 1
  fi
  trace_event "manager_healthy_from_${bad//@/_}"

  echo "[PASS] recovered from $bad back to $GOOD_ACCOUNT"
done

stop_manager
wait_for_pid_gone "$baseline_pid" 15 || true
echo "[PASS] live global account recovery succeeded for all configured bad accounts"
