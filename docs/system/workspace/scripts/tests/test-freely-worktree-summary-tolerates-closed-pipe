#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-worktree-summary-pipe.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
WORKTREE_DIR="$TMP_DIR/feature-wt"

git init -q -b develop "$PROJECT"
git -C "$PROJECT" config user.name "Freely Test"
git -C "$PROJECT" config user.email "freely@example.com"

mkdir -p "$PROJECT/docs"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
git -C "$PROJECT" add .
git -C "$PROJECT" commit -q -m "init"

git -C "$PROJECT" worktree add -q -b feature/test "$WORKTREE_DIR" develop
echo "dirty" >"$WORKTREE_DIR/dirty.txt"

set +e
bash -lc '
  set -euo pipefail
  source "'"$ROOT_DIR"'/docs/system/workspace/scripts/runtime/freely"
  worktree_summary_for_project "'"$PROJECT"'" | true
  echo survived
' >"$TMP_DIR/stdout" 2>"$TMP_DIR/stderr"
status=$?
set -e

output="$(cat "$TMP_DIR/stdout")"
stderr_output="$(cat "$TMP_DIR/stderr")"

[[ "$status" -eq 0 ]] || {
  echo "[FAIL] expected closed-pipe consumer to exit 0, got status=$status" >&2
  [[ -z "$stderr_output" ]] || echo "$stderr_output" >&2
  exit 1
}

[[ "$output" == "survived" ]] || {
  echo "[FAIL] expected closed-pipe consumer to survive, got: $output" >&2
  exit 1
}

echo "[PASS] worktree summary tolerates closed stdout pipe"
