#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-network-proxy-resolver.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
mkdir -p "$PROJECT/.freely"

cat >"$PROJECT/.freely/config.env" <<'EOF'
FREELY_NETWORK_PROXY_MODE="explicit"
FREELY_NETWORK_PROXY_URL="http://proxy.example:9000"
FREELY_NO_PROXY="localhost,127.0.0.1"
EOF

RESULT="$(
  bash -lc '
    set -euo pipefail
    source "'"$ROOT_DIR"'/docs/system/workspace/scripts/runtime/network-proxy-resolver.sh"
    freely_apply_project_network_proxy_env "'"$PROJECT"'"
    printf "%s|%s|%s|%s\n" "${ALL_PROXY:-}" "${HTTP_PROXY:-}" "${HTTPS_PROXY:-}" "${NO_PROXY:-}"
  '
)"

[[ "$RESULT" == "http://proxy.example:9000|http://proxy.example:9000|http://proxy.example:9000|localhost,127.0.0.1" ]]

cat >"$PROJECT/.freely/config.env" <<'EOF'
FREELY_NETWORK_PROXY_MODE="disabled"
FREELY_NETWORK_PROXY_URL="http://proxy.example:9000"
EOF

RESULT_DISABLED="$(
  bash -lc '
    set -euo pipefail
    export ALL_PROXY="http://should-clear:9999"
    export HTTP_PROXY="http://should-clear:9999"
    export HTTPS_PROXY="http://should-clear:9999"
    export NO_PROXY="should-clear"
    source "'"$ROOT_DIR"'/docs/system/workspace/scripts/runtime/network-proxy-resolver.sh"
    freely_apply_project_network_proxy_env "'"$PROJECT"'"
    printf "%s|%s|%s|%s\n" "${ALL_PROXY:-}" "${HTTP_PROXY:-}" "${HTTPS_PROXY:-}" "${NO_PROXY:-}"
  '
)"

[[ "$RESULT_DISABLED" == "|||" ]]

FREELY_HOME="$TMP_DIR/freely-home"
mkdir -p "$FREELY_HOME"
cat >"$FREELY_HOME/config.env" <<'EOF'
FREELY_NETWORK_PROXY_MODE="explicit"
FREELY_HTTP_PROXY="http://global-http.example:8080"
FREELY_HTTPS_PROXY="http://global-https.example:8443"
FREELY_NO_PROXY="localhost"
EOF

cat >"$PROJECT/.freely/config.env" <<'EOF'
FREELY_NETWORK_PROXY_MODE="inherit"
FREELY_NETWORK_PROXY_URL=""
FREELY_ALL_PROXY=""
FREELY_HTTP_PROXY=""
FREELY_HTTPS_PROXY=""
FREELY_NO_PROXY=""
EOF

RESULT_GLOBAL="$(
  FREELY_HOME="$FREELY_HOME" bash -lc '
    set -euo pipefail
    source "'"$ROOT_DIR"'/docs/system/workspace/scripts/runtime/network-proxy-resolver.sh"
    freely_apply_project_network_proxy_env "'"$PROJECT"'"
    printf "%s|%s|%s|%s\n" "${ALL_PROXY:-}" "${HTTP_PROXY:-}" "${HTTPS_PROXY:-}" "${NO_PROXY:-}"
  '
)"

[[ "$RESULT_GLOBAL" == "http://global-https.example:8443|http://global-http.example:8080|http://global-https.example:8443|localhost" ]]

echo "[PASS] network proxy resolver handles explicit base-url, disabled mode, and global fallback"
