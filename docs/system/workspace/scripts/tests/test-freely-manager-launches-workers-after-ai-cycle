#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-post-cycle-launch.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
WORKER_WT="$TMP_DIR/worker-wt"
mkdir -p "$PROJECT/docs/B1-docs/raw-20260322-0000"

git init -q -b develop "$PROJECT"
git -C "$PROJECT" config user.name "Freely Test"
git -C "$PROJECT" config user.email "freely@example.com"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
- 20260322-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260322-0000/brainstorms.md" <<'EOF'
# Brainstorms
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260322-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

git -C "$PROJECT" add .
git -C "$PROJECT" commit -q -m "init"
git -C "$PROJECT" worktree add -q -b feature/test-worker "$WORKER_WT" develop

mkdir -p "$PROJECT/.freely/run/worker-prompts" "$PROJECT/.freely/logs" "$WORKER_WT/.freely/run" "$WORKER_WT/.freely/logs"
cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF
cat >"$WORKER_WT/.freely/config.env" <<EOF
PROJECT_ROOT="$WORKER_WT"
INTENT_FILE="$WORKER_WT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$WORKER_WT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

PROMPT_FILE="$PROJECT/.freely/run/worker-prompts/20260322-020303-worker-cli-retire-codex.txt"
cat >"$PROMPT_FILE" <<EOF
Worktree:
- \`$WORKER_WT\`
Branch:
- \`feature/test-worker\`
dispatch_priority: P0
parallel_safe: false
write_scope: \`$WORKER_WT\`
intent_kind: cleanup
intent_target: \`$WORKER_WT\`
Owner-Issue:
- \`I-20260322-0203-A\`
Pre-Tests-Path:
- \`docs/B2-docs/sample/story/pre-tests.md\`
Verification-Artifact-Dir:
- \`docs/B2-docs/sample/story/code-reviews\`
Required-Test-Lanes:
- \`post-merge-followthrough\`
Required-Acceptance-Item-Ids:
- \`cleanup-followthrough\`
Minimum-Evidence-Level:
- \`artifact-plus-human-observation\`
Target-Environment:
- \`feature/test-worker\`
Closeout-Gate:
- \`owner-issue verification closeout\`
Closeout-Gate-Command:
- \`owner-issue verification closeout\`
Closeout-Target-Lane:
- \`post-merge-followthrough\`
Closeout-Promotion-Gate:
- \`completion\`
Closeout-Requires-Adequacy:
- \`false\`
Closeout-Review-Artifact-Policy:
- \`none\`
EOF

CONT_FILE="$PROJECT/.freely/run/manager-continuity-20260322-020303.md"
cat >"$CONT_FILE" <<EOF
# Manager Continuity

## Queue State

worker_prompts:
- $PROMPT_FILE
EOF

cat >"$PROJECT/.freely/run/manager-worker-launch-state.env" <<EOF
LAST_MANAGER_CONTINUITY_GENERATED="$CONT_FILE"
LAST_MANAGER_WORKER_PROMPTS_GENERATED="$PROMPT_FILE"
LAST_MANAGER_CONTINUITY_CONSUMED="$CONT_FILE"
LAST_MANAGER_WORKER_PROMPTS_CONSUMED=""
LAUNCHED_WORKER_PROMPTS=""
UPDATED_AT="2026-03-22T02:03:03Z"
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

START_LOG="$TMP_DIR/started.log"
role_hint_for_project() {
  local project="$1"
  if [[ "$project" == "$PROJECT" ]]; then
    printf 'manager\n'
  else
    printf 'worker\n'
  fi
}
manager_supervisor_pid_for_project() {
  return 0
}
runtime_ai_pid_hint_for_project() {
  return 0
}
start_workcell_supervisor_async() {
  echo "$1" >>"$START_LOG"
}

LAUNCHED="$(manager_runtime_launch_workers_after_ai_cycle_if_needed "$PROJECT" "ai_exit_rc_0")"
[[ "$LAUNCHED" == "1" ]] || {
  echo "[FAIL] expected post-cycle launch to start one worker, got $LAUNCHED" >&2
  exit 1
}

grep -q "$WORKER_WT" "$START_LOG"
grep -q 'event=manager_worker_launch_after_ai_cycle launched_count=1 exit_reason=ai_exit_rc_0' "$PROJECT/.freely/logs/runtime-events.log"
grep -q '^DESIRED_RUNTIME_STATE="running"$' "$WORKER_WT/.freely/run/workcell-state.env"
grep -q "^LAST_MANAGER_CONTINUITY_CONSUMED=\"$CONT_FILE\"$" "$PROJECT/.freely/run/manager-worker-launch-state.env"
grep -q "^LAST_MANAGER_WORKER_PROMPTS_CONSUMED=\"$PROMPT_FILE\"$" "$PROJECT/.freely/run/manager-worker-launch-state.env"

echo "[PASS] manager supervisor launches worker prompts after a successful ai cycle"
