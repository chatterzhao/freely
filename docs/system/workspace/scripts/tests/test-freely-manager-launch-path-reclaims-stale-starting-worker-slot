#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"

OUTPUT="$(
  bash -lc '
    set -euo pipefail
    source "'"$ROOT_DIR"'/docs/system/workspace/scripts/runtime/freely"

    root="$(mktemp -d /tmp/freely-launch-reclaim.XXXXXX)"
    trap "rm -rf \"$root\"" EXIT
    project="$root/manager"
    worker="$root/test-pre-merge-worker"
    mkdir -p "$project/.freely/run" "$worker/.freely/run" "$worker/.freely/logs"

    prompt_file_path="$project/.freely/run/worker-prompt.txt"
    continuity_file_path="$project/.freely/run/manager-continuity.md"
    {
      printf "Worktree:\n"
      printf -- "- \`%s\`\n\n" "$worker"
      printf "Branch:\n"
      printf -- "- \`test-pre-merge-demo\`\n"
    } >"$prompt_file_path"
    {
      printf "# Manager Continuity\n"
      printf -- "- authoritative_worker_prompts:\n"
      printf -- "  - \`%s\`\n" "$prompt_file_path"
    } >"$continuity_file_path"

    cat >"$project/.freely/run/manager-worker-launch-state.env" <<EOF
LAST_MANAGER_CONTINUITY_GENERATED="$continuity_file_path"
LAST_MANAGER_WORKER_PROMPTS_GENERATED="$prompt_file_path"
LAST_MANAGER_CONTINUITY_CONSUMED="$continuity_file_path"
LAST_MANAGER_WORKER_PROMPTS_CONSUMED="$prompt_file_path"
LAUNCHED_WORKER_PROMPTS="$prompt_file_path"
QUEUED_WORKER_PROMPTS=""
QUEUED_WORKER_PROMPT_BLOCKERS=""
MAX_PARALLEL_WORKERS="unbounded"
ACTIVE_RUNNING_WORKER_COUNT="1"
AVAILABLE_NEW_WORKER_SLOTS="unbounded"
UPDATED_AT="2026-04-25T00:00:00Z"
EOF

    cat >"$worker/.freely/run/workcell-state.env" <<EOF
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="up"
LAST_AI_STATE="down"
LAST_EXIT_REASON="starting"
LAST_STATE_UPDATED_AT="2026-04-24T00:00:00Z"
EOF

    cat >"$worker/.freely/run/worker-verification-contract.env" <<EOF
SOURCE_PROMPT_FILE="$prompt_file_path"
SOURCE_INTAKE_ID="intake-1"
TARGET_PROJECT="$worker"
VERIFICATION_METADATA_PRESENT="true"
VERIFICATION_METADATA_MISSING_FIELDS=""
OWNER_ISSUE="docs/B2-docs/sample/issues/sample.md"
PRE_TESTS_PATH="docs/B2-docs/sample/pre-tests.md"
VERIFICATION_ARTIFACT_DIR="docs/B2-docs/sample/artifacts"
REQUIRED_TEST_LANES_CSV="feature-local"
REQUIRED_ACCEPTANCE_ITEM_IDS_CSV="sample-acceptance"
MINIMUM_EVIDENCE_LEVEL="sample"
TARGET_ENVIRONMENT="sample"
CLOSEOUT_GATE="sample"
CLOSEOUT_GATE_COMMAND="./bin/freely daemon start --project $project"
CLOSEOUT_TARGET_LANE="develop"
CLOSEOUT_PROMOTION_GATE="sample"
CLOSEOUT_REQUIRES_ADEQUACY="true"
CLOSEOUT_REVIEW_ARTIFACT_POLICY="sample"
UPDATED_AT="2026-04-25T00:00:00Z"
EOF

    run_dir_for_project() { printf "%s\n" "$1/.freely/run"; }
    workcell_state_file() { printf "%s\n" "$1/.freely/run/workcell-state.env"; }
    worker_verification_contract_state_file() { printf "%s\n" "$1/.freely/run/worker-verification-contract.env"; }
    current_timestamp_utc_for_machine() { printf "2026-04-25T00:00:00Z\n"; }
    latest_manager_worker_prompt_csv_from_continuity() { printf "%s\n" "$prompt_file_path"; }
    latest_manager_worker_prompt_paths_from_continuity() { printf "%s\n" "$prompt_file_path"; }
    latest_patrol_authoritative_manager_continuity_file_for_project() { printf "%s\n" "$continuity_file_path"; }
    worker_prompt_launchable_for_manager_project() { return 0; }
    worker_prompt_resolved_worktree() { printf "%s\n" "$worker"; }
    worker_prompt_matches_active_authoritative_worker() { return 1; }
    manager_supervisor_pid_for_project() {
      [[ "$1" == "$worker" ]] && printf "43434\n"
    }
    runtime_ai_pid_hint_for_project() { return 0; }
    role_hint_for_project() { printf "manager\n"; }
    project_bootstrap_launch_in_flight() { return 1; }
    count_active_running_workers_for_manager_project() { printf "0\n"; }
    manager_max_parallel_workers() { printf "unbounded\n"; }
    terminate_pid_with_graceful_wait() { printf "terminate:%s|%s\n" "$1" "$2"; }
    clear_supervisor_identity_truth() { printf "clear:%s|%s\n" "$1" "$2"; }
    interruption_dispatcher_pid_for_project() { return 0; }
    manager_watchdog_pid_for_project() { return 0; }

    if manager_continuity_has_unconsumed_launchable_worker_prompt "$project" "$continuity_file_path"; then
      printf "launchable:true\n"
    else
      printf "launchable:false\n"
    fi

    awk -F= "/^LAST_MANAGER_WORKER_PROMPTS_CONSUMED=/{print \"consumed:\" \$2}" "$project/.freely/run/manager-worker-launch-state.env"
    awk -F= "/^ACTIVE_RUNNING_WORKER_COUNT=/{print \"active:\" \$2}" "$project/.freely/run/manager-worker-launch-state.env"
  ' 2>&1
)"

[[ "$OUTPUT" == *"terminate:43434|delegated worker starting-stuck supervisor reclaim"* ]]
[[ "$OUTPUT" == *"launchable:true"* ]]
[[ "$OUTPUT" == *'consumed:"none"'* ]]
[[ "$OUTPUT" == *'active:"0"'* ]]
[[ "$OUTPUT" != *"unbound variable"* ]]

echo "[PASS] manager dispatch path reclaims stale starting worker slot before suppressing relaunch"
