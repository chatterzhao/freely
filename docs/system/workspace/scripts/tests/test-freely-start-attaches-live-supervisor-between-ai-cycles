#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-start-live-supervisor.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
mkdir -p \
  "$PROJECT/docs/B1-docs/raw-20260413-0000" \
  "$PROJECT/.freely/run" \
  "$PROJECT/.freely/logs"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF

cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF

cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF

cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF

cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF

cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
- 20260413-0000--sample
EOF

cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF

cat >"$PROJECT/docs/B1-docs/raw-20260413-0000/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF

cat >"$PROJECT/docs/B1-docs/raw-20260413-0000/candidates.md" <<'EOF'
# Candidates
- candidate_format_version: `v2`
- status: `promoted`
- milestone: `M-20260306-workspace-routing-foundation`
- promoted_issue_path: `docs/B2-docs/sample/issues/sample.md`
- session_refs: []
EOF

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="test-sleep"
AI_MODEL=""
AI_MODE="auto"
AI_REASONING_EFFORT=""
CHECK_INTERVAL=1
RESTART_DELAY=1
MAX_RESTARTS=0
IFLOW_MAX_TURNS=100
EOF

bash "$ROOT_DIR/bin/freely" daemon start --project "$PROJECT" >/dev/null

SUPERVISOR_PID=""
for _ in $(seq 1 50); do
  if [[ -f "$PROJECT/.freely/run/supervisor.pid" ]]; then
    SUPERVISOR_PID="$(cat "$PROJECT/.freely/run/supervisor.pid" 2>/dev/null || true)"
  fi
  if [[ -n "$SUPERVISOR_PID" ]] && kill -0 "$SUPERVISOR_PID" 2>/dev/null; then
    break
  fi
  sleep 0.2
done
[[ -n "$SUPERVISOR_PID" ]] || {
  echo "[FAIL] daemon start did not materialize a live supervisor" >&2
  exit 1
}

for _ in $(seq 1 80); do
  if [[ -f "$PROJECT/.freely/logs/runtime-events.log" ]] && grep -q 'event=ai_cycle_finished' "$PROJECT/.freely/logs/runtime-events.log" && [[ ! -f "$PROJECT/.freely/run/ai.pid" ]]; then
    break
  fi
  sleep 0.2
done

if [[ -f "$PROJECT/.freely/run/ai.pid" ]]; then
  echo "[FAIL] test fixture did not reach a between-cycles state with missing ai.pid" >&2
  cat "$PROJECT/.freely/logs/runtime-events.log" >&2 || true
  exit 1
fi

START_OUTPUT="$(bash "$ROOT_DIR/bin/freely" start --project "$PROJECT" 2>&1)"
printf '%s\n' "$START_OUTPUT" | grep -q 'reusing supervisor pid='

SUPERVISOR_PID_AFTER="$(cat "$PROJECT/.freely/run/supervisor.pid" 2>/dev/null || true)"
[[ "$SUPERVISOR_PID_AFTER" == "$SUPERVISOR_PID" ]] || {
  echo "[FAIL] foreground start should attach to the live supervisor between ai cycles" >&2
  echo "before=$SUPERVISOR_PID after=$SUPERVISOR_PID_AFTER" >&2
  cat "$PROJECT/.freely/logs/runtime-events.log" >&2 || true
  exit 1
}

grep -q 'LAST_EXIT_REASON="already_running_attach"' "$PROJECT/.freely/run/workcell-state.env"
grep -q "event=supervisor_attach_reuse supervisor_pid=$SUPERVISOR_PID .*ai_pid_state=missing" "$PROJECT/.freely/logs/runtime-events.log"

bash "$ROOT_DIR/bin/freely" daemon stop --project "$PROJECT" >/dev/null

echo "[PASS] freely start attaches to a live supervisor between ai cycles instead of repairing it"
