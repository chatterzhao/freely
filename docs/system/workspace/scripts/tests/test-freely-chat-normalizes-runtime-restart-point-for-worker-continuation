#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-chat-normalizes-runtime-restart-point.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
FREELY_HOME="$TMP_DIR/freely-home"
HANDLER_FIXTURE="$TMP_DIR/interruption-handler-fixture"
mkdir -p "$PROJECT/docs/B1-docs/raw-20260320-0000"

git init -q -b feature/test-chat-normalizes-runtime-restart-point "$PROJECT"
git -C "$PROJECT" config user.name "Freely Test"
git -C "$PROJECT" config user.email "freely@example.com"
mkdir -p "$PROJECT/.githooks"
cat >"$PROJECT/.githooks/pre-commit" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
chmod +x "$PROJECT/.githooks/pre-commit"

cat >"$PROJECT/.gitignore" <<'EOF'
.freely/
EOF
cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260320-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260320-0000/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260320-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

git -C "$PROJECT" add .
git -C "$PROJECT" commit -q -m "init"

cat >"$HANDLER_FIXTURE" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
cat <<'OUT'
DECISION=delegate
REACTION=followup
CLASSIFICATION=continuation
RESTART_POINT=runtime
OWNERSHIP=worker
WHY=当前工位应继续当前 issue
HANDOFF=让当前 worker 主循环继续接棒
ANSWER=
OUT
EOF
chmod +x "$HANDLER_FIXTURE"

cd "$PROJECT"
FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" init --intent "$PROJECT/docs/PROJECT_INTENT.md" --constitution "$PROJECT/docs/CONSTITUTION.md" --ai codex:gpt-5.4:auto --accept-default-autonomy >/dev/null

python3 - <<'PY'
from pathlib import Path
cfg = Path(".freely/config.env")
text = cfg.read_text()
text = text.replace('AGENT_AI_TOOL="codex"', 'AGENT_AI_TOOL="test-sleep"', 1)
cfg.write_text(text)
PY

cat >"$PROJECT/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="stopped"
LAST_SUPERVISOR_STATE="down"
LAST_AI_STATE="down"
LAST_EXIT_REASON="operator_stop"
LAST_ROLE_HINT="worker"
LAST_STATE_UPDATED_AT="2026-03-21T00:00:00Z"
EOF

wait_for_grep() {
  local pattern="$1" file="$2" tries="${3:-40}"
  local i
  for i in $(seq 1 "$tries"); do
    if [[ -f "$file" ]] && grep -q -- "$pattern" "$file"; then
      return 0
    fi
    sleep 0.2
  done
  return 1
}

wait_for_ai() {
  local pid tries=0
  while (( tries < 40 )); do
    if [[ -f "$PROJECT/.freely/run/ai.pid" ]]; then
      pid="$(cat "$PROJECT/.freely/run/ai.pid" 2>/dev/null || true)"
      if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        return 0
      fi
    fi
    sleep 0.2
    tries=$((tries + 1))
  done
  return 1
}

CHAT_OUTPUT="$(FREELY_HOME="$FREELY_HOME" FREELY_INTERRUPTION_HANDLER_BIN="$HANDLER_FIXTURE" bash "$ROOT_DIR/bin/freely" chat --project "$PROJECT" '继续当前 issue')"
INTAKE_ID="$(printf '%s\n' "$CHAT_OUTPUT" | sed -n 's/^intake_id: //p')"
[[ -n "$INTAKE_ID" ]] || {
  echo "[FAIL] missing intake id" >&2
  exit 1
}

wait_for_grep '^STATUS="delegated"$' "$PROJECT/.freely/intake/$INTAKE_ID/meta.env" || {
  echo "[FAIL] intake was not delegated" >&2
  exit 1
}
wait_for_grep '^ABSORPTION_TARGET="handoff://continuation"$' "$PROJECT/.freely/intake/$INTAKE_ID/meta.env" || {
  echo "[FAIL] worker continuation should normalize away from runtime handoff" >&2
  exit 1
}
wait_for_grep 'restart_point: `continuation`' "$PROJECT/.freely/run/interruption-resolution/$INTAKE_ID/resolution.md" || {
  echo "[FAIL] resolution should record normalized continuation restart point" >&2
  exit 1
}

wait_for_ai || {
  echo "[FAIL] normalized worker continuation should reactivate runtime" >&2
  exit 1
}

FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" stop --project "$PROJECT" >/dev/null || true

echo "[PASS] freely normalizes worker continuation signals away from runtime handoff parking"
