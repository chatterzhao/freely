#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-ensure-manager-no-account-ready.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
mkdir -p "$PROJECT/docs/B1-docs/raw-20260318-0000" "$PROJECT/.freely/run" "$PROJECT/.freely/logs"

git init -q -b develop "$PROJECT"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260318-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260318-0000/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260318-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
AUTO_SWITCH_TOOL="true"
AUTO_SWITCH_SLOT="true"
EOF

cat >"$PROJECT/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
SUPERVISOR_STATE="down"
AI_STATE="down"
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"
load_config "$PROJECT"

launch_log="$TMP_DIR/launch.log"
readiness_log="$TMP_DIR/readiness.log"

valid_supervisor_pid_for_project() { return 1; }
discover_supervisor_pid() { return 0; }
manager_ai_pid_for_project() { return 0; }
recover_stalled_manager_ai_if_needed() { return 1; }
codex_current_cooldown_identity() { return 0; }
ensure_codex_slot_ready_for_manager() {
  printf '%s\n' "$1" >>"$readiness_log"
  return 1
}
manager_runtime_recover_workers_if_needed() { return 0; }
launch_manager_supervisor() {
  printf '%s\n' "$1" >>"$launch_log"
}
log_info() { :; }
log_warn() { :; }
log_error() { :; }

if ! ensure_manager_once "$PROJECT" >/dev/null; then
  echo "[FAIL] ensure-manager should skip launch rather than fail when no codex slot is ready" >&2
  exit 1
fi

grep -q "^$PROJECT$" "$readiness_log"
if [[ -s "$launch_log" ]]; then
  echo "[FAIL] ensure-manager should not launch when no codex slot is ready" >&2
  cat "$launch_log" >&2
  exit 1
fi
if [[ -f "$PROJECT/.freely/logs/runtime-events.log" ]]; then
  echo "[FAIL] no-account-ready guard should stay blocked without emitting a switch event" >&2
  cat "$PROJECT/.freely/logs/runtime-events.log" >&2
  exit 1
fi

echo "[PASS] ensure-manager skips manager launch when no codex slot is ready"
