#!/usr/bin/env bash
# TC-8: live worker not mis-marked by scan
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
HANDOFF_PY="$ROOT_DIR/docs/system/workspace/scripts/runtime/handoff.py"

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
db="$tmpdir/test.db"

python3 "$HANDOFF_PY" init --db "$db"

# Insert a launched worker with the test script's own PID (alive)
live_pid="$$"
python3 -c "
import sqlite3
from datetime import datetime, timezone
conn = sqlite3.connect('$db')
now = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')

conn.execute('INSERT INTO handoffs (handoff_id, role, raw_key, prompt_file, status, worker_pid, created_at, updated_at) VALUES (?,?,?,?,?,?,?,?)',
  ('LIVE', 'worker', 'test-raw', '/tmp/live', 'launched', '$live_pid', now, now))
conn.commit()
conn.close()
"

# Run scanning logic
python3 -c "
import sqlite3, os
from datetime import datetime, timezone
conn = sqlite3.connect('$db')
rows = conn.execute(
  \"SELECT handoff_id, worker_pid FROM handoffs \"
  \"WHERE role='worker' AND status='launched' AND worker_pid != '' AND worker_pid IS NOT NULL \"
).fetchall()
marked = []
for hid, pid_str in rows:
  if not pid_str or not pid_str.strip().isdigit():
    continue
  pid = int(pid_str.strip())
  try:
    os.kill(pid, 0)
  except OSError:
    marked.append(hid)

# No records should be marked since the test PID is alive
print(f'Marked {len(marked)} records (expected 0)')
assert len(marked) == 0, f'Expected 0 marked, got {len(marked)}'

# Verify the record is still launched
row = conn.execute('SELECT status, exit_kind FROM handoffs WHERE handoff_id=?', ('LIVE',)).fetchone()
print(f'LIVE: status={row[0]} exit_kind=[{row[1]}]')
assert row[0] == 'launched', f'Expected launched, got {row[0]}'
assert row[1] == '', f'Expected empty exit_kind, got [{row[1]}]'
conn.close()
"

echo "[PASS] live worker not mis-marked by scan"
