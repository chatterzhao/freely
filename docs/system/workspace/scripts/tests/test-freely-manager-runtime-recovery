#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-runtime-recovery.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/freely"
WT_ROOT="$TMP_DIR/freely-worktrees"
WORKER="$WT_ROOT/feature-worker"

mkdir -p "$PROJECT/docs/B1-docs/raw-20260309-0000" "$PROJECT/.freely/run" "$PROJECT/.freely/logs" "$WT_ROOT"
cd "$PROJECT"
git init -q -b develop
git config user.name tester
git config user.email tester@example.com
echo base > README.md
git add README.md
git commit -q -m "init"
git branch feature/worker
git worktree add "$WORKER" feature/worker >/dev/null
WORKER="$(cd "$WORKER" && pwd -P)"

for wt in "$PROJECT" "$WORKER"; do
  mkdir -p "$wt/docs/B1-docs/raw-20260309-0000" "$wt/.freely/run" "$wt/.freely/logs"
  cat >"$wt/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
  cat >"$wt/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
  cat >"$wt/docs/LAWS.md" <<'EOF'
# Laws
EOF
  cat >"$wt/AGENTS.md" <<'EOF'
# Agents
EOF
  cat >"$wt/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF
  cat >"$wt/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260309-0000--sample
EOF
  cat >"$wt/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF
  cat >"$wt/docs/B1-docs/raw-20260309-0000/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF
  cat >"$wt/docs/B1-docs/raw-20260309-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF
done

echo worker >"$WORKER/worker-branch.txt"
git -C "$WORKER" add worker-branch.txt
git -C "$WORKER" commit -q -m "worker branch divergence"

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="test-once"
AI_MODEL=""
AI_MODE="auto"
AI_REASONING_EFFORT=""
CHECK_INTERVAL=1
RESTART_DELAY=0
MAX_RESTARTS=1
IFLOW_MAX_TURNS=100
EOF

cat >"$WORKER/.freely/config.env" <<EOF
PROJECT_ROOT="$WORKER"
INTENT_FILE="$WORKER/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$WORKER/docs/CONSTITUTION.md"
AGENT_AI_TOOL="test-sleep"
AI_MODEL=""
AI_MODE="auto"
AI_REASONING_EFFORT=""
CHECK_INTERVAL=1
RESTART_DELAY=0
MAX_RESTARTS=1
IFLOW_MAX_TURNS=100
EOF

cat >"$WORKER/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="down"
LAST_AI_STATE="down"
LAST_EXIT_REASON="unexpected_supervisor_exit"
LAST_ROLE_HINT="worker"
LAST_STATE_UPDATED_AT="2026-03-18T00:00:00Z"
EOF

WORKER_PROMPT="$PROJECT/.freely/run/worker-prompts/recovery-worker.txt"
mkdir -p "$(dirname "$WORKER_PROMPT")"
cat >"$WORKER_PROMPT" <<EOF
Dispatch metadata:
- dispatch_priority: P0
- parallel_safe: true
- write_scope: $WORKER

Branch:
- \`feature/worker\`

Worktree:
- \`$WORKER\`
EOF

cat >"$WORKER/.freely/run/worker-verification-contract.env" <<EOF
SOURCE_PROMPT_FILE="$WORKER_PROMPT"
SOURCE_INTAKE_ID="recovery-intake"
TARGET_PROJECT="$WORKER"
VERIFICATION_METADATA_PRESENT="true"
VERIFICATION_METADATA_MISSING_FIELDS=""
OWNER_ISSUE="docs/B2-docs/sample/issues/sample.md"
PRE_TESTS_PATH="docs/B2-docs/sample/pre-tests.md"
VERIFICATION_ARTIFACT_DIR="docs/B2-docs/sample/artifacts"
REQUIRED_TEST_LANES_CSV="feature-local"
REQUIRED_ACCEPTANCE_ITEM_IDS_CSV="sample-acceptance"
MINIMUM_EVIDENCE_LEVEL="sample"
TARGET_ENVIRONMENT="sample"
CLOSEOUT_GATE="sample"
CLOSEOUT_GATE_COMMAND="./bin/freely daemon start --project $PROJECT"
CLOSEOUT_TARGET_LANE="develop"
CLOSEOUT_PROMOTION_GATE="sample"
CLOSEOUT_REQUIRES_ADEQUACY="true"
CLOSEOUT_REVIEW_ARTIFACT_POLICY="sample"
UPDATED_AT="2026-03-18T00:00:00Z"
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

START_LOG="$TMP_DIR/start.log"
manager_runtime_launch_workers_from_latest_handoff() {
  echo "0"
}
start_workcell_supervisor_async() {
  printf '%s\n' "$1" >>"$START_LOG"
  return 0
}

RECOVERED="$(manager_runtime_recover_workers_if_needed "$PROJECT" | tail -n 1)"
[[ "$RECOVERED" == "1" ]] || {
  echo "[FAIL] expected one recovered worker, got $RECOVERED" >&2
  exit 1
}
grep -q "^$WORKER$" "$START_LOG" || {
  echo "[FAIL] expected manager recovery to start the worker supervisor" >&2
  exit 1
}

echo "[PASS] manager runtime recovers expected-running worker with launchable verification contract"
