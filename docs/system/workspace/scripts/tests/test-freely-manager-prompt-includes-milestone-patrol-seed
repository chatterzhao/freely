EOF

PROMPT_OUTPUT="$(
  PROJECT_ROOT="$PROJECT" \
  INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md" \
  CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md" \
  AGENT_AI_TOOL="codex" \
  AI_MODEL="gpt-5.4" \
  AI_MODE="auto" \
  AI_REASONING_EFFORT="medium" \
  bash -lc '
    source "$1"
    build_prompt
  ' _ "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"
)"

printf '%s\n' "$PROMPT_OUTPUT" | grep -q 'Task-source patrol seed:'
printf '%s\n' "$PROMPT_OUTPUT" | grep -q '默认只把它们当作 patrol seed，不当作 completion 证明'
printf '%s\n' "$PROMPT_OUTPUT" | grep -q 'machine_readable_scan_json:'
SCAN_JSON="$PROJECT/.freely/run/manager-task-source-scan-latest.json"
test -f "$SCAN_JSON"
python3 - "$SCAN_JSON" <<'PY'
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as f:
    payload = json.load(f)

assert payload["schema_version"] == "manager-task-source-scan-v1"
assert payload["scan_reason"] == "bootstrap_missing_scan"
