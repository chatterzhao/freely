printf '%s\n' "$PROMPT_OUTPUT" | grep -q 'issue=I-20260420-1300-A phase_state=implementing runtime_state=paused'
if printf '%s\n' "$PROMPT_OUTPUT" | grep -q 'I-20260419-0900-A'; then
  echo "[FAIL] completed milestone items should not be surfaced as patrol seeds" >&2
  exit 1
fi

echo "[PASS] manager prompt includes unresolved patrol seeds for milestone/pre-brainstorm/progress and excludes completed queue items"
