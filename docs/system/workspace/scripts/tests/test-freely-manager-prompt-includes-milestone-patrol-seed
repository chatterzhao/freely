assert surfaces["active_progress_queue"]["active_count"] == 1
assert surfaces["delegated_continuation"]["needs_reconcile"] is True
assert surfaces["human_chat_intake"]["trust_level"] == "runtime_intake_authoritative_for_existence"
assert surfaces["active_pre_brainstorm_queue"]["trust_level"] == "advisory_candidate_reconcile_required"
assert surfaces["active_progress_queue"]["trust_level"] == "advisory_progress_reconcile_required"
