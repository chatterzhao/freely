#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TEST_TMP="$(mktemp -d /tmp/freely-wt-close-guard.XXXXXX)"
trap 'rm -rf "$TEST_TMP"' EXIT

REDIRECT_CWD="$TEST_TMP/repo"
mkdir -p "$REDIRECT_CWD"
cd "$REDIRECT_CWD"

failures=0

# Test 1: guard blocks on develop
echo "=== Test 1: guard blocks on develop ==="
_guard_branch="develop"
case "$_guard_branch" in
  main|develop|test-pre-merge-*)
    echo "[PASS] blocked on $_guard_branch"
    ;;
  *)
    echo "[FAIL] develop not blocked"
    failures=$((failures+1))
    ;;
esac

# Test 2: guard blocks on main
echo "=== Test 2: guard blocks on main ==="
_guard_branch="main"
case "$_guard_branch" in
  main|develop|test-pre-merge-*)
    echo "[PASS] blocked on $_guard_branch"
    ;;
  *)
    echo "[FAIL] main not blocked"
    failures=$((failures+1))
    ;;
esac

# Test 3: guard blocks on test-pre-merge-*
echo "=== Test 3: guard blocks on test-pre-merge-* ==="
for branch in "test-pre-merge-20260522-demo" "test-pre-merge-foo"; do
  _guard_branch="$branch"
  case "$_guard_branch" in
    main|develop|test-pre-merge-*)
      echo "[PASS] blocked on $branch"
      ;;
    *)
      echo "[FAIL] $branch not blocked"
      failures=$((failures+1))
      ;;
  esac
done

# Test 4: guard allows on fix/feature/hotfix branches
echo "=== Test 4: guard allows on fix/feature/hotfix ==="
for branch in "fix/raw-20260522-demo" "feature/raw-20260522-demo" "hotfix/critical-20260522"; do
  _guard_branch="$branch"
  case "$_guard_branch" in
    main|develop|test-pre-merge-*)
      echo "[FAIL] $branch blocked (should be allowed)"
      failures=$((failures+1))
      ;;
    *)
      echo "[PASS] allowed on $branch"
      ;;
  esac
done

# Test 5: guard message contains workflow guidance (syntax check on actual script)
# The assertion must match the text wt-close actually prints. It used to look for
# "wt-close refuses to modify files on protected branch", a string that does not
# exist in the script, so this test was permanently red on every machine.
echo "=== Test 5: guard message exists in actual script ==="
GUARD_FILE="$ROOT_DIR/docs/system/workspace/scripts/worktree/wt-close"
if grep -qE "is a protected branch, cannot close" "$GUARD_FILE"; then
  echo "[PASS] guard message found in wt-close"
else
  echo "[FAIL] guard message not found"
  failures=$((failures+1))
fi

# Test 6: guard references the REAL workflow skill and no ghost names.
# This used to assert the opposite (a ghost name had to be present), which froze
# the historical bug into the acceptance criteria. It also used `grep -q "a\|b"`,
# and BSD grep does not support \| in basic regex, so it never matched on macOS.
echo "=== Test 6: guard references the real skill, no ghosts ==="
if grep -qE "freely-fix-execution|freely-feature-execution|freely-feat-execution" "$GUARD_FILE"; then
  echo "[FAIL] ghost skill name still referenced in guard message"
  failures=$((failures+1))
else
  echo "[PASS] no ghost skill names in guard message"
fi
if grep -qE "skill:freely-workflow-guarded-execution" "$GUARD_FILE"; then
  echo "[PASS] real workflow skill referenced in guard message"
else
  echo "[FAIL] real workflow skill not referenced in guard message"
  failures=$((failures+1))
fi

if [[ "$failures" -eq 0 ]]; then
  echo ""
  echo "[PASS] test-wt-close-protected-branch-guard"
else
  echo ""
  echo "[FAIL] $failures test(s) failed"
  exit 1
fi
