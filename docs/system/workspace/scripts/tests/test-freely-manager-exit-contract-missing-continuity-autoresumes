cat >"$PROJECT/.freely/run/manager-continuity-20260425-150901.md" <<'EOF'
# Manager Continuity

## Primary Judgement

- route_kind: `completion_verification`
- restart_point: `consume worker terminal result from /tmp/fake-worker`
- ownership: `manager-owned completion followthrough`
- next_action: `review the promote-ready worker evidence and decide merge or cleanup`

## Worker Delegation

- none in this round
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

ACTION="$(manager_runtime_handle_exit_contract_after_ai_cycle "$PROJECT" "ai_exit_rc_0")"
[[ "$ACTION" == "resume_manager" ]] || {
  echo "[FAIL] expected continuity fallback to resume_manager, got $ACTION" >&2
  exit 1
}

CONTRACT="$PROJECT/.freely/run/manager-exit-contract.env"
grep -q '^EXIT_KIND="resume_manager"$' "$CONTRACT"
grep -q '^RESTART_POINT="consume worker terminal result from /tmp/fake-worker"$' "$CONTRACT"
grep -q '^NEXT_ACTION="review the promote-ready worker evidence and decide merge or cleanup"$' "$CONTRACT"
grep -q '^WHY_NOT_STOP="authoritative manager continuity remains open"$' "$CONTRACT"
grep -q '^WHY_NOT_DELEGATE="current continuity has no launchable worker prompts"$' "$CONTRACT"
grep -q 'manager_exit_contract_autofilled_continuity_resume' "$PROJECT/.freely/logs/runtime-events.log"
grep -q 'manager_exit_contract_resume_autofilled' "$PROJECT/.freely/logs/runtime-events.log"

echo "[PASS] missing manager exit contract auto-resumes from authoritative continuity"
