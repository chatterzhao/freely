#!/usr/bin/env bash
# AT-001 — raw-20261104T082556Z / #4183
# Promoting a candidate into a B2 I-* document must be able to create that issue
# on both platforms. The B1-only file assumption made it impossible.
set -uo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
ISSUE_SYNC="$ROOT_DIR/bin/issue-sync"
PASS=0; FAIL=0
ok(){ echo "  [ok] $1"; PASS=$((PASS+1)); }
bad(){ echo "  [FAIL] $1"; FAIL=$((FAIL+1)); }

RAW_KEY="20260101T000000Z"
RAW_ID="raw-$RAW_KEY"
I_ID="I-$RAW_KEY-A"
STORY="docs/B2-docs/gate/platform/raw-$RAW_KEY"

FIX=""
make_fixture() {
  FIX="$(mktemp -d /tmp/freely-promote.XXXXXX)"; FIX="$(cd "$FIX" && pwd -P)"
  mkdir -p "$FIX/bin" "$FIX/stub" \
           "$FIX/docs/system/workspace/scripts/runtime" \
           "$FIX/docs/system/workspace/scripts/sync" \
           "$FIX/docs/system/workspace/scripts/lifecycle" \
           "$FIX/docs/B1-docs/$RAW_ID" "$FIX/$STORY/issues"
  cp "$ISSUE_SYNC" "$FIX/bin/issue-sync"
  cp "$ROOT_DIR/docs/system/workspace/scripts/sync/raw_title_contract.py" \
     "$FIX/docs/system/workspace/scripts/sync/raw_title_contract.py"
  # Single-owner frontmatter CLI (#4148): without it every _fm_* call is a no-op.
  cp "$ROOT_DIR"/docs/system/workspace/scripts/lifecycle/*.py \
     "$FIX/docs/system/workspace/scripts/lifecycle/"

  cat > "$FIX/docs/system/workspace/scripts/runtime/gitee-issue.py" <<'STUB'
import json, os, sys
with open(os.environ["STUB_LOG"], "a") as f:
    f.write(json.dumps(sys.argv[1:]) + "\n")
args = sys.argv[1:]
if "create" in args:
    print(json.dumps({"number": "77", "html_url": "https://gitee.com/o/r/issues/77"}))
else:
    print(json.dumps({"ok": True}))
STUB

  cat > "$FIX/stub/gh" <<'STUB'
#!/usr/bin/env bash
echo "$*" >> "${STUB_LOG:-/dev/null}.gh"
case "$*" in
  "repo view --json nameWithOwner -q .nameWithOwner") echo "o/r"; exit 0 ;;
  repo\ view*) echo '{"nameWithOwner":"o/r"}'; exit 0 ;;
  auth\ status*) exit 0 ;;
  issue\ create*) echo "https://github.com/o/r/issues/88"; exit 0 ;;
  *) exit 0 ;;
esac
STUB
  chmod +x "$FIX/stub/gh"

  cat > "$FIX/docs/B1-docs/$RAW_ID/issue.md" <<DOC
---
schema_version: '1'
local_id: $RAW_ID
kind: raw
phase_state: proposed
absorbed_into: ''
platform_ids:
  github:
    issue_id: '11'
    url: https://github.com/o/r/issues/11
    synced_at: ''
  gitee:
    issue_id: 'G11'
    url: https://gitee.com/o/r/issues/G11
    synced_at: ''
primary_platform: github
canonical_issue_path: ''
last_synced_comment_at: {}
hash: ''
created_at: '2026-01-01T00:00:00Z'
updated_at: '2026-01-01T00:00:00Z'
intake_id: ''
author: platform
channel: github
session_refs: []
platform_state: open
promoted_children: []
source_candidate: ''
completed_at: ''
closeout_note: ''
---

workflow_kind: fix

## 问题

promote 目标文档在 B2。
DOC

  cat > "$FIX/$STORY/issues/$I_ID.md" <<DOC
---
schema_version: '1'
issue_id: $I_ID
kind: linked
status: in_dev
phase_state: completed
promoted_from: $RAW_ID
