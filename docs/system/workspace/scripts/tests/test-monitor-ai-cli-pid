#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-monitor-pid.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

prompt_file="$TMP_DIR/prompt.txt"
pid_file="$TMP_DIR/ai.pid"
log_file="$TMP_DIR/ai.log"

cat >"$prompt_file" <<'EOF'
test prompt
EOF

session_id_file="$TMP_DIR/session.id"

bash "$ROOT_DIR/docs/system/workspace/scripts/monitor-ai-cli.sh" \
  --project "$ROOT_DIR" \
  --tool test-sleep \
  --model "" \
  --mode auto \
  --prompt-file "$prompt_file" \
  --pid-file "$pid_file" \
  --log-file "$log_file" \
  --launch-kind fresh \
  >"$session_id_file" &

monitor_pid=$!
sleep 1

recorded_pid="$(cat "$pid_file")"
reported_pid="$(tr -d '\n' <"$session_id_file")"

[[ -n "$recorded_pid" ]]
[[ "$recorded_pid" == "$reported_pid" ]]
kill -0 "$recorded_pid" 2>/dev/null

wait "$monitor_pid"

printf '%s\n' "$(cat "$log_file")" | grep -q '\[TEST\] mock AI CLI started'

echo "[PASS] monitor writes the real launched pid and blocks until exit"
