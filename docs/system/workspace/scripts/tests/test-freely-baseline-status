#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-baseline-status.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/repo"
mkdir -p "$PROJECT/.freely/run" "$PROJECT/docs"
git -C "$TMP_DIR" init -q "$PROJECT"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
AI_REASONING_EFFORT="high"
EOF
cat >"$PROJECT/.freely/run/session-state.env" <<'EOF'
LAST_TOOL_SESSION_ID="session-123"
LAST_TOOL_JSONL_PATH="/tmp/session.jsonl"
LAST_LAUNCH_KIND="resume"
LAST_ROTATION_REASON="none"
CHECKPOINT_DRIFT_STREAK_CURRENT="2"
EOF

BASELINE_OUTPUT="$(bash "$ROOT_DIR/bin/freely" baseline-status --project "$PROJECT")"
STATUS_VIEW_OUTPUT="$(bash "$ROOT_DIR/bin/freely" status --project "$PROJECT" --view baseline)"

printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'project: '
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'last_tool_session_id: session-123'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'reasoning_effort: high'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'checkpoint_drift_streak: 2'

if [[ "$BASELINE_OUTPUT" != "$STATUS_VIEW_OUTPUT" ]]; then
  echo "[FAIL] status --view baseline diverged from baseline-status" >&2
  exit 1
fi

echo "[PASS] freely baseline-status is the canonical baseline snapshot"
