#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-baseline-status.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/repo"
mkdir -p "$PROJECT/.freely/run" "$PROJECT/docs"
mkdir -p "$PROJECT/.codex" "$PROJECT/.githooks" "$PROJECT/docs/pre-brainstorms"
git -C "$TMP_DIR" init -q "$PROJECT"
git -C "$PROJECT" config core.hooksPath .githooks

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
AI_REASONING_EFFORT="high"
AI_TOOL_ADAPTER="direct"
AI_TOOL_ADAPTER_POLICY="direct"
FREELY_ACTIVATION_CONSENT_STATUS="accepted"
FREELY_ACTIVATION_CONSENT_RECORDED_AT="2026-04-01T00:00:00Z"
FREELY_ACTIVATION_CONSENT_RECORDED_VIA="test"
EOF
cat >"$PROJECT/.codex/config.toml" <<'EOF'
approval_policy = "never"
sandbox_mode = "workspace-write"
[sandbox_workspace_write]
network_access = false
EOF
cat >"$PROJECT/.freely/run/session-state.env" <<'EOF'
LAST_TOOL_SESSION_ID="session-123"
LAST_TOOL_JSONL_PATH="/tmp/session.jsonl"
LAST_LAUNCH_KIND="resume"
LAST_ROTATION_REASON="none"
CHECKPOINT_DRIFT_STREAK_CURRENT="2"
LAST_PRIMARY_RATE_LIMIT_RESETS_AT="2026-04-01T03:00:00Z"
LAST_SECONDARY_RATE_LIMIT_RESETS_AT="2026-04-01T04:00:00Z"
LAST_SLOT_SWITCH_AT="2026-04-01T05:00:00Z"
LAST_DELEGATED_CONTINUATION_CONSUMED_AT="2026-04-01T06:00:00Z"
LAST_RESTART_STORM_SIGNAL_AT="2026-04-01T07:00:00Z"
LAST_RESTART_STORM_ESCALATED_AT="2026-04-01T08:00:00Z"
EOF

BASELINE_OUTPUT="$(TZ="America/Los_Angeles" bash "$ROOT_DIR/bin/freely" baseline-status --project "$PROJECT")"
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'project: '
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'last_tool_session_id: session-123'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'tool_adapter: direct'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'tool_adapter_policy: direct'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'tool_supported_adapters: direct,acp'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'security_review_policy: advisory-on-high-risk-or-uncertainty'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'security_review_scope: execution-boundary-and-reviewer-support'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'reasoning_effort: high'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'checkpoint_drift_streak: 2'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'activation_consent_recorded_at: 2026.03.31 17:00:00 PDT'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'last_primary_rate_limit_resets_at: 2026.03.31 20:00:00 PDT'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'last_secondary_rate_limit_resets_at: 2026.03.31 21:00:00 PDT'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'last_slot_switch_at: 2026.03.31 22:00:00 PDT'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'last_delegated_continuation_consumed_at: 2026.03.31 23:00:00 PDT'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'last_restart_storm_signal_at: 2026.04.01 00:00:00 PDT'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'last_restart_storm_escalated_at: 2026.04.01 01:00:00 PDT'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'execution_boundary_audit_status: pass'
printf '%s\n' "$BASELINE_OUTPUT" | grep -q 'execution_boundary_audit_detail: aligned'

echo "[PASS] freely baseline-status is the canonical baseline snapshot"
