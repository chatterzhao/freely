#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-ensure-manager-earliest-reset.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
mkdir -p "$PROJECT/.freely/run"

log_info() { :; }
log_warn() { :; }
log_error() { printf '%s\n' "$*" >&2; }

ai_cli_bin_for_project() {
  printf '%s/bin/ai\n' "$1"
}

codex_slot_cooldown_file() {
  printf '%s/.freely/run/codex-slot-cooldowns.tsv\n' "$1"
}

seconds_until_epoch() {
  local target="$1" now
  now="$(date +%s)"
  if (( target <= now )); then
    printf '0\n'
  else
    printf '%s\n' "$((target - now))"
  fi
}

source "$ROOT_DIR/docs/system/workspace/skills/freely-freely-watchdog-control-plane/scripts/availability-watchdog.sh"

now="$(date +%s)"
earliest_reset=$((now + 1))

WATCHDOG_RESET_BUFFER_SECS=2
WATCHDOG_REPROBE_INTERVAL_SECS=1
WATCHDOG_REPROBE_MAX_ATTEMPTS=4

IFS='|' read -r due_at next_at attempts max_attempts <<<"$(compute_all_unavailable_reprobe_schedule "$earliest_reset")"

if (( due_at != earliest_reset + WATCHDOG_RESET_BUFFER_SECS )); then
  echo "[FAIL] expected due_at to honor WATCHDOG_RESET_BUFFER_SECS" >&2
  exit 1
fi
if (( next_at != due_at )); then
  echo "[FAIL] expected first reprobe to wait until the buffered earliest-reset time" >&2
  exit 1
fi
if [[ "$attempts" != "0" || "$max_attempts" != "4" ]]; then
  echo "[FAIL] expected initial earliest-reset reprobe window state to start at 0 attempts with configured max attempts" >&2
  exit 1
fi

if ! should_defer_all_unavailable_reprobe "all_unavailable" "all_slots_unavailable" "fp" "fp" "$earliest_reset" "$next_at"; then
  echo "[FAIL] expected watchdog to defer reprobe before the buffered earliest-reset time" >&2
  exit 1
fi

sleep 3

if should_defer_all_unavailable_reprobe "all_unavailable" "all_slots_unavailable" "fp" "fp" "$earliest_reset" "$next_at"; then
  echo "[FAIL] expected watchdog to stop deferring once the buffered earliest-reset time has arrived" >&2
  exit 1
fi

EARLIEST_REPROBE_ATTEMPTS=0
IFS='|' read -r due_at next_at attempts max_attempts <<<"$(compute_all_unavailable_reprobe_schedule "$earliest_reset" "$earliest_reset" "$due_at" "$EARLIEST_REPROBE_ATTEMPTS")"
if [[ "$attempts" != "1" ]]; then
  echo "[FAIL] expected first post-reset reprobe to count as attempt 1" >&2
  exit 1
fi
if (( next_at <= $(date +%s) )); then
  echo "[FAIL] expected a later reprobe to be scheduled after the configured interval" >&2
  exit 1
fi

if ! should_defer_all_unavailable_reprobe "all_unavailable" "all_slots_unavailable" "fp" "fp" "$earliest_reset" "$next_at"; then
  echo "[FAIL] expected watchdog to defer again until the next scheduled post-reset reprobe slot" >&2
  exit 1
fi

if ! FREELY_FORCE_WATCHDOG_REPROBE=1 should_defer_all_unavailable_reprobe "all_unavailable" "all_slots_unavailable" "fp" "fp" "$earliest_reset" "$next_at"; then
  :
else
  echo "[FAIL] expected explicit forced reprobe to bypass the earliest-reset wait window" >&2
  exit 1
fi

echo "[PASS] ensure-manager earliest-reset scheduling defers before the buffered reset time, schedules spaced reprobes after it, and lets forced auth-change wake bypass the wait"
