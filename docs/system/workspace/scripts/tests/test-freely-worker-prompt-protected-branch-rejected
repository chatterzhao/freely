#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-worker-protected-branch.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
WORKER="$TMP_DIR/project-worktrees/feature-worker"
mkdir -p "$PROJECT/.freely/run/worker-prompts" "$WORKER"

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

worker_prompt_launchable_for_project_branch() {
  local project="$1" worktree="$2" branch="$3"
  local prompt
  prompt="$(mktemp)"
  cat >"$prompt" <<EOF
Worktree:
- \`$worktree\`
Branch:
- \`$branch\`
EOF
  worker_prompt_launchable_for_manager_project "$project" "$prompt"
  local rc=$?
  rm -f "$prompt"
  return $rc
}

# Test: develop branch should be rejected
if worker_prompt_launchable_for_project_branch "$PROJECT" "$WORKER" "develop"; then
  echo "[FAIL] expected non-launchable for develop" >&2
  exit 1
fi
echo "[PASS] develop rejected"

# Test: main branch should be rejected
if worker_prompt_launchable_for_project_branch "$PROJECT" "$WORKER" "main"; then
  echo "[FAIL] expected non-launchable for main" >&2
  exit 1
fi
echo "[PASS] main rejected"

# Test: test-pre-merge-* branch should be rejected
if worker_prompt_launchable_for_project_branch "$PROJECT" "$WORKER" "test-pre-merge-20260509-some-fix"; then
  echo "[FAIL] expected non-launchable for test-pre-merge-*" >&2
  exit 1
fi
echo "[PASS] test-pre-merge-* rejected"

# Test: release/* branch should be rejected
if worker_prompt_launchable_for_project_branch "$PROJECT" "$WORKER" "release/2026.05.01-stable"; then
  echo "[FAIL] expected non-launchable for release/*" >&2
  exit 1
fi
echo "[PASS] release/* rejected"

# Test: fix/* branch should be accepted
if ! worker_prompt_launchable_for_project_branch "$PROJECT" "$WORKER" "fix/raw-20260509-test"; then
  echo "[FAIL] expected launchable for fix/*" >&2
  exit 1
fi
echo "[PASS] fix/* accepted"

# Test: feature/* branch should be accepted
if ! worker_prompt_launchable_for_project_branch "$PROJECT" "$WORKER" "feature/my-feature"; then
  echo "[FAIL] expected launchable for feature/*" >&2
  exit 1
fi
echo "[PASS] feature/* accepted"

# Test: empty/unparseable branch value should be accepted (backward compat)
PROMPT=$(mktemp)
cat >"$PROMPT" <<EOF
Worktree:
- \`$WORKER\`
- title: some prompt without branch header
EOF
if ! worker_prompt_launchable_for_manager_project "$PROJECT" "$PROMPT"; then
  echo "[FAIL] expected launchable for unparseable branch" >&2
  exit 1
fi
echo "[PASS] empty branch value accepted"
rm -f "$PROMPT"

echo "[PASS] all branch protection checks passed"
