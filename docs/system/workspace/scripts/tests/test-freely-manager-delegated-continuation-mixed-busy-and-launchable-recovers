#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-mixed-busy-launchable.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
WT_ROOT="$TMP_DIR/project-worktrees"
BUSY_WORKER="$WT_ROOT/feature-busy-worker"
IDLE_WORKER="$WT_ROOT/feature-idle-worker"

mkdir -p "$PROJECT/.freely/run/worker-prompts" "$PROJECT/.freely/logs" "$WT_ROOT"
cd "$PROJECT"
git init -q -b develop
git config user.name tester
git config user.email tester@example.com
echo base > README.md
mkdir -p docs/B1-docs/raw-20260322-0000
cat >docs/PROJECT_INTENT.md <<'EOF'
# Intent
EOF
cat >docs/CONSTITUTION.md <<'EOF'
# Constitution
EOF
cat >docs/LAWS.md <<'EOF'
# Laws
EOF
cat >AGENTS.md <<'EOF'
# Agents
EOF
cat >docs/B1-docs/README.md <<'EOF'
# README
EOF
cat >docs/B1-docs/INDEX.md <<'EOF'
# INDEX
- 20260322-0000--sample
EOF
cat >docs/B1-docs/CONVERGENCE.md <<'EOF'
# CONVERGENCE
EOF
cat >docs/B1-docs/raw-20260322-0000/brainstorms.md <<'EOF'
# Brainstorms
EOF
cat >docs/B1-docs/raw-20260322-0000/candidates.md <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF
git add .
git commit -q -m init
git worktree add "$BUSY_WORKER" -b feature/busy-worker develop >/dev/null
git worktree add "$IDLE_WORKER" -b feature/idle-worker develop >/dev/null

mkdir -p "$BUSY_WORKER/.freely/run" "$BUSY_WORKER/.freely/logs" "$IDLE_WORKER/.freely/run" "$IDLE_WORKER/.freely/logs"
cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

sleep 999 >/dev/null 2>&1 &
AI_PID=$!
echo "$AI_PID" >"$PROJECT/.freely/run/ai.pid"
echo "$$" >"$PROJECT/.freely/run/supervisor.pid"

cat >"$PROJECT/.freely/run/prompt-20260323-220100.txt" <<'EOF'
主管模式提示

Delegated continuation handoff:
- intake_id=20260323-220100-current message=keep routing
EOF
touch -t 202603232201 "$PROJECT/.freely/run/prompt-20260323-220100.txt"

cat >"$BUSY_WORKER/.freely/run/prompt-20260323-220050.txt" <<'EOF'
worker prompt

Delegated continuation handoff:
- intake_id=existing message=keep working
EOF

BUSY_PROMPT="$PROJECT/.freely/run/worker-prompts/20260323-220101-worker-busy-codex.txt"
cat >"$BUSY_PROMPT" <<EOF
Dispatch metadata:
- dispatch_priority: P0
- parallel_safe: true
- write_scope: $BUSY_WORKER

Branch:
- \`feature/busy-worker\`

Worktree:
- \`$BUSY_WORKER\`
EOF

IDLE_PROMPT="$PROJECT/.freely/run/worker-prompts/20260323-220102-worker-idle-codex.txt"
cat >"$IDLE_PROMPT" <<EOF
Dispatch metadata:
- dispatch_priority: P0
- parallel_safe: true
- write_scope: $IDLE_WORKER

Branch:
- \`feature/idle-worker\`

Worktree:
- \`$IDLE_WORKER\`
EOF

CONTINUITY="$PROJECT/.freely/run/manager-continuity-20260323-220101.md"
cat >"$CONTINUITY" <<EOF
# Manager Continuity
- worker_prompt: \`$BUSY_PROMPT\`
- worker_prompt: \`$IDLE_PROMPT\`
EOF
touch -t 202603232202 "$CONTINUITY"

touch "$PROJECT/.freely/logs/cycle-20260323-220100.log"
touch -t 202603232201 "$PROJECT/.freely/logs/cycle-20260323-220100.log"

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

PREEMPT_LOG="$TMP_DIR/preempt.log"
RESTART_LOG="$TMP_DIR/restart.log"
manager_ai_pid_for_project() {
  echo "$AI_PID"
}
manager_supervisor_pid_for_project() {
  local project="$1"
  if [[ "$project" == "$BUSY_WORKER" ]]; then
    echo "12345"
  fi
}
runtime_ai_pid_hint_for_project() {
  local project="$1"
  if [[ "$project" == "$BUSY_WORKER" ]]; then
    echo "54321"
  fi
}
request_local_continuation_reentry() {
  echo "$1|$2" >>"$PREEMPT_LOG"
  write_preemption_state "$1" "graceful_term" "local_continuation_reentry" "$2" "$AI_PID"
}
restart_manager_supervisor_preserving_handoff() {
  echo "$1" >>"$RESTART_LOG"
}
write_manager_bootstrap_handoff() {
  printf '%s|%s|%s\n' "$1" "$5" "$6" >>"$TMP_DIR/handoff.log"
}
codex_current_account() {
  echo "test@example.com"
}

if ! recover_stalled_manager_ai_if_needed "$PROJECT"; then
  echo "[FAIL] mixed busy and still-launchable prompts should still trigger recovery" >&2
  exit 1
fi

grep -q "$PROJECT|runtime-stalled-ai-recovery" "$PREEMPT_LOG"
grep -q "$PROJECT" "$RESTART_LOG"
grep -q 'manager_ai_stalled_after_delegated_continuation_prompt|relaunch-manager-after-stall-recovery' "$TMP_DIR/handoff.log"

echo "[PASS] active busy worker does not suppress recovery when the same continuity still contains another launchable worker prompt"
