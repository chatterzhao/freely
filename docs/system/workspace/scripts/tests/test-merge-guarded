#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TEST_TMP="$(mktemp -d /tmp/freely-merge-guard.XXXXXX)"
PIDS=()
cleanup() {
  local pid
  for pid in "${PIDS[@]:-}"; do
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  done
  rm -rf "$TEST_TMP"
}
trap cleanup EXIT

REPO="$TEST_TMP/repo"
mkdir -p "$REPO"
cd "$REPO"

git init -q -b develop
git config user.name tester
git config user.email tester@example.com
cp "$ROOT_DIR/docs/system/workspace/scripts/worktree/merge-guarded" "$REPO/bin-merge-guarded"
mkdir -p "$REPO/bin" "$REPO/docs/system/workspace/scripts/quality" "$REPO/docs/system/workspace/scripts/runtime" "$REPO/docs/system/workspace/skills/watchdog-control-plane/scripts"
cp "$ROOT_DIR/bin/governance-promotion-gate" "$REPO/bin/governance-promotion-gate"
cp "$ROOT_DIR/docs/system/workspace/scripts/quality/governance-promotion-gate" "$REPO/docs/system/workspace/scripts/quality/governance-promotion-gate"
cp "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely" "$REPO/docs/system/workspace/scripts/runtime/freely"
cp "$ROOT_DIR/docs/system/workspace/scripts/runtime/session-evidence-resolver.sh" "$REPO/docs/system/workspace/scripts/runtime/session-evidence-resolver.sh"
cp "$ROOT_DIR/docs/system/workspace/scripts/runtime/network-proxy-resolver.sh" "$REPO/docs/system/workspace/scripts/runtime/network-proxy-resolver.sh"
cp "$ROOT_DIR/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh" "$REPO/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"
chmod +x "$REPO/bin-merge-guarded"
chmod +x "$REPO/bin/governance-promotion-gate" "$REPO/docs/system/workspace/scripts/quality/governance-promotion-gate" "$REPO/docs/system/workspace/scripts/runtime/freely" "$REPO/docs/system/workspace/scripts/runtime/session-evidence-resolver.sh" "$REPO/docs/system/workspace/scripts/runtime/network-proxy-resolver.sh" "$REPO/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"

echo base > README.md
git add README.md
git commit -q -m "init"

git branch main
git branch test-pre-merge-20260327-demo
git branch feature/demo
git branch hotfix/demo main
git branch release/demo develop

git checkout -q feature/demo
echo feature >> README.md
git commit -q -am "feature change"

git checkout -q hotfix/demo
echo hotfix >> HOTFIX.md
git add HOTFIX.md
git commit -q -m "hotfix change"

git checkout -q develop
"$REPO/bin-merge-guarded" develop feature/demo >/dev/null
git merge-base --is-ancestor feature/demo develop
git log -1 --format=%B HEAD | grep -q '^Freely-Merge-Path: merge-guarded$'
git log -1 --format=%B HEAD | grep -q '^Freely-Bypass-Mode: forbidden$'
git log -1 --format=%B HEAD | grep -q '^Freely-Source-Branch: feature/demo$'

if "$REPO/bin-merge-guarded" develop test-pre-merge-20260327-demo >/dev/null 2>"$TEST_TMP/pretestmerge-blocked.err"; then
  echo "[FAIL] invalid test-pre-merge -> develop merge unexpectedly allowed" >&2
  exit 1
fi
grep -q "blocked merge" "$TEST_TMP/pretestmerge-blocked.err"

git checkout -q test-pre-merge-20260327-demo
"$REPO/bin-merge-guarded" test-pre-merge-20260327-demo hotfix/demo >/dev/null
git merge-base --is-ancestor hotfix/demo test-pre-merge-20260327-demo

git checkout -q main
if "$REPO/bin-merge-guarded" main feature/demo >/dev/null 2>"$TEST_TMP/blocked.err"; then
  echo "[FAIL] invalid feature -> main merge unexpectedly allowed" >&2
  exit 1
fi
grep -q "blocked merge" "$TEST_TMP/blocked.err"

git checkout -q develop
git checkout -q -b feature/promotion-owner
echo promotion > PROMOTION.md
git add PROMOTION.md
git commit -q -m "promotion owner branch"

git checkout -q develop
SOURCE_WT="$TEST_TMP/source-worker"
CONFLICT_WT="$TEST_TMP/conflict-worker"
git worktree add -q "$SOURCE_WT" feature/promotion-owner
git worktree add -q -b feature/promotion-conflict "$CONFLICT_WT" develop

mkdir -p "$SOURCE_WT/.freely/run" "$CONFLICT_WT/.freely/run"
cat > "$SOURCE_WT/.freely/run/prompt-20260402-080000.txt" <<EOF
Worktree:
- \`$SOURCE_WT\`
Branch:
- \`feature/promotion-owner\`
- intent_kind: promotion
- intent_target: \`I-20260327-2205 -> develop\`
EOF
cat > "$CONFLICT_WT/.freely/run/prompt-20260402-080100.txt" <<EOF
Worktree:
- \`$CONFLICT_WT\`
Branch:
- \`feature/promotion-conflict\`
- intent_kind: promotion
- intent_target: \`I-20260327-2205 -> develop\`
EOF

(
  cd "$SOURCE_WT"
  exec bash -lc 'exec -a "codex exec" sleep 300'
) &
SOURCE_PID=$!
PIDS+=("$SOURCE_PID")
printf '%s\n' "$SOURCE_PID" > "$SOURCE_WT/.freely/run/ai.pid"

(
  cd "$CONFLICT_WT"
  exec bash -lc 'exec -a "codex exec" sleep 300'
) &
CONFLICT_PID=$!
PIDS+=("$CONFLICT_PID")
printf '%s\n' "$CONFLICT_PID" > "$CONFLICT_WT/.freely/run/ai.pid"

if "$REPO/bin-merge-guarded" develop feature/promotion-owner >/dev/null 2>"$TEST_TMP/promotion-blocked.err"; then
  echo "[FAIL] merge-guarded should block duplicate develop promotion ownership before merge" >&2
  exit 1
fi
grep -q "duplicate develop promotion ownership is already active" "$TEST_TMP/promotion-blocked.err"

kill "$CONFLICT_PID" 2>/dev/null || true
wait "$CONFLICT_PID" 2>/dev/null || true
rm -f "$CONFLICT_WT/.freely/run/ai.pid"

"$REPO/bin-merge-guarded" develop feature/promotion-owner >/dev/null
git merge-base --is-ancestor feature/promotion-owner develop
git log -1 --format=%B HEAD | grep -q '^Freely-Merge-Path: merge-guarded$'

git checkout -q -b feature/conflict-normal
printf 'feature-side\n' > CONFLICT.txt
git add CONFLICT.txt
git commit -q -m "seed conflict source"

git checkout -q develop
printf 'develop-side\n' > CONFLICT.txt
git add CONFLICT.txt
git commit -q -m "seed conflict target"

set +e
"$REPO/bin-merge-guarded" develop feature/conflict-normal >/dev/null 2>"$TEST_TMP/conflict-normal.err"
conflict_normal_rc=$?
set -e
[[ "$conflict_normal_rc" -ne 0 ]] || {
  echo "[FAIL] merge-guarded should stop on textual conflict and leave merge state for completion" >&2
  exit 1
}
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1
printf 'resolved-normal\n' > CONFLICT.txt
git add CONFLICT.txt
"$REPO/bin-merge-guarded" complete develop feature/conflict-normal >/dev/null
git log -1 --format=%B HEAD | grep -q '^Freely-Merge-Path: merge-guarded-complete$'
git log -1 --format=%B HEAD | grep -q '^Freely-Bypass-Mode: forbidden$'
git log -1 --format=%B HEAD | grep -q '^Freely-Source-Branch: feature/conflict-normal$'

git checkout -q -b feature/conflict-breakglass
printf 'breakglass-source\n' > BREAKGLASS.txt
git add BREAKGLASS.txt
git commit -q -m "seed break-glass source"

git checkout -q develop
printf 'breakglass-target\n' > BREAKGLASS.txt
git add BREAKGLASS.txt
git commit -q -m "seed break-glass target"

set +e
"$REPO/bin-merge-guarded" develop feature/conflict-breakglass >/dev/null 2>"$TEST_TMP/conflict-breakglass.err"
conflict_breakglass_rc=$?
set -e
[[ "$conflict_breakglass_rc" -ne 0 ]] || {
  echo "[FAIL] merge-guarded should leave conflict state for break-glass completion test" >&2
  exit 1
}
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1
printf 'resolved-breakglass\n' > BREAKGLASS.txt
git add BREAKGLASS.txt
"$REPO/bin-merge-guarded" complete develop feature/conflict-breakglass \
  --break-glass \
  --reason verified_false_negative \
  --blocked-gate pre-merge-commit \
  --evidence-ref docs/epics/sample/story/code-reviews/r-breakglass.md \
  --follow-on-issue I-20260402-0020-A >/dev/null
git log -1 --format=%B HEAD | grep -q '^Freely-Merge-Path: merge-guarded-break-glass$'
git log -1 --format=%B HEAD | grep -q '^Freely-Bypass-Mode: break_glass$'
git log -1 --format=%B HEAD | grep -q '^Freely-Break-Glass-Reason: verified_false_negative$'
git log -1 --format=%B HEAD | grep -q '^Freely-Blocked-Gate: pre-merge-commit$'
git log -1 --format=%B HEAD | grep -q '^Freely-Operation-Scope: merge_completion_only$'
git log -1 --format=%B HEAD | grep -q '^Freely-Evidence-Ref: docs/epics/sample/story/code-reviews/r-breakglass.md$'
git log -1 --format=%B HEAD | grep -q '^Freely-Follow-On-Issue: I-20260402-0020-A$'

echo "[PASS] merge-guarded enforces replay-only develop paths, duplicate promotion ownership, and controlled completion receipts"
