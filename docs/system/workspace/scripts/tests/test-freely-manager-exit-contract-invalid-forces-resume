LAST_RESTART_STORM_SIGNAL_REASON=""
LAST_RESTART_STORM_ESCALATED_AT=""
LAST_RESTART_STORM_ESCALATION_TARGET=""
AUTO_RECOVERY_ATTEMPTED_TOOLS_CSV=""
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

ACTION="$(manager_runtime_handle_exit_contract_after_ai_cycle "$PROJECT" "ai_exit_rc_0")"
[[ "$ACTION" == "resume_invalid" ]]
grep -q '^LAST_EXIT_REASON="manager_exit_contract_invalid"$' "$PROJECT/.freely/run/workcell-state.env"
grep -q 'manager_exit_contract_invalid' "$PROJECT/.freely/run/session-handoff.txt"
grep -q 'resume-demo' "$PROJECT/.freely/run/session-handoff.txt"

echo "[PASS] invalid manager exit contract forces precise resume repair"
