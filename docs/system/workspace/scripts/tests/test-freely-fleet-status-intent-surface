#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-fleet-status-intent.XXXXXX)"
TMP_DIR_REAL="$(cd "$TMP_DIR" && pwd -P)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/repo"
WT_ROOT="$TMP_DIR/repo-worktrees"
WORKER="$WT_ROOT/feature-promotion"
WORKER_REAL="$TMP_DIR_REAL/repo-worktrees/feature-promotion"

mkdir -p "$PROJECT/.freely/run/worker-prompts" "$PROJECT/docs" "$WT_ROOT"
cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
git init -q "$PROJECT"
git -C "$PROJECT" config user.email "test@example.com"
git -C "$PROJECT" config user.name "Test User"
cat >"$PROJECT/README.md" <<'EOF'
# repo
EOF
git -C "$PROJECT" add README.md
git -C "$PROJECT" commit -q -m "init"
git -C "$PROJECT" branch -m develop
git -C "$PROJECT" worktree add -q -b feature/promotion "$WORKER"

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF
mkdir -p "$WORKER/.freely/run" "$WORKER/docs"
cat >"$WORKER/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$WORKER/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$WORKER/.freely/config.env" <<EOF
PROJECT_ROOT="$WORKER"
INTENT_FILE="$WORKER/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$WORKER/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

cat >"$WORKER/.freely/run/prompt-20260402-132000.txt" <<EOF
Dispatch metadata:
- intent_kind: promotion
- intent_target: \`I-20260402-0455-A -> develop\`

Worktree:
- \`$WORKER\`
EOF

QUEUE_PROMPT="$PROJECT/.freely/run/worker-prompts/20260402-132100-worker-cleanup-codex.txt"
cat >"$QUEUE_PROMPT" <<EOF
Dispatch metadata:
- intent_kind: cleanup

Worktree:
- \`$WORKER\`
EOF
cat >"$PROJECT/.freely/run/manager-worker-launch-state.env" <<EOF
LAST_MANAGER_CONTINUITY_GENERATED="$PROJECT/.freely/run/manager-continuity-20260402-132200.md"
LAST_MANAGER_WORKER_PROMPTS_GENERATED="$QUEUE_PROMPT"
LAST_MANAGER_CONTINUITY_CONSUMED="$PROJECT/.freely/run/manager-continuity-20260402-132200.md"
LAST_MANAGER_WORKER_PROMPTS_CONSUMED=""
LAUNCHED_WORKER_PROMPTS=""
QUEUED_WORKER_PROMPTS="$QUEUE_PROMPT"
MAX_PARALLEL_WORKERS="unbounded"
ACTIVE_RUNNING_WORKER_COUNT="0"
AVAILABLE_NEW_WORKER_SLOTS="unbounded"
UPDATED_AT="2026-04-02T13:22:00Z"
EOF

OUTPUT="$(bash "$ROOT_DIR/bin/freely" fleet-status --project "$PROJECT")"

grep -q 'promotion@I-20260402-0455-A -> develop' <<<"$OUTPUT"
grep -q "manager_intent" <<<"$OUTPUT"
grep -q "generated=cleanup@$WORKER_REAL consumed=none" <<<"$OUTPUT"

echo "[PASS] fleet-status surfaces worker and manager intent ownership summaries"
