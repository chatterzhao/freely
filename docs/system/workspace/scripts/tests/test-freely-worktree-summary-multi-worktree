#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-worktree-summary.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
WORKTREE_DIR="$TMP_DIR/feature-wt"

git init -q -b develop "$PROJECT"
git -C "$PROJECT" config user.name "Freely Test"
git -C "$PROJECT" config user.email "freely@example.com"

mkdir -p "$PROJECT/docs"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
git -C "$PROJECT" add .
git -C "$PROJECT" commit -q -m "init"

git -C "$PROJECT" worktree add -q -b feature/test "$WORKTREE_DIR" develop
echo "dirty" >"$WORKTREE_DIR/dirty.txt"

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

summary="$(worktree_summary_for_project "$PROJECT")"
[[ "$summary" == "2|1" ]] || {
  echo "[FAIL] expected worktree summary 2|1, got $summary" >&2
  exit 1
}

echo "[PASS] worktree summary counts multiple worktrees without pipe-based parsing"
