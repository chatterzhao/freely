#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-security-review-brief.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/repo"
mkdir -p "$PROJECT/.freely/run" "$PROJECT/.codex" "$PROJECT/.githooks" "$PROJECT/docs/pre-brainstorms"
git -C "$TMP_DIR" init -q "$PROJECT"
git -C "$PROJECT" config core.hooksPath .githooks

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
AI_REASONING_EFFORT="high"
AI_TOOL_ADAPTER="direct"
AI_TOOL_ADAPTER_POLICY="direct"
AI_CAPABILITY_CODEX_MODEL="gpt-5.4"
AI_CAPABILITY_CODEX_SANDBOX="workspace-write"
AI_CAPABILITY_CODEX_APPROVAL_POLICY="never"
AI_CAPABILITY_CODEX_CWD_MODE="project-root"
FREELY_ACTIVATION_CONSENT_STATUS="accepted"
FREELY_ACTIVATION_CONSENT_RECORDED_AT="2026-04-01T00:00:00Z"
FREELY_ACTIVATION_CONSENT_RECORDED_VIA="test"
CURRENT_TOOL_SLOT="codex-default"
EOF

cat >"$PROJECT/.codex/config.toml" <<'EOF'
approval_policy = "never"
sandbox_mode = "workspace-write"
[sandbox_workspace_write]
network_access = false
EOF

bash "$ROOT_DIR/bin/freely" security-review-brief --project "$PROJECT" >"$TMP_DIR/pass.out"
grep -q 'security_review_mode: none' "$TMP_DIR/pass.out"
grep -q 'recommended_reviewer_count: 0' "$TMP_DIR/pass.out"
grep -q 'security_review_decision: continue-current-agent' "$TMP_DIR/pass.out"

cat >"$PROJECT/.codex/config.toml" <<'EOF'
approval_policy = "never"
sandbox_mode = "workspace-write"
[sandbox_workspace_write]
network_access = true
EOF

bash "$ROOT_DIR/bin/freely" security-review-brief --project "$PROJECT" >"$TMP_DIR/warn.out"
grep -q 'execution_boundary_audit_status: warn' "$TMP_DIR/warn.out"
grep -q 'security_review_mode: single-reviewer' "$TMP_DIR/warn.out"
grep -q 'recommended_reviewer_count: 1' "$TMP_DIR/warn.out"
grep -q 'recommended_review_scope: codex-network-access' "$TMP_DIR/warn.out"

cat >"$PROJECT/.codex/config.toml" <<'EOF'
approval_policy = "on-request"
sandbox_mode = "workspace-write"
[sandbox_workspace_write]
network_access = false
EOF

bash "$ROOT_DIR/bin/freely" security-review-brief --project "$PROJECT" >"$TMP_DIR/fail.out"
grep -q 'execution_boundary_audit_status: fail' "$TMP_DIR/fail.out"
grep -q 'security_review_mode: decision-committee' "$TMP_DIR/fail.out"
grep -q 'recommended_reviewer_count: 2' "$TMP_DIR/fail.out"
grep -q 'recommended_review_scope: codex-approval-policy' "$TMP_DIR/fail.out"
grep -q 'security_review_decision: repair-boundary-before-continue' "$TMP_DIR/fail.out"
grep -q 'minimal_risk_state: last-resort-safe-stop' "$TMP_DIR/fail.out"

echo "[PASS] freely security-review-brief surfaces reviewer escalation guidance from execution-boundary truth"
