#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-live-status-hint-degrade.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/repo"
mkdir -p "$PROJECT/.freely/run" "$PROJECT/docs/system/workspace/scripts" "$PROJECT/docs"

git init -q "$PROJECT"
git -C "$PROJECT" config user.email "test@example.com"
git -C "$PROJECT" config user.name "Test User"
cat >"$PROJECT/README.md" <<'EOF'
# repo
EOF
git -C "$PROJECT" add README.md
git -C "$PROJECT" commit -q -m "init"
git -C "$PROJECT" branch -m develop

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF
cat >"$PROJECT/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="up"
LAST_AI_STATE="down"
LAST_EXIT_REASON="starting"
LAST_ROLE_HINT="manager"
LAST_STATE_UPDATED_AT="2026-04-07T01:10:28Z"
EOF
cat >"$PROJECT/docs/system/workspace/scripts/start-lead-agent.sh" <<'EOF'
#!/usr/bin/env bash
exec manager --workspace-root "$1" --reasoning-effort medium
EOF

sleep 30 &
FOREIGN_PID=$!
trap 'kill "$FOREIGN_PID" 2>/dev/null || true; rm -rf "$TMP_DIR"' EXIT
printf '%s' "$FOREIGN_PID" >"$PROJECT/.freely/run/supervisor.pid"
printf '%s' "$FOREIGN_PID" >"$PROJECT/.freely/run/interruption-dispatch.pid"
printf '%s' "$FOREIGN_PID" >"$PROJECT/.freely/run/manager-watchdog.pid"
printf '%s' "$FOREIGN_PID" >"$PROJECT/.freely/run/ai.pid"

LIVE_OUTPUT="$(PATH="/usr/bin:/bin:/usr/sbin:/sbin" bash "$ROOT_DIR/bin/freely" live-status --project "$PROJECT")"

printf '%s\n' "$LIVE_OUTPUT" | grep -q '^project: '
printf '%s\n' "$LIVE_OUTPUT" | grep -q '^activity_state: idle$'
printf '%s\n' "$LIVE_OUTPUT" | grep -q '^active_processes: none$'
printf '%s\n' "$LIVE_OUTPUT" | grep -q '^last_ai_state: down$'

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"
WORKSPACE_ROOT="$(PATH="/usr/bin:/bin:/usr/sbin:/sbin" workspace_root_for_project "$PROJECT")"
[[ "$WORKSPACE_ROOT" == "$PROJECT/docs/system/workspace" ]]

kill "$FOREIGN_PID" 2>/dev/null || true
wait "$FOREIGN_PID" 2>/dev/null || true

echo "[PASS] live-status degrades cleanly when pid hints fail validation and workspace root no longer depends on rg"
