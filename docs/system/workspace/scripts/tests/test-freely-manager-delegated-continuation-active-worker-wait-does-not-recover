#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-active-worker-wait.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
WT_ROOT="$TMP_DIR/project-worktrees"
WORKER="$WT_ROOT/feature-worker"

mkdir -p "$PROJECT/.freely/run/worker-prompts" "$PROJECT/.freely/logs" "$WT_ROOT"
cd "$PROJECT"
git init -q -b develop
git config user.name tester
git config user.email tester@example.com
echo base > README.md
mkdir -p docs/B1-docs/raw-20260322-0000
cat >docs/PROJECT_INTENT.md <<'EOF'
# Intent
EOF
cat >docs/CONSTITUTION.md <<'EOF'
# Constitution
EOF
cat >docs/LAWS.md <<'EOF'
# Laws
EOF
cat >AGENTS.md <<'EOF'
# Agents
EOF
cat >docs/B1-docs/README.md <<'EOF'
# README
EOF
cat >docs/B1-docs/INDEX.md <<'EOF'
# INDEX
- 20260322-0000--sample
EOF
cat >docs/B1-docs/CONVERGENCE.md <<'EOF'
# CONVERGENCE
EOF
cat >docs/B1-docs/raw-20260322-0000/brainstorms.md <<'EOF'
# Brainstorms
EOF
cat >docs/B1-docs/raw-20260322-0000/candidates.md <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF
git add .
git commit -q -m init
git worktree add "$WORKER" -b feature/worker develop >/dev/null

mkdir -p "$WORKER/.freely/run" "$WORKER/.freely/logs"
cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

sleep 999 >/dev/null 2>&1 &
AI_PID=$!
echo "$AI_PID" >"$PROJECT/.freely/run/ai.pid"
echo "$$" >"$PROJECT/.freely/run/supervisor.pid"

cat >"$PROJECT/.freely/run/prompt-20260323-210100.txt" <<'EOF'
主管模式提示

Delegated continuation handoff:
- intake_id=20260323-210100-current message=wait for current worker
EOF
touch -t 202603232101 "$PROJECT/.freely/run/prompt-20260323-210100.txt"

WORKER_RUNTIME_PROMPT="$WORKER/.freely/run/prompt-20260323-210050.txt"
cat >"$WORKER_RUNTIME_PROMPT" <<'EOF'
worker prompt

Delegated continuation handoff:
- intake_id=existing message=keep working
EOF

WORKER_PROMPT="$PROJECT/.freely/run/worker-prompts/20260323-210101-worker-busy-codex.txt"
cat >"$WORKER_PROMPT" <<EOF
Dispatch metadata:
- dispatch_priority: P0
- parallel_safe: true
- write_scope: $WORKER

Branch:
- \`feature/worker\`

Worktree:
- \`$WORKER\`
EOF

CONTINUITY="$PROJECT/.freely/run/manager-continuity-20260323-210101.md"
cat >"$CONTINUITY" <<EOF
# Manager Continuity
- worker_prompt: \`$WORKER_PROMPT\`
EOF
touch -t 202603232101 "$CONTINUITY"

touch "$PROJECT/.freely/logs/cycle-20260323-210100.log"
touch -t 202603232101 "$PROJECT/.freely/logs/cycle-20260323-210100.log"

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

PREEMPT_LOG="$TMP_DIR/preempt.log"
RESTART_LOG="$TMP_DIR/restart.log"
manager_ai_pid_for_project() {
  echo "$AI_PID"
}
manager_supervisor_pid_for_project() {
  local project="$1"
  if [[ "$project" == "$WORKER" ]]; then
    echo "12345"
  fi
}
runtime_ai_pid_hint_for_project() {
  local project="$1"
  if [[ "$project" == "$WORKER" ]]; then
    echo "54321"
  fi
}
request_local_continuation_reentry() {
  echo "$1|$2" >>"$PREEMPT_LOG"
}
restart_manager_supervisor_preserving_handoff() {
  echo "$1" >>"$RESTART_LOG"
}
write_manager_bootstrap_handoff() {
  printf '%s|%s|%s\n' "$1" "$5" "$6" >>"$TMP_DIR/handoff.log"
}
codex_current_account() {
  echo "test@example.com"
}

if recover_stalled_manager_ai_if_needed "$PROJECT"; then
  echo "[FAIL] lawful wait on active busy worker should not trigger manager stall recovery" >&2
  exit 1
fi

if [[ -f "$PREEMPT_LOG" || -f "$RESTART_LOG" || -f "$TMP_DIR/handoff.log" ]]; then
  echo "[FAIL] no recovery side effects should be produced while waiting on active worker" >&2
  exit 1
fi

echo "[PASS] delegated continuation stall recovery stays idle-safe while latest continuity waits on active busy worker"
