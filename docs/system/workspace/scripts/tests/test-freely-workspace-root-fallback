#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-workspace-root-fallback.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
mkdir -p \
  "$PROJECT/docs/B1-docs/raw-20260309-0000" \
  "$PROJECT/docs/system/workspace/scripts" \
  "$PROJECT/.freely/run" \
  "$PROJECT/.freely/logs"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF

cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF

cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF

cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF

cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF

cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260309-0000--sample
EOF

cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF

cat >"$PROJECT/docs/B1-docs/raw-20260309-0000/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF

cat >"$PROJECT/docs/B1-docs/raw-20260309-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$PROJECT/docs/system/workspace/scripts/start-lead-agent.sh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
cat <<'USAGE'
Usage:
  start-lead-agent.sh \
    --project <abs_path> \
    --intent <abs_file> \
    --constitution <abs_file> \
    --ai <tool[:model][:mode]>
USAGE
exit 1
EOF
chmod +x "$PROJECT/docs/system/workspace/scripts/start-lead-agent.sh"

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="test-once"
AI_MODEL=""
AI_MODE="auto"
AI_REASONING_EFFORT=""
CHECK_INTERVAL=1
RESTART_DELAY=0
MAX_RESTARTS=1
IFLOW_MAX_TURNS=100
MAX_RESUME_STREAK=24
MAX_ROUTE_ONLY_STREAK=1
ROTATE_ON_CONTEXT_COMPACTED=1
SESSION_HANDOFF_TAIL_LINES=10
CONTEXT_WARN_RATIO=0.50
CONTEXT_ROTATE_RATIO=0.70
CHECKPOINT_WARN_DIRTY_ENTRIES=40
CHECKPOINT_BLOCK_DIRTY_ENTRIES=120
EOF

bash "$ROOT_DIR/bin/freely" start --project "$PROJECT" >/dev/null 2>&1 || true

first_prompt="$(ls "$PROJECT"/.freely/run/prompt-*.txt | sort | head -n 1)"
[[ -n "$first_prompt" ]] || {
  echo "[FAIL] expected prompt file"
  exit 1
}

if grep -q '^Usage:' "$first_prompt"; then
  echo "[FAIL] expected runtime to fall back from incompatible project-local workspace root"
  exit 1
fi

grep -q "$ROOT_DIR/docs/system/workspace" "$first_prompt"

echo "[PASS] freely falls back to current control-plane workspace root when project-local workspace scripts are incompatible"
