#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/watchdog-switch-suppress-wake.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT_DIR="$TMP_DIR/project"
HOME_DIR="$TMP_DIR/home"
AI_LOG="$TMP_DIR/ai.log"
mkdir -p "$PROJECT_DIR/bin" "$PROJECT_DIR/.freely/run" "$HOME_DIR/.codex"

cat >"$PROJECT_DIR/bin/ai" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'suppress=%s args=%s\n' "${AI_CLI_SUPPRESS_AUTH_CHANGE_WAKE:-0}" "$*" >>"${AI_LOG:?}"
cat <<'JSON'
{"switched": true, "tool": "codex", "slot": "slot@example-com-2", "auth_email": "slot@example.com", "account": "slot@example.com"}
JSON
EOF
chmod +x "$PROJECT_DIR/bin/ai"

cat >"$HOME_DIR/.codex/active-slot" <<'EOF'
slot@example-com-2
EOF

HOME="$HOME_DIR" AI_LOG="$AI_LOG" bash -lc '
  set -euo pipefail
  source "'"$ROOT_DIR"'/docs/system/workspace/skills/freely-freely-watchdog-control-plane/scripts/availability-watchdog.sh"
  ai_cli_bin_for_project() { printf "%s\n" "'"$PROJECT_DIR"'/bin/ai"; }
  wait_for_codex_slot_switch_idle() { return 0; }
  log_warn() { return 0; }
  switch_to_codex_slot "'"$PROJECT_DIR"'" "slot@example-com-2" "probe_promote_usable_slot" >/dev/null
'

grep -q '^suppress=1 args=--quiet --format json switch codex slot@example-com-2 --yes$' "$AI_LOG"

echo "[PASS] watchdog slot switch suppresses ai auth-change wake re-entry"
