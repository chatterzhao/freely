#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-watchdog-after-failure-reason.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
HOME_DIR="$TMP_DIR/home"
mkdir -p "$PROJECT/.freely/run" "$HOME_DIR/.codex"

bash -lc '
  set -euo pipefail
  export HOME="'"$HOME_DIR"'"
  recovery_log="'"$TMP_DIR"'/recovery.log"
  log_info() { :; }
  log_warn() { :; }
  log_error() { :; }
  source "'"$ROOT_DIR"'/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"
  codex_current_slot() { echo "slot-current"; }
  codex_current_slot_kind() { echo "apikey"; }
  codex_current_identity_hint() { echo "slot-current"; }
  codex_saved_slots_fingerprint() { echo "fp-1"; }
  codex_load_availability_state() { return 1; }
  codex_write_availability_state() { :; }
  codex_clear_availability_state() { :; }
  codex_cached_slot_status() { echo "usable"; }
  codex_live_auth_kind() { echo "apikey"; }
  write_manager_bootstrap_handoff() { :; }
  codex_exec_saved_slot_truth() {
    local _project="$1" excluded_identity="${2:-}" switch_reason="${3:-}" probe_lock_reason="${4:-}" probe_activity_label="${5:-}"
    printf "%s|%s|%s|%s\n" "$excluded_identity" "$switch_reason" "$probe_lock_reason" "$probe_activity_label" >"$recovery_log"
    echo "usable:slot-next"
  }
  ensure_codex_slot_ready_for_manager "'"$PROJECT"'" after_failure >/dev/null
'

grep -q '^slot-current|after_failure_exec_recovery_slot_probe|after_failure_exec_recovery_probe|after-failure codex exec recovery probe$' "$TMP_DIR/recovery.log" || {
  echo "[FAIL] after-failure recovery should use dedicated probe reasons instead of watchdog probe labels" >&2
  cat "$TMP_DIR/recovery.log" >&2
  exit 1
}

echo "[PASS] after-failure recovery uses dedicated probe reasons instead of watchdog probe labels"
