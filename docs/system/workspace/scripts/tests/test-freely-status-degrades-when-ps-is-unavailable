#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-status-ps-degraded.XXXXXX)"
cleanup() {
  set +e
  kill "${SUP_PID:-}" "${DISPATCH_PID:-}" "${AI_PID:-}" 2>/dev/null || true
  wait "${SUP_PID:-}" 2>/dev/null || true
  wait "${DISPATCH_PID:-}" 2>/dev/null || true
  wait "${AI_PID:-}" 2>/dev/null || true
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

PROJECT="$TMP_DIR/repo"
FAKE_BIN_DIR="$TMP_DIR/fake-bin"
mkdir -p "$PROJECT/.freely/run" "$PROJECT/docs/pre-brainstorms" "$FAKE_BIN_DIR"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
AI_REASONING_EFFORT="medium"
EOF
cat >"$PROJECT/.freely/run/session-state.env" <<EOF
LAST_TOOL_SESSION_ID="session-ps-blocked"
LAST_TOOL_JSONL_PATH="$TMP_DIR/session.jsonl"
EOF
cat >"$PROJECT/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="up"
LAST_AI_STATE="up"
LAST_EXIT_REASON="none"
LAST_ROLE_HINT="manager"
LAST_STATE_UPDATED_AT="2026-04-03T22:55:00Z"
EOF
touch "$TMP_DIR/session.jsonl"

bash -c "cd '$PROJECT' && exec -a 'runtime/freely start --project $PROJECT' sleep 30" >/dev/null 2>&1 &
SUP_PID=$!
bash -c "cd '$PROJECT' && exec -a 'runtime/freely ensure-interruption-dispatch --project $PROJECT --watch' sleep 30" >/dev/null 2>&1 &
DISPATCH_PID=$!
bash -c "cd '$PROJECT' && exec -a 'codex exec -C $PROJECT -m gpt-5.4' sleep 30" >/dev/null 2>&1 &
AI_PID=$!

printf '%s' "$SUP_PID" >"$PROJECT/.freely/run/supervisor.pid"
printf '%s' "$DISPATCH_PID" >"$PROJECT/.freely/run/interruption-dispatch.pid"
printf '%s' "$AI_PID" >"$PROJECT/.freely/run/ai.pid"

cat >"$FAKE_BIN_DIR/ps" <<'EOF'
#!/usr/bin/env bash
exit 1
EOF
chmod +x "$FAKE_BIN_DIR/ps"

OUTPUT="$(PATH="$FAKE_BIN_DIR:$PATH" bash "$ROOT_DIR/bin/freely" live-status --project "$PROJECT")"

grep -q 'process_inspection_state: degraded' <<<"$OUTPUT"
grep -q "role=supervisor pid=$SUP_PID command=unavailable://process-inspection-blocked" <<<"$OUTPUT"
grep -q "role=interruption_dispatcher pid=$DISPATCH_PID command=unavailable://process-inspection-blocked" <<<"$OUTPUT"
grep -q "role=ai pid=$AI_PID command=unavailable://process-inspection-blocked" <<<"$OUTPUT"

echo "[PASS] freely live-status degrades process evidence cleanly when ps is unavailable"
