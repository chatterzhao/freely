#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-current-live-apikey.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
HOME_DIR="$TMP_DIR/home"
mkdir -p "$PROJECT/.freely/run" "$PROJECT/.freely/logs" "$HOME_DIR/.codex"

cat >"$HOME_DIR/.codex/auth.json" <<'EOF'
{
  "OPENAI_API_KEY": "sk-live"
}
EOF

bash -lc '
  set -euo pipefail
  export HOME="'"$HOME_DIR"'"
  log_info() { :; }
  log_warn() { :; }
  log_error() { :; }
  source "'"$ROOT_DIR"'/docs/system/workspace/skills/freely-freely-watchdog-control-plane/scripts/availability-watchdog.sh"
  codex_current_slot() { echo ""; }
  codex_current_slot_kind() { echo ""; }
  codex_current_identity_hint() { echo ""; }
  codex_saved_slots_fingerprint() { echo "none"; }
  # Handoff is only emitted when watchdog is recovering from a blocked phase.
  codex_load_availability_state() {
    AVAILABILITY_PHASE="all_unavailable"
    BLOCKED_REASON="all_slots_unavailable"
    PREVIOUS_SLOT="current-live"
    SAVED_SLOTS_FINGERPRINT="none"
    return 0
  }
  codex_inventory_truth() { echo none; }
  codex_cached_slot_status() { echo ""; }
  codex_probe_current_slot_now() { echo usable; }
  manager_bootstrap_handoff_path() { echo "'"$PROJECT"'/.freely/run/bootstrap.env"; }
  codex_write_availability_state() { :; }
  codex_clear_availability_state() { :; }
  wait_for_codex_slot_switch_idle() { return 0; }
  should_defer_all_unavailable_reprobe() { return 1; }
  watchdog_force_reprobe_requested() { return 1; }
  write_manager_bootstrap_handoff() {
    local project="$1" trigger="$2" previous_slot="$3" active_slot="$4"
    printf "PREVIOUS_SLOT=%s\nACTIVE_SLOT=%s\n" "$previous_slot" "$active_slot" >"$(manager_bootstrap_handoff_path "$project")"
  }
  ensure_codex_slot_ready_for_manager "'"$PROJECT"'"
  rg -q "^ACTIVE_SLOT=current-live$" "$(manager_bootstrap_handoff_path "'"$PROJECT"'")"
'

echo "[PASS] manager bootstrap accepts a usable current live apikey auth without saved-slot inventory"
