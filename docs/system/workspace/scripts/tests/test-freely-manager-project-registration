#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-project-registration.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

make_project() {
  local project="$1" branch="${2:-develop}"
  mkdir -p "$project/.freely" "$project/docs/B1-docs/raw-20260320-0018"
  git init -q -b "$branch" "$project"

  cat >"$project/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
  cat >"$project/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
  cat >"$project/docs/LAWS.md" <<'EOF'
# Laws
EOF
  cat >"$project/AGENTS.md" <<'EOF'
# Agents
EOF
  cat >"$project/docs/B1-docs/README.md" <<'EOF'
# README
EOF
  cat >"$project/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
EOF
  cat >"$project/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
  cat >"$project/docs/B1-docs/raw-20260320-0018/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF
  cat >"$project/docs/B1-docs/raw-20260320-0018/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF
  cat >"$project/.freely/config.env" <<EOF
PROJECT_ROOT="$project"
INTENT_FILE="$project/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$project/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
AI_REASONING_EFFORT="medium"
EOF
}

FREELY_HOME="$TMP_DIR/freely-home"
mkdir -p "$FREELY_HOME"

PROJECT_START="$TMP_DIR/project-start"
make_project "$PROJECT_START" develop
PROJECT_START_CANON="$(cd "$PROJECT_START" && pwd -P)"
FAKE_BIN="$TMP_DIR/fake-freely"
cat >"$FAKE_BIN" <<EOF
#!/usr/bin/env bash
set -euo pipefail
RUNTIME_BIN="$ROOT_DIR/bin/freely"
cmd="\${1:-}"
shift || true
case "\$cmd" in
  ensure-interruption-dispatch)
    exit 0
    ;;
  ensure-manager)
    exec bash "\$RUNTIME_BIN" ensure-manager "\$@"
    ;;
  *)
    exec bash "\$RUNTIME_BIN" "\$cmd" "\$@"
    ;;
esac
EOF
chmod +x "$FAKE_BIN"

if FREELY_HOME="$FREELY_HOME" FREELY_INTERRUPTION_DISPATCH_LAUNCH_BIN="$FAKE_BIN" bash "$ROOT_DIR/bin/freely" start --project "$PROJECT_START" >/dev/null 2>&1; then
  echo "[FAIL] expected start fixture to fail before runtime launch because dispatcher never becomes ready" >&2
  exit 1
fi

grep -q "^${PROJECT_START_CANON}[[:space:]]" "$FREELY_HOME/projects.tsv"

PROJECT_ENSURE="$TMP_DIR/project-ensure"
MOCK_BIN="$TMP_DIR/mock-bin"
LAUNCH_LOG="$TMP_DIR/launch.log"
AI_STATE="$TMP_DIR/active-account"
AI_SWITCH_LOG="$TMP_DIR/ai-switch.log"
mkdir -p "$PROJECT_ENSURE/bin" "$PROJECT_ENSURE/.freely/run" "$PROJECT_ENSURE/.freely/logs" "$MOCK_BIN"
make_project "$PROJECT_ENSURE" develop
PROJECT_ENSURE_CANON="$(cd "$PROJECT_ENSURE" && pwd -P)"

cat >"$PROJECT_ENSURE/bin/ai" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

state_file="${AI_SWITCH_STATE:?}"
log_file="${AI_SWITCH_LOG:?}"
printf '%s\n' "$*" >>"$log_file"

cmd=""
for arg in "$@"; do
  case "$arg" in
    switch|whoami|list)
      cmd="$arg"
      break
      ;;
  esac
done

case "$cmd" in
  whoami)
    account="$(cat "$state_file")"
    echo "{\"tool\":\"codex\",\"account\":\"$account\",\"slot\":\"$account\"}"
    ;;
  list)
    echo '{"accounts":["codex-ready@example-com-1"]}'
    ;;
  switch)
    echo '{"switched": true}'
    ;;
esac
EOF
chmod +x "$PROJECT_ENSURE/bin/ai"

cat >"$MOCK_BIN/codex" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
echo "hi"
EOF
cat >"$MOCK_BIN/launch-freely" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${LAUNCH_LOG:?}"
EOF
chmod +x "$MOCK_BIN/codex" "$MOCK_BIN/launch-freely"

printf 'ready@example-com-1' >"$AI_STATE"
rm -f "$FREELY_HOME/projects.tsv"

FREELY_HOME="$FREELY_HOME" \
AI_SWITCH_STATE="$AI_STATE" \
AI_SWITCH_LOG="$AI_SWITCH_LOG" \
LAUNCH_LOG="$LAUNCH_LOG" \
FREELY_ENSURE_MANAGER_LAUNCH_BIN="$MOCK_BIN/launch-freely" \
PATH="$MOCK_BIN:$PATH" \
  bash "$ROOT_DIR/bin/freely" ensure-manager --project "$PROJECT_ENSURE" >/dev/null

grep -q "^${PROJECT_ENSURE_CANON}[[:space:]]" "$FREELY_HOME/projects.tsv"

echo "[PASS] freely start and ensure-manager both register canonical manager projects into the global registry"
