#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-breakglass-hook-completion.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

REPO="$TMP_DIR/repo"
mkdir -p \
  "$REPO/bin" \
  "$REPO/docs/system/workspace/hooks" \
  "$REPO/docs/system/workspace/scripts/quality" \
  "$REPO/docs/system/workspace/scripts/runtime" \
  "$REPO/docs/system/workspace/skills/watchdog-control-plane/scripts"
cd "$REPO"

git init -q -b develop
git config user.name tester
git config user.email tester@example.com
git config core.hooksPath /dev/null

cp -R "$ROOT_DIR/.githooks" "$REPO/.githooks"
cp "$ROOT_DIR/docs/system/workspace/hooks/pre-commit.sh" "$REPO/docs/system/workspace/hooks/pre-commit.sh"
cp "$ROOT_DIR/docs/system/workspace/hooks/pre-merge-commit.sh" "$REPO/docs/system/workspace/hooks/pre-merge-commit.sh"
cp "$ROOT_DIR/docs/system/workspace/scripts/worktree/merge-guarded" "$REPO/bin/merge-guarded"
cp "$ROOT_DIR/bin/governance-promotion-gate" "$REPO/bin/governance-promotion-gate"
cp "$ROOT_DIR/docs/system/workspace/scripts/quality/governance-promotion-gate" "$REPO/docs/system/workspace/scripts/quality/governance-promotion-gate"
cp "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely" "$REPO/docs/system/workspace/scripts/runtime/freely"
cp "$ROOT_DIR/docs/system/workspace/scripts/runtime/session-evidence-resolver.sh" "$REPO/docs/system/workspace/scripts/runtime/session-evidence-resolver.sh"
cp "$ROOT_DIR/docs/system/workspace/scripts/runtime/network-proxy-resolver.sh" "$REPO/docs/system/workspace/scripts/runtime/network-proxy-resolver.sh"
cp "$ROOT_DIR/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh" "$REPO/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"
cp "$ROOT_DIR/docs/system/workspace/scripts/worktree/worktree-common.sh" "$REPO/bin/worktree-common.sh"

chmod +x \
  "$REPO/.githooks/"* \
  "$REPO/bin/merge-guarded" \
  "$REPO/bin/governance-promotion-gate" \
  "$REPO/bin/worktree-common.sh" \
  "$REPO/docs/system/workspace/scripts/quality/governance-promotion-gate" \
  "$REPO/docs/system/workspace/scripts/runtime/freely" \
  "$REPO/docs/system/workspace/scripts/runtime/session-evidence-resolver.sh" \
  "$REPO/docs/system/workspace/scripts/runtime/network-proxy-resolver.sh" \
  "$REPO/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"

echo base > README.md
git add .
git commit -q -m "init"

git checkout -q -b feature/breakglass
printf 'feature-side\n' > CONFLICT.txt
git add CONFLICT.txt
git commit -q -m "feature payload"

git checkout -q develop
printf 'develop-side\n' > CONFLICT.txt
git add CONFLICT.txt
git commit -q -m "develop payload"

git config core.hooksPath .githooks

set +e
git merge --no-commit feature/breakglass >"$TMP_DIR/raw-merge.stdout" 2>"$TMP_DIR/raw-merge.stderr"
merge_rc=$?
set -e
[[ "$merge_rc" -ne 0 ]] || {
  echo "[FAIL] expected merge conflict before guarded completion" >&2
  exit 1
}
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1

printf 'resolved-raw\n' > CONFLICT.txt
git add CONFLICT.txt
if git commit -m "raw merge completion" >"$TMP_DIR/raw-complete.stdout" 2>"$TMP_DIR/raw-complete.stderr"; then
  echo "[FAIL] raw protected-branch merge completion should be blocked by hooks" >&2
  exit 1
fi
cat "$TMP_DIR/raw-complete.stdout" "$TMP_DIR/raw-complete.stderr" | grep -q "raw merge completion"

git merge --abort >/dev/null 2>&1

set +e
./bin/merge-guarded develop feature/breakglass >"$TMP_DIR/guarded-merge.stdout" 2>"$TMP_DIR/guarded-merge.stderr"
guarded_rc=$?
set -e
[[ "$guarded_rc" -ne 0 ]] || {
  echo "[FAIL] merge-guarded should leave conflict state for completion path" >&2
  exit 1
}
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1

printf 'resolved-breakglass\n' > CONFLICT.txt
git add CONFLICT.txt
./bin/merge-guarded complete develop feature/breakglass \
  --break-glass \
  --reason verified_false_negative \
  --blocked-gate pre-merge-commit \
  --evidence-ref docs/epics/sample/issues/sample.md \
  --follow-on-issue I-20260402-0020-A \
  >"$TMP_DIR/complete.stdout" 2>"$TMP_DIR/complete.stderr"

if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  echo "[FAIL] guarded break-glass completion left MERGE_HEAD active" >&2
  exit 1
fi
git log -1 --format=%B HEAD | grep -q '^Freely-Merge-Path: merge-guarded-break-glass$'
git log -1 --format=%B HEAD | grep -q '^Freely-Bypass-Mode: break_glass$'
git log -1 --format=%B HEAD | grep -q '^Freely-Break-Glass-Reason: verified_false_negative$'
git log -1 --format=%B HEAD | grep -q '^Freely-Blocked-Gate: pre-merge-commit$'
git log -1 --format=%B HEAD | grep -q '^Freely-Operation-Scope: merge_completion_only$'
git log -1 --format=%B HEAD | grep -q '^Freely-Evidence-Ref: docs/epics/sample/issues/sample.md$'
git log -1 --format=%B HEAD | grep -q '^Freely-Follow-On-Issue: I-20260402-0020-A$'

echo "[PASS] merge-guarded break-glass completion succeeds only through hook handshake"
