#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-live-status-status-signals.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

REPO="$TMP_DIR/repo"
mkdir -p "$REPO/.freely/run" "$REPO/docs"

cd "$REPO"
git init -q -b develop
git config user.name tester
git config user.email tester@example.com
echo base > README.md
git add README.md
git commit -q -m "init"

cat >"$REPO/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$REPO/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$REPO/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$REPO/.freely/config.env" <<EOF
PROJECT_ROOT="$REPO"
INTENT_FILE="$REPO/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$REPO/docs/CONSTITUTION.md"
LAW_FILE="$REPO/docs/LAWS.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
AI_REASONING_EFFORT="medium"
EOF
cat >"$REPO/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="up"
LAST_AI_STATE="down"
LAST_EXIT_REASON="none"
LAST_ROLE_HINT="manager"
LAST_STATE_UPDATED_AT="2026-04-22T16:00:00Z"
EOF
cat >"$REPO/.freely/run/session-state.env" <<'EOF'
LAST_DELEGATED_CONTINUATION_PENDING_IDS="delegated-a,delegated-b"
LAST_DELEGATED_CONTINUATION_PENDING_COUNT="2"
LAST_DELEGATED_CONTINUATION_CONSUMED_IDS=""
LAST_DELEGATED_CONTINUATION_CONSUMED_AT=""
EOF
cat >"$REPO/.freely/run/intake.pending" <<'EOF'
PENDING_INTAKE_ITEMS="20"
UPDATED_AT="2026-04-22T16:00:00Z"
EOF

source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

count_active_intake_items() {
  echo "[FAIL] live-status should use intake.pending instead of recounting active intake" >&2
  return 99
}

delegated_continuation_ids_for_project() {
  echo "[FAIL] live-status should use session-state delegated continuation ids instead of rescanning history" >&2
  return 99
}

task_source_scan_status_summary_for_project() {
  printf 'none|unavailable|none|none|none\n'
}

blocked_supervision_snapshot_for_project() {
  printf 'none|none|none|none\n'
}

manager_handoff_snapshot_for_project() {
  printf 'none|none|none|none|none|none|none\n'
}

manager_continuity_gap_snapshot_for_project() {
  printf 'none|none|none|none|none|none|none|none\n'
}

develop_push_followthrough_snapshot_for_project() {
  printf 'none|none|none|0|0|none|none|none|none|none|none|none|none\n'
}

OUTPUT="$(cmd_live_status --project "$REPO")"

printf '%s\n' "$OUTPUT" | grep -q 'role_hint: manager'
printf '%s\n' "$OUTPUT" | grep -q 'activity_state: stalled_without_runtime'
printf '%s\n' "$OUTPUT" | grep -q 'intake_active_items: 20'
printf '%s\n' "$OUTPUT" | grep -q 'pending_delegated_continuation_ids: delegated-a,delegated-b'

echo "[PASS] live-status uses lightweight status signals when manager AI is idle"
