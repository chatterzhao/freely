#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-chat-tui.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
FREELY_HOME="$TMP_DIR/freely-home"
CANON_PROJECT=""
DISPATCH_PID=""
HANDLER_FIXTURE="$TMP_DIR/interruption-handler-fixture"
mkdir -p "$PROJECT/docs/B1-docs/raw-20260319-0000"

git init -q -b develop "$PROJECT"
mkdir -p "$PROJECT/.githooks"
cat >"$PROJECT/.githooks/pre-commit" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
chmod +x "$PROJECT/.githooks/pre-commit"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF

cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF

cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF

cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF

cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF

cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260319-0000--sample
EOF

cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF

cat >"$PROJECT/docs/B1-docs/raw-20260319-0000/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF

cat >"$PROJECT/docs/B1-docs/raw-20260319-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$HANDLER_FIXTURE" <<'EOF'
#!/usr/bin/env bash
cat <<'OUT'
DECISION=delegate_general
REACTION=followup
CLASSIFICATION=discovery
WHY=测试使用的通用委派夹具
OUT
EOF
chmod +x "$HANDLER_FIXTURE"

INIT_OUTPUT="$(cd "$PROJECT" && FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" init --intent "$PROJECT/docs/PROJECT_INTENT.md" --constitution "$PROJECT/docs/CONSTITUTION.md" --ai codex:gpt-5.4:auto --accept-default-autonomy 2>&1)"
printf '%s\n' "$INIT_OUTPUT" | grep -q 'activation_consent_status: accepted'
printf '%s\n' "$INIT_OUTPUT" | grep -q 'initialized:'
CANON_PROJECT="$(cd "$PROJECT" && pwd -P)"

DOCTOR_OUTPUT="$(cd "$PROJECT" && FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" doctor 2>&1)"
printf '%s\n' "$DOCTOR_OUTPUT" | grep -q 'doc gate PASS'

STATUS_OUTPUT_BEFORE_START="$(cd "$PROJECT" && FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" baseline-status)"
printf '%s\n' "$STATUS_OUTPUT_BEFORE_START" | grep -q "project: $CANON_PROJECT"

OFFLINE_OUTPUT="$(cd "$PROJECT" && FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" intake chat --author human --channel chat --message "离线收件仍然允许")"
OFFLINE_ID="$(printf '%s\n' "$OFFLINE_OUTPUT" | sed -n 's/^intake_id: //p')"
[[ -n "$OFFLINE_ID" ]] || {
  echo "[FAIL] freely intake chat should still work offline" >&2
  exit 1
}
grep -q '离线收件仍然允许' "$PROJECT/.freely/intake/$OFFLINE_ID/message.txt"

CHAT_OUTPUT="$(cd "$PROJECT" && FREELY_HOME="$FREELY_HOME" FREELY_INTERRUPTION_HANDLER_BIN="$HANDLER_FIXTURE" bash "$ROOT_DIR/bin/freely" chat "你好，Freely")"
CHAT_ID="$(printf '%s\n' "$CHAT_OUTPUT" | sed -n 's/^intake_id: //p')"
[[ -n "$CHAT_ID" ]] || {
  echo "[FAIL] freely chat did not return intake_id" >&2
  exit 1
}
grep -q '你好，Freely' "$PROJECT/.freely/intake/$CHAT_ID/message.txt"
for _ in $(seq 1 10); do
  if [[ -f "$PROJECT/.freely/run/interruption-dispatch.pid" ]]; then
    READY_PID="$(cat "$PROJECT/.freely/run/interruption-dispatch.pid" 2>/dev/null || true)"
    if [[ -n "$READY_PID" ]] && kill -0 "$READY_PID" 2>/dev/null; then
      DISPATCH_PID="$READY_PID"
      break
    fi
  fi
  sleep 1
done
[[ -n "$DISPATCH_PID" ]] || {
  echo "[FAIL] freely chat did not auto-bootstrap interruption dispatcher" >&2
  exit 1
}
trap 'kill "$DISPATCH_PID" 2>/dev/null || true; wait "$DISPATCH_PID" 2>/dev/null || true; rm -rf "$TMP_DIR"' EXIT
for _ in $(seq 1 10); do
  STATUS_CHAT="$(awk -F '\"' '/^STATUS=/{print $2; exit}' "$PROJECT/.freely/intake/$CHAT_ID/meta.env")"
  if [[ "$STATUS_CHAT" == "classified" || "$STATUS_CHAT" == "absorbed" ]]; then
    break
  fi
  sleep 1
done
STATUS_CHAT="$(awk -F '\"' '/^STATUS=/{print $2; exit}' "$PROJECT/.freely/intake/$CHAT_ID/meta.env")"
[[ "$STATUS_CHAT" == "classified" || "$STATUS_CHAT" == "absorbed" ]] || {
  echo "[FAIL] freely chat intake was not claimed after autobootstrap" >&2
  exit 1
}

TUI_OUTPUT="$(cd "$PROJECT" && printf '继续测试中文输入框\n第二行中文\n\n' | FREELY_HOME="$FREELY_HOME" FREELY_INTERRUPTION_HANDLER_BIN="$HANDLER_FIXTURE" bash "$ROOT_DIR/bin/freely" tui --project "$PROJECT" --once)"
printf '%s\n' "$TUI_OUTPUT" | grep -q 'Freely TUI'
printf '%s\n' "$TUI_OUTPUT" | grep -q 'submitted: 继续测试中文输入框'
printf '%s\n' "$TUI_OUTPUT" | grep -q '第二行中文'
TUI_ID="$(printf '%s\n' "$TUI_OUTPUT" | sed -n 's/^intake_id: //p')"
[[ -n "$TUI_ID" ]] || {
  echo "[FAIL] freely tui did not return intake_id" >&2
  exit 1
}
grep -q '第二行中文' "$PROJECT/.freely/intake/$TUI_ID/message.txt"
for _ in $(seq 1 10); do
  STATUS_TUI="$(awk -F '\"' '/^STATUS=/{print $2; exit}' "$PROJECT/.freely/intake/$TUI_ID/meta.env")"
  if [[ "$STATUS_TUI" == "classified" || "$STATUS_TUI" == "absorbed" ]]; then
    break
  fi
  sleep 1
done

STATUS_OUTPUT="$(cd "$PROJECT" && FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" intake status)"
printf '%s\n' "$STATUS_OUTPUT" | grep -q 'active_items: 3'
printf '%s\n' "$STATUS_OUTPUT" | grep -q 'channel=chat'
printf '%s\n' "$STATUS_OUTPUT" | grep -q 'channel=tui'
printf '%s\n' "$STATUS_OUTPUT" | grep -q '继续测试中文输入框'
printf '%s\n' "$STATUS_OUTPUT" | grep -q '离线收件仍然允许'
printf '%s\n' "$STATUS_OUTPUT" | grep -q '你好，Freely'

REGISTRY_STATUS_OUTPUT="$(cd "$TMP_DIR" && FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" intake status)"
printf '%s\n' "$REGISTRY_STATUS_OUTPUT" | grep -q "project: $CANON_PROJECT"
printf '%s\n' "$REGISTRY_STATUS_OUTPUT" | grep -q 'active_items: 3'

echo "[PASS] freely chat and tui auto-bootstrap interruption handling while intake chat remains the offline primitive"
