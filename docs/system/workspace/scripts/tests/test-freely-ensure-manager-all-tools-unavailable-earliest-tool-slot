#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-ensure-manager-earliest-tool-slot.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
HOME="$TMP_DIR/home"
mkdir -p "$PROJECT/docs/B1-docs/raw-20260331-0000" "$PROJECT/.freely/run" "$PROJECT/.freely/logs" "$HOME/.ai-auth"

git init -q -b develop "$PROJECT"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260331-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260331-0000/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260331-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="kiro-cli"
AI_MODEL="auto"
AI_MODE="auto"
AI_REASONING_EFFORT=""
AUTO_SWITCH_TOOL="true"
AUTO_SWITCH_SLOT="true"
AI_FALLBACK_TOOLS="codex,iflow"
EOF

cat >"$PROJECT/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
SUPERVISOR_STATE="down"
AI_STATE="down"
LAST_EXIT_REASON="kiro_monthly_request_limit"
EOF

# shellcheck disable=SC1090
HOME="$HOME" source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

launch_log="$TMP_DIR/launch.log"

valid_supervisor_pid_for_project() { return 1; }
discover_supervisor_pid() { return 0; }
manager_ai_pid_for_project() { return 0; }
manager_supervisor_pid_for_project() { return 0; }
recover_stalled_manager_ai_if_needed() { return 1; }
ensure_codex_slot_ready_for_manager() {
  codex_write_availability_state "$1" "all_unavailable" "all_slots_unavailable" "slot-a" "slot-a" "fp" "" "slot-a" "1893456000"
  return 1
}
tool_binary_available_for_auto_recovery() { return 1; }
manager_runtime_recover_workers_if_needed() { return 0; }
launch_manager_supervisor() {
  printf '%s tool=%s\n' "$1" "$AI_TOOL" >>"$launch_log"
}
log_info() { :; }
log_warn() { :; }
log_error() { :; }

HOME="$HOME" ensure_manager_once "$PROJECT" >/dev/null

grep -q '^AGENT_AI_TOOL="codex"$' "$PROJECT/.freely/config.env" || {
  echo "[FAIL] expected earliest-reset waiting truth to pin codex as the target tool" >&2
  cat "$PROJECT/.freely/config.env" >&2
  exit 1
}
grep -q '^AI_TOOL_ADAPTER="direct"$' "$PROJECT/.freely/config.env" || {
  echo "[FAIL] expected earliest-reset waiting truth to persist the codex default adapter" >&2
  cat "$PROJECT/.freely/config.env" >&2
  exit 1
}
grep -q '^slot-a$' "$HOME/.ai-auth/.codex-current-slot" || {
  echo "[FAIL] expected waiting truth to persist the earliest recovery slot" >&2
  cat "$HOME/.ai-auth/.codex-current-slot" >&2
  exit 1
}
if [[ -s "$launch_log" ]]; then
  echo "[FAIL] expected launch to remain blocked while every tool/slot is unavailable" >&2
  cat "$launch_log" >&2
  exit 1
fi
grep -q 'event=tool_auto_switch_waiting_for_recovery' "$PROJECT/.freely/logs/runtime-events.log" || {
  echo "[FAIL] expected waiting event to be recorded" >&2
  cat "$PROJECT/.freely/logs/runtime-events.log" >&2
  exit 1
}
grep -q 'active_tool=codex' "$PROJECT/.freely/logs/runtime-events.log" || {
  echo "[FAIL] expected waiting event to point at codex" >&2
  cat "$PROJECT/.freely/logs/runtime-events.log" >&2
  exit 1
}
grep -q 'active_slot=slot-a' "$PROJECT/.freely/logs/runtime-events.log" || {
  echo "[FAIL] expected waiting event to preserve the earliest slot" >&2
  cat "$PROJECT/.freely/logs/runtime-events.log" >&2
  exit 1
}
grep -q 'earliest_slot=slot-a' "$PROJECT/.freely/logs/runtime-events.log" || {
  echo "[FAIL] expected waiting event to expose earliest_slot separately" >&2
  cat "$PROJECT/.freely/logs/runtime-events.log" >&2
  exit 1
}

echo "[PASS] ensure-manager pins earliest recovery as tool plus slot when all tools are unavailable"
