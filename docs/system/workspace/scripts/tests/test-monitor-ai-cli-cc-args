#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-monitor-cc-args.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

project_dir="$TMP_DIR/project"
prompt_file="$TMP_DIR/prompt.txt"
pid_file="$TMP_DIR/ai.pid"
log_file="$TMP_DIR/ai.log"
debug_log_file="$TMP_DIR/ai.debug.log"
mock_bin="$TMP_DIR/bin"
project_worktrees_root="${project_dir}-worktrees"
mkdir -p "$mock_bin" "$project_dir"
project_real="$(cd "$project_dir" && pwd -P)"

cat >"$prompt_file" <<'EOF'
test cc prompt
EOF

cat >"$mock_bin/claude" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$@" >"$TMP_DIR/claude.args"
pwd -P >"$TMP_DIR/claude.cwd"
echo "[TEST] mock claude started"
sleep 1
EOF
chmod +x "$mock_bin/claude"

PATH="$mock_bin:$PATH" TMP_DIR="$TMP_DIR" \
bash "$ROOT_DIR/docs/system/workspace/scripts/monitor-ai-cli.sh" \
  --project "$project_dir" \
  --tool cc \
  --model "sonnet" \
  --reasoning-effort "medium" \
  --tool-capabilities "" \
  --tool-policy "" \
  --codex-capability-model "" \
  --codex-capability-sandbox "" \
  --codex-capability-approval-policy "" \
  --codex-capability-cwd-mode "" \
  --debug-log-file "$debug_log_file" \
  --claude-session-id "session-plain-1" \
  --mode auto \
  --prompt-file "$prompt_file" \
  --pid-file "$pid_file" \
  --log-file "$log_file" \
  --launch-kind fresh \
  >/dev/null

grep -q -- '^-p$' "$TMP_DIR/claude.args"
grep -q -- '^--permission-mode$' "$TMP_DIR/claude.args"
grep -q -- '^bypassPermissions$' "$TMP_DIR/claude.args"
grep -q -- '^--add-dir$' "$TMP_DIR/claude.args"
grep -q -- "^$project_worktrees_root$" "$TMP_DIR/claude.args"
grep -q -- '^--model$' "$TMP_DIR/claude.args"
grep -q -- '^sonnet$' "$TMP_DIR/claude.args"
grep -q -- '^--effort$' "$TMP_DIR/claude.args"
grep -q -- '^medium$' "$TMP_DIR/claude.args"
grep -q -- '^--debug-file$' "$TMP_DIR/claude.args"
grep -q "^$debug_log_file$" "$TMP_DIR/claude.args"
grep -q -- '^--session-id$' "$TMP_DIR/claude.args"
grep -q -- '^session-plain-1$' "$TMP_DIR/claude.args"
if grep -q -- '^--append-system-prompt$' "$TMP_DIR/claude.args"; then
  echo "[FAIL] plain cc should not append codex policy prompt" >&2
  exit 1
fi
if grep -q -- '^--resume$' "$TMP_DIR/claude.args"; then
  echo "[FAIL] fresh cc launch should not use --resume" >&2
  exit 1
fi
grep -q '\[TEST\] mock claude started' "$log_file"
grep -q "^$project_real\$" "$TMP_DIR/claude.cwd"

resume_session_id="11111111-2222-4333-8444-555555555555"
PATH="$mock_bin:$PATH" TMP_DIR="$TMP_DIR" \
bash "$ROOT_DIR/docs/system/workspace/scripts/monitor-ai-cli.sh" \
  --project "$project_dir" \
  --tool cc-use-codex-cli \
  --model "" \
  --reasoning-effort "medium" \
  --tool-capabilities "codex-cli" \
  --tool-policy "prefer-codex-for-repo-work" \
  --codex-capability-model "gpt-5.4" \
  --codex-capability-sandbox "workspace-write" \
  --codex-capability-approval-policy "never" \
  --codex-capability-cwd-mode "worktree-required-on-protected-branches" \
  --debug-log-file "$debug_log_file" \
  --claude-session-id "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee" \
  --tool-resume-target "$resume_session_id" \
  --mode auto \
  --prompt-file "$prompt_file" \
  --pid-file "$pid_file" \
  --log-file "$log_file" \
  --launch-kind resume \
  >/dev/null

grep -q -- '^--resume$' "$TMP_DIR/claude.args"
grep -q -- "^$resume_session_id$" "$TMP_DIR/claude.args"
if grep -q -- '^--session-id$' "$TMP_DIR/claude.args"; then
  echo "[FAIL] cc resume should not create a fresh session id" >&2
  exit 1
fi
grep -q -- '^--add-dir$' "$TMP_DIR/claude.args"
grep -q -- "^$project_worktrees_root$" "$TMP_DIR/claude.args"
grep -q -- '^--append-system-prompt$' "$TMP_DIR/claude.args"
grep -q 'codex-cli MCP' "$TMP_DIR/claude.args"
grep -q 'model=gpt-5.4' "$TMP_DIR/claude.args"
grep -q 'sandbox=workspace-write' "$TMP_DIR/claude.args"
grep -q 'approval-policy=never' "$TMP_DIR/claude.args"
grep -q 'cwd policy: worktree-required-on-protected-branches' "$TMP_DIR/claude.args"
grep -q "Allowed sibling worktrees root: $project_worktrees_root" "$TMP_DIR/claude.args"
grep -q "^$project_real\$" "$TMP_DIR/claude.cwd"

echo "[PASS] monitor launches cc fresh sessions with session-id and cc resume with explicit --resume continuity"
