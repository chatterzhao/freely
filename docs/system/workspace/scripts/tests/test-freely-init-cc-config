#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-init-cc-config.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

make_project() {
  local project="$1"
  mkdir -p "$project/docs/B1-docs/raw-20260320-0018"
  git init -q -b develop "$project"
  mkdir -p "$project/.githooks"
  cat >"$project/.githooks/pre-commit" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
  chmod +x "$project/.githooks/pre-commit"

  cat >"$project/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF

  cat >"$project/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF

  cat >"$project/docs/LAWS.md" <<'EOF'
# Laws
EOF

  cat >"$project/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF

  cat >"$project/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260320-0018--sample
EOF

  cat >"$project/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF

  cat >"$project/docs/B1-docs/raw-20260320-0018/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF

  cat >"$project/docs/B1-docs/raw-20260320-0018/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF
}

FREELY_HOME="$TMP_DIR/freely-home"

PROJECT_CC="$TMP_DIR/project-cc"
PROJECT_CC_WORKTREES_ROOT="${PROJECT_CC}-worktrees"
make_project "$PROJECT_CC"
cd "$PROJECT_CC"
FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" init \
  --project "$PROJECT_CC" \
  --intent "$PROJECT_CC/docs/PROJECT_INTENT.md" \
  --constitution "$PROJECT_CC/docs/CONSTITUTION.md" \
  --ai cc:auto \
  --accept-default-autonomy \
  >/dev/null

CONFIG_FILE="$PROJECT_CC/.freely/config.env"
test -f "$PROJECT_CC/AGENTS.md"
grep -q '^# Project Agent Entry$' "$PROJECT_CC/AGENTS.md"
grep -q '^AGENT_AI_TOOL="cc"$' "$CONFIG_FILE"
grep -q '^AI_MODE="auto"$' "$CONFIG_FILE"
grep -q '^AI_REASONING_EFFORT="medium"$' "$CONFIG_FILE"
grep -q '^AI_TOOL_ADAPTER="direct"$' "$CONFIG_FILE"
grep -q '^AI_TOOL_ADAPTER_POLICY="direct"$' "$CONFIG_FILE"
grep -q '^AI_TOOL_CAPABILITIES=""$' "$CONFIG_FILE"
grep -q '^AI_TOOL_POLICY=""$' "$CONFIG_FILE"
grep -q '^AI_CAPABILITY_CODEX_MODEL=""$' "$CONFIG_FILE"
grep -q '^AI_CAPABILITY_CODEX_SANDBOX=""$' "$CONFIG_FILE"
grep -q '^AI_CAPABILITY_CODEX_APPROVAL_POLICY=""$' "$CONFIG_FILE"
grep -q '^AI_CAPABILITY_CODEX_CWD_MODE=""$' "$CONFIG_FILE"
grep -q '^FREELY_NETWORK_PROXY_MODE="inherit"$' "$CONFIG_FILE"
grep -q '^FREELY_NETWORK_PROXY_URL=""$' "$CONFIG_FILE"
grep -q '^FREELY_ALL_PROXY=""$' "$CONFIG_FILE"
grep -q '^FREELY_HTTP_PROXY=""$' "$CONFIG_FILE"
grep -q '^FREELY_HTTPS_PROXY=""$' "$CONFIG_FILE"
grep -q '^FREELY_NO_PROXY=""$' "$CONFIG_FILE"
grep -Fq -- "--add-dir \"$PROJECT_CC_WORKTREES_ROOT\"" "$PROJECT_CC/.freely/bin/claude"
grep -Fq "\`$PROJECT_CC_WORKTREES_ROOT\`" "$PROJECT_CC/.freely/tool-boundary-bootstrap.md"

STATUS_OUTPUT="$(FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" status)"
printf '%s\n' "$STATUS_OUTPUT" | grep -q '^ai: cc:default:auto$'
printf '%s\n' "$STATUS_OUTPUT" | grep -q '^tool_adapter: direct$'
printf '%s\n' "$STATUS_OUTPUT" | grep -q '^tool_adapter_policy: direct$'
printf '%s\n' "$STATUS_OUTPUT" | grep -q '^tool_supported_adapters: direct$'
printf '%s\n' "$STATUS_OUTPUT" | grep -q '^tool_capabilities: none$'
printf '%s\n' "$STATUS_OUTPUT" | grep -q '^tool_policy: none$'

PROJECT_CC_ACP="$TMP_DIR/project-cc-acp"
PROJECT_CC_ACP_WORKTREES_ROOT="${PROJECT_CC_ACP}-worktrees"
make_project "$PROJECT_CC_ACP"
cd "$PROJECT_CC_ACP"
FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" init \
  --project "$PROJECT_CC_ACP" \
  --intent "$PROJECT_CC_ACP/docs/PROJECT_INTENT.md" \
  --constitution "$PROJECT_CC_ACP/docs/CONSTITUTION.md" \
  --ai cc:auto \
  --tool-adapter acp \
  --accept-default-autonomy \
  >/dev/null

CONFIG_FILE_ACP="$PROJECT_CC_ACP/.freely/config.env"
grep -q '^AGENT_AI_TOOL="cc"$' "$CONFIG_FILE_ACP"
grep -q '^AI_TOOL_ADAPTER="acp"$' "$CONFIG_FILE_ACP"
grep -q '^AI_TOOL_ADAPTER_POLICY="acp"$' "$CONFIG_FILE_ACP"

STATUS_OUTPUT_ACP="$(FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" status)"
printf '%s\n' "$STATUS_OUTPUT_ACP" | grep -q '^ai: cc:default:auto$'
printf '%s\n' "$STATUS_OUTPUT_ACP" | grep -q '^tool_adapter: acp$'
printf '%s\n' "$STATUS_OUTPUT_ACP" | grep -q '^tool_adapter_policy: acp$'
printf '%s\n' "$STATUS_OUTPUT_ACP" | grep -q '^tool_supported_adapters: direct$'
grep -Fq -- "--add-dir \"$PROJECT_CC_ACP_WORKTREES_ROOT\"" "$PROJECT_CC_ACP/.freely/bin/claude"

PROJECT_CC_CODEX="$TMP_DIR/project-cc-codex"
PROJECT_CC_CODEX_WORKTREES_ROOT="${PROJECT_CC_CODEX}-worktrees"
make_project "$PROJECT_CC_CODEX"
cd "$PROJECT_CC_CODEX"
FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" init \
  --project "$PROJECT_CC_CODEX" \
  --intent "$PROJECT_CC_CODEX/docs/PROJECT_INTENT.md" \
  --constitution "$PROJECT_CC_CODEX/docs/CONSTITUTION.md" \
  --ai cc-use-codex-cli:auto \
  --accept-default-autonomy \
  >/dev/null

CONFIG_FILE_CODEX="$PROJECT_CC_CODEX/.freely/config.env"
CODEX_CONFIG_FILE="$PROJECT_CC_CODEX/.codex/config.toml"
grep -q '^AGENT_AI_TOOL="cc-use-codex-cli"$' "$CONFIG_FILE_CODEX"
grep -q '^AI_MODE="auto"$' "$CONFIG_FILE_CODEX"
grep -q '^AI_REASONING_EFFORT="medium"$' "$CONFIG_FILE_CODEX"
grep -q '^AI_TOOL_ADAPTER="direct"$' "$CONFIG_FILE_CODEX"
grep -q '^AI_TOOL_ADAPTER_POLICY="direct"$' "$CONFIG_FILE_CODEX"
grep -q '^AI_TOOL_CAPABILITIES="codex-cli"$' "$CONFIG_FILE_CODEX"
grep -q '^AI_TOOL_POLICY="prefer-codex-for-repo-work"$' "$CONFIG_FILE_CODEX"
grep -q '^AI_CAPABILITY_CODEX_MODEL="gpt-5.4"$' "$CONFIG_FILE_CODEX"
grep -q '^AI_CAPABILITY_CODEX_SANDBOX="workspace-write"$' "$CONFIG_FILE_CODEX"
grep -q '^AI_CAPABILITY_CODEX_APPROVAL_POLICY="never"$' "$CONFIG_FILE_CODEX"
grep -q '^AI_CAPABILITY_CODEX_CWD_MODE="worktree-required-on-protected-branches"$' "$CONFIG_FILE_CODEX"
grep -q '^FREELY_NETWORK_PROXY_MODE="inherit"$' "$CONFIG_FILE_CODEX"
grep -q '^FREELY_NETWORK_PROXY_URL=""$' "$CONFIG_FILE_CODEX"
grep -q '^FREELY_ALL_PROXY=""$' "$CONFIG_FILE_CODEX"
grep -q '^FREELY_HTTP_PROXY=""$' "$CONFIG_FILE_CODEX"
grep -q '^FREELY_HTTPS_PROXY=""$' "$CONFIG_FILE_CODEX"
grep -q '^FREELY_NO_PROXY=""$' "$CONFIG_FILE_CODEX"
test -f "$CODEX_CONFIG_FILE"
grep -q '^approval_policy = "never"$' "$CODEX_CONFIG_FILE"
grep -Fq "writable_roots = [\"$PROJECT_CC_CODEX-worktrees\"]" "$CODEX_CONFIG_FILE"
grep -Fq -- "--add-dir \"$PROJECT_CC_CODEX_WORKTREES_ROOT\"" "$PROJECT_CC_CODEX/.freely/bin/codex"
grep -Fq -- "--add-dir \"$PROJECT_CC_CODEX_WORKTREES_ROOT\"" "$PROJECT_CC_CODEX/.freely/bin/claude"
grep -Fq -- "--add-dir \"$PROJECT_CC_CODEX_WORKTREES_ROOT\"" "$PROJECT_CC_CODEX/.freely/bin/iflow"

STATUS_OUTPUT_CODEX="$(FREELY_HOME="$FREELY_HOME" bash "$ROOT_DIR/bin/freely" status)"
printf '%s\n' "$STATUS_OUTPUT_CODEX" | grep -q '^ai: cc-use-codex-cli:default:auto$'
printf '%s\n' "$STATUS_OUTPUT_CODEX" | grep -q '^tool_adapter_policy: direct$'
printf '%s\n' "$STATUS_OUTPUT_CODEX" | grep -q '^tool_supported_adapters: direct$'
printf '%s\n' "$STATUS_OUTPUT_CODEX" | grep -q '^tool_capabilities: codex-cli$'
printf '%s\n' "$STATUS_OUTPUT_CODEX" | grep -q '^tool_policy: prefer-codex-for-repo-work$'
printf '%s\n' "$STATUS_OUTPUT_CODEX" | grep -q '^codex_capability_model: gpt-5.4$'
printf '%s\n' "$STATUS_OUTPUT_CODEX" | grep -q '^codex_capability_sandbox: workspace-write$'
printf '%s\n' "$STATUS_OUTPUT_CODEX" | grep -q '^codex_capability_approval_policy: never$'
printf '%s\n' "$STATUS_OUTPUT_CODEX" | grep -q '^codex_capability_cwd_mode: worktree-required-on-protected-branches$'

echo "[PASS] freely init writes separate plain-cc and cc-use-codex-cli profiles"
