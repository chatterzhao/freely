cat >"$PROJECT/.freely/run/session-handoff.txt" <<EOF
# Session Handoff

- rotation_reason: worker_exit_contract_repair
- previous_launch_kind: resume
- previous_tool_resume_target: worker-repair-demo
- worktree_path: $PROJECT

## Repair Contract
- reason: worker_exit_contract_invalid
- contract_file: $PROJECT/.freely/run/worker-exit-contract.env
- details: missing_file

## What To Handle First
- Stay inside the current worker issue boundary.
- Reuse the same worker context and produce a valid worker exit contract before claiming completion or requesting reschedule.
- The missing/invalid contract is the blocking defect from the previous round.
EOF

PROMPT_OUTPUT="$(
  PROJECT_ROOT="$PROJECT" \
  INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md" \
  CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md" \
  AI_TOOL="codex" \
  AI_MODEL="gpt-5.4" \
  AI_MODE="auto" \
  AI_REASONING_EFFORT="medium" \
  bash -lc '
    source "$1"
    build_prompt
  ' _ "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"
)"

printf '%s\n' "$PROMPT_OUTPUT" | grep -q '^Repair-first override:$'
printf '%s\n' "$PROMPT_OUTPUT" | grep -q 'worker exit contract repair'
printf '%s\n' "$PROMPT_OUTPUT" | grep -q "$PROJECT/.freely/run/worker-exit-contract.env"

python3 - <<'PY' "$TMP_DIR/prompt.txt" "$PROMPT_OUTPUT"
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
prompt = sys.argv[2]
path.write_text(prompt, encoding="utf-8")
repair_idx = prompt.find("Repair-first override:")
lead_idx = prompt.find("你现在进入 Freely 的首跳闭环。")
if repair_idx == -1 or lead_idx == -1 or repair_idx > lead_idx:
    raise SystemExit(1)
PY

echo "[PASS] worker repair prompt prioritizes exit-contract recovery before broad lead-agent context"
