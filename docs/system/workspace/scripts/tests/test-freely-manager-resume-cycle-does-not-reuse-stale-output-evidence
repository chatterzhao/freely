#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-resume-stale-evidence.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
mkdir -p "$PROJECT/.freely/run" "$PROJECT/.freely/logs"
git init -q -b develop "$PROJECT"
git -C "$PROJECT" config user.name tester
git -C "$PROJECT" config user.email tester@example.com

cat >"$PROJECT/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="up"
LAST_AI_STATE="down"
LAST_EXIT_REASON="ai_exit_rc_0"
LAST_ROLE_HINT="manager"
LAST_STATE_UPDATED_AT="2026-04-25T20:14:44Z"
EOF

JSONL="$PROJECT/.freely/run/resume-session.jsonl"
cat >"$JSONL" <<'EOF'
{"timestamp":"2026-04-25T20:11:02.000Z","type":"session_meta","payload":{"id":"sess-resume"}}
{"timestamp":"2026-04-25T20:11:04.000Z","type":"response_item","payload":{"type":"message","role":"assistant","content":[{"type":"output_text","text":"old output"}]}}
{"timestamp":"2026-04-25T20:11:05.000Z","type":"event_msg","payload":{"type":"task_complete"}}
EOF

PROMPT_FILE="$PROJECT/.freely/run/prompt-resume.txt"
cat >"$PROMPT_FILE" <<'EOF'
resume prompt
EOF
touch -t 202604252014 "$PROMPT_FILE"

cat >"$PROJECT/.freely/run/session-state.env" <<EOF
LAST_TOOL_SESSION_ID="sess-resume"
LAST_TOOL_RESUME_TARGET="sess-resume"
LAST_TOOL_JSONL_PATH="$JSONL"
LAST_LAUNCH_KIND="resume"
LAST_ROTATION_REASON="none"
LAST_CYCLE_LOG=""
LAST_PROMPT_FILE="$PROMPT_FILE"
LAST_CONTEXT_COMPACTED="0"
LAST_CONTEXT_RATIO=""
LAST_PRIMARY_RATE_LIMIT_USED_PERCENT=""
LAST_PRIMARY_RATE_LIMIT_RESETS_AT=""
LAST_SECONDARY_RATE_LIMIT_USED_PERCENT=""
LAST_SECONDARY_RATE_LIMIT_RESETS_AT=""
LAST_ROUTE_ONLY_HANDOFF="0"
ROUTE_ONLY_STREAK_CURRENT="0"
RESUME_STREAK_CURRENT="1"
CURRENT_TOOL_SLOT=""
LAST_SLOT_SWITCH_REASON=""
LAST_SLOT_SWITCH_AT=""
LAST_CYCLE_DEBUG_LOG=""
LAST_CLAUDE_JSONL_PATH=""
LAST_CODEX_MCP_USED="0"
LAST_CODEX_MCP_THREAD_ID=""
LAST_CODEX_MCP_JSONL_PATH=""
CLAUDE_SESSION_ID_CURRENT=""
CLAUDE_SESSION_ID_PREVIOUS=""
LAST_PROJECT_DIRTY_ENTRIES="0"
LAST_WORKTREE_SUMMARY_TOTAL="1"
LAST_WORKTREE_SUMMARY_DIRTY="0"
CHECKPOINT_DRIFT_STREAK_CURRENT="0"
LAST_DELEGATED_CONTINUATION_PENDING_IDS=""
LAST_DELEGATED_CONTINUATION_PENDING_COUNT="0"
LAST_DELEGATED_CONTINUATION_CONSUMED_IDS=""
LAST_DELEGATED_CONTINUATION_CONSUMED_AT=""
LAST_RESTART_STORM_WINDOW_SECS="0"
LAST_RESTART_STORM_COUNT="0"
LAST_PROCESS_CHURN_PEAK="0"
LAST_RESTART_STORM_SIGNAL_AT=""
LAST_RESTART_STORM_SIGNAL_REASON=""
LAST_RESTART_STORM_ESCALATED_AT=""
LAST_RESTART_STORM_ESCALATION_TARGET=""
AUTO_RECOVERY_ATTEMPTED_TOOLS_CSV=""
EOF

cat >"$PROJECT/.freely/config.env" <<'EOF'
PROJECT_ROOT=""
AGENT_AI_TOOL="codex"
EOF

cat >"$PROJECT/.freely/run/manager-continuity-20260425-201013.md" <<'EOF'
# Manager Continuity

## Primary Judgement

- route_kind: `unknown`
- restart_point: `resume from authoritative manager continuity manager-continuity-20260425-201013.md`
- ownership: `manager`
- next_action: `manager should enrich or replace this stub with the real startup continuity before delegation or merge judgement`
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

ACTION="$(manager_runtime_handle_exit_contract_after_ai_cycle "$PROJECT" "ai_exit_rc_0")"
[[ "$ACTION" == "resume_invalid" ]] || {
  echo "[FAIL] expected stale resume evidence to force resume_invalid, got $ACTION" >&2
  exit 1
}

if [[ -f "$PROJECT/.freely/run/manager-exit-contract.env" ]]; then
  echo "[FAIL] stale resume evidence should not autofill manager exit contract" >&2
  exit 1
fi

grep -q '^LAST_EXIT_REASON="manager_empty_success_cycle"$' "$PROJECT/.freely/run/workcell-state.env"
grep -q 'manager_empty_success_cycle_detected' "$PROJECT/.freely/logs/runtime-events.log"
if grep -q 'manager_exit_contract_autofilled_continuity_resume' "$PROJECT/.freely/logs/runtime-events.log"; then
  echo "[FAIL] stale resume evidence must not trigger continuity resume autofill" >&2
  exit 1
fi
grep -q 'rotation_reason: manager_exit_contract_repair' "$PROJECT/.freely/run/session-handoff.txt"
grep -q 'reason: manager_empty_success_cycle' "$PROJECT/.freely/run/session-handoff.txt"

echo "[PASS] resume cycle ignores stale historical output evidence from reused session jsonl"
