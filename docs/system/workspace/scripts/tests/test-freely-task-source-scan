cat >"$TMP_DIR/gitee-server.py" <<'EOF'
import json
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

meta_path, log_path = sys.argv[1], sys.argv[2]
requests = []

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        requests.append({"method": self.command, "path": self.path})
        with open(log_path, "w", encoding="utf-8") as handle:
            json.dump(requests, handle, ensure_ascii=False, indent=2)
        payload = [
            {
                "number": 201,
                "title": "Raw gitee external issue",
                "html_url": "https://gitee.com/zhaoquan/freely/issues/201",
                "labels": [{"name": "triaged"}],
                "created_at": "2026-04-20T00:00:00Z",
                "updated_at": "2026-04-20T01:00:00Z"
            },
            {
                "number": 202,
                "title": "Linked gitee external issue still open",
                "html_url": "https://gitee.com/zhaoquan/freely/issues/202",
                "labels": [{"name": "in-progress"}],
                "created_at": "2026-04-20T00:00:00Z",
                "updated_at": "2026-04-20T01:00:00Z"
            }
        ]
        encoded = json.dumps(payload).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(encoded)))
        self.end_headers()
        self.wfile.write(encoded)

    def log_message(self, fmt, *args):
        return

server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
with open(meta_path, "w", encoding="utf-8") as handle:
    json.dump({"port": server.server_address[1]}, handle)
server.serve_forever()
EOF

python3 "$TMP_DIR/gitee-server.py" "$GITEE_META" "$GITEE_LOG" &
GITEE_SERVER_PID=$!
for _ in $(seq 1 50); do
  [[ -f "$GITEE_META" ]] && break
  sleep 0.1
done
[[ -f "$GITEE_META" ]]
GITEE_PORT="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["port"])' "$GITEE_META")"

OUTPUT_JSON="$TMP_DIR/task-source-scan.json"
PATH="$FAKE_BIN_DIR:$PATH" \
FREELY_TASK_SOURCE_SCAN_GITHUB_REPO="example/freely-demo" \
GITEE_API_BASE="http://127.0.0.1:$GITEE_PORT/api/v5" \
GITEE_ACCESS_TOKEN="demo-token" \
bash "$ROOT_DIR/bin/freely" task-source-scan --project "$PROJECT" --json >"$OUTPUT_JSON"

python3 - <<'PY' "$OUTPUT_JSON"
import json
import pathlib
import sys

payload = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
assert payload["recommended_skill"] == "freely-auto-loop-orchestrator"
assert payload["routing_skill"] == "freely-context-source-skill"

sources = payload["sources"]

def one(source_type):
    matches = [entry for entry in sources if entry["source_type"] == source_type]
    assert matches, f"missing {source_type}"
    return matches[0]

intake = one("intake_item")
assert intake["source_family"] == "human interruption"
assert intake["restart_point"] == "pre_brainstorm"

candidate = one("candidate_packet")
assert candidate["source_family"] == "pre-brainstorm"
assert candidate["status_markers"]["candidate_status"] == "needs_research"
assert candidate["status_markers"]["candidate_id"] == "C-20260420-0001-A"
assert not any(
    entry["source_type"] == "candidate_packet"
    and entry["status_markers"]["candidate_status"] in {"dropped", "absorbed"}
    for entry in sources
), sources

milestone = one("milestone_queue_item")
assert milestone["source_family"] == "milestone"
assert milestone["restart_point"] == "continuation"

progress = one("progress_item")
assert progress["source_family"] == "progress"
assert progress["restart_point"] == "verification"
assert progress["source_ref"] == "docs/progress/demo/p-demo.md"
ready_followthrough = [
    entry for entry in sources
    if entry["source_type"] == "progress_item"
    and entry["source_ref"] == "docs/progress/demo/p-ready-followthrough.md"
]
assert ready_followthrough, sources
assert not any(
    entry["source_type"] == "progress_item"
    and entry["source_ref"] == "docs/progress/demo/p-contract-frozen.md"
    for entry in sources
), sources

raw_issue = one("github_raw_issue")
assert raw_issue["source_family"] == "external issue"
assert raw_issue["restart_point"] == "pre_brainstorm"
assert raw_issue["status_markers"]["canonical_linkage"] == "missing"

linked_issue = one("github_linked_open_issue")
assert linked_issue["restart_point"] == "cleanup"
assert linked_issue["status_markers"]["canonical_linkage"] == "present"
assert "docs/progress/demo/p-demo.md" in linked_issue["linked_paths"]

gitee_raw_issue = one("gitee_raw_issue")
assert gitee_raw_issue["source_family"] == "external issue"
assert gitee_raw_issue["restart_point"] == "pre_brainstorm"
assert gitee_raw_issue["status_markers"]["canonical_linkage"] == "missing"

gitee_linked_issue = one("gitee_linked_open_issue")
assert gitee_linked_issue["restart_point"] == "cleanup"
assert gitee_linked_issue["status_markers"]["canonical_linkage"] == "present"
assert "docs/progress/demo/p-demo.md" in gitee_linked_issue["linked_paths"]

assert payload["providers"]["external_issue"]["github"]["enabled"] is True
assert payload["providers"]["external_issue"]["gitee"]["enabled"] is True
assert payload["providers"]["external_issue"]["github"]["availability_hint"] is None
assert payload["providers"]["external_issue"]["gitee"]["availability_hint"] is None
assert payload["summary"]["actionable_count"] == 9
PY

LATEST_SCAN="$PROJECT/.freely/run/task-source-scan/latest.json"
test -f "$LATEST_SCAN"

echo "[PASS] freely task-source-scan reports interruption, pre-brainstorm, milestone/progress, and dual-platform external issue sources"
