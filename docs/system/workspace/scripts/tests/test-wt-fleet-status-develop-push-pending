#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/wt-fleet-status-develop-push.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

REPO="$TMP_DIR/repo"
WT_ROOT="$TMP_DIR/repo-worktrees"
REMOTE="$TMP_DIR/remote.git"

mkdir -p "$REPO" "$WT_ROOT"
git init -q -b develop "$REPO"
git -C "$REPO" config user.name tester
git -C "$REPO" config user.email tester@example.com

echo base >"$REPO/README.md"
git -C "$REPO" add README.md
git -C "$REPO" commit -q -m "init"
git init -q --bare "$REMOTE"
git -C "$REPO" remote add origin "$REMOTE"
git -C "$REPO" push -q -u origin develop

mkdir -p "$REPO/bin" "$REPO/.freely/run"
cp "$ROOT_DIR/bin/checkpoint-guard" "$REPO/bin/checkpoint-guard"
chmod +x "$REPO/bin/checkpoint-guard"

git -C "$REPO" worktree add -q -b feature/demo "$WT_ROOT/feature-demo" develop

echo local >"$REPO/local.txt"
git -C "$REPO" add local.txt
git -C "$REPO" commit -q -m "local merge result"

OUTPUT="$(bash "$ROOT_DIR/bin/wt-fleet-status" --project "$REPO")"
printf '%s\n' "$OUTPUT" | grep -q 'PUSH'
printf '%s\n' "$OUTPUT" | grep -q 'push_pending'
printf '%s\n' "$OUTPUT" | grep -q 'develop_push'
printf '%s\n' "$OUTPUT" | grep -q 'feature/demo'

echo "[PASS] wt-fleet-status surfaces develop push followthrough summary"
