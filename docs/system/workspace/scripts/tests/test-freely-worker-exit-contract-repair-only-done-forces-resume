#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-worker-repair-only-done.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
WORKER="$TMP_DIR/project-worktrees/feature-cleanup"
mkdir -p "$PROJECT/.freely/run/worker-prompts" "$PROJECT/.freely/logs" "$WORKER"

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

cat >"$PROJECT/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="up"
LAST_AI_STATE="down"
LAST_EXIT_REASON="ai_exit_rc_0"
LAST_ROLE_HINT="worker"
LAST_STATE_UPDATED_AT="2026-04-24T09:30:42Z"
EOF

cat >"$PROJECT/.freely/run/session-state.env" <<'EOF'
LAST_TOOL_SESSION_ID="sess-demo"
LAST_TOOL_RESUME_TARGET="worker-cleanup-repair-demo"
LAST_TOOL_JSONL_PATH=""
LAST_LAUNCH_KIND="resume"
LAST_ROTATION_REASON="none"
LAST_CYCLE_LOG=""
LAST_PROMPT_FILE=""
LAST_CONTEXT_COMPACTED="0"
LAST_CONTEXT_RATIO=""
LAST_PRIMARY_RATE_LIMIT_USED_PERCENT=""
LAST_PRIMARY_RATE_LIMIT_RESETS_AT=""
LAST_SECONDARY_RATE_LIMIT_USED_PERCENT=""
LAST_SECONDARY_RATE_LIMIT_RESETS_AT=""
LAST_ROUTE_ONLY_HANDOFF="0"
ROUTE_ONLY_STREAK_CURRENT="0"
RESUME_STREAK_CURRENT="1"
CURRENT_TOOL_SLOT=""
LAST_SLOT_SWITCH_REASON=""
LAST_SLOT_SWITCH_AT=""
LAST_CYCLE_DEBUG_LOG=""
LAST_CLAUDE_JSONL_PATH=""
LAST_CODEX_MCP_USED="0"
LAST_CODEX_MCP_THREAD_ID=""
LAST_CODEX_MCP_JSONL_PATH=""
CLAUDE_SESSION_ID_CURRENT=""
CLAUDE_SESSION_ID_PREVIOUS=""
LAST_PROJECT_DIRTY_ENTRIES="0"
LAST_WORKTREE_SUMMARY_TOTAL="1"
LAST_WORKTREE_SUMMARY_DIRTY="0"
CHECKPOINT_DRIFT_STREAK_CURRENT="0"
LAST_DELEGATED_CONTINUATION_PENDING_IDS=""
LAST_DELEGATED_CONTINUATION_PENDING_COUNT="0"
LAST_DELEGATED_CONTINUATION_CONSUMED_IDS=""
LAST_DELEGATED_CONTINUATION_CONSUMED_AT=""
LAST_RESTART_STORM_WINDOW_SECS="0"
LAST_RESTART_STORM_COUNT="0"
LAST_PROCESS_CHURN_PEAK="0"
LAST_RESTART_STORM_SIGNAL_AT=""
LAST_RESTART_STORM_SIGNAL_REASON=""
LAST_RESTART_STORM_ESCALATED_AT=""
LAST_RESTART_STORM_ESCALATION_TARGET=""
AUTO_RECOVERY_ATTEMPTED_TOOLS_CSV=""
EOF

PROMPT="$PROJECT/.freely/run/worker-prompts/20260424-031000-worker-cleanup-closeout-codex.txt"
cat >"$PROMPT" <<EOF
Worktree:
- \`$WORKER\`
Branch:
- \`feature/cleanup-closeout-20260424\`
dispatch_priority: P0
parallel_safe: false
write_scope:
- \`$WORKER\`
intent_kind: cleanup
intent_target: \`$WORKER\`
Owner-Issue:
- \`I-20260424-0310-A\`
Pre-Tests-Path:
- \`docs/B2-docs/sample/story/pre-tests.md\`
Verification-Artifact-Dir:
- \`docs/B2-docs/sample/story/code-reviews\`
Required-Test-Lanes:
- \`feature-local\`
- \`premerge-integration\`
Required-Acceptance-Item-Ids:
- \`cleanup-boundary\`
Minimum-Evidence-Level:
- \`cleanup-blocker-or-bounded-closeout-artifact\`
Target-Environment:
- \`feature/cleanup-closeout-20260424\`
Closeout-Gate:
- \`classify the lane as exactly one of atomic_checkpoint_ready, split_required_with_target, retire_only_ready, or blocked_need_manager_decision\`
Closeout-Gate-Command:
- \`./bin/checkpoint-guard && ./bin/freely baseline-status --project $WORKER && git status --short\`
Closeout-Target-Lane:
- \`cleanup_governance\`
Closeout-Promotion-Gate:
- \`manager_cleanup_replay\`
Closeout-Requires-Adequacy:
- \`true\`
Closeout-Review-Artifact-Policy:
- \`write or update one cleanup blocker/handoff artifact under the owner verification artifact directory and cite exact residue paths\`
EOF

cat >"$PROJECT/.freely/run/session-handoff.txt" <<EOF
# Session Handoff

- rotation_reason: worker_exit_contract_repair
- previous_launch_kind: resume
- previous_tool_resume_target: worker-cleanup-repair-demo
- worktree_path: $PROJECT
EOF

cat >"$PROJECT/.freely/run/worker-exit-contract.env" <<EOF
EXIT_KIND="worker_done"
COMPLETION_SUMMARY="Repaired the missing worker exit contract for the resumed cleanup lane using the current session handoff evidence; no additional cleanup work was performed in this repair-first round."
EVIDENCE_PATHS_CSV="$PROJECT/.freely/run/session-handoff.txt,$PROJECT/.freely/run/worker-exit-contract.env"
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

write_worker_verification_contract_file "$(worker_verification_contract_state_file "$PROJECT")" "$PROMPT" "" "$WORKER"

ACTION="$(worker_runtime_handle_exit_contract_after_ai_cycle "$PROJECT" "ai_exit_rc_0")"
[[ "$ACTION" == "resume_invalid" ]]
grep -q '^LAST_EXIT_REASON="worker_exit_contract_invalid"$' "$PROJECT/.freely/run/workcell-state.env"
grep -q 'worker_exit_contract_repair_done_without_bounded_cleanup' "$PROJECT/.freely/run/session-handoff.txt"
grep -q '^## Cleanup Reentry Requirement$' "$PROJECT/.freely/run/session-handoff.txt"

echo "[PASS] repair-only cleanup worker_done is rejected and forced back into bounded reentry"
