#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-watchdog-live.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
mkdir -p \
  "$PROJECT/docs/B1-docs/raw-20260309-0000" \
  "$PROJECT/.freely/run" \
  "$PROJECT/.freely/logs"

cd "$PROJECT"
git init -q -b develop
git config user.name tester
git config user.email tester@example.com
echo base > README.md
git add README.md
git commit -q -m "init"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF

cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF

cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF

cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF

cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF

cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260309-0000--sample
EOF

cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF

cat >"$PROJECT/docs/B1-docs/raw-20260309-0000/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF

cat >"$PROJECT/docs/B1-docs/raw-20260309-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="test-sleep"
AI_MODEL=""
AI_MODE="auto"
AI_REASONING_EFFORT=""
CHECK_INTERVAL=1
RESTART_DELAY=1
MAX_RESTARTS=0
IFLOW_MAX_TURNS=100
EOF

bash "$ROOT_DIR/bin/freely" start --project "$PROJECT" >/dev/null 2>&1 &
supervisor_pid=$!

for _ in $(seq 1 10); do
  if [[ -f "$PROJECT/.freely/run/ai.pid" && -f "$PROJECT/.freely/run/ensure-manager.pid" ]]; then
    break
  fi
  sleep 1
done

ai_pid="$(cat "$PROJECT/.freely/run/ai.pid" 2>/dev/null || true)"
watchdog_pid="$(cat "$PROJECT/.freely/run/ensure-manager.pid" 2>/dev/null || true)"

[[ -n "$ai_pid" ]] || {
  echo "[FAIL] expected active ai pid while manager supervisor is running" >&2
  exit 1
}
[[ -n "$watchdog_pid" ]] || {
  echo "[FAIL] expected ensure-manager watchdog pid while manager ai is active" >&2
  exit 1
}

kill -0 "$supervisor_pid" 2>/dev/null
kill -0 "$ai_pid" 2>/dev/null
kill -0 "$watchdog_pid" 2>/dev/null

bash "$ROOT_DIR/bin/freely" stop --project "$PROJECT" >/dev/null 2>&1 || true
wait "$supervisor_pid" || true

for _ in $(seq 1 10); do
  if [[ ! -f "$PROJECT/.freely/run/ensure-manager.pid" ]]; then
    break
  fi
  sleep 1
done

if [[ -f "$PROJECT/.freely/run/ensure-manager.pid" ]]; then
  echo "[FAIL] ensure-manager watchdog pid file still exists after freely stop" >&2
  exit 1
fi

echo "[PASS] manager runtime keeps ensure-manager watchdog alive during active ai and stops it cleanly"
