#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-interruption-handler-cc.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

run_case() {
  local tool="$1"
  local capabilities="$2"
  local policy="$3"
  local codex_model="$4"
  local codex_sandbox="$5"
  local codex_approval="$6"
  local codex_cwd_mode="$7"
  local case_dir="$TMP_DIR/$tool"
  local project="$case_dir/project"
  local fake_bin="$case_dir/bin"
  local intake_id="20260320-000000-test"
  mkdir -p "$project/.freely/intake/$intake_id" "$fake_bin"

  cat >"$project/.freely/config.env" <<EOF
AI_TOOL="$tool"
AI_MODEL="sonnet"
AI_REASONING_EFFORT="medium"
AI_TOOL_CAPABILITIES="$capabilities"
AI_TOOL_POLICY="$policy"
AI_CAPABILITY_CODEX_MODEL="$codex_model"
AI_CAPABILITY_CODEX_SANDBOX="$codex_sandbox"
AI_CAPABILITY_CODEX_APPROVAL_POLICY="$codex_approval"
AI_CAPABILITY_CODEX_CWD_MODE="$codex_cwd_mode"
EOF

  cat >"$project/.freely/intake/$intake_id/meta.env" <<'EOF'
INTAKE_ID="20260320-000000-test"
STATUS="classified"
EOF

  cat >"$project/.freely/intake/$intake_id/message.txt" <<'EOF'
检查已经合并到develop的worktree，应该怎么收口
EOF

  cat >"$fake_bin/claude" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$@" >"$TMP_DIR/claude.args"
cat <<'OUT'
DECISION=delegate
REACTION=followup
CLASSIFICATION=control
RESTART_POINT=cleanup
OWNERSHIP=worker
WHY=cc 模式下也应委派收口工作
HANDOFF=先核对已合并工位再执行 cleanup 收口
ANSWER=
OUT
EOF
  chmod +x "$fake_bin/claude"

  OUTPUT="$(
    PATH="$fake_bin:$PATH" TMP_DIR="$case_dir" \
      bash "$ROOT_DIR/docs/system/workspace/scripts/runtime/interruption-manager-handler" \
        --project "$project" \
        --intake-id "$intake_id"
  )"

  grep -q '^DECISION=delegate$' <<<"$OUTPUT"
  grep -q '^RESTART_POINT=cleanup$' <<<"$OUTPUT"
  grep -q '^OWNERSHIP=worker$' <<<"$OUTPUT"
  grep -q -- '^--permission-mode$' "$case_dir/claude.args"
  grep -q -- '^bypassPermissions$' "$case_dir/claude.args"

  if [[ "$tool" == "cc-use-codex-cli" ]]; then
    grep -q -- '^--append-system-prompt$' "$case_dir/claude.args"
    grep -q 'approval-policy=never' "$case_dir/claude.args"
    grep -q 'sandbox=workspace-write' "$case_dir/claude.args"
  else
    if grep -q -- '^--append-system-prompt$' "$case_dir/claude.args"; then
      echo "[FAIL] plain cc interruption handler should not append codex policy" >&2
      exit 1
    fi
  fi
}

run_case "cc" "" "" "" "" "" ""
run_case "cc-use-codex-cli" "codex-cli" "prefer-codex-for-repo-work" "gpt-5.4" "workspace-write" "never" "project-root"

echo "[PASS] interruption manager handler supports plain cc and cc-use-codex-cli profiles"
