#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-active-runtime-network-local.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
HOME="$TMP_DIR/home"
LOG_FILE="$TMP_DIR/reconnect.log"
mkdir -p "$PROJECT/docs/B1-docs/raw-20260401-0004" "$PROJECT/.freely/run" "$PROJECT/.freely/logs" "$HOME"

git init -q -b feature/test-active-runtime-reconnect "$PROJECT"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260401-0004--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260401-0004/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260401-0004/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
AUTO_SWITCH_TOOL="true"
AUTO_SWITCH_SLOT="true"
EOF

printf '%s\n' 'ERROR rmcp::transport::worker: worker quit with fatal: Transport channel closed, when Client(Reqwest(reqwest::Error { kind: Request, url: "https://chatgpt.com/backend-api/wham/apps", source: hyper_util::client::legacy::Error(Connect, Error { code: -9802, message: "Fatal alert" }) }))' >"$LOG_FILE"

# shellcheck disable=SC1090
HOME="$HOME" source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

reason="$(runtime_network_failure_reason_from_log "$PROJECT" "$LOG_FILE")"
[[ "$reason" == "execution_network_transient" ]] || {
  echo "[FAIL] active runtime reconnect/TLS evidence should stay execution-network scoped" >&2
  exit 1
}

if tool_failure_allows_same_tool_slot_recovery "codex" "$reason"; then
  echo "[FAIL] active runtime reconnect/TLS evidence must not trigger same-tool slot recovery" >&2
  exit 1
fi

echo "[PASS] active runtime reconnect/TLS evidence stays network-local and does not authorize same-tool slot recovery"
