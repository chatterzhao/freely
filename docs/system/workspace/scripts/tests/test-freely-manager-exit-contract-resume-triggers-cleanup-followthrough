EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
- 20260324-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260324-0000/brainstorms.md" <<'EOF'
# Brainstorms
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260324-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF
git -C "$PROJECT" add .
git -C "$PROJECT" commit -q -m init

bash "$ROOT_DIR/bin/freely" init --project "$PROJECT" --intent "$PROJECT/docs/PROJECT_INTENT.md" --constitution "$PROJECT/docs/CONSTITUTION.md" --ai codex:gpt-5.4:auto --accept-default-autonomy >/dev/null

mkdir -p "$PROJECT/docs/B2-docs/sample/story/issues" "$PROJECT/docs/B2-docs/sample/story/code-reviews"
cat >"$PROJECT/docs/B2-docs/sample/story/issues/sample.md" <<'EOF'
# Issue: sample

- issue_id: `I-sample`
- phase_state: `completed`
- pre_tests_path: `docs/B2-docs/sample/story/pre-tests.md`
- verification_artifact_dir: `docs/B2-docs/sample/story/code-reviews`
EOF
cat >"$PROJECT/docs/B2-docs/sample/story/code-reviews/pt-1.md" <<'EOF'
# Verification artifact
EOF
cat >"$PROJECT/docs/B2-docs/sample/story/pre-tests.md" <<'EOF'
# Pre-tests: sample

## Unit
- acceptance target: `Document the bounded unit surface for this sample fixture.`
- testing layer: `unit`
- target environment: `feature/sample`
- required evidence: `lawful replacement evidence for the unit surface`
- blocker taxonomy: `definition_missing`
- not_applicable_reason: `change_not_touching_this_layer`
- not_applicable_explanation: `This documentation-only sample does not change unit-testable runtime logic.`
- replacement_evidence: `The sample issue is documentation-only and keeps unit behavior unchanged.`

## Integration
- acceptance target: `Run the sample issue-bound integration replay.`
- testing layer: `integration`
- target environment: `feature/sample`
- required evidence: `sample integration replay log`
- blocker taxonomy: `execution_pending_or_failed`
1. Run the sample issue-bound integration replay.

## End-to-End
- acceptance target: `State why no end-to-end runtime surface exists in this fixture.`
- testing layer: `end_to_end`
- target environment: `feature/sample`
- required evidence: `lawful replacement evidence for missing end-to-end surface`
- blocker taxonomy: `definition_missing`
- not_applicable_reason: `no_executable_boundary_at_this_layer`
- not_applicable_explanation: `This sample repo does not include an end-to-end runtime surface.`
- replacement_evidence: `The sample repo intentionally omits a runtime shell.`

## Real-Environment
- real_environment_status: `pass`
- real_environment_reason: `This isolated fixture does not require real-environment testing.`

## Acceptance Items

### PT-1
- id: `PT-1`
- requirement: `sample`
- evidence_level: `integration`
- status: `pass`
- artifact_ref: `docs/B2-docs/sample/story/code-reviews/pt-1.md`
EOF
cat >"$PROJECT/docs/B2-docs/sample/story/tasks.md" <<'EOF'
# Tasks
1. Keep the sample owner visible for cleanup followthrough retirement.
EOF

git -C "$PROJECT" worktree add -q -b feature/cleanup-fixture "$CLEAN_WT" develop
mkdir -p "$CLEAN_WT/.freely/run"
cat >"$CLEAN_WT/clean.txt" <<'EOF'
clean fixture
EOF
git -C "$CLEAN_WT" add clean.txt
git -C "$CLEAN_WT" commit -q -m "clean fixture"
git -C "$PROJECT" merge --no-ff feature/cleanup-fixture -m "merge clean fixture" >/dev/null
cat >"$CLEAN_WT/.freely/run/workcell-state.env" <<'EOF'
LAST_WORKER_OWNER_ISSUE="I-sample"
LAST_WORKER_PRE_TESTS_PATH="docs/B2-docs/sample/story/pre-tests.md"
LAST_WORKER_CLOSEOUT_GATE="pretests-gate"
LAST_WORKER_CLOSEOUT_GATE_COMMAND="pretests-gate"
LAST_WORKER_CLOSEOUT_REQUIRES_ADEQUACY="false"
LAST_WORKER_CLOSEOUT_REVIEW_ARTIFACT_POLICY="none"
EOF

cat >"$PROJECT/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="up"
LAST_AI_STATE="down"
LAST_EXIT_REASON="ai_exit_rc_0"
LAST_ROLE_HINT="manager"
LAST_STATE_UPDATED_AT="2026-04-22T20:10:00Z"
EOF

cat >"$PROJECT/.freely/run/session-state.env" <<'EOF'
LAST_TOOL_SESSION_ID="sess-demo"
LAST_TOOL_RESUME_TARGET="resume-demo"
LAST_TOOL_JSONL_PATH=""
