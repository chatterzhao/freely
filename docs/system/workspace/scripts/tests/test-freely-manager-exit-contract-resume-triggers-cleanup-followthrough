EOF

INTAKE_OUTPUT="$(bash "$ROOT_DIR/bin/freely" intake chat --project "$PROJECT" --author cleanup-worker --channel runtime --message "cleanup followthrough")"
INTAKE_ID="$(printf '%s\n' "$INTAKE_OUTPUT" | sed -n 's/^intake_id: //p')"
[[ -n "$INTAKE_ID" ]] || {
  echo "[FAIL] missing intake id" >&2
  exit 1
}

cat >"$PROJECT/.freely/run/manager-continuity-20260422-201000.md" <<EOF
# Manager Continuity

- generated_at: \`2026-04-22 20:10:00 PDT\`
- manager_worktree: \`$PROJECT\`
- manager_branch: \`develop\`
- selected_tool: \`codex\`
- source_class: \`continuation\`

## Primary Judgement

- route_kind: \`cleanup_governance\`
- restart_point: \`continuation\`
- ownership: \`manager -> runtime retirement followthrough for I-20260421-1200-A\`
- next_action: \`consume the existing retire_only worker exit contract, retire $CLEAN_WT, materialize a retirement receipt, then resume manager patrol from the next source\`

## Evidence

5. delegated continuation truth
   - \`$INTAKE_ID\`: consume existing worker exit contract and move cleanup surface into runtime retirement / fleet closure
EOF

cat >"$PROJECT/.freely/run/manager-exit-contract.env" <<'EOF'
EXIT_KIND="resume_manager"
RESTART_POINT="post_retirement_receipt_patrol"
NEXT_ACTION="Wait for runtime retirement receipt, then resume patrol."
WHY_NOT_STOP="Cleanup followthrough is still open."
WHY_NOT_DELEGATE="This lane is already retire_only."
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

ACTION="$(manager_runtime_handle_exit_contract_after_ai_cycle "$PROJECT" "ai_exit_rc_0")"
[[ "$ACTION" == "resume_manager" ]]

if [[ -d "$CLEAN_WT" ]]; then
  echo "[FAIL] clean merged worktree should be removed during manager resume cleanup followthrough" >&2
  exit 1
fi
if git -C "$PROJECT" show-ref --verify --quiet refs/heads/feature/cleanup-fixture; then
  echo "[FAIL] merged cleanup branch should be deleted during cleanup followthrough" >&2
  exit 1
fi
if ! grep -q 'event=manager_exit_contract_cleanup_followthrough_begin' "$PROJECT/.freely/logs/runtime-events.log"; then
  echo "[FAIL] expected cleanup followthrough begin event" >&2
  exit 1
fi
if ! grep -q 'event=manager_exit_contract_cleanup_followthrough ' "$PROJECT/.freely/logs/runtime-events.log"; then
  echo "[FAIL] expected cleanup followthrough completion event" >&2
  exit 1
fi

echo "[PASS] manager exit contract resume triggers cleanup followthrough before resume"
