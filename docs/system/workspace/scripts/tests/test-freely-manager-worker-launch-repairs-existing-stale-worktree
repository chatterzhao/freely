#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-worker-stale-worktree.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
WT_ROOT="${PROJECT}-worktrees"
WORKER_WT="$WT_ROOT/20260424-feature-existing-stale-worker"
FREELY_HOME="$TMP_DIR/freely-home"
mkdir -p "$PROJECT/docs/B1-docs/raw-20260424-0001" "$WT_ROOT" "$FREELY_HOME"

git init -q -b develop "$PROJECT"
git -C "$PROJECT" config user.name "Freely Test"
git -C "$PROJECT" config user.email "freely@example.com"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
- 20260424-0001--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260424-0001/brainstorms.md" <<'EOF'
# Brainstorms
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260424-0001/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

git -C "$PROJECT" add .
git -C "$PROJECT" commit -q -m "init"
git -C "$PROJECT" worktree add -q -b feature/existing-stale-worker "$WORKER_WT" develop

mkdir -p "$PROJECT/.freely/run/worker-prompts" "$PROJECT/.freely/logs" "$WORKER_WT/.freely"
cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF
cat >"$WORKER_WT/.freely/config.env" <<EOF
PROJECT_ROOT="$WORKER_WT"
INTENT_FILE="$WORKER_WT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$WORKER_WT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

test ! -e "$WORKER_WT/.freely/tool-boundary-bootstrap.md"
test ! -e "$WORKER_WT/.freely/bin/codex"
test ! -e "$WORKER_WT/.codex/config.toml"
test ! -e "$WORKER_WT/.freely/run/workcell-state.env"

PROMPT_FILE="$PROJECT/.freely/run/worker-prompts/20260424-existing-stale-worker-codex.txt"
cat >"$PROMPT_FILE" <<EOF
Worktree:
- \`$WORKER_WT\`
Branch:
- \`feature/existing-stale-worker\`
dispatch_priority: P0
parallel_safe: false
write_scope: \`$WORKER_WT\`
intent_kind: edit
intent_target: \`$WORKER_WT\`
Owner-Issue:
- \`I-20260424-0203-A\`
Pre-Tests-Path:
- \`docs/B2-docs/sample/story/pre-tests.md\`
Verification-Artifact-Dir:
- \`docs/B2-docs/sample/story/code-reviews\`
Required-Test-Lanes:
- \`feature-local\`
Required-Acceptance-Item-Ids:
- \`worker-launch-linkage\`
Minimum-Evidence-Level:
- \`artifact-plus-human-observation\`
Target-Environment:
- \`develop\`
Closeout-Gate:
- \`owner-issue verification closeout\`
Closeout-Gate-Command:
- \`owner-issue verification closeout\`
Closeout-Target-Lane:
- \`feature-local\`
Closeout-Promotion-Gate:
- \`completion\`
Closeout-Requires-Adequacy:
- \`false\`
Closeout-Review-Artifact-Policy:
- \`none\`
EOF

CONT_FILE="$PROJECT/.freely/run/manager-continuity-20260424-existing-stale.md"
cat >"$CONT_FILE" <<EOF
# Manager Continuity

- worker_prompt: \`$PROMPT_FILE\`
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

START_LOG="$TMP_DIR/started.log"
manager_supervisor_pid_for_project() { return 0; }
runtime_ai_pid_hint_for_project() { return 0; }
start_workcell_supervisor_async() {
  echo "$1" >>"$START_LOG"
}

LAUNCHED="$(FREELY_HOME="$FREELY_HOME" manager_runtime_launch_workers_from_latest_handoff "$PROJECT")"
[[ "$LAUNCHED" == "1" ]] || {
  echo "[FAIL] expected one launched worker after repairing the stale existing worktree, got $LAUNCHED" >&2
  exit 1
}

grep -q "$WORKER_WT" "$START_LOG"
test -f "$WORKER_WT/.freely/tool-boundary-bootstrap.md"
test -x "$WORKER_WT/.freely/bin/codex"
test -f "$WORKER_WT/.codex/config.toml"
test -f "$WORKER_WT/.freely/run/workcell-state.env"
grep -q '^LAST_EXIT_REASON="manager_worker_launch_linkage"$' "$WORKER_WT/.freely/run/workcell-state.env"

echo "[PASS] manager worker launch repairs a stale existing worktree before delegating"
