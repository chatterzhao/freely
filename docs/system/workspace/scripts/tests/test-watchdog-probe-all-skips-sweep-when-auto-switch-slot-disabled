#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-watchdog-probe-all-slot-disabled.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
HOME_DIR="$TMP_DIR/home"
mkdir -p "$PROJECT/.freely/run" "$HOME_DIR/.codex"

bash -lc '
  set -euo pipefail
  export HOME="'"$HOME_DIR"'"
  export AUTO_SWITCH_SLOT="false"
  log_info() { :; }
  log_warn() { :; }
  log_error() { :; }
  source "'"$ROOT_DIR"'/docs/system/workspace/skills/watchdog-control-plane/scripts/availability-watchdog.sh"
  codex_current_cooldown_identity() { echo "slot-current"; }
  codex_current_slot() { echo "slot-current"; }
  read_codex_active_slot() { echo "slot-current"; }
  codex_active_auth_file() { echo "'"$TMP_DIR"'/auth.json"; }
  codex_saved_slots() {
    echo "[FAIL] probe_all should not enumerate saved slots when AUTO_SWITCH_SLOT=false" >&2
    exit 1
  }
  switch_to_codex_slot() {
    echo "[FAIL] probe_all should not switch slots when AUTO_SWITCH_SLOT=false" >&2
    exit 1
  }
  codex_probe_current_slot_now() {
    echo "[FAIL] probe_all should not probe any slot when AUTO_SWITCH_SLOT=false" >&2
    exit 1
  }
  set +e
  result="$(probe_all_codex_slots_and_update_cooldown "'"$PROJECT"'")"
  rc=$?
  set -e
  [[ "$rc" -eq 1 ]] || {
    echo "[FAIL] expected probe_all to return rc=1 when AUTO_SWITCH_SLOT=false, got: $rc" >&2
    exit 1
  }
  [[ "$result" == "none" ]] || {
    echo "[FAIL] expected probe_all to short-circuit with none, got: $result" >&2
    exit 1
  }
'

echo "[PASS] watchdog probe-all sweep short-circuits when AUTO_SWITCH_SLOT=false"
