#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-monitor-ai-iflow-descendants.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
PROMPT_FILE="$TMP_DIR/prompt.txt"
PID_FILE="$TMP_DIR/child.pid"
LOG_FILE="$TMP_DIR/monitor.log"
DEBUG_LOG_FILE="$TMP_DIR/debug.log"
MARKER_FILE="$TMP_DIR/failure.marker"
GRANDCHILD_PID_FILE="$TMP_DIR/grandchild.pid"
MOCK_BIN="$TMP_DIR/mock-bin"

mkdir -p "$PROJECT" "$MOCK_BIN"
printf 'hi\n' >"$PROMPT_FILE"

cat >"$MOCK_BIN/iflow" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
sleep 30 &
grandchild_pid=$!
printf '%s\n' "$grandchild_pid" >"$IFLOW_GRANDCHILD_PID_FILE"
printf '%s\n' 'Attempt 1 failed. Retrying with backoff... Error: 您当前的账号已达到平台并发限制，系统将重试请求，请控制单并发使用'
wait "$grandchild_pid"
EOF
chmod +x "$MOCK_BIN/iflow"

set +e
IFLOW_GRANDCHILD_PID_FILE="$GRANDCHILD_PID_FILE" \
PATH="$MOCK_BIN:$PATH" \
  bash "$ROOT_DIR/docs/system/workspace/scripts/monitor-ai-cli.sh" \
    --project "$PROJECT" \
    --tool iflow \
    --tool-adapter direct \
    --model auto \
    --reasoning-effort "" \
    --tool-capabilities "" \
    --tool-policy "" \
    --codex-capability-model "" \
    --codex-capability-sandbox "" \
    --codex-capability-approval-policy "" \
    --codex-capability-cwd-mode "" \
    --debug-log-file "$DEBUG_LOG_FILE" \
    --claude-session-id "" \
    --tool-resume-target "" \
    --mode auto \
    --prompt-file "$PROMPT_FILE" \
    --pid-file "$PID_FILE" \
    --log-file "$LOG_FILE" \
    --failure-marker-file "$MARKER_FILE" \
    --launch-kind fresh >/dev/null 2>&1
RC=$?
set -e

[[ "$RC" -ne 0 ]]
[[ -f "$MARKER_FILE" ]]
grep -q '^tool_runtime_failure$' "$MARKER_FILE"
grep -q '平台并发限制' "$LOG_FILE"

CHILD_PID="$(cat "$PID_FILE")"
GRANDCHILD_PID="$(cat "$GRANDCHILD_PID_FILE")"

if kill -0 "$CHILD_PID" 2>/dev/null; then
  echo "[FAIL] monitor-ai-cli left the iflow parent running after a runtime failure" >&2
  exit 1
fi

if kill -0 "$GRANDCHILD_PID" 2>/dev/null; then
  echo "[FAIL] monitor-ai-cli left an iflow descendant running after a runtime failure" >&2
  exit 1
fi

echo "[PASS] monitor-ai-cli terminates the iflow process tree on runtime failure"
