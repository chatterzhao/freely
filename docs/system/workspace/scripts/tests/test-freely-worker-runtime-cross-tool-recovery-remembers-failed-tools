#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-worker-cross-tool-memory.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
HOME="$TMP_DIR/home"
mkdir -p "$PROJECT/docs/B1-docs/raw-20260401-0005" "$PROJECT/.freely/run" "$PROJECT/.freely/logs" "$HOME/.ai-auth/codex-default-2"

git init -q -b feature/test-worker-cross-tool-memory "$PROJECT"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260401-0005--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260401-0005/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260401-0005/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
AUTO_SWITCH_TOOL="true"
AUTO_SWITCH_SLOT="true"
AI_FALLBACK_TOOLS="cc,iflow,kiro-cli"
EOF

cat >"$PROJECT/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
SUPERVISOR_STATE="up"
AI_STATE="down"
LAST_EXIT_REASON="tool_runtime_failure"
EOF

# shellcheck disable=SC1090
HOME="$HOME" source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"
load_config "$PROJECT"

role_hint_for_project() {
  printf 'worker\n'
}

tool_select_ready_slot_for_manager_auto_recovery() {
  return 1
}

tool_ready_for_manager_auto_recovery() {
  local project="$1" tool="$2"
  case "$tool" in
    cc|iflow|kiro-cli)
      runtime_write_tool_current_slot "$tool" "default-1"
      TOOL_AUTO_RECOVERY_SLOT="default-1"
      return 0
      ;;
  esac
  return 1
}

attempt_runtime_auto_recovery_after_failure "$PROJECT" "codex" "tool_runtime_failure" >/dev/null
[[ "${RUNTIME_AUTO_RECOVERY_TOOL:-}" == "cc" ]] || {
  echo "[FAIL] first recovery step should fall through from codex to cc" >&2
  exit 1
}

attempt_runtime_auto_recovery_after_failure "$PROJECT" "cc" "tool_runtime_failure" >/dev/null
[[ "${RUNTIME_AUTO_RECOVERY_TOOL:-}" == "iflow" ]] || {
  echo "[FAIL] second recovery step should skip failed codex/cc and choose iflow" >&2
  exit 1
}

attempt_runtime_auto_recovery_after_failure "$PROJECT" "iflow" "tool_runtime_failure" >/dev/null
[[ "${RUNTIME_AUTO_RECOVERY_TOOL:-}" == "kiro-cli" ]] || {
  echo "[FAIL] third recovery step should continue to the next untried fallback tool" >&2
  exit 1
}

if attempt_runtime_auto_recovery_after_failure "$PROJECT" "kiro-cli" "tool_runtime_failure" >/dev/null 2>&1; then
  echo "[FAIL] recovery should stop once every fallback tool in the ordered set has already failed" >&2
  exit 1
fi

grep -q '^AI_TOOL="codex"$' "$PROJECT/.freely/config.env" || {
  echo "[FAIL] once every fallback fails, the runtime should restore the episode origin tool for the next retry" >&2
  cat "$PROJECT/.freely/config.env" >&2
  exit 1
}

[[ "${AUTO_RECOVERY_ATTEMPTED_TOOLS_CSV:-}" == "codex,cc,iflow,kiro-cli" ]] || {
  echo "[FAIL] expected attempted tool memory to preserve the recovery episode ordering" >&2
  printf '%s\n' "${AUTO_RECOVERY_ATTEMPTED_TOOLS_CSV:-}" >&2
  exit 1
}
[[ "${AUTO_RECOVERY_ORIGIN_TOOL:-}" == "codex" ]] || {
  echo "[FAIL] expected recovery episode to remember the original tool while fallback memory remains active" >&2
  exit 1
}

runtime_auto_recovery_reset_attempted_tools
attempt_runtime_auto_recovery_after_failure "$PROJECT" "codex" "tool_runtime_failure" >/dev/null
[[ "${RUNTIME_AUTO_RECOVERY_TOOL:-}" == "cc" ]] || {
  echo "[FAIL] a fresh recovery episode should restart from the leftmost fallback priority" >&2
  exit 1
}

echo "[PASS] worker runtime remembers failed fallback tools within one recovery episode and resets cleanly for the next one"
