#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-runtime-defers-global-account-recovery.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/freely"
WT_ROOT="$TMP_DIR/freely-worktrees"
WORKER="$WT_ROOT/feature-worker"
MOCK_BIN="$TMP_DIR/mock-bin"
AI_LOG="$TMP_DIR/ai.log"

mkdir -p "$PROJECT/docs/B1-docs/raw-20260309-0000" "$PROJECT/.freely/run" "$PROJECT/.freely/logs" "$WT_ROOT" "$MOCK_BIN"
cd "$PROJECT"
git init -q -b develop
git config user.name tester
git config user.email tester@example.com
echo base > README.md
git add README.md
git commit -q -m "init"
git branch feature/worker
git worktree add "$WORKER" feature/worker >/dev/null

for wt in "$PROJECT" "$WORKER"; do
  mkdir -p "$wt/bin" "$wt/docs/B1-docs/raw-20260309-0000" "$wt/.freely/run" "$wt/.freely/logs"
  cat >"$wt/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
  cat >"$wt/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
  cat >"$wt/docs/LAWS.md" <<'EOF'
# Laws
EOF
  cat >"$wt/AGENTS.md" <<'EOF'
# Agents
EOF
  cat >"$wt/docs/B1-docs/README.md" <<'EOF'
# 预研头脑风暴工作区
EOF
  cat >"$wt/docs/B1-docs/INDEX.md" <<'EOF'
# 预研头脑风暴索引
- 20260309-0000--sample
EOF
  cat >"$wt/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# 收敛
EOF
  cat >"$wt/docs/B1-docs/raw-20260309-0000/brainstorms.md" <<'EOF'
# Brainstorms
- ok
EOF
  cat >"$wt/docs/B1-docs/raw-20260309-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF
done

cat >"$WORKER/.freely/config.env" <<EOF
PROJECT_ROOT="$WORKER"
INTENT_FILE="$WORKER/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$WORKER/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
AI_REASONING_EFFORT="medium"
CHECK_INTERVAL=1
RESTART_DELAY=0
MAX_RESTARTS=0
IFLOW_MAX_TURNS=100
MAX_RESUME_STREAK=24
MAX_ROUTE_ONLY_STREAK=1
ROTATE_ON_CONTEXT_COMPACTED=1
SESSION_HANDOFF_TAIL_LINES=20
CONTEXT_WARN_RATIO=0.50
CONTEXT_ROTATE_RATIO=0.70
CHECKPOINT_WARN_DIRTY_ENTRIES=40
CHECKPOINT_BLOCK_DIRTY_ENTRIES=120
EOF

cat >"$WORKER/bin/ai" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"${AI_LOG:?}"
cmd=""
for arg in "$@"; do
  case "$arg" in
    whoami|switch|list)
      cmd="$arg"
      break
      ;;
  esac
done
case "$cmd" in
  whoami)
    echo '{"tool":"codex","account":"limited@example.com"}'
    ;;
  list)
    echo '{"accounts":["codex-limited@example-com","codex-good@example-com"]}'
    ;;
  switch)
    echo '{"switched":true,"tool":"codex","account":"unexpected@example.com"}'
    ;;
  *)
    echo '{}'
    ;;
esac
EOF
chmod +x "$WORKER/bin/ai"

cat >"$MOCK_BIN/codex" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
cat <<'OUT'
Error: authentication failed
OUT
exit 1
EOF
chmod +x "$MOCK_BIN/codex"

PATH="$MOCK_BIN:$PATH" AI_LOG="$AI_LOG" bash "$ROOT_DIR/bin/freely" start --project "$WORKER" >/dev/null 2>&1 || true

if grep -q ' switch ' "$AI_LOG"; then
  echo "[FAIL] worker runtime should not invoke ai switch on auth failure" >&2
  cat "$AI_LOG" >&2 || true
  exit 1
fi

grep -q 'LAST_EXIT_REASON="auth_failure"' "$WORKER/.freely/run/workcell-state.env"

if [[ -f "$WORKER/.freely/run/supervisor.pid" ]]; then
  sp="$(cat "$WORKER/.freely/run/supervisor.pid" 2>/dev/null || true)"
  if [[ -n "$sp" ]] && kill -0 "$sp" 2>/dev/null; then
    echo "[FAIL] worker supervisor should stop after deferring global account recovery" >&2
    exit 1
  fi
fi

echo "[PASS] worker runtime defers global account recovery to external watchdog on auth failure"
