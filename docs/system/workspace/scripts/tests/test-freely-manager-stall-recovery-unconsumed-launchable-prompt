#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-stall-unconsumed.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
WORKER="$TMP_DIR/project-worktrees/feature-worker"
mkdir -p \
  "$PROJECT/docs/B1-docs/raw-20260322-0000" \
  "$PROJECT/.freely/run/worker-prompts" \
  "$PROJECT/.freely/logs" \
  "$WORKER/.freely/run"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
- 20260322-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260322-0000/brainstorms.md" <<'EOF'
# Brainstorms
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260322-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

sleep 999 >/dev/null 2>&1 &
AI_PID=$!
echo "$AI_PID" >"$PROJECT/.freely/run/ai.pid"
echo "$$" >"$PROJECT/.freely/run/supervisor.pid"

cat >"$PROJECT/.freely/run/prompt-20260323-060100.txt" <<'EOF'
主管模式提示

Delegated continuation handoff:
- intake_id=20260323-060100-current message=continue current stalled closeout
EOF
touch -t 202603230601 "$PROJECT/.freely/run/prompt-20260323-060100.txt"

WORKER_PROMPT="$PROJECT/.freely/run/worker-prompts/20260323-060101-worker-feature-worker-codex.txt"
cat >"$WORKER_PROMPT" <<EOF
Worktree:
- \`$WORKER\`

Branch:
- \`feature/worker\`
EOF
touch -t 202603230601 "$WORKER_PROMPT"

CONTINUITY="$PROJECT/.freely/run/manager-continuity-20260323-060101.md"
cat >"$CONTINUITY" <<EOF
# Manager Continuity
- worker_prompt: \`$WORKER_PROMPT\`
EOF
touch -t 202603230602 "$CONTINUITY"

touch "$PROJECT/.freely/logs/cycle-20260323-060100.log"
touch -t 202603230601 "$PROJECT/.freely/logs/cycle-20260323-060100.log"

cat >"$PROJECT/.freely/run/manager-worker-launch-state.env" <<EOF
LAST_MANAGER_CONTINUITY_GENERATED="$CONTINUITY"
LAST_MANAGER_WORKER_PROMPTS_GENERATED="$WORKER_PROMPT"
LAST_MANAGER_CONTINUITY_CONSUMED="$CONTINUITY"
LAST_MANAGER_WORKER_PROMPTS_CONSUMED=""
LAUNCHED_WORKER_PROMPTS=""
UPDATED_AT="2026-03-23T06:01:30Z"
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

PREEMPT_LOG="$TMP_DIR/preempt.log"
RESTART_LOG="$TMP_DIR/restart.log"
manager_ai_pid_for_project() {
  echo "$AI_PID"
}
request_local_continuation_reentry() {
  echo "$1|$2" >>"$PREEMPT_LOG"
  write_preemption_state "$1" "graceful_term" "local_continuation_reentry" "$2" "$AI_PID"
  kill "$AI_PID" 2>/dev/null || true
}
restart_manager_supervisor_preserving_handoff() {
  echo "$1" >>"$RESTART_LOG"
}
write_manager_bootstrap_handoff() {
  printf '%s|%s|%s\n' "$1" "$5" "$6" >>"$TMP_DIR/handoff.log"
}
codex_current_account() {
  echo "test@example.com"
}

if ! recover_stalled_manager_ai_if_needed "$PROJECT"; then
  echo "[FAIL] expected stalled recovery to detect unconsumed launchable worker prompt" >&2
  exit 1
fi

grep -q "$PROJECT|runtime-stalled-ai-recovery" "$PREEMPT_LOG"
grep -q "$PROJECT" "$RESTART_LOG"
grep -q 'manager_ai_stalled_after_delegated_continuation_prompt|relaunch-manager-after-stall-recovery' "$TMP_DIR/handoff.log"

echo "[PASS] stalled recovery handles unconsumed launchable worker prompt without unbound variable"
