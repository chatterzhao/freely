#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-exit-contract-block.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/freely"
WT_ROOT="$TMP_DIR/freely-worktrees"
WORKER="$WT_ROOT/feature-worker"

mkdir -p "$PROJECT/docs/B1-docs/raw-20260324-0000" "$PROJECT/.freely/run" "$PROJECT/.freely/logs" "$WT_ROOT"
cd "$PROJECT"
git init -q -b develop
git config user.name tester
git config user.email tester@example.com
echo base > README.md
git add README.md
git commit -q -m init
git branch feature/worker
git worktree add "$WORKER" feature/worker >/dev/null
echo worker > "$WORKER/worker.txt"
git -C "$WORKER" add worker.txt
git -C "$WORKER" commit -q -m "worker diverges from develop"

for wt in "$PROJECT" "$WORKER"; do
  mkdir -p "$wt/docs/B1-docs/raw-20260324-0000" "$wt/.freely/run" "$wt/.freely/logs"
  cat >"$wt/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
  cat >"$wt/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
  cat >"$wt/docs/LAWS.md" <<'EOF'
# Laws
EOF
  cat >"$wt/AGENTS.md" <<'EOF'
# Agents
EOF
  cat >"$wt/docs/B1-docs/README.md" <<'EOF'
# README
EOF
  cat >"$wt/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
- 20260324-0000--sample
EOF
  cat >"$wt/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
  cat >"$wt/docs/B1-docs/raw-20260324-0000/brainstorms.md" <<'EOF'
# Brainstorms
EOF
  cat >"$wt/docs/B1-docs/raw-20260324-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF
done

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

cat >"$WORKER/.freely/config.env" <<EOF
PROJECT_ROOT="$WORKER"
INTENT_FILE="$WORKER/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$WORKER/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

cat >"$WORKER/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="down"
LAST_AI_STATE="down"
LAST_EXIT_REASON="tool_runtime_failure"
LAST_ROLE_HINT="worker"
LAST_STATE_UPDATED_AT="2026-03-24T00:00:00Z"
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

cat >"$(manager_exit_contract_file "$PROJECT")" <<'EOF'
EXIT_KIND="stop_ai"
STOP_REASON="all_scan_closed"
EOF

RESULT="$(manager_runtime_handle_exit_contract_after_ai_cycle "$PROJECT" "ai_exit_rc_0")"
[[ "$RESULT" == "resume_invalid" ]] || {
  echo "[FAIL] expected unresolved worker to block stop_ai, got $RESULT" >&2
  exit 1
}
[[ ! -f "$(stop_marker_file "$PROJECT")" ]] || {
  echo "[FAIL] manager stop marker must not be written while expected-running worker remains unresolved" >&2
  exit 1
}
grep -q '^LAST_EXIT_REASON="manager_exit_contract_stop_ai_blocked_expected_running_worker"$' "$PROJECT/.freely/run/workcell-state.env"
grep -q 'reason: manager_exit_contract_stop_ai_blocked_expected_running_worker' "$(handoff_file "$PROJECT")"
grep -q 'blocking_workers=1' "$(handoff_file "$PROJECT")"

echo "[PASS] manager exit contract refuses stop_ai while expected-running worker is unresolved"
