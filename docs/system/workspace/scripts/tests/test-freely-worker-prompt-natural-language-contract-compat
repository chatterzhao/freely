#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-worker-prompt-natural-language.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
WORKER="$TMP_DIR/project-worktrees/feature-worker"
mkdir -p "$PROJECT/.freely/run/worker-prompts" "$WORKER"

cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF

CONTINUITY="$PROJECT/.freely/run/manager-continuity-20260323-203000.md"
PROMPT="$PROJECT/.freely/run/worker-prompts/20260323-203000-worker-manager-delegated-continuation-stall-codex.txt"

cat >"$PROMPT" <<EOF
dispatch_priority: P0
parallel_safe: false
write_scope:
- docs/B1-docs/raw-20260323-1705/**
- docs/milestones.md

You are the worker for \`feature/worker-prompt-natural-language-contract-compat-20260323\` in \`$WORKER\`.
EOF

cat >"$CONTINUITY" <<EOF
# Manager Continuity
- worker_prompt: \`$PROMPT\`
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

[[ "$(worker_prompt_target_worktree "$PROMPT")" == "$WORKER" ]]
[[ "$(worker_prompt_target_branch "$PROMPT")" == "feature/worker-prompt-natural-language-contract-compat-20260323" ]]
worker_prompt_launchable_for_manager_project "$PROJECT" "$PROMPT"
[[ "$(latest_launchable_manager_continuity_file_for_project "$PROJECT")" == "$CONTINUITY" ]]

echo "[PASS] worker prompt parser accepts natural-language worker sentence contract"
