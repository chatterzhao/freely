#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-start-no-preflight-sweep.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
HOME_DIR="$TMP_DIR/home"
mkdir -p "$PROJECT/.freely/run" "$HOME_DIR/.codex"

cat >"$PROJECT/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
SUPERVISOR_STATE="down"
AI_STATE="down"
LAST_EXIT_REASON="primary_rate_limit_exhausted"
EOF

cat >"$HOME_DIR/.codex/auth.json" <<'EOF'
{"tokens":{"access_token":"token-current"}}
EOF
printf 'account-bad@example-com-1\n' >"$HOME_DIR/.codex/active-slot"

bash -lc '
  set -euo pipefail
  export HOME="'"$HOME_DIR"'"
  log_info() { :; }
  log_warn() { :; }
  log_error() { :; }
  source "'"$ROOT_DIR"'/docs/system/workspace/scripts/runtime/freely"
  codex_current_identity_hint() { echo "bad@example-com-1"; }
  codex_active_auth_file() { echo "'"$HOME_DIR"'/.codex/auth.json"; }
  select_any_available_codex_slot() {
    echo "[FAIL] freely start should not preflight-sweep saved slots when a current slot already exists" >&2
    exit 1
  }
  switch_to_codex_slot() {
    echo "[FAIL] freely start should not switch slots before the current slot actually fails in use" >&2
    exit 1
  }
  preflight_codex_slot_recovery_before_start_or_fail "'"$PROJECT"'"
'

echo "[PASS] freely start does not preflight-sweep or auto-switch before the current codex slot actually fails during use"
