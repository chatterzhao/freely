#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-authoritative-edit-prompt.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

PROJECT="$TMP_DIR/project"
WT_ROOT="$TMP_DIR/project-worktrees"
WORKER="$WT_ROOT/20260423-feature-authoritative-edit"

mkdir -p "$PROJECT/.freely/run/worker-prompts" "$PROJECT/.freely/logs" "$WT_ROOT"
git init -q -b develop "$PROJECT"
git -C "$PROJECT" config user.name tester
git -C "$PROJECT" config user.email tester@example.com

mkdir -p "$PROJECT/docs/B1-docs/raw-20260324-0000"
cat >"$PROJECT/.gitignore" <<'EOF'
.freely/
EOF
cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/AGENTS.md" <<'EOF'
# Agents
EOF
cat >"$PROJECT/docs/B1-docs/README.md" <<'EOF'
# README
EOF
cat >"$PROJECT/docs/B1-docs/INDEX.md" <<'EOF'
# INDEX
- 20260324-0000--sample
EOF
cat >"$PROJECT/docs/B1-docs/CONVERGENCE.md" <<'EOF'
# CONVERGENCE
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260324-0000/brainstorms.md" <<'EOF'
# Brainstorms
EOF
cat >"$PROJECT/docs/B1-docs/raw-20260324-0000/candidates.md" <<'EOF'
# Candidates
- promoted_issue_path: pending://issue-materialization
- milestone: pending://milestone-binding
- session_refs: []
EOF
echo base >"$PROJECT/README.md"
git -C "$PROJECT" add .
git -C "$PROJECT" commit -q -m init

git -C "$PROJECT" worktree add -q -b feature/authoritative-edit "$WORKER" develop

for wt in "$PROJECT" "$WORKER"; do
  mkdir -p "$wt/.freely/run" "$wt/.freely/logs"
  cat >"$wt/.freely/config.env" <<EOF
PROJECT_ROOT="$wt"
INTENT_FILE="$wt/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$wt/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF
done

cat >"$WORKER/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="down"
LAST_AI_STATE="down"
LAST_EXIT_REASON="operator_stop"
LAST_ROLE_HINT="worker"
LAST_STATE_UPDATED_AT="2026-04-23T12:00:00Z"
EOF

PROMPT="$PROJECT/.freely/run/worker-prompts/20260423-120000-worker-feature-authoritative-edit-codex.txt"
cat >"$PROMPT" <<EOF
Worktree:
- \`$WORKER\`
Branch:
- \`feature/authoritative-edit\`
dispatch_priority: P0
parallel_safe: false
write_scope: \`$WORKER\`
intent_kind: edit
intent_target: \`$WORKER\`
Owner-Issue:
- \`I-20260423-1200-A\`
Pre-Tests-Path:
- \`docs/B2-docs/sample/story/pre-tests.md\`
Verification-Artifact-Dir:
- \`docs/B2-docs/sample/story/code-reviews\`
Required-Test-Lanes:
- \`feature-local\`
Required-Acceptance-Item-Ids:
- \`authoritative-edit-prompt\`
Minimum-Evidence-Level:
- \`artifact-plus-human-observation\`
Target-Environment:
- \`develop\`
Closeout-Gate:
- \`owner-issue verification closeout\`
Closeout-Gate-Command:
- \`owner-issue verification closeout\`
Closeout-Target-Lane:
- \`feature-local\`
Closeout-Promotion-Gate:
- \`completion\`
Closeout-Requires-Adequacy:
- \`false\`
Closeout-Review-Artifact-Policy:
- \`none\`
EOF

CONTINUITY="$PROJECT/.freely/run/manager-continuity-20260423-120000.md"
cat >"$CONTINUITY" <<EOF
# Manager Continuity

## Worker Delegation
- authoritative_worker_prompts:
  - \`$PROMPT\`
- launchable_queue:
  - lane_id: \`I-20260423-1200-A\`
    dispatch_priority: \`P0\`
    prompt_path: \`$PROMPT\`
EOF

# shellcheck disable=SC1090
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"

git -C "$PROJECT" merge --no-ff -m "merge feature/authoritative-edit" feature/authoritative-edit >/dev/null

START_LOG="$TMP_DIR/start.log"
start_workcell_supervisor_async() {
  printf '%s\n' "$1" >>"$START_LOG"
  return 0
}

if worker_project_is_absorbed_merged_lane "$PROJECT" "$WORKER" "feature/authoritative-edit"; then
  echo "[FAIL] authoritative edit prompt should block absorbed-merged classification" >&2
  exit 1
fi
if worker_project_is_retire_ready_merged_followthrough "$PROJECT" "$WORKER" "feature/authoritative-edit"; then
  echo "[FAIL] authoritative edit prompt should block retire-ready merged classification" >&2
  exit 1
fi

LAUNCHED="$(manager_runtime_launch_workers_from_latest_handoff "$PROJECT")"
[[ "$LAUNCHED" == "1" ]]
grep -q "$WORKER" "$START_LOG"
grep -q '^DESIRED_RUNTIME_STATE="running"$' "$WORKER/.freely/run/workcell-state.env"
! grep -q '^LAST_EXIT_REASON="retire_ready_merged_worker"$' "$WORKER/.freely/run/workcell-state.env"

echo "[PASS] authoritative edit prompt keeps a fresh merged-tip worker launchable"
