#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-live-status-ignore-stale-delegated.XXXXXX)"

cleanup() {
  kill "${DISPATCH_PID:-}" "${WATCHDOG_PID:-}" 2>/dev/null || true
  wait "${DISPATCH_PID:-}" 2>/dev/null || true
  wait "${WATCHDOG_PID:-}" 2>/dev/null || true
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

PROJECT="$TMP_DIR/project"
mkdir -p "$PROJECT/.freely/run" "$PROJECT/.freely/intake/20260418-old" "$PROJECT/docs"

cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF
cat >"$PROJECT/.freely/config.env" <<EOF
PROJECT_ROOT="$PROJECT"
INTENT_FILE="$PROJECT/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$PROJECT/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
AI_REASONING_EFFORT="medium"
EOF
cat >"$PROJECT/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="down"
LAST_AI_STATE="down"
LAST_EXIT_REASON="none"
LAST_ROLE_HINT="manager"
LAST_STATE_UPDATED_AT="2026-04-20T05:00:00Z"
EOF
cat >"$PROJECT/.freely/run/manager-continuity-20260420-060000.md" <<'EOF'
# Manager Continuity
- continuity_id: `20260420-060000`
EOF
touch -t 202604200600.00 "$PROJECT/.freely/run/manager-continuity-20260420-060000.md"

cat >"$PROJECT/.freely/intake/20260418-old/meta.env" <<'EOF'
INTAKE_ID="20260418-old"
CREATED_AT="2026-04-18T21:00:00Z"
AUTHOR="human"
CHANNEL="chat"
STATUS="delegated"
CLASSIFICATION="continuation"
REACTION="followup"
LINKED_ARTIFACT="pending://interruption-manager-delegation"
DELEGATED_WORKTREE=""
SESSION_REFS="[]"
CLAIMED_BY="interruption-manager-agent"
CLAIMED_AT="2026-04-18T21:00:01Z"
ABSORPTION_TARGET="handoff://continuation"
RESOLUTION_ARTIFACT=""
EOF
cat >"$PROJECT/.freely/intake/20260418-old/message.txt" <<'EOF'
older delegated continuation should stay in history but not count as active intake
EOF

bash -c "exec -a 'runtime/freely ensure-interruption-dispatch --project $PROJECT --watch' sleep 30" >/dev/null 2>&1 &
DISPATCH_PID=$!
disown "$DISPATCH_PID" 2>/dev/null || true
bash -c "exec -a 'runtime/freely ensure-manager --project $PROJECT --watch --interval 10' sleep 30" >/dev/null 2>&1 &
WATCHDOG_PID=$!
disown "$WATCHDOG_PID" 2>/dev/null || true

printf '%s' "$DISPATCH_PID" >"$PROJECT/.freely/run/interruption-dispatch.pid"
printf '%s' "$WATCHDOG_PID" >"$PROJECT/.freely/run/ensure-manager.pid"

OUTPUT="$(bash "$ROOT_DIR/bin/freely" live-status --project "$PROJECT")"

printf '%s\n' "$OUTPUT" | grep -q 'intake_active_items: 0'
printf '%s\n' "$OUTPUT" | grep -q 'intake_delegated_items: 1'
printf '%s\n' "$OUTPUT" | grep -q 'activity_state: supervising'
! printf '%s\n' "$OUTPUT" | grep -q 'activity_state: supervising_with_pending_intake'

echo "[PASS] live-status ignores stale delegated continuation items when deciding pending intake posture"
