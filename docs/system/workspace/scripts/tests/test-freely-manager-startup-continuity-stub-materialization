#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-manager-startup-stub.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT

REPO="$TMP_DIR/repo"
mkdir -p "$REPO/.freely/run" "$REPO/.freely/logs" "$REPO/docs"

git init -q "$REPO"
git -C "$REPO" config user.email "test@example.com"
git -C "$REPO" config user.name "Test User"
cat >"$REPO/README.md" <<'EOF'
# repo
EOF
git -C "$REPO" add README.md
git -C "$REPO" commit -q -m "init"
git -C "$REPO" branch -m develop

cat >"$REPO/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$REPO/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$REPO/docs/LAWS.md" <<'EOF'
# Laws
EOF

OLD_CONTINUITY="$REPO/.freely/run/manager-continuity-20260413-045348.md"
EXPECTED_CONTINUITY="$REPO/.freely/run/manager-continuity-20260413-055348.md"
PROMPT="$REPO/.freely/run/prompt-20260413-055346.txt"
CYCLE_LOG="$REPO/.freely/logs/cycle-20260413-055346.log"

cat >"$OLD_CONTINUITY" <<'EOF'
# Manager Continuity
- continuity_id: `20260413-045348`
EOF
touch "$CYCLE_LOG"
cat >"$REPO/.freely/run/session-state.env" <<EOF
LAST_CYCLE_LOG="$CYCLE_LOG"
EOF
cat >"$PROMPT" <<EOF
你现在进入 Freely 的首跳闭环。
19. 至少创建一个 manager continuity 文件：\`$EXPECTED_CONTINUITY\`。
EOF

export AGENT_AI_TOOL="codex"
export AI_MODEL="gpt-5.4"
export AI_REASONING_EFFORT="medium"
export LAST_CYCLE_LOG="$CYCLE_LOG"

source "$ROOT_DIR/docs/system/workspace/scripts/runtime/freely"
materialize_required_manager_continuity_startup_stub "$REPO" "$PROMPT" "fresh"

[[ -f "$EXPECTED_CONTINUITY" ]]
grep -q 'continuity_written_by: `freely-runtime-startup-stub`' "$EXPECTED_CONTINUITY"
grep -q 'startup_handoff_state: `seeded_by_runtime`' "$EXPECTED_CONTINUITY"
grep -q 'startup_handoff_launch_kind: `fresh`' "$EXPECTED_CONTINUITY"
grep -Eq 'generated_at: `20[0-9]{2}\.[0-9]{2}\.[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} [A-Z]{3}`' "$EXPECTED_CONTINUITY"
grep -q "previous_manager_continuity: \`$OLD_CONTINUITY\`" "$EXPECTED_CONTINUITY"
grep -q "prompt_file: \`$PROMPT\`" "$EXPECTED_CONTINUITY"
grep -q "latest_cycle_log: \`$CYCLE_LOG\`" "$EXPECTED_CONTINUITY"
grep -q 'event=manager_continuity_startup_stub_materialized' "$REPO/.freely/logs/runtime-events.log"

echo "[PASS] runtime seeds the required manager continuity startup stub on the normal path"
