#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"
TMP_DIR="$(mktemp -d /tmp/freely-live-status-hard-stale-recorded-owner.XXXXXX)"
TMP_DIR_REAL="$(cd "$TMP_DIR" && pwd -P)"
trap 'rm -rf "$TMP_DIR_REAL"' EXIT

PROJECT="$TMP_DIR/repo"
WT_ROOT="$TMP_DIR/repo-worktrees"
WORKER_A="$WT_ROOT/feature-a"
WORKER_B="$WT_ROOT/feature-b"

mkdir -p "$PROJECT/.freely/run" "$PROJECT/docs" "$WT_ROOT"
cat >"$PROJECT/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
cat >"$PROJECT/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
cat >"$PROJECT/docs/LAWS.md" <<'EOF'
# Laws
EOF

git init -q "$PROJECT"
git -C "$PROJECT" config user.email "test@example.com"
git -C "$PROJECT" config user.name "Test User"
cat >"$PROJECT/README.md" <<'EOF'
# repo
EOF
git -C "$PROJECT" add README.md
git -C "$PROJECT" commit -q -m "init"
git -C "$PROJECT" branch -m develop
git -C "$PROJECT" worktree add -q -b feature/a "$WORKER_A"
git -C "$PROJECT" worktree add -q -b feature/b "$WORKER_B"

for wt in "$WORKER_A" "$WORKER_B"; do
  mkdir -p "$wt/.freely/run" "$wt/docs"
  cat >"$wt/docs/PROJECT_INTENT.md" <<'EOF'
# Intent
EOF
  cat >"$wt/docs/CONSTITUTION.md" <<'EOF'
# Constitution
EOF
  cat >"$wt/.freely/config.env" <<EOF
PROJECT_ROOT="$wt"
INTENT_FILE="$wt/docs/PROJECT_INTENT.md"
CONSTITUTION_FILE="$wt/docs/CONSTITUTION.md"
AGENT_AI_TOOL="codex"
AI_MODEL="gpt-5.4"
AI_MODE="auto"
EOF
done

cat >"$WORKER_A/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="down"
LAST_AI_STATE="down"
LAST_EXIT_REASON="operator_stop"
LAST_ROLE_HINT="worker"
LAST_STATE_UPDATED_AT="2020-01-01T00:00:00Z"
EOF

cat >"$WORKER_A/.freely/run/prompt-20260402-181500.txt" <<EOF
Dispatch metadata:
- intent_kind: promotion
- intent_target: \`I-20260402-0455-A -> develop\`

Worktree:
- \`$WORKER_A\`
EOF

touch -t 202001010000 "$WORKER_A/.freely/run/prompt-20260402-181500.txt" "$WORKER_A/.freely/run/workcell-state.env"

cat >"$WORKER_B/.freely/run/workcell-state.env" <<'EOF'
DESIRED_RUNTIME_STATE="running"
LAST_SUPERVISOR_STATE="down"
LAST_AI_STATE="down"
LAST_EXIT_REASON="operator_stop"
LAST_ROLE_HINT="worker"
LAST_STATE_UPDATED_AT="2026-04-02T18:16:00Z"
EOF

cat >"$WORKER_B/.freely/run/prompt-20260402-181600.txt" <<EOF
Dispatch metadata:
- intent_kind: promotion
- intent_target: \`I-20260402-0455-A -> develop\`

Worktree:
- \`$WORKER_B\`
EOF

export OWNERSHIP_HARD_STALE_THRESHOLD_SECS=1
OUTPUT="$(bash "$ROOT_DIR/bin/freely" live-status --project "$WORKER_B")"

grep -q 'ownership_conflict_state: none' <<<"$OUTPUT"
grep -q 'ownership_conflict_summary: none' <<<"$OUTPUT"
grep -q 'ownership_conflict_signature: none' <<<"$OUTPUT"
grep -q 'ownership_conflict_with: none' <<<"$OUTPUT"

echo "[PASS] live-status does not surface a hard-stale recorded owner as an active ownership conflict"
