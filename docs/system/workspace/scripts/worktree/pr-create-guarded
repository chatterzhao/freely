#!/usr/bin/env bash
set -euo pipefail

# pr-create-guarded: merge onto latest develop → handle conflicts → dry-run gate → push → create PR
#
# Usage:
#   ./bin/pr-create-guarded [--title <title>] [--body <body>] [--base <branch>]
#
# Must be run inside a fix/raw-* or feature/raw-* worktree.

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$ROOT_DIR" ]] || { echo "ERROR: not in a git repository" >&2; exit 1; }
cd "$ROOT_DIR"

current_branch="$(git rev-parse --abbrev-ref HEAD)"
case "$current_branch" in
  develop|main|test-pre-merge-*)
    echo "拒绝: 不能在受保护分支 '$current_branch' 上执行 pr-create-guarded。" >&2
    echo "请在 fix/raw-* 或 feature/raw-* 工位中执行。" >&2
    exit 1
    ;;
esac

title="${1:-}"
body="${2:-}"
base="${3:-develop}"

echo "=== pr-create-guarded: $current_branch → $base ==="
echo ""

# ── Step 0a: Worktree cleanliness check ──
_dirty_files=$(git status --porcelain 2>/dev/null | grep -v '^?' | head -20 || true)
_untracked=$(git ls-files --others --exclude-standard 2>/dev/null | head -20 || true)
if [[ -n "$_dirty_files" ]] || [[ -n "$_untracked" ]]; then
  cat >&2 <<DIRTY
[PR-CREATE] Worktree is dirty — cannot create PR.
Uncommitted changes prevent accurate governance-gate evaluation.

Tracked modifications:
${_dirty_files:-  (none)}

Untracked files (should be committed or .gitignored):
${_untracked:-  (none)}

Resolve:
  git add <files> && git commit -m "..."   — commit changes
  git stash                                — save and restore later
  echo <pattern> >> .gitignore             — intentionally ignore
DIRTY
  exit 1
fi
echo "Step 0a/4: worktree clean ✓"

# ── Step 0b: Worktree phase_state check ──
_raw_key=$(echo "$current_branch" | grep -oE 'raw-[0-9]{8}T[0-9]{6}Z' | head -1 || true)
if [[ -n "$_raw_key" ]]; then
  _issue_file="$ROOT_DIR/docs/issues/${_raw_key}/issue.md"
  if [[ -f "$_issue_file" ]]; then
    _phase="$(python3 -c "
import yaml
with open('$_issue_file') as f: c=f.read()
p=c.split('---',2)
fm=yaml.safe_load(p[1]) if len(p)>=3 else {}
print(fm.get('phase_state',''))
" 2>/dev/null || true)"
    if [[ "$_phase" != "absorbed" ]]; then
      cat >&2 <<PHASE
[PR-CREATE] raw issue phase_state is '${_phase:-<empty>}', not 'absorbed'.
The raw issue must be absorbed before creating a PR.
This means the IBM lifecycle is complete and the issue is ready for merge.

  Current state: phase_state=${_phase:-<empty>}
  Required:      phase_state=absorbed

  If work is done but phase_state not updated:
    1. Edit $ROOT_DIR/docs/issues/${_raw_key}/issue.md
    2. Set phase_state: absorbed
    3. Set absorbed_into: 'I-{key}-A' (the I-* issue that absorbs this)
    4. git add + git commit

  If governance (B1_IBM/B2_IBM) is incomplete:
    skill:freely-doc-B1_IBM-execution → brainstorm → candidate
    skill:freely-doc-B2_IBM-execution → I-* → pre-tests → code-review
PHASE
      exit 1
    fi
    echo "Step 0b/4: phase_state=absorbed ✓"
  fi
fi

# ── Step 0c: Dev↔Test consistency check ──
if [[ "$_branch" == fix/raw-* || "$_branch" == feature/raw-* ]]; then
  _raw_key=$(echo "$_branch" | grep -oE '[0-9]{8}T[0-9]{6}Z' | head -1 || true)
  if [[ -n "$_raw_key" ]]; then
    echo "Step 0c/4: dev↔test consistency..."
    freely_wt_assert_dev_test_consistent "$_raw_key" || {
      echo ""
      echo "  同步后重跑 test-GREEN（skill:freely-test-execution），全部 green 后重新 pr-create。"
      exit 1
    }
    echo "Step 0c/4: dev↔test consistent ✓"
  fi
fi

# ── Step 2a: epics-map alignment check ──
echo "Step 2a/4: epics-map alignment..."
if [[ -x "$ROOT_DIR/bin/check-epics-map" ]]; then
  "$ROOT_DIR/bin/check-epics-map" --project "$ROOT_DIR" || {
    echo ""
    echo "epics-map 门禁未通过。请更新 docs/epics-map.svg 后重试。"
    exit 1
  }
else
  echo "[WARN] check-epics-map not found, skipping"
fi
echo ""

# ── Step 2: dry-run merge gate ──
echo "Step 2b/4: dry-run merge gate..."
if [[ -x "$ROOT_DIR/bin/pr-merge-guarded" ]]; then
  "$ROOT_DIR/bin/pr-merge-guarded" --dry-run "$base" "$current_branch"
  if [[ $? -ne 0 ]]; then
    echo ""
    echo "dry-run 门禁未通过。请修复后重试。"
    exit 1
  fi
else
  echo "[WARN] pr-merge-guarded not found, skipping dry-run"
fi

# ── Step 2b: IBM governance gate (early check before PR creation) ──
# Runs governance-merge-gate on the diff between base and current branch.
# Catches missing IBM lifecycle artifacts (candidate, I-*, milestone)
# BEFORE pushing and creating PR — gives developer clear fix instructions.
echo ""
echo "Step 2c/4: IBM governance gate..."
if [[ -x "$ROOT_DIR/bin/governance-merge-gate" ]]; then
  set +e
  gate_output="$("$ROOT_DIR/bin/governance-merge-gate" --range "$base..HEAD" 2>&1)"
  gate_rc=$?
  set -e
  if [[ "$gate_rc" -ne 0 ]]; then
	    # Determine the authoritative skill from branch prefix.
	    # wt-create derives prefix from --skill: freely-fix-execution → fix/raw-*, freely-feature-execution → feature/raw-*
	    _primary_skill=""; _flow_desc=""
	    case "$current_branch" in
	      fix/*)
	        _primary_skill="freely-fix-execution"
	        _flow_desc="Fix first, govern later → 代码已实现，补 IBM 治理文档"
	        ;;
	      feature/*)
	        _primary_skill="freely-feature-execution"
	        _flow_desc="Govern first, code later → 先完成 IBM 治理，再实现代码"
	        ;;
	      *)
	        _primary_skill="freely-fix-execution（无法从分支名判断，假定 fix）"
	        _flow_desc="无法从分支名判断 fix/feature，请检查工位"
	        ;;
	    esac
	    cat >&2 <<GATE_BLOCKED

╔══════════════════════════════════════════════════════════════╗
║  [GOVERNANCE-GATE] IBM 治理门禁未通过                        ║
╠══════════════════════════════════════════════════════════════╣
║                                                              ║
║  本工位对应 skill: ${_primary_skill}                                ║
║  ${_flow_desc}
║                                                              ║
║  根因：未按上述 skill 的规范流程完成治理。                       ║
║                                                              ║
║  不要直接对着下方错误逐条改！                                   ║
║  正确做法：                                                   ║
║    1. 完整阅读 skill:${_primary_skill}（核心原则、工作流、场景）     ║
║    2. 看 skill:freely-doc-B1_IBM-execution §门禁常见坑速查       ║
║    3. 看 skill:freely-doc-B2_IBM-execution §门禁常见坑速查       ║
║    4. 坑速查找不到 → 看两个 skill 中的模板/示例                 ║
║    5. 还是找不到 → 按语义理解，对照 skill 模板交叉验证后修正       ║
║    6. 理解全部错误再开始改，不要改一条验一条                     ║
║                                                              ║
║  离开「对着错误凑」的习惯——门禁说缺什么，skill 说怎么做。         ║
║                                                              ║
║  详细错误:                                                    ║
║  $gate_output
║                                                              ║
╚══════════════════════════════════════════════════════════════╝

GATE_BLOCKED
	    exit 1
	  fi
  echo "$gate_output"
  echo "[GOVERNANCE-GATE] IBM governance artifacts: OK"
else
  echo "[WARN] governance-merge-gate not found, skipping IBM gate check"
fi
echo ""

# ── Step 2c: Pretests execution evidence check ──
# Checks that pretests execution evidence exists before allowing PR creation.
# Mirrors the check in wt-close to catch untested code before PR creation.
echo "Step 2d/4: pretests execution evidence check..."
# Use the current worktree as both project (for issue/doc lookup) and worktree path
# (for runtime evidence). During development, governance files live in the worktree
# alongside the code changes, so the worktree root is the correct project root here.
if [[ -x "$ROOT_DIR/bin/pretests-retirement-gate" ]]; then
  set +e
  _gate_output="$("$ROOT_DIR/bin/pretests-retirement-gate" --project "$ROOT_DIR" --worktree-path "$ROOT_DIR" 2>&1)"
  _gate_rc=$?
  set -e
  if [[ "$_gate_rc" -ne 0 ]]; then
    cat >&2 <<PRETEST_GATE_BLOCKED

╔══════════════════════════════════════════════════════════════╗
║  [PRETESTS-GATE] 测试门禁未通过                               ║
╠══════════════════════════════════════════════════════════════╣
║                                                              ║
║  测试分为两个阶段，缺一不可：                                    ║
║                                                              ║
║  RED — 测试方案设计（B2_IBM 产物）:                              ║
║    阅读 skill:freely-doc-B2_IBM-execution                      ║
║    根据本次修改目标，在 pre-tests.md 中设计合理的测试方案            ║
║    方案应根据改动类型选择：AI 相关 md、测试脚本、端到端测试             ║
║                                                              ║
║  GREEN — 测试执行证据（test-execution 产物）:                     ║
║    阅读 skill:freely-test-execution                             ║
║    根据 pre-tests.md 设计的方案实际执行测试                         ║
║    不要改 status 字段假装通过——去跑测试，写回真实结果                 ║
║                                                              ║
║  离开「对着错误凑字段」的习惯——门禁说缺什么，skill 说怎么做。         ║
║                                                              ║
║  详细错误:                                                    ║
║  $_gate_output
║                                                              ║
╚══════════════════════════════════════════════════════════════╝

PRETEST_GATE_BLOCKED
    exit 1
  fi
  echo "[PRETESTS-GATE] pretests execution evidence: OK ✓"
else
  echo "[WARN] pretests-retirement-gate not found, skipping pretests evidence check"
fi
echo ""

# ── Step 2d: Comment resolution check ──
# Scans raw issue comments on all platforms. Blocks PR if any human comment
# lacks a resolution sub-comment (adopted/discarded).
echo "Step 2e/4: comment resolution check..."
_comment_check_failed=0
for _raw_file in $(find "$ROOT_DIR/docs/issues" -maxdepth 2 -name "issue.md" -path "*/raw-*" 2>/dev/null); do
  _raw_text="$(cat "$_raw_file")"
  # Check for human comments without resolution
  _unresolved=$(echo "$_raw_text" | grep -c "^### comment-" 2>/dev/null || true)
  _resolved=$(echo "$_raw_text" | grep -c "^#### resolution-" 2>/dev/null || true)
  if [[ "$_unresolved" -gt "$_resolved" ]]; then
    _raw_id=$(basename "$(dirname "$_raw_file")")
    echo "  $_raw_id: $_unresolved comments, $_resolved resolutions — $_((_unresolved - _resolved)) unresolved"
    _comment_check_failed=1
  fi
done
if [[ "$_comment_check_failed" -eq 1 ]]; then
  cat >&2 <<COMMENT_GATE_BLOCKED
========================================
评论 resolution 检查未通过

以上 raw issue 存在未标记 resolution 的评论。
每条人类评论必须有子评论标记 adopted（采纳）或 discarded（丢弃）。

修复方式：
  对每条未处理评论，在 issue.md 中添加：
  #### resolution-{timestamp}
  - status: adopted | discarded
  - reason: <理由>
  - resolved_by: <agent_id>

========================================
COMMENT_GATE_BLOCKED
  exit 1
fi
echo "  all comments resolved"
echo ""

# ── Gate-passed marker ──
mkdir -p .freely/run
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > .freely/run/pr-create-gate-passed
echo ""

# ── Step 3: Rebase onto latest develop (all gates passed, now sync before push) ──
# Rebase replays each commit individually onto the latest base, preventing a single
# merge commit from crossing checkpoint-guard scope budgets when develop has files
# from other merged PRs. Conflicts surface per-commit instead of all at once.
echo "Step 3/4: rebasing $current_branch onto latest $base..."
if ! git pull --no-rebase origin "$base" 2>&1; then
  conflicted_files=$(git diff --name-only --diff-filter=U 2>/dev/null || true)
  cat >&2 <<CONFLICT
========================================
冲突: $current_branch merge 到 $base 时出现冲突

冲突文件:
$(if [[ -n "$conflicted_files" ]]; then echo "$conflicted_files" | sed 's/^/  /'; else echo "  (无法列出冲突文件，请执行 git status 查看)"; fi)

解决方案（二选一）:

  方案A: 手动解决冲突后继续 merge 冲突
    # 编辑冲突文件，解决冲突
    git add <resolved-files>
    git add <resolved-files> && git merge --continue  # 继续 merge
    # 如果还有冲突，重复上述步骤直到 merge 完成
    ./bin/pr-create-guarded  # 重新运行

  方案B: 放弃本次 merge
    git merge --abort          # 回到 merge 前状态
    # 修复冲突根源后重新运行
    ./bin/pr-create-guarded

========================================
CONFLICT
  exit 1
fi
echo ""

# ── Step 4: Push branch + Create PR on each configured platform ──
# Principle: push branch to platform X, create PR on platform X.
# Never push to A then PR on B (cross-platform = empty PR).
# Reads FREELY_REPO_PLATFORMS (comma-separated, e.g. "github,gitee").
# Each platform maps to: remote name, optional CLI for PR creation.
echo "Step 3/4: pushing + PR on all platforms..."

# Build PR defaults
if [[ -z "${title:-}" ]]; then
  title="$(echo "$current_branch" | sed 's/.*raw-[0-9]*T[0-9]*Z-//; s/-/ /g')"
fi
if [[ -z "${body:-}" ]]; then
  body="See commits for details."
fi

_platform_configs() {
  local configured="${FREELY_REPO_PLATFORMS:-}"
  if [[ -n "$configured" ]]; then
    printf '%s\n' "$configured" | tr ',' '\n'
  else
    # Auto-detect: check remote URLs to identify platforms.
    # Uses URL matching so any remote name (origin, upstream, etc.) works.
    # Also keeps name-based detection for backward compatibility.
    local found_github=0 found_gitee=0 found_gitlab=0
    while IFS= read -r remote; do
      [[ -z "$remote" || "$remote" == "all" ]] && continue
      local url
      url=$(git remote get-url "$remote" 2>/dev/null || true)
      case "$url" in
        *github.com*|*github-*|*github*)  found_github=1 ;;
        *gitee.com*|*gitee-*|*gitee*)      found_gitee=1 ;;
        *gitlab.com*|*gitlab-*|*gitlab*)    found_gitlab=1 ;;
      esac
      # Also check remote name as fallback
      case "$remote" in
        github) found_github=1 ;;
        gitee)  found_gitee=1 ;;
        gitlab) found_gitlab=1 ;;
      esac
    done < <(git remote)
    [[ "$found_github" == "1" ]] && echo "github"
    [[ "$found_gitee" == "1" ]] && echo "gitee"
    [[ "$found_gitlab" == "1" ]] && echo "gitlab"
    # If nothing detected, fall back to origin only
    if [[ "$found_github" == "0" && "$found_gitee" == "0" && "$found_gitlab" == "0" ]]; then
      git remote | grep -v '^all$' | while read -r r; do echo "$r"; done
    fi
  fi | sort -u
}

_platform_cli() {
  case "$1" in
    github) echo "gh" ;;
    gitee)  echo "gitee" ;;
    *)      echo "" ;;
  esac
}

_platform_remote_name() {
  case "$1" in
    gitee) git remote | grep -q '^gitee$' && echo "gitee" || echo "origin" ;;
    *)     echo "$1" ;;
  esac
}

platforms=$(_platform_configs)
if [[ -z "$platforms" ]]; then
  echo "ERROR: no platforms. Set FREELY_REPO_PLATFORMS or add remotes." >&2
  exit 1
fi
echo "Platforms: $(echo "$platforms" | tr '\n' ' ')"

pushed_any=0
pr_created_any=0
for platform in $platforms; do
  remote=$(_platform_remote_name "$platform")

  # Push branch to this platform
  echo "  [$platform] pushing branch..."
  if git push --force-with-lease "$remote" "$current_branch" 2>&1; then
    pushed_any=1
    echo "  [$platform] push ✓"
  else
    echo "  [$platform] push FAILED" >&2
    continue
  fi
done
echo ""

if [[ "$pushed_any" == "0" ]]; then
  echo "ERROR: failed to push to any platform" >&2
  exit 1
fi

# Create PR on all platforms via platform-adapter (#3340)
echo "  Creating PR via platform-adapter..."
_adapter="$ROOT_DIR/docs/system/workspace/scripts/sync/platform-adapter.py"
_pr_result="$(python3 "$_adapter" create-pr "$current_branch" "$base" "$title" "$body" 2>&1)" || true
echo "$_pr_result"

# Check if at least one platform succeeded
if echo "$_pr_result" | grep -q '"status": "created"'; then
  pr_created_any=1
fi

if [[ "$pr_created_any" == "1" ]]; then
  echo ""
  echo "Next: ./bin/pr-review-guarded $current_branch"
  echo ""
else
  echo "WARNING: PR not created on any platform (manual PR may be needed)" >&2
fi
