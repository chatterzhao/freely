#!/usr/bin/env bash
set -euo pipefail

# pr-create-guarded: pull latest develop → handle conflicts → dry-run gate → push → create PR
#
# Usage:
#   ./bin/pr-create-guarded [--title <title>] [--body <body>] [--base <branch>]
#
# Must be run inside a fix/raw-* or feature/raw-* worktree.

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$ROOT_DIR" ]] || { echo "ERROR: not in a git repository" >&2; exit 1; }
cd "$ROOT_DIR"

current_branch="$(git rev-parse --abbrev-ref HEAD)"
case "$current_branch" in
  develop|main|test-pre-merge-*)
    echo "拒绝: 不能在受保护分支 '$current_branch' 上执行 pr-create-guarded。" >&2
    echo "请在 fix/raw-* 或 feature/raw-* 工位中执行。" >&2
    exit 1
    ;;
esac

title="${1:-}"
body="${2:-}"
base="${3:-develop}"

echo "=== pr-create-guarded: $current_branch → $base ==="
echo ""

# ── Step 1: Pull latest develop into current branch ──
echo "Step 1/4: pulling latest $base into $current_branch..."
if ! git pull origin "$base" 2>&1; then
  cat >&2 <<CONFLICT
========================================
冲突: $base 合并到 $current_branch 时出现冲突

请在当前工位中手动解决冲突:
  git mergetool 或手动编辑冲突文件
  git add <resolved-files>
  git commit

然后重新运行:
  ./bin/pr-create-guarded
========================================
CONFLICT
  exit 1
fi
echo ""

# ── Step 2: dry-run merge gate ──
echo "Step 2/4: dry-run merge gate..."
if [[ -x "$ROOT_DIR/bin/pr-merge-guarded" ]]; then
  "$ROOT_DIR/bin/pr-merge-guarded" --dry-run "$base" "$current_branch"
  if [[ $? -ne 0 ]]; then
    echo ""
    echo "dry-run 门禁未通过。请修复后重试。"
    exit 1
  fi
else
  echo "[WARN] pr-merge-guarded not found, skipping dry-run"
fi

# ── Step 2b: IBM governance gate (early check before PR creation) ──
# Runs governance-merge-gate on the diff between base and current branch.
# Catches missing IBM lifecycle artifacts (candidate, I-*, milestone)
# BEFORE pushing and creating PR — gives developer clear fix instructions.
echo ""
echo "Step 2b/4: IBM governance gate..."
if [[ -x "$ROOT_DIR/bin/governance-merge-gate" ]]; then
  set +e
  gate_output="$("$ROOT_DIR/bin/governance-merge-gate" --range "$base..HEAD" 2>&1)"
  gate_rc=$?
  set -e
  if [[ "$gate_rc" -ne 0 ]]; then
    cat >&2 <<GATE_BLOCKED

╔══════════════════════════════════════════════════════════════╗
║  [GOVERNANCE-GATE] IBM 治理门禁未通过                        ║
╠══════════════════════════════════════════════════════════════╣
║                                                              ║
║  你的分支缺少完整的 IBM 生命周期治理文档。                     ║
║  在创建 PR 之前，请先完成以下步骤:                             ║
║                                                              ║
║  skill:freely-doc-B1_IBM-execution                           ║
║    → raw issue → brainstorm → candidate → milestones.md       ║
║                                                              ║
║  skill:freely-doc-B2_IBM-execution                           ║
║    → I-* issue → prd.md → tasks.md → pre-tests → code-review  ║
║    → milestones.md committed_issues                           ║
║                                                              ║
║  详见 docs/system/workspace/ibm-framework.md                  ║
║                                                              ║
║  详细错误:                                                    ║
║  $gate_output
║                                                              ║
║  修复后重新运行 ./bin/pr-create-guarded                       ║
╚══════════════════════════════════════════════════════════════╝

GATE_BLOCKED
    exit 1
  fi
  echo "$gate_output"
  echo "[GOVERNANCE-GATE] IBM governance artifacts: OK"
else
  echo "[WARN] governance-merge-gate not found, skipping IBM gate check"
fi
echo ""

# ── Step 2b: Write gate-passed marker ──
mkdir -p .freely/run
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > .freely/run/pr-create-gate-passed
echo ""

# ── Step 3+4: Push branch + Create PR on each configured platform ──
# Principle: push branch to platform X, create PR on platform X.
# Never push to A then PR on B (cross-platform = empty PR).
# Reads FREELY_REPO_PLATFORMS (comma-separated, e.g. "github,gitee").
# Each platform maps to: remote name, optional CLI for PR creation.
echo "Step 3/4: pushing + PR on all platforms..."

# Build PR defaults
if [[ -z "${title:-}" ]]; then
  title="$(echo "$current_branch" | sed 's/.*raw-[0-9]*T[0-9]*Z-//; s/-/ /g')"
fi
if [[ -z "${body:-}" ]]; then
  body="See commits for details."
fi

_platform_configs() {
  local configured="${FREELY_REPO_PLATFORMS:-}"
  if [[ -n "$configured" ]]; then
    printf '%s\n' "$configured" | tr ',' '\n'
  else
    # Auto-detect: check remote URLs to identify platforms.
    # Uses URL matching so any remote name (origin, upstream, etc.) works.
    # Also keeps name-based detection for backward compatibility.
    local found_github=0 found_gitee=0 found_gitlab=0
    while IFS= read -r remote; do
      [[ -z "$remote" || "$remote" == "all" ]] && continue
      local url
      url=$(git remote get-url "$remote" 2>/dev/null || true)
      case "$url" in
        *github.com*|*github-*|*github*)  found_github=1 ;;
        *gitee.com*|*gitee-*|*gitee*)      found_gitee=1 ;;
        *gitlab.com*|*gitlab-*|*gitlab*)    found_gitlab=1 ;;
      esac
      # Also check remote name as fallback
      case "$remote" in
        github) found_github=1 ;;
        gitee)  found_gitee=1 ;;
        gitlab) found_gitlab=1 ;;
      esac
    done < <(git remote)
    [[ "$found_github" == "1" ]] && echo "github"
    [[ "$found_gitee" == "1" ]] && echo "gitee"
    [[ "$found_gitlab" == "1" ]] && echo "gitlab"
    # If nothing detected, fall back to origin only
    if [[ "$found_github" == "0" && "$found_gitee" == "0" && "$found_gitlab" == "0" ]]; then
      git remote | grep -v '^all$' | while read -r r; do echo "$r"; done
    fi
  fi | sort -u
}

_platform_cli() {
  case "$1" in
    github) echo "gh" ;;
    gitee)  echo "gitee" ;;
    *)      echo "" ;;
  esac
}

_platform_remote_name() {
  case "$1" in
    gitee) git remote | grep -q '^gitee$' && echo "gitee" || echo "origin" ;;
    *)     echo "$1" ;;
  esac
}

platforms=$(_platform_configs)
if [[ -z "$platforms" ]]; then
  echo "ERROR: no platforms. Set FREELY_REPO_PLATFORMS or add remotes." >&2
  exit 1
fi
echo "Platforms: $(echo "$platforms" | tr '\n' ' ')"

pushed_any=0
pr_created_any=0
for platform in $platforms; do
  remote=$(_platform_remote_name "$platform")

  # Step A: Push branch to this platform (always)
  echo "  [$platform] pushing branch..."
  if git push "$remote" "$current_branch" 2>&1; then
    pushed_any=1
    echo "  [$platform] push ✓"
  else
    echo "  [$platform] push FAILED — skipping PR" >&2
    continue
  fi

  # Step B: Create PR on this platform (if CLI available)
  cli=$(_platform_cli "$platform")
  if [[ -z "$cli" ]] || ! command -v "$cli" >/dev/null 2>&1; then
    echo "  [$platform] no CLI ($cli), skipping PR"
    continue
  fi

  echo "  [$platform] creating PR via $cli..."
  if [[ "$cli" == "gh" ]]; then
    if gh pr create --head "$current_branch" --base "$base" \
         --title "$title" --body "$body" 2>&1; then
      pr_created_any=1; echo "  [$platform] PR created ✓"
    else
      echo "  [$platform] PR creation FAILED" >&2
    fi
  elif [[ "$cli" == "gitee" ]]; then
    if gitee pr create --head "$current_branch" --base "$base" \
         --title "$title" --body "$body" 2>&1; then
      pr_created_any=1; echo "  [$platform] PR created ✓"
    else
      echo "  [$platform] PR creation FAILED" >&2
    fi
  fi
done
echo ""

if [[ "$pushed_any" == "0" ]]; then
  echo "ERROR: failed to push to any platform" >&2
  exit 1
fi
if [[ "$pr_created_any" == "0" ]]; then
  echo "WARNING: PR not created on any platform (manual PR may be needed)" >&2
fi
