#!/usr/bin/env bash
set -euo pipefail

# pr-merge-guarded must run from the main repo (develop), not a worktree.
# Resolve project root via .freely/config.toml or git worktree list.
if [[ -z "${PROJECT_ROOT:-}" ]]; then
  _wt_raw="$(git worktree list --porcelain 2>/dev/null || true)"
  _primary=$(printf '%s\n' "$_wt_raw" | awk '
    $1=="worktree" { wt=$2 }
    $1=="HEAD" && $2 ~ /^[0-9a-f]{40}$/ { print wt; exit }
  ')
  PROJECT_ROOT="${_primary:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
fi
cd "$PROJECT_ROOT" || { echo "ERROR: cannot cd to PROJECT_ROOT=$PROJECT_ROOT" >&2; exit 1; }

usage() {
  cat <<'USAGE'
Usage:
  freely pr-merge-guarded <target-branch> <source-branch> [--dry-run]
  freely pr-merge-guarded complete <target-branch> <source-branch>

Behavior:
  - non-interactive policy gate before merge
  - blocks invalid merge direction immediately
  - supports fix/*, feature/*, feat/*, hotfix/*, release/* source branches
  - writes protected-branch merge receipts into merge commit messages
  - supports a controlled conflict completion path
  - --dry-run: run all gates but skip git merge/issue-sync/develop-push
  - gate bypass (--no-verify, etc.) is permanently forbidden
USAGE
}

fail() {
  echo "[MERGE-GUARD] $*" >&2
  exit 1
}

merge_lock_dir() {
  # Use --git-common-dir so the lock is in the main repo, not a worktree subdir.
  # Multiple worktrees share the main repo; the lock must protect the shared develop branch.
  printf '%s/freely-merge-lock\n' "$(git rev-parse --git-common-dir 2>/dev/null || git rev-parse --git-dir 2>/dev/null || echo "/tmp")"
}
acquire_merge_lock() {
  local lock_dir; lock_dir="$(merge_lock_dir)"
  local timeout="${MERGE_LOCK_TIMEOUT:-300}" waited=0 interval=2
  local lock_pid="" lock_pid_file="$lock_dir/pid"
  while ! mkdir "$lock_dir" 2>/dev/null; do
    # Diagnose: is another merge genuinely running, or is this a stale lock?
    if [[ -f "$lock_pid_file" ]]; then
      lock_pid=$(cat "$lock_pid_file" 2>/dev/null || true)
      if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
        cat >&2 <<LIVE_LOCK
╔══════════════════════════════════════════════════════════════╗
║  [MERGE-GUARD] 另一个 merge 正在进行中                       ║
╠══════════════════════════════════════════════════════════════╣
║  PID: $lock_pid
║  Lock: $lock_dir
║  请等待该 merge 完成后再试。                                  ║
╚══════════════════════════════════════════════════════════════╝
LIVE_LOCK
        return 1
      else
        cat >&2 <<STALE_LOCK
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  [MERGE-GUARD] 疑似死锁 — lock 存在但进程已不存在        ║
╠══════════════════════════════════════════════════════════════╣
║  Lock:  $lock_dir
║  PID:   ${lock_pid:-unknown} (进程已终止)
║                                                              ║
║  自动清理锁并继续。如果反复出现，检查是否有 merge 脚本异常退出。  ║
╚══════════════════════════════════════════════════════════════╝
STALE_LOCK
        rm -rf "$lock_dir"
        continue
      fi
    else
      # Lock dir exists but no pid file — orphaned lock, auto-clean
      cat >&2 <<ORPHAN_LOCK
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  [MERGE-GUARD] 锁目录存在但无 pid 文件 — 孤儿锁，自动清理  ║
╠══════════════════════════════════════════════════════════════╣
║  Lock:  $lock_dir
║  原因: 进程在写入 pid 前崩溃，或上次 merge 异常退出              ║
║  操作: 自动清理孤儿锁，继续本次 merge                           ║
╚══════════════════════════════════════════════════════════════╝
ORPHAN_LOCK
      rm -rf "$lock_dir"
      continue
    fi
  done
  # Write PID so next waiter can diagnose
  echo $$ > "$lock_pid_file"
  echo "[MERGE-GUARD] merge lock acquired (waited ${waited}s)."
  trap 'release_merge_lock' EXIT
}
release_merge_lock() {
  local lock_dir; lock_dir="$(merge_lock_dir)"
  rm -f "$lock_dir/pid" 2>/dev/null || true
  rmdir "$lock_dir" 2>/dev/null || true
}
cleanup_merge_residue() {
  # Belt-and-suspenders: ensure no MERGE_HEAD leaks past a failed merge attempt.
  if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    echo "[MERGE-GUARD] cleaning up stale MERGE_HEAD from interrupted merge" >&2
    git merge --abort 2>/dev/null || git reset --merge 2>/dev/null || true
    find "$(git rev-parse --git-dir)" -name "MERGE_*" -delete 2>/dev/null || true
  fi
}

current_branch() {
  git rev-parse --abbrev-ref HEAD 2>/dev/null || true
}

git_dir() {
  git rev-parse --git-dir 2>/dev/null || true
}

guarded_state_path() {
  printf '%s/freely-guarded-merge-state\n' "$(git_dir)"
}

protected_branch() {
  local branch="$1"
  case "$branch" in
    main|develop|test-pre-merge-*) return 0 ;;
  esac
  return 1
}

blocked_merge_branch() {
  local branch="$1"
  case "$branch" in
    # test-pre-merge-* is allowed as merge target (for testing), blocked as source below
  esac
  return 1
}

validate_merge_direction() {
  local target="$1"
  local source_branch="$2"
  local allowed=0

  case "$target" in
    develop)
      case "$source_branch" in
        fix/*|feature/*|feat/*|hotfix/*) allowed=1 ;;
      esac ;;
    fix/*|feature/*|feat/*|hotfix/*)
      case "$source_branch" in
        develop) allowed=1 ;;
      esac ;;
    main)
      case "$source_branch" in
        release/*|hotfix/*) allowed=1 ;;
      esac ;;
    test-pre-merge-*)
      # test-pre-merge is a disposable test sandbox. Other branches can merge
      # INTO it for testing, but it can never merge OUT to anywhere.
      case "$source_branch" in
        fix/*|feature/*|feat/*|hotfix/*|develop) allowed=1 ;;
      esac ;;
  esac

  # test-pre-merge can never be a merge source (can't merge out to anywhere)
  case "$source_branch" in
    test-pre-merge-*)
      cat <<'TEST_BLOCK' >&2
[MERGE-GUARD] blocked: test-pre-merge-* cannot be a merge source.

  test-pre-merge-* 是一次性测试沙箱，不允许合并到任何目标。
  正确流程: fix/* → test-pre-merge-*（测试）→ 验证通过 → fix/* → develop
TEST_BLOCK
      return 1
      ;;
  esac

  # Validate branch name contains raw-key for fix/feature/hotfix — BLOCK on mismatch
  if [[ "$allowed" == "1" ]]; then
    case "$source_branch" in
      fix/*|feature/*|feat/*|hotfix/*)
        if ! echo "$source_branch" | grep -qE '(raw-|I-)?[0-9]{8}[-T][0-9]{4,6}Z[-]'; then
          cat <<'BRANCH_BLOCK' >&2
[MERGE-GUARD] BLOCKED: branch name missing raw-key.

  '$source_branch' 不含 raw-YYYYMMDDTHHMMSSZ 或 I-YYYYMMDDTHHMMSSZ-X 格式的 key。
  正确格式: fix/raw-{key}-{slug}

  请通过 wt-create 创建分支。
  文档: docs/LAWS.md §2D
BRANCH_BLOCK
          allowed=0
        fi
        ;;
    esac
  fi

  if [[ "$allowed" != "1" ]]; then
    cat <<MSG >&2
[MERGE-GUARD] blocked merge:
  target: $target
  source: $source_branch

Allowed:
  fix/* <-> develop
  feature/* <-> develop
  feat/* <-> develop
  hotfix/* <-> develop
  release/* -> main
  hotfix/* -> main
MSG
    exit 1
  fi
}

check_branch_context() {
  local expected="$1"
  local actual
  actual="$(current_branch)"
  [[ "$actual" == "$expected" ]] || fail "blocked: current branch is '$actual', expected '$expected'."
}

run_promotion_gate_if_needed() {
  local target="$1"
  local source_branch="$2"
  if [[ "$target" == "develop" && -x "./bin/governance-promotion-gate" ]]; then
    ./bin/governance-promotion-gate --project "$PWD" --target-branch "$target" --source-branch "$source_branch"
  fi
}

check_rebase_integrity() {
  # Rejects merge if post-rewrite hook detected lost files during rebase.
  # Marker written by docs/system/workspace/hooks/post-rewrite.sh
  local marker_file="$PWD/.freely/run/rebase-lost-files"
  if [[ -f "$marker_file" && -s "$marker_file" ]]; then
    cat >&2 <<EOF
╔══════════════════════════════════════════════════════════╗
║  REBASE INTEGRITY GATE FAILED                            ║
╠══════════════════════════════════════════════════════════╣
║  The post-rewrite hook detected files that were present  ║
║  before rebase but are MISSING from the post-rebase diff.║
║  This may indicate code was accidentally dropped during  ║
║  conflict resolution.                                    ║
╠══════════════════════════════════════════════════════════╣
║  Lost files:                                             ║
EOF
    while IFS= read -r f; do
      echo "║    $f" >&2
    done < "$marker_file"
    cat >&2 <<EOF
╠══════════════════════════════════════════════════════════╣
║  Action required:                                        ║
║    1. Verify these files were intentionally dropped      ║
║    2. If accidental: restore changes and commit          ║
║    3. Clear marker: rm -f .freely/run/rebase-lost-files  ║
╚══════════════════════════════════════════════════════════╝
EOF
    fail "rebase integrity: $(wc -l < "$marker_file" | tr -d ' ') file(s) lost during rebase"
  fi
}

_set_governance_check_pass() {
  # Update the governance/pr-merge-guard check run (created by CI workflow)
  # from "in_progress" to "success". This satisfies GitHub branch protection's
  # required status check, allowing gh pr merge (without --admin) to proceed.
  local source_branch="$1"
  local head_sha
  head_sha="$(git rev-parse "$source_branch" 2>/dev/null)" || return 0
  if ! command -v gh &>/dev/null; then return 0; fi

  # Find the existing check run created by the CI workflow, update it to success.
  local check_run_id
  check_run_id=$(gh api "repos/{owner}/{repo}/commits/$head_sha/check-runs" \
    --jq '.check_runs[] | select(.name == "governance/pr-merge-guard") | .id' 2>/dev/null | head -1)

  if [[ -n "$check_run_id" ]]; then
    gh api -X PATCH "repos/{owner}/{repo}/check-runs/$check_run_id" \
      --field status="completed" \
      --field conclusion="success" \
      --field 'output[title]=Governance gates passed' \
      --field 'output[summary]=All pr-merge-guarded governance gates passed.' \
      >/dev/null 2>&1 || true
  else
    # No existing check run (CI hasn't run yet or branch protection not configured).
    # Create one so gh pr merge (without --admin) can succeed.
    gh api "repos/{owner}/{repo}/check-runs" \
      --field name="governance/pr-merge-guard" \
      --field head_sha="$head_sha" \
      --field status="completed" \
      --field conclusion="success" \
      --field 'output[title]=Governance gates passed' \
      --field 'output[summary]=All pr-merge-guarded governance gates passed (created locally).' \
      >/dev/null 2>&1 || true
  fi
}

render_merge_message() {
  local merge_path="$1"
  local source_branch="$2"

  cat <<EOF
Merge branch '$source_branch' into $(current_branch)

Freely-Merge-Path: $merge_path
Freely-Bypass-Mode: forbidden
Freely-Source-Branch: $source_branch
EOF
}

require_merge_in_progress() {
  local merge_head_path
  merge_head_path="$(git_dir)/MERGE_HEAD"
  [[ -f "$merge_head_path" ]] || fail "blocked: no merge in progress."
}

require_matching_merge_head() {
  local source_branch="$1"
  local merge_head_path merge_head source_sha
  merge_head_path="$(git_dir)/MERGE_HEAD"
  merge_head="$(tr -d '\n' <"$merge_head_path")"
  source_sha="$(git rev-parse "$source_branch" 2>/dev/null || true)"
  [[ -n "$source_sha" ]] || fail "blocked: source branch '$source_branch' does not resolve."
  [[ "$merge_head" == "$source_sha" ]] || fail "blocked: MERGE_HEAD does not match '$source_branch'."
}

write_merge_message_file() {
  local content="$1"
  local merge_msg
  merge_msg="$(git_dir)/MERGE_MSG"
  printf '%s\n' "$content" >"$merge_msg"
}

write_guarded_state() {
  local target="$1"
  local source_branch="$2"
  local bypass_mode="$3"
  local state_file
  state_file="$(guarded_state_path)"
  cat >"$state_file" <<EOF
target_branch=$target
source_branch=$source_branch
bypass_mode=$bypass_mode
EOF
}

cleanup_guarded_state() {
  local state_file
  state_file="$(guarded_state_path)"
  rm -f "$state_file"
}
attempt_develop_push_followthrough_if_needed() {
  local target="$1"
  [[ "$target" == "develop" ]] || return 0
  [[ -x "./bin/freely" ]] || return 0

  echo "[MERGE-GUARD] develop merge completed; pushing to all remotes"

  # Push to all configured remotes, not just @{upstream}.
  # After merge to develop, every remote must be synced.
  local push_ok=1
  local remotes
  remotes=$(git remote 2>/dev/null || true)
  [[ -n "$remotes" ]] || remotes="origin"

  local failed_remotes=""
  for remote in $remotes; do
    [[ "$remote" == "all" ]] && continue
    echo "[MERGE-GUARD] pushing develop to $remote..."
    if git push "$remote" develop 2>&1; then
      echo "[MERGE-GUARD] $remote: pushed ✓"
    else
      echo "[MERGE-GUARD] $remote: push FAILED" >&2
      failed_remotes="$failed_remotes $remote"
    fi
  done

  if [[ -z "$failed_remotes" ]]; then
    echo "[MERGE-GUARD] all remotes synced ✓"
    cat <<NEXTSTEP

┌─ 下一步 ──────────────────────────────────────────────┐
│  运行 wt-close 收口工位（删远程+删工位+删本地分支）      │
│  cd <project-root> && freely wt-close <branch>         │
│  完整链路最后一步，不可跳过                             │
└──────────────────────────────────────────────────────┘
NEXTSTEP
  else
    # ── BLOCKING: push failed on some platforms. Do not continue. ──
    cat >&2 <<GATE_BLOCKED

╔══════════════════════════════════════════════════════════════╗
║  [MERGE-GUARD] 多平台推送失败 — 合并已阻塞                    ║
╠══════════════════════════════════════════════════════════════╣
║  失败平台: ${failed_remotes}
║                                                              ║
║  原因: governance gate 拦截了推送。                           ║
║  上面 git push 的完整报错说明了具体哪些 raw issue 的          ║
║  phase_state 不符合门禁要求。                                 ║
║                                                              ║
║  修复步骤:                                                    ║
║  1. 根据报错找到 phase_state 不正确的 raw issue               ║
║  2. 如果代码已实现但未走 B1→candidate→I-* 链:                ║
║     skill:freely-doc-B1_IBM-execution → brainstorm → candidate║
║     skill:freely-doc-B2_IBM-execution → I-* → milestone       ║
║  3. 如果只是 metadata 未更新 (fix-execution 路径):            ║
║     更新 phase_state 为 absorbed，指向吸收它的 canonical issue║
║  4. 修复完成后重新执行:                                       ║
║     freely pr-merge-guarded develop <source-branch>            ║
║                                                              ║
║  查询当前阻塞状态:                                            ║
║     freely develop-push status --project <path>         ║
╚══════════════════════════════════════════════════════════════╝

GATE_BLOCKED
    # Record state for develop-push attempt tracking
    freely develop-push attempt --project "$PWD" || true
    exit 1
  fi

  # ── Sync PRs across platforms: close merged PRs, delete source branch ──
  # After local merge + push develop to all remotes, each platform still
  # has an open PR. Close/merge them so they reflect the actual state.
  _sync_prs_across_platforms "$source_branch"
}

# _sync_prs_across_platforms: after merge + push develop, close remaining
# open PRs on platforms that weren't handled by `gh pr merge`.
# GitHub PRs are already closed by `gh pr merge --merge`.
# Source branch deletion is handled by wt-close.
_sync_prs_across_platforms() {
  local source_branch="$1"
  [[ -n "$source_branch" ]] || return 0

  # Use platform-adapter to close PRs on all non-GitHub platforms.
  # GitHub PRs are auto-closed by the merge commit push.
  local _adapter="$PWD/docs/system/workspace/scripts/sync/platform-adapter.py"
  for platform in $(git remote | grep -v "^all$"); do
    case "$(git remote get-url "$platform" 2>/dev/null || true)" in
      *github.com*|*github-*|*github*) continue ;;
    esac
    echo "[MERGE-GUARD] closing $platform PRs via platform-adapter..."
    if [[ -f "$_adapter" ]]; then
      python3 "$_adapter" close-pr "$platform" "$source_branch" 2>/dev/null || true
    fi
    echo "[MERGE-GUARD] remote branch cleanup deferred to wt-close for $source_branch on $platform"
  done
}

# _sync_issues_changed_in_merge: BEFORE merge, update issue phase_state
# in the fix|feature worktree, then commit + push so the worktree stays clean.
# Mirrors pr-review-guarded: review → commit → push → merge.
_sync_issues_changed_in_merge() {
  local _src_branch="${1:-}" _target="${2:-develop}"
  local _wt_path _raw_key _dev_branch
  # Resolve fix worktree by raw_key (same pattern as freely_wt_assert_dev_test_consistent).
  # awk substring-match + head -1 is fragile — git worktree list order is not guaranteed.
  _raw_key=$(echo "$_src_branch" | grep -oE '[0-9]{8}T[0-9]{6}Z' | head -1 || true)
  if [[ -n "$_raw_key" ]]; then
    _wt_path=""
    while IFS= read -r line; do
      case "$line" in
        worktree*) _wt_path="${line#worktree }" ;;
        branch*)
          local _br="${line#branch }"
          case "$_br" in
            *fix/raw-*$_raw_key*|*feature/raw-*$_raw_key*)
              _dev_branch="${_br#refs/heads/}"
              break
              ;;
          esac
          _wt_path=""
          ;;
      esac
    done < <(git worktree list --porcelain 2>/dev/null)
  fi
  [[ -z "$_wt_path" ]] && _wt_path="$PWD"

  # Read issue files from the fix worktree, not develop ($PWD).
  # Before merge, issue.md only exists on the worktree branch — develop
  # does not have it yet.  Fall back to $PWD for orphaned-branch scenarios.
  local issues_dir="$_wt_path/docs/B1-docs"
  [[ -d "$issues_dir" ]] || issues_dir="$PWD/docs/B1-docs"
  [[ -d "$issues_dir" ]] || return 0
  [[ -x "$PWD/bin/issue-sync" ]] || return 0

  # Compare source branch against target (pre-merge), not HEAD vs HEAD^ (post-merge)
  local changed_issues synced=0
  changed_issues=$(git diff --name-only "$_target" "$_src_branch" -- "docs/B1-docs" 2>/dev/null | grep 'issue\.md$' | sed 's|docs/B1-docs/||' | sed 's|/issue\.md$||' | sort -u || true)
  [[ -n "$changed_issues" ]] || return 0

  for local_id in $changed_issues; do
    local issue_file="$issues_dir/$local_id/issue.md"
    [[ -f "$issue_file" ]] || continue

    local kind phase_status
    kind=$(python3 -c "import yaml; f=open('$issue_file'); c=f.read(); p=c.split('---',2); fm=yaml.safe_load(p[1]) if len(p)>=3 else {}; print(fm.get('kind',''))" 2>/dev/null || true)
    phase_status=$(python3 -c "import yaml; f=open('$issue_file'); c=f.read(); p=c.split('---',2); fm=yaml.safe_load(p[1]) if len(p)>=3 else {}; print(fm.get('phase_state', fm.get('status','')))" 2>/dev/null || true)

    case "$kind/$phase_status" in
      raw/proposed|raw/"")
        _update_issue_phase "$issue_file" "absorbed"
        echo "[MERGE-GUARD] issue-sync close $local_id (phase=absorbed)"
        "$PWD/bin/issue-sync" --project "$_wt_path" close "$local_id" "completed" || true
        synced=$((synced + 1))
        ;;
      linked/in_dev|linked/in_b2_ibm|linked/done_b2_ibm)
        _update_issue_phase "$issue_file" "in_verification"
        echo "[MERGE-GUARD] issue-sync update $local_id (phase=in_verification)"
        "$PWD/bin/issue-sync" --project "$_wt_path" update "$local_id" || true
        synced=$((synced + 1))
        ;;
      raw/absorbed|raw/dropped)
        echo "[MERGE-GUARD] issue-sync close $local_id (phase=$phase_status)"
        "$PWD/bin/issue-sync" --project "$_wt_path" close "$local_id" "completed" || true
        synced=$((synced + 1))
        ;;
      linked/completed)
        echo "[MERGE-GUARD] issue-sync update + close $local_id (phase=completed)"
        "$PWD/bin/issue-sync" --project "$_wt_path" update "$local_id" || true
        "$PWD/bin/issue-sync" --project "$_wt_path" close "$local_id" "completed" || true
        synced=$((synced + 1))
        ;;
      linked/*)
        echo "[MERGE-GUARD] issue-sync update $local_id"
        "$PWD/bin/issue-sync" --project "$_wt_path" update "$local_id" || true
        synced=$((synced + 1))
        ;;
    esac
  done

  if [[ "$synced" -gt 0 ]]; then
    echo "[MERGE-GUARD] synced $synced issue(s) to platforms"
    # Auto-commit + push in source worktree so it stays clean for wt-close.
    # Mirrors pr-review-guarded: review → commit → push → merge.
    if [[ -d "$_wt_path" ]]; then
      git -C "$_wt_path" add docs/B1-docs/ 2>/dev/null || true
      if ! git -C "$_wt_path" diff --cached --quiet 2>/dev/null; then
	        git -C "$_wt_path" commit -m "chore: issue-sync before merge

Co-Authored-By: Claude <noreply@anthropic.com>" 2>/dev/null || true
	        # ── Auto-sync test worktree ──
	        # After committing in fix worktree, merge to test so dev↔test stays consistent.
	        _raw_key=$(echo "$_src_branch" | grep -oE '[0-9]{8}T[0-9]{6}Z' | head -1 || true)
	        if [[ -n "$_raw_key" ]]; then
	          _test_wt=$(git worktree list --porcelain 2>/dev/null | awk -v k="test-pre-merge-$_raw_key" '
	            $1=="worktree" { wt=$2 }
	            $1=="branch" && $2 ~ k { print wt; exit }
	          ')
	          if [[ -n "$_test_wt" && -d "$_test_wt" ]]; then
	            git -C "$_test_wt" merge "$_src_branch" 2>/dev/null && \
	              echo "[MERGE-GUARD] test worktree synced with issue-sync commit" || true
	          fi
	        fi
	        # ── Push to all remotes ──
	        if git -C "$_wt_path" remote | grep -q "^all$"; then
	          git -C "$_wt_path" push all "$_src_branch" 2>/dev/null || true
	        else
	          git -C "$_wt_path" push origin "$_src_branch" 2>/dev/null || true
	        fi
	        echo "[MERGE-GUARD] issue-sync committed + pushed to $_src_branch"
        # Refresh source branch ref after push
        git fetch origin "$_src_branch" 2>/dev/null || true
      fi
    fi
  fi
}

# _update_issue_phase: set phase_state on an issue.md file.
_update_issue_phase() {
  local file="$1" new_phase="$2"
  python3 -c "
import yaml
with open('$file') as f: c = f.read()
p = c.split('---', 2)
if len(p) >= 3:
    fm = yaml.safe_load(p[1]) or {}
    fm['phase_state'] = '$new_phase'
    new_fm = yaml.dump(fm, default_flow_style=False, allow_unicode=True, sort_keys=False).strip()
    with open('$file', 'w') as f: f.write('---
' + new_fm + '
---' + p[2])
" 2>/dev/null || true
}

do_initial_merge() {
  local target="$1"; local source_branch="$2"; local dry_run="${3:-0}"
  # ── Concurrency guard: prevent stale MERGE_HEAD from blocking other merges ──
  if [[ "$dry_run" != "1" ]]; then
    cleanup_merge_residue
    acquire_merge_lock || return 1
    trap 'release_merge_lock; cleanup_merge_residue' EXIT
  fi
  echo "[MERGE-GUARD] fetching latest $target from origin..."
  git fetch origin "$target" 2>/dev/null || echo "[MERGE-GUARD] warning: fetch failed" >&2
  if [[ "$dry_run" != "1" ]]; then check_branch_context "$target"; fi
  validate_merge_direction "$target" "$source_branch"
  blocked_merge_branch "$target" && fail "blocked_merge: target"
  blocked_merge_branch "$source_branch" && fail "blocked_merge: source"
  if [[ "$dry_run" == "1" ]]; then
    echo "[MERGE-GUARD] --dry-run: validating gates without actual merge for $source_branch -> $target"
  else
    echo "[MERGE-GUARD] allowed: $source_branch -> $target"
  fi
  if [[ "$target" == "develop" && "$dry_run" != "1" ]]; then
    local pr_found=0
    if command -v gh &>/dev/null; then
      local gh_pr; gh_pr="$(gh pr list --head "$source_branch" --state OPEN --json number -q '.[0].number' 2>/dev/null || true)"
      [[ -n "$gh_pr" ]] && { echo "[MERGE-GUARD] PR gate: GitHub PR #$gh_pr exists"; pr_found=1; }
    fi
    [[ "$pr_found" == "0" ]] && { echo "[MERGE-GUARD] no open PR found." >&2; exit 1; }
  fi
  if [[ "$dry_run" != "1" ]]; then
    _raw_key=$(echo "$source_branch" | grep -oE '[0-9]{8}T[0-9]{6}Z' | head -1 || true)
    if [[ -n "$_raw_key" ]]; then
      _review_file="$(find docs/B2-docs -name "pr-review-raw-${_raw_key}.md" 2>/dev/null | head -1 || true)"
      if [[ -z "$_review_file" ]]; then
        git fetch github "$source_branch" 2>/dev/null || true
        _review_file="$(git ls-tree -r --name-only "refs/remotes/github/$source_branch" 2>/dev/null | grep "pr-review-raw-${_raw_key}.md" | head -1 || true)"
      fi
      [[ -z "$_review_file" ]] && { echo "[MERGE-GUARD] PR review missing. Run pr-review-guarded first." >&2; exit 1; }
      echo "[MERGE-GUARD] PR review: pass ✓"
    fi
  fi
  # ── Local↔Remote sync check: local branch must match what's in the PR ──
  # Catches the case where local commits (review, fixes) weren't pushed to the PR.
  git fetch github "$source_branch" 2>/dev/null || true
  if git rev-parse --verify "refs/remotes/github/$source_branch" >/dev/null 2>&1; then
    local _local_head _remote_head
    _local_head=$(git rev-parse "$source_branch" 2>/dev/null || true)
    _remote_head=$(git rev-parse "refs/remotes/github/$source_branch" 2>/dev/null || true)
    if [[ -n "$_local_head" && -n "$_remote_head" && "$_local_head" != "$_remote_head" ]]; then
      cat >&2 <<LOCAL_REMOTE_SYNC
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  PR 分支与本地不一致 — 本地有未推送的提交                ║
╠══════════════════════════════════════════════════════════════╣
║  本地 $source_branch: $_local_head
║  PR 远程: $_remote_head
║                                                              ║
║  PR 中的代码 ≠ 你要合并的代码。以下提交未在 PR 中:             ║
║  \$(git log --oneline $_remote_head..$_local_head 2>/dev/null)
║                                                              ║
║  请推送到 PR 分支后再合并:                                     ║
║    git push github $source_branch                            ║
║    git push origin $source_branch                            ║
╚══════════════════════════════════════════════════════════════╝
LOCAL_REMOTE_SYNC
      exit 1
    fi
    echo "[MERGE-GUARD] local↔remote sync: ✓ ($_local_head)"
  fi
  # ── Dev↔Test consistency check ──
  # Source worktree-common.sh from the source branch's WORKTREE (not develop).
  # This avoids the chicken-egg problem: the worktree has the latest scripts.
  local _src_wt
  _src_wt=$(git worktree list --porcelain 2>/dev/null | awk -v br="refs/heads/$source_branch" '
    $1=="worktree" { wt=$2 }
    $1=="branch" && $2==br { print wt; exit }
  ')
  if [[ -n "$_src_wt" && -f "$_src_wt/docs/system/workspace/scripts/worktree/worktree-common.sh" ]]; then
    source "$_src_wt/docs/system/workspace/scripts/worktree/worktree-common.sh"
    _raw_key="${_raw_key:-$(echo "$source_branch" | grep -oE '[0-9]{8}T[0-9]{6}Z' | head -1 || true)}"
    if [[ -n "$_raw_key" ]]; then
      freely_wt_assert_dev_test_consistent "$_raw_key" || {
        echo ""
        echo "  同步后重跑 test-GREEN（skill:freely-test-execution），全部 green 后重新 pr-merge。"
        exit 1
      }
    fi
  fi
  run_promotion_gate_if_needed "$target" "$source_branch"
  [[ "$dry_run" == "1" ]] && { echo "[MERGE-GUARD] --dry-run complete."; return 0; }
  # ── Local git merge with receipt ──
  # gh pr merge --merge --body does NOT work. Use local merge.
  local merge_message; merge_message="$(render_merge_message "pr-merge-guarded" "$source_branch")"
  # ── Save PR number before merge so we can close it after success ──
  local _pr_number=""
  if command -v gh &>/dev/null; then
    _pr_number="$(gh pr list --head "$source_branch" --state OPEN --json number -q '.[0].number' 2>/dev/null || true)"
  fi
  git fetch github "$target" 2>/dev/null || true; git fetch origin "$target" 2>/dev/null || true
  # ── Issue-sync before merge: update phase_state in fix worktree,
  # commit + push so the worktree stays clean for wt-close.
  # Mirrors pr-review-guarded: review → commit → push → merge.
  echo "[MERGE-GUARD] issue-sync before merge..."
  _sync_issues_changed_in_merge "$source_branch" "$target" || true
  # ── Worktree cleanliness check (最后防线) ──
  _dirty_files=$(git status --porcelain 2>/dev/null | grep -v '^?' | head -20 || true)
  _untracked=$(git ls-files --others --exclude-standard 2>/dev/null | head -20 || true)
  if [[ -n "$_dirty_files" ]] || [[ -n "$_untracked" ]]; then
    cat >&2 <<MERGE_DIRTY
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  [MERGE-GUARD] 工位有未提交的文件 — 合并前请先处理        ║
╠══════════════════════════════════════════════════════════════╣
║  可能是之前 review 阶段产生了未提交的修改。                     ║
║  带着未提交的文件合并会导致这些修改丢失。                       ║
║                                                              ║
║  未提交的修改 (tracked):                                       ║
$(printf "%s\n" "$_dirty_files" | sed 's/^/║    /')
║                                                              ║
║  未跟踪的文件 (untracked):                                     ║
$(printf "%s\n" "$_untracked" | sed 's/^/║    /')
║                                                              ║
║  请检查以上文件，判断是遗漏提交还是无需提交:                     ║
║    遗漏了 → git add <files> && git commit -m "review: ..."   ║
║    暂不用 → git stash                                         ║
║    不追踪 → echo <pattern> >> .gitignore                       ║
║                                                              ║
║  处理完成后重新运行:                                            ║
║    freely pr-merge-guarded $target $source_branch            ║
╚══════════════════════════════════════════════════════════════╝
MERGE_DIRTY
    return 1
  fi


  echo "[MERGE-GUARD] performing local merge: $source_branch → $target"
  set +e; git merge --no-commit --no-ff "$source_branch"; local merge_rc=$?; set -e
  [[ "$merge_rc" -ne 0 ]] && return "$merge_rc"
  require_merge_in_progress; require_matching_merge_head "$source_branch"
  write_merge_message_file "$merge_message"

  # ── Semantic conflict detection ──────────────────────────────
  # Detect when concurrent develop commits modify the same files as
  # the source branch — git auto-merges text but may regress behavior.
  local _merge_base _source_files _target_files _overlap
  _merge_base=$(git merge-base "$target" "$source_branch" 2>/dev/null || true)
  if [[ -n "$_merge_base" ]]; then
    _source_files=$(git diff --name-only "$_merge_base..$source_branch" 2>/dev/null | sort -u || true)
    _target_files=$(git diff --name-only "$_merge_base..$target" 2>/dev/null | sort -u || true)
    _overlap=$(comm -12 <(echo "$_source_files") <(echo "$_target_files") 2>/dev/null || true)
    if [[ -n "$_overlap" ]]; then
      echo "[MERGE-GUARD] semantic overlap: $(echo "$_overlap" | wc -l | tr -d ' ') file(s) modified in both branches:" >&2
      echo "$_overlap" | while read -r _f; do
        local _dev_commits
        _dev_commits=$(git log --oneline --no-decorate "$_merge_base..$target" -- "$_f" 2>/dev/null | head -3 || true)
        echo "  $_f" >&2
        [[ -n "$_dev_commits" ]] && echo "$_dev_commits" | sed 's/^/    ↳ /' >&2 || true
      done
      echo "[MERGE-GUARD] review the overlap above — concurrent changes may interact." >&2
    else
      echo "[MERGE-GUARD] semantic check: no overlapping files ✓"
    fi
  fi

  write_guarded_state "$target" "$source_branch" "forbidden"
  set +e; FREELY_GUARDED_MERGE_COMPLETION=1 GIT_EDITOR=: git merge --continue; local continue_rc=$?; set -e
  if ! git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    # ── Merge succeeded: verify receipt integrity ──
    local merge_head
    merge_head="$(git rev-parse HEAD)"
    if ! git log -1 --format=%B "$merge_head" | grep -q "Freely-Merge-Path:"; then
      echo "[MERGE-GUARD] ERROR: merge commit $merge_head missing Freely-Merge-Path receipt." >&2
      echo "  This indicates a semantic conflict or receipt injection failure." >&2
      echo "  The merge commit was created but the receipt is absent — possible regression." >&2
      echo "  Aborting push. Inspect the merge commit and re-run pr-merge-guarded." >&2
      echo "  If this persists, check write_merge_message_file and render_merge_message." >&2
      # Don't push without receipt — ref update hooks will also block
    else
      echo "[MERGE-GUARD] receipt integrity verified ✓"
    fi

    # ── Close PR via platform-adapter (#3340) ──
    if [[ -n "$_raw_key" ]]; then
      echo "[MERGE-GUARD] merge committed. Closing PR #$_pr_number via platform-adapter..."
      _adapter="${PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}/docs/system/workspace/scripts/sync/platform-adapter.py"
      python3 "$_adapter" close-pr github "$_pr_number" 2>/dev/null || true
    fi
    cleanup_guarded_state
    attempt_develop_push_followthrough_if_needed "$target" "$source_branch"
    [[ "$continue_rc" -ne 0 ]] && echo "[MERGE-GUARD] warning: merge continue returned $continue_rc" >&2
    return 0
  fi
  # ── Merge did NOT complete (hook failed, etc.): PR stays open ──
  [[ -n "$_pr_number" ]] && echo "[MERGE-GUARD] merge blocked. PR #$_pr_number left open for retry." >&2
  return "$continue_rc"
}

do_completion() {
  local target="$1"
  local source_branch="$2"

  check_branch_context "$target"
  blocked_merge_branch "$target" && fail "blocked_merge: target '$target' is blocked from merge operations"
  blocked_merge_branch "$source_branch" && fail "blocked_merge: source '$source_branch' is blocked from merge operations"
  validate_merge_direction "$target" "$source_branch"
  require_merge_in_progress
  require_matching_merge_head "$source_branch"

  local merge_path="pr-merge-guarded-complete"
  local merge_message
  merge_message="$(render_merge_message "$merge_path" "$source_branch")"
  write_merge_message_file "$merge_message"
  write_guarded_state "$target" "$source_branch" "forbidden"

  set +e
  FREELY_GUARDED_MERGE_COMPLETION=1 GIT_EDITOR=: git merge --continue
  local continue_rc=$?
  set -e
  if ! git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    cleanup_guarded_state
    attempt_develop_push_followthrough_if_needed "$target" "$source_branch"
    if [[ "$continue_rc" -ne 0 ]]; then
      echo "[MERGE-GUARD] warning: merge commit created but git merge --continue returned $continue_rc (non-critical)" >&2
    fi
    return 0
  fi
  return "$continue_rc"
}

main() {
  local subcommand="${1:-}"
  if [[ "$subcommand" == "--help" || "$subcommand" == "-h" ]]; then
    usage
    exit 0
  fi
  if [[ -z "$subcommand" ]]; then
    usage
    exit 1
  fi

  local dry_run=0
  local args=()
  for a in "$@"; do
    if [[ "$a" == "--dry-run" ]]; then
      dry_run=1
    else
      args+=("$a")
    fi
  done
  set -- "${args[@]}"
  subcommand="${1:-}"

  if [[ "$subcommand" == "complete" ]]; then
    shift
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      usage
      exit 0
    fi
    local target="${1:-}"
    local source_branch="${2:-}"
    [[ -n "$target" && -n "$source_branch" ]] || { usage; exit 1; }
    shift 2
    do_completion "$target" "$source_branch" "$@"
    exit 0
  fi

  local target="$subcommand"
  local source_branch="${2:-}"
  [[ -n "$target" && -n "$source_branch" ]] || { usage; exit 1; }
  do_initial_merge "$target" "$source_branch" "$dry_run"
}

main "$@"
