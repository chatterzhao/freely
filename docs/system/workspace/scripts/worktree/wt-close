	      ;;
	  esac
	  cat >&2 <<UNMERGED

╔══════════════════════════════════════════════════════════════╗
║  ⚠️  严重警告：分支未合并到 develop，无法安全删除                ║
╠══════════════════════════════════════════════════════════════╣
║                                                              ║
║  分支 $branch 的提交尚未合并到 develop。                        ║
║                                                              ║
║  大概率是 pr-merge-guarded 还没执行成功。                       ║
║  请仔细阅读 skill:${_wt_skill}（${_wt_skill_name}），               ║
║  按 skill 工作流完成 merge 后再关闭工位。                        ║
║                                                              ║
║  如果确定要丢弃未合并的提交（不可恢复）：                         ║
║    wt-close $branch --force --discard-unmerged \\
║      --reason "违规绕过门禁中，理由充分，是：<业务理由>"           ║
║                                                              ║
╚══════════════════════════════════════════════════════════════╝

UNMERGED
	  exit 1
	fi
fi

# ── Phase 6b: Cleanup companion test-pre-merge via raw-key ──
# fix|feature/raw-{raw_key}-{slug} and test-pre-merge-{raw_key}-{slug} share the same raw-key.
# Derive the test-pre-merge branch from the fix|feature branch name — no stored relationship needed.
if [[ "$branch" == fix/raw-* || "$branch" == feature/raw-* ]]; then
  _tp_raw_key=$(echo "$branch" | sed -n 's|.*/raw-\([0-9]\{8\}T[0-9]\{6\}Z\)-.*|\1|p')
  _tp_slug=$(echo "$branch" | sed -n 's|.*/raw-[0-9]\{8\}T[0-9]\{6\}Z-\(.*\)|\1|p')
  if [[ -n "$_tp_raw_key" ]]; then
    _tp_branch="test-pre-merge-${_tp_raw_key}-${_tp_slug}"
    _tp_wt="$PROJECT_WORKTREES_ROOT/test-pre-merge-${_tp_raw_key}-${_tp_slug}"
    if git show-ref --verify --quiet "refs/heads/$_tp_branch" 2>/dev/null; then
      if [[ "$FORCE" == true ]]; then
        echo "wt-close: 严重警告 —— 已经用 --force 参数彻底丢弃了所有修改"
        [[ -d "$_tp_wt" ]] && git worktree remove --force "$_tp_wt" 2>/dev/null || true
        git branch -D "$_tp_branch" 2>/dev/null || echo "wt-close: warning - test-pre-merge branch deletion failed" >&2
        echo "wt-close: test-pre-merge 已强制删除 ✓"
      else
        echo "wt-close: cleaning up companion test-pre-merge: $_tp_branch"
        if [[ -d "$_tp_wt" ]]; then
          git worktree remove "$_tp_wt" || { echo "wt-close: 删除 test 工位失败" >&2; exit 1; }
        fi
        if git show-ref --verify --quiet "refs/heads/$_tp_branch" 2>/dev/null; then
          git branch -D "$_tp_branch" || { echo "wt-close: 删除 test 分支失败" >&2; exit 1; }
        fi
        echo "wt-close: test-pre-merge cleaned ✓"
      fi
    fi
	    # Release agent from agent_working table (replaces agent-id.env cleanup).
	    _dev_wt=$(git worktree list --porcelain 2>/dev/null | awk '$1=="worktree"{wt=$2} $1=="branch"&&$2=="refs/heads/develop"{print wt;exit}')
	    [[ -n "$_dev_wt" ]] || _dev_wt="$PROJECT_ROOT"
	    # Phase 1: close ACP sessions + release agent_working table
	    if [[ -f "$_dev_wt/docs/system/workspace/scripts/runtime/agent_working.py" ]]; then
	      # Close ACP sessions (worker + reviewer) before releasing table entries
	      python3 -c "
import sys,os,json,socket,hashlib
sys.path.insert(0, '$_dev_wt/docs/system/workspace/scripts/runtime')
from agent_working import agent_list_by_raw_key, agent_get_session
row = agent_list_by_raw_key('$_dev_wt', 'raw-${_tp_raw_key}')
if row:
    h = hashlib.sha256('$_dev_wt'.encode()).hexdigest()[:16]
    bridge = f'/tmp/freely-acp-{h}.sock'
    if os.path.exists(bridge):
        for role in ('worker', 'reviewer', 'manager'):
            sid = agent_get_session('$_dev_wt', 'raw-${_tp_raw_key}', role)
            if sid:
                try:
                    s=socket.socket(socket.AF_UNIX); s.settimeout(2); s.connect(bridge)
                    req=json.dumps({'jsonrpc':'2.0','id':1,'method':'session/close','params':{'sessionId':sid}})+'
'
                    s.sendall(req.encode()); s.shutdown(socket.SHUT_WR); s.recv(4096); s.close()
                except: pass
" 2>/dev/null || true
	      # Release from agent_working table
	      python3 -c "
import sys; sys.path.insert(0, '$_dev_wt/docs/system/workspace/scripts/runtime')
from agent_working import agent_release_all
agent_release_all('$_dev_wt', 'raw-${_tp_raw_key}')
" 2>/dev/null && echo "wt-close: agent_working released for raw-${_tp_raw_key}" || true
	    fi
	    # Fallback: legacy agent-id.env cleanup
	    _agent_env="$_dev_wt/.freely/agent-id.env"
	    if [[ -f "$_agent_env" ]]; then
	      sed -i.bak "/raw-${_tp_raw_key}/d" "$_agent_env" 2>/dev/null || true
	    fi
  fi
fi

# ── Phase 7: Sync develop across platforms ──

# Only sync when closing a test-pre-merge-* branch (PR was merged to develop)
if [[ "$branch" == test-pre-merge-* ]]; then
  echo "wt-close: syncing develop across platforms..."

  if [[ "$DRY_RUN" == true ]]; then
    _dry "git fetch github origin"
    _dry "git update-ref refs/heads/develop <sha>"
    _dry "git push origin develop:develop"
  else
    # 1. Fetch all remotes
    for remote in $(git remote); do
      git fetch "$remote" develop 2>/dev/null || true
    done

    # 2. Find authoritative SHA (github as primary platform)
    authoritative_sha=$(git rev-parse github/develop 2>/dev/null || echo "")

    if [[ -n "$authoritative_sha" ]]; then
      # 3. Sync local develop if needed
      local_sha=$(git rev-parse develop 2>/dev/null || echo "")

      if [[ "$local_sha" != "$authoritative_sha" ]]; then
        if git diff --quiet HEAD 2>/dev/null; then
          echo "wt-close: updating local develop to $(git rev-parse --short "$authoritative_sha")..."
          git update-ref refs/heads/develop "$authoritative_sha"
          echo "wt-close: local develop synced ✓"
        else
          echo "wt-close: warning - local develop is dirty, skipping local sync" >&2
        fi
      fi

      # 4. Sync to other platforms (origin/gitee)
      origin_sha=$(git rev-parse origin/develop 2>/dev/null || echo "")

      if [[ -n "$origin_sha" && "$origin_sha" != "$authoritative_sha" ]]; then
        echo "wt-close: syncing develop to gitee (origin)..."
        if git push origin "develop:develop" 2>/dev/null; then
          echo "wt-close: gitee develop synced ✓"
        else
          echo "wt-close: warning - failed to sync gitee (may need manual sync)" >&2
        fi
      fi
    fi
  fi
fi

echo "wt-close: done ✓"
