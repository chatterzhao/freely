          sleep 2
          kill -0 "$_wpid" 2>/dev/null && kill -9 "$_wpid" 2>/dev/null || true
        fi
        echo "wt-close: worker $_wtask_id shutdown complete"
      else
        echo "wt-close: worker $_wtask_id already exited (pid=$_wpid not found)"
      fi

