#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/worktree-common.sh"

# Paths from config.toml (single source of truth)
PROJECT_ROOT="${PROJECT_ROOT:-}"
PROJECT_WORKTREES_ROOT="${PROJECT_WORKTREES_ROOT:-}"
PROJECT_WORKTREE_PATH="${PROJECT_WORKTREE_PATH:-}"

# Derive from config.toml if not already set
if [[ -z "$PROJECT_ROOT" ]] && [[ -f ".freely/config.toml" ]]; then
  PROJECT_ROOT="$(dirname "${BASH_SOURCE[0]}")/../../../../.."
  PROJECT_ROOT="$(cd "$PROJECT_ROOT" && pwd -P)"
fi
if [[ -z "$PROJECT_WORKTREES_ROOT" ]]; then
  PROJECT_WORKTREES_ROOT="${PROJECT_ROOT}-worktrees"
fi

FORCE=false
DISCARD_UNMERGED=false
FORCE_REASON=""
SKIP_PLATFORM=false
PLATFORM_ONLY=false
DRY_RUN=false

usage() {
  cat <<USAGE
Usage:
  freely wt-close --raw-key <key> [options]

Close both the fix|feature worktree and its companion test-pre-merge worktree.
--raw-key 是唯一必填参数。命令从 raw key 自动发现两个工位，按先测试后开发的顺序关闭。
  --raw-key <key>       Raw issue key.  Compatible with multiple formats:
                          raw-20260629T160852Z
                          fix/raw-20260629T160852Z-my-fix
                          feature/raw-20260629T160852Z-my-feat
                          20260629T160852Z
Options (按场景选择):
  --reason <text>    REQUIRED with any bypass flag below.  Format:
                      --reason "违规绕过门禁中，理由充分，是：<业务理由>"

  ── 正常关闭 (PR 已 merge，无需 bypass) ──
  (no flags)         Standard close.  Requires clean worktree, synced test worktree,
                      passed pretests, completed phase_state.

  ── 彻底丢弃（不可恢复）──
  --force            永久丢弃。必须配合 --raw-key 和 --reason。绕过自治门禁的拒绝判定
                      (unfinished/foreign block),使用既有 kill-and-continue 路径。
                      正常自治关闭不需要此标志——gate 会自动判定放行条件。
  --discard-unmerged  确认丢弃未 merge 的提交（需同时 --force）。

  ── 仅操作平台，不管本地 ──
  --platform-only    只关闭平台 issue。必须配合 --raw-key 和 --reason。

  ── 其他 ──
  --skip-platform    跳过平台 issue 关闭。
  --dry-run          只打印操作，不执行。

Scenarios:
    # PR 已 merge，正常收口
  freely wt-close --raw-key 20260627T021849Z
  # 确定放弃此 issue
    # PR 已 merge，正常收口
  freely wt-close --raw-key 20260627T021849Z --force --reason "违规绕过门禁中，理由充分，是：该功能确定放弃（自治 gate 判定为 deny 时的人类兜底）"

  # 无工位，只关闭平台 issue
    # PR 已 merge，正常收口
  freely wt-close --raw-key 20260627T021849Z --platform-only --reason "违规绕过门禁中，理由充分，是：工位已清理仅剩平台 issue"

USAGE
}

# ── Frontmatter helpers (inline, matches issue-sync pattern) ──

_fm_get() {
  local file="$1" key="$2"
  python3 -c "
import yaml, sys
with open('$file') as f: content = f.read()
if not content.startswith('---'): sys.exit(0)
parts = content.split('---', 2)
if len(parts) < 3: sys.exit(0)
fm = yaml.safe_load(parts[1]) or {}
val = fm.get('$key','')
if isinstance(val, dict):
  import json; print(json.dumps(val))
elif isinstance(val, list):
  import json; print(json.dumps(val))
elif val is not None:
  print(val)
" 2>/dev/null || true
}

_close_issue_platforms_readonly() {
  local raw_key="$1" file="$2" label="$3" platform_ids
  platform_ids="{}"
  if [[ -f "$file" ]]; then
    platform_ids="$(_fm_get "$file" "platform_ids")"
  fi
  [[ -n "$platform_ids" && "$platform_ids" != "None" ]] || platform_ids="{}"
  FREELY_PROJECT_ROOT="$PROJECT_ROOT" python3 \
    "$PROJECT_ROOT/docs/system/workspace/scripts/sync/platform-adapter.py" \
    close-raw "$raw_key" "$platform_ids"
}

_close_platform_ids_readonly() {
  local file="$1" label="$2" platform_ids
  platform_ids="$(_fm_get "$file" "platform_ids")"
  if [[ -z "$platform_ids" || "$platform_ids" == "None" || "$platform_ids" == "{}" ]]; then
    echo "Error: no platform_ids for $label" >&2
    return 1
  fi
  FREELY_PROJECT_ROOT="$PROJECT_ROOT" python3 \
    "$PROJECT_ROOT/docs/system/workspace/scripts/sync/platform-adapter.py" \
    close-multi "$platform_ids"
}

# ── Branch/issue resolution ──

_resolve_branch() {
  local input="$1"
  if [[ -d "$input" ]]; then
    git worktree list --porcelain | awk -v wt="$input" '
      $1=="worktree" && $2==wt {found=1}
      found && $1=="branch" {print $2; exit}
    ' | sed 's|^refs/heads/||'
    return 0
  fi
  echo "$input"
}

_resolve_worktree_path() {
  local branch="$1"
  local existing
  existing="$(freely_wt_existing_for_branch "$branch")"
  if [[ -n "$existing" ]]; then
    echo "$existing"
    return 0
  fi
  return 1
}

_is_protected_branch() {
  local branch="$1"
  case "$branch" in
    main|develop|test-pre-merge-*) return 0 ;;
    *) return 1 ;;
  esac
}

# ── Dry-run logging ──

_dry() {
  echo "[DRY-RUN] $*"
}

# ── Parse args ──

args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --force) FORCE=true; shift ;;
    --discard-unmerged) DISCARD_UNMERGED=true; shift ;;
    --reason) FORCE_REASON="$2"; shift 2 ;;
    --skip-platform) SKIP_PLATFORM=true; shift ;;
    --raw-key) RAW_KEY="$2"; shift 2 ;;
    --platform-only) PLATFORM_ONLY=true; shift ;;
    --dry-run) DRY_RUN=true; shift ;;
    --help|-h) usage; exit 0 ;;
    -*) echo "Unknown: $1" >&2; usage; exit 1 ;;
    *) args+=("$1"); shift ;;
  esac
done

if [[ ${#args[@]} -gt 0 ]]; then
  set -- "${args[@]}"
else
  set --
fi

# ── Ownership guard (raw-20260717T103359Z) ────────────────────────────────
# Three production incidents (2026-07-17): fallback workers removed worktrees
# with ZERO deliverables — twice their own assignment, once someone else's.
# Two hard checks before any worktree-destroying action (--platform-only skips):
#   1. unfinished guard: closing a key with no develop merge evidence requires
#      --force --reason (existing semantics — no new bypass surface)
#   2. foreign guard: FREELY_AGENT_RAW_KEY (exported by worker launch paths)
#      differing from the target key requires --force
_autonomous_close_gate() {
  # Machine-judgeable closeout gate for autonomous agents.
  # Human --force --reason is preserved for exceptional abandon scenarios.
  local target_key="$1"
  [[ "$PLATFORM_ONLY" == "true" ]] && return 0
  [[ "$FORCE" == "true" ]] && return 0
  local _own_key="${FREELY_AGENT_RAW_KEY:-}"
  local _is_self=false; [[ -n "$_own_key" && "$_own_key" == "$target_key" ]] && _is_self=true
  local _has_merge=false _merge_count
  # rev-list --count: no pipe → immune to pipefail/SIGPIPE race that broke grep -q here
  _merge_count=$(git -C "$PROJECT_ROOT" rev-list develop --merges --grep "raw-${target_key}" --count 2>/dev/null || echo 0)
  [[ "$_merge_count" =~ ^[0-9]+$ && "$_merge_count" -gt 0 ]] && _has_merge=true
  # B1 phase_state: read from develop (authoritative), fall back to working tree
  local _b1_state="" _b1_rel="docs/B1-docs/raw-${target_key}/issue.md"
  _b1_state=$(git -C "$PROJECT_ROOT" show "develop:${_b1_rel}" 2>/dev/null | grep -m1 "^phase_state:" | awk '{print $2}' || true)
  [[ -z "$_b1_state" && -f "$PROJECT_ROOT/$_b1_rel" ]] && _b1_state=$(grep -m1 "^phase_state:" "$PROJECT_ROOT/$_b1_rel" 2>/dev/null | awk '{print $2}' || true)
  local _is_dropped=false; [[ "$_b1_state" == "dropped" ]] && _is_dropped=true
  # agent_working lives in the MAIN repo's db daemon (socket hashed by main root path).
  # From a worktree, PROJECT_ROOT hashes differently — resolve main root via git-common-dir.
  local _main_root
  _main_root=$(dirname "$(git -C "$PROJECT_ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" 2>/dev/null) || _main_root="$PROJECT_ROOT"
  [[ -d "$_main_root" ]] || _main_root="$PROJECT_ROOT"
  local _aw_worker="" _aw_reviewer="" _aw_py
  _aw_py="$_main_root/docs/system/workspace/scripts/runtime/agent_working.py"
  if [[ -f "$_aw_py" ]]; then
    export _AW_PROJECT="$_main_root" _AW_RAW_KEY="raw-${target_key}"
    # try/except everything: db daemon down (socket missing) = runtime not
    # running = no active agents. Gate degrades gracefully, never blocks close.
    _aw_row=$(python3 2>/dev/null <<'PYAW' || true
import os, sys
try:
    _PROJECT = os.environ.get("_AW_PROJECT", "")
    _AW_RAW_KEY = os.environ.get("_AW_RAW_KEY", "")
    sys.path.insert(0, os.path.join(_PROJECT, "docs/system/workspace/scripts/runtime"))
    from agent_working import agent_list_by_raw_key
    r = agent_list_by_raw_key(_PROJECT, _AW_RAW_KEY)
    if r:
        wid = r.get("worker_id", "") or ""
        rid = r.get("reviewer_id", "") or ""
        if wid or rid:
            print(f"{wid}|{rid}")
except Exception:
    pass
PYAW
    )
    if [[ -n "${_aw_row:-}" ]]; then
      _aw_worker="${_aw_row%%|*}"; _aw_worker="${_aw_worker%%:*}"
      _aw_reviewer="${_aw_row##*|}"; _aw_reviewer="${_aw_reviewer%%:*}"
    fi
  fi
  local _has_active_task=false _active_tasks=""
  local _a2a_py="$_main_root/docs/system/workspace/scripts/runtime/a2a_task.py"
  local _db="$_main_root/.freely/freely.db"
  if [[ -f "$_a2a_py" && -f "$_db" ]]; then
    _active_tasks=$(python3 "$_a2a_py" list --raw-key "$target_key" --status working,submitted,launched 2>/dev/null | python3 -c "
import json,sys
try: rows=json.load(sys.stdin).get('rows',[]); print(len(rows))
except: print(0)
" 2>/dev/null || echo 0)
    [[ "$_active_tasks" =~ ^[0-9]+$ && "$_active_tasks" -gt 0 ]] && _has_active_task=true
  fi
  if $_is_self && ! $_has_merge && ! $_is_dropped; then
    local _no_activity=true
    [[ -n "$_aw_worker" || -n "$_aw_reviewer" ]] && _no_activity=false
    $_has_active_task && _no_activity=false
    if $_no_activity; then
      echo "[closeout-gate] self-owned raw-$target_key: no merge evidence, zero agent activity — allowing close" >&2
      return 0
    fi
    echo "[closeout-gate] DENIED self-owned raw-$target_key: w=$_aw_worker r=$_aw_reviewer a2a=$_active_tasks" >&2
    echo "  action: complete work (a2a-exit --state completed), then retry; --force to abandon" >&2
    exit 1
  fi
  if ! $_is_self && ( $_has_merge || $_is_dropped ); then
    echo "[closeout-gate] foreign raw-$target_key has merge/dropped — allowing sweep" >&2
    return 0
  fi
  if ! $_is_self && ! $_has_merge && ! $_is_dropped; then
    echo "[closeout-gate] DENIED foreign unfinished raw-$target_key" >&2
    echo "  action: owner close, batch-reconcile, or --force" >&2
    exit 1
  fi
  if [[ -n "$_aw_reviewer" ]]; then
    echo "[closeout-gate] DENIED raw-$target_key: reviewer $_aw_reviewer active" >&2
    echo "  action: reviewer a2a-exit verdict before close" >&2
    exit 1
  fi
  return 0
}
_extract_raw_key() {
  local val="$1"
  # Strip fix/ or feature/ prefix first
  local stripped="${val#fix/}"
  stripped="${stripped#feature/}"
  # Extract raw-YYYYMMDDTHHMMSSZ pattern (just the key part, not the slug)
  local raw_match
  raw_match=$(echo "$stripped" | grep -oE 'raw-[0-9]{8}T[0-9]{4,6}Z' 2>/dev/null | head -1 || true)
  if [[ -n "$raw_match" ]]; then
    echo "${raw_match#raw-}"
  elif [[ "$val" =~ ^[0-9]{8}T[0-9]{4,6}Z$ ]]; then
    echo "$val"
  else
    echo ""
  fi
}

# ── Resolve branch from raw key ──
_resolve_branch_from_raw_key() {
  local raw_key="$1" match_list _count first _shortest_count
  match_list=$(git branch --list "fix/raw-${raw_key}-*" "feature/raw-${raw_key}-*" 2>/dev/null | sed 's/^[*+ ]*//' | sort -u || true)
  if [[ -z "$match_list" ]]; then
    match_list=$(git branch --list "*raw-${raw_key}-*" "*raw-${raw_key}" 2>/dev/null | sed 's/^[*+ ]*//' | grep -E "(^fix/|^feature/|^hotfix/)" | sort -u || true)
  fi
  # test-pre-merge-* is a DISPOSABLE sandbox, never a close target. When its
  # dev worktree is already gone it is retired by the dedicated companion-only
  # path below, not by resolving it into `branch` (that made it run the full
  # raw lifecycle and triggered platform/develop side effects).
  # `grep -c` prints "0" AND exits 1 when nothing matches. Adding `|| echo 0`
  # appended a SECOND "0", so _count became $'0\n0' and `[[ ... -eq 0 ]]` was a
  # syntax error; the function then returned 0 with no output, making the caller
  # believe a branch had been resolved. Take the first line and validate it.
  _count=$(printf '%s
' "$match_list" | grep -c . 2>/dev/null || true)
  _count="${_count%%$'\n'*}"
  _count="${_count:-0}"
  if ! [[ "$_count" =~ ^[0-9]+$ ]]; then
    echo "[closeout-gate] branch count is not numeric: '$_count'" >&2
    return 1
  fi
  if [[ "$_count" -eq 0 ]]; then return 0
  elif [[ "$_count" -eq 1 ]]; then printf '%s
' "$match_list"; return 0; fi
  first=$(printf '%s
' "$match_list" | awk '{print length, $0}' | sort -n | head -1 | cut -d' ' -f2-)
  _shortest_count=$(printf '%s
' "$match_list" | awk -v L="${#first}" 'length==L' | wc -l | tr -d ' ')
  if [[ "$_shortest_count" -le 1 ]]; then printf '%s
' "$first"; return 0; fi
  echo "[closeout-gate] DENIED ambiguous: $_count branches matched, $_shortest_count at shortest length" >&2
  printf '%s
' "$match_list" | while read -r line; do echo "  candidate: $line" >&2; done
  echo "  action: pass explicit branch name, or --force" >&2
  exit 1
}

# Retire a leftover test-pre-merge sandbox whose dev worktree is already gone.
# This is a COMPANION-ONLY retirement: it deletes the worktree + branch and does
# NOT run the raw lifecycle (no platform issue close, no Phase 7 develop sync).
# main/develop/test-pre-merge stay protected as close targets in the main path.
# The destructive gate is the same: --force + --discard-unmerged with a reason
# already validated by _require_reason before this function is called.
_wt_retire_orphan_test_sandbox() {
  local key="$1" candidates count target_branch target_wt
  candidates=$(git branch --list "test-pre-merge-${key}-*" "test-pre-merge-${key}" 2>/dev/null | sed 's/^[*+ ]*//' | sort -u || true)
  [[ -z "$candidates" ]] && return 1
  count=$(printf '%s\n' "$candidates" | grep -c . 2>/dev/null || true)
  count="${count%%$'\n'*}"
  if [[ "$count" -ne 1 ]]; then
    echo "[closeout-gate] DENIED ambiguous orphan test sandboxes for raw-${key}: $candidates" >&2
    exit 1
  fi
  target_branch="$candidates"
  if [[ "$FORCE" != true || "$DISCARD_UNMERGED" != true ]]; then
    echo "[closeout-gate] orphan test sandbox '$target_branch' requires --force --discard-unmerged --reason <合规前缀>" >&2
    exit 1
  fi
  target_wt="$(git worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$target_branch" '
      $1=="worktree" { wt=$2 }
      $1=="branch" && $2==b { print wt; exit }')"
  if [[ "$DRY_RUN" == true ]]; then
    _dry "git worktree remove ${target_wt:-<none>}"
    _dry "git branch -D $target_branch"
    _dry "no platform close / no Phase 7 develop sync (companion-only)"
    return 0
  fi
  if [[ -n "$target_wt" && -d "$target_wt" ]]; then
    git worktree remove "$target_wt" --force || { echo "wt-close: 删除 test 工位失败" >&2; exit 1; }
  fi
  git branch -D "$target_branch" || { echo "wt-close: 删除 test 分支失败" >&2; exit 1; }
  echo "wt-close: retired orphan test sandbox '$target_branch' (companion-only; no platform/develop side effects) ✓"
  return 0
}

# ── Determine input from --raw-key ──
if [[ -n "${RAW_KEY:-}" ]]; then
  _raw_key="$(_extract_raw_key "$RAW_KEY")"
  if [[ -z "$_raw_key" ]]; then
    echo "Error: could not extract raw key from '${RAW_KEY}'" >&2
    echo "  Supported formats: raw-YYYYMMDDTHHMMSSZ, fix/raw-{key}-{slug}, feature/raw-{key}-{slug}, YYYYMMDDTHHMMSSZ" >&2
    exit 1
  fi
  _autonomous_close_gate "$_raw_key"
  if [[ "${PLATFORM_ONLY:-false}" == true ]]; then
    # --platform-only: skip branch resolution, use raw key directly for API close
    input="raw-${_raw_key}"
    branch="$input"
    echo "wt-close: raw key '${_raw_key}' (--platform-only, no branch resolution)"
  else
    _matched="$(_resolve_branch_from_raw_key "$_raw_key")"
    if [[ -z "$_matched" ]]; then
      # No dev worktree left. An orphan test sandbox must be retired by the
      # companion-only path AFTER the reason gate - never by resolving it into
      # `branch` and running the full raw lifecycle.
      ORPHAN_SANDBOX_KEY="$_raw_key"
      input="raw-${_raw_key}"
    else
      input="$_matched"
      echo "wt-close: raw key '${_raw_key}' → branch '${input}'"
    fi
  fi
else
  echo "Error: --raw-key is required" >&2
  usage
  exit 1
fi

# ── --reason gate: bypass flags require valid reason ──
# Reason must start with "违规绕过门禁中，理由充分，是：" to prevent casual abuse.
if true; then  # --raw-key always passes through reason check
  _require_reason() {
    local flag="$1" flag_name="$2"
    if [[ "${!flag:-false}" != "true" ]]; then
      return 0
    fi
    if [[ -z "${FORCE_REASON:-}" ]] || ! echo "${FORCE_REASON}" | grep -q "^违规绕过门禁中，理由充分，是："; then
      cat >&2 <<GATE
[GATE] 检测到你试图违规绕过门禁: wt-close ${flag_name}

  如果是因为实现没有达到门禁要求，请按要求去完成，而不是想着违规绕过。

  只有确实有合理的业务理由，才允许绕过。
  请按以下格式加上绕过理由:
    --reason "违规绕过门禁中，理由充分，是：<业务理由>"

  --force 合法业务理由:
    - 该功能需求确定不再需要继续实现（如产品方向变更、需求被撤销等）
    - 工位目录已损坏或丢失，仅剩分支引用需清理
  --discard-unmerged 合法业务理由:
    - 该方案已被否决，未合并的提交确认不再需要（需同时使用 --force）
  --platform-only 合法业务理由:
    - 工位已删除但平台 issue 仍 OPEN，需关闭平台 issue 收口
    - 孤儿 raw issue——工位和分支已清理，仅剩平台 issue 未同步关闭

  --skip-platform 合法业务理由:
    - 平台 issue 已通过其他渠道手动关闭，无需同步

  示例:
    freely wt-close --force --reason "违规绕过门禁中，理由充分，是：该功能确定放弃，不再继续实现此 raw issue" fix/raw-xxx
    freely wt-close --force --discard-unmerged --reason "违规绕过门禁中，理由充分，是：该方案已被否决，未合并提交确认丢弃" fix/raw-xxx
GATE
    fi
  }
  _require_reason FORCE "--force"
  _require_reason SKIP_PLATFORM "--skip-platform"
  _require_reason PLATFORM_ONLY "--platform-only"
  _require_reason DISCARD_UNMERGED "--discard-unmerged"
fi

# Companion-only retirement runs here so it inherits the reason gate above but
# never reaches the protected-branch guard, platform close or Phase 7.
if [[ -n "${ORPHAN_SANDBOX_KEY:-}" ]]; then
  _wt_retire_orphan_test_sandbox "$ORPHAN_SANDBOX_KEY" && exit 0
  echo "Error: no fix/feature branch found for raw key '${ORPHAN_SANDBOX_KEY}'" >&2
  echo "  Searched: fix/raw-${ORPHAN_SANDBOX_KEY}-* and feature/raw-${ORPHAN_SANDBOX_KEY}-*" >&2
  echo "  Check available branches:" >&2
  echo "    git branch --list \"fix/raw-${ORPHAN_SANDBOX_KEY}-*\" \"feature/raw-${ORPHAN_SANDBOX_KEY}-*\"" >&2
  exit 1
fi

if [[ -z "$input" ]]; then
  echo "Error: --raw-key is required" >&2
  usage
  exit 1
fi

# ── Resolve branch ──
branch="$(_resolve_branch "$input")"
if [[ -z "$branch" ]]; then
  echo "Error: could not resolve branch from '$input'" >&2
  exit 1
fi
echo "wt-close: branch = $branch"

# Derive PROJECT_WORKTREE_PATH from branch name
if [[ -z "$PROJECT_WORKTREE_PATH" ]] && [[ -n "$branch" ]]; then
  _wt_dir="$(freely_wt_dir_name_for_branch "$branch")"
  PROJECT_WORKTREE_PATH="${PROJECT_WORKTREES_ROOT}/${_wt_dir}"
fi
ISSUES_DIR="$PROJECT_WORKTREE_PATH/docs/B1-docs"

# ── Guard: protected branch (test-pre-merge is disposable, skip checks) ──
# main / develop / test-pre-merge-* are ALL protected as close targets. This is
# asserted by test-wt-close-protected-branch-guard Test 1-3. A leftover
# test-pre-merge sandbox is retired by the companion-only path in the
# --raw-key resolution above, which does NOT go through the raw lifecycle
# (no platform close, no Phase 7 develop sync). Never widen this guard.
if _is_protected_branch "$branch"; then
  echo "Error: '$branch' is a protected branch, cannot close" >&2
  exit 1
fi

# ── Resolve worktree path ──
wt_path="$(_resolve_worktree_path "$branch" || true)"
if [[ -z "$wt_path" ]]; then
  if [[ "$FORCE" == true || "$PLATFORM_ONLY" == true ]]; then
    if [[ "$PLATFORM_ONLY" == true ]]; then
      echo "wt-close: --platform-only, no worktree found for '$branch' (API close only)"
    else
      echo "wt-close: --force, no worktree found for '$branch' (orphaned branch cleanup)"
    fi
  else
    echo "Error: no worktree found for branch '$branch'" >&2
    echo "  Use --force with --raw-key to close an orphaned worktree." >&2
    echo "  Or use --platform-only to just close the platform issue via API." >&2
    exit 1
  fi
else
  echo "wt-close: worktree = $wt_path"
fi

# ── Extract issue id ──
issue_id="raw-${_raw_key}"  # always derived from raw key
if [[ -z "$issue_id" ]]; then
  echo "Warning: could not extract issue id from branch '$branch'" >&2
  echo "  Skipping phase_state check and platform close." >&2
fi

# ── Phase 0: Comment resolution check ──
# Delegates to the single implementation used by pr-create-guarded so both gates
# can never disagree (they did: system-event comments were counted as human).
if [[ -n "$issue_id" ]]; then
  _raw_file="$ISSUES_DIR/$issue_id/issue.md"
  if [[ -f "$_raw_file" ]]; then
    _wt_root="${ROOT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)}"
    _scan_py="$_wt_root/docs/system/workspace/scripts/quality/comment-resolution-scan.py"
    if [[ ! -f "$_scan_py" ]]; then
      # Minimal trees (fixtures, partial packages) may not ship the scan. Only
      # skip when there is nothing to judge; otherwise fail closed.
      if grep -q "^### comment-" "$_raw_file"; then
        echo "[wt-close] comment check unavailable: missing $_scan_py" >&2
        exit 1
      fi
      echo "wt-close: comment check skipped (no scan, no comments)"
    else
      _scan_out="$(python3 "$_scan_py" "$ISSUES_DIR" 2>&1 || true)"
      if grep -q "^  $issue_id:" <<<"$_scan_out"; then
        echo "[wt-close] comments without resolution:"
        grep "^  $issue_id:" <<<"$_scan_out"
        echo "  每条人类评论必须有子评论标记 adopted（采纳）或 discarded（丢弃）"
        echo "  添加 #### resolution-{ts} 后重试 wt-close"
        exit 1
      fi
      echo "wt-close: comment check ✓"
    fi
  fi
fi

# ── Phase 1: Checks ──

if [[ -n "$issue_id" ]]; then
  issue_file="$ISSUES_DIR/$issue_id/issue.md"
  if [[ "$FORCE" != true ]]; then
    freely_wt_assert_raw_reconciled_readonly "$_raw_key" "$PROJECT_WORKTREE_PATH" || {
      echo "[wt-close] raw replicas are inconsistent after merge; resolve explicitly before close." >&2
      exit 1
    }
  fi
fi

if [[ "$FORCE" == false && -n "$issue_id" && -f "${issue_file:-}" ]]; then
  phase_state="$(_fm_get "$issue_file" "phase_state")"
  if [[ -z "$phase_state" || ( "$phase_state" != "completed" && "$phase_state" != "absorbed" ) ]]; then
    cat >&2 <<PHASE_GATE
[wt-close] $issue_id 的 phase_state='${phase_state:-<empty>}'，不满足 wt-close 要求的 'completed' 或 'absorbed'

  'absorbed' 是正常完成状态——pr-merge-guarded 将 raw issue 吸收到 I-* issue，表示工作已完成。

  请判断属于以下哪种情况，然后采取对应措施:

  1. 实现已完成，只是 phase_state 忘记更新为 completed 或 absorbed
     → 更新 $issue_file 的 phase_state，然后重新执行 wt-close

  2. 实现确实还没做完
     → 请回到工位继续完成实现工作，完成后再执行 wt-close

  3. 该功能已确定放弃，工位需要强制收口
     → 使用 --force 并给出准确的业务理由:
       freely wt-close $branch --force --reason "违规绕过门禁中，理由充分，是：<业务理由>"

     有效业务理由示例:
       ✅ "该功能确定放弃，不再继续实现此 raw issue"
       ✅ "该方案已被否决，工位需强制收口销毁"
PHASE_GATE
    exit 1
  fi
  echo "wt-close: phase_state=$phase_state ✓"

  # pretests-retirement-gate check
  # Find companion test-pre-merge worktree (same raw key timestamp).
  # test-gate.env lives in the test worktree where the daemon actually ran.
  # The fix worktree doesn't run daemon so it has no test evidence.
  _raw_key_ts=$(echo "$branch" | grep -oE '[0-9]{8}T[0-9]{6}Z' | head -1 || true)
  _test_wt=""
  if [[ -n "$_raw_key_ts" ]]; then
    _test_wt=$(git worktree list --porcelain 2>/dev/null | awk -v k="test-pre-merge-$_raw_key_ts" '
      $1=="worktree" { wt=$2 }
      $1=="branch" && $2 ~ k { print wt; exit }
    ')
  fi
  if [[ -z "$_test_wt" || ! -d "$_test_wt" ]]; then
    cat >&2 <<TEST_MISSING
[wt-close] 找不到对应的测试工位 test-pre-merge-${_raw_key_ts}-*

  测试工位中的 test-gate.env 是测试已运行的唯一证据。
  测试工位缺失意味着无法验证测试是否完成。

  如果测试工位被误删，请重新创建并在其中运行 daemon 完成测试，
  然后再执行 wt-close。
TEST_MISSING
    exit 1
  fi
  if [[ -x "$PROJECT_ROOT/bin/pretests-retirement-gate" ]]; then
    if "$PROJECT_ROOT/bin/pretests-retirement-gate" --project "$PROJECT_ROOT" --worktree-path "$_test_wt" 2>/dev/null; then
      echo "wt-close: pretests-retirement-gate passed ✓"
    else
      cat >&2 <<PRETEST_GATE
[wt-close] pretests-retirement-gate 检查未通过: $_test_wt

  ── 保留此 issue 继续推进 ────────────────────────────────────
  请在测试工位完成测试验证:

  1. cd $_test_wt
  2. freely daemon start --task-mode auto
  3. 按 pre-tests.md 的测试用例逐条验证
  4. daemon 停止后 test-gate.env 会记录测试完成的 commit

  测试通过后重新执行 wt-close。无需 --force。

  ── 确定丢弃此 issue ────────────────────────────────────────
  --force 仅用于此场景: 确定不再继续实现此 raw issue。
    wt-close $branch --force --reason "违规绕过门禁中，理由充分，是：该功能确定放弃"
PRETEST_GATE
      exit 1
    fi
  fi
elif [[ "$FORCE" == true ]]; then
  echo "wt-close: --force, skipping checks"
fi

# ── Guard: refuse to close if the main repo is on the branch being closed ──

# Orphaned branch cleanup: skip frontmatter/issue operations entirely
if [[ "$FORCE" == true && -z "$wt_path" ]]; then
  echo "wt-close: orphaned branch cleanup mode (no worktree, no frontmatter ops)"

else
  # Only block if the branch being closed IS the currently checked-out branch
  _guard_branch=$(git -C "$PROJECT_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
  if [[ "$branch" == "$_guard_branch" ]]; then
    case "$_guard_branch" in
      main|develop|test-pre-merge-*)
        echo "Error: cannot close the currently checked-out protected branch" >&2
        exit 1
        ;;
    esac
  fi
fi

# ── Phase 1.5: Consistency check — dev and test worktrees must be synced ──
# Only for fix|feature branches (skip orphaned, test-pre-merge, main, develop).
# Prevent closing when test results would be lost.

_consistency_check() {
  local _dev_branch="$1" _dev_wt="$2"

  # Skip if not a fix|feature branch
  [[ "$_dev_branch" == fix/raw-* || "$_dev_branch" == feature/raw-* ]] || return 0

  # Extract raw key
  local _raw_key
  _raw_key=$(echo "$_dev_branch" | grep -oE '[0-9]{8}T[0-9]{6}Z' | head -1 || true)
  [[ -n "$_raw_key" ]] || return 0

  # Find test-pre-merge worktree
  local _test_wt
  _test_wt=$(git -C "$PROJECT_ROOT" worktree list --porcelain 2>/dev/null | awk -v k="test-pre-merge-$_raw_key" '
    $1=="worktree" { wt=$2 }
    $1=="branch" && $2 ~ k { print wt; exit }
  ')
  [[ -z "$_test_wt" || ! -d "$_test_wt" ]] && return 0  # no test worktree, skip

  echo "wt-close: checking consistency between dev and test worktrees..."

  # Check 1: dev worktree clean
  if git -C "$_dev_wt" status --short 2>/dev/null | grep -q .; then
    cat >&2 <<DIRTY_DEV
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  wt-close blocked: 开发工位有未提交的修改                ║
╠══════════════════════════════════════════════════════════════╣
║  开发工位: $_dev_wt ($_dev_branch)
║                                                              ║
║  git 跟踪的文件必须提交。请处理后再 wt-close:                  ║
║    cd $_dev_wt && git add -A && git commit
║    git push && pr-review && wt-close
╚══════════════════════════════════════════════════════════════╝
DIRTY_DEV
    exit 1
  fi

  # Check 2: test worktree clean
  if git -C "$_test_wt" status --short 2>/dev/null | grep -q .; then
    cat >&2 <<DIRTY_TEST
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  wt-close blocked: 测试工位有未提交的测试结果            ║
╠══════════════════════════════════════════════════════════════╣
║  测试工位: $_test_wt (test-pre-merge-$_raw_key-*)
║                                                              ║
║  git 跟踪的文件必须提交。请处理后再 wt-close:                  ║
║    cd $_test_wt && git add -A && git commit -m "test: results"
║                                                              ║
║  ⚠️  然后必须同步到开发工位，否则测试通过的代码会丢失:         ║
║    cd $_dev_wt
║    git cherry-pick \$(git -C $_test_wt log --format=%H --no-merges $_dev_branch..HEAD)
║    git push && pr-review && wt-close
╚══════════════════════════════════════════════════════════════╝
DIRTY_TEST
    exit 1
  fi

  # Check 3: test has commits not in dev (test results need cherry-pick)
  local _missing
  _missing=$(git -C "$_test_wt" log --oneline --no-merges "$_dev_branch..HEAD" 2>/dev/null || true)
  if [[ -n "$_missing" ]]; then
    cat >&2 <<NEED_CP
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  wt-close blocked: 测试工位有提交未同步到开发工位        ║
╠══════════════════════════════════════════════════════════════╣
║  开发与测试工位必须一致，否则最后测试通过的代码不在开发里，白干。
║                                                              ║
║  开发工位: $_dev_wt ($_dev_branch)
║  测试工位: $_test_wt (test-pre-merge-$_raw_key-*)
║                                                              ║
║  以下提交在测试工位但不在开发工位:                              ║
║  $_missing
║                                                              ║
║  请用 cherry-pick 同步到开发工位（两边都能互相 cherry-pick）:    ║
║    cd $_dev_wt
║    git cherry-pick \$(git -C $_test_wt log --format=%H --no-merges $_dev_branch..HEAD)
║    git push && pr-review && wt-close
╚══════════════════════════════════════════════════════════════╝
NEED_CP
    exit 1
  fi

  # Check 4: dev has commits not in test (out of sync)
  _missing=$(git -C "$_test_wt" log --oneline --no-merges "HEAD..$_dev_branch" 2>/dev/null || true)
  if [[ -n "$_missing" ]]; then
    cat >&2 <<NEED_CP
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  wt-close blocked: 开发工位有提交未同步到测试工位        ║
╠══════════════════════════════════════════════════════════════╣
║  开发工位: $_dev_wt ($_dev_branch)
║  测试工位: $_test_wt (test-pre-merge-$_raw_key-*)
║                                                              ║
║  开发与测试工位必须一致，否则测试结果没有意义——                  ║
║  测的不是最终要合并的代码。                                    ║
║                                                              ║
║  以下提交在开发工位但不在测试工位:                              ║
║  $_missing
║                                                              ║
║  请用 cherry-pick 同步（两边都能互相 cherry-pick）:             ║
║    cd $_test_wt
║    git cherry-pick \$(git -C $_dev_wt log --format=%H --no-merges HEAD..$_dev_branch)
║                                                              ║
║  同步后必须在测试工位重跑 pre-tests，验证最终代码。             ║
║  全部 passed 后再 git push && pr-review && wt-close           ║
╚══════════════════════════════════════════════════════════════╝
NEED_CP
    exit 1
  fi

  echo "wt-close: consistency check passed ✓"
}

cd "$PROJECT_ROOT" || { echo "Error: cannot cd to $PROJECT_ROOT" >&2; exit 1; }
if [[ "$branch" == fix/raw-* || "$branch" == feature/raw-* ]]; then
  _raw_key=$(echo "$branch" | grep -oE '[0-9]{8}T[0-9]{6}Z' | head -1 || true)
  if [[ -n "$_raw_key" ]]; then
    _consistency_check "$branch" "$wt_path"
  fi
fi

# ── Unmerged commits guard (--force) ──
if [[ "$FORCE" == true ]]; then
  _ahead=$(git -C "$PROJECT_ROOT" rev-list --count develop.."$branch" 2>/dev/null || echo 0)
  if [[ "$_ahead" -gt 0 ]]; then
    echo "wt-close: WARNING — $branch has $_ahead unmerged commit(s) ahead of develop:"
    git -C "$PROJECT_ROOT" log --oneline --no-decorate "develop..$branch" 2>/dev/null | while read -r line; do
      echo "          $line"
    done
    echo ""
    if [[ "$DISCARD_UNMERGED" != true ]]; then
      cat >&2 <<UNMERGED_BLOCK
[wt-close] BLOCKED: '$branch' has unmerged commits that would be lost.

  ⚠️  --force 只有一个目标: 彻底丢弃。如果意图不是丢弃，STOP。

  如果你认为"已经 merge 了，可以删除":
    → 用不带 --force 的正常 wt-close:  freely wt-close --raw-key <key>
    → 不带 force 报错 → 说明没有 merge → 回到工位完成 merge → 再 wt-close
    → 不要用 --force 绕过"未 merge"报错

  如果确定要彻底丢弃这些提交:
  1. Review the unmerged commits listed above
  2. If useful: create a new raw issue to extract and preserve the work
     freely chat --new-issue "extract: <what to preserve from $branch>"
  3. Then re-run with --discard-unmerged to confirm:
     freely wt-close --force --discard-unmerged --reason "..." $branch
UNMERGED_BLOCK
      exit 1
    fi
    echo "wt-close: --discard-unmerged confirmed, discarding $_ahead unmerged commit(s)"
  fi
fi

# ── Phase 2: Platform close ──

# --platform-only: close platform issue via API only, NO local file modifications.
# Requires: NO worktree exists for this raw key (never created, or already removed).
# If a worktree exists → blocked, use normal wt-close or --force instead.
# Uses gh/gitee API directly to avoid writing to develop.
if [[ "$PLATFORM_ONLY" == true ]]; then
  echo "wt-close: --platform-only mode (API close only, no local file changes)"

  # raw_key MUST be set for --platform-only
  if [[ -z "${_raw_key:-}" ]]; then
    _raw_key="$(_extract_raw_key "${RAW_KEY:-${input:-}}")"
  fi
  if [[ -z "${_raw_key:-}" ]]; then
    echo "Error: --platform-only requires --raw-key <key> to identify the platform issue" >&2
    exit 1
  fi
  raw_key="$_raw_key"
  issue_id="raw-${raw_key}"

  # ── Guard: --platform-only requires NO local worktree ──
  # If a worktree exists for this raw key, the user should use normal
  # wt-close (or --force if discarding).  --platform-only is only for
  # orphan issues where the worktree is already gone.
  _po_existing_wt=$(git -C "$PROJECT_ROOT" worktree list --porcelain 2>/dev/null | awk -v k="$raw_key" '
    $1=="worktree" { wt=$2 }
    $1=="branch" && $2 ~ k { print wt; exit }
  ')
  if [[ -n "$_po_existing_wt" && -d "$_po_existing_wt" ]]; then
    cat >&2 <<PLATFORM_BLOCK
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  --platform-only blocked: 本地工位仍然存在               ║
╠══════════════════════════════════════════════════════════════╣
║  工位: $_po_existing_wt
║  raw key: $raw_key
║                                                              ║
║  --platform-only 仅用于工位已被删除，仅剩平台 issue 的场景。   ║
║                                                              ║
║  正确做法:                                                    ║
║    - 如果要彻底丢弃此 raw issue 的所有修改:                    ║
║      freely wt-close $branch --force --reason "违规绕过门禁中，理由充分，是：..."    ║
║    - 如果 PR 已 merge，正常收口:                              ║
║      freely wt-close $branch                                  ║
╚══════════════════════════════════════════════════════════════╝
PLATFORM_BLOCK
    exit 1
  fi

  # Local metadata is only a cache.  Missing/incomplete mappings are recovered
  # through the adapter by resolving this raw key on every configured platform.
  _po_issue_file="$PROJECT_ROOT/docs/B1-docs/$issue_id/issue.md"
  echo "wt-close: resolving and closing raw issue via platform-adapter (all platforms)..."
  if _close_issue_platforms_readonly "$raw_key" "$_po_issue_file" "$issue_id"; then
    echo "wt-close: raw issue closed (all platforms, local files unchanged)"
  else
    echo "Error: platform close failed for $issue_id; cleanup stopped" >&2
    exit 1
  fi

  # A canonical I-* has an independent multi-platform mapping when it exists.
  _po_absorbed_i="$(_fm_get "$_po_issue_file" "absorbed_into")"
  if [[ -n "$_po_absorbed_i" ]]; then
    _po_i_file="$PROJECT_ROOT/docs/B1-docs/$_po_absorbed_i/issue.md"
    if [[ -f "$_po_i_file" ]]; then
      _po_i_phase="$(_fm_get "$_po_i_file" "phase_state")"
      _po_i_ps="$(_fm_get "$_po_i_file" "platform_state")"
      if [[ ( "$_po_i_phase" == "completed" || "$_po_i_phase" == "done_b2_ibm" ) && "$_po_i_ps" != "closed" ]]; then
        echo "wt-close: also closing absorbed I-* issue $_po_absorbed_i..."
        if _close_platform_ids_readonly "$_po_i_file" "$_po_absorbed_i"; then
          echo "wt-close: absorbed I-* closed ✓"
        else
          echo "Error: platform close failed for $_po_absorbed_i; cleanup stopped" >&2
          exit 1
        fi
      fi
    fi
  fi

  echo "wt-close: --platform-only complete (platform closed, local files unchanged)"
  echo "  Note: local platform_state still shows 'open'. Next scan will detect inconsistency."
  exit 0
fi

# ── Phase 2: Platform close ── (skipped for orphaned branches)

if [[ "$FORCE" == true && -z "$wt_path" ]]; then
    :  # skip platform close for orphaned branches
  elif [[ "$SKIP_PLATFORM" == false && -n "$issue_id" && -f "${issue_file:-}" ]]; then
  if [[ "$DRY_RUN" == true ]]; then
    _dry "freely issue-sync close $issue_id completed"
  else
    # ── Check if pr-merge-guarded already synced ──
    # pr-merge-guarded writes platform_state: closed to the worktree before merge.
    # If that field is already present, issue-sync close is redundant — skip it.
    _wt_existing_platform_state="$(_fm_get "$issue_file" "platform_state")"
    if [[ "$_wt_existing_platform_state" == "closed" ]]; then
      echo "wt-close: platform_state already closed (pr-merge-guarded synced), skipping issue-sync"
    else
      # platform_state is NOT closed.  In normal flow pr-merge-guarded should have
      # handled this.  Reaching here means the sync was missed — tell the user to
      # go through the formal workflow instead of force-discarding the diff.
      if [[ "$FORCE" != true ]]; then
        cat >&2 <<WTPLATFORM_MISSING
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  wt-close: platform_state 未同步，请走正规化流程           ║
╠══════════════════════════════════════════════════════════════╣
║                                                              ║
║  pr-merge-guarded 未完成 issue-sync。                         ║
║  issue.md 缺少 platform_state: closed。                       ║
║                                                              ║
║  正确处理（不要 --force 丢弃有价值的状态）:                     ║
║    1. cd $wt_path && git stash          # 暂存修改            ║
║    2. freely wt-close --raw-key $_raw_key # 正常关闭工位      ║
║    3. cd <project-root>                                       ║
║    4. freely feedback ...               # 创建 raw issue      ║
║    5. freely wt-create ...              # 创建新工位           ║
║    6. cd <新工位> && git stash pop       # 恢复修改            ║
║    7. 按规范流程: B1 → B2 → dev → test → PR → merge           ║
║                                                              ║
║  --force 允许跳过（仅当确认要丢弃）:                            ║
║    freely wt-close --raw-key $_raw_key --force                ║
║    --reason "违规绕过门禁中，理由充分，是：<业务理由>"          ║
╚══════════════════════════════════════════════════════════════╝
WTPLATFORM_MISSING
        exit 1
      fi
      echo "wt-close: --force, closing platform issue for $issue_id..."
      if _close_issue_platforms_readonly "$_raw_key" "$issue_file" "$issue_id" 2>&1; then
        echo "wt-close: platform issue closed ✓"
      else
        echo "Error: platform close failed for $issue_id; cleanup stopped" >&2
        exit 1
      fi
    fi

  fi
elif [[ "$SKIP_PLATFORM" == true ]]; then
  echo "wt-close: --skip-platform, skipping platform close"
fi

# ── Phase 2.5: linked children closeout ──
# A raw is 1:N (promoted_children) but owns exactly ONE worktree. Deleting the
# worktree therefore requires every child to be terminal, and every completed
# child must have its platform replica closed - otherwise linked issues
# accumulate as OPEN forever (raw-20261113T115957Z).
# The children documents live under docs/B2-docs/{epic}/{story}/raw-{key}/issues/,
# NOT docs/B1-docs (the old path never existed, so the previous block was dead code).
if [[ "$FORCE" != true || -n "${wt_path:-}" ]]; then
  if [[ -n "${issue_file:-}" && -f "${issue_file:-}" ]]; then
    _wt_children_report="$(python3 - "$PROJECT_ROOT" "$issue_file" <<'PYCHILD'
import glob
import os
import sys

import yaml

root, raw_file = sys.argv[1], sys.argv[2]
text = open(raw_file, encoding="utf-8").read()
parts = text.split("---", 2)
fm = yaml.safe_load(parts[1]) if len(parts) >= 3 else {}
children = [str(c) for c in (fm.get("promoted_children") or [])]
absorbed = str(fm.get("absorbed_into") or "")
if absorbed and absorbed not in children:
    children.append(absorbed)
for child in children:
    matches = sorted(glob.glob(os.path.join(
        root, "docs/B2-docs", "*", "*", "raw-*", "issues", child + ".md")))
    if not matches:
        print("%s\tMISSING\t\t" % child)
        continue
    cfile = matches[0]
    ctext = open(cfile, encoding="utf-8").read()
    cparts = ctext.split("---", 2)
    cfm = yaml.safe_load(cparts[1]) if len(cparts) >= 3 else {}
    # Empty fields MUST NOT be emitted as empty TSV columns: bash IFS=$'\t'
    # collapses consecutive whitespace delimiters, which shifted the path into
    # the platform_state column and broke the close (raw-20261113T122411Z).
    print("%s\t%s\t%s\t%s" % (child, cfm.get("phase_state", "") or "-",
                                 cfm.get("platform_state", "") or "-", cfile))
PYCHILD
)"
    if [[ -n "$_wt_children_report" ]]; then
      _wt_unfinished=""
      while IFS=$'\t' read -r _wt_cid _wt_cphase _wt_cstate _wt_cpath; do
        [[ -n "$_wt_cid" ]] || continue
        case "$_wt_cphase" in
          completed) ;;
          *) _wt_unfinished="${_wt_unfinished}  - ${_wt_cid} (phase_state=${_wt_cphase})"$'\n' ;;
        esac
      done <<< "$_wt_children_report"
      if [[ -n "$_wt_unfinished" ]]; then
        cat >&2 <<WTC_CHILDREN
[wt-close] 拒绝关闭：I-* 尚未就绪

未完成（phase_state 必须是 completed）：
${_wt_unfinished}
一个 raw 只有一个 worktree；删除后这些 I-* 将无法再实现。
收口由 issue-sync 完成（唯一平台写入口）。在本工位内执行：

  freely issue-sync --project <本工位> batch

它会关闭所有 completed 且未关闭的 I-*，并把 platform_state 写成 closed；
提交该变更、走 pr-merge-guarded 之后，再执行 wt-close。
WTC_CHILDREN
        exit 1
      fi
    fi
  fi
fi

# ── Phase 3: Lifecycle ownership boundary ──
# Raw and linked issue metadata must already be terminal before cleanup starts.
# wt-close performs platform/worktree cleanup only and never writes issue files.

# ── Phase 4: Remote branch delete ──

remotes=()
while IFS= read -r remote; do
  remotes+=("$remote")
done < <(git remote 2>/dev/null || true)

_gitee_remote() {
  local remote="$1"
  git remote get-url "$remote" 2>/dev/null | grep -qi "gitee"
}

_gitee_branch_delete() {
  local branch="$1"
  local gitee_py="$PROJECT_ROOT/docs/system/workspace/scripts/runtime/gitee-issue.py"
  [[ -f "$gitee_py" ]] || return 1
  python3 "$gitee_py" delete-branch "$branch" 2>/dev/null
}

if [[ ${#remotes[@]} -gt 0 ]]; then
  for remote in "${remotes[@]}"; do
    if git fetch "$remote" "$branch" 2>/dev/null; then  # fetch may fail for already-deleted branches; try delete anyway
      if [[ "$DRY_RUN" == true ]]; then
        if _gitee_remote "$remote"; then
          _dry "gitee-issue.py delete-branch $branch"
        else
          _dry "git push $remote --delete $branch"
        fi
      else
        echo "wt-close: deleting remote branch '$branch' on '$remote'..."
        if _gitee_remote "$remote"; then
          if _gitee_branch_delete "$branch"; then
            echo "wt-close: gitee branch deleted via API ✓"
          else
            echo "wt-close: gitee API delete failed, trying git push --delete..."
            FREELY_ALLOW_REMOTE_BRANCH_DELETE=1 git push "$remote" --delete "$branch" 2>&1 || echo "wt-close: warning: failed to delete $branch on $remote" >&2
          fi
        else
          FREELY_ALLOW_REMOTE_BRANCH_DELETE=1 git push "$remote" --delete "$branch" 2>&1 || echo "wt-close: warning: failed to delete $branch on $remote" >&2
        fi
      fi
    fi
  done
fi
  # Prune stale local tracking refs for deleted remote branches
  for _r in "${remotes[@]}"; do
    git remote prune "$_r" 2>/dev/null || true
  done

# _update_scan_state: mark scan item as closed after wt-close. Mirrors wt-create.
_update_scan_state() {
  local _rk="$1" _ts
  local _scan_file="$PROJECT_ROOT/.freely/run/manager-task-source-scan-latest.json"
  _ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  [[ -f "$_scan_file" ]] || return 0
  python3 -c "
import json, os
try:
    with open('$_scan_file') as f: scan = json.load(f)
    for item in scan.get('items', []):
        key = item.get('key', '')
        na = item.get('next_action', '')
        if '$_rk' in key or '$_rk' in na:
            item['scan_state'] = 'closed'
            item['scan_state_updated_at'] = '$_ts'
    tmp = '$_scan_file' + '.tmp'
    with open(tmp, 'w') as f: json.dump(scan, f, indent=2)
    os.rename(tmp, '$_scan_file')
except: pass
" 2>/dev/null || true
}

# ── Phase 4.5: Safe worker shutdown ─────────────────────

# Stop any active workers on this raw_key before deleting the worktree.
# Prevents zombie worker processes (run-acp-prompt.py with cwd to deleted dir).
_a2a_task_py="$PROJECT_ROOT/docs/system/workspace/scripts/runtime/a2a_task.py"
_db_path="$PROJECT_ROOT/.freely/freely.db"
_raw_key="$(echo "$branch" | grep -oE '[0-9]{8}T[0-9]{4,6}Z' | head -1 || true)"
if [[ -n "$_raw_key" && -f "$_a2a_task_py" && -f "$_db_path" ]]; then
  _active_workers=$(python3 "$_a2a_task_py" list --raw-key "$_raw_key" --status working,submitted,launched 2>/dev/null | python3 -c "
import json,sys
try:
    data=json.load(sys.stdin)
    rows=data.get('rows',[])
    for r in rows:
        print(f\"{r.get('task_id','')}\t{r.get('worker_pid','')}\t{r.get('session_id','')}\t{r.get('state','')}\")
except: pass
" 2>/dev/null || true)

  if [[ -n "$_active_workers" ]]; then
    echo "wt-close: checking active workers for raw_key=$_raw_key..."
    while IFS=$'\t' read -r _wtask_id _wpid _wsession _wstate; do
      [[ -n "$_wtask_id" ]] || continue
      echo "wt-close: worker task=$_wtask_id pid=$_wpid state=$_wstate"

      # Check if process exists
      if [[ -n "$_wpid" ]] && kill -0 "$_wpid" 2>/dev/null; then
        # Try graceful shutdown via A2A session/prompt
        if [[ -n "$_wsession" ]]; then
          echo "wt-close: sending shutdown request to worker $_wtask_id (session=$_wsession)..."
          python3 "$_a2a_task_py" prompt --task-id "$_wtask_id" \
            --message "wt-close: worktree closing, please complete and a2a-exit." >/dev/null 2>&1 || true
          # Wait for worker to exit gracefully (max 10s)
          for _i in 1 2 3 4 5; do
            sleep 2
            kill -0 "$_wpid" 2>/dev/null || break
          done
        fi
        # Force kill if still alive
        if kill -0 "$_wpid" 2>/dev/null; then
          echo "wt-close: force-killing worker pid=$_wpid..."
          kill -TERM "$_wpid" 2>/dev/null || true
          sleep 2
          kill -0 "$_wpid" 2>/dev/null && kill -9 "$_wpid" 2>/dev/null || true
        fi
        echo "wt-close: worker $_wtask_id shutdown complete"
      else
        echo "wt-close: worker $_wtask_id already exited (pid=$_wpid not found)"
      fi

      # Gracefully close ACP session before marking task completed
      if [[ -n "$_wsession" ]]; then
        _acp_bridge="/tmp/freely-acp-$(python3 -c "import hashlib,os; print(hashlib.sha256(os.path.abspath('$PROJECT_ROOT').encode()).hexdigest()[:16])" 2>/dev/null).sock"
        if [[ -S "$_acp_bridge" ]]; then
          python3 -c "
import json, socket
req = json.dumps({'jsonrpc':'2.0','id':1,'method':'session/close','params':{'sessionId':'$_wsession'}}) + '\n'
s = socket.socket(socket.AF_UNIX); s.settimeout(5)
try:
    s.connect('$_acp_bridge'); s.sendall(req.encode()); s.shutdown(socket.SHUT_WR)
    s.recv(4096)
except: pass
finally: s.close()
" 2>/dev/null || true
        fi
      fi
      # Mark task as completed (was 'consumed' — invalid A2A state, silently rejected by SQLite CHECK)
      python3 "$_a2a_task_py" update --task-id "$_wtask_id" --state completed >/dev/null 2>&1 || true
    done <<<"$_active_workers"
  fi

  # Safety net: scan for any residual run-acp-prompt processes in this worktree
  if [[ -n "$wt_path" && -d "$wt_path" ]]; then
    _residual_pids=$(ps aux | grep "run-acp-prompt.*$wt_path" | grep -v grep | awk '{print $2}' || true)
    if [[ -n "$_residual_pids" ]]; then
      echo "wt-close: cleaning up residual worker processes in $wt_path..."
      for _rpid in $_residual_pids; do
        kill -9 "$_rpid" 2>/dev/null || true
      done
    fi
  fi
fi

# ── Phase 5: Consume A2A tasks then remove worktree ──

# auto-consume all terminal worker tasks (variables set in Phase 4.5).
# Worker tasks should remain visible (completed/blocked) until wt-close,
# so the manager can read and process them before the worktree is retired.
if [[ -n "$_raw_key" && -f "$_a2a_task_py" && -f "$_db_path" ]]; then
  _consumed=$(python3 "$_a2a_task_py" auto-consume --db "$_db_path" --raw-key "$_raw_key" 2>/dev/null || true)
  echo "wt-close: consumed ${_consumed:-0} tasks for $_raw_key"
  _update_scan_state "$_raw_key" "closed"
fi

if [[ -n "$wt_path" ]]; then
  if [[ "$DRY_RUN" == true ]]; then
    _dry "git worktree remove $wt_path"
  else
	    # ── Worktree cleanliness check (删工位前; --force 跳过) ──
	    if [[ "$FORCE" != true ]]; then
	      _dirty_files=$(git -C "$wt_path" status --porcelain 2>/dev/null | grep -v '^?' | head -20 || true)
	      _untracked=$(git -C "$wt_path" ls-files --others --exclude-standard 2>/dev/null | head -20 || true)
	      if [[ -n "$_dirty_files" ]] || [[ -n "$_untracked" ]]; then
	        cat >&2 <<WTCLOSE_DIRTY
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  [WT-CLOSE] 工位有未提交的文件 — 删工位前请先处理          ║
╠══════════════════════════════════════════════════════════════╣
║  工位: $wt_path
║  以下文件尚未提交——删除工位后这些修改将永久丢失。              ║
║                                                              ║
║  未提交的修改 (tracked):                                       ║
$(printf "%s\n" "$_dirty_files" | sed 's/^/║    /')
║                                                              ║
║  未跟踪的文件 (untracked):                                     ║
$(printf "%s\n" "$_untracked" | sed 's/^/║    /')
║                                                              ║
║  两条路，根据实际情况选:                                         ║
║                                                              ║
║  ① 这些修改没用 → 带 --force 直接丢弃:                          ║
║      freely wt-close --raw-key $_raw_key --force             ║
║      --reason "违规绕过门禁中，理由充分，是：<写清为什么丢弃>"    ║
║                                                              ║
║  ② 这些修改有用 → stash 暂存，开 raw issue 正规化:              ║
║      cd $wt_path && git stash                                ║
║      cd <project-root>                                       ║
║      freely feedback --title "fix: ..." --kind fix \         ║
║        --body "从 wt-close 拦截中恢复的修改: ..."               ║
║      然后重新运行 freely wt-close --raw-key $_raw_key          ║
║                                                              ║
║  --force 什么都不检查直接删——确定没用就用它。                    ║
╚══════════════════════════════════════════════════════════════╝
WTCLOSE_DIRTY
	        exit 1
	      fi
	    fi


    echo "wt-close: removing worktree $wt_path..."
    if FREELY_WT_BYPASS_GUARD=1 command git worktree remove "$wt_path" 2>/dev/null; then
      echo "wt-close: worktree removed ✓"
    else
      echo "Warning: worktree has dirty/untracked files, retrying with --force..." >&2
      FREELY_WT_BYPASS_GUARD=1 command git worktree remove --force "$wt_path" 2>/dev/null || {
        echo "Error: could not remove worktree $wt_path, remove manually" >&2
        exit 1
      }
    fi
  fi
elif [[ "$FORCE" == true ]]; then
  echo "wt-close: no worktree to remove (orphaned branch cleanup)"
fi

# ── Phase 6: Local branch delete ──

cd "$PROJECT_ROOT" || { echo "Error: cannot cd to $PROJECT_ROOT" >&2; exit 1; }

if [[ "$DRY_RUN" == true ]]; then
  _dry "git branch -d $branch"
else
	echo "wt-close: deleting branch $branch..."
	if git branch --merged develop | grep -q "$branch"; then
	  git branch -d "$branch" 2>/dev/null && echo "wt-close: branch deleted ✓"
	elif [[ "$DISCARD_UNMERGED" == true ]]; then
	  echo "wt-close: --discard-unmerged, using -D..." >&2
	  git branch -D "$branch" 2>/dev/null || true
	else
	  # fix and feature share one workflow skill; only the RED-phase semantics
	  # differ (see skill:freely-workflow-guarded-execution §fix 与 feature 的唯一差异).
	  _wt_skill="freely-workflow-guarded-execution"
	  case "$branch" in
	    fix/*)
	      _wt_skill_name="fix 分支 — 先复现 RED，再实现"
	      ;;
	    feature/*)
	      _wt_skill_name="feature 分支 — 先设计验收，再实现"
	      ;;
	    *)
	      _wt_skill_name="无法从分支名判断"
	      ;;
	  esac
	  cat >&2 <<UNMERGED

╔══════════════════════════════════════════════════════════════╗
║  ⚠️  严重警告：分支未合并到 develop，无法安全删除                ║
╠══════════════════════════════════════════════════════════════╣
║                                                              ║
║  分支 $branch 的提交尚未合并到 develop。                        ║
║                                                              ║
║  大概率是 pr-merge-guarded 还没执行成功。                       ║
║  请仔细阅读 skill:${_wt_skill}（${_wt_skill_name}），               ║
║  按 skill 工作流完成 merge 后再关闭工位。                        ║
║                                                              ║
║  如果确定要丢弃未合并的提交（不可恢复）：                         ║
║    wt-close $branch --force --discard-unmerged \\
║      --reason "违规绕过门禁中，理由充分，是：<业务理由>"           ║
║                                                              ║
╚══════════════════════════════════════════════════════════════╝

UNMERGED
	  exit 1
	fi
fi

# ── Phase 6b: Cleanup companion test-pre-merge via raw-key ──
# fix|feature/raw-{raw_key}-{slug} and test-pre-merge-{raw_key}-{slug} share the same raw-key.
# Derive the test-pre-merge branch from the fix|feature branch name — no stored relationship needed.
if [[ "$branch" == fix/raw-* || "$branch" == feature/raw-* ]]; then
  _tp_raw_key=$(echo "$branch" | sed -n 's|.*/raw-\([0-9]\{8\}T[0-9]\{6\}Z\)-.*|\1|p')
  _tp_slug=$(echo "$branch" | sed -n 's|.*/raw-[0-9]\{8\}T[0-9]\{6\}Z-\(.*\)|\1|p')
  if [[ -n "$_tp_raw_key" ]]; then
    _tp_branch="test-pre-merge-${_tp_raw_key}-${_tp_slug}"
    _tp_wt="$PROJECT_WORKTREES_ROOT/test-pre-merge-${_tp_raw_key}-${_tp_slug}"
    if git show-ref --verify --quiet "refs/heads/$_tp_branch" 2>/dev/null; then
      # --dry-run must be side-effect free here too: this phase removes a real
      # worktree/branch AND releases agent rows (Phase 5/6/7 already branch on
      # DRY_RUN; Phase 6b was the gap, and it destroyed the only test-gate
      # evidence during a rehearsal).
      if [[ "$DRY_RUN" == true ]]; then
        _dry "git worktree remove $_tp_wt"
        _dry "git branch -D $_tp_branch"
        _dry "release agent_working rows for raw-${_tp_raw_key}"
      elif [[ "$FORCE" == true ]]; then
        echo "wt-close: 严重警告 —— 已经用 --force 参数彻底丢弃了所有修改"
        [[ -d "$_tp_wt" ]] && git worktree remove --force "$_tp_wt" 2>/dev/null || true
        git branch -D "$_tp_branch" 2>/dev/null || echo "wt-close: warning - test-pre-merge branch deletion failed" >&2
        echo "wt-close: test-pre-merge 已强制删除 ✓"
      else
        echo "wt-close: cleaning up companion test-pre-merge: $_tp_branch"
        if [[ -d "$_tp_wt" ]]; then
          git worktree remove "$_tp_wt" || { echo "wt-close: 删除 test 工位失败" >&2; exit 1; }
        fi
        if git show-ref --verify --quiet "refs/heads/$_tp_branch" 2>/dev/null; then
          git branch -D "$_tp_branch" || { echo "wt-close: 删除 test 分支失败" >&2; exit 1; }
        fi
        echo "wt-close: test-pre-merge cleaned ✓"
      fi
    fi
	    # Release agent from agent_working table (replaces agent-id.env cleanup).
	    if [[ "$DRY_RUN" == true ]]; then
	      :  # --dry-run: nothing released; the plan is printed above
	    else
	    _dev_wt=$(git worktree list --porcelain 2>/dev/null | awk '$1=="worktree"{wt=$2} $1=="branch"&&$2=="refs/heads/develop"{print wt;exit}')
	    [[ -n "$_dev_wt" ]] || _dev_wt="$PROJECT_ROOT"
	    # Phase 1: close ACP sessions + release agent_working table
	    if [[ -f "$_dev_wt/docs/system/workspace/scripts/runtime/agent_working.py" ]]; then
	      # Close ACP sessions (worker + reviewer) before releasing table entries
	      python3 -c "
import sys,os,json,socket,hashlib
sys.path.insert(0, '$_dev_wt/docs/system/workspace/scripts/runtime')
from agent_working import agent_list_by_raw_key, agent_get_session
row = agent_list_by_raw_key('$_dev_wt', 'raw-${_tp_raw_key}')
if row:
    h = hashlib.sha256('$_dev_wt'.encode()).hexdigest()[:16]
    bridge = f'/tmp/freely-acp-{h}.sock'
    if os.path.exists(bridge):
        for role in ('worker', 'reviewer', 'manager'):
            sid = agent_get_session('$_dev_wt', 'raw-${_tp_raw_key}', role)
            if sid:
                try:
                    s=socket.socket(socket.AF_UNIX); s.settimeout(2); s.connect(bridge)
                    req=json.dumps({'jsonrpc':'2.0','id':1,'method':'session/close','params':{'sessionId':sid}})+'
'
                    s.sendall(req.encode()); s.shutdown(socket.SHUT_WR); s.recv(4096); s.close()
                except: pass
" 2>/dev/null || true
	      # Release from agent_working table
	      python3 -c "
import sys; sys.path.insert(0, '$_dev_wt/docs/system/workspace/scripts/runtime')
from agent_working import agent_release_all
agent_release_all('$_dev_wt', 'raw-${_tp_raw_key}')
" 2>/dev/null && echo "wt-close: agent_working released for raw-${_tp_raw_key}" || true
	    fi
	    # Fallback: legacy agent-id.env cleanup
	    _agent_env="$_dev_wt/.freely/agent-id.env"
	    if [[ -f "$_agent_env" ]]; then
	      sed -i.bak "/raw-${_tp_raw_key}/d" "$_agent_env" 2>/dev/null || true; rm -f "$_agent_env.bak"
	    fi
	    fi
  fi
fi

# ── Phase 7: Sync develop across platforms ──

# Only sync when closing a test-pre-merge-* branch (PR was merged to develop)
if [[ "$branch" == test-pre-merge-* ]]; then
  echo "wt-close: syncing develop across platforms..."

  if [[ "$DRY_RUN" == true ]]; then
    _dry "git fetch github origin"
    _dry "git update-ref refs/heads/develop <sha>"
    _dry "git push origin develop:develop"
  else
    # 1. Fetch all remotes
    for remote in $(git remote); do
      git fetch "$remote" develop 2>/dev/null || true
    done

    # 2. Find authoritative SHA (github as primary platform)
    authoritative_sha=$(git rev-parse github/develop 2>/dev/null || echo "")

    if [[ -n "$authoritative_sha" ]]; then
      # 3. Sync local develop if needed
      local_sha=$(git rev-parse develop 2>/dev/null || echo "")

      if [[ "$local_sha" != "$authoritative_sha" ]]; then
        if git diff --quiet HEAD 2>/dev/null; then
          echo "wt-close: updating local develop to $(git rev-parse --short "$authoritative_sha")..."
          git update-ref refs/heads/develop "$authoritative_sha"
          echo "wt-close: local develop synced ✓"
        else
          echo "wt-close: warning - local develop is dirty, skipping local sync" >&2
        fi
      fi

      # 4. Sync to other platforms (origin/gitee)
      origin_sha=$(git rev-parse origin/develop 2>/dev/null || echo "")

      if [[ -n "$origin_sha" && "$origin_sha" != "$authoritative_sha" ]]; then
        echo "wt-close: syncing develop to gitee (origin)..."
        if git push origin "develop:develop" 2>/dev/null; then
          echo "wt-close: gitee develop synced ✓"
        else
          echo "wt-close: warning - failed to sync gitee (may need manual sync)" >&2
        fi
      fi
    fi
  fi
fi

echo "wt-close: done ✓"
