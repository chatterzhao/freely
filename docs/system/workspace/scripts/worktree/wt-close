#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/worktree-common.sh"

# Paths from config.toml (single source of truth)
PROJECT_ROOT="${PROJECT_ROOT:-}"
PROJECT_WORKTREES_ROOT="${PROJECT_WORKTREES_ROOT:-}"
PROJECT_WORKTREE_PATH="${PROJECT_WORKTREE_PATH:-}"

# Derive from config.toml if not already set
if [[ -z "$PROJECT_ROOT" ]] && [[ -f ".freely/config.toml" ]]; then
  PROJECT_ROOT="$(dirname "${BASH_SOURCE[0]}")/../../../../.."
  PROJECT_ROOT="$(cd "$PROJECT_ROOT" && pwd -P)"
fi
if [[ -z "$PROJECT_WORKTREES_ROOT" ]]; then
  PROJECT_WORKTREES_ROOT="${PROJECT_ROOT}-worktrees"
fi

FORCE=false
DISCARD_UNMERGED=false
FORCE_REASON=""
SKIP_PLATFORM=false
PLATFORM_ONLY=false
DRY_RUN=false

usage() {
  cat <<USAGE
Usage:
  freely wt-close --raw-key <key> [options]

Close both the fix|feature worktree and its companion test-pre-merge worktree.
--raw-key 是唯一必填参数。命令从 raw key 自动发现两个工位，按先测试后开发的顺序关闭。
  --raw-key <key>       Raw issue key.  Compatible with multiple formats:
                          raw-20260629T160852Z
                          fix/raw-20260629T160852Z-my-fix
                          feature/raw-20260629T160852Z-my-feat
                          20260629T160852Z
Options (按场景选择):
  --reason <text>    REQUIRED with any bypass flag below.  Format:
                      --reason "违规绕过门禁中，理由充分，是：<业务理由>"

  ── 正常关闭 (PR 已 merge，无需 bypass) ──
  (no flags)         Standard close.  Requires clean worktree, synced test worktree,
                      passed pretests, completed phase_state.

  ── 彻底丢弃（不可恢复）──
  --force            永久丢弃。必须配合 --raw-key 和 --reason。
  --discard-unmerged  确认丢弃未 merge 的提交（需同时 --force）。

  ── 仅操作平台，不管本地 ──
  --platform-only    只关闭平台 issue。必须配合 --raw-key 和 --reason。

  ── 其他 ──
  --skip-platform    跳过平台 issue 关闭。
  --dry-run          只打印操作，不执行。

Scenarios:
    # PR 已 merge，正常收口
  freely wt-close --raw-key 20260627T021849Z
  # 确定放弃此 issue
    # PR 已 merge，正常收口
  freely wt-close --raw-key 20260627T021849Z --force --reason "违规绕过门禁中，理由充分，是：该功能确定放弃"

  # 无工位，只关闭平台 issue
    # PR 已 merge，正常收口
  freely wt-close --raw-key 20260627T021849Z --platform-only --reason "违规绕过门禁中，理由充分，是：工位已清理仅剩平台 issue"

USAGE
}

# ── Frontmatter helpers (inline, matches issue-sync pattern) ──

_fm_get() {
  local file="$1" key="$2"
  python3 -c "
import yaml, sys
with open('$file') as f: content = f.read()
if not content.startswith('---'): sys.exit(0)
parts = content.split('---', 2)
if len(parts) < 3: sys.exit(0)
fm = yaml.safe_load(parts[1]) or {}
val = fm.get('$key','')
if isinstance(val, dict):
  import json; print(json.dumps(val))
elif isinstance(val, list):
  import json; print(json.dumps(val))
elif val is not None:
  print(val)
" 2>/dev/null || true
}

_fm_set_str() {
  local file="$1" key="$2" value="$3"
  python3 -c "
import yaml
with open('$file') as f: content = f.read()
parts = content.split('---', 2)
fm = yaml.safe_load(parts[1]) if len(parts) >= 3 else {}
fm['$key'] = '$value'
new_fm = yaml.dump(fm, default_flow_style=False, allow_unicode=True, sort_keys=False).strip()
body = parts[2] if len(parts) >= 3 else ''
with open('$file', 'w') as f: f.write('---\n' + new_fm + '\n---' + body)
" 2>/dev/null || true
}

# ── Branch/issue resolution ──

_resolve_branch() {
  local input="$1"
  if [[ -d "$input" ]]; then
    git worktree list --porcelain | awk -v wt="$input" '
      $1=="worktree" && $2==wt {found=1}
      found && $1=="branch" {print $2; exit}
    ' | sed 's|^refs/heads/||'
    return 0
  fi
  echo "$input"
}

_resolve_worktree_path() {
  local branch="$1"
  local existing
  existing="$(freely_wt_existing_for_branch "$branch")"
  if [[ -n "$existing" ]]; then
    echo "$existing"
    return 0
  fi
  return 1
}

_is_protected_branch() {
  local branch="$1"
  case "$branch" in
    main|develop|test-pre-merge-*) return 0 ;;
    *) return 1 ;;
  esac
}

# ── Dry-run logging ──

_dry() {
  echo "[DRY-RUN] $*"
}

# ── Parse args ──

args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --force) FORCE=true; shift ;;
    --discard-unmerged) DISCARD_UNMERGED=true; shift ;;
    --reason) FORCE_REASON="$2"; shift 2 ;;
    --skip-platform) SKIP_PLATFORM=true; shift ;;
    --raw-key) RAW_KEY="$2"; shift 2 ;;
    --platform-only) PLATFORM_ONLY=true; shift ;;
    --dry-run) DRY_RUN=true; shift ;;
    --help|-h) usage; exit 0 ;;
    -*) echo "Unknown: $1" >&2; usage; exit 1 ;;
    *) args+=("$1"); shift ;;
  esac
done

if [[ ${#args[@]} -gt 0 ]]; then
  set -- "${args[@]}"
else
  set --
fi

# ── Extract raw key from various formats ──
# Supports: raw-YYYYMMDDTHHMMSSZ, fix/raw-{key}-{slug}, feature/raw-{key}-{slug}, YYYYMMDDTHHMMSSZ
_extract_raw_key() {
  local val="$1"
  # Strip fix/ or feature/ prefix first
  local stripped="${val#fix/}"
  stripped="${stripped#feature/}"
  # Extract raw-YYYYMMDDTHHMMSSZ pattern (just the key part, not the slug)
  local raw_match
  raw_match=$(echo "$stripped" | grep -oE 'raw-[0-9]{8}T[0-9]{4,6}Z' 2>/dev/null | head -1 || true)
  if [[ -n "$raw_match" ]]; then
    echo "${raw_match#raw-}"
  elif [[ "$val" =~ ^[0-9]{8}T[0-9]{4,6}Z$ ]]; then
    echo "$val"
  else
    echo ""
  fi
}

# ── Resolve branch from raw key ──
_resolve_branch_from_raw_key() {
  local raw_key="$1"
  local matched
  matched=$(git branch --list "fix/raw-${raw_key}-*" "feature/raw-${raw_key}-*" 2>/dev/null | sed 's/^[*+ ]*//' | head -1 || true)
  echo "$matched"
}

# ── Determine input from --raw-key ──
if [[ -n "${RAW_KEY:-}" ]]; then
  _raw_key="$(_extract_raw_key "$RAW_KEY")"
  if [[ -z "$_raw_key" ]]; then
    echo "Error: could not extract raw key from '${RAW_KEY}'" >&2
    echo "  Supported formats: raw-YYYYMMDDTHHMMSSZ, fix/raw-{key}-{slug}, feature/raw-{key}-{slug}, YYYYMMDDTHHMMSSZ" >&2
    exit 1
  fi
  if [[ "${PLATFORM_ONLY:-false}" == true ]]; then
    # --platform-only: skip branch resolution, use raw key directly for API close
    input="raw-${_raw_key}"
    branch="$input"
    echo "wt-close: raw key '${_raw_key}' (--platform-only, no branch resolution)"
  else
    _matched="$(_resolve_branch_from_raw_key "$_raw_key")"
    if [[ -z "$_matched" ]]; then
      echo "Error: no fix/feature branch found for raw key '${_raw_key}'" >&2
      echo "  Searched: fix/raw-${_raw_key}-* and feature/raw-${_raw_key}-*" >&2
      echo "  Check available branches:" >&2
      echo "    git branch --list \"fix/raw-${_raw_key}-*\" \"feature/raw-${_raw_key}-*\"" >&2
      exit 1
    fi
    input="$_matched"
    echo "wt-close: raw key '${_raw_key}' → branch '${input}'"
  fi
else
  echo "Error: --raw-key is required" >&2
  usage
  exit 1
fi

# ── --reason gate: bypass flags require valid reason ──
# Reason must start with "违规绕过门禁中，理由充分，是：" to prevent casual abuse.
if true; then  # --raw-key always passes through reason check
  _require_reason() {
    local flag="$1" flag_name="$2"
    if [[ "${!flag:-false}" != "true" ]]; then
      return 0
    fi
    if [[ -z "${FORCE_REASON:-}" ]] || ! echo "${FORCE_REASON}" | grep -q "^违规绕过门禁中，理由充分，是："; then
      cat >&2 <<GATE
[GATE] 检测到你试图违规绕过门禁: wt-close ${flag_name}

  如果是因为实现没有达到门禁要求，请按要求去完成，而不是想着违规绕过。

  只有确实有合理的业务理由，才允许绕过。
  请按以下格式加上绕过理由:
    --reason "违规绕过门禁中，理由充分，是：<业务理由>"

  --force 合法业务理由:
    - 该功能需求确定不再需要继续实现（如产品方向变更、需求被撤销等）
    - 工位目录已损坏或丢失，仅剩分支引用需清理
  --discard-unmerged 合法业务理由:
    - 该方案已被否决，未合并的提交确认不再需要（需同时使用 --force）
  --platform-only 合法业务理由:
    - 工位已删除但平台 issue 仍 OPEN，需关闭平台 issue 收口
    - 孤儿 raw issue——工位和分支已清理，仅剩平台 issue 未同步关闭

  --skip-platform 合法业务理由:
    - 平台 issue 已通过其他渠道手动关闭，无需同步

  示例:
    freely wt-close --force --reason "违规绕过门禁中，理由充分，是：该功能确定放弃，不再继续实现此 raw issue" fix/raw-xxx
    freely wt-close --force --discard-unmerged --reason "违规绕过门禁中，理由充分，是：该方案已被否决，未合并提交确认丢弃" fix/raw-xxx
GATE
    fi
  }
  _require_reason FORCE "--force"
  _require_reason SKIP_PLATFORM "--skip-platform"
  _require_reason PLATFORM_ONLY "--platform-only"
  _require_reason DISCARD_UNMERGED "--discard-unmerged"
fi

if [[ -z "$input" ]]; then
  echo "Error: --raw-key is required" >&2
  usage
  exit 1
fi

# ── Resolve branch ──
branch="$(_resolve_branch "$input")"
if [[ -z "$branch" ]]; then
  echo "Error: could not resolve branch from '$input'" >&2
  exit 1
fi
echo "wt-close: branch = $branch"

# Derive PROJECT_WORKTREE_PATH from branch name
if [[ -z "$PROJECT_WORKTREE_PATH" ]] && [[ -n "$branch" ]]; then
  _wt_dir="$(freely_wt_dir_name_for_branch "$branch")"
  PROJECT_WORKTREE_PATH="${PROJECT_WORKTREES_ROOT}/${_wt_dir}"
fi
ISSUES_DIR="$PROJECT_WORKTREE_PATH/docs/B1-docs"

# ── Guard: protected branch (test-pre-merge is disposable, skip checks) ──
if _is_protected_branch "$branch"; then
  echo "Error: '$branch' is a protected branch, cannot close" >&2
  exit 1
fi

# ── Resolve worktree path ──
wt_path="$(_resolve_worktree_path "$branch" || true)"
if [[ -z "$wt_path" ]]; then
  if [[ "$FORCE" == true || "$PLATFORM_ONLY" == true ]]; then
    if [[ "$PLATFORM_ONLY" == true ]]; then
      echo "wt-close: --platform-only, no worktree found for '$branch' (API close only)"
    else
      echo "wt-close: --force, no worktree found for '$branch' (orphaned branch cleanup)"
    fi
  else
    echo "Error: no worktree found for branch '$branch'" >&2
    echo "  Use --force with --raw-key to close an orphaned worktree." >&2
    echo "  Or use --platform-only to just close the platform issue via API." >&2
    exit 1
  fi
else
  echo "wt-close: worktree = $wt_path"
fi

# ── Extract issue id ──
issue_id="raw-${_raw_key}"  # always derived from raw key
if [[ -z "$issue_id" ]]; then
  echo "Warning: could not extract issue id from branch '$branch'" >&2
  echo "  Skipping phase_state check and platform close." >&2
fi

# ── Phase 0: Comment resolution check ──
# Scans raw issue comments. Blocks wt-close if any human comment lacks resolution.
if [[ -n "$issue_id" ]]; then
  _raw_file="$ISSUES_DIR/$issue_id/issue.md"
  if [[ -f "$_raw_file" ]]; then
    _raw_text="$(cat "$_raw_file")"
    _unresolved=$(echo "$_raw_text" | grep -c "^### comment-" 2>/dev/null || true)
    _resolved=$(echo "$_raw_text" | grep -c "^#### resolution-" 2>/dev/null || true)
    if [[ "$_unresolved" -gt "$_resolved" ]]; then
      echo "[wt-close] $issue_id: $_unresolved comments, $_resolved resolutions — $_((_unresolved - _resolved)) unresolved"
      echo "  每条人类评论必须有子评论标记 adopted（采纳）或 discarded（丢弃）"
      echo "  添加 #### resolution-{ts} 后重试 wt-close"
      exit 1
    fi
    echo "wt-close: comment check ($_resolved/$_unresolved resolved) ✓"
  fi
fi

# ── Phase 1: Checks ──

if [[ -n "$issue_id" ]]; then
  issue_file="$ISSUES_DIR/$issue_id/issue.md"
fi

if [[ "$FORCE" == false && -n "$issue_id" && -f "${issue_file:-}" ]]; then
  phase_state="$(_fm_get "$issue_file" "phase_state")"
  if [[ -z "$phase_state" || ( "$phase_state" != "completed" && "$phase_state" != "absorbed" ) ]]; then
    cat >&2 <<PHASE_GATE
[wt-close] $issue_id 的 phase_state='${phase_state:-<empty>}'，不满足 wt-close 要求的 'completed' 或 'absorbed'

  'absorbed' 是正常完成状态——pr-merge-guarded 将 raw issue 吸收到 I-* issue，表示工作已完成。

  请判断属于以下哪种情况，然后采取对应措施:

  1. 实现已完成，只是 phase_state 忘记更新为 completed 或 absorbed
     → 更新 $issue_file 的 phase_state，然后重新执行 wt-close

  2. 实现确实还没做完
     → 请回到工位继续完成实现工作，完成后再执行 wt-close

  3. 该功能已确定放弃，工位需要强制收口
     → 使用 --force 并给出准确的业务理由:
       freely wt-close $branch --force --reason "违规绕过门禁中，理由充分，是：<业务理由>"

     有效业务理由示例:
       ✅ "该功能确定放弃，不再继续实现此 raw issue"
       ✅ "该方案已被否决，工位需强制收口销毁"
PHASE_GATE
    exit 1
  fi
  echo "wt-close: phase_state=$phase_state ✓"

  # pretests-retirement-gate check
  # Find companion test-pre-merge worktree (same raw key timestamp).
  # test-gate.env lives in the test worktree where the daemon actually ran.
  # The fix worktree doesn't run daemon so it has no test evidence.
  _raw_key_ts=$(echo "$branch" | grep -oE '[0-9]{8}T[0-9]{6}Z' | head -1 || true)
  _test_wt=""
  if [[ -n "$_raw_key_ts" ]]; then
    _test_wt=$(git worktree list --porcelain 2>/dev/null | awk -v k="test-pre-merge-$_raw_key_ts" '
      $1=="worktree" { wt=$2 }
      $1=="branch" && $2 ~ k { print wt; exit }
    ')
  fi
  if [[ -z "$_test_wt" || ! -d "$_test_wt" ]]; then
    cat >&2 <<TEST_MISSING
[wt-close] 找不到对应的测试工位 test-pre-merge-${_raw_key_ts}-*

  测试工位中的 test-gate.env 是测试已运行的唯一证据。
  测试工位缺失意味着无法验证测试是否完成。

  如果测试工位被误删，请重新创建并在其中运行 daemon 完成测试，
  然后再执行 wt-close。
TEST_MISSING
    exit 1
  fi
  if [[ -x "$PROJECT_ROOT/bin/pretests-retirement-gate" ]]; then
    if "$PROJECT_ROOT/bin/pretests-retirement-gate" --project "$PROJECT_ROOT" --worktree-path "$_test_wt" 2>/dev/null; then
      echo "wt-close: pretests-retirement-gate passed ✓"
    else
      cat >&2 <<PRETEST_GATE
[wt-close] pretests-retirement-gate 检查未通过: $_test_wt

  ── 保留此 issue 继续推进 ────────────────────────────────────
  请在测试工位完成测试验证:

  1. cd $_test_wt
  2. freely daemon start --task-mode auto
  3. 按 pre-tests.md 的测试用例逐条验证
  4. daemon 停止后 test-gate.env 会记录测试完成的 commit

  测试通过后重新执行 wt-close。无需 --force。

  ── 确定丢弃此 issue ────────────────────────────────────────
  --force 仅用于此场景: 确定不再继续实现此 raw issue。
    wt-close $branch --force --reason "违规绕过门禁中，理由充分，是：该功能确定放弃"
PRETEST_GATE
      exit 1
    fi
  fi
elif [[ "$FORCE" == true ]]; then
  echo "wt-close: --force, skipping checks"
fi

# ── Guard: refuse to close if the main repo is on the branch being closed ──

# Orphaned branch cleanup: skip frontmatter/issue operations entirely
if [[ "$FORCE" == true && -z "$wt_path" ]]; then
  echo "wt-close: orphaned branch cleanup mode (no worktree, no frontmatter ops)"

else
  # Only block if the branch being closed IS the currently checked-out branch
  _guard_branch=$(git -C "$PROJECT_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
  if [[ "$branch" == "$_guard_branch" ]]; then
    case "$_guard_branch" in
      main|develop|test-pre-merge-*)
        echo "Error: cannot close the currently checked-out protected branch" >&2
        exit 1
        ;;
    esac
  fi
fi

# ── Phase 1.5: Consistency check — dev and test worktrees must be synced ──
# Only for fix|feature branches (skip orphaned, test-pre-merge, main, develop).
# Prevent closing when test results would be lost.

_consistency_check() {
  local _dev_branch="$1" _dev_wt="$2"

  # Skip if not a fix|feature branch
  [[ "$_dev_branch" == fix/raw-* || "$_dev_branch" == feature/raw-* ]] || return 0

  # Extract raw key
  local _raw_key
  _raw_key=$(echo "$_dev_branch" | grep -oE '[0-9]{8}T[0-9]{6}Z' | head -1 || true)
  [[ -n "$_raw_key" ]] || return 0

  # Find test-pre-merge worktree
  local _test_wt
  _test_wt=$(git -C "$PROJECT_ROOT" worktree list --porcelain 2>/dev/null | awk -v k="test-pre-merge-$_raw_key" '
    $1=="worktree" { wt=$2 }
    $1=="branch" && $2 ~ k { print wt; exit }
  ')
  [[ -z "$_test_wt" || ! -d "$_test_wt" ]] && return 0  # no test worktree, skip

  echo "wt-close: checking consistency between dev and test worktrees..."

  # Check 1: dev worktree clean
  if git -C "$_dev_wt" status --short 2>/dev/null | grep -q .; then
    cat >&2 <<DIRTY_DEV
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  wt-close blocked: 开发工位有未提交的修改                ║
╠══════════════════════════════════════════════════════════════╣
║  开发工位: $_dev_wt ($_dev_branch)
║                                                              ║
║  git 跟踪的文件必须提交。请处理后再 wt-close:                  ║
║    cd $_dev_wt && git add -A && git commit
║    git push && pr-review && wt-close
╚══════════════════════════════════════════════════════════════╝
DIRTY_DEV
    exit 1
  fi

  # Check 2: test worktree clean
  if git -C "$_test_wt" status --short 2>/dev/null | grep -q .; then
    cat >&2 <<DIRTY_TEST
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  wt-close blocked: 测试工位有未提交的测试结果            ║
╠══════════════════════════════════════════════════════════════╣
║  测试工位: $_test_wt (test-pre-merge-$_raw_key-*)
║                                                              ║
║  git 跟踪的文件必须提交。请处理后再 wt-close:                  ║
║    cd $_test_wt && git add -A && git commit -m "test: results"
║                                                              ║
║  ⚠️  然后必须同步到开发工位，否则测试通过的代码会丢失:         ║
║    cd $_dev_wt
║    git cherry-pick \$(git -C $_test_wt log --format=%H --no-merges $_dev_branch..HEAD)
║    git push && pr-review && wt-close
╚══════════════════════════════════════════════════════════════╝
DIRTY_TEST
    exit 1
  fi

  # Check 3: test has commits not in dev (test results need cherry-pick)
  local _missing
  _missing=$(git -C "$_test_wt" log --oneline --no-merges "$_dev_branch..HEAD" 2>/dev/null || true)
  if [[ -n "$_missing" ]]; then
    cat >&2 <<NEED_CP
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  wt-close blocked: 测试工位有提交未同步到开发工位        ║
╠══════════════════════════════════════════════════════════════╣
║  开发与测试工位必须一致，否则最后测试通过的代码不在开发里，白干。
║                                                              ║
║  开发工位: $_dev_wt ($_dev_branch)
║  测试工位: $_test_wt (test-pre-merge-$_raw_key-*)
║                                                              ║
║  以下提交在测试工位但不在开发工位:                              ║
║  $_missing
║                                                              ║
║  请用 cherry-pick 同步到开发工位（两边都能互相 cherry-pick）:    ║
║    cd $_dev_wt
║    git cherry-pick \$(git -C $_test_wt log --format=%H --no-merges $_dev_branch..HEAD)
║    git push && pr-review && wt-close
╚══════════════════════════════════════════════════════════════╝
NEED_CP
    exit 1
  fi

  # Check 4: dev has commits not in test (out of sync)
  _missing=$(git -C "$_test_wt" log --oneline --no-merges "HEAD..$_dev_branch" 2>/dev/null || true)
  if [[ -n "$_missing" ]]; then
    cat >&2 <<NEED_CP
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  wt-close blocked: 开发工位有提交未同步到测试工位        ║
╠══════════════════════════════════════════════════════════════╣
║  开发工位: $_dev_wt ($_dev_branch)
║  测试工位: $_test_wt (test-pre-merge-$_raw_key-*)
║                                                              ║
║  开发与测试工位必须一致，否则测试结果没有意义——                  ║
║  测的不是最终要合并的代码。                                    ║
║                                                              ║
