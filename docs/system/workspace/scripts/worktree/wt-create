#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<USAGE
Usage:
  ./bin/wt-create --raw-key <key> --source <platform|chat-inbox> --skill <freely-fix-execution|freely-feat-execution> --slug <slug> [--base <branch>]
  ./bin/wt-create <branch> [--base <base-branch>]    (legacy: 补建 test-pre-merge-*、纯文档、init develop、release 分支)

Required:
  --raw-key <key>     Raw issue key (YYYYMMDDTHHMM[SS]Z format, e.g. 20260513T010343Z)
  --source  <platform|chat-inbox>
                        platform    — GitHub/Gitee OPEN issue
                        chat-inbox  — freely.db chats 表
  --skill   <freely-fix-execution|freely-feat-execution>
                        freely-fix-execution  — 快速修复 bug
                        freely-feat-execution — 新功能/大型改动
  --slug    <slug>    Short descriptive slug for the worktree

Optional:
  --base <branch>     Base branch (default: develop)

What it creates:
  1. {prefix}/raw-{raw-key}-{slug}    ← based on --base (develop), the permanent dev worktree
     prefix is derived from --skill:
       freely-fix-execution   → fix/raw-{raw-key}-{slug}
       freely-feat-execution  → feature/raw-{raw-key}-{slug}
  2. test-pre-merge-{raw-key}-{slug}  ← based on ①, discardable testing sandbox

Examples:
  ./bin/wt-create --raw-key 20260506T100035Z --source platform \
    --skill freely-fix-execution --slug task-mode-wait-prelaunch-gate

  ./bin/wt-create --raw-key 20260506T100035Z --source chat-inbox \
    --skill freely-feat-execution --slug new-auth-module

Legacy:
  ./bin/wt-create feature/my-task-20260307 --base develop
USAGE
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

# ── Argument parsing ─────────────────────────────────────

raw_key=""
source_val=""
skill_name=""
skill_path=""
slug=""
base="develop"
legacy_branch=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --raw-key)
      raw_key="${2:-}"
      [[ -n "$raw_key" ]] || { echo "Missing value for --raw-key" >&2; exit 1; }
      shift 2
      ;;
    --source)
      source_val="${2:-}"
      [[ -n "$source_val" ]] || { echo "Missing value for --source" >&2; exit 1; }
      shift 2
      ;;
    --skill)
      skill_name="${2:-}"
      [[ -n "$skill_name" ]] || { echo "Missing value for --skill" >&2; exit 1; }
      # Resolve name to path: freely-fix-execution → docs/system/workspace/skills/freely-fix-execution/SKILL.md
      case "$skill_name" in
        freely-fix-execution|freely-feat-execution) skill_path="docs/system/workspace/skills/${skill_name}/SKILL.md" ;;
        *) echo "Invalid --skill '$skill_name'. Must be 'freely-fix-execution' or 'freely-feat-execution'." >&2; exit 1 ;;
      esac
      shift 2
      ;;
    --slug)
      slug="${2:-}"
      [[ -n "$slug" ]] || { echo "Missing value for --slug" >&2; exit 1; }
      shift 2
      ;;
    --base)
      base="${2:-}"
      [[ -n "$base" ]] || { echo "Missing value for --base" >&2; exit 1; }
      shift 2
      ;;
    --*)
      echo "Unknown argument: $1" >&2
      usage
      exit 1
      ;;
    *)
      legacy_branch="$1"
      shift
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --base)
            base="${2:-}"; shift 2 ;;
          *) echo "Unknown argument: $1" >&2; usage; exit 1 ;;
        esac
      done
      break
      ;;
  esac
done

# ── Validate new interface ───────────────────────────────

using_new=0
if [[ -n "$raw_key" || -n "$source_val" || -n "$skill_path" || -n "$slug" ]]; then
  if [[ -z "$raw_key" ]]; then
    echo "Missing required: --raw-key" >&2; usage; exit 1
  fi
  if [[ -z "$source_val" ]]; then
    cat <<MSG >&2
Missing required: --source

  --source tells wt-create where the raw issue comes from:
    chat-inbox  — freely.db chats 表 (chat_type=new-issue, consumed=0)
    platform    — GitHub/Gitee OPEN issue

  AI: search for this raw-key in the scan file to find its source_family:
    .freely/run/manager-task-source-scan-latest.json

  If the scan file doesn't have this key, wt-create will auto-run scan once.

Usage: ./bin/wt-create --raw-key <key> --source <source> --skill <path> --slug <slug>
MSG
    exit 1
  fi
  if [[ -z "$skill_path" ]]; then
    echo "Missing required: --skill" >&2
    echo "  Valid values:" >&2
    echo "    freely-fix-execution   (bug fixes)" >&2
    echo "    freely-feat-execution  (new features)" >&2
    echo "Usage: ./bin/wt-create --raw-key <key> --source <source> --skill <path> --slug <slug>" >&2
    exit 1
  fi
  if [[ -z "$slug" ]]; then
    echo "Missing required: --slug" >&2; usage; exit 1
  fi
  using_new=1
fi

# ── Validate source value ───────────────────────────────

if [[ "$using_new" -eq 1 ]]; then
  case "$source_val" in
    chat-inbox|platform|local) ;;
    *)
      echo "Invalid --source '$source_val'. Must be 'chat-inbox', 'platform', or 'local'." >&2
      echo "  chat-inbox — raw issue comes from freely.db chats table" >&2
      echo "  platform   — raw issue comes from GitHub/Gitee OPEN issue" >&2
      echo "  local      — raw issue exists in docs/issues/raw-<key>/" >&2
      exit 1
      ;;
  esac
fi

# ── Derive prefix from --skill path ──────────────────────

if [[ "$using_new" -eq 1 ]]; then
  case "$skill_path" in
    *freely-fix-execution/SKILL.md)   prefix="fix" ;;
    *freely-feat-execution/SKILL.md)  prefix="feature" ;;
    *)
      echo "Unrecognized --skill path: $skill_path" >&2
      echo "  Must be one of:" >&2
      echo "    docs/system/workspace/skills/freely-fix-execution/SKILL.md" >&2
      echo "    docs/system/workspace/skills/freely-feat-execution/SKILL.md" >&2
      exit 1
      ;;
  esac
fi

# ── Validate raw-key format ──────────────────────────────

if [[ "$using_new" -eq 1 ]]; then
  if echo "$raw_key" | grep -qE '^[0-9]{8}T[0-9]{4,6}Z$'; then
    : # valid
  elif echo "$raw_key" | grep -qE '^[0-9]{8}-[0-9]{4,6}$'; then
    echo "警告: raw-key '$raw_key' uses legacy format. Prefer YYYYMMDDTHHMM[SS]Z." >&2
  else
    echo "Invalid raw-key format '$raw_key'. Expected YYYYMMDDTHHMM[SS]Z (e.g., 20260513T010343Z)." >&2
    exit 1
  fi
fi

# ── Resolve branches ─────────────────────────────────────

if [[ "$using_new" -eq 1 ]]; then
  test_pre_merge_branch="test-pre-merge-${raw_key}-${slug}"
  fix_branch="${prefix}/raw-${raw_key}-${slug}"
else
  test_pre_merge_branch=""
  fix_branch="$legacy_branch"
fi

[[ -n "$fix_branch" ]] || { usage; exit 1; }

# ── Root dir + common ────────────────────────────────────

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

source "$ROOT_DIR/bin/worktree-common.sh"
freely_wt_assert_strict_root

# ── Validate base exists ─────────────────────────────────

if ! git show-ref --verify --quiet "refs/heads/$base" && ! git rev-parse --verify --quiet "$base" >/dev/null; then
  echo "Base branch/ref not found: $base" >&2
  exit 1
fi

# ── Validate branches don't already exist ────────────────

for b in $test_pre_merge_branch $fix_branch; do
  [[ -z "$b" ]] && continue
  if git show-ref --verify --quiet "refs/heads/$b"; then
    echo "Branch already exists: $b" >&2
    exit 1
  fi
done

# ── Issue pre-check helpers ──────────────────────────────

_extract_issue_key() {
  local branch="$1"
  if echo "$branch" | grep -qoE 'raw-[0-9]{8}[-T][0-9]{4,6}Z?'; then
    echo "$branch" | grep -oE 'raw-[0-9]{8}[-T][0-9]{4,6}Z?' | head -1
    return 0
  fi
  if echo "$branch" | grep -qoE 'I-[0-9]{8}[-T][0-9]{4,6}Z?(-[A-Z0-9]+)?'; then
    echo "$branch" | grep -oE 'I-[0-9]{8}[-T][0-9]{4}Z?(-[A-Z0-9]+)?' | head -1
    return 0
  fi
  return 1
}

# ── Scan matching: verify raw-key exists in scan with correct source ──

_scan_json_path() {
  printf '%s\n' "$ROOT_DIR/.freely/run/manager-task-source-scan-latest.json"
}

_scan_lookup() {
  local raw_key="$1"
  local scan_file; scan_file="$(_scan_json_path)"
  [[ -f "$scan_file" ]] || return 1
  python3 -c "
import json, sys
with open('$scan_file') as f:
    data = json.load(f)
items = data if isinstance(data, list) else data.get('items', [])
for item in items:
    # Try exact key match first
    if item.get('key') == '$raw_key':
        print(item.get('source_family', ''))
        sys.exit(0)
    # Try issue_id match: raw-{key} == issue_id
    issue_id = item.get('issue_id', '') or ''
    if issue_id == 'raw-$raw_key':
        print(item.get('source_family', ''))
        sys.exit(0)
sys.exit(1)
" 2>/dev/null
}

_run_scan_once() {
  local scan_py="$ROOT_DIR/docs/system/workspace/scripts/runtime/task-lifecycle-scan.py"
  [[ -f "$scan_py" ]] || return 1
  echo "Scan file missing raw-key $raw_key, running scan once..." >&2
  mkdir -p "$(dirname "$(_scan_json_path)")"
  python3 "$scan_py" --project "$ROOT_DIR" --json > "$(_scan_json_path)" 2>/dev/null || true
}

# ── Pull helpers (unified) ────────────────────────────────

_pull_raw_issue() {
  local raw_key="$1" source="$2"
  case "$source" in
    chat-inbox)
      local ts db_path chat_inbox_py
      ts="${raw_key}"
      db_path="$ROOT_DIR/.freely/freely.db"
      chat_inbox_py="$ROOT_DIR/docs/system/workspace/scripts/runtime/chat-inbox.py"
      [[ -f "$db_path" ]] || { echo "chat-inbox DB not found: $db_path" >&2; return 1; }

      # Check if chat with this id exists and is unconsumed (normalize ISO->bare for DB)
      local consumed ts_bare
      ts_bare=$(echo "$ts" | tr -d 'TZ')
      consumed=$(python3 -c "
import sqlite3
conn=sqlite3.connect('$db_path')
r=conn.execute('SELECT consumed FROM chats WHERE id=? AND chat_type=\"new-issue\"', ('$ts_bare',)).fetchone()
print(r[0] if r else '')
conn.close()
" 2>/dev/null || echo "")
      if [[ "$consumed" != "0" ]]; then
        echo "chat-inbox: no unconsumed new-issue chat found for id=$ts" >&2
        return 1
      fi

      local issue_dir="$PWD/docs/issues/raw-${raw_key}"
      mkdir -p "$issue_dir"
      if ! python3 "$chat_inbox_py" materialize --db "$db_path" --id "$ts" --target "$issue_dir" >/dev/null 2>&1; then
        echo "chat-inbox: materialize failed for id=$ts" >&2
        return 1
      fi
      python3 "$chat_inbox_py" consume --db "$db_path" --id "$ts" --materialized-as "raw-${raw_key}" >/dev/null 2>&1
      echo "pull: materialized raw-$raw_key from chat-inbox → $issue_dir/issue.md" >&2
      return 0
      ;;
    platform)
      if [[ -x "$ROOT_DIR/bin/raw-issue-pull" ]]; then
        local result
        result=$("$ROOT_DIR/bin/raw-issue-pull" --raw-key "$raw_key" 2>/dev/null || true)
        if echo "$result" | grep -q '"local_id"'; then
          echo "pull: materialized raw-$raw_key from platform" >&2
          return 0
        fi
      fi
      return 1
      ;;
    local)
      # Issue already exists in docs/issues/, verify frontmatter
      local _issue_file="$PWD/docs/issues/raw-${raw_key}/issue.md"
      if [[ -f "$_issue_file" ]]; then
        local _kind; _kind=$(python3 -c "
import yaml
with open('$_issue_file') as f: c = f.read()
parts = c.split('---', 2)
fm = yaml.safe_load(parts[1]) if len(parts) >= 3 else {}
print(fm.get('kind', ''))
" 2>/dev/null || true)
        if [[ "$_kind" != "raw" ]]; then
          echo "拒绝: raw-$raw_key 的 kind 字段为 '${_kind:-missing}'，必须为 'raw'。" >&2
          echo "  请通过 freely feedback 创建 raw issue，不要手工创建 issue.md。" >&2
          return 1
        fi
        echo "pull: raw-$raw_key already exists locally" >&2
        return 0
      fi
      echo "pull: raw-$raw_key not found in docs/issues/" >&2
      return 1
      ;;
  esac
}

# ── After pull: ensure platform_ids on all configured platforms ──

_fill_platform_ids() {
  local raw_key="$1"
  local issue_file="$PWD/docs/issues/raw-${raw_key}/issue.md"
  [[ -f "$issue_file" ]] || return 0

  # Check if any configured platform is missing
  local needs_sync=0
  if [[ -n "${GH_REPO:-}" ]] || gh repo view --json nameWithOwner -q '.nameWithOwner' >/dev/null 2>&1; then
    local gh_id
    gh_id=$(python3 -c "
import yaml
with open('$issue_file') as f: c=f.read()
parts=c.split('---',2)
fm=yaml.safe_load(parts[1]) if len(parts)>=3 else {}
ids=fm.get('platform_ids',{}) or {}
gh=ids.get('github',{}) or {}
print(gh.get('issue_id',''))
" 2>/dev/null || true)
    if [[ -z "$gh_id" || "$gh_id" == "None" ]]; then
      needs_sync=1
    fi
  fi
  if [[ -n "${GITEE_TOKEN:-}" ]]; then
    local gt_id
    gt_id=$(python3 -c "
import yaml
with open('$issue_file') as f: c=f.read()
parts=c.split('---',2)
fm=yaml.safe_load(parts[1]) if len(parts)>=3 else {}
ids=fm.get('platform_ids',{}) or {}
gt=ids.get('gitee',{}) or {}
print(gt.get('issue_id',''))
" 2>/dev/null || true)
    if [[ -z "$gt_id" || "$gt_id" == "None" ]]; then
      needs_sync=1
    fi
  fi

  if [[ "$needs_sync" -eq 1 ]] && [[ -x "$ROOT_DIR/bin/issue-sync" ]]; then
    echo "补齐 platform_ids: issue-sync create raw-$raw_key" >&2
    "$ROOT_DIR/bin/issue-sync" create "raw-$raw_key" >/dev/null 2>&1 || true
    echo "platform_ids 已补齐" >&2
  fi
}

_require_issue_exists() {
  local branch="$1"
  local key ts db_path chat_inbox_py
  key="$(_extract_issue_key "$branch")"
  [[ -n "$key" ]] || return 0

  db_path="$ROOT_DIR/.freely/freely.db"
  chat_inbox_py="$ROOT_DIR/docs/system/workspace/scripts/runtime/chat-inbox.py"

  case "$key" in
    raw-*)
      ts="${key#raw-}"

      # ── Scan matching (new: validate --source against scan, fallback to dir/DB) ──
      local scan_found=0
      if [[ "$using_new" -eq 1 ]]; then
        local scan_source; scan_source="$(_scan_lookup "$raw_key" || true)"
        if [[ -z "$scan_source" ]]; then
          _run_scan_once
          scan_source="$(_scan_lookup "$raw_key" || true)"
        fi
        if [[ -n "$scan_source" ]]; then
          scan_found=1
          if [[ "$scan_source" != "$source_val" ]]; then
            echo "警告: raw-$raw_key scan source_family='$scan_source' 与 --source '$source_val' 不一致，按 --source 参数继续" >&2
            scan_found=0
          fi
        fi
      fi

      # ── Source-aware existence check ──
      if [[ "$scan_found" -ne 1 ]]; then
        case "$source_val" in
          platform)
            # Check if raw issue exists on configured platforms (GitHub/Gitee)
            local platform_result
            platform_result=$(python3 "$ROOT_DIR/docs/system/workspace/scripts/sync/platform-adapter.py" search "$raw_key" 2>/dev/null || echo "{}")
            if [[ "$platform_result" != "{}" && "$platform_result" != "" ]]; then
              : # found on platform, proceed
            elif [[ -d "$ROOT_DIR/docs/issues/$key" ]]; then
              : # exists locally (local_only — will be pushed to platform by worker)
            else
              echo "拒绝创建工位: raw-$raw_key not found on platform or local" >&2
              echo "  先在平台创建 raw issue:" >&2
              echo "    freely feedback --repo <user/repo> --title '...' --body '...'" >&2
              echo "  或: gh issue create --repo <user/repo> --title '[RAW-$raw_key] ...' --body '...'" >&2
              echo "  创建后重试: wt-create --raw-key $raw_key --source platform --skill <skill> --slug <slug>" >&2
              return 1
            fi
            ;;
          chat-inbox)
            if [[ -f "$db_path" ]] && python3 "$chat_inbox_py" show --db "$db_path" --id "$ts" >/dev/null 2>&1; then
              : # chat exists in inbox, proceed
            else
              echo "拒绝创建工位: raw-$raw_key not found in chat-inbox" >&2
              if [[ -d "$ROOT_DIR/docs/issues/raw-$raw_key" ]]; then
                echo "  但发现 issue 文件存在于 docs/issues/raw-$raw_key/" >&2
                echo "  请使用 --source platform（本地 issue 文件作为 platform 创建工位）:" >&2
                echo "    wt-create --raw-key $raw_key --source platform --skill <skill> --slug <slug>" >&2
              else
                echo "  先通过 freely chat 提交消息创建 chat-inbox raw issue" >&2
                echo "  创建后重试: wt-create --raw-key $raw_key --source chat-inbox --skill <skill> --slug <slug>" >&2
              fi
              return 1
            fi
            ;;
          local)
            if [[ -d "$ROOT_DIR/docs/issues/$key" ]]; then
              : # exists locally
            else
              echo "拒绝创建工位: raw-$raw_key not found in docs/issues/" >&2
              echo "  先在 docs/issues/raw-$raw_key/ 创建 issue.md" >&2
              echo "  或: freely feedback --repo <user/repo> --title '...' --body '...'" >&2
              echo "  创建后重试: wt-create --raw-key $raw_key --source local --skill <skill> --slug <slug>" >&2
              return 1
            fi
            ;;
          *)
            # Legacy / unspecified source: check local dir
            if [[ -d "$ROOT_DIR/docs/issues/$key" ]]; then
              : # exists locally
            else
              echo "拒绝创建工位: raw-$raw_key not found" >&2
              echo "  --source 必须为 'platform' 或 'chat-inbox'，且 raw issue 必须存在" >&2
              return 1
            fi
            ;;
        esac
      fi

      # Source 1: chat-inbox (already handled by pull in new mode)
      if [[ -f "$db_path" ]] && python3 "$chat_inbox_py" show --db "$db_path" --id "$ts" >/dev/null 2>&1; then
        local consumed ts_bare
        ts_bare=$(echo "$ts" | tr -d 'TZ')
        consumed=$(python3 -c "
import sqlite3
conn=sqlite3.connect('$db_path')
r=conn.execute('SELECT consumed FROM chats WHERE id=?', ('$ts_bare',)).fetchone()
print(r[0] if r else '')
conn.close()
" 2>/dev/null || echo "")
        if [[ "$consumed" == "0" ]]; then
          return 0
        fi
        if [[ "$consumed" == "1" ]]; then
          if [[ -d "$ROOT_DIR/docs/issues/$key" ]]; then
            return 0
          fi
          echo "警告: chat $key consumed but issue missing, resetting to pending" >&2
          python3 "$chat_inbox_py" reset --db "$db_path" --id "$ts" >/dev/null 2>&1 || true
          return 0
        fi
      fi
      if [[ -d "$ROOT_DIR/docs/issues/$key" ]]; then
        return 0
      fi
      # Platform pull is deferred to after worktree creation
      if [[ "$using_new" -eq 1 && "$source_val" == "platform" ]]; then
        return 0
      fi
      ;;
    I-*)
      if [[ -d "$ROOT_DIR/docs/issues/$key" ]]; then
        return 0
      fi
      ;;
  esac

  echo "拒绝创建工位: issue $key not found" >&2
  if [[ -n "$source_val" ]]; then
    echo "  source: $source_val — raw issue 在该来源中不存在" >&2
  fi
  echo "  检查 raw-key 是否正确，或先用 freely feedback / freely chat 创建 raw issue" >&2
  return 1
}

_materialize_chat_if_needed() {
  local branch="$1" target_path="$2"
  local key ts db_path chat_inbox_py
  key="$(_extract_issue_key "$branch")"
  [[ "$key" == raw-* ]] || return 0
  ts="${key#raw-}"

  db_path="$ROOT_DIR/.freely/freely.db"
  chat_inbox_py="$ROOT_DIR/docs/system/workspace/scripts/runtime/chat-inbox.py"
  [[ -f "$db_path" ]] || return 0

  local consumed ts_bare
  ts_bare=$(echo "$ts" | tr -d 'TZ')
  consumed=$(python3 -c "
import sqlite3
conn=sqlite3.connect('$db_path')
r=conn.execute('SELECT consumed FROM chats WHERE id=? AND chat_type=\"new-issue\"', ('$ts_bare',)).fetchone()
print(r[0] if r else '')
conn.close()
" 2>/dev/null || echo "")

  if [[ "$consumed" != "0" ]]; then
    return 0
  fi

  local issue_dir="$target_path/docs/issues/$key"
  mkdir -p "$issue_dir"

  if ! python3 "$chat_inbox_py" materialize --db "$db_path" --id "$ts" --target "$issue_dir" >/dev/null 2>&1; then
    echo "materialize failed, rolling back worktree" >&2
    git -C "$ROOT_DIR" worktree remove "$target_path" --force 2>/dev/null || true
    git -C "$ROOT_DIR" branch -D "$branch" 2>/dev/null || true
    return 1
  fi

  # Do NOT consume here — _pull_raw_issue is the single consumption point
  echo "materialized: chat-inbox → $issue_dir/issue.md"

  python3 "$chat_inbox_py" query-by-issue --db "$db_path" --issue-id "$key" --consumed 0 2>/dev/null \
    | while read -r line; do
        local comment_id
        comment_id=$(echo "$line" | cut -f1)
        [[ -n "$comment_id" ]] || continue
        python3 "$chat_inbox_py" materialize-comment --db "$db_path" --id "$comment_id" \
          --issue-file "$issue_dir/issue.md" >/dev/null 2>&1 \
          && python3 "$chat_inbox_py" consume --db "$db_path" --id "$comment_id" >/dev/null 2>&1
      done
}

# _mark_raw_issue_absorbed: after successful worktree creation, mark the
# raw issue as absorbed so scan stops showing it and comment routing works.
_mark_raw_issue_absorbed() {
  local raw_key="$1"
  local target_path="${2:-$ROOT_DIR}"
  local issue_file="$target_path/docs/issues/raw-${raw_key}/issue.md"
  [[ -f "$issue_file" ]] || { echo "warning: issue file not found: $issue_file" >&2; return 0; }
  python3 -c "
import yaml
with open('$issue_file') as f: c = f.read()
p = c.split('---', 2)
if len(p) < 3: exit(1)
fm = yaml.safe_load(p[1]) or {}
fm['phase_state'] = 'absorbed'
new_fm = yaml.dump(fm, default_flow_style=False, allow_unicode=True, sort_keys=False).strip()
with open('$issue_file', 'w') as f: f.write('---\n' + new_fm + '\n---' + p[2])
" 2>/dev/null && echo "phase_state: absorbed → raw-${raw_key}" || echo "warning: failed to update phase_state for raw-${raw_key}" >&2
}

# ── Create worktree helper ───────────────────────────────

_create_worktree() {
  local branch="$1" target_path="$2" base_branch="$3"

  mkdir -p "$(freely_wt_root_dir)"

  git worktree add -b "$branch" "$target_path" "$base_branch"

  _materialize_chat_if_needed "$branch" "$target_path" || return 1

  if [[ -x "$ROOT_DIR/bin/freely" ]]; then
    FREELY_WT_AUTOCREATE_INTERNAL=1 bash "$ROOT_DIR/bin/freely" sync-tooling \
      --source-project "$ROOT_DIR" --project "$target_path" >/dev/null 2>&1 || true
  fi
}

# ── Pre-check: issue must exist ──────────────────────────

_require_issue_exists "$fix_branch" || exit 1

# ── Sync local develop with remote ───────────────────────
echo "=== Syncing local develop ==="
_github_head=""
_origin_head=""
git fetch github develop 2>/dev/null && _github_head="$(git rev-parse refs/remotes/github/develop 2>/dev/null || true)" || true
git fetch origin develop 2>/dev/null && _origin_head="$(git rev-parse refs/remotes/origin/develop 2>/dev/null || true)" || true
if [[ -n "$_github_head" ]] && [[ -n "$_origin_head" ]] && [[ "$_github_head" != "$_origin_head" ]]; then
  echo "ERROR: Platform divergence detected" >&2
  echo "  github: $_github_head" >&2
  echo "  origin: $_origin_head" >&2
  echo "  Cannot create worktree. Run: ./bin/freely develop-push attempt" >&2
  exit 1
fi
_sync_head="${_github_head:-$_origin_head}"
if [[ -n "$_sync_head" ]]; then
  git update-ref refs/heads/develop "$_sync_head" 2>/dev/null 
    && echo "  develop updated to $(git rev-parse --short develop)" 
    || echo "  warning: sync failed, proceeding with local develop"
else
  echo "  warning: no remote develop found, proceeding with local develop"
fi

# ── Create worktree(s) ───────────────────────────────────

  if [[ "$using_new" -eq 1 ]]; then
  fix_target="$(freely_wt_resolve_target_path "$fix_branch")"
  echo "=== Step 1/2: Creating ${prefix} worktree ==="
  _create_worktree "$fix_branch" "$fix_target" "$base"
  echo "  ${prefix}: $fix_target (base: $base)"

  # Pull raw issue from inside the fix/feature worktree
  if [[ "$using_new" -eq 1 ]]; then
