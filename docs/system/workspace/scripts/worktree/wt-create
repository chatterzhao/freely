#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<USAGE
Usage:
  freely wt-create --raw-key <key> --source platform --kind <fix|feature|hotfix> --slug <slug> [--base <branch>] [--source-platform <github|gitee>]
  freely wt-create <branch> [--base <base-branch>]    (legacy: 传 test-pre-merge-* 分支名补建测试工位；纯文档、init develop、release 分支)

  可重跑恢复：标准模式若在 Step 2 之前中断（dev 工位已建、test 工位缺失），
  用完全相同的参数重跑本命令即可只补建 test 工位并完整初始化；
  两个工位都存在时重跑为 no-op（退出码 0），不会产生重复工位。

Required:
  --raw-key <key>     Raw issue key (YYYYMMDDTHHMM[SS]Z format, e.g. 20260513T010343Z)
  --source  platform    Raw issue must exist on a configured platform (created via 'freely feedback')
  --kind    <fix|feature|hotfix>    如何选择 → 见下方「--kind 选择指南」
  --slug    <slug>    Short descriptive slug for the worktree

Optional:
  --base <branch>     Base branch (default: develop)
  --skill  <name>     Override workflow skill (default: freely-workflow-guarded-execution)
  --source-platform <github|gitee>
                      Pin the raw issue read source. Default: first READABLE
                      configured platform; an unreadable platform is recorded
                      as sync debt and worktree creation continues.

── --kind 选择指南 ──────────────────────────────────────────

  --kind 决定两件事: ① 分支前缀（fix/ 或 feature/）
                    ② RED 阶段怎么做（fix RED = 复现，feature RED = 设计新测试）

  --kind fix     bug 可以稳定复现。
                 已有测试能捕获 → 直接跑，确认 FAIL。
                 没有测试 → 设计复现测试或手工端到端复现。
                 RED 含义: bug 存在时按测试方法测试一定是 RED，修复正确后，用修复前一样的测试方法，结论一定是 GREEN
                 分支: fix/raw-{raw key}-{slug}

  --kind feature 新功能、重构、优化、架构改进。
                 RED 阶段按端到端→集成→单元设计新测试，全部 FAIL 才进 dev。
                 RED 含义: 功能未实现时，按测试方法测试一定是 RED，实现正确后，用实现前一样的测试方法，结论一定是 GREEN
                 分支: feature/raw-{raw key}-{slug}
                 注意: 如果 bug 修复同时需要实现紧相关的新功能 →
                       拆为两个 raw issue，分别 wt-create。

  --kind hotfix  紧急修复，从 main 创建，合并到 main + develop。
                 其他流程与 fix 完全一致（测试不可跳过）。
                 分支: hotfix/<desc>-<YYYYMMDD>

  选了 --kind 之后，skill:freely-test-RED-execution 会根据
  fix/feature 自动采用对应的 RED 策略。

── 创建内容 ──────────────────────────────────────────────────

  1. {prefix}/raw-{raw key}-{slug}    ← based on --base (develop), the permanent dev worktree
  2. test-pre-merge-{raw key}-{slug}  ← based on ①, discardable testing sandbox

Before wt-create, create the raw issue on a configured platform first:
  freely feedback --help    (review usage, then create the raw issue)

Example:
  freely feedback --repo chatterzhao/freely --title "描述" --body "..."
  freely wt-create --raw-key <returned-key> --source platform \
    --kind fix --slug task-mode-wait-prelaunch-gate

Legacy:
  freely wt-create feature/my-task-20260307 --base develop
USAGE
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

# ── Argument parsing ─────────────────────────────────────

raw_key=""
source_val=""
source_platform=""
skill_name="freely-workflow-guarded-execution"
skill_path="docs/system/workspace/skills/freely-workflow-guarded-execution/SKILL.md"
branch_kind=""
slug=""
base="develop"
legacy_branch=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --raw-key)
      raw_key="${2:-}"
      [[ -n "$raw_key" ]] || { echo "Missing value for --raw-key" >&2; exit 1; }
      shift 2
      ;;
    --source)
      source_val="${2:-}"
      [[ -n "$source_val" ]] || { echo "Missing value for --source" >&2; exit 1; }
      shift 2
      ;;
    --kind)
      branch_kind="${2:-}"
      [[ -n "$branch_kind" ]] || { echo "Missing value for --kind" >&2; exit 1; }
      case "$branch_kind" in
        fix|feature|hotfix) ;;
        *) echo "Invalid --kind '$branch_kind'. Must be 'fix', 'feature', or 'hotfix'." >&2; exit 1 ;;
      esac
      shift 2
      ;;
    --skill)
      skill_name="${2:-}"
      skill_path="docs/system/workspace/skills/${skill_name}/SKILL.md"
      shift 2
      ;;
    --slug)
      slug="${2:-}"
      [[ -n "$slug" ]] || { echo "Missing value for --slug" >&2; exit 1; }
      shift 2
      ;;
    --base)
      base="${2:-}"
      [[ -n "$base" ]] || { echo "Missing value for --base" >&2; exit 1; }
      shift 2
      ;;
    --source-platform)
      source_platform="${2:-}"
      [[ -n "$source_platform" ]] || { echo "Missing value for --source-platform" >&2; exit 1; }
      case "$source_platform" in
        github|gitee) ;;
        *) echo "Invalid --source-platform '$source_platform' (expected github|gitee)" >&2; exit 1 ;;
      esac
      shift 2
      ;;
    --*)
      echo "Unknown argument: $1" >&2
      usage
      exit 1
      ;;
    *)
      legacy_branch="$1"
      shift
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --base)
            base="${2:-}"; shift 2 ;;
          *) echo "Unknown argument: $1" >&2; usage; exit 1 ;;
        esac
      done
      break
      ;;
  esac
done

# ── Validate new interface ───────────────────────────────

# skill_path and base both carry non-empty defaults. Including skill_path in
# the interface test made using_new unconditionally 1, so the entire legacy
# branch below was unreachable and `wt-create <branch>` always died with
# "Missing required: --raw-key" — despite usage promising test worktree 补建.
# Detect the interface from flags the caller actually supplied instead.
_new_flags_present=0
if [[ -n "$raw_key" || -n "$source_val" || -n "$branch_kind" || -n "$slug" ]]; then
  _new_flags_present=1
fi
if [[ -n "$legacy_branch" && "$_new_flags_present" -eq 1 ]]; then
  echo "拒绝创建工位: legacy 分支名不能与 --raw-key/--source/--kind/--slug 混用" >&2
  usage
  exit 1
fi
if [[ -z "$legacy_branch" && "$_new_flags_present" -eq 0 ]]; then
  usage
  exit 1
fi

using_new=0
if [[ "$_new_flags_present" -eq 1 ]]; then
  if [[ -z "$raw_key" ]]; then
    echo "Missing required: --raw-key" >&2; usage; exit 1
  fi
  if [[ -z "$source_val" ]]; then
    cat <<MSG >&2
Missing required: --source

  --source must be 'platform'. Raw issues must exist on a configured platform.
  Create one first: freely feedback --help

  AI: search for this raw-key in the scan file to find its source_family:
    .freely/run/manager-task-source-scan-latest.json

  If the scan file doesn't have this key, wt-create will auto-run scan once.

Usage: freely wt-create --raw-key <key> --source platform --kind <fix|feature|hotfix> --slug <slug>
MSG
    exit 1
  fi
  if [[ -z "$branch_kind" ]]; then
    # Fallback: try to read kind from raw issue (set by 'freely feedback --kind')
    local _raw_issue_file="docs/B1-docs/raw-${raw_key}/issue.md"
    if [[ -f "$_raw_issue_file" ]]; then
      branch_kind=$(grep -m1 '^- kind:' "$_raw_issue_file" 2>/dev/null | sed 's/^- kind: *//' || true)
    fi
    if [[ -z "$branch_kind" ]]; then
      cat >&2 <<KIND_ERR
Missing required: --kind

  --kind 未在 wt-create 命令行指定，且 raw issue 中也未找到。

  请在 feedback 阶段就选好 kind:
    freely feedback --title "..." --body "..." --kind fix
    freely feedback --title "..." --body "..." --kind feature

  或直接在 wt-create 显式指定:
    wt-create ... --kind fix
    wt-create ... --kind feature

  --kind 怎么选（仔细分析，选错会影响 RED 阶段行为）:

    fix     bug 可以稳定复现。已有测试能捕获，或可以手工端到端复现。
            RED 阶段 = 复现——bug 存在时按测试方法测试一定是 RED，修复正确后，用修复前一样的测试方法，结论一定是 GREEN
            分支: fix/raw-{key}-{slug}

    feature 新功能、重构、优化、架构改进。
            RED 阶段 = 功能未实现时，按测试方法测试一定是 RED，实现正确后，用实现前一样的测试方法，结论一定是 GREEN
            分支: feature/raw-{key}-{slug}

    hotfix  紧急修复，从 main 创建，合并到 main + develop
            （其他流程与 fix 完全一致，测试不可跳过）

    如果 bug 修复同时需要实现紧相关的新功能 →
    拆为两个 raw issue，分别 feedback + wt-create。

KIND_ERR
      exit 1
    fi
    echo "wt-create: using kind='${branch_kind}' from raw issue"
  fi
  if [[ -z "$slug" ]]; then
    echo "Missing required: --slug" >&2; usage; exit 1
  fi
  using_new=1
fi

# ── Validate source value ───────────────────────────────

if [[ "$using_new" -eq 1 ]]; then
  case "$source_val" in
    platform) ;;
    chat-inbox|local)
      echo "Invalid --source '$source_val'. Only 'platform' is allowed." >&2
      echo "  Raw issues must be created on a configured platform via 'freely feedback' first." >&2
      echo "  Then use: wt-create --raw-key <key> --source platform --kind <fix|feature|hotfix> --slug <slug>" >&2
      exit 1
      ;;
    *)
      echo "Invalid --source '$source_val'. Must be 'platform'." >&2
      echo "  platform — raw issue exists on a configured platform (created via 'freely feedback')" >&2
      exit 1
      ;;
  esac
fi

# ── Derive prefix from --kind ──────────────────────

if [[ "$using_new" -eq 1 ]]; then
  case "$branch_kind" in
    fix)     prefix="fix" ;;
    feature) prefix="feature" ;;
    hotfix)  prefix="hotfix" ;;
    *)
      echo "Unrecognized --kind: $branch_kind" >&2
      echo "  Must be one of: fix, feature, hotfix" >&2
      exit 1
      ;;
  esac
fi

# ── Validate raw-key format ──────────────────────────────

if [[ "$using_new" -eq 1 ]]; then
  # #4154: normalize through the single owner instead of maintaining a second
  # format table. The old branch accepted legacy YYYYMMDD-HHMM with a warning
  # but kept it verbatim, so branch names became raw-20261103-1326 and every
  # downstream T...Z extractor produced an empty raw_key.
  _wt_canon_py="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)/docs/system/workspace/scripts/runtime/raw_key_canon.py"
  [[ -f "$_wt_canon_py" ]] || { echo "raw_key_canon.py not found: $_wt_canon_py" >&2; exit 1; }
  _canonical_raw_key="$(python3 "$_wt_canon_py" "$raw_key" 2>/dev/null || true)"
  if [[ ! "$_canonical_raw_key" =~ ^raw-[0-9]{8}T[0-9]{6}Z$ ]]; then
    echo "Invalid raw-key format '$raw_key'. Expected YYYYMMDDTHHMM[SS]Z or legacy YYYYMMDD-HHMM[SS]." >&2
    exit 1
  fi
  _normalized_raw_key="${_canonical_raw_key#raw-}"
  if [[ "$_normalized_raw_key" != "$raw_key" ]]; then
    echo "raw-key normalized: '$raw_key' → '$_normalized_raw_key'" >&2
  fi
  raw_key="$_normalized_raw_key"
fi

# ── Resolve branches ─────────────────────────────────────

if [[ "$using_new" -eq 1 ]]; then
  test_pre_merge_branch="test-pre-merge-${raw_key}-${slug}"
  dev_branch="${prefix}/raw-${raw_key}-${slug}"
else
  test_pre_merge_branch=""
  dev_branch="$legacy_branch"
fi

[[ -n "$dev_branch" ]] || { usage; exit 1; }

# ── Root dir + common ────────────────────────────────────

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

source "$ROOT_DIR/bin/worktree-common.sh"
freely_wt_assert_strict_root

# ── Pre-flight state detection (before any side effect) ─────
# Standard mode is idempotent. Detect interruption residue here so the
# replica gate below can be skipped for recovery: the dev worktree already
# exists, so re-verifying configured platforms only adds latency and a new
# failure mode to the very command that is supposed to recover.
# ── Worktree state helpers ────────────────────────────────────
# A branch existing is NOT the same as a usable worktree: the directory may
# have been removed (manual delete, disk cleanup, `git worktree prune`), and
# an added test worktree may not have finished initialisation yet.
_wt_registered_dir() {
  local branch="$1" dir
  dir="$(git worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$branch" '
    $1=="worktree" { w=$2 }
    $1=="branch" && $2==b { print w; exit }
  ')"
  [[ -n "$dir" && -d "$dir" ]] || return 1
  printf '%s\n' "$dir"
}

# test-gate.env is written by _init_test_worktree_state() at the END of a
# successful initialisation, so it doubles as the completion marker. Accept
# any TEST_STATUS value: after a GREEN run the value is "completed", and a
# re-run must still be recognised as fully initialised.
_wt_test_initialized() {
  local dir="$1" marker
  [[ -n "$dir" && -d "$dir" ]] || return 1
  marker="$dir/.freely/run/test-gate.env"
  [[ -f "$marker" ]] || return 1
  grep -q '^TEST_STATUS=' "$marker"
}

resume_mode=0
_dev_dir=""; _test_dir=""; _test_ready=0
if [[ "$using_new" -eq 1 ]]; then
  _dev_exists=0; _test_exists=0
  git show-ref --verify --quiet "refs/heads/$dev_branch" && _dev_exists=1 || true
  git show-ref --verify --quiet "refs/heads/$test_pre_merge_branch" && _test_exists=1 || true
  _dev_dir="$(_wt_registered_dir "$dev_branch")" || _dev_dir=""
  _test_dir="$(_wt_registered_dir "$test_pre_merge_branch")" || _test_dir=""
  if _wt_test_initialized "$_test_dir"; then _test_ready=1; fi

  # Complete state: both branches, both REGISTERED DIRECTORIES, and the test
  # initialisation marker. Anything less is interruption residue to repair.
  if [[ "$_dev_exists" -eq 1 && "$_test_exists" -eq 1 && -n "$_dev_dir" && -n "$_test_dir" && "$_test_ready" -eq 1 ]]; then
    echo "wt-create: 工位已存在，无需创建 (idempotent no-op)" >&2
    echo "  dev:  $_dev_dir" >&2
    echo "  test: $_test_dir" >&2
    exit 0
  fi
  if [[ "$_dev_exists" -eq 0 && "$_test_exists" -eq 1 ]]; then
    echo "拒绝创建工位: test 工位分支已存在但 dev 分支缺失，状态不一致" >&2
    echo "  请先清理残留的 test-pre-merge 分支/工位，再重建。" >&2
    exit 1
  fi
  if [[ "$_dev_exists" -eq 1 ]]; then
    resume_mode=1
    echo "wt-create: 检测到中断残留 —— dev 分支存在但工位不完整，进入恢复模式" >&2
    [[ -z "$_dev_dir" ]] && echo "  dev 工位目录缺失，需补建" >&2
    [[ -z "$_test_dir" ]] && echo "  test 工位目录缺失，需补建" >&2
    [[ "$_test_ready" -eq 0 && -n "$_test_dir" ]] && echo "  test 工位未完成初始化，需重跑初始化" >&2
  fi
fi

# 恢复模式无需重复校验平台 raw replicas（工位与 raw issue 已在本地）。
if [[ "$using_new" -eq 1 && "$resume_mode" -eq 0 ]]; then
  echo "wt-create: verifying configured raw replicas..." >&2
  _replica_receipt="$(mktemp -t freely-replica-receipt.XXXXXX)"
  if ! FREELY_PROJECT_ROOT="$ROOT_DIR" python3 \
    "$ROOT_DIR/docs/system/workspace/scripts/lifecycle/raw-reconciliation-gate.py" \
    --project "$ROOT_DIR" --raw-key "$raw_key" --allow-degraded > "$_replica_receipt"; then
      cat "$_replica_receipt" >&2
      rm -f "$_replica_receipt"
      echo "拒绝创建工位: configured raw replicas are inconsistent or unavailable" >&2
      exit 1
  fi
  # An unreadable platform is debt, not a fact: record it so it can be settled.
  _debt_count=$(python3 "$ROOT_DIR/docs/system/workspace/scripts/lifecycle/sync-debt.py" \
    --root "$ROOT_DIR" record --receipt "$_replica_receipt" 2>/dev/null \
    | python3 -c 'import sys,json; print(json.load(sys.stdin).get("recorded", 0))' 2>/dev/null || echo 0)
  if [[ "${_debt_count:-0}" != "0" ]]; then
    echo "wt-create: 有平台读取失败，已记入待对账（sync-debt list 查看）；工位创建继续" >&2
  fi
  rm -f "$_replica_receipt"
fi

# ── Validate base exists ─────────────────────────────────

if ! git show-ref --verify --quiet "refs/heads/$base" && ! git rev-parse --verify --quiet "$base" >/dev/null; then
  echo "Base branch/ref not found: $base" >&2
  exit 1
fi

# ── Validate branches don't already exist ────────────────
# Standard mode resolved its four-state machine in the pre-flight block
# above; only legacy mode needs the classic "branch already exists" guard.
if [[ "$using_new" -eq 0 ]]; then
  if git show-ref --verify --quiet "refs/heads/$dev_branch"; then
    echo "Branch already exists: $dev_branch" >&2
    exit 1
  fi
fi

# ── Fuzzy-match: block if ANY branch/worktree exists for this raw_key ──
# 恢复模式跳过 fuzzy-match：dev 分支本身就是预期的中断残留，
# 若在这里阻断，重跑仍然会退回「Branch already exists」的死路。
if [[ "$using_new" -eq 1 && "$resume_mode" -eq 0 ]]; then
  _existing_branch=$(git branch | grep "raw-${raw_key}" | head -1 || true)
  _existing_wt=$(git worktree list 2>/dev/null | grep "raw-${raw_key}" | head -1 || true)
  if [[ -n "$_existing_branch" || -n "$_existing_wt" ]]; then
    cat >&2 <<FUZZY_BLOCK
拒绝创建工位: raw-${raw_key} 已有工位/分支

  已有分支: ${_existing_branch:-无}
  已有工位: ${_existing_wt:-无}

  同一 raw_key 不允许创建多个工位。请使用已有工位继续工作，
  或先 wt-close 清理后再重建。
FUZZY_BLOCK
    exit 1
  fi
fi

# ── Raw issue state check ────────────────────────────────
# If the raw issue was previously closed (absorbed/completed/dropped),
# automatically reopen it by setting phase_state → proposed.
# This avoids forcing the user to manually edit develop.
_issue_file="docs/B1-docs/raw-${raw_key}/issue.md"
if [[ -f "$_issue_file" ]]; then
  _phase=$(grep 'phase_state:' "$_issue_file" 2>/dev/null | head -1 | sed 's/.*: *//' | tr -d "'\"" || true)
  case "$_phase" in
    absorbed|completed|dropped)
      echo "[wt-create] raw-${raw_key} phase_state=${_phase} → proposed (auto-reopen)" >&2
      # Change phase_state in-place on the worktree branch (never on develop)
      if [[ "$(uname)" == "Darwin" ]]; then
        sed -i.bak "s/phase_state: ${_phase}/phase_state: proposed/" "$_issue_file"; rm -f "$_issue_file.bak"
      else
        sed -i "s/phase_state: ${_phase}/phase_state: proposed/" "$_issue_file"
      fi
      ;;
  esac
fi

# ── Issue pre-check helpers ──────────────────────────────

_extract_issue_key() {
  local branch="$1"
  if echo "$branch" | grep -qoE 'raw-[0-9]{8}[-T][0-9]{4,6}Z?'; then
    echo "$branch" | grep -oE 'raw-[0-9]{8}[-T][0-9]{4,6}Z?' | head -1
    return 0
  fi
  if echo "$branch" | grep -qoE 'I-[0-9]{8}[-T][0-9]{4,6}Z?(-[A-Z0-9]+)?'; then
    echo "$branch" | grep -oE 'I-[0-9]{8}[-T][0-9]{4}Z?(-[A-Z0-9]+)?' | head -1
    return 0
  fi
  return 1
}

# ── Scan matching: verify raw-key exists in scan with correct source ──

_scan_json_path() {
  printf '%s\n' "$ROOT_DIR/.freely/run/manager-task-source-scan-latest.json"
}

_scan_lookup() {
  local raw_key="$1"
  local scan_file; scan_file="$(_scan_json_path)"
  [[ -f "$scan_file" ]] || return 1
  python3 -c "
import json, sys
with open('$scan_file') as f:
    data = json.load(f)
items = data if isinstance(data, list) else data.get('items', [])
for item in items:
    # Try exact key match first
    if item.get('key') == '$raw_key':
        print(item.get('source_family', ''))
        sys.exit(0)
    # Try issue_id match: raw-{key} == issue_id
    issue_id = item.get('issue_id', '') or ''
    if issue_id == 'raw-$raw_key':
        print(item.get('source_family', ''))
        sys.exit(0)
sys.exit(1)
" 2>/dev/null
}

_run_scan_once() {
  local scan_py="$ROOT_DIR/docs/system/workspace/scripts/runtime/task-lifecycle-scan.py"
  [[ -f "$scan_py" ]] || return 1
  echo "Scan file missing raw-key $raw_key, running scan once..." >&2
  mkdir -p "$(dirname "$(_scan_json_path)")"
  python3 "$scan_py" --project "$ROOT_DIR" --json > "$(_scan_json_path)" 2>/dev/null || true
}

# ── Pull helpers (unified) ────────────────────────────────

_pull_raw_issue() {
  local raw_key="$1" source="$2" preferred_platform="${3:-}"
  local expected_local_id="raw-${raw_key}"
  local expected_issue_file="$PWD/docs/B1-docs/${expected_local_id}/issue.md"
  case "$source" in
    platform)
      if [[ -x "$ROOT_DIR/bin/raw-issue-pull" ]]; then
        local result parsed_id pull_err pull_rc=0
        local -a pull_args=(--raw-key "$raw_key")
        if [[ -n "$preferred_platform" ]]; then
          pull_args+=(--platform "$preferred_platform")
        fi
        pull_err="$(mktemp /tmp/freely-raw-pull.XXXXXX)"
        result=$("$ROOT_DIR/bin/raw-issue-pull" "${pull_args[@]}" 2>"$pull_err") || pull_rc=$?
        # Exit 3 = partial success: materialized from a readable fallback
        # platform while another platform was unreadable. That is sync debt,
        # not a blocking failure — worktree creation must continue.
        if [[ "$pull_rc" -ne 0 && "$pull_rc" -ne 3 ]]; then
          if [[ -s "$pull_err" ]]; then cat "$pull_err" >&2; fi
          rm -f "$pull_err"
          echo "pull: raw-issue-pull failed for $expected_local_id (exit $pull_rc)" >&2
          return 1
        fi
        # Surface warnings (e.g. partial-success debt, issue-sync normalization
        # failure) without mixing them into the JSON document parsed below.
        if [[ -s "$pull_err" ]]; then cat "$pull_err" >&2; fi
        rm -f "$pull_err"
        if [[ "$pull_rc" -eq 3 ]]; then
          echo "pull: 部分成功 —— 已从未读平台回退物化，未读平台记入 sync-debt，工位创建继续" >&2
        fi
        parsed_id=$(printf '%s' "$result" | python3 -c '
import json, sys
try:
    print(json.load(sys.stdin).get("local_id", ""))
except Exception:
    print("")
' 2>/dev/null || true)
        if [[ "$parsed_id" != "$expected_local_id" ]]; then
          echo "pull: identity mismatch — expected $expected_local_id, got '${parsed_id:-<none>}'" >&2
          return 1
        fi
        if [[ ! -f "$expected_issue_file" ]]; then
          echo "pull: expected issue file missing: $expected_issue_file" >&2
          return 1
        fi
        echo "pull: materialized $expected_local_id from platform" >&2
        return 0
      fi
      return 1
      ;;
  esac
}

# ── After pull: ensure platform_ids on all configured platforms ──

_fill_platform_ids() {
  local raw_key="$1"
  local issue_file="$PWD/docs/B1-docs/raw-${raw_key}/issue.md"
  [[ -f "$issue_file" ]] || return 0

  # Check if any configured platform is missing
  local needs_sync=0
  if [[ -n "${GH_REPO:-}" ]] || gh repo view --json nameWithOwner -q '.nameWithOwner' >/dev/null 2>&1; then
    local gh_id
    gh_id=$(python3 -c "
import yaml
with open('$issue_file') as f: c=f.read()
parts=c.split('---',2)
fm=yaml.safe_load(parts[1]) if len(parts)>=3 else {}
ids=fm.get('platform_ids',{}) or {}
gh=ids.get('github',{}) or {}
print(gh.get('issue_id',''))
" 2>/dev/null || true)
    if [[ -z "$gh_id" || "$gh_id" == "None" ]]; then
      needs_sync=1
    fi
  fi
  if [[ -n "${GITEE_TOKEN:-}" ]]; then
    local gt_id
    gt_id=$(python3 -c "
import yaml
with open('$issue_file') as f: c=f.read()
parts=c.split('---',2)
fm=yaml.safe_load(parts[1]) if len(parts)>=3 else {}
ids=fm.get('platform_ids',{}) or {}
gt=ids.get('gitee',{}) or {}
print(gt.get('issue_id',''))
" 2>/dev/null || true)
    if [[ -z "$gt_id" || "$gt_id" == "None" ]]; then
      needs_sync=1
    fi
  fi

  if [[ "$needs_sync" -eq 1 ]] && [[ -x "$ROOT_DIR/bin/issue-sync" ]]; then
    echo "补齐 platform_ids: issue-sync create raw-$raw_key" >&2
    "$ROOT_DIR/bin/issue-sync" create "raw-$raw_key" >/dev/null 2>&1 || true
    echo "platform_ids 已补齐" >&2
  fi
}

_require_issue_exists() {
  local branch="$1"
  local key ts db_path chat_inbox_py
  key="$(_extract_issue_key "$branch")"
  [[ -n "$key" ]] || return 0

  db_path="$ROOT_DIR/.freely/freely.db"
  chat_inbox_py="$ROOT_DIR/docs/system/workspace/scripts/runtime/chat-inbox.py"

  case "$key" in
    raw-*)
      ts="${key#raw-}"
      ts_bare=$(echo "$ts" | tr -d 'TZ')

      # ── Scan matching (new: validate --source against scan, fallback to dir/DB) ──
      local scan_found=0
      if [[ "$using_new" -eq 1 ]]; then
        local scan_source; scan_source="$(_scan_lookup "$raw_key" || true)"
        if [[ -z "$scan_source" ]]; then
          _run_scan_once
          scan_source="$(_scan_lookup "$raw_key" || true)"
        fi
        if [[ -n "$scan_source" ]]; then
          scan_found=1
          if [[ "$scan_source" != "$source_val" ]]; then
            echo "警告: raw-$raw_key scan source_family='$scan_source' 与 --source '$source_val' 不一致，按 --source 参数继续" >&2
            scan_found=0
          fi
        fi
      fi

      # ── Source-aware existence check ──
      if [[ "$scan_found" -ne 1 ]]; then
        case "$source_val" in
          platform)
            # Check if raw issue exists on configured platforms (GitHub/Gitee)
            local platform_result
            platform_result=$(python3 "$ROOT_DIR/docs/system/workspace/scripts/sync/platform-adapter.py" search "$raw_key" 2>/dev/null || echo "{}")
            if [[ "$platform_result" != "{}" && "$platform_result" != "" ]]; then
              : # found on platform, proceed
            elif [[ -d "$ROOT_DIR/docs/B1-docs/$key" ]]; then
              : # exists locally (local_only — will be pushed to platform by worker)
            else
              echo "拒绝创建工位: raw-$raw_key not found on platform or local" >&2
              echo "  如果出错是因为还没有创建 raw issue：" >&2
              echo "    请使用 freely feedback 命令创建 raw issue" >&2
              echo "    如果不清楚用法，请运行 freely feedback --help" >&2
              echo "  创建后重试: wt-create --raw-key $raw_key --source platform --kind <fix|feature|hotfix> --slug <slug>" >&2
              return 1
            fi
            ;;
          chat-inbox|local|*)
            # All sources other than platform: redirect to feedback → platform flow
            if [[ -d "$ROOT_DIR/docs/B1-docs/raw-$raw_key" ]] || [[ -d "$ROOT_DIR/docs/B1-docs/$key" ]]; then
              echo "  发现本地 issue 文件，请使用 --source platform:" >&2
              echo "    wt-create --raw-key $raw_key --source platform --kind <fix|feature|hotfix> --slug <slug>" >&2
            else
              echo "拒绝创建工位: raw-$raw_key 不存在" >&2
              echo "  如果出错是因为还没有创建 raw issue：" >&2
              echo "    请使用 freely feedback 命令创建 raw issue" >&2
              echo "    如果不清楚用法，请运行 freely feedback --help" >&2
              echo "  创建后重试: wt-create --raw-key $raw_key --source platform --kind <fix|feature|hotfix> --slug <slug>" >&2
            fi
            return 1
            ;;
        esac
      fi

      # Source 1: chat-inbox (already handled by pull in new mode)
      if [[ -f "$db_path" ]] && python3 "$chat_inbox_py" show --db "$db_path" --id "$ts_bare" >/dev/null 2>&1; then
        local consumed
        consumed=$(python3 -c "
import sqlite3
conn=sqlite3.connect("file:" + '$db_path' + "?mode=ro", uri=True)
r=conn.execute('SELECT consumed FROM chats WHERE id=?', ('$ts_bare',)).fetchone()
print(r[0] if r else '')
conn.close()
" 2>/dev/null || echo "")
        if [[ "$consumed" == "0" ]]; then
          return 0
        fi
        if [[ "$consumed" == "1" ]]; then
          if [[ -d "$ROOT_DIR/docs/B1-docs/$key" ]]; then
            return 0
          fi
          echo "警告: chat $key consumed but issue missing, resetting to pending" >&2
          python3 "$chat_inbox_py" reset --db "$db_path" --id "$ts" >/dev/null 2>&1 || true
          return 0
        fi
      fi
      if [[ -d "$ROOT_DIR/docs/B1-docs/$key" ]]; then
        return 0
      fi
      # Platform pull is deferred to after worktree creation
      if [[ "$using_new" -eq 1 && "$source_val" == "platform" ]]; then
        return 0
      fi
      ;;
    I-*)
      if [[ -d "$ROOT_DIR/docs/B1-docs/$key" ]]; then
        return 0
      fi
      ;;
  esac

  echo "拒绝创建工位: issue $key not found" >&2
  if [[ -n "$source_val" ]]; then
    echo "  source: $source_val — raw issue 在该来源中不存在" >&2
  fi
  echo "  检查 raw-key 是否正确，或先用 freely feedback / freely chat 创建 raw issue" >&2
  return 1
}

_materialize_chat_if_needed() {
  local branch="$1" target_path="$2"
  local key ts db_path chat_inbox_py
  key="$(_extract_issue_key "$branch")"
  [[ "$key" == raw-* ]] || return 0
  ts="${key#raw-}"

  db_path="$ROOT_DIR/.freely/freely.db"
  chat_inbox_py="$ROOT_DIR/docs/system/workspace/scripts/runtime/chat-inbox.py"
  [[ -f "$db_path" ]] || return 0

  local consumed ts_bare
  ts_bare=$(echo "$ts" | tr -d 'TZ')
  consumed=$(python3 -c "
import sqlite3
conn=sqlite3.connect("file:" + '$db_path' + "?mode=ro", uri=True)
r=conn.execute('SELECT consumed FROM chats WHERE id=? AND chat_type=\"new-issue\"', ('$ts_bare',)).fetchone()
print(r[0] if r else '')
conn.close()
" 2>/dev/null || echo "")

  if [[ "$consumed" != "0" ]]; then
    return 0
  fi

  local issue_dir="$target_path/docs/B1-docs/$key"
  mkdir -p "$issue_dir"

  if ! python3 "$chat_inbox_py" materialize --db "$db_path" --id "$ts_bare" --target "$issue_dir" >/dev/null 2>&1; then
    echo "materialize failed, rolling back worktree" >&2
    git -C "$ROOT_DIR" worktree remove "$target_path" --force 2>/dev/null || true
    git -C "$ROOT_DIR" branch -D "$branch" 2>/dev/null || true
    return 1
  fi

  # Do NOT consume here — _pull_raw_issue is the single consumption point
  echo "materialized: chat-inbox → $issue_dir/issue.md"

  python3 "$chat_inbox_py" query-by-issue --db "$db_path" --issue-id "$key" --consumed 0 2>/dev/null \
    | while read -r line; do
        local comment_id
        comment_id=$(echo "$line" | cut -f1)
        [[ -n "$comment_id" ]] || continue
        python3 "$chat_inbox_py" materialize-comment --db "$db_path" --id "$comment_id" \
          --issue-file "$issue_dir/issue.md" >/dev/null 2>&1 \
          && python3 "$chat_inbox_py" consume --db "$db_path" --id "$comment_id" >/dev/null 2>&1
      done
}

# _update_scan_state: update scan JSON to track item lifecycle.
# States: pending (default) → working (wt-create) → closed (wt-close).
_update_scan_state() {
  local _rk="$1" _new_state="$2" _wt_path="${3:-}" _ts
  local _scan_file="$ROOT_DIR/.freely/run/manager-task-source-scan-latest.json"
  _ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  [[ -f "$_scan_file" ]] || return 0
  python3 -c "
import json, os
try:
    with open('$_scan_file') as f: scan = json.load(f)
    for item in scan.get('items', []):
        key = item.get('key', '')
        na = item.get('next_action', '')
        if '$_rk' in key or '$_rk' in na:
            item['scan_state'] = '$_new_state'
            item['scan_state_updated_at'] = '$_ts'
            if '$_wt_path':
                item['scan_state_worktree'] = '$_wt_path'
    tmp = '$_scan_file' + '.tmp'
    with open(tmp, 'w') as f: json.dump(scan, f, indent=2)
    os.rename(tmp, '$_scan_file')
except: pass
" 2>/dev/null || true
}

# ── Create worktree helper ───────────────────────────────

# Apply the project's declarative seeds to a freshly created worktree.
# The manifest lives in the repo, so a project can list whatever gitignored
# files it needs without touching this script.
_seed_worktree() {
  local target_path="$1" out
  local seeder="$ROOT_DIR/docs/system/workspace/scripts/worktree/worktree_seed.py"
  [[ -f "$seeder" ]] || return 0
  # Source of truth is the main project tree, not this worktree: the gitignored
  # files we are seeding do not exist here yet (that is the whole point).
  local seed_root="$ROOT_DIR" home
  if [[ -f "$ROOT_DIR/.freely/config.toml" ]]; then
    home=$(sed -n 's/^[[:space:]]*FREELY_HOME[[:space:]]*=[[:space:]]*"\(.*\)"/\1/p' \
      "$ROOT_DIR/.freely/config.toml" 2>/dev/null | head -1)
    [[ -n "$home" && -d "$home" ]] && seed_root="$home"
  fi
  if ! out=$(python3 "$seeder" apply --project "$seed_root" --target "$target_path" 2>&1); then
    printf '%s\n' "$out" >&2
    return 1
  fi
  # Keep the summary, drop the per-file "skipped" noise on re-runs.
  printf '%s\n' "$out" | grep -v '^\[wt-seed\] skipped:' || true
}

_create_worktree() {
  local branch="$1" target_path="$2" base_branch="$3"

  mkdir -p "$(freely_wt_root_dir)"

  FREELY_WT_CREATE=1 git worktree add -b "$branch" "$target_path" "$base_branch"

  _materialize_chat_if_needed "$branch" "$target_path" || return 1

  if [[ -x "$ROOT_DIR/bin/freely" ]]; then
    FREELY_WT_AUTOCREATE_INTERNAL=1 bash "$ROOT_DIR/bin/freely" sync-tooling \
      --source-project "$ROOT_DIR" --project "$target_path" >/dev/null 2>&1 || true
  fi
}

# ── Test worktree initialisation: single source of truth ─────────
# Normal Step 2, interrupted-run recovery and the legacy test-pre-merge
# 补建 path all converge here, so a recovered test worktree is equivalent
# to a normally created one (seed / .freely state / test gate marker).
_init_test_worktree_state() {
  local tp_target="$1"
  local _src_freely _dst_freely

  if ! _seed_worktree "$tp_target"; then
    echo "拒绝创建工位: worktree seed failed" >&2
    return 1
  fi

  _src_freely="$ROOT_DIR/.freely"
  _dst_freely="$tp_target/.freely"
  if [[ -d "$_src_freely" && -d "$tp_target" ]]; then
    mkdir -p "$_dst_freely"
    [[ -f "$_src_freely/freely.db" ]] && cp "$_src_freely/freely.db" "$_dst_freely/freely.db" 2>/dev/null || true
    [[ -f "$_src_freely/a2a_task.db" ]] && cp "$_src_freely/a2a_task.db" "$_dst_freely/a2a_task.db" 2>/dev/null || true
    echo "  test-pre-merge: cloned .freely state from develop"
  fi

  # Always write the gate marker, even when the source .freely tree is
  # absent (fresh checkout / minimal package). The daemon updates
  # TEST_STATUS and LAST_TESTED_COMMIT; gates compare them against HEAD.
  mkdir -p "$tp_target/.freely/run"
  cat > "$tp_target/.freely/run/test-gate.env" <<'TEST_INIT'
TEST_STATUS="not_tested"
LAST_TESTED_AT="1970-01-01T00:00:00Z"
LAST_TESTED_COMMIT=""
TEST_INIT
  echo "  test-pre-merge: initialized test-gate.env (not_tested)"
  return 0
}

# ── Recovery: provision only the missing test-pre-merge worktree ──
# Runs after the helpers are defined and before _require_issue_exists /
# remote fetch. An interrupted run already owns its dev worktree and raw
# issue, so re-validating platforms or syncing develop would reintroduce the
# very network dependency that caused the interruption in the first place.
if [[ "$resume_mode" -eq 1 ]]; then
  echo "=== 恢复模式: 补齐缺失的工位与初始化 ==="

  # (1) dev worktree directory was removed but its branch survived.
  #     The branch already exists, so `git worktree add` MUST NOT use -b.
  if [[ -z "$_dev_dir" ]]; then
    _dev_target="$(freely_wt_target_path_for_branch "$dev_branch")"
    mkdir -p "$(freely_wt_root_dir)"
    if ! FREELY_WT_CREATE=1 git worktree add "$_dev_target" "$dev_branch"; then
      echo "恢复失败: dev 工位补建失败" >&2
      exit 1
    fi
    _dev_dir="$_dev_target"
    echo "  dev 工位已补建: $_dev_dir"
  fi

  # (2) test worktree: rebuild the directory when missing, otherwise keep
  #     the registered one. A surviving test branch also means "no -b".
  if [[ -z "$_test_dir" ]]; then
    tp_target="$(freely_wt_target_path_for_branch "$test_pre_merge_branch")"
    mkdir -p "$(freely_wt_root_dir)"
    if [[ "$_test_exists" -eq 1 ]]; then
      _created=0
      FREELY_WT_CREATE=1 git worktree add "$tp_target" "$test_pre_merge_branch" && _created=1
    else
      _created=0
      _create_worktree "$test_pre_merge_branch" "$tp_target" "$dev_branch" && _created=1
    fi
    if [[ "$_created" -ne 1 ]]; then
      echo "恢复失败: test 工位创建失败" >&2
      git -C "$ROOT_DIR" worktree remove "$tp_target" --force 2>/dev/null || true
      git -C "$ROOT_DIR" branch -D "$test_pre_merge_branch" 2>/dev/null || true
      exit 1
    fi
    _test_dir="$tp_target"
    echo "  test 工位已补建: $tp_target"
  else
    tp_target="$_test_dir"
  fi

  # (3) A surviving test directory may be only half-initialised. The marker
  #     is test-gate.env; re-run the SAME initialisation single source.
  if [[ "$_test_ready" -eq 0 ]]; then
    if ! _init_test_worktree_state "$tp_target"; then
      echo "恢复失败: test 工位初始化失败" >&2
      git -C "$ROOT_DIR" worktree remove "$tp_target" --force 2>/dev/null || true
      git -C "$ROOT_DIR" branch -D "$test_pre_merge_branch" 2>/dev/null || true
      exit 1
    fi
    echo "  test 工位初始化已补齐"
  fi

  # Recovery: the dev worktree ALREADY EXISTS, so reverse-lookup its real
  # registered path. freely_wt_resolve_target_path() is for a worktree about
  # to be CREATED: it appends a hash suffix when the target exists, which
  # would yield a non-existent path here and poison scan_state_worktree.
  _recovery_dev_path="$(_wt_registered_dir "$dev_branch")" || {
    echo "恢复失败: 反查 dev 工位失败，git worktree list 中找不到 $dev_branch 的有效工位目录" >&2
    exit 1
  }
  if [[ "$_recovery_dev_path" != "$_dev_dir" ]]; then
    echo "恢复失败: dev 工位反查结果不一致 ($_dev_dir vs $_recovery_dev_path)" >&2
    exit 1
  fi
  _update_scan_state "$raw_key" "working" "$_recovery_dev_path"
  cat <<MSG

╔══════════════════════════════════════════════════════════╗
║  Worktrees recovered                                    ║
╠══════════════════════════════════════════════════════════╣
║  dev (kept):      $_recovery_dev_path
║  test (created):  $tp_target
║  base:            $dev_branch
║  raw key:         $raw_key
╠══════════════════════════════════════════════════════════╣
║  后续流程不变：cd 到 dev 工位继续 B1/B2/RED/GREEN          ║
╚══════════════════════════════════════════════════════════╝
MSG
  exit 0
fi

