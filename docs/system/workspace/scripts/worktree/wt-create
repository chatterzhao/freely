│    cd $tp_target                                         │
│                                                          │
│  请阅读 skill:${skill_name}                                 │
│  按其规范流程的完整步骤执行。                                 │
│  Skill 是流程的唯一权威来源——不依赖本提示的摘要。              │
└──────────────────────────────────────────────────────────┘
REMINDER
      ;;
    *)
      cat <<REMINDER

┌─ 下一步 ───────────────────────────────────────────────┐
│  进入工位开发:                                            │
│    cd $fix_target                                        │
│  测试时进入 test-pre-merge 工位:                          │
│    cd $tp_target                                         │
│  仔细阅读 skill: ${skill_path}                             │
└──────────────────────────────────────────────────────────┘
REMINDER
      ;;
  esac
else
  # legacy 补建：仅当传入分支名是 test-pre-merge-<raw-key>-<slug> 时，
  # 才按完整测试工位规格创建。base 必须是对应 dev 分支，绝不回退到 develop，
  # 否则补建出的工位基于错误基线，门禁无法验证该 lane 的改动。
  legacy_test_pre_merge=0
  _legacy_dev_base=""
  if [[ "$dev_branch" == test-pre-merge-* ]]; then
    legacy_test_pre_merge=1
    _legacy_raw_key="$(printf '%s\n' "$dev_branch" | sed -E 's/^test-pre-merge-([0-9]{8}[-T][0-9]{4,6}Z?)-.*/\1/')"
    if [[ -n "$_legacy_raw_key" && "$_legacy_raw_key" != "$dev_branch" ]]; then
      _legacy_dev_base="$(git branch --format='%(refname:short)' | grep -E "^(fix|feature|hotfix)/raw-${_legacy_raw_key}-" | head -1 || true)"
    fi
    if [[ -z "$_legacy_dev_base" ]]; then
      echo "拒绝补建: 找不到 raw-${_legacy_raw_key:-?} 对应的 dev 分支" >&2
      echo "  legacy 补建必须以对应 fix/feature/hotfix 分支为 base，不会回退到 develop。" >&2
      exit 1
    fi
    base="$_legacy_dev_base"
  fi

  tp_target="$(freely_wt_resolve_target_path "$dev_branch")"
  _create_worktree "$dev_branch" "$tp_target" "$base"
  if [[ "$legacy_test_pre_merge" -eq 1 ]]; then
    if ! _init_test_worktree_state "$tp_target"; then
      echo "拒绝补建: test 工位初始化失败" >&2
      git -C "$ROOT_DIR" worktree remove "$tp_target" --force 2>/dev/null || true
      git -C "$ROOT_DIR" branch -D "$dev_branch" 2>/dev/null || true
      exit 1
    fi
  fi

  cat <<MSG
Created worktree:
  $tp_target
Branch:
  $dev_branch
Execution base:
  $base

  wt-create 标准模式: --raw-key <key> --source platform --kind <fix|feature|hotfix> --slug <slug>
    使用场景：从 raw issue 创建 fix|hotfix|feature + test-pre-merge 工位对，走完整 IBM 治理链路
    可重跑恢复：Step 2 之前中断后用相同参数重跑，只补建缺失的 test 工位；双工位齐全时 no-op
  wt-create legacy 模式: <branch>
    使用场景：传入 test-pre-merge-<raw-key>-<slug> 分支名时补建测试工位（自动以对应 dev 分支为 base，
              并执行 seed / .freely 状态 / test-gate.env 初始化）；纯文档修改、init develop、release 分支
MSG
fi
