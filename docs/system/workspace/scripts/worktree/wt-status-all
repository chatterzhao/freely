#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  freely wt-status-all

Behavior:
  - list every mounted git worktree and whether it is CLEAN or DIRTY
  - return 0 when all worktrees are CLEAN
  - return 2 when any worktree is DIRTY
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

entries="$(git worktree list --porcelain | awk '
  BEGIN { wt=""; br="" }
  /^worktree / { wt=substr($0, 10); br="(detached)" }
  /^branch / { br=$2; sub(/^refs\/heads\//, "", br) }
  /^$/ {
    if (wt != "") {
      print wt "|" br
      wt=""
      br=""
    }
  }
  END {
    if (wt != "") {
      print wt "|" br
    }
  }
')"

if [[ -z "$entries" ]]; then
  echo "No worktrees found."
  exit 1
fi

dirty_count=0
total_count=0

while IFS='|' read -r wt_path wt_branch; do
  [[ -n "$wt_path" ]] || continue
  total_count=$((total_count + 1))

  if [[ -n "$(git -C "$wt_path" status --porcelain)" ]]; then
    state="DIRTY"
    dirty_count=$((dirty_count + 1))
  else
    state="CLEAN"
  fi

  printf "%-6s | %-40s | %s\n" "$state" "$wt_branch" "$wt_path"
done <<< "$entries"

echo "---"
echo "Summary: total=${total_count}, dirty=${dirty_count}"

if [[ "$dirty_count" -gt 0 ]]; then
  exit 2
fi

