#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  ./bin/merge-guarded <target-branch> <source-branch>

Behavior:
  - non-interactive policy gate before merge
  - blocks invalid merge direction immediately
  - runs git merge --no-ff for allowed paths
USAGE
}

target="${1:-}"
source_branch="${2:-}"

[[ -n "$target" && -n "$source_branch" ]] || { usage; exit 1; }

current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if [[ "$current_branch" != "$target" ]]; then
  echo "[MERGE-GUARD] blocked: current branch is '$current_branch', expected '$target'." >&2
  exit 1
fi

allowed=0
if [[ "$target" == test-pre-merge-* ]]; then
  case "$source_branch" in
    feature/*|hotfix/*) allowed=1 ;;
  esac
else
  case "$target" in
  develop)
    if [[ "$source_branch" == feature/* ]]; then
      allowed=1
    elif [[ "$source_branch" == hotfix/* ]]; then
      allowed=1
    fi
    ;;
  main)
    if [[ "$source_branch" == release/* ]]; then
      allowed=1
    elif [[ "$source_branch" == hotfix/* ]]; then
      allowed=1
    fi
    ;;
  *)
    allowed=0
    ;;
  esac
fi

if [[ "$allowed" != "1" ]]; then
  cat <<MSG >&2
[MERGE-GUARD] blocked merge:
  target: $target
  source: $source_branch

Allowed:
  feature/* -> test-pre-merge-*
  hotfix/* -> test-pre-merge-*
  feature/* -> develop
  hotfix/* -> develop
  release/* -> main
  hotfix/* -> main
MSG
  exit 1
fi

echo "[MERGE-GUARD] allowed: $source_branch -> $target"
if [[ "$target" == "develop" && -x "./bin/governance-promotion-gate" ]]; then
  ./bin/governance-promotion-gate --project "$PWD" --target-branch "$target" --source-branch "$source_branch"
fi
git merge --no-ff "$source_branch"
