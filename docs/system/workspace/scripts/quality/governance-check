check_v2_candidate_fields() {
  local candidates="$1"
  rg -n "^[- ]*candidate_format_version:\\s*v2$" "$candidates" >/dev/null 2>&1 || return 0

  rg -n "acceptance_criteria:" "$candidates" >/dev/null 2>&1 || fail "missing acceptance_criteria in v2 candidate file $candidates"
  rg -n "promotion_gate:" "$candidates" >/dev/null 2>&1 || fail "missing promotion_gate in v2 candidate file $candidates"
  rg -n "open_questions:" "$candidates" >/dev/null 2>&1 || fail "missing open_questions in v2 candidate file $candidates"
  rg -n "acceptance_reviews:" "$candidates" >/dev/null 2>&1 || fail "missing acceptance_reviews in v2 candidate file $candidates"

  if rg -n "^[- ]*status:\\s*promoted$" "$candidates" >/dev/null 2>&1; then
    rg -n "reviewer:" "$candidates" >/dev/null 2>&1 || fail "promoted v2 candidate file $candidates must contain at least one acceptance review"
  fi
}

check_candidate_milestone_bindings() {
  python3 - <<'PY'
import pathlib
import re
import sys

root = pathlib.Path(".")
milestones_path = root / "docs/milestones.md"
lines = milestones_path.read_text(encoding="utf-8").splitlines()

def normalize_milestone(value: str) -> str:
    value = value.strip().strip("`").strip("'").strip('"').strip()
    anchor = re.search(r"(M-[A-Za-z0-9-]+)$", value, re.IGNORECASE)
    if anchor:
        value = "M-" + anchor.group(1)[2:]
    return value

milestone_status = {}
candidate_entries = {}
formal_issue_entries = {}
current_milestone = None
current_queue = None
current_item = None

for raw in lines:
    line = raw.strip()
    m = re.match(r"^##\s+(M-[A-Za-z0-9-]+)\s*$", line)
    if m:
        current_milestone = m.group(1)
        current_queue = None
        current_item = None
        continue
    m = re.match(r"^-+\s*status:\s*([A-Za-z0-9_-]+)\s*$", line)
    if m and current_milestone:
        milestone_status[current_milestone] = m.group(1)
        continue
    m = re.match(r"^###\s+(candidate_issues|committed_issues|completed_issues)\s*$", line)
    if m:
        current_queue = m.group(1)
        current_item = None
        continue
    m = re.match(r"^\d+\.\s+`(C-[^`]+)`\s*$", line)
    if m and current_milestone and current_queue == "candidate_issues":
        candidate_entries.setdefault(m.group(1), []).append(current_milestone)
        current_item = None
        continue
    m = re.match(r"^\d+\.\s+`(I-[^`]+)`\s*$", line)
    if m and current_milestone and current_queue in {"committed_issues", "completed_issues"}:
        current_item = (current_milestone, current_queue)
        continue
    m = re.match(r"^\s*-\s*issue_path:\s*(.+?)\s*$", raw)
    if m and current_item:
        issue_path = m.group(1).strip().strip("`").strip("'").strip('"').strip()
        formal_issue_entries.setdefault(issue_path, []).append(current_item)
        continue
    m = re.match(r"^\s*-\s*source_candidates:\s*(.+?)\s*$", raw)
    if m and current_item:
        refs = re.findall(r"`([^`]+)`", m.group(1))
        if not refs:
            refs = [m.group(1).split(":", 1)[-1].strip()]
        for ref in refs:
            normalized_ref = ref.strip().strip("`").strip("'").strip('"').strip()
            if normalized_ref:
                formal_issue_entries.setdefault(normalized_ref, []).append(current_item)
        continue
    m = re.match(r"^\s*-\s+(.+?)\s*$", raw)
    if m and current_item:
        refs = re.findall(r"`([^`]+)`", m.group(1))
        if refs:
            for ref in refs:
                formal_issue_entries.setdefault(ref.split("#", 1)[0].strip(), []).append(current_item)

errors = []

candidate_files = sorted((root / "docs/pre-brainstorms").glob("*/candidates.md"))
for path in candidate_files:
    text = path.read_text(encoding="utf-8")
    starts = []
    for idx, line in enumerate(text.splitlines()):
        m = re.match(r"^\s*###\s+(C-[A-Za-z0-9-]+)\s*$", line.strip())
        if m:
            starts.append((idx, m.group(1)))
            continue
        m = re.match(r"^\s*-\s*(candidate_id|id):\s*`?(C-[A-Za-z0-9-]+)`?\s*$", line)
        if m:
            starts.append((idx, m.group(2)))
    if not starts:
        continue
    lines = text.splitlines()
    for pos, (start_idx, candidate_id) in enumerate(starts):
        end_idx = starts[pos + 1][0] if pos + 1 < len(starts) else len(lines)
        block = "\n".join(lines[start_idx:end_idx])
        def grab(name):
            m = re.search(rf"^\s*-\s*{re.escape(name)}:\s*(.+?)\s*$", block, re.MULTILINE)
            if not m:
                return ""
            value = m.group(1).strip().strip("`").strip("'").strip('"').strip()
            return value
        def grab_list(name):
            values = []
            inline = re.search(rf"^\s*-\s*{re.escape(name)}:\s*(.+?)\s*$", block, re.MULTILINE)
            if inline:
                inline_value = inline.group(1).strip()
                if inline_value:
                    values.append(inline_value.strip("`").strip("'").strip('"').strip())
            list_block = re.search(rf"^\s*-\s*{re.escape(name)}:\s*$([\s\S]*?)(?=^\s*-\s*[A-Za-z0-9_-]+:|\Z)", block, re.MULTILINE)
            if list_block:
                for raw_line in list_block.group(1).splitlines():
                    item = re.match(r"^\s*-\s+(.+?)\s*$", raw_line)
                    if item:
                        values.append(item.group(1).strip().strip("`").strip("'").strip('"').strip())
            return [value for value in values if value]
        status = grab("status")
        milestone = normalize_milestone(grab("milestone"))
        promoted_issue_paths = grab_list("promoted_issue_path")
        active_statuses = {"proposed", "needs_research", "blocked", "promoted"}
        if status not in active_statuses:
            continue
        if not milestone or milestone == "unassigned" or milestone.startswith("pending://"):
            errors.append(f"[FAIL] {candidate_id} in {path.as_posix()} is active with status '{status}', but milestone is '{milestone or 'missing'}'. Bind it to an active milestone instead of leaving it unassigned.")
            continue
        if milestone_status.get(milestone) != "active":
            actual = milestone_status.get(milestone, "missing")
            errors.append(f"[FAIL] {candidate_id} in {path.as_posix()} is active with status '{status}', but declared milestone {milestone} has status '{actual}'. Active unresolved candidates must bind to an active milestone.")
        if status in {"proposed", "needs_research", "blocked"}:
            actual_entries = candidate_entries.get(candidate_id, [])
            if milestone not in actual_entries:
                if actual_entries:
                    errors.append(f"[FAIL] {candidate_id} in {path.as_posix()} declares milestone {milestone}, but docs/milestones.md places it in {', '.join(sorted(set(actual_entries)))}. Keep candidate metadata and milestone queue placement aligned.")
                else:
                    errors.append(f"[FAIL] {candidate_id} in {path.as_posix()} declares milestone {milestone}, but docs/milestones.md has no candidate_issues entry for it.")
        elif status == "promoted":
            if not promoted_issue_paths:
                errors.append(f"[FAIL] {candidate_id} in {path.as_posix()} is marked promoted, but promoted_issue_path is missing. Materialize it into a real issue before merge.")
                continue
            if all(issue_path.startswith("pending://") for issue_path in promoted_issue_paths):
                rendered = ", ".join(promoted_issue_paths)
                errors.append(f"[FAIL] {candidate_id} in {path.as_posix()} is marked promoted, but promoted_issue_path is still '{rendered}'. Materialize it into a real issue before merge.")
                continue
            formal_entries = []
            rendered_paths = []
            for promoted_issue_path in promoted_issue_paths:
                if promoted_issue_path.startswith("pending://"):
                    continue
                rendered_paths.append(promoted_issue_path)
                formal_entries.extend(formal_issue_entries.get(promoted_issue_path, []))
            if not formal_entries:
                rendered = ", ".join(rendered_paths or promoted_issue_paths)
                errors.append(f"[FAIL] {candidate_id} in {path.as_posix()} is promoted to {rendered or 'missing'}, but docs/milestones.md has no committed/completed issue entry for that issue.")
                continue
            actual_entries = sorted({entry_milestone for entry_milestone, _queue in formal_entries})
            if milestone not in actual_entries:
                rendered = ", ".join(rendered_paths or promoted_issue_paths)
                errors.append(f"[FAIL] {candidate_id} in {path.as_posix()} declares milestone {milestone}, but docs/milestones.md sequences promoted issue {rendered} under {', '.join(actual_entries)}. Keep candidate metadata and milestone queue placement aligned.")

if errors:
    print("\n".join(errors))
    sys.exit(1)
PY
}

check_file_exists() {
  local file="$1"
  [[ -f "$file" ]] || fail "missing file: $file"
}

check_no_tbd() {
  local file="$1"
  if rg -n "<TBD>" "$file" >/dev/null 2>&1; then
    fail "placeholder <TBD> found in $file"
  fi
}

check_three_loop_reference() {
  local file="$1"
  rg -n --fixed-strings "docs/system/workspace/three-loop-capability-lifecycle.md" "$file" >/dev/null 2>&1 \
    || fail "missing three-loop lifecycle reference in $file"
}

check_fixed_string() {
  local file="$1"
  local text="$2"
  local description="$3"
  rg -n --fixed-strings "$text" "$file" >/dev/null 2>&1 || fail "missing ${description} in $file"
}

check_entry_naming() {
  local entry="$1"
  # 新格式：YYYYMMDD-HHMM--<topic>（时间后双短横线）
  local new_format="^[0-9]{8}-[0-9]{4}--.+$"
  # 遗留格式：YYYYMMDD-<topic>（日期后单短横线，topic 可含短横线）
  local legacy_format="^[0-9]{8}-.+$"
  
  if [[ "$entry" =~ $new_format ]]; then
    return 0
  elif [[ "$entry" =~ $legacy_format ]]; then
    warn "pre-brainstorm entry '$entry' uses legacy naming, consider migrating to YYYYMMDD-HHMM--<topic>"
    return 0
  else
    fail "pre-brainstorm entry '$entry' does not match naming convention: YYYYMMDD-HHMM--<topic>"
    return 1
  fi
}

audit_current_protected_branch_merge_receipt() {
  local branch head_parents commit_body bypass_mode merge_path source_branch
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  case "$branch" in
    main|develop|test-pre-merge-*) ;;
    *) return 0 ;;
  esac

  git rev-parse -q --verify HEAD >/dev/null 2>&1 || return 0
  head_parents="$(git rev-list --parents -n 1 HEAD 2>/dev/null || true)"
  [[ -n "$head_parents" ]] || return 0
  if [[ "$(awk '{print NF-1}' <<<"$head_parents")" -lt 2 ]]; then
    return 0
  fi

  commit_body="$(git log -1 --format=%B HEAD 2>/dev/null || true)"
  merge_path="$(sed -n 's/^Freely-Merge-Path:[[:space:]]*//p' <<<"$commit_body" | tail -n 1)"
  bypass_mode="$(sed -n 's/^Freely-Bypass-Mode:[[:space:]]*//p' <<<"$commit_body" | tail -n 1)"
  source_branch="$(sed -n 's/^Freely-Source-Branch:[[:space:]]*//p' <<<"$commit_body" | tail -n 1)"

  [[ -n "$merge_path" ]] || {
    fail "protected branch '$branch' HEAD merge commit is missing Freely-Merge-Path receipt"
    return 0
  }
  [[ -n "$source_branch" ]] || fail "protected branch '$branch' HEAD merge commit is missing Freely-Source-Branch receipt"

  case "$merge_path" in
    merge-guarded|merge-guarded-complete|merge-guarded-break-glass) ;;
    *) fail "protected branch '$branch' HEAD merge commit has unknown Freely-Merge-Path '$merge_path'" ;;
  esac

  case "$bypass_mode" in
    forbidden)
      return 0
      ;;
    break_glass)
      ;;
    "")
      fail "protected branch '$branch' HEAD merge commit is missing Freely-Bypass-Mode receipt"
      return 0
      ;;
    *)
      fail "protected branch '$branch' HEAD merge commit has invalid Freely-Bypass-Mode '$bypass_mode'"
      return 0
      ;;
  esac

  sed -n 's/^Freely-Break-Glass-Reason:[[:space:]]*//p' <<<"$commit_body" | tail -n 1 | grep -Eq '^(tooling_unavailable|verified_false_negative)$' \
    || fail "protected branch '$branch' HEAD break-glass merge is missing a valid Freely-Break-Glass-Reason"
  sed -n 's/^Freely-Blocked-Gate:[[:space:]]*//p' <<<"$commit_body" | tail -n 1 | grep -Eq '^(pre-commit|pre-merge-commit|governance-merge-gate|governance-promotion-gate|pretests-gate|checkpoint-guard)$' \
    || fail "protected branch '$branch' HEAD break-glass merge is missing a valid Freely-Blocked-Gate"
  sed -n 's/^Freely-Operation-Scope:[[:space:]]*//p' <<<"$commit_body" | tail -n 1 | grep -Eq '^merge_completion_only$' \
    || fail "protected branch '$branch' HEAD break-glass merge must declare Freely-Operation-Scope: merge_completion_only"
  sed -n 's/^Freely-Follow-On-Issue:[[:space:]]*//p' <<<"$commit_body" | tail -n 1 | grep -Eq '^I-[A-Za-z0-9-]+$' \
    || fail "protected branch '$branch' HEAD break-glass merge is missing a valid Freely-Follow-On-Issue"
  rg -n '^Freely-Evidence-Ref:[[:space:]]*\S+' <<<"$commit_body" >/dev/null 2>&1 \
    || fail "protected branch '$branch' HEAD break-glass merge must include at least one Freely-Evidence-Ref"
}

audit_recorded_protected_branch_breakglass_receipts() {
  python3 - <<'PY'
import pathlib
import re
import subprocess
import sys
from collections import Counter

root = pathlib.Path(".")
receipts_path = root / "docs/system/workspace/hooks/protected-branch-breakglass-receipts.md"
text = receipts_path.read_text(encoding="utf-8")

effective_match = re.search(r"^- audit_effective_date:\s*`?([0-9]{4}-[0-9]{2}-[0-9]{2})`?\s*$", text, re.MULTILINE)
if not effective_match:
    print(f"[FAIL] {receipts_path.as_posix()} must declare - audit_effective_date: `YYYY-MM-DD`")
    sys.exit(1)

effective_date = effective_match.group(1)
effective_since = f"{effective_date} 00:00:00"
starts = list(re.finditer(r"^##\s+Receipt:\s+([0-9a-f]{7,40})\s*$", text, re.MULTILINE))

allowed_reasons = {"tooling_unavailable", "verified_false_negative"}
allowed_scopes = {"merge_completion_only"}
allowed_gates = {"pre-commit", "pre-merge-commit", "governance-merge-gate", "governance-promotion-gate", "pretests-gate", "checkpoint-guard"}
allowed_receipt_modes = {"trailer_parity", "legacy_backfill"}
receipts = {}
errors = []
observed_receipts = set()

for idx, match in enumerate(starts):
    commit = match.group(1)
    end = starts[idx + 1].start() if idx + 1 < len(starts) else len(text)
    block = text[match.start():end]

    def grab(name: str):
        m = re.search(rf"^\s*-\s*{re.escape(name)}:\s*(.+?)\s*$", block, re.MULTILINE)
        if not m:
            return None
        return m.group(1).strip().strip("`").strip()

    def grab_list(name: str):
        m = re.search(rf"^\s*-\s*{re.escape(name)}:\s*$([\s\S]*?)(?=^\s*-\s*[A-Za-z0-9_-]+:|^##\s+Receipt:|\Z)", block, re.MULTILINE)
        if not m:
            return []
        values = []
        for raw in m.group(1).splitlines():
            item = re.match(r"^\s*-\s+(.+?)\s*$", raw)
            if item:
                values.append(item.group(1).strip().strip("`").strip())
        return values

    target_branch = grab("target_branch")
    source_branch = grab("source_branch")
    receipt_mode = grab("receipt_mode") or "trailer_parity"
    bypass_mode = grab("bypass_mode")
    reason = grab("break_glass_reason")
    blocked_gate = grab("blocked_gate")
    scope = grab("operation_scope")
    follow_on_owner = grab("follow_on_owner")
    evidence_refs = grab_list("evidence_refs")

    if target_branch not in {"develop", "main"} and not (target_branch or "").startswith("test-pre-merge-"):
        errors.append(f"[FAIL] {receipts_path.as_posix()} receipt {commit} has invalid target_branch '{target_branch}'.")
    if not source_branch:
        errors.append(f"[FAIL] {receipts_path.as_posix()} receipt {commit} is missing source_branch.")
    if receipt_mode not in allowed_receipt_modes:
        errors.append(f"[FAIL] {receipts_path.as_posix()} receipt {commit} has invalid receipt_mode '{receipt_mode}'.")
    if bypass_mode != "break_glass":
        errors.append(f"[FAIL] {receipts_path.as_posix()} receipt {commit} must declare bypass_mode: `break_glass`.")
    if reason not in allowed_reasons:
        errors.append(f"[FAIL] {receipts_path.as_posix()} receipt {commit} has invalid break_glass_reason '{reason}'.")
    if blocked_gate not in allowed_gates:
        errors.append(f"[FAIL] {receipts_path.as_posix()} receipt {commit} has invalid blocked_gate '{blocked_gate}'.")
    if scope not in allowed_scopes:
        errors.append(f"[FAIL] {receipts_path.as_posix()} receipt {commit} has invalid operation_scope '{scope}'.")
    if not follow_on_owner or not re.match(r"^I-[A-Za-z0-9-]+$", follow_on_owner):
        errors.append(f"[FAIL] {receipts_path.as_posix()} receipt {commit} is missing a valid follow_on_owner.")
    if not evidence_refs:
        errors.append(f"[FAIL] {receipts_path.as_posix()} receipt {commit} must list at least one evidence_ref.")

    receipts[commit] = {
        "target_branch": target_branch,
        "source_branch": source_branch,
        "receipt_mode": receipt_mode,
        "bypass_mode": bypass_mode,
        "break_glass_reason": reason,
        "blocked_gate": blocked_gate,
        "operation_scope": scope,
        "follow_on_owner": follow_on_owner,
        "evidence_refs": evidence_refs,
    }

branches = ["develop"]
try:
    extra_refs = subprocess.check_output(
        ["git", "for-each-ref", "--format=%(refname:short)", "refs/heads/main", "refs/heads/test-pre-merge-*"],
        cwd=root,
        text=True,
    ).splitlines()
except subprocess.CalledProcessError:
    extra_refs = []

for ref in extra_refs:
    ref = ref.strip()
    if ref and ref not in branches:
        branches.append(ref)

for branch in branches:
    try:
        merge_output = subprocess.check_output(
            ["git", "log", branch, "--merges", "--since", effective_since, "--format=%H%x00%B%x00"],
            cwd=root,
            text=True,
        )
    except subprocess.CalledProcessError:
        continue

    chunks = [chunk for chunk in merge_output.split("\x00") if chunk]
    for idx in range(0, len(chunks), 2):
        commit = chunks[idx].strip()
        body = chunks[idx + 1] if idx + 1 < len(chunks) else ""
        if not commit:
            continue
        if re.search(r"^Freely-Merge-Path:\s+(merge-guarded|merge-guarded-complete)\s*$", body, re.MULTILINE):
            continue
        if re.search(r"^Freely-Merge-Path:\s+merge-guarded-break-glass\s*$", body, re.MULTILINE):
            receipt = receipts.get(commit)
            if receipt and receipt.get("target_branch") == branch:
                observed_receipts.add(commit)
                if receipt.get("receipt_mode") == "legacy_backfill":
                    errors.append(
                        f"[FAIL] protected branch break-glass merge {commit} on {branch} is trailer-bearing but receipt_mode is legacy_backfill."
                    )
                    continue
                def grab_trailer(name: str):
                    match = re.search(rf"^{re.escape(name)}:\s*(.+?)\s*$", body, re.MULTILINE)
                    return match.group(1).strip() if match else ""

                trailer_source_branch = grab_trailer("Freely-Source-Branch")
                trailer_bypass_mode = grab_trailer("Freely-Bypass-Mode")
                trailer_reason = grab_trailer("Freely-Break-Glass-Reason")
                trailer_blocked_gate = grab_trailer("Freely-Blocked-Gate")
                trailer_scope = grab_trailer("Freely-Operation-Scope")
                trailer_follow_on_issue = grab_trailer("Freely-Follow-On-Issue")
                trailer_evidence_refs = re.findall(r"^Freely-Evidence-Ref:\s*(.+?)\s*$", body, re.MULTILINE)

                comparisons = [
                    ("source_branch", trailer_source_branch, receipt.get("source_branch", "")),
                    ("bypass_mode", trailer_bypass_mode, receipt.get("bypass_mode", "")),
                    ("break_glass_reason", trailer_reason, receipt.get("break_glass_reason", "")),
                    ("blocked_gate", trailer_blocked_gate, receipt.get("blocked_gate", "")),
                    ("operation_scope", trailer_scope, receipt.get("operation_scope", "")),
                    ("follow_on_owner", trailer_follow_on_issue, receipt.get("follow_on_owner", "")),
                ]
                for field_name, trailer_value, receipt_value in comparisons:
                    if trailer_value != receipt_value:
                        errors.append(
                            f"[FAIL] protected branch break-glass merge {commit} on {branch} has trailer/ledger mismatch for {field_name}: trailer='{trailer_value}' ledger='{receipt_value}'."
                        )

                if Counter(trailer_evidence_refs) != Counter(receipt.get("evidence_refs", [])):
                    errors.append(
                        f"[FAIL] protected branch break-glass merge {commit} on {branch} has trailer/ledger mismatch for evidence_refs."
                    )
                continue
            errors.append(
                f"[FAIL] protected branch break-glass merge {commit} on {branch} is missing a matching receipt in {receipts_path.as_posix()}."
            )
            continue
        receipt = receipts.get(commit)
        if receipt and receipt.get("target_branch") == branch:
            observed_receipts.add(commit)
            if receipt.get("receipt_mode") == "legacy_backfill":
                continue
            errors.append(
                f"[FAIL] protected branch merge {commit} on {branch} has a trailer_parity receipt in {receipts_path.as_posix()} but the merge commit is missing canonical break-glass trailers."
            )

for commit, receipt in receipts.items():
    if receipt.get("target_branch") not in branches:
        errors.append(
            f"[FAIL] {receipts_path.as_posix()} receipt {commit} targets unknown branch '{receipt.get('target_branch')}'."
        )
        continue
    if commit not in observed_receipts:
        errors.append(
            f"[FAIL] {receipts_path.as_posix()} receipt {commit} does not match any protected-branch merge on {receipt.get('target_branch')} since {effective_since}."
        )

if errors:
    print("\n".join(errors))
    sys.exit(1)
PY
}

for file in "${required_files[@]}"; do
  check_file_exists "$file"
  check_no_tbd "$file"
done

