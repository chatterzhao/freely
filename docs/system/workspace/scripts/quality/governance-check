}

check_entry_naming() {
  local entry="$1"
  # 新格式：YYYYMMDD-HHMM--<topic>（时间后双短横线）
  local new_format="^[0-9]{8}-[0-9]{4}--.+$"
  # 遗留格式：YYYYMMDD-<topic>（日期后单短横线，topic 可含短横线）
  local legacy_format="^[0-9]{8}-.+$"
  
  if [[ "$entry" =~ $new_format ]]; then
    return 0
  elif [[ "$entry" =~ $legacy_format ]]; then
    warn "pre-brainstorm entry '$entry' uses legacy naming, consider migrating to YYYYMMDD-HHMM--<topic>"
    return 0
  else
    fail "pre-brainstorm entry '$entry' does not match naming convention: YYYYMMDD-HHMM--<topic>"
    return 1
  fi
}

audit_current_protected_branch_merge_receipt() {
  local branch head_parents commit_body bypass_mode merge_path source_branch
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  case "$branch" in
    main|develop|test-pre-merge-*) ;;
    *) return 0 ;;
  esac

  git rev-parse -q --verify HEAD >/dev/null 2>&1 || return 0
  head_parents="$(git rev-list --parents -n 1 HEAD 2>/dev/null || true)"
  [[ -n "$head_parents" ]] || return 0
  if [[ "$(awk '{print NF-1}' <<<"$head_parents")" -lt 2 ]]; then
    return 0
  fi

  commit_body="$(git log -1 --format=%B HEAD 2>/dev/null || true)"
  merge_path="$(sed -n 's/^Freely-Merge-Path:[[:space:]]*//p' <<<"$commit_body" | tail -n 1)"
  bypass_mode="$(sed -n 's/^Freely-Bypass-Mode:[[:space:]]*//p' <<<"$commit_body" | tail -n 1)"
  source_branch="$(sed -n 's/^Freely-Source-Branch:[[:space:]]*//p' <<<"$commit_body" | tail -n 1)"

  [[ -n "$merge_path" ]] || {
    fail "protected branch '$branch' HEAD merge commit is missing Freely-Merge-Path receipt"
    return 0
  }
  [[ -n "$source_branch" ]] || fail "protected branch '$branch' HEAD merge commit is missing Freely-Source-Branch receipt"
  if protected_branch_source_policy_active_for_head && ! protected_branch_merge_source_allowed "$branch" "$source_branch"; then
    fail "protected branch '$branch' HEAD merge commit has invalid Freely-Source-Branch '$source_branch'"
  fi

  case "$merge_path" in
    merge-guarded|merge-guarded-complete) ;;
    *) fail "protected branch '$branch' HEAD merge commit has unknown Freely-Merge-Path '$merge_path'" ;;
  esac

  case "$bypass_mode" in
    forbidden)
      return 0
      ;;
    "")
      fail "protected branch '$branch' HEAD merge commit is missing Freely-Bypass-Mode receipt"
      return 0
      ;;
    *)
      fail "protected branch '$branch' HEAD merge commit has invalid Freely-Bypass-Mode '$bypass_mode'"
      return 0
      ;;
  esac
}

protected_branch_merge_source_allowed() {
  local target="$1" source="$2"
  case "$target" in
    develop)
      [[ "$source" == test-pre-merge-* || "$source" == hotfix/* ]]
      ;;
    main)
      [[ "$source" == release/* || "$source" == hotfix/* ]]
      ;;
    test-pre-merge-*)
      [[ "$source" == feature/* || "$source" == hotfix/* || "$source" == feature/premerge-* ]]
      ;;
    *)
      return 1
      ;;
  esac
}

protected_branch_source_policy_effective_date() {
  local receipts_path="docs/system/workspace/hooks/protected-branch-merge-receipt-backfills.md"
  [[ -f "$receipts_path" ]] || return 0
  sed -n 's/^- source_policy_effective_date:[[:space:]]*`\\{0,1\\}\\([0-9]\\{4\\}-[0-9]\\{2\\}-[0-9]\\{2\\}\\).*/\\1/p' "$receipts_path" | head -n 1
}

protected_branch_source_policy_active_for_head() {
  local effective_date head_date
  effective_date="$(protected_branch_source_policy_effective_date)"
  [[ -n "$effective_date" ]] || return 1
  head_date="$(git log -1 --format=%cs HEAD 2>/dev/null || true)"
  [[ -n "$head_date" ]] || return 1
  [[ "$head_date" > "$effective_date" || "$head_date" == "$effective_date" ]]
}

audit_recorded_protected_branch_merge_receipt_backfills() {
  python3 - <<'PY'
import pathlib
import re
import subprocess
import sys

root = pathlib.Path(".")
receipts_path = root / "docs/system/workspace/hooks/protected-branch-merge-receipt-backfills.md"
text = receipts_path.read_text(encoding="utf-8")

effective_match = re.search(r"^- audit_effective_date:\s*`?([0-9]{4}-[0-9]{2}-[0-9]{2})`?\s*$", text, re.MULTILINE)
if not effective_match:
    print(f"[FAIL] {receipts_path.as_posix()} must declare - audit_effective_date: `YYYY-MM-DD`")
    sys.exit(1)

effective_date = effective_match.group(1)
effective_since = f"{effective_date} 00:00:00"
source_policy_match = re.search(r"^- source_policy_effective_date:\s*`?([0-9]{4}-[0-9]{2}-[0-9]{2})`?\s*$", text, re.MULTILINE)
source_policy_since = (
    f"{source_policy_match.group(1)} 00:00:00"
    if source_policy_match
    else None
)
starts = list(re.finditer(r"^##\s+Receipt Gap:\s+([0-9a-f]{7,40})\s*$", text, re.MULTILINE))

entries = {}
errors = []
observed = set()
reachable_protected_merge_commits = set()

def git_body(commit: str) -> str:
    try:
        return subprocess.check_output(
            ["git", "show", "--no-patch", "--format=%B", commit],
            cwd=root,
            text=True,
        )
    except subprocess.CalledProcessError:
        return ""

def has_absorbed_ancestry(absorbing_merge: str, ancestor: str) -> bool:
    try:
        absorbed_chain = set(
            subprocess.check_output(
                ["git", "rev-list", "--first-parent", f"{absorbing_merge}^2"],
                cwd=root,
                text=True,
            ).splitlines()
        )
    except subprocess.CalledProcessError:
        return False
    return ancestor in absorbed_chain

def merge_source_allowed(target_branch: str, source_branch: str) -> bool:
    if target_branch == "develop":
        return source_branch.startswith("test-pre-merge-") or source_branch.startswith("hotfix/")
    if target_branch == "main":
        return source_branch.startswith("release/") or source_branch.startswith("hotfix/")
    if target_branch.startswith("test-pre-merge-"):
        return (
            source_branch.startswith("feature/")
            or source_branch.startswith("hotfix/")
            or source_branch.startswith("feature/premerge-")
        )
    return True

for idx, match in enumerate(starts):
    commit = match.group(1)
    end = starts[idx + 1].start() if idx + 1 < len(starts) else len(text)
    block = text[match.start():end]

    def grab(name: str):
        m = re.search(rf"^\s*-\s*{re.escape(name)}:\s*(.+?)\s*$", block, re.MULTILINE)
        if not m:
            return None
        return m.group(1).strip().strip("`").strip()

    def grab_list(name: str):
        m = re.search(rf"^\s*-\s*{re.escape(name)}:\s*$([\s\S]*?)(?=^\s*-\s*[A-Za-z0-9_-]+:|^##\s+Receipt Gap:|\Z)", block, re.MULTILINE)
        if not m:
            return []
        values = []
        for raw in m.group(1).splitlines():
            item = re.match(r"^\s*-\s+(.+?)\s*$", raw)
            if item:
                values.append(item.group(1).strip().strip("`").strip())
        return values

    target_branch = grab("target_branch")
    source_branch = grab("source_branch")
    validation_mode = grab("validation_mode") or "subject_match"
    protected_batch_branch = grab("protected_batch_branch")
    absorbing_protected_merge = grab("absorbing_protected_merge")
    canonical_merge_path = grab("canonical_merge_path")
    canonical_bypass_mode = grab("canonical_bypass_mode")
    follow_on_owner = grab("follow_on_owner")
    bounded_issue = grab("bounded_issue")
    verification_ref = grab("verification_ref")
    evidence_refs = grab_list("evidence_refs")

    valid_target_branch = bool(
        re.match(
            r"^(develop|main|test-pre-merge-[A-Za-z0-9._/-]+|feature/[A-Za-z0-9._-]+|release/[A-Za-z0-9._-]+|hotfix/[A-Za-z0-9._-]+)$",
            target_branch or "",
        )
    )

    if not valid_target_branch:
        errors.append(f"[FAIL] {receipts_path.as_posix()} receipt gap {commit} has invalid target_branch '{target_branch}'.")
    if validation_mode not in {"subject_match", "unparseable_subject_ancestry"}:
        errors.append(
            f"[FAIL] {receipts_path.as_posix()} receipt gap {commit} has invalid validation_mode '{validation_mode}'."
        )
    if not source_branch:
        errors.append(f"[FAIL] {receipts_path.as_posix()} receipt gap {commit} is missing source_branch.")
    if canonical_merge_path not in {"merge-guarded", "merge-guarded-complete"}:
        errors.append(f"[FAIL] {receipts_path.as_posix()} receipt gap {commit} has invalid canonical_merge_path '{canonical_merge_path}'.")
    if canonical_bypass_mode != "forbidden":
        errors.append(f"[FAIL] {receipts_path.as_posix()} receipt gap {commit} must declare canonical_bypass_mode: `forbidden`.")
    if not follow_on_owner or not re.match(r"^I-[A-Za-z0-9-]+$", follow_on_owner):
        errors.append(f"[FAIL] {receipts_path.as_posix()} receipt gap {commit} is missing a valid follow_on_owner.")
    if not evidence_refs:
        errors.append(f"[FAIL] {receipts_path.as_posix()} receipt gap {commit} must list at least one evidence_ref.")
    if validation_mode == "unparseable_subject_ancestry":
        if not protected_batch_branch:
            errors.append(
                f"[FAIL] {receipts_path.as_posix()} receipt gap {commit} must declare protected_batch_branch for validation_mode unparseable_subject_ancestry."
            )
        if not absorbing_protected_merge or not re.match(r"^[0-9a-f]{7,40}$", absorbing_protected_merge or ""):
            errors.append(
                f"[FAIL] {receipts_path.as_posix()} receipt gap {commit} must declare a valid absorbing_protected_merge for validation_mode unparseable_subject_ancestry."
            )
        if protected_batch_branch and source_branch and protected_batch_branch != source_branch:
            errors.append(
                f"[FAIL] {receipts_path.as_posix()} receipt gap {commit} must keep source_branch aligned with protected_batch_branch for validation_mode unparseable_subject_ancestry."
            )
        if not bounded_issue:
            errors.append(
                f"[FAIL] {receipts_path.as_posix()} receipt gap {commit} must declare bounded_issue for validation_mode unparseable_subject_ancestry."
            )
        if not verification_ref:
            errors.append(
                f"[FAIL] {receipts_path.as_posix()} receipt gap {commit} must declare verification_ref for validation_mode unparseable_subject_ancestry."
            )

    entries[commit] = {
        "target_branch": target_branch,
        "source_branch": source_branch,
        "validation_mode": validation_mode,
        "protected_batch_branch": protected_batch_branch,
        "absorbing_protected_merge": absorbing_protected_merge,
        "canonical_merge_path": canonical_merge_path,
        "canonical_bypass_mode": canonical_bypass_mode,
        "bounded_issue": bounded_issue,
        "verification_ref": verification_ref,
    }

branches = ["develop"]
try:
    extra_refs = subprocess.check_output(
        ["git", "for-each-ref", "--format=%(refname:short)", "refs/heads/main", "refs/heads/test-pre-merge-*"],
        cwd=root,
        text=True,
    ).splitlines()
except subprocess.CalledProcessError:
    extra_refs = []

for ref in extra_refs:
    ref = ref.strip()
    if ref and ref not in branches:
        branches.append(ref)

for branch in branches:
    source_policy_commits = set()
    if source_policy_since:
        try:
            source_policy_commits = set(
                subprocess.check_output(
                    ["git", "log", branch, "--first-parent", "--merges", "--since", source_policy_since, "--format=%H"],
                    cwd=root,
                    text=True,
                ).splitlines()
            )
        except subprocess.CalledProcessError:
            source_policy_commits = set()
    try:
        merge_output = subprocess.check_output(
            ["git", "log", branch, "--merges", "--since", effective_since, "--format=%H%x00%B%x00"],
            cwd=root,
            text=True,
        )
    except subprocess.CalledProcessError:
        continue

    chunks = [chunk for chunk in merge_output.split("\x00") if chunk]
    for idx in range(0, len(chunks), 2):
        commit = chunks[idx].strip()
        body = chunks[idx + 1] if idx + 1 < len(chunks) else ""
        if not commit:
            continue
        reachable_protected_merge_commits.add(commit)
        subject = body.splitlines()[0].strip() if body else ""
        target_match = re.match(r"^Merge branch '.*' into (.+?)\s*$", subject)
        target_branch = target_match.group(1).strip() if target_match else ""
        if target_branch and target_branch != branch and commit not in entries:
            continue

        merge_path_match = re.search(r"^Freely-Merge-Path:\s*(.+?)\s*$", body, re.MULTILINE)
        bypass_mode_match = re.search(r"^Freely-Bypass-Mode:\s*(.+?)\s*$", body, re.MULTILINE)
        source_branch_match = re.search(r"^Freely-Source-Branch:\s*(.+?)\s*$", body, re.MULTILINE)

        merge_path = merge_path_match.group(1).strip() if merge_path_match else ""
        bypass_mode = bypass_mode_match.group(1).strip() if bypass_mode_match else ""
        source_branch = source_branch_match.group(1).strip() if source_branch_match else ""

        if merge_path == "merge-guarded-break-glass":
            errors.append(
                f"[FAIL] protected branch merge {commit} on {branch} uses deprecated 'merge-guarded-break-glass' path."
            )
            continue

        entry = entries.get(commit)
        if merge_path in {"merge-guarded", "merge-guarded-complete"}:
            if commit in source_policy_commits and not merge_source_allowed(branch, source_branch):
                errors.append(
                    f"[FAIL] protected branch merge {commit} on {branch} has invalid Freely-Source-Branch '{source_branch}'."
                )
            if entry:
                observed.add(commit)
                if commit in source_policy_commits and not merge_source_allowed(branch, entry.get("source_branch", "")):
                    errors.append(
                        f"[FAIL] {receipts_path.as_posix()} receipt gap {commit} has invalid source_branch '{entry.get('source_branch')}' for target '{branch}'."
                    )
                errors.append(
                    f"[FAIL] protected branch merge {commit} on {branch} already has canonical trailers and must not declare a receipt-gap backfill in {receipts_path.as_posix()}."
                )
            continue

        if not merge_path and not bypass_mode and not source_branch:
            subject_match = re.search(r"^Merge branch '([^']+)' into ([^\n]+)$", body, re.MULTILINE)
            if subject_match and subject_match.group(2).strip() != branch and not entry:
                continue
            if entry:
                validation_mode = entry.get("validation_mode", "subject_match")
                if validation_mode == "unparseable_subject_ancestry":
                    if entry.get("target_branch") != branch:
                        continue
                observed.add(commit)
                if commit in source_policy_commits and not merge_source_allowed(branch, entry.get("source_branch", "")):
                    errors.append(
                        f"[FAIL] {receipts_path.as_posix()} receipt gap {commit} has invalid source_branch '{entry.get('source_branch')}' for target '{branch}'."
                    )
                if validation_mode == "unparseable_subject_ancestry":
                    if subject_match:
                        errors.append(
                            f"[FAIL] protected branch merge {commit} on {branch} already has a parseable merge subject and must not use validation_mode unparseable_subject_ancestry."
                        )
                        continue
                    absorbing_commit = entry.get("absorbing_protected_merge", "")
                    absorbing_body = git_body(absorbing_commit)
                    absorbing_subject = absorbing_body.splitlines()[0].strip() if absorbing_body else ""
                    absorbing_target_match = re.match(r"^Merge branch '.*' into (.+?)\s*$", absorbing_subject)
                    absorbing_merge_path_match = re.search(r"^Freely-Merge-Path:\s*(.+?)\s*$", absorbing_body, re.MULTILINE)
                    absorbing_bypass_mode_match = re.search(r"^Freely-Bypass-Mode:\s*(.+?)\s*$", absorbing_body, re.MULTILINE)
                    absorbing_source_match = re.search(r"^Freely-Source-Branch:\s*(.+?)\s*$", absorbing_body, re.MULTILINE)
                    absorbing_target = absorbing_target_match.group(1).strip() if absorbing_target_match else ""
                    absorbing_merge_path = absorbing_merge_path_match.group(1).strip() if absorbing_merge_path_match else ""
                    absorbing_bypass_mode = absorbing_bypass_mode_match.group(1).strip() if absorbing_bypass_mode_match else ""
                    absorbing_source = absorbing_source_match.group(1).strip() if absorbing_source_match else ""
                    if not absorbing_target or absorbing_target != branch:
                        errors.append(
                            f"[FAIL] protected branch merge {commit} on {branch} has absorbing merge {absorbing_commit} with missing or mismatched protected target."
                        )
                        continue
                    if absorbing_merge_path not in {"merge-guarded", "merge-guarded-complete"} or absorbing_bypass_mode != "forbidden":
                        errors.append(
                            f"[FAIL] protected branch merge {commit} on {branch} has absorbing merge {absorbing_commit} without canonical protected merge trailers."
                        )
                        continue
                    if absorbing_source != entry.get("protected_batch_branch"):
                        errors.append(
                            f"[FAIL] protected branch merge {commit} on {branch} has absorbing merge {absorbing_commit} source branch '{absorbing_source}' that does not match protected_batch_branch '{entry.get('protected_batch_branch')}'."
                        )
                        continue
                    if not has_absorbed_ancestry(absorbing_commit, commit):
                        errors.append(
                            f"[FAIL] protected branch merge {commit} on {branch} is not present in the absorbed ancestry below {absorbing_commit}."
                        )
                        continue
                    continue
                if not subject_match:
                    errors.append(
                        f"[FAIL] protected branch merge {commit} on {branch} is missing canonical trailers and has no parseable merge subject for backfill validation."
                    )
                    continue
                subject_source = subject_match.group(1).strip()
                subject_target = subject_match.group(2).strip()
                if subject_source != entry.get("source_branch"):
                    errors.append(
                        f"[FAIL] protected branch merge {commit} on {branch} has backfill source_branch mismatch: subject='{subject_source}' ledger='{entry.get('source_branch')}'."
                    )
                if subject_target != entry.get("target_branch"):
                    errors.append(
                        f"[FAIL] protected branch merge {commit} has backfill target_branch mismatch: subject='{subject_target}' ledger='{entry.get('target_branch')}'."
                    )
                continue
            errors.append(
                f"[FAIL] protected branch merge {commit} on {branch} is missing canonical Freely merge trailers and has no matching receipt-gap backfill in {receipts_path.as_posix()}."
            )
            continue

        if entry:
            observed.add(commit)
            errors.append(
                f"[FAIL] protected branch merge {commit} on {branch} has partial or malformed merge trailers and cannot rely on receipt-gap backfill."
            )

for commit, entry in entries.items():
    if commit in observed or entry.get("validation_mode") != "unparseable_subject_ancestry":
        continue
    if entry.get("target_branch") in branches:
        continue

    body = git_body(commit)
    if not body:
        continue
    subject = body.splitlines()[0].strip() if body else ""
    if re.search(r"^Merge branch '([^']+)' into ([^\n]+)$", subject):
        errors.append(
            f"[FAIL] protected branch merge {commit} already has a parseable merge subject and must not use validation_mode unparseable_subject_ancestry."
        )
        continue

    merge_path_match = re.search(r"^Freely-Merge-Path:\s*(.+?)\s*$", body, re.MULTILINE)
    bypass_mode_match = re.search(r"^Freely-Bypass-Mode:\s*(.+?)\s*$", body, re.MULTILINE)
    source_branch_match = re.search(r"^Freely-Source-Branch:\s*(.+?)\s*$", body, re.MULTILINE)
    if any(match and match.group(1).strip() for match in (merge_path_match, bypass_mode_match, source_branch_match)):
        errors.append(
            f"[FAIL] protected branch merge {commit} already carries canonical merge trailers and must not use validation_mode unparseable_subject_ancestry."
        )
        continue

    absorbing_commit = entry.get("absorbing_protected_merge", "")
    absorbing_body = git_body(absorbing_commit)
    absorbing_subject = absorbing_body.splitlines()[0].strip() if absorbing_body else ""
    absorbing_target_match = re.match(r"^Merge branch '.*' into (.+?)\s*$", absorbing_subject)
    absorbing_merge_path_match = re.search(r"^Freely-Merge-Path:\s*(.+?)\s*$", absorbing_body, re.MULTILINE)
    absorbing_bypass_mode_match = re.search(r"^Freely-Bypass-Mode:\s*(.+?)\s*$", absorbing_body, re.MULTILINE)
    absorbing_source_match = re.search(r"^Freely-Source-Branch:\s*(.+?)\s*$", absorbing_body, re.MULTILINE)
    absorbing_target = absorbing_target_match.group(1).strip() if absorbing_target_match else ""
    absorbing_merge_path = absorbing_merge_path_match.group(1).strip() if absorbing_merge_path_match else ""
    absorbing_bypass_mode = absorbing_bypass_mode_match.group(1).strip() if absorbing_bypass_mode_match else ""
    absorbing_source = absorbing_source_match.group(1).strip() if absorbing_source_match else ""
    if absorbing_commit not in reachable_protected_merge_commits:
        errors.append(
            f"[FAIL] protected branch merge {commit} references absorbing merge {absorbing_commit} that is not reachable from current protected-branch ancestry since {effective_since}."
        )
        continue
    if not absorbing_target or absorbing_target != entry.get("target_branch"):
        errors.append(
            f"[FAIL] protected branch merge {commit} has absorbing merge {absorbing_commit} with missing or mismatched protected target."
        )
        continue
    if absorbing_merge_path not in {"merge-guarded", "merge-guarded-complete"} or absorbing_bypass_mode != "forbidden":
        errors.append(
            f"[FAIL] protected branch merge {commit} on retired target {entry.get('target_branch')} has absorbing merge {absorbing_commit} without canonical protected merge trailers."
        )
        continue
    if absorbing_source != entry.get("protected_batch_branch"):
        errors.append(
            f"[FAIL] protected branch merge {commit} on retired target {entry.get('target_branch')} has absorbing merge {absorbing_commit} source branch '{absorbing_source}' that does not match protected_batch_branch '{entry.get('protected_batch_branch')}'."
        )
        continue
    if not has_absorbed_ancestry(absorbing_commit, commit):
        errors.append(
            f"[FAIL] protected branch merge {commit} is not present in the absorbed ancestry below {absorbing_commit}."
        )
        continue
    observed.add(commit)

for commit, entry in entries.items():
    if commit not in observed:
        errors.append(
            f"[FAIL] {receipts_path.as_posix()} receipt gap {commit} does not match any trailerless merge commit reachable from protected-branch ancestry since {effective_since}."
        )

if errors:
    print("\n".join(errors))
    sys.exit(1)
PY
}

