#!/usr/bin/env bash
set -euo pipefail

PROJECT="$(pwd -P)"
WORKTREE_PATH=""
RUNTIME_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." && pwd -P)"

usage() {
  cat <<'EOF'
Usage:
  pretests-retirement-gate --project <abs_path> --worktree-path <abs_path>

Purpose:
  - consume recorded worker verification metadata during cleanup/retirement
  - resolve the canonical owner issue bound to the worktree
  - reuse pretests-gate before a merged clean worktree is retired
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) PROJECT="$2"; shift 2 ;;
    --worktree-path) WORKTREE_PATH="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *)
      echo "unknown arg: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

[[ -d "$PROJECT" ]] || { echo "project not found: $PROJECT" >&2; exit 1; }
[[ -n "$WORKTREE_PATH" ]] || { echo "missing --worktree-path" >&2; exit 1; }
[[ -d "$WORKTREE_PATH" ]] || { echo "worktree not found: $WORKTREE_PATH" >&2; exit 1; }

python3 - "$PROJECT" "$WORKTREE_PATH" "$RUNTIME_ROOT" <<'PY'
import re
import subprocess
import sys
from pathlib import Path

project = Path(sys.argv[1]).resolve()
worktree = Path(sys.argv[2]).resolve()
runtime_root = Path(sys.argv[3]).resolve()
state_file = worktree / ".freely" / "run" / "workcell-state.env"
gate_file = worktree / ".freely" / "run" / "test-gate.env"
pretests_gate = project / "bin" / "pretests-gate"
if not pretests_gate.exists():
    pretests_gate = runtime_root / "bin" / "pretests-gate"


def parse_env(path: Path) -> dict[str, str]:
    data: dict[str, str] = {}
    if not path.exists():
        return data
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or "=" not in line:
            continue
        key, value = line.split("=", 1)
        data[key] = value.strip().strip('"')
    return data


def resolve_issue_path(issue_ref: str) -> tuple[str, str]:
    if not issue_ref:
        return "", "missing"
    issue_root = project / "docs" / "epics"
    if not issue_root.exists():
        return "", "missing_issue_root"
    candidate_path = project / issue_ref
    if issue_ref.startswith("docs/epics/") and candidate_path.exists():
        return issue_ref, ""
    pattern = re.compile(rf"^- issue_id:\s*`?{re.escape(issue_ref)}`?\s*$", re.MULTILINE)
    matches: list[str] = []
    for issue_file in issue_root.glob("**/issues/*.md"):
        try:
            text = issue_file.read_text()
        except OSError:
            continue
        if pattern.search(text):
            matches.append(issue_file.relative_to(project).as_posix())
    if not matches:
        return "", "missing"
    if len(matches) > 1:
        return "", "ambiguous:" + ",".join(sorted(matches))
    return matches[0], ""


env = parse_env(state_file)
gate_env = parse_env(gate_file)

# test-gate.env fields (only exist in test worktrees)
_test_status = gate_env.get("TEST_STATUS", "")
_last_tested_commit = gate_env.get("LAST_TESTED_COMMIT", "")
_last_tested_at = gate_env.get("LAST_TESTED_AT", "")

# Closeout context is now read from worker-verification-contract.env
# (the authoritative source). See closeout check block below.
owner_issue = ""
recorded_pre_tests = ""

if not pretests_gate.exists():
    print(f"[pretests_retirement_missing] missing gate: {pretests_gate}", file=sys.stderr)
    sys.exit(1)
if not gate_file.exists():
    print(f"[pretests_not_tested] 测试工位还没有运行过 daemon", file=sys.stderr)
    print(f"  文件: {gate_file}", file=sys.stderr)
    print(f"", file=sys.stderr)
    print(f"  请在测试工位运行 daemon 完成测试:", file=sys.stderr)
    print(f"    cd {worktree}", file=sys.stderr)
    print(f"    ./bin/freely daemon start --task-mode auto", file=sys.stderr)
    print(f"  详见 skill `freely-test-execution`", file=sys.stderr)
    sys.exit(1)

# ── Test-gate freshness check ──
# Compare test-gate.env's LAST_TESTED_COMMIT against HEAD.
# If HEAD is ahead, tests are stale and must be re-run.

_latest_commit = ""
try:
    _latest_commit = _sp.check_output(
        ["git", "-C", str(worktree), "rev-parse", "HEAD"],
        text=True, stderr=_sp.DEVNULL
    ).strip()
except Exception:
    pass

if _test_status == "not_tested" or not _last_tested_at or _last_tested_at == "1970-01-01T00:00:00Z":
    print(f"[pretests_not_tested] 测试工位还没有运行过 daemon", file=sys.stderr)
    print(f"  文件: {gate_file}", file=sys.stderr)
    print(f"  TEST_STATUS = {_test_status or '<empty>'}", file=sys.stderr)
    print(f"", file=sys.stderr)
    print(f"  请先在测试工位运行 daemon 完成测试:", file=sys.stderr)
    print(f"    cd {worktree}", file=sys.stderr)
    print(f"    ./bin/freely daemon start --task-mode auto", file=sys.stderr)
    print(f"  详见 skill `freely-test-execution`", file=sys.stderr)
    sys.exit(1)

if _latest_commit and _last_tested_commit and _latest_commit != _last_tested_commit:
    print(f"[pretests_stale] 测试工位有新提交但未重新跑测试", file=sys.stderr)
    print(f"  文件: {gate_file}", file=sys.stderr)
    print(f"  当前 HEAD:  {_latest_commit[:12]}", file=sys.stderr)
    print(f"  上次测试时: {_last_tested_commit[:12] if _last_tested_commit else '<empty>'}", file=sys.stderr)
    print(f"  上次测试时间: {_last_tested_at}", file=sys.stderr)
    print(f"", file=sys.stderr)
    print(f"  测试工位在 merge 新代码后未重新运行 daemon。", file=sys.stderr)
    print(f"  请检查新的修改是否需要跑测试——", file=sys.stderr)
    print(f"  如果需要:", file=sys.stderr)
    print(f"    cd {worktree}", file=sys.stderr)
    print(f"    ./bin/freely daemon start --task-mode auto", file=sys.stderr)
    print(f"    按照 pre-tests.md 中的测试用例逐条执行验证。", file=sys.stderr)
    print(f"  详见 skill `freely-test-execution`", file=sys.stderr)
    sys.exit(1)

# Tests are current — test-gate commit matches HEAD.
# Closeout context is read from worker-verification-contract.env
# (the authoritative source written by the manager on worker launch).
# If the contract file doesn't exist (manager role, test-pre-merge daemon),
# closeout checks are skipped — they only apply to worker retirement.
_contract_file = worktree / ".freely" / "run" / "worker-verification-contract.env"
_contract_env = parse_env(_contract_file) if _contract_file.exists() else {}

_contract_closeout_gate = _contract_env.get("CLOSEOUT_GATE", "")
_contract_closeout_gate_command = _contract_env.get("CLOSEOUT_GATE_COMMAND", "")
_contract_closeout_target_lane = _contract_env.get("CLOSEOUT_TARGET_LANE", "")
_contract_closeout_promotion_gate = _contract_env.get("CLOSEOUT_PROMOTION_GATE", "")
_contract_closeout_requires_adequacy = _contract_env.get("CLOSEOUT_REQUIRES_ADEQUACY", "").lower()
_contract_closeout_review_artifact_policy = _contract_env.get("CLOSEOUT_REVIEW_ARTIFACT_POLICY", "")
_contract_owner_issue = _contract_env.get("OWNER_ISSUE", "")
_contract_pre_tests_path = _contract_env.get("PRE_TESTS_PATH", "")

# Only enforce closeout checks when the contract file actually exists
# (worker worktrees launched by the manager). Manager/test worktrees
# won't have this file, and that's expected.
if _contract_file.exists():
    missing_closeout_fields: list[str] = []
    if not _contract_closeout_gate_command:
        missing_closeout_fields.append("closeout_gate_command")
    if not _contract_closeout_requires_adequacy:
        missing_closeout_fields.append("closeout_requires_adequacy")
    if not _contract_closeout_review_artifact_policy:
        missing_closeout_fields.append("closeout_review_artifact_policy")

    require_adequacy = _contract_closeout_requires_adequacy == "true"
    if _contract_closeout_requires_adequacy not in ("true", "false", ""):
        missing_closeout_fields.append("closeout_requires_adequacy")
    if require_adequacy and not _contract_closeout_target_lane:
        missing_closeout_fields.append("closeout_target_lane")
    if require_adequacy and not _contract_closeout_promotion_gate:
        missing_closeout_fields.append("closeout_promotion_gate")

    if missing_closeout_fields:
        print(
            "[pretests_retirement_closeout_context_missing] worker verification contract 缺少 closeout 字段: "
            + ", ".join(missing_closeout_fields),
            file=sys.stderr,
        )
        print(f"  文件: {_contract_file}", file=sys.stderr)
        print(f"  补充缺失字段，详见 skill `freely-doc-B2_IBM-execution`", file=sys.stderr)
        sys.exit(1)

    # Use contract values for issue resolution below
    owner_issue = _contract_owner_issue
    recorded_pre_tests = _contract_pre_tests_path

issue_path, issue_error = resolve_issue_path(owner_issue)
if not issue_path:
    if issue_error.startswith("ambiguous:"):
        print(
            f"[pretests_retirement_issue_ambiguous] owner issue {owner_issue} matched multiple issue docs: {issue_error.split(':', 1)[1]}",
            file=sys.stderr,
        )
    else:
        print(f"[pretests_retirement_issue_missing] 无法解析 owner issue {owner_issue} 的文件路径", file=sys.stderr)
        print(f"  I-* issue 唯一正确位置: docs/epics/{{epic-name}}/{{story-name}}/raw-{{raw key}}/issues/{owner_issue}.md", file=sys.stderr)
        print(f"  文件不存在 → 按 skill `freely-doc-B2_IBM-execution` 创建 I-* issue", file=sys.stderr)
    sys.exit(1)

cmd = [str(pretests_gate), "--project", str(project), "--issue", issue_path]
if require_adequacy:
    cmd.append("--require-adequacy")
    cmd.extend(["--target-lane", closeout_target_lane, "--promotion-gate", closeout_promotion_gate])

result = subprocess.run(cmd, text=True, capture_output=True)
if result.returncode == 0:
    sys.exit(0)

combined_output = f"{result.stdout}\n{result.stderr}"
if require_adequacy:
    unsupported_markers = (
        "unknown arg: --require-adequacy",
        "unrecognized arguments: --require-adequacy",
        "unsupported option --require-adequacy",
    )
    if any(marker in combined_output for marker in unsupported_markers):
        print(
            f"[pretests_retirement_adequacy_unsupported] recorded closeout gate requires --require-adequacy but {pretests_gate} does not support it",
            file=sys.stderr,
        )
        sys.exit(1)

for line in combined_output.splitlines():
    line = line.strip()
    if not line:
        continue
    if line.startswith("[pretests-gate]"):
        continue
    print(line, file=sys.stderr)
sys.exit(result.returncode)
PY
