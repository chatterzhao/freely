def relative_path(path: str) -> str:
    return os.path.relpath(path, ROOT_DIR)


def is_test_premerge_branch(branch: Optional[str]) -> bool:
    return bool(branch) and branch.startswith("test-pre-merge-")


def staged_path_exists(rel_path: Optional[str]) -> bool:
    if not rel_path:
        return False
    result = subprocess.run(
        ["git", "cat-file", "-e", f":{rel_path}"],
        cwd=ROOT_DIR,
        text=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def range_path_exists(rel_path: Optional[str]) -> bool:
    if not rel_path or not RANGE_SOURCE_REF:
        return False
    result = subprocess.run(
        ["git", "cat-file", "-e", f"{RANGE_SOURCE_REF}:{rel_path}"],
        cwd=ROOT_DIR,
        text=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def read_repo_text(rel_path: str) -> str:
    full_path = os.path.join(ROOT_DIR, rel_path)
    if USE_STAGED_VIEW and staged_path_exists(rel_path):
        return git("show", f":{rel_path}")
    # Range view must take priority over disk read:
    # When validating a feature→test-pre-merge merge from the target worktree,
    # the files exist in the source branch (git) but not on disk.
    if USE_RANGE_VIEW and RANGE_SOURCE_REF and range_path_exists(rel_path):
        return git("show", f"{RANGE_SOURCE_REF}:{rel_path}")
    if os.path.isfile(full_path):
        with open(full_path, "r", encoding="utf-8") as handle:
            return handle.read()
    raise FileNotFoundError(f"cannot read {rel_path}: not on disk, not in staged view, not in range view")


def path_exists(rel_path: Optional[str]) -> bool:
    return bool(rel_path) and (
        os.path.isfile(os.path.join(ROOT_DIR, rel_path))
        or (USE_STAGED_VIEW and staged_path_exists(rel_path))
        or (USE_RANGE_VIEW and range_path_exists(rel_path))
    )


def verification_artifact_dir_is_scoped(rel_path: str) -> bool:
    parts = [part for part in normalize_scalar(rel_path).split("/") if part]
    if len(parts) < 4:
        return False
    if parts[0] != "docs" or parts[1] != "epics":
        return False
    if parts[-1] != "code-reviews":
        return False
    return True


