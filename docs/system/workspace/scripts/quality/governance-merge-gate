def is_governance_only_path(rel_path: str) -> bool:
    """Paths where FREELY_SKIP_IBM_GATE=1 is allowed.

    Per LAWS.md §3: only docs/cleanup/format changes that structurally
    do not require IBM lifecycle evidence. This means governance process
    artifacts (pre-brainstorms, epics, progress, issues, milestones,
    agent/skill definitions) and meta-governance quality scripts.

    Deliberately EXCLUDED (require full IBM lifecycle):
      - docs/system/workspace/hooks/          (runtime enforcement code)
      - docs/system/workspace/scripts/runtime/ (daemon, bridge, launchers)
      - docs/system/workspace/scripts/worktree/ (wt-close, pr-merge, etc.)
      - docs/system/workspace/scripts/tests/    (test code)
    """
    if rel_path in {
        "AGENTS.md",
        "docs/CONSTITUTION.md",
        "docs/LAWS.md",
        "docs/PROJECT_INTENT.md",
        "docs/milestones.md",
        "docs/system/workspace/ibm-framework.md",
        "docs/system/workspace/three-loop-capability-lifecycle.md",
        "docs/system/workspace/scan-lifecycle-design.md",
    }:
        return True
    if rel_path.startswith(("docs/pre-brainstorms/", "docs/epics/", "docs/progress/", "docs/issues/")):
        return True
    if rel_path.startswith(("docs/system/workspace/agents/", "docs/system/workspace/skills/")):
        return True
    # Meta-governance quality scripts (governance-merge-gate itself)
    if rel_path.startswith("docs/system/workspace/scripts/quality/"):
        return True
    return False


_CODE_EXTS = {".sh", ".py", ".rs", ".ts", ".js", ".tsx", ".jsx", ".go", ".java", ".c", ".cpp", ".h", ".toml"}
_CODE_INTERPRETERS = ("python", "bash", "sh", "node", "deno", "bun")


def _is_code_file(rel_path: str) -> bool:
    """Check if a file is implementation code by extension or shebang."""
    if os.path.splitext(rel_path)[1] in _CODE_EXTS:
        return True
    # No extension: check shebang for script interpreter
    if os.path.splitext(rel_path)[1] == "":
        try:
            with open(rel_path, "rb") as f:
                head = f.read(128).decode("utf-8", errors="ignore")
            if head.startswith("#!"):
                for interp in _CODE_INTERPRETERS:
                    if interp in head[:128]:
                        return True
        except (OSError, UnicodeDecodeError):
            pass
    return False


def is_implementation_bearing_path(rel_path: str) -> bool:
    if rel_path in IMPLEMENTATION_PATH_FILES:
        return True
    return rel_path.startswith(IMPLEMENTATION_PATH_PREFIXES)


def _fail_no_common_ancestor(base: str, head: str) -> None:
    """Block the push — git merge-base found no common ancestor (history rewritten)."""
    print(f"""
╔══════════════════════════════════════════════════════════════╗
║  [GOVERNANCE-GATE] 无法验证 — 找不到共同祖先                 ║
╠══════════════════════════════════════════════════════════════╣
║  git merge-base 返回空 → 提交历史被重写过。                  ║
║  门禁无法验证中间 commit 的治理合规性，必须阻塞。             ║
║                                                              ║
║  常见原因: git filter-branch / rebase 重写了 develop 历史     ║
║                                                              ║
║  修复: 确认重写后的 phase_state 正确 → 一次性对齐:            ║
║    git push <remote> develop --force-with-lease               ║
║  之后恢复使用 pr-merge-guarded（不再 force push）             ║
╚══════════════════════════════════════════════════════════════╝
""", file=sys.stderr)
    sys.exit(1)


def changed_paths_from_args(args: argparse.Namespace) -> List[str]:
    if args.staged:
        output = git("diff", "--cached", "--name-only", "--diff-filter=ACMR")
    elif args.range:
        try:
            output = git("diff", "--name-only", "--diff-filter=ACMR", args.range)
        except subprocess.CalledProcessError:
            range_parts = args.range.split("..", 1)
            if len(range_parts) == 2 and range_parts[0] and range_parts[1]:
                base = range_parts[0].strip()
                head = range_parts[1].strip()
                try:
                    merge_base = git("merge-base", base, head).strip()
                    if not merge_base:
                        _fail_no_common_ancestor(base, head)
                    output = git("diff", "--name-only", "--diff-filter=ACMR", f"{merge_base}..{head}")
                except subprocess.CalledProcessError:
                    _fail_no_common_ancestor(base, head)
            else:
                raise
    else:
        raise SystemExit("governance-merge-gate requires --staged or --range")
    return [line.strip() for line in output.splitlines() if line.strip()]


def changed_line_numbers(rel_path: str, args: argparse.Namespace) -> Set[int]:
    if args.staged:
        output = git("diff", "--cached", "--unified=0", "--", rel_path)
    elif args.range:
        output = git("diff", "--unified=0", args.range, "--", rel_path)
    else:
        return set()

    changed: Set[int] = set()
    for line in output.splitlines():
        match = re.match(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@", line)
        if not match:
            continue
        start = int(match.group(1))
        length = int(match.group(2) or "1")
        if length <= 0:
            continue
        changed.update(range(start, start + length))
    return changed


def parse_candidate_file(rel_path: str) -> List[CandidateRecord]:
    lines = read_repo_text(rel_path).splitlines(keepends=True)

    starts = []
    for idx, line in enumerate(lines):
        heading = re.match(r"^#{1,3}\s+(C-[A-Za-z0-9-]+)", line.strip())
        if heading:
            starts.append((idx, heading.group(1)))
            continue
        inline = re.match(r"^\s*-\s*(candidate_id|id):\s*`?(C-[A-Za-z0-9-]+)`?\s*$", line)
        if inline:
            starts.append((idx, inline.group(2)))

    records: List[CandidateRecord] = []
    if not starts:
        return records

    for pos, (start_idx, candidate_id_value) in enumerate(starts):
        end_idx = starts[pos + 1][0] if pos + 1 < len(starts) else len(lines)
        block = "".join(lines[start_idx:end_idx])

        def grab(name: str) -> Optional[str]:
            # 支持两种格式：
            # 1. "- field: value" (Markdown 标题格式)
            # 2. "  field: value" (YAML 列表格式，缩进)
            match = re.search(rf"^\s*(?:-\s*)?{re.escape(name)}:\s*(.+?)\s*$", block, re.MULTILINE)
            return normalize_scalar(match.group(1)) if match else None

        records.append(
            CandidateRecord(
                path=rel_path,
                candidate_id=candidate_id_value,
                start_line=start_idx + 1,
                end_line=end_idx,
                status=grab("status"),
                milestone=normalize_milestone(grab("milestone")),
                promoted_issue_path=grab("promoted_issue_path"),
                promoted_issue_id=grab("promoted_issue_id"),
                decision_reason=grab("decision_reason"),
                next_action=grab("next_action"),
                revisit_trigger=grab("revisit_trigger"),
                legacy_id_mapping=grab("legacy_id_mapping"),
            )
        )
    return records


def parse_issue_file(rel_path: str) -> IssueRecord:
    text = read_repo_text(rel_path)

    def grab(name: str) -> Optional[str]:
        # Try bullet format: "- key: value" (canonical I-* issues, top-level bullet)
        match = re.search(rf"^\s*-\s*{re.escape(name)}:\s*(.+?)\s*$", text, re.MULTILINE)
        if match:
            return normalize_scalar(match.group(1))
        # Try YAML format: "key: value" at line start (raw-* and linked I-* issues).
        # Must be top-level (no leading whitespace) to avoid matching
        # nested fields like platform_ids.github.issue_id.
        match = re.search(rf"^{re.escape(name)}:\s*(.+?)\s*$", text, re.MULTILINE)
        return normalize_scalar(match.group(1)) if match else None

    issue_id = grab("issue_id") or grab("local_id")
    phase_state = grab("phase_state")
    milestone = normalize_milestone(grab("milestone"))
    source_candidate = grab("source_candidate")
    verification_artifact_dir = grab("verification_artifact_dir")

    # Linked I-* issues in docs/issues/ point to canonical I-* in docs/epics/.
    # Follow canonical_issue_path to read authoritative governance fields.
    if rel_path.startswith("docs/issues/I-"):
        canonical = grab("canonical_issue_path")
        if canonical and path_exists(canonical):
            try:
                canonical_text = read_repo_text(canonical)
                def cgrab(name: str) -> Optional[str]:
                    # bullet format: "- key: value" (canonical I-* issues)
                    m = re.search(rf"^\s*-\s*{re.escape(name)}:\s*(.+?)\s*$", canonical_text, re.MULTILINE)
                    if m:
                        return normalize_scalar(m.group(1))
                    # YAML format: "key: value" at line start (raw-* and linked I-*)
                    m = re.search(rf"^{re.escape(name)}:\s*(.+?)\s*$", canonical_text, re.MULTILINE)
                    return normalize_scalar(m.group(1)) if m else None
                # Canonical fields override linked fields (which may be absent or stale)
                phase_state = cgrab("phase_state") or phase_state
                milestone = normalize_milestone(cgrab("milestone")) or milestone
                source_candidate = cgrab("source_candidate") or source_candidate
                verification_artifact_dir = cgrab("verification_artifact_dir") or verification_artifact_dir
            except Exception:
                pass  # canonical unreachable, use linked fields as-is

    return IssueRecord(
        path=rel_path,
        issue_id=issue_id,
        phase_state=phase_state,
        milestone=milestone,
        source_candidate=source_candidate,
        verification_artifact_dir=verification_artifact_dir,
    )


def parse_progress_file(rel_path: str) -> ProgressRecord:
    text = read_repo_text(rel_path)

    def grab(name: str) -> Optional[str]:
        match = re.search(rf"^\s*-\s*{re.escape(name)}:\s*(.+?)\s*$", text, re.MULTILINE)
        return normalize_scalar(match.group(1)) if match else None

    return ProgressRecord(
        path=rel_path,
        issue_id=grab("issue_id"),
        issue_path=grab("issue_path"),
    )


def parse_review_file(rel_path: str) -> ReviewRecord:
    text = read_repo_text(rel_path)

    def grab(name: str) -> Optional[str]:
        match = re.search(rf"^\s*-\s*{re.escape(name)}:\s*(.+?)\s*$", text, re.MULTILINE)
        return normalize_scalar(match.group(1)) if match else None

    issue_id = grab("issue_id")
    issue_path = grab("issue_path")
    decision_note_fields: Set[str] = set()
    section_match = re.search(
        r"^##\s+Implementation Decision Note\s*$([\s\S]*?)(?=^##\s+|\Z)",
        text,
        re.MULTILINE,
    )
    if section_match:
        section = section_match.group(1)
        for field_name in IMPLEMENTATION_DECISION_NOTE_FIELDS:
            if re.search(rf"^\s*-\s*{re.escape(field_name)}:\s*(.+?)\s*$", section, re.MULTILINE):
                decision_note_fields.add(field_name)

    if not decision_note_fields:
        for field_name in IMPLEMENTATION_DECISION_NOTE_FIELDS:
            legacy_section = re.search(
                rf"^##\s+{re.escape(field_name)}\s*$([\s\S]*?)(?=^##\s+|\Z)",
                text,
                re.MULTILINE,
            )
            if legacy_section and legacy_section.group(1).strip():
                decision_note_fields.add(field_name)

    return ReviewRecord(
        path=rel_path,
        issue_id=issue_id,
        issue_path=issue_path,
        decision_note_fields=decision_note_fields,
    )


def parse_milestones() -> List[MilestoneEntry]:
    lines = read_repo_text("docs/milestones.md").splitlines(keepends=True)

    entries: List[MilestoneEntry] = []
    current_milestone = None
    current_milestone_status = None
    current_queue = None
    current_item: Optional[MilestoneEntry] = None
    current_list_field = None

    for raw_line in lines:
        line = raw_line.rstrip("\n")
        heading = re.match(r"^##\s+(M-[A-Za-z0-9-]+)\s*$", line.strip())
        if heading:
            current_milestone = heading.group(1)
            current_milestone_status = None
            current_queue = None
            current_item = None
            current_list_field = None
            continue

        milestone_status = re.match(r"^-\s*status:\s*(.+?)\s*$", line.strip())
        if milestone_status and current_milestone and not current_queue and not current_item:
            current_milestone_status = normalize_scalar(milestone_status.group(1))
            continue

        queue = re.match(r"^###\s+(candidate_issues|committed_issues|completed_issues)\s*$", line.strip())
        if queue:
            current_queue = queue.group(1)
            current_item = None
            current_list_field = None
            continue

        item = re.match(r"^\d+\.\s+`([^`]+)`\s*$", line.strip())
        if item and current_milestone and current_queue:
            current_item = MilestoneEntry(
                milestone_id=current_milestone,
                milestone_status=current_milestone_status,
                queue=current_queue,
                item_id=item.group(1),
            )
            entries.append(current_item)
            current_list_field = None
            continue

        if not current_item:
            continue

        issue_path = re.match(r"^\s*-\s*issue_path:\s*(.+?)\s*$", line)
        if issue_path:
            current_item.issue_path = normalize_scalar(issue_path.group(1))
            current_list_field = None
            continue

        source_candidates = re.match(r"^\s*-\s*source_candidates:\s*(.*)$", line)
        if source_candidates:
            current_item.source_candidates.extend(extract_inline_refs(source_candidates.group(1)))
            current_list_field = "source_candidates"
            continue

        if current_list_field == "source_candidates":
            list_item = re.match(r"^\s*-\s+(.+?)\s*$", line)
            if list_item:
                current_item.source_candidates.extend(extract_inline_refs(list_item.group(1)))
                continue
            if line.strip():
                current_list_field = None

    return entries


def anchorless_source_candidate(source_candidate: Optional[str]) -> Optional[str]:
    if not source_candidate:
        return None
    return source_candidate.split("#", 1)[0]


def build_issue_index() -> Dict[str, IssueRecord]:
    # Canonical issue files in epics/
    try:
        output = git("ls-files", "docs/epics/**/issues/*.md")
        paths = [line.strip() for line in output.splitlines() if line.strip()]
    except Exception:
        paths = []
    # Scan docs/issues/ for raw-* and I-* linked issue files.
    # When validating a range (pr-review-guarded from outside the worktree),
    # discover files from the source ref via git ls-tree so we find new
    # I-* and raw-* that only exist in the fix branch.
    if USE_RANGE_VIEW and RANGE_SOURCE_REF:
        try:
            # ls-tree from docs/issues/ subtree returns paths relative to that dir
            # (e.g. "raw-20260620T142838Z/issue.md"). Prepend docs/issues/ prefix.
            output = git("ls-tree", "--name-only", "-r", f"{RANGE_SOURCE_REF}:docs/issues/")
            for line in output.splitlines():
                line = line.strip()
                if not line:
                    continue
                if line.endswith("/issue.md") and not line.startswith(".scan"):
                    full_path = f"docs/issues/{line}"
                    if full_path not in paths:
                        paths.append(full_path)
        except Exception:
            pass
    # Fallback: filesystem scan at ROOT_DIR (works when running from the
    # worktree that actually has the files on disk).
    if not USE_RANGE_VIEW or not RANGE_SOURCE_REF:
        issues_dir = os.path.join(ROOT_DIR, "docs", "issues")
        if os.path.isdir(issues_dir):
            for d in sorted(os.listdir(issues_dir)):
                if d.startswith("raw-") or d.startswith("I-"):
                    mf = os.path.join(issues_dir, d, "issue.md")
                    if os.path.isfile(mf):
                        rel = os.path.relpath(mf, ROOT_DIR)
                        if rel not in paths:
                            paths.append(rel)
    result: Dict[str, IssueRecord] = {}
    for path in paths:
        result[path] = parse_issue_file(path)
    return result


def build_issue_id_index(issues_index: Dict[str, IssueRecord]) -> Dict[str, IssueRecord]:
    result: Dict[str, IssueRecord] = {}
    for issue in issues_index.values():
        if issue.issue_id:
            result[issue.issue_id] = issue
    return result


def resolve_source_candidate_record(
    issue: Optional[IssueRecord], candidate_records_by_path: Dict[str, List[CandidateRecord]]
) -> Optional[CandidateRecord]:
    if not issue or not issue.source_candidate:
        return None

    source_candidate_path = anchorless_source_candidate(issue.source_candidate)
    if not source_candidate_path:
        return None

    source_candidates = candidate_records_by_path.get(source_candidate_path, [])
    if not source_candidates:
        return None

    issue_anchor = issue.source_candidate.split("#", 1)[1].lower() if "#" in issue.source_candidate else None
    for candidate in source_candidates:
        if issue_anchor and candidate.candidate_id.lower() == issue_anchor:
            return candidate

    return source_candidates[0]


def resolve_review_owner_issue(
    review: ReviewRecord,
    issues_by_id: Dict[str, IssueRecord],
    issues_index: Dict[str, IssueRecord],
) -> Optional[IssueRecord]:
    if review.issue_id:
        return issues_by_id.get(review.issue_id)
    if review.issue_path:
        return issues_index.get(review.issue_path)
    return None


def candidate_has_canonical_owner_line(
    candidate: CandidateRecord,
    issues_index: Dict[str, IssueRecord],
    milestone_by_issue_path: Dict[str, List[MilestoneEntry]],
) -> bool:
    owner_path = normalize_scalar(candidate.promoted_issue_path or "")
    if not owner_path or owner_path.startswith("pending://"):
        return False

    issue_record = issues_index.get(owner_path)
    if not issue_record:
        return False

    candidate_source = anchorless_source_candidate(issue_record.source_candidate)
    if candidate_source != candidate.path:
        return False

    if not issue_matches_candidate_identity(
        issue_record.issue_id,
        candidate.candidate_id,
        candidate.legacy_id_mapping,
    ):
        return False

    return bool(milestone_by_issue_path.get(owner_path))


VALID_RAW_PHASES = {"proposed", "absorbed", "dropped"}


def _validate_raw_issue(issue: IssueRecord, changed_paths: list = None) -> list[str]:
    """Validate a raw-* issue meets B1 entry-point requirements.

    Checks:
      1. local_id must exist (raw identity)
      2. phase_state must be in {proposed, absorbed, dropped} (B1 phases)
      3. If absorbed, absorbed_into must point to an existing target
    """
    errors = []
    iid = issue.issue_id or issue.path

    # 1. local_id sanity
    if not issue.issue_id or not issue.issue_id.startswith("raw-"):
        errors.append(
            f"{iid} in {issue.path}: raw issues must have a local_id starting with 'raw-'."
        )

    # 2. Valid B1 phase
    phase = (issue.phase_state or "").strip("`").strip()
    if phase not in VALID_RAW_PHASES:
        errors.append(
            f"{iid} in {issue.path}: raw issue phase_state '{phase}' is invalid for B1. "
            f"Valid B1 phases: {', '.join(sorted(VALID_RAW_PHASES))}."
        )

    # 3. Absorbed chain
    if phase == "absorbed":
        # Read the raw issue file to find absorbed_into
        text = read_repo_text(issue.path)
        match = re.search(r"^\s*absorbed_into:\s*(.+?)\s*$", text, re.MULTILINE)
        if not match:
            # Try YAML format without leading hyphen
            match = re.search(r"^absorbed_into:\s*(.+?)\s*$", text, re.MULTILINE)
        if match:
            target_id = match.group(1).strip("`").strip('"').strip("'")
            target_dir = os.path.join(ROOT_DIR, "docs", "issues", target_id)
            if not os.path.isdir(target_dir) or not os.path.isfile(os.path.join(target_dir, "issue.md")):
                errors.append(
                    f"{iid} in {issue.path}: absorbed_into '{target_id}' but target issue does not exist at docs/issues/{target_id}/issue.md."
                )
        else:
            errors.append(
                f"{iid} in {issue.path}: phase_state is 'absorbed' but no absorbed_into field. "
                f"Set absorbed_into to the canonical I-* issue that absorbs this raw."
            )

    # 4. Dropped validation: prevent using "dropped" as a shortcut for completed code merges.
    # dropped means the issue was abandoned — not "I finished the code and merged it."
    if phase == "dropped" and changed_paths:
        code_files_in_merge = [
            p for p in changed_paths
            if not p.startswith("docs/issues/")
            and not p.startswith("docs/pre-brainstorms/")
            and not p.startswith("docs/milestones.md")
            and not p.startswith("AGENTS.md")
            and not p.startswith("docs/system/workspace/agents/")
        ]
        if code_files_in_merge:
            errors.append(
                f"{iid} in {issue.path}: phase_state is 'dropped' but the merge contains "
                f"{len(code_files_in_merge)} code file(s) beyond docs/issues/ or agent docs. "
                f"dropped means the issue was abandoned without code changes. "
                f"If code was implemented and merged, use 'absorbed' (with absorbed_into pointing to the I-* issue) "
                f"or go through B1→candidate→I-* chain. "
                f"Code files in merge: {', '.join(code_files_in_merge[:5])}"
                f"{'...' if len(code_files_in_merge) > 5 else ''}"
            )

    return errors


def main() -> int:
    global USE_STAGED_VIEW, USE_RANGE_VIEW, RANGE_SOURCE_REF
    parser = argparse.ArgumentParser(description="Develop-merge governance gate for raw/C/M/I lifecycle materialization.")
    parser.add_argument("--staged", action="store_true", help="Validate the staged merge result.")
    parser.add_argument("--range", help="Validate changed governance artifacts in the given git revision range.")
    parser.add_argument("--target-branch", default="develop", help="Target branch for the guarded merge or push.")
    parser.add_argument("--source-branch", default="", help="Source branch for guarded merge verification.")
    parser.add_argument("--skip-ibm-gate", action="store_true", help="Skip IBM governance lifecycle validation. Only check that changed paths are governance-only (no implementation code).")
    args = parser.parse_args()
    if not args.skip_ibm_gate and os.environ.get("FREELY_SKIP_IBM_GATE") == "1":
        args.skip_ibm_gate = True
    USE_STAGED_VIEW = bool(args.staged)
    if args.range:
        USE_RANGE_VIEW = True
        RANGE_SOURCE_REF = args.range.split("...")[-1].split("..")[-1]

    changed_paths = changed_paths_from_args(args)
    candidate_paths: Set[str] = {p for p in changed_paths if p.startswith("docs/pre-brainstorms/") and p.endswith("/candidates.md")}
    touched_candidate_paths: Set[str] = set(candidate_paths)
    issue_paths: Set[str] = {p for p in changed_paths if re.match(r"docs/epics/.+/issues/.+\.md$", p) or re.match(r"docs/issues/(raw-|I-).+/issue\.md$", p)}
    progress_paths: Set[str] = {p for p in changed_paths if re.match(r"docs/progress/.+\.md$", p)}
    review_paths: Set[str] = {p for p in changed_paths if re.match(r"docs/epics/.+/code-reviews/.+\.md$", p)}
    milestones_changed = "docs/milestones.md" in changed_paths

    # ── SKIP IBM GATE: skip lifecycle validation, only check governance-only ──
    if args.skip_ibm_gate:
        non_governance_paths = [p for p in changed_paths if not is_governance_only_path(p)]
        if non_governance_paths:
            print("[FAIL] FREELY_SKIP_IBM_GATE=1 but merge contains implementation changes.")
            print("FREELY_SKIP_IBM_GATE=1 is only allowed for governance-only changes:")
            print("  - docs/ (pre-brainstorms, epics, progress, issues, system/workspace/skills, system/workspace/hooks)")
            print("  - AGENTS.md, docs/CONSTITUTION.md, docs/LAWS.md, docs/PROJECT_INTENT.md, docs/milestones.md")
            print()
            print("Implementation changes must go through the full raw/C/M/I lifecycle.")
            print("Non-governance paths in this diff:")
            for p in non_governance_paths:
                print(f"  - {p}")
            return 1
        # Code files (by extension or shebang) MUST go through full lifecycle
        code_paths = [p for p in changed_paths if _is_code_file(p)]
        if code_paths:
            print("[FAIL] FREELY_SKIP_IBM_GATE=1 but code files cannot skip IBM gate.")
            print("Code files require full raw/C/M/I lifecycle regardless of path:")
            for p in code_paths:
                print(f"  - {p}")
            return 1
        print("[SKIP-IBM-GATE] All changed paths are governance-only. IBM gate skipped.")
        return 0

    milestones = parse_milestones()
    milestone_by_issue_path: Dict[str, List[MilestoneEntry]] = {}
    milestone_candidate_entries: Dict[str, List[MilestoneEntry]] = {}
    milestone_entries_by_source_candidate: Dict[str, List[MilestoneEntry]] = {}
    milestone_status_by_id: Dict[str, str] = {}

    for entry in milestones:
        if entry.milestone_status:
            milestone_status_by_id[entry.milestone_id] = entry.milestone_status
        if entry.issue_path:
            milestone_by_issue_path.setdefault(entry.issue_path, []).append(entry)
        if entry.queue == "candidate_issues":
            milestone_candidate_entries.setdefault(entry.item_id, []).append(entry)
        for source_candidate_path in entry.source_candidates:
            milestone_entries_by_source_candidate.setdefault(source_candidate_path, []).append(entry)

    issues_index = build_issue_index()
    issues_by_id = build_issue_id_index(issues_index)
    candidate_records: List[CandidateRecord] = []
    progress_records: List[ProgressRecord] = [parse_progress_file(path) for path in sorted(progress_paths)]
    review_records: List[ReviewRecord] = [parse_review_file(path) for path in sorted(review_paths)]
    for candidate_path in sorted(candidate_paths):
        candidate_records.extend(parse_candidate_file(candidate_path))

    for issue_path in list(issue_paths):
        issue = issues_index.get(issue_path)
        if issue:
            candidate_source_path = anchorless_source_candidate(issue.source_candidate)
            if candidate_source_path:
                candidate_paths.add(candidate_source_path)

    for progress in progress_records:
        owner_issue = None
        if progress.issue_path:
            owner_issue = issues_index.get(progress.issue_path)
        if not owner_issue and progress.issue_id:
            owner_issue = issues_by_id.get(progress.issue_id)
        if owner_issue:
            candidate_source_path = anchorless_source_candidate(owner_issue.source_candidate)
            if candidate_source_path:
                candidate_paths.add(candidate_source_path)

    for review in review_records:
        owner_issue = issues_by_id.get(review.issue_id or "")
        if owner_issue:
            candidate_source_path = anchorless_source_candidate(owner_issue.source_candidate)
            if candidate_source_path:
                candidate_paths.add(candidate_source_path)

    for candidate_path in sorted(candidate_paths):
        if all(record.path != candidate_path for record in candidate_records):
            candidate_records.extend(parse_candidate_file(candidate_path))

    candidate_records_by_path: Dict[str, List[CandidateRecord]] = {}
    for candidate in candidate_records:
        candidate_records_by_path.setdefault(candidate.path, []).append(candidate)

    errors: List[str] = []
    warnings: List[str] = []

    # ── GATE 1: source branch must carry a valid issue key ──
    source_branch = (args.source_branch or "").strip()
    # In --range mode without explicit --source-branch, derive from current branch
    if USE_RANGE_VIEW and not source_branch:
        source_branch = current_git_branch() or ""
    if (
        args.target_branch == "develop"
        and source_branch
        and source_branch != "develop"
        and source_branch != "main"
        and not is_test_premerge_branch(source_branch)
    ):
        key_ok = False
        key_match = (re.search(r"raw-[0-9]{8}T[0-9]{4,6}Z", source_branch) or re.search(r"raw-[0-9]{8}-[0-9]{4}", source_branch))
        if key_match:
            key_ok = True
        else:
            key_match = (re.search(r"I-[0-9]{8}T[0-9]{4,6}Z(-[A-Z0-9]+)?", source_branch) or re.search(r"I-[0-9]{8}-[0-9]{4}(-[A-Z0-9]+)?", source_branch))
            if key_match:
                key_ok = True
        if not key_ok:
            branch_type = source_branch.split("/")[0] if "/" in source_branch else "unknown"
            errors.append(
                f"GATE 1: source branch '{source_branch}' does not contain a valid issue key. "
                f"Feature and hotfix branches must include a raw-YYYYMMDDTHHMM[SS]Z or I-YYYYMMDDTHHMM[SS]Z-X key (legacy raw-YYYYMMDD-HHMM also accepted). "
                f"Examples: {branch_type}/raw-20260505T121030Z-scan-b1-fix, {branch_type}/I-20260505T121030Z-A-issue-state-refactor. "
                f"Use './bin/wt-create {branch_type}/raw-YYYYMMDDTHHMM[SS]Z-slug' to create the worktree with correct naming."
            )

    # ── GATE 2: raw issue must be materialized from SQLite and on platform ──
    branch_issue_key = ""
    branch_key_match = (re.search(r"(raw-[0-9]{8}T[0-9]{4,6}Z)", source_branch) or re.search(r"(raw-[0-9]{8}-[0-9]{4})", source_branch))
    if branch_key_match:
        branch_issue_key = branch_key_match.group(1)
    else:
        i_key_match = (re.search(r"(I-[0-9]{8}T[0-9]{4,6}Z(?:-[A-Z0-9]+)?)", source_branch) or re.search(r"(I-[0-9]{8}-[0-9]{4}(?:-[A-Z0-9]+)?)", source_branch))
        if i_key_match:
            branch_issue_key = i_key_match.group(1)

    # ── GATE 1b: timestamp consistency — branch key must agree with governance chain ──
    if args.target_branch == "develop" and branch_issue_key:
        def _extract_ts(key: str) -> Optional[str]:
            m = re.match(r"^(?:raw-|C-|I-)?(\d{8}[-T]\d{4}Z?)", key)
            return m.group(1) if m else None

        def _gate1_mismatch_msg(
            branch_key: str,
            branch_ts: str,
            item_label: str,
            item_path: str,
            item_ts: str,
        ) -> str:
            return (
                f"GATE 1: timestamp mismatch in {item_path}\n"
                f"  branch key: {branch_key} ({branch_ts})\n"
                f"  {item_label} ({item_ts})\n"
                f"\n"
                f"  诊断步骤:\n"
                f"  1. 检查格式: 文件名和 frontmatter local_id 是否符合\n"
                f"     raw-YYYYMMDDTHHMM[SS]Z 或 I-YYYYMMDDTHHMM[SS]Z-X\n"
                f"  2. 格式正确但仍被拦截，考虑:\n"
                f"     a. 工位不是通过 wt-create 创建 → 分支 key 不正确\n"
                f"     b. 一个工位处理了多个 raw issue → 违反一个工位一个 issue\n"
                f"        (docs/LAWS.md)\n"
                f"  3. 如确认多个 issue 混入:\n"
                f"     - 用 wt-create --raw-key <被混入的key> 创建独立工位\n"
                f"     - 将属于该 issue 的实现迁移到新工位\n"
                f"     - 从当前工位移除不属于本工位的 issue 文件\n"
            )

        branch_ts = _extract_ts(branch_issue_key)
        if branch_ts:
            # Only check candidates actually modified by this merge. Batch
            # operations (e.g., closeout) touch issue metadata without modifying
            # candidates; their timestamps naturally differ from the branch key
            # and should not trigger false rejections.
            if touched_candidate_paths:
                for candidate in candidate_records:
                    if candidate.path not in touched_candidate_paths:
                        continue
                    c_key = candidate_key(candidate.candidate_id)
                    if c_key:
                        c_ts = _extract_ts(c_key)
                        if c_ts and not c_ts.startswith(branch_ts) and not branch_ts.startswith(c_ts):
                            if c_ts.rstrip("Z") != branch_ts.rstrip("Z"):
                                errors.append(_gate1_mismatch_msg(
                                    branch_issue_key, branch_ts,
                                    f"candidate {candidate.candidate_id}", candidate.path, c_ts,
                                ))
                for issue_path in sorted(issue_paths):
                    iid_match = re.search(r"((?:raw|I)-\d{8}T\d{4,6}Z(?:-[A-Z0-9]+)?)", issue_path)
                    if iid_match:
                        iid = iid_match.group(1)
                        i_ts = _extract_ts(iid)
                        if i_ts and not i_ts.startswith(branch_ts) and not branch_ts.startswith(i_ts):
                            if i_ts.rstrip("Z") != branch_ts.rstrip("Z"):
                                errors.append(_gate1_mismatch_msg(
                                    branch_issue_key, branch_ts,
                                    f"issue {iid}", issue_path, i_ts,
                                ))

    if args.target_branch == "develop" and branch_issue_key:
        # 2a: SQLite chat-inbox catch-all — ensure matching chat is consumed
        db_path = os.path.join(ROOT_DIR, ".freely", "freely.db")
        if os.path.isfile(db_path) and branch_issue_key.startswith("raw-"):
            try:
                conn = sqlite3.connect(db_path)
                # Branch key raw-YYYYMMDD-HHMM → chat id is YYYYMMDDHHMMSS
                # Use LIKE to find chats with matching date+time prefix (ignore seconds)
                # Accept old (YYYYMMDD-HHMM) and new (YYYYMMDDTHHMM[SS]Z) formats
                raw_ts_match = re.match(r"raw-(\d{8}[-T]\d{4}Z?)", branch_issue_key)
                if raw_ts_match:
                    ts_prefix = raw_ts_match.group(1).replace("-", "").replace("T", "").replace("Z", "")
                    rows = conn.execute(
                        "SELECT id, issue_id, consumed, materialized_as FROM chats "
                        "WHERE CAST(id AS TEXT) LIKE ? AND chat_type = 'new-issue' AND consumed = 0 "
                        "ORDER BY id ASC",
                        (f"{ts_prefix}%",),
                    ).fetchall()
                    if rows:
                        for row in rows:
                            chat_id, chat_issue_id, consumed_val, materialized_as = row
                            # Only consume the chat whose issue_id matches the branch key
                            if chat_issue_id == branch_issue_key or chat_issue_id.startswith(branch_issue_key):
                                raw_dir = os.path.join(ROOT_DIR, "docs", "issues", branch_issue_key)
                                # Auto-materialize to docs/issues/ if missing
                                if not os.path.isdir(raw_dir) or not os.path.isfile(os.path.join(raw_dir, "issue.md")):
                                    os.makedirs(raw_dir, exist_ok=True)
                                    chat_row = conn.execute(
                                        "SELECT issue_id, author, channel, created_at, session_refs, intake_id, message FROM chats WHERE id = ?",
                                        (chat_id,),
                                    ).fetchone()
                                    if chat_row:
                                        issue_id, author, channel, created_at, session_refs, intake_id, message = chat_row
                                        raw_issue_file = os.path.join(raw_dir, "issue.md")
                                        with open(raw_issue_file, "w", encoding="utf-8") as f:
                                            f.write(
                                                f"---\n"
                                                f"local_id: {issue_id}\n"
                                                f"kind: raw\n"
                                                f"status: proposed\n"
                                                f"platform_ids: {{}}\n"
                                                f"primary_platform: \"\"\n"
                                                f"canonical_issue_path: \"\"\n"
                                                f"last_synced_comment_at: {{}}\n"
                                                f"hash: \"\"\n"
                                                f"created_at: {created_at}\n"
                                                f"updated_at: {created_at}\n"
                                                f"intake_id: {intake_id}\n"
                                                f"author: {author}\n"
                                                f"channel: {channel}\n"
                                                f"session_refs: {session_refs}\n"
                                                f"---\n\n"
                                                f"{message}\n"
                                            )
                                        warnings.append(
                                            f"GATE 2a: auto-materialized raw issue {branch_issue_key} from chat-inbox entry {chat_id}."
                                        )
                                # Mark this specific chat as consumed
                                conn.execute(
                                    "UPDATE chats SET consumed = 1, materialized_as = ? WHERE id = ?",
                                    (branch_issue_key, chat_id),
                                )
                                conn.commit()
                                warnings.append(
                                    f"GATE 2a: consumed chat-inbox entry {chat_id} → {branch_issue_key} (catch-all)."
                                )
                                break  # Only consume one matching chat
                conn.close()
            except Exception:
                pass  # SQLite check is best-effort; don't block the merge on DB errors

        # 2b: Platform raw issue check — ensure raw-* has platform_ids or clear waiver
        if branch_issue_key.startswith("raw-"):
            raw_issue_file = os.path.join(ROOT_DIR, "docs", "issues", branch_issue_key, "issue.md")
            if os.path.isfile(raw_issue_file):
                try:
                    with open(raw_issue_file, encoding="utf-8") as f:
                        content = f.read()
                    platform_ids_match = re.search(r"platform_ids:\s*(\{.*?\})", content, re.DOTALL)
                    if platform_ids_match:
                        try:
                            platform_ids = json.loads(platform_ids_match.group(1))
                            has_github = bool((platform_ids.get("github") or {}).get("issue_id", ""))
                            has_gitee = bool((platform_ids.get("gitee") or {}).get("issue_id", ""))
                            if not has_github and not has_gitee:
                                warnings.append(
                                    f"GATE 2: raw issue {branch_issue_key} has no platform_ids on GitHub or Gitee. "
                                    f"Run './bin/issue-sync batch' to create it on the platform before merging."
                                )
                        except json.JSONDecodeError:
                            pass
                except Exception:
                    pass

    is_hotfix_source = bool(source_branch) and source_branch.startswith("hotfix/")

    if is_hotfix_source:
        # Hotfix source branches skip lifecycle validation (candidates, milestones,
        # issue chains, progress, reviews, pretests gate). Only GATE 1 (issue key)
        # and GATE 2 (raw issue materialization) have been validated above.
        if errors:
            print("[FAIL] hotfix pre-flight governance gate blocked.")
            for message in errors:
                print(f"- {message}")
            return 1
        if warnings:
            print("Hotfix pre-flight governance gate passed with warnings:")
            for message in warnings:
                print(f"- {message}")
        else:
            print("Hotfix pre-flight governance gate passed.")
        return 0

    allowed_status_guide = [
        "needs_research (还需要继续研究；可停在 milestone candidate_issues，但必须有 next_action 和 revisit_trigger)",
        "blocked (当前 pre-brainstorm 已识别阻塞；可停在 milestone candidate_issues，但必须写清 blocker 后的下一步)",
        "promoted (不允许停在当前环；必须已经 materialize 成一个或多个 I-{issue-id}*)",
        "absorbed (允许不新开独立 issue，但必须指向吸收它的 canonical owner issue)",
        "dropped (允许不进入下一环，但必须写清不再推进的原因)",
    ]

    candidate_changed_lines_by_path = {
        path: changed_line_numbers(path, args) for path in sorted(touched_candidate_paths)
    }
    touched_candidate_ids: Set[str] = set()
    for candidate in candidate_records:
        changed_lines = candidate_changed_lines_by_path.get(candidate.path)
        if not changed_lines:
            continue
        candidate_lines = set(range(candidate.start_line, candidate.end_line + 1))
        if candidate_lines & changed_lines:
            touched_candidate_ids.add(candidate.candidate_id)
    candidate_driven_evidence: Set[str] = set(touched_candidate_ids)
    issue_bound_evidence: Set[str] = set()
    issue_bound_issue_paths: Set[str] = set()
    issue_bound_candidate_ids: Set[str] = set()
    progress_owner_issue_paths: Set[str] = set()
    review_owner_issue_paths: Set[str] = set()
    owner_issue_records: Dict[str, IssueRecord] = {}

    for issue_path in sorted(issue_paths):
        issue = issues_index.get(issue_path)
        if not issue:
            continue
        # Raw issues (docs/issues/raw-*) are the lifecycle entry point.
        # They don't have source_candidate — they ARE the source.
        # I-* issues must have source_candidate linking back to a candidate.
        is_raw_issue = issue.path.startswith("docs/issues/raw-")
        if is_raw_issue or issue.source_candidate:
            issue_bound_evidence.add(issue.issue_id or issue.path)
            issue_bound_issue_paths.add(issue.path)
            owner_issue_records[issue.path] = issue
            if not is_raw_issue:
                source_candidate = resolve_source_candidate_record(issue, candidate_records_by_path)
                if source_candidate:
                    issue_bound_candidate_ids.add(source_candidate.candidate_id)
                    candidate_driven_evidence.add(source_candidate.candidate_id)
            else:
                # Raw issues contribute to lifecycle evidence directly
                candidate_driven_evidence.add(issue.issue_id or issue.path)

    for progress in progress_records:
        owner_issue = None
        if progress.issue_path:
            owner_issue = issues_index.get(progress.issue_path)
        if not owner_issue and progress.issue_id:
            owner_issue = issues_by_id.get(progress.issue_id)

        if not owner_issue:
            errors.append(
                f"{progress.path} points to owner issue '{progress.issue_id or progress.issue_path or 'missing'}', but that issue cannot be resolved. "
                f"Every develop-bound merge must stay on a candidate-driven lifecycle. Link progress to a real issue that already traces back to a pre-brainstorm candidate."
            )
            continue

        issue_bound_evidence.add(owner_issue.issue_id or owner_issue.path)
        issue_bound_issue_paths.add(owner_issue.path)
        progress_owner_issue_paths.add(owner_issue.path)
        owner_issue_records[owner_issue.path] = owner_issue
        source_candidate = resolve_source_candidate_record(owner_issue, candidate_records_by_path)
        if not source_candidate:
            sc_path = anchorless_source_candidate(owner_issue.source_candidate) if owner_issue and owner_issue.source_candidate else ""
            detail = ""
            if sc_path and path_exists(sc_path):
                detail = f" File '{sc_path}' exists but contains no recognizable candidate heading (expecting ## C-xxx or ### C-xxx)."
            errors.append(
                f"{progress.path} points to owner issue {owner_issue.issue_id or owner_issue.path}, but that issue has no valid source_candidate.{detail} "
                f"Restore the originating C-* candidate before merging develop-bound work."
            )
            continue

        issue_bound_candidate_ids.add(source_candidate.candidate_id)
        candidate_driven_evidence.add(source_candidate.candidate_id)

    for review in review_records:
        owner_issue = resolve_review_owner_issue(review, issues_by_id, issues_index)
        if not owner_issue:
            errors.append(
                f"{review.path} points to owner issue '{review.issue_id or review.issue_path or 'missing'}', but that issue cannot be resolved. "
                f"Every develop-bound merge must stay on a candidate-driven lifecycle. Link the review to a real issue that traces back to a pre-brainstorm candidate."
            )
            continue

        issue_bound_evidence.add(owner_issue.issue_id or owner_issue.path)
        issue_bound_issue_paths.add(owner_issue.path)
        review_owner_issue_paths.add(owner_issue.path)
        owner_issue_records[owner_issue.path] = owner_issue
        source_candidate = resolve_source_candidate_record(owner_issue, candidate_records_by_path)
        if not source_candidate:
            sc_path = anchorless_source_candidate(owner_issue.source_candidate) if owner_issue and owner_issue.source_candidate else ""
            detail = ""
            if sc_path and path_exists(sc_path):
                detail = f" File '{sc_path}' exists but contains no recognizable candidate heading (expecting ## C-xxx or ### C-xxx)."
            errors.append(
                f"{review.path} points to owner issue {owner_issue.issue_id or owner_issue.path}, but that issue has no valid source_candidate.{detail} "
                f"Restore the originating C-* candidate before merging develop-bound work."
            )
            continue

        issue_bound_candidate_ids.add(source_candidate.candidate_id)
        candidate_driven_evidence.add(source_candidate.candidate_id)

    governance_only_merge = all(is_governance_only_path(path) for path in changed_paths)

    if not governance_only_merge:
        if not candidate_driven_evidence:
            errors.append(
                "This develop-bound merge has no raw/C/M/I lifecycle evidence. Every worktree must start from a raw-* issue (chat or platform), proceed through B1 pre-brainstorm research, and hit a traceable C-* candidate in the merge diff. "
                "Continue existing research by updating its raw/candidate/issue/progress/review artifacts, or if this is a completed-family reopen, create a new raw issue and new candidate that records reopen_of_issue and reopen_reason before replaying the merge."
            )

        if not issue_bound_evidence:
            errors.append(
                "This develop-bound merge is not based on a specific issue. Raw-* or candidate-only evidence is not enough for an implementation-bearing develop merge: the merge diff must carry a concrete I-* issue with progress/review owner, and then the raw/C/M/I chain must still validate."
            )

    for candidate in candidate_records:
        status = (candidate.status or "").strip("`").strip()
        milestone = normalize_milestone_ref(candidate.milestone or "")
        key = candidate_key(candidate.candidate_id)
        if not key:
            continue

        owner_path = normalize_scalar(candidate.promoted_issue_path or "")
        candidate_is_directly_touched = candidate.candidate_id in touched_candidate_ids
        candidate_is_bound_to_touched_issue = candidate.candidate_id in issue_bound_candidate_ids
        candidate_is_bound_to_touched_owner = bool(owner_path) and owner_path in issue_bound_issue_paths
        candidate_is_relevant = (
            candidate_is_directly_touched
            or candidate_is_bound_to_touched_owner
        )
        candidate_is_unresolved_pre_ibm = status in {"proposed", "needs_research", "blocked"}
        unresolved_metadata_fix_is_absorbed_by_governance_owner = (
            candidate_is_directly_touched
            and candidate_is_unresolved_pre_ibm
            and governance_only_merge
            and bool(issue_bound_evidence)
        )
        completed_provenance_fix_is_backed_by_canonical_owner = (
            candidate_is_directly_touched
            and status == "completed"
            and candidate_has_canonical_owner_line(candidate, issues_index, milestone_by_issue_path)
        )

        # dropped 状态的 candidate 不需要 owner issue，因为它们已被明确放弃
        if status == "dropped":
            continue

        # pre-IBM 状态的 candidate（proposed, needs_research, blocked, candidate）不需要 owner issue
        # 它们处于研究阶段，尚未决定是否 materialize
        pre_ibm_statuses = {"proposed", "needs_research", "blocked", "candidate"}
        if status in pre_ibm_statuses:
            continue

        candidate_queue_entries = milestone_candidate_entries.get(candidate.candidate_id, [])

        # M GATE: promoted candidates must have candidate_issues in milestones.md.
        # This check runs before the relevance filter below so that promoted
        # candidates without candidate_issues are caught even when their specific
        # lines in the candidates.md file are not directly "touched" by the diff.
        if status == "promoted" and not candidate_queue_entries:
            errors.append(
                f"{candidate.candidate_id} in {candidate.path} is promoted but has no candidate_issues entry in docs/milestones.md. "
                f"Promoted candidates must flow through milestone candidate_issues -> committed_issues. "
                f"Add C-{key} as M-{key} to the active milestone's candidate_issues queue."
            )
            continue

        if (
            not candidate_is_relevant
            and not unresolved_metadata_fix_is_absorbed_by_governance_owner
            and not completed_provenance_fix_is_backed_by_canonical_owner
        ):
            continue

        if (
            not candidate_is_bound_to_touched_issue
            and not (status == "absorbed" and candidate_is_bound_to_touched_owner)
            and not unresolved_metadata_fix_is_absorbed_by_governance_owner
            and not completed_provenance_fix_is_backed_by_canonical_owner
        ):
            errors.append(
                f"{candidate.candidate_id} in {candidate.path} is touched by this develop merge, but the same merge does not carry its concrete owner issue/progress/review. "
                f"Candidate-only evidence or an unrelated issue in the diff is not enough: bind the merge to this candidate's own I-* issue, or for an absorbed candidate include the canonical owner issue/progress/review in the same merge."
            )

        active_statuses = {"proposed", "needs_research", "blocked", "promoted"}
        if status in active_statuses and (not milestone or milestone == "unassigned" or milestone.startswith("pending://")):
            errors.append(
                f"{candidate.candidate_id} in {candidate.path} is active with status '{status}', but milestone binding is missing. "
                f"Create milestone identity M-{key} and place the candidate in docs/milestones.md candidate_issues before merging to develop."
            )
            continue

        if status in active_statuses:
            declared_milestone_status = milestone_status_by_id.get(milestone, "missing")
            if declared_milestone_status != "active":
                errors.append(
                    f"{candidate.candidate_id} in {candidate.path} is active with status '{status}', but declared milestone {milestone} has status '{declared_milestone_status}'. "
                    f"Active unresolved candidates must bind to an active milestone."
                )
            if status in {"proposed", "needs_research", "blocked"} and candidate_queue_entries:
                entry_milestones = {entry.milestone_id for entry in candidate_queue_entries}
                if milestone not in entry_milestones:
                    errors.append(
                        f"{candidate.candidate_id} in {candidate.path} declares milestone {milestone}, but docs/milestones.md currently places it in {', '.join(sorted(entry_milestones))}. "
                        f"Keep the candidate metadata aligned with the milestone queue that actually carries it."
                    )
                for entry in candidate_queue_entries:
                    if entry.milestone_status != "active":
                        errors.append(
                            f"{candidate.candidate_id} in {candidate.path} is still queued under milestone {entry.milestone_id}, but that milestone has status '{entry.milestone_status or 'missing'}'. "
                            f"Unresolved active candidates cannot stay in completed or non-active milestone queues."
                        )

        if status in {"proposed", "needs_research", "blocked"} and not candidate_queue_entries:
            errors.append(
                f"{candidate.candidate_id} in {candidate.path} stays at pre-IBM status '{status}', but docs/milestones.md has no candidate_issues entry for it. "
                f"Keep C-{key} visible as M-{key} in the milestone candidate queue instead of merging it as an orphan."
            )
        if status in {"proposed", "needs_research", "blocked"}:
            if not (candidate.next_action or "").strip():
                errors.append(
                    f"{candidate.candidate_id} in {candidate.path} is merge-eligible only because it stays in pre-IBM status '{status}', but next_action is missing. "
                    f"Write the concrete next action before merging unresolved research to develop."
                )
            if not (candidate.revisit_trigger or "").strip():
                errors.append(
                    f"{candidate.candidate_id} in {candidate.path} is merge-eligible only because it stays in pre-IBM status '{status}', but revisit_trigger is missing. "
                    f"Write the restart condition so the candidate does not disappear after merge."
                )

        if status == "promoted":
            if not candidate_queue_entries:
                errors.append(
                    f"{candidate.candidate_id} in {candidate.path} is promoted but has no candidate_issues entry in docs/milestones.md. "
                    f"Promoted candidates must flow through milestone candidate_issues → committed_issues. "
                    f"Add C-{key} as M-{key} to the active milestone's candidate_issues queue."
                )
            # Check raw→C key chain: promoted candidates should have a matching raw issue
            issues_dir = os.path.join(ROOT_DIR, "docs", "issues")
            raw_ids: set[str] = set()
            if os.path.isdir(issues_dir):
                for entry in os.listdir(issues_dir):
                    raw_dir = os.path.join(issues_dir, entry)
                    if os.path.isdir(raw_dir) and entry.startswith("raw-"):
                        raw_ids.add(entry)
            if raw_ids and not candidate_matches_raw_identity(candidate.candidate_id, raw_ids):
                # GATE 6.3: promoted candidate must trace back to a raw-* issue (B1 input source)
                c_key_val = candidate_key(candidate.candidate_id) or candidate.candidate_id
                errors.append(
                    f"GATE 6.3: {candidate.candidate_id} in {candidate.path} is promoted but has no matching raw-* issue in docs/issues/. "
                    f"Every promoted candidate must share its date-time key with a raw issue (raw-{c_key_val.split('-')[0] if '-' in str(c_key_val) else c_key_val} → {candidate.candidate_id}). "
                    f"Create docs/issues/raw-{{key}}/issue.md for this candidate, or if the candidate came from a platform issue, ensure scan creates the raw-* entry."
                )

            issue_path = owner_path
            if not issue_path or issue_path.startswith("pending://"):
                errors.append(
                    f"{candidate.candidate_id} in {candidate.path} is marked promoted, but promoted_issue_path is still '{issue_path or 'missing'}'. "
                    f"Materialize it into one or more I-{key}* issues before merging to develop."
                )
                continue

            if issue_path not in issue_bound_issue_paths:
                errors.append(
                    f"{candidate.candidate_id} in {candidate.path} is marked promoted to {issue_path}, but this merge does not carry that issue or its linked progress/review. "
                    f"Develop-bound implementation merges must bring the concrete owner issue into the same diff so the raw/C/M/I chain is auditable."
                )

            issue_record = issues_index.get(issue_path)
            if not issue_record:
                errors.append(
                    f"{candidate.candidate_id} in {candidate.path} points to {issue_path}, but that issue file does not exist. "
                    f"Create the I-{key}* issue artifact or correct promoted_issue_path."
                )
                continue

            candidate_source = anchorless_source_candidate(issue_record.source_candidate)
            if candidate_source != candidate.path:
                errors.append(
                    f"{candidate.candidate_id} in {candidate.path} materialized to {issue_path}, but the issue source_candidate is '{issue_record.source_candidate or 'missing'}'. "
                    f"Point the issue back to this candidate so the raw/C/M/I chain is traceable."
                )

            issue_identifier = issue_record.issue_id or ""
            if not issue_matches_candidate_identity(
                issue_identifier,
                candidate.candidate_id,
                candidate.legacy_id_mapping,
            ):
                errors.append(
                    f"{candidate.candidate_id} in {candidate.path} promoted to issue '{issue_identifier or issue_path}', but it does not preserve the shared issue-id key '{key}'. "
                    f"Use an issue id like I-{key} or I-{key}-<split> so IBM splits still trace back to the same candidate."
                )

            formal_entries = milestone_by_issue_path.get(issue_path, [])
            if not formal_entries:
                errors.append(
                    f"{candidate.candidate_id} in {candidate.path} already materialized to {issue_path}, but docs/milestones.md still has no committed/completed issue entry for it. "
                    f"Move the work from milestone candidate_issues into formal issue orchestration before merging to develop."
                )
            else:
                formal_milestones = {entry.milestone_id for entry in formal_entries}
                if milestone not in formal_milestones:
                    errors.append(
                        f"{candidate.candidate_id} in {candidate.path} declares milestone {milestone}, but docs/milestones.md sequences {issue_path} under {', '.join(sorted(formal_milestones))}. "
                        f"Keep candidate metadata aligned with the active milestone that owns the formal issue."
                    )
                for entry in formal_entries:
                    if entry.milestone_status != "active":
                        errors.append(
                            f"{candidate.candidate_id} in {candidate.path} is materialized under milestone {entry.milestone_id}, but that milestone has status '{entry.milestone_status or 'missing'}'. "
                            f"Promoted candidates must sequence their formal issues under an active milestone."
                        )

            if candidate_queue_entries and not formal_entries:
                errors.append(
                    f"{candidate.candidate_id} in {candidate.path} is still only represented in milestone candidate_issues even though {issue_path} exists. "
                    f"Once IBM creates I-{key}*, the milestone must sequence those formal issues instead of leaving the candidate as the execution surface."
                )

        if status == "absorbed":
            if not owner_path or owner_path.startswith("pending://"):
                errors.append(
                    f"{candidate.candidate_id} in {candidate.path} is marked absorbed, but there is no canonical owner issue in promoted_issue_path. "
                    f"Point it to the issue that absorbed this candidate before merging to develop."
                )
            elif not path_exists(owner_path):
                errors.append(
                    f"{candidate.candidate_id} in {candidate.path} is marked absorbed, but promoted_issue_path points to missing owner issue {owner_path}. "
                    f"Restore the owner issue path or choose a different final status."
                )
            elif owner_path not in issue_bound_issue_paths:
                errors.append(
                    f"{candidate.candidate_id} in {candidate.path} is marked absorbed into {owner_path}, but this merge does not carry that canonical owner issue or its linked progress/review. "
                    f"An absorbed candidate only counts when the absorbing owner is part of the same develop-bound diff."
                )
            if not (candidate.decision_reason or "").strip():
                errors.append(
                    f"{candidate.candidate_id} in {candidate.path} is marked absorbed, but decision_reason is missing. "
                    f"Explain why this candidate no longer needs an independent lifecycle."
                )

        if status == "dropped" and not (candidate.decision_reason or "").strip():
            errors.append(
                f"{candidate.candidate_id} in {candidate.path} is marked dropped, but decision_reason is missing. "
                f"Record why this candidate is intentionally not moving to the next lifecycle stage."
            )

    queue_for_phase = {
        "in_ibm": "committed_issues",
        "done_ibm": "committed_issues",
        "in_dev": "committed_issues",
        "blocked_dev": "committed_issues",
        "in_verification": "committed_issues",
        "completed": "completed_issues",
    }

    touched_issue_records: List[IssueRecord] = []
    for issue_path in sorted(issue_paths):
        issue = issues_index.get(issue_path)
        if issue:
            touched_issue_records.append(issue)

    for issue in touched_issue_records:
        if not issue.issue_id:
            errors.append(f"{issue.path} is missing issue_id, so the develop merge gate cannot bind it into an I-{{issue-id}} chain.")
            continue

        # Raw issues are B1 entry points — they don't have source_candidate.
        # Instead, validate raw-specific requirements.
        if issue.path.startswith("docs/issues/raw-"):
            raw_errors = _validate_raw_issue(issue, changed_paths)
            errors.extend(raw_errors)
            continue

        phase = normalized_phase(issue.phase_state)

        source_candidate_path = anchorless_source_candidate(issue.source_candidate)
        if not source_candidate_path or not path_exists(source_candidate_path):
            errors.append(
                f"{issue.issue_id} in {issue.path} is missing a valid source_candidate. "
                f"Point it to the originating pre-brainstorm candidate so the merge gate can trace the lifecycle."
            )

        expected_queue = queue_for_phase.get((issue.phase_state or "").strip("`").strip())
        entries = milestone_by_issue_path.get(issue.path, [])
        # Linked I-* issues: also try canonical path for milestone matching
        if not entries and issue.path.startswith("docs/issues/I-"):
            try:
                text = read_repo_text(issue.path)
                m = re.search(r"^canonical_issue_path:\s*(.+?)\s*$", text, re.MULTILINE)
                if m:
                    cp = m.group(1).strip().strip('"').strip("'")
                    entries = milestone_by_issue_path.get(cp, entries)
            except Exception:
                pass
        if expected_queue:
            matching_queue = [entry for entry in entries if entry.queue == expected_queue]
            if not matching_queue:
                if phase == "completed":
                    # Completed legacy items: milestone queue is bookkeeping, not a merge blocker.
                    warnings.append(
                        f"{issue.issue_id} in {issue.path} has phase_state 'completed' but is not in milestone {expected_queue}. "
                        f"Consider moving it into completed_issues for traceability."
                    )
                else:
                    errors.append(
                        f"{issue.issue_id} in {issue.path} has phase_state '{issue.phase_state}', but docs/milestones.md does not place it in {expected_queue}. "
                        f"Synchronize the milestone queue with the real issue phase before merging to develop."
                    )

        if source_candidate_path:
            referenced_candidate = resolve_source_candidate_record(issue, candidate_records_by_path)

            if referenced_candidate:
                c_key = candidate_key(referenced_candidate.candidate_id)
                if not issue_matches_candidate_identity(
                    issue.issue_id,
                    referenced_candidate.candidate_id,
                    referenced_candidate.legacy_id_mapping,
                ):
                    msg = (
                        f"{issue.issue_id} in {issue.path} comes from {referenced_candidate.candidate_id}, but the issue id does not preserve the shared issue-id key '{c_key}'. "
                        f"Rename it to I-{c_key} or I-{c_key}-<split> so milestone and IBM stay on the same lifecycle line."
                    )
                    if phase == "completed":
                        warnings.append(msg)
                    else:
                        errors.append(msg)

                candidate_status = (referenced_candidate.status or "").strip("`").strip()
                if candidate_status in {"proposed", "needs_research", "blocked"} and expected_queue:
                    errors.append(
                        f"{issue.issue_id} in {issue.path} is already in phase '{issue.phase_state}', but its source candidate {referenced_candidate.candidate_id} still says '{candidate_status}'. "
                        f"Update the candidate to the promoted/materialized state instead of leaving upstream status stale."
                    )

    capability_changed_paths = [path for path in changed_paths if not is_governance_only_path(path)]
    implementation_changed_paths = [path for path in changed_paths if is_implementation_bearing_path(path)]
    if capability_changed_paths:
        capability_owner_phases = {"completed"}
        for owner_issue_path in sorted(issue_bound_issue_paths):
            owner_issue = issues_index.get(owner_issue_path)
            if not owner_issue:
                continue
            # Raw issues (B1 input) have their own valid phases (proposed/absorbed/dropped).
            # Skip the B2 execution-phase check for raw issues.
            if owner_issue.path.startswith("docs/issues/raw-"):
                continue
            phase = normalized_phase(owner_issue.phase_state)
            if phase not in capability_owner_phases:
                errors.append(
                    f"{owner_issue.issue_id or owner_issue.path} in {owner_issue.path} has phase_state '{owner_issue.phase_state}', which cannot own capability/implementation changes in a develop-bound merge. "
                    f"Complete verification and advance phase_state to 'completed' before merging, or keep this merge governance-only."
                )
            # 历史遗留豁免：phase_state 为 completed 的 issue 允许后补 capability changes
            # 这些是历史 issue，之前已完成但后来有后续修复合并进来
            if phase == "completed":
                warnings.append(
                    f"{owner_issue.issue_id or owner_issue.path} in {owner_issue.path} has phase_state 'completed' but carries capability/implementation changes. "
                    f"This is allowed for legacy issues with post-completion fixes. Consider creating a follow-up issue for future work."
                )

        for issue in touched_issue_records:
            phase = normalized_phase(issue.phase_state)
            has_progress = issue.path in progress_owner_issue_paths
            has_review = issue.path in review_owner_issue_paths
            if phase in {"in_dev", "blocked_dev"} and not has_progress:
                errors.append(
                    f"{issue.issue_id} in {issue.path} touches capability/implementation changes while still in phase '{phase}', but the same develop-bound diff carries no same-line progress artifact. "
                    f"Runtime or product-surface changes must bring the concrete progress owner into the same diff, not just the bare issue document."
                )
            if phase == "in_verification" and not (has_progress or has_review):
                errors.append(
                    f"{issue.issue_id} in {issue.path} touches capability/implementation changes while in_verification, but the same develop-bound diff carries neither same-line progress nor review evidence. "
                    f"Verification-phase merges must include the concrete verification/progress artifact that justifies the closeout state."
                )

    if implementation_changed_paths:
        for owner_issue_path in sorted(issue_bound_issue_paths):
            owner_issue = owner_issue_records.get(owner_issue_path) or issues_index.get(owner_issue_path)
            if not owner_issue:
                continue
            # Raw issues (B1 input) don't need verification_artifact_dir.
            if owner_issue.path.startswith("docs/issues/raw-"):
                continue

            verification_dir = normalize_scalar(owner_issue.verification_artifact_dir or "")

            # 对于已完成的 issue，豁免 review artifact 要求（历史遗留问题）
            phase = normalized_phase(owner_issue.phase_state)
            if phase == "completed":
                continue

            if not verification_dir:
                errors.append(
                    f"{owner_issue.issue_id or owner_issue.path} in {owner_issue.path} owns implementation-bearing changes, but verification_artifact_dir is missing. "
                    f"Set the canonical review/verification directory on the issue before merging develop-bound implementation work."
                )
                continue
            if not verification_artifact_dir_is_scoped(verification_dir):
                errors.append(
                    f"{owner_issue.issue_id or owner_issue.path} in {owner_issue.path} uses verification_artifact_dir '{verification_dir}', which is too broad or non-canonical. "
                    f"Use an issue-scoped docs/epics/.../code-reviews directory before merging implementation-bearing changes."
                )
                continue

            normalized_dir = verification_dir.rstrip("/")
            owner_reviews = [review for review in review_records if review.path.startswith(f"{normalized_dir}/")]
            if not owner_reviews:
                errors.append(
                    f"{owner_issue.issue_id or owner_issue.path} in {owner_issue.path} owns implementation-bearing changes, but no fresh staged owner review artifact was added under {verification_dir}. "
                    f"Stage an issue-bound review/verification artifact there and record the implementation decision note."
                )
                continue

            complete_review = None
            for review in owner_reviews:
                missing_fields = [
                    field_name
                    for field_name in IMPLEMENTATION_DECISION_NOTE_FIELDS
                    if field_name not in review.decision_note_fields
                ]
                if not missing_fields:
                    complete_review = review
                    break

            if complete_review:
                continue

            first_review = owner_reviews[0]
            missing_fields = [
                field_name
                for field_name in IMPLEMENTATION_DECISION_NOTE_FIELDS
                if field_name not in first_review.decision_note_fields
            ]
            errors.append(
                f"{first_review.path} is the staged review artifact for {owner_issue.issue_id or owner_issue.path}, but its implementation decision note is incomplete. "
                f"Missing fields: {', '.join(missing_fields)}."
            )

    if (
        args.target_branch == "develop"
        and is_test_premerge_branch(args.source_branch)
        and issue_bound_issue_paths
    ):
        # test-pre-merge -> develop is itself a guarded promotion surface.
        # Once the merge binds to an owner issue, consume that owner's pre-tests
        # contract even for governance/status-only closeout diffs so develop
        # cannot accept "completed/verified" truth that lacks adequate evidence.
        if not os.path.exists(PRETESTS_GATE_BIN):
            errors.append(
                f"test-pre-merge promote from {args.source_branch} requires {relative_path(PRETESTS_GATE_BIN)}, but that gate is unavailable."
            )
        else:
            for owner_issue_path in sorted(issue_bound_issue_paths):
                result = subprocess.run(
                    [
                        PRETESTS_GATE_BIN,
                        "--project",
                        ROOT_DIR,
                        "--issue",
                        owner_issue_path,
                        "--staged-only",
                        "--require-adequacy",
                        "--target-lane",
                        "premerge-integration",
                        "--promotion-gate",
                        "develop_merge",
                    ],
                    cwd=ROOT_DIR,
                    text=True,
                    capture_output=True,
                )
                if result.returncode == 0:
                    continue
                output_lines = [
                    line.strip()
                    for line in f"{result.stdout}\n{result.stderr}".splitlines()
                    if line.strip()
                ]
                errors.append(
                    f"{owner_issue_path}: owner issue pre-tests are not adequate for guarded promote from {args.source_branch}."
                )
                for line in output_lines:
                    if line.startswith("[pretests-gate]"):
                        continue
                    if line.startswith("- "):
                        errors.append(line[2:].strip())
                    else:
                        errors.append(line)

    if milestones_changed:
        for entry in milestones:
            if entry.queue in {"committed_issues", "completed_issues"} and entry.item_id.startswith("C-") and entry.issue_path:
                warnings.append(
                    f"docs/milestones.md still uses legacy candidate identity {entry.item_id} in {entry.queue} for {entry.issue_path}. "
                    f"Prefer formal I-{{issue-id}} identities for new develop-bound work."
                )

    # GATE 6.2: linked issues must have platform_ids in docs/issues/
    for issue_path in sorted(issue_bound_issue_paths):
        matched = re.match(r".*/(I-\d{8}-\d{4}[A-Za-z0-9-]*)\.md$", issue_path)
        if not matched:
            continue
        issue_local_id = matched.group(1)
        docs_issue_file = os.path.join(ROOT_DIR, "docs", "issues", issue_local_id, "issue.md")
        if os.path.exists(docs_issue_file):
            with open(docs_issue_file) as f:
                docs_text = f.read()
            if "platform_ids:" not in docs_text or "issue_id:" not in docs_text.split("platform_ids:")[1][:100] if "platform_ids:" in docs_text else True:
                errors.append(
                    f"GATE 6.2: {issue_local_id} in docs/issues/ has no platform_ids. "
                    "Run bin/issue-sync-bootstrap to sync before merge."
                )
        else:
            errors.append(
                f"GATE 6.2: {issue_local_id} has no docs/issues/ entry. "
                "Run bin/issue-sync-bootstrap to create it before merge."
            )

    # GATE 7: platform_state vs phase_state consistency + schema validation
    LEGAL_RAW_PHASE = {"proposed", "absorbed", "dropped"}
    LEGAL_LINKED_PHASE = {"in_b2_ibm", "done_b2_ibm", "in_dev", "blocked_dev", "in_verification", "completed"}

    for issue_path in sorted(issue_bound_issue_paths):
        matched = re.match(r".*/(I-\d{8}[-T]\d{4}Z?[A-Za-z0-9-]*)\.md$", issue_path)
        if not matched:
            continue
        issue_local_id = matched.group(1)
        docs_issue_file = os.path.join(ROOT_DIR, "docs", "issues", issue_local_id, "issue.md")
        if not os.path.exists(docs_issue_file):
            continue
        with open(docs_issue_file) as f:
            docs_text = f.read()

        # Extract frontmatter fields via regex (avoid full YAML parser)
        def _fm_get(text, key):
            m = re.search(rf'^{key}:\s*["\']?(\S+)', text, re.MULTILINE)
            return m.group(1).strip('"\'') if m else ""
        phase = _fm_get(docs_text, "phase_state")
        platform_state = _fm_get(docs_text, "platform_state")
        kind = _fm_get(docs_text, "kind")
        has_pids = bool(re.search(r'issue_id:\s*["\']?\d+', docs_text))

        # S3: phase_state must be in legal set per kind
        legal_set = LEGAL_RAW_PHASE if kind == "raw" else LEGAL_LINKED_PHASE if kind == "linked" else set()
        if phase and legal_set and phase not in legal_set:
            errors.append(
                f"GATE S3: {issue_local_id} has illegal phase_state '{phase}' for kind={kind}. "
                f"Allowed: {sorted(legal_set)}"
            )

        # G1: completed but platform still open
        if phase == "completed" and platform_state == "open":
            errors.append(
                f"GATE G1: {issue_local_id} phase_state=completed but platform_state=open. "
                "Close the platform issue before merge."
            )

        # G2: proposed raw but platform already closed
        if kind == "raw" and phase == "proposed" and platform_state == "closed":
            errors.append(
                f"GATE G2: {issue_local_id} phase_state=proposed but platform_state=closed. "
                "Platform issue was closed before B1 even started."
            )

        # G3: platform_state set but no platform_ids
        if platform_state and platform_state.strip() and not has_pids:
            errors.append(
                f"GATE G3: {issue_local_id} has platform_state='{platform_state}' but no platform_ids.github.issue_id. "
                "Set platform_ids or clear platform_state."
            )

    # ── GATE: Comment closeout (pre-merge, before issue-sync close) ──
    db_path = os.path.join(ROOT_DIR, ".freely", "freely.db")
    if os.path.isfile(db_path) and touched_issue_records:
        try:
            conn = sqlite3.connect(db_path)
            for issue in touched_issue_records:
                iid = issue.issue_id
                if not iid:
                    continue
                # Check for unconsumed comments targeting this issue
                count = conn.execute(
                    "SELECT COUNT(*) FROM chats WHERE consumed = 0 AND chat_type = 'comment' AND (issue_id = ? OR issue_id = ?)",
                    (iid, iid)
                ).fetchone()[0]
                if count > 0:
                    errors.append(
                        f"GATE comment-closeout: {iid} in {issue.path} has {count} unconsumed comment(s) in chat-inbox. "
                        f"Consume (append to issue.md), discard (consumed=-1), or promote to new raw issue before merging."
                    )
            conn.close()
        except Exception:
            pass  # SQLite check is best-effort

    if errors:
        print("[FAIL] develop merge governance gate blocked.")
        print("The following raw/C/M/I lifecycle links are incomplete or inconsistent:")
        for message in errors:
            print(f"- {message}")
        print()
        print("Allowed candidate statuses before merge:")
        for message in allowed_status_guide:
            print(f"- {message}")
        print()
        print("这些错误不是让你改文档凑字段来绕过门禁。")
        print("它们出现意味着实际的实现、验证、评审工作还没完成，或者完成了但没有诚实反映到产物里。")
        print("请回到工位把该做的事情做完，然后再更新对应的 document/status。不要跳过工作只改状态字。")
        if warnings:
            print()
            print("Warnings:")
            for message in warnings:
                print(f"- {message}")
        return 1

    if warnings:
        print("Develop merge governance gate passed with warnings:")
        for message in warnings:
            print(f"- {message}")
    else:
        print("Develop merge governance gate passed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
