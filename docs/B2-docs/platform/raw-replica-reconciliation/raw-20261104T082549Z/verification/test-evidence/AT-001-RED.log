n  1. {prefix}/raw-{raw key}-{slug}    ← based on --base (develop), the permanent dev worktree\n  2. test-pre-merge-{raw key}-{slug}  ← based on ①, discardable testing sandbox\n\nBefore wt-create, create the raw issue on a configured platform first:\n  freely feedback --help    (review usage, then create the raw issue)\n\nExample:\n  freely feedback --repo chatterzhao/freely --title "描述" --body "..."\n  freely wt-create --raw-key <returned-key> --source platform \\\n    --kind fix --slug task-mode-wait-prelaunch-gate\n\nLegacy:\n  freely wt-create feature/my-task-20260307 --base develop\nUSAGE\n}\n\nif [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then\n  usage\n  exit 0\nfi\n\n# ── Argument parsing ─────────────────────────────────────\n\nraw_key=""\nsource_val=""\nskill_name="freely-workflow-guarded-execution"\nskill_path="docs/system/workspace/skills/freely-workflow-guarded-execution/SKILL.md"\nbranch_kind=""\nslug=""\nbase="develop"\nlegacy_branch=""\n\nwhile [[ $# -gt 0 ]]; do\n  case "$1" in\n    --raw-key)\n      raw_key="${2:-}"\n      [[ -n "$raw_key" ]] || { echo "Missing value for --raw-key" >&2; exit 1; }\n      shift 2\n      ;;\n    --source)\n      source_val="${2:-}"\n      [[ -n "$source_val" ]] || { echo "Missing value for --source" >&2; exit 1; }\n      shift 2\n      ;;\n    --kind)\n      branch_kind="${2:-}"\n      [[ -n "$branch_kind" ]] || { echo "Missing value for --kind" >&2; exit 1; }\n      case "$branch_kind" in\n        fix|feature|hotfix) ;;\n        *) echo "Invalid --kind \'$branch_kind\'. Must be \'fix\', \'feature\', or \'hotfix\'." >&2; exit 1 ;;\n      esac\n      shift 2\n      ;;\n    --skill)\n      skill_name="${2:-}"\n      skill_path="docs/system/workspace/skills/${skill_name}/SKILL.md"\n      shift 2\n      ;;\n    --slug)\n      slug="${2:-}"\n      [[ -n "$slug" ]] || { echo "Missing value for --slug" >&2; exit 1; }\n      shift 2\n      ;;\n    --base)\n      base="${2:-}"\n      [[ -n "$base" ]] || { echo "Missing value for --base" >&2; exit 1; }\n      shift 2\n      ;;\n    --*)\n      echo "Unknown argument: $1" >&2\n      usage\n      exit 1\n      ;;\n    *)\n      legacy_branch="$1"\n      shift\n      while [[ $# -gt 0 ]]; do\n        case "$1" in\n          --base)\n            base="${2:-}"; shift 2 ;;\n          *) echo "Unknown argument: $1" >&2; usage; exit 1 ;;\n        esac\n      done\n      break\n      ;;\n  esac\ndone\n\n# ── Validate new interface ───────────────────────────────\n\n# skill_path and base both carry non-empty defaults. Including skill_path in\n# the interface test made using_new unconditionally 1, so the entire legacy\n# branch below was unreachable and `wt-create <branch>` always died with\n# "Missing required: --raw-key" — despite usage promising test worktree 补建.\n# Detect the interface from flags the caller actually supplied instead.\n_new_flags_present=0\nif [[ -n "$raw_key" || -n "$source_val" || -n "$branch_kind" || -n "$slug" ]]; then\n  _new_flags_present=1\nfi\nif [[ -n "$legacy_branch" && "$_new_flags_present" -eq 1 ]]; then\n  echo "拒绝创建工位: legacy 分支名不能与 --raw-key/--source/--kind/--slug 混用" >&2\n  usage\n  exit 1\nfi\nif [[ -z "$legacy_branch" && "$_new_flags_present" -eq 0 ]]; then\n  usage\n  exit 1\nfi\n\nusing_new=0\nif [[ "$_new_flags_present" -eq 1 ]]; then\n  if [[ -z "$raw_key" ]]; then\n    echo "Missing required: --raw-key" >&2; usage; exit 1\n  fi\n  if [[ -z "$source_val" ]]; then\n    cat <<MSG >&2\nMissing required: --source\n\n  --source must be \'platform\'. Raw issues must exist on a configured platform.\n  Create one first: freely feedback --help\n\n  AI: search for this raw-key in the scan file to find its source_family:\n    .freely/run/manager-task-source-scan-latest.json\n\n  If the scan file doesn\'t have this key, wt-create will auto-run scan once.\n\nUsage: freely wt-create --raw-key <key> --source platform --kind <fix|feature|hotfix> --slug <slug>\nMSG\n    exit 1\n  fi\n  if [[ -z "$branch_kind" ]]; then\n    # Fallback: try to read kind from raw issue (set by \'freely feedback --kind\')\n    local _raw_issue_file="docs/B1-docs/raw-${raw_key}/issue.md"\n    if [[ -f "$_raw_issue_file" ]]; then\n      branch_kind=$(grep -m1 \'^- kind:\' "$_raw_issue_file" 2>/dev/null | sed \'s/^- kind: *//\' || true)\n    fi\n    if [[ -z "$branch_kind" ]]; then\n      cat >&2 <<KIND_ERR\nMissing required: --kind\n\n  --kind 未在 wt-create 命令行指定，且 raw issue 中也未找到。\n\n  请在 feedback 阶段就选好 kind:\n    freely feedback --title "..." --body "..." --kind fix\n    freely feedback --title "..." --body "..." --kind feature\n\n  或直接在 wt-create 显式指定:\n    wt-create ... --kind fix\n    wt-create ... --kind feature\n\n  --kind 怎么选（仔细分析，选错会影响 RED 阶段行为）:\n\n    fix     bug 可以稳定复现。已有测试能捕获，或可以手工端到端复现。\n            RED 阶段 = 复现——bug 存在时按测试方法测试一定是 RED，修复正确后，用修复前一样的测试方法，结论一定是 GREEN\n            分支: fix/raw-{key}-{slug}\n\n    feature 新功能、重构、优化、架构改进。\n            RED 阶段 = 功能未实现时，按测试方法测试一定是 RED，实现正确后，用实现前一样的测试方法，结论一定是 GREEN\n            分支: feature/raw-{key}-{slug}\n\n    hotfix  紧急修复，从 main 创建，合并到 main + develop\n            （其他流程与 fix 完全一致，测试不可跳过）\n\n    如果 bug 修复同时需要实现紧相关的新功能 →\n    拆为两个 raw issue，分别 feedback + wt-create。\n\nKIND_ERR\n      exit 1\n    fi\n    echo "wt-create: using kind=\'${branch_kind}\' from raw issue"\n  fi\n  if [[ -z "$slug" ]]; then\n    echo "Missing required: --slug" >&2; usage; exit 1\n  fi\n  using_new=1\nfi\n\n# ── Validate source value ───────────────────────────────\n\nif [[ "$using_new" -eq 1 ]]; then\n  case "$source_val" in\n    platform) ;;\n    chat-inbox|local)\n      echo "Invalid --source \'$source_val\'. Only \'platform\' is allowed." >&2\n      echo "  Raw issues must be created on a configured platform via \'freely feedback\' first." >&2\n      echo "  Then use: wt-create --raw-key <key> --source platform --kind <fix|feature|hotfix> --slug <slug>" >&2\n      exit 1\n      ;;\n    *)\n      echo "Invalid --source \'$source_val\'. Must be \'platform\'." >&2\n      echo "  platform — raw issue exists on a configured platform (created via \'freely feedback\')" >&2\n      exit 1\n      ;;\n  esac\nfi\n\n# ── Derive prefix from --kind ──────────────────────\n\nif [[ "$using_new" -eq 1 ]]; then\n  case "$branch_kind" in\n    fix)     prefix="fix" ;;\n    feature) prefix="feature" ;;\n    hotfix)  prefix="hotfix" ;;\n    *)\n      echo "Unrecognized --kind: $branch_kind" >&2\n      echo "  Must be one of: fix, feature, hotfix" >&2\n      exit 1\n      ;;\n  esac\nfi\n\n# ── Validate raw-key format ──────────────────────────────\n\nif [[ "$using_new" -eq 1 ]]; then\n  if echo "$raw_key" | grep -qE \'^[0-9]{8}T[0-9]{4,6}Z$\'; then\n    : # valid\n  elif echo "$raw_key" | grep -qE \'^[0-9]{8}-[0-9]{4,6}$\'; then\n    echo "警告: raw-key \'$raw_key\' uses legacy format. Prefer YYYYMMDDTHHMM[SS]Z." >&2\n  else\n    echo "Invalid raw-key format \'$raw_key\'. Expected YYYYMMDDTHHMM[SS]Z (e.g., 20260513T010343Z)." >&2\n    exit 1\n  fi\nfi\n\n# ── Resolve branches ─────────────────────────────────────\n\nif [[ "$using_new" -eq 1 ]]; then\n  test_pre_merge_branch="test-pre-merge-${raw_key}-${slug}"\n  dev_branch="${prefix}/raw-${raw_key}-${slug}"\nelse\n  test_pre_merge_branch=""\n  dev_branch="$legacy_branch"\nfi\n\n[[ -n "$dev_branch" ]] || { usage; exit 1; }\n\n# ── Root dir + common ────────────────────────────────────\n\nROOT_DIR="$(git rev-parse --show-toplevel)"\ncd "$ROOT_DIR"\n\nsource "$ROOT_DIR/bin/worktree-common.sh"\nfreely_wt_assert_strict_root\n\n# ── Pre-flight state detection (before any side effect) ─────\n# Standard mode is idempotent. Detect interruption residue here so the\n# replica gate below can be skipped for recovery: the dev worktree already\n# exists, so re-verifying configured platforms only adds latency and a new\n# failure mode to the very command that is supposed to recover.\n# ── Worktree state helpers ────────────────────────────────────\n# A branch existing is NOT the same as a usable worktree: the directory may\n# have been removed (manual delete, disk cleanup, `git worktree prune`), and\n# an added test worktree may not have finished initialisation yet.\n_wt_registered_dir() {\n  local branch="$1" dir\n  dir="$(git worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$branch" \'\n    $1=="worktree" { w=$2 }\n    $1=="branch" && $2==b { print w; exit }\n  \')"\n  [[ -n "$dir" && -d "$dir" ]] || return 1\n  printf \'%s\\n\' "$dir"\n}\n\n# test-gate.env is written by _init_test_worktree_state() at the END of a\n# successful initialisation, so it doubles as the completion marker. Accept\n# any TEST_STATUS value: after a GREEN run the value is "completed", and a\n# re-run must still be recognised as fully initialised.\n_wt_test_initialized() {\n  local dir="$1" marker\n  [[ -n "$dir" && -d "$dir" ]] || return 1\n  marker="$dir/.freely/run/test-gate.env"\n  [[ -f "$marker" ]] || return 1\n  grep -q \'^TEST_STATUS=\' "$marker"\n}\n\nresume_mode=0\n_dev_dir=""; _test_dir=""; _test_ready=0\nif [[ "$using_new" -eq 1 ]]; then\n  _dev_exists=0; _test_exists=0\n  git show-ref --verify --quiet "refs/heads/$dev_branch" && _dev_exists=1 || true\n  git show-ref --verify --quiet "refs/heads/$test_pre_merge_branch" && _test_exists=1 || true\n  _dev_dir="$(_wt_registered_dir "$dev_branch")" || _dev_dir=""\n  _test_dir="$(_wt_registered_dir "$test_pre_merge_branch")" || _test_dir=""\n  if _wt_test_initialized "$_test_dir"; then _test_ready=1; fi\n\n  # Complete state: both branches, both REGISTERED DIRECTORIES, and the test\n  # initialisation marker. Anything less is interruption residue to repair.\n  if [[ "$_dev_exists" -eq 1 && "$_test_exists" -eq 1 && -n "$_dev_dir" && -n "$_test_dir" && "$_test_ready" -eq 1 ]]; then\n    echo "wt-create: 工位已存在，无需创建 (idempotent no-op)" >&2\n    echo "  dev:  $_dev_dir" >&2\n    echo "  test: $_test_dir" >&2\n    exit 0\n  fi\n  if [[ "$_dev_exists" -eq 0 && "$_test_exists" -eq 1 ]]; then\n    echo "拒绝创建工位: test 工位分支已存在但 dev 分支缺失，状态不一致" >&2\n    echo "  请先清理残留的 test-pre-merge 分支/工位，再重建。" >&2\n    exit 1\n  fi\n  if [[ "$_dev_exists" -eq 1 ]]; then\n    resume_mode=1\n    echo "wt-create: 检测到中断残留 —— dev 分支存在但工位不完整，进入恢复模式" >&2\n    [[ -z "$_dev_dir" ]] && echo "  dev 工位目录缺失，需补建" >&2\n    [[ -z "$_test_dir" ]] && echo "  test 工位目录缺失，需补建" >&2\n    [[ "$_test_ready" -eq 0 && -n "$_test_dir" ]] && echo "  test 工位未完成初始化，需重跑初始化" >&2\n  fi\nfi\n\n# 恢复模式无需重复校验平台 raw replicas（工位与 raw issue 已在本地）。\nif [[ "$using_new" -eq 1 && "$resume_mode" -eq 0 ]]; then\n  echo "wt-create: verifying configured raw replicas..." >&2\n  _replica_receipt="$(mktemp -t freely-replica-receipt.XXXXXX)"\n  if ! FREELY_PROJECT_ROOT="$ROOT_DIR" python3 \\\n    "$ROOT_DIR/docs/system/workspace/scripts/lifecycle/raw-reconciliation-gate.py" \\\n    --project "$ROOT_DIR" --raw-key "$raw_key" --allow-degraded > "$_replica_receipt"; then\n      cat "$_replica_receipt" >&2\n      rm -f "$_replica_receipt"\n      echo "拒绝创建工位: configured raw replicas are inconsistent or unavailable" >&2\n      exit 1\n  fi\n  # An unreadable platform is debt, not a fact: record it so it can be settled.\n  _debt_count=$(python3 "$ROOT_DIR/docs/system/workspace/scripts/lifecycle/sync-debt.py" \\\n    --root "$ROOT_DIR" record --receipt "$_replica_receipt" 2>/dev/null \\\n    | python3 -c \'import sys,json; print(json.load(sys.stdin).get("recorded", 0))\' 2>/dev/null || echo 0)\n  if [[ "${_debt_count:-0}" != "0" ]]; then\n    echo "wt-create: 有平台读取失败，已记入待对账（sync-debt list 查看）；工位创建继续" >&2\n  fi\n  rm -f "$_replica_receipt"\nfi\n\n# ── Validate base exists ─────────────────────────────────\n\nif ! git show-ref --verify --quiet "refs/heads/$base" && ! git rev-parse --verify --quiet "$base" >/dev/null; then\n  echo "Base branch/ref not found: $base" >&2\n  exit 1\nfi\n\n# ── Validate branches don\'t already exist ────────────────\n# Standard mode resolved its four-state machine in the pre-flight block\n# above; only legacy mode needs the classic "branch already exists" guard.\nif [[ "$using_new" -eq 0 ]]; then\n  if git show-ref --verify --quiet "refs/heads/$dev_branch"; then\n    echo "Branch already exists: $dev_branch" >&2\n    exit 1\n  fi\nfi\n\n# ── Fuzzy-match: block if ANY branch/worktree exists for this raw_key ──\n# 恢复模式跳过 fuzzy-match：dev 分支本身就是预期的中断残留，\n# 若在这里阻断，重跑仍然会退回「Branch already exists」的死路。\nif [[ "$using_new" -eq 1 && "$resume_mode" -eq 0 ]]; then\n  _existing_branch=$(git branch | grep "raw-${raw_key}" | head -1 || true)\n  _existing_wt=$(git worktree list 2>/dev/null | grep "raw-${raw_key}" | head -1 || true)\n  if [[ -n "$_existing_branch" || -n "$_existing_wt" ]]; then\n    cat >&2 <<FUZZY_BLOCK\n拒绝创建工位: raw-${raw_key} 已有工位/分支\n\n  已有分支: ${_existing_branch:-无}\n  已有工位: ${_existing_wt:-无}\n\n  同一 raw_key 不允许创建多个工位。请使用已有工位继续工作，\n  或先 wt-close 清理后再重建。\nFUZZY_BLOCK\n    exit 1\n  fi\nfi\n\n# ── Raw issue state check ────────────────────────────────\n# If the raw issue was previously closed (absorbed/completed/dropped),\n# automatically reopen it by setting phase_state → proposed.\n# This avoids forcing the user to manually edit develop.\n_issue_file="docs/B1-docs/raw-${raw_key}/issue.md"\nif [[ -f "$_issue_file" ]]; then\n  _phase=$(grep \'phase_state:\' "$_issue_file" 2>/dev/null | head -1 | sed \'s/.*: *//\' | tr -d "\'\\"" || true)\n  case "$_phase" in\n    absorbed|completed|dropped)\n      echo "[wt-create] raw-${raw_key} phase_state=${_phase} → proposed (auto-reopen)" >&2\n      # Change phase_state in-place on the worktree branch (never on develop)\n      if [[ "$(uname)" == "Darwin" ]]; then\n        sed -i \'\' "s/phase_state: ${_phase}/phase_state: proposed/" "$_issue_file"\n      else\n        sed -i "s/phase_state: ${_phase}/phase_state: proposed/" "$_issue_file"\n      fi\n      ;;\n  esac\nfi\n\n# ── Issue pre-check helpers ──────────────────────────────\n\n_extract_issue_key() {\n  local branch="$1"\n  if echo "$branch" | grep -qoE \'raw-[0-9]{8}[-T][0-9]{4,6}Z?\'; then\n    echo "$branch" | grep -oE \'raw-[0-9]{8}[-T][0-9]{4,6}Z?\' | head -1\n    return 0\n  fi\n  if echo "$branch" | grep -qoE \'I-[0-9]{8}[-T][0-9]{4,6}Z?(-[A-Z0-9]+)?\'; then\n    echo "$branch" | grep -oE \'I-[0-9]{8}[-T][0-9]{4}Z?(-[A-Z0-9]+)?\' | head -1\n    return 0\n  fi\n  return 1\n}\n\n# ── Scan matching: verify raw-key exists in scan with correct source ──\n\n_scan_json_path() {\n  printf \'%s\\n\' "$ROOT_DIR/.freely/run/manager-task-source-scan-latest.json"\n}\n\n_scan_lookup() {\n  local raw_key="$1"\n  local scan_file; scan_file="$(_scan_json_path)"\n  [[ -f "$scan_file" ]] || return 1\n  python3 -c "\nimport json, sys\nwith open(\'$scan_file\') as f:\n    data = json.load(f)\nitems = data if isinstance(data, list) else data.get(\'items\', [])\nfor item in items:\n    # Try exact key match first\n    if item.get(\'key\') == \'$raw_key\':\n        print(item.get(\'source_family\', \'\'))\n        sys.exit(0)\n    # Try issue_id match: raw-{key} == issue_id\n    issue_id = item.get(\'issue_id\', \'\') or \'\'\n    if issue_id == \'raw-$raw_key\':\n        print(item.get(\'source_family\', \'\'))\n        sys.exit(0)\nsys.exit(1)\n" 2>/dev/null\n}\n\n_run_scan_once() {\n  local scan_py="$ROOT_DIR/docs/system/workspace/scripts/runtime/task-lifecycle-scan.py"\n  [[ -f "$scan_py" ]] || return 1\n  echo "Scan file missing raw-key $raw_key, running scan once..." >&2\n  mkdir -p "$(dirname "$(_scan_json_path)")"\n  python3 "$scan_py" --project "$ROOT_DIR" --json > "$(_scan_json_path)" 2>/dev/null || true\n}\n\n# ── Pull helpers (unified) ────────────────────────────────\n\n_pull_raw_issue() {\n  local raw_key="$1" source="$2"\n  local expected_local_id="raw-${raw_key}"\n  local expected_issue_file="$PWD/docs/B1-docs/${expected_local_id}/issue.md"\n  case "$source" in\n    platform)\n      if [[ -x "$ROOT_DIR/bin/raw-issue-pull" ]]; then\n        local result parsed_id pull_err\n        pull_err="$(mktemp /tmp/freely-raw-pull.XXXXXX)"\n        result=$("$ROOT_DIR/bin/raw-issue-pull" --raw-key "$raw_key" 2>"$pull_err") || {\n          if [[ -s "$pull_err" ]]; then cat "$pull_err" >&2; fi\n          rm -f "$pull_err"\n          echo "pull: raw-issue-pull failed for $expected_local_id" >&2\n          return 1\n        }\n        # Surface warnings (e.g. issue-sync normalization failure) without\n        # mixing them into the JSON document parsed below.\n        if [[ -s "$pull_err" ]]; then cat "$pull_err" >&2; fi\n        rm -f "$pull_err"\n        parsed_id=$(printf \'%s\' "$result" | python3 -c \'\nimport json, sys\ntry:\n    print(json.load(sys.stdin).get("local_id", ""))\nexcept Exception:\n    print("")\n\' 2>/dev/null || true)\n        if [[ "$parsed_id" != "$expected_local_id" ]]; then\n          echo "pull: identity mismatch — expected $expected_local_id, got \'${parsed_id:-<none>}\'" >&2\n          return 1\n        fi\n        if [[ ! -f "$expected_issue_file" ]]; then\n          echo "pull: expected issue file missing: $expected_issue_file" >&2\n          return 1\n        fi\n        echo "pull: materialized $expected_local_id from platform" >&2\n        return 0\n      fi\n      return 1\n      ;;\n  esac\n}\n\n# ── After pull: ensure platform_ids on all configured platforms ──\n\n_fill_platform_ids() {\n  local raw_key="$1"\n  local issue_file="$PWD/docs/B1-docs/raw-${raw_key}/issue.md"\n  [[ -f "$issue_file" ]] || return 0\n\n  # Check if any configured platform is missing\n  local needs_sync=0\n  if [[ -n "${GH_REPO:-}" ]] || gh repo view --json nameWithOwner -q \'.nameWithOwner\' >/dev/null 2>&1; then\n    local gh_id\n    gh_id=$(python3 -c "\nimport yaml\nwith open(\'$issue_file\') as f: c=f.read()\nparts=c.split(\'---\',2)\nfm=yaml.safe_load(parts[1]) if len(parts)>=3 else {}\nids=fm.get(\'platform_ids\',{}) or {}\ngh=ids.get(\'github\',{}) or {}\nprint(gh.get(\'issue_id\',\'\'))\n" 2>/dev/null || true)\n    if [[ -z "$gh_id" || "$gh_id" == "None" ]]; then\n      needs_sync=1\n    fi\n  fi\n  if [[ -n "${GITEE_TOKEN:-}" ]]; then\n    local gt_id\n    gt_id=$(python3 -c "\nimport yaml\nwith open(\'$issue_file\') as f: c=f.read()\nparts=c.split(\'---\',2)\nfm=yaml.safe_load(parts[1]) if len(parts)>=3 else {}\nids=fm.get(\'platform_ids\',{}) or {}\ngt=ids.get(\'gitee\',{}) or {}\nprint(gt.get(\'issue_id\',\'\'))\n" 2>/dev/null || true)\n    if [[ -z "$gt_id" || "$gt_id" == "None" ]]; then\n      needs_sync=1\n    fi\n  fi\n\n  if [[ "$needs_sync" -eq 1 ]] && [[ -x "$ROOT_DIR/bin/issue-sync" ]]; then\n    echo "补齐 platform_ids: issue-sync create raw-$raw_key" >&2\n    "$ROOT_DIR/bin/issue-sync" create "raw-$raw_key" >/dev/null 2>&1 || true\n    echo "platform_ids 已补齐" >&2\n  fi\n}\n\n_require_issue_exists() {\n  local branch="$1"\n  local key ts db_path chat_inbox_py\n  key="$(_extract_issue_key "$branch")"\n  [[ -n "$key" ]] || return 0\n\n  db_path="$ROOT_DIR/.freely/freely.db"\n  chat_inbox_py="$ROOT_DIR/docs/system/workspace/scripts/runtime/chat-inbox.py"\n\n  case "$key" in\n    raw-*)\n      ts="${key#raw-}"\n      ts_bare=$(echo "$ts" | tr -d \'TZ\')\n\n      # ── Scan matching (new: validate --source against scan, fallback to dir/DB) ──\n      local scan_found=0\n      if [[ "$using_new" -eq 1 ]]; then\n        local scan_source; scan_source="$(_scan_lookup "$raw_key" || true)"\n        if [[ -z "$scan_source" ]]; then\n          _run_scan_once\n          scan_source="$(_scan_lookup "$raw_key" || true)"\n        fi\n        if [[ -n "$scan_source" ]]; then\n          scan_found=1\n          if [[ "$scan_source" != "$source_val" ]]; then\n            echo "警告: raw-$raw_key scan source_family=\'$scan_source\' 与 --source \'$source_val\' 不一致，按 --source 参数继续" >&2\n            scan_found=0\n          fi\n        fi\n      fi\n\n      # ── Source-aware existence check ──\n      if [[ "$scan_found" -ne 1 ]]; then\n        case "$source_val" in\n          platform)\n            # Check if raw issue exists on configured platforms (GitHub/Gitee)\n            local platform_result\n            platform_result=$(python3 "$ROOT_DIR/docs/system/workspace/scripts/sync/platform-adapter.py" search "$raw_key" 2>/dev/null || echo "{}")\n            if [[ "$platform_result" != "{}" && "$platform_result" != "" ]]; then\n              : # found on platform, proceed\n            elif [[ -d "$ROOT_DIR/docs/B1-docs/$key" ]]; then\n              : # exists locally (local_only — will be pushed to platform by worker)\n            else\n              echo "拒绝创建工位: raw-$raw_key not found on platform or local" >&2\n              echo "  如果出错是因为还没有创建 raw issue：" >&2\n              echo "    请使用 freely feedback 命令创建 raw issue" >&2\n              echo "    如果不清楚用法，请运行 freely feedback --help" >&2\n              echo "  创建后重试: wt-create --raw-key $raw_key --source platform --kind <fix|feature|hotfix> --slug <slug>" >&2\n              return 1\n            fi\n            ;;\n          chat-inbox|local|*)\n            # All sources other than platform: redirect to feedback → platform flow\n            if [[ -d "$ROOT_DIR/docs/B1-docs/raw-$raw_key" ]] || [[ -d "$ROOT_DIR/docs/B1-docs/$key" ]]; then\n              echo "  发现本地 issue 文件，请使用 --source platform:" >&2\n              echo "    wt-create --raw-key $raw_key --source platform --kind <fix|feature|hotfix> --slug <slug>" >&2\n            else\n              echo "拒绝创建工位: raw-$raw_key 不存在" >&2\n              echo "  如果出错是因为还没有创建 raw issue：" >&2\n              echo "    请使用 freely feedback 命令创建 raw issue" >&2\n              echo "    如果不清楚用法，请运行 freely feedback --help" >&2\n              echo "  创建后重试: wt-create --raw-key $raw_key --source platform --kind <fix|feature|hotfix> --slug <slug>" >&2\n            fi\n            return 1\n            ;;\n        esac\n      fi\n\n      # Source 1: chat-inbox (already handled by pull in new mode)\n      if [[ -f "$db_path" ]] && python3 "$chat_inbox_py" show --db "$db_path" --id "$ts_bare" >/dev/null 2>&1; then\n        local consumed\n        consumed=$(python3 -c "\nimport sqlite3\nconn=sqlite3.connect(\'$db_path\')\nr=conn.execute(\'SELECT consumed FROM chats WHERE id=?\', (\'$ts_bare\',)).fetchone()\nprint(r[0] if r else \'\')\nconn.close()\n" 2>/dev/null || echo "")\n        if [[ "$consumed" == "0" ]]; then\n          return 0\n        fi\n        if [[ "$consumed" == "1" ]]; then\n          if [[ -d "$ROOT_DIR/docs/B1-docs/$key" ]]; then\n            return 0\n          fi\n          echo "警告: chat $key consumed but issue missing, resetting to pending" >&2\n          python3 "$chat_inbox_py" reset --db "$db_path" --id "$ts" >/dev/null 2>&1 || true\n          return 0\n        fi\n      fi\n      if [[ -d "$ROOT_DIR/docs/B1-docs/$key" ]]; then\n        return 0\n      fi\n      # Platform pull is deferred to after worktree creation\n      if [[ "$using_new" -eq 1 && "$source_val" == "platform" ]]; then\n        return 0\n      fi\n      ;;\n    I-*)\n      if [[ -d "$ROOT_DIR/docs/B1-docs/$key" ]]; then\n        return 0\n      fi\n      ;;\n  esac\n\n  echo "拒绝创建工位: issue $key not found" >&2\n  if [[ -n "$source_val" ]]; then\n    echo "  source: $source_val — raw issue 在该来源中不存在" >&2\n  fi\n  echo "  检查 raw-key 是否正确，或先用 freely feedback / freely chat 创建 raw issue" >&2\n  return 1\n}\n\n_materialize_chat_if_needed() {\n  local branch="$1" target_path="$2"\n  local key ts db_path chat_inbox_py\n  key="$(_extract_issue_key "$branch")"\n  [[ "$key" == raw-* ]] || return 0\n  ts="${key#raw-}"\n\n  db_path="$ROOT_DIR/.freely/freely.db"\n  chat_inbox_py="$ROOT_DIR/docs/system/workspace/scripts/runtime/chat-inbox.py"\n  [[ -f "$db_path" ]] || return 0\n\n  local consumed ts_bare\n  ts_bare=$(echo "$ts" | tr -d \'TZ\')\n  consumed=$(python3 -c "\nimport sqlite3\nconn=sqlite3.connect(\'$db_path\')\nr=conn.execute(\'SELECT consumed FROM chats WHERE id=? AND chat_type=\\"new-issue\\"\', (\'$ts_bare\',)).fetchone()\nprint(r[0] if r else \'\')\nconn.close()\n" 2>/dev/null || echo "")\n\n  if [[ "$consumed" != "0" ]]; then\n    return 0\n  fi\n\n  local issue_dir="$target_path/docs/B1-docs/$key"\n  mkdir -p "$issue_dir"\n\n  if ! python3 "$chat_inbox_py" materialize --db "$db_path" --id "$ts_bare" --target "$issue_dir" >/dev/null 2>&1; then\n    echo "materialize failed, rolling back worktree" >&2\n    git -C "$ROOT_DIR" worktree remove "$target_path" --force 2>/dev/null || true\n    git -C "$ROOT_DIR" branch -D "$branch" 2>/dev/null || true\n    return 1\n  fi\n\n  # Do NOT consume here — _pull_raw_issue is the single consumption point\n  echo "materialized: chat-inbox → $issue_dir/issue.md"\n\n  python3 "$chat_inbox_py" query-by-issue --db "$db_path" --issue-id "$key" --consumed 0 2>/dev/null \\\n    | while read -r line; do\n        local comment_id\n        comment_id=$(echo "$line" | cut -f1)\n        [[ -n "$comment_id" ]] || continue\n        python3 "$chat_inbox_py" materialize-comment --db "$db_path" --id "$comment_id" \\\n          --issue-file "$issue_dir/issue.md" >/dev/null 2>&1 \\\n          && python3 "$chat_inbox_py" consume --db "$db_path" --id "$comment_id" >/dev/null 2>&1\n      done\n}\n\n# _update_scan_state: update scan JSON to track item lifecycle.\n# States: pending (default) → working (wt-create) → closed (wt-close).\n_update_scan_state() {\n  local _rk="$1" _new_state="$2" _wt_path="${3:-}" _ts\n  local _scan_file="$ROOT_DIR/.freely/run/manager-task-source-scan-latest.json"\n  _ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)\n  [[ -f "$_scan_file" ]] || return 0\n  python3 -c "\nimport json, os\ntry:\n    with open(\'$_scan_file\') as f: scan = json.load(f)\n    for item in scan.get(\'items\', []):\n        key = item.get(\'key\', \'\')\n        na = item.get(\'next_action\', \'\')\n        if \'$_rk\' in key or \'$_rk\' in na:\n            item[\'scan_state\'] = \'$_new_state\'\n            item[\'scan_state_updated_at\'] = \'$_ts\'\n            if \'$_wt_path\':\n                item[\'scan_state_worktree\'] = \'$_wt_path\'\n    tmp = \'$_scan_file\' + \'.tmp\'\n    with open(tmp, \'w\') as f: json.dump(scan, f, indent=2)\n    os.rename(tmp, \'$_scan_file\')\nexcept: pass\n" 2>/dev/null || true\n}\n\n# ── Create worktree helper ───────────────────────────────\n\n# Apply the project\'s declarative seeds to a freshly created worktree.\n# The manifest lives in the repo, so a project can list whatever gitignored\n# files it needs without touching this script.\n_seed_worktree() {\n  local target_path="$1" out\n  local seeder="$ROOT_DIR/docs/system/workspace/scripts/worktree/worktree_seed.py"\n  [[ -f "$seeder" ]] || return 0\n  # Source of truth is the main project tree, not this worktree: the gitignored\n  # files we are seeding do not exist here yet (that is the whole point).\n  local seed_root="$ROOT_DIR" home\n  if [[ -f "$ROOT_DIR/.freely/config.toml" ]]; then\n    home=$(sed -n \'s/^[[:space:]]*FREELY_HOME[[:space:]]*=[[:space:]]*"\\(.*\\)"/\\1/p\' \\\n      "$ROOT_DIR/.freely/config.toml" 2>/dev/null | head -1)\n    [[ -n "$home" && -d "$home" ]] && seed_root="$home"\n  fi\n  if ! out=$(python3 "$seeder" apply --project "$seed_root" --target "$target_path" 2>&1); then\n    printf \'%s\\n\' "$out" >&2\n    return 1\n  fi\n  # Keep the summary, drop the per-file "skipped" noise on re-runs.\n  printf \'%s\\n\' "$out" | grep -v \'^\\[wt-seed\\] skipped:\' || true\n}\n\n_create_worktree() {\n  local branch="$1" target_path="$2" base_branch="$3"\n\n  mkdir -p "$(freely_wt_root_dir)"\n\n  FREELY_WT_CREATE=1 git worktree add -b "$branch" "$target_path" "$base_branch"\n\n  _materialize_chat_if_needed "$branch" "$target_path" || return 1\n\n  if [[ -x "$ROOT_DIR/bin/freely" ]]; then\n    FREELY_WT_AUTOCREATE_INTERNAL=1 bash "$ROOT_DIR/bin/freely" sync-tooling \\\n      --source-project "$ROOT_DIR" --project "$target_path" >/dev/null 2>&1 || true\n  fi\n}\n\n# ── Test worktree initialisation: single source of truth ─────────\n# Normal Step 2, interrupted-run recovery and the legacy test-pre-merge\n# 补建 path all converge here, so a recovered test worktree is equivalent\n# to a normally created one (seed / .freely state / test gate marker).\n_init_test_worktree_state() {\n  local tp_target="$1"\n  local _src_freely _dst_freely\n\n  if ! _seed_worktree "$tp_target"; then\n    echo "拒绝创建工位: worktree seed failed" >&2\n    return 1\n  fi\n\n  _src_freely="$ROOT_DIR/.freely"\n  _dst_freely="$tp_target/.freely"\n  if [[ -d "$_src_freely" && -d "$tp_target" ]]; then\n    mkdir -p "$_dst_freely"\n    [[ -f "$_src_freely/freely.db" ]] && cp "$_src_freely/freely.db" "$_dst_freely/freely.db" 2>/dev/null || true\n    [[ -f "$_src_freely/a2a_task.db" ]] && cp "$_src_freely/a2a_task.db" "$_dst_freely/a2a_task.db" 2>/dev/null || true\n    echo "  test-pre-merge: cloned .freely state from develop"\n  fi\n\n  # Always write the gate marker, even when the source .freely tree is\n  # absent (fresh checkout / minimal package). The daemon updates\n  # TEST_STATUS and LAST_TESTED_COMMIT; gates compare them against HEAD.\n  mkdir -p "$tp_target/.freely/run"\n  cat > "$tp_target/.freely/run/test-gate.env" <<\'TEST_INIT\'\nTEST_STATUS="not_tested"\nLAST_TESTED_AT="1970-01-01T00:00:00Z"\nLAST_TESTED_COMMIT=""\nTEST_INIT\n  echo "  test-pre-merge: initialized test-gate.env (not_tested)"\n  return 0\n}\n\n# ── Recovery: provision only the missing test-pre-merge worktree ──\n# Runs after the helpers are defined and before _require_issue_exists /\n# remote fetch. An interrupted run already owns its dev worktree and raw\n# issue, so re-validating platforms or syncing develop would reintroduce the\n# very network dependency that caused the interruption in the first place.\nif [[ "$resume_mode" -eq 1 ]]; then\n  echo "=== 恢复模式: 补齐缺失的工位与初始化 ==="\n\n  # (1) dev worktree directory was removed but its branch survived.\n  #     The branch already exists, so `git worktree add` MUST NOT use -b.\n  if [[ -z "$_dev_dir" ]]; then\n    _dev_target="$(freely_wt_target_path_for_branch "$dev_branch")"\n    mkdir -p "$(freely_wt_root_dir)"\n    if ! FREELY_WT_CREATE=1 git worktree add "$_dev_target" "$dev_branch"; then\n      echo "恢复失败: dev 工位补建失败" >&2\n      exit 1\n    fi\n    _dev_dir="$_dev_target"\n    echo "  dev 工位已补建: $_dev_dir"\n  fi\n\n  # (2) test worktree: rebuild the directory when missing, otherwise keep\n  #     the registered one. A surviving test branch also means "no -b".\n  if [[ -z "$_test_dir" ]]; then\n    tp_target="$(freely_wt_target_path_for_branch "$test_pre_merge_branch")"\n    mkdir -p "$(freely_wt_root_dir)"\n    if [[ "$_test_exists" -eq 1 ]]; then\n      _created=0\n      FREELY_WT_CREATE=1 git worktree add "$tp_target" "$test_pre_merge_branch" && _created=1\n    else\n      _created=0\n      _create_worktree "$test_pre_merge_branch" "$tp_target" "$dev_branch" && _created=1\n    fi\n    if [[ "$_created" -ne 1 ]]; then\n      echo "恢复失败: test 工位创建失败" >&2\n      git -C "$ROOT_DIR" worktree remove "$tp_target" --force 2>/dev/null || true\n      git -C "$ROOT_DIR" branch -D "$test_pre_merge_branch" 2>/dev/null || true\n      exit 1\n    fi\n    _test_dir="$tp_target"\n    echo "  test 工位已补建: $tp_target"\n  else\n    tp_target="$_test_dir"\n  fi\n\n  # (3) A surviving test directory may be only half-initialised. The marker\n  #     is test-gate.env; re-run the SAME initialisation single source.\n  if [[ "$_test_ready" -eq 0 ]]; then\n    if ! _init_test_worktree_state "$tp_target"; then\n      echo "恢复失败: test 工位初始化失败" >&2\n      git -C "$ROOT_DIR" worktree remove "$tp_target" --force 2>/dev/null || true\n      git -C "$ROOT_DIR" branch -D "$test_pre_merge_branch" 2>/dev/null || true\n      exit 1\n    fi\n    echo "  test 工位初始化已补齐"\n  fi\n\n  # Recovery: the dev worktree ALREADY EXISTS, so reverse-lookup its real\n  # registered path. freely_wt_resolve_target_path() is for a worktree about\n  # to be CREATED: it appends a hash suffix when the target exists, which\n  # would yield a non-existent path here and poison scan_state_worktree.\n  _recovery_dev_path="$(_wt_registered_dir "$dev_branch")" || {\n    echo "恢复失败: 反查 dev 工位失败，git worktree list 中找不到 $dev_branch 的有效工位目录" >&2\n    exit 1\n  }\n  if [[ "$_recovery_dev_path" != "$_dev_dir" ]]; then\n    echo "恢复失败: dev 工位反查结果不一致 ($_dev_dir vs $_recovery_dev_path)" >&2\n    exit 1\n  fi\n  _update_scan_state "$raw_key" "working" "$_recovery_dev_path"\n  cat <<MSG\n\n╔══════════════════════════════════════════════════════════╗\n║  Worktrees recovered                                    ║\n╠══════════════════════════════════════════════════════════╣\n║  dev (kept):      $_recovery_dev_path\n║  test (created):  $tp_target\n║  base:            $dev_branch\n║  raw key:         $raw_key\n╠══════════════════════════════════════════════════════════╣\n║  后续流程不变：cd 到 dev 工位继续 B1/B2/RED/GREEN          ║\n╚══════════════════════════════════════════════════════════╝\nMSG\n  exit 0\nfi\n\n# ── Pre-check: issue must exist ──────────────────────────\n\n_require_issue_exists "$dev_branch" || exit 1\n\n# ── Sync local develop with remote ───────────────────────\necho "=== Syncing local develop ==="\n_github_head=""\n_origin_head=""\ngit fetch github develop 2>/dev/null && _github_head="$(git rev-parse refs/remotes/github/develop 2>/dev/null || true)" || true\ngit fetch origin develop 2>/dev/null && _origin_head="$(git rev-parse refs/remotes/origin/develop 2>/dev/null || true)" || true\nif [[ -n "$_github_head" ]] && [[ -n "$_origin_head" ]] && [[ "$_github_head" != "$_origin_head" ]]; then\n  echo "ERROR: Platform divergence detected" >&2\n  echo "  github: $_github_head" >&2\n  echo "  origin: $_origin_head" >&2\n  echo "  Cannot create worktree. Run: freely develop-push attempt" >&2\n  exit 1\nfi\n_sync_head="${_github_head:-$_origin_head}"\nif [[ -n "$_sync_head" ]]; then\n  if git update-ref refs/heads/develop "$_sync_head" 2>/dev/null; then\n    echo "  develop updated to $(git rev-parse --short develop)"\n  else\n    echo "  warning: sync failed, proceeding with local develop"\n  fi\nelse\n  echo "  warning: no remote develop found, proceeding with local develop"\nfi\n\n# ── Create worktree(s) ───────────────────────────────────\n\n  if [[ "$using_new" -eq 1 ]]; then\n  fix_target="$(freely_wt_resolve_target_path "$dev_branch")"\n  echo "=== Step 1/2: Creating ${prefix} worktree ==="\n  _create_worktree "$dev_branch" "$fix_target" "$base"\n  echo "  ${prefix}: $fix_target (base: $base)"\n\n  # Pull raw issue from inside the fix/feature worktree\n  if [[ "$using_new" -eq 1 ]]; then\n    echo ""\n    echo "=== Pulling raw issue from inside ${prefix} worktree ==="\n    if ! ( cd "$fix_target" && _pull_raw_issue "$raw_key" "$source_val" ); then\n      echo "拒绝创建工位: raw-issue-pull failed" >&2\n      git -C "$ROOT_DIR" worktree remove "$fix_target" --force 2>/dev/null || true\n      git -C "$ROOT_DIR" branch -D "$dev_branch" 2>/dev/null || true\n      return 1\n    fi\n    _fill_platform_ids "$raw_key"\n\t    _update_scan_state "$raw_key" "working" "$fix_target"\n  fi\n\n  tp_target="$(freely_wt_resolve_target_path "$test_pre_merge_branch")"\n  echo ""\n  echo "=== Step 2/2: Creating test-pre-merge worktree (for testing) ==="\n  _create_worktree "$test_pre_merge_branch" "$tp_target" "$dev_branch"\n  echo "  test-pre-merge: $tp_target (base: $dev_branch)"\n\n  # Seed the dev worktree. The test worktree is seeded and fully initialised\n  # by the shared helper — same code path as recovery and legacy 补建.\n  if ! _seed_worktree "$fix_target"; then\n    echo "拒绝创建工位: worktree seed failed" >&2\n    git -C "$ROOT_DIR" worktree remove "$fix_target" --force 2>/dev/null || true\n    git -C "$ROOT_DIR" worktree remove "$tp_target" --force 2>/dev/null || true\n    git -C "$ROOT_DIR" branch -D "$dev_branch" 2>/dev/null || true\n    git -C "$ROOT_DIR" branch -D "$test_pre_merge_branch" 2>/dev/null || true\n    return 1\n  fi\n  if ! _init_test_worktree_state "$tp_target"; then\n    echo "拒绝创建工位: test worktree initialisation failed" >&2\n    git -C "$ROOT_DIR" worktree remove "$fix_target" --force 2>/dev/null || true\n    git -C "$ROOT_DIR" worktree remove "$tp_target" --force 2>/dev/null || true\n    git -C "$ROOT_DIR" branch -D "$dev_branch" 2>/dev/null || true\n    git -C "$ROOT_DIR" branch -D "$test_pre_merge_branch" 2>/dev/null || true\n    return 1\n  fi\n\n  cat <<MSG\n\n╔══════════════════════════════════════════════════════════╗\n║  Worktrees created                                      ║\n╠══════════════════════════════════════════════════════════╣\n║  ${prefix} worktree:     $fix_target\n║  branch:          $dev_branch\n║  base:            $base\n║  skill:           ${skill_path}\n║  source:          ${source_val}\n║                                                        ║\n║  test-pre-merge (testing): $tp_target\n║  branch:          $test_pre_merge_branch\n║  base:            $dev_branch\n╠══════════════════════════════════════════════════════════╣\n║  Merge chain:                                           ║\n║    $dev_branch → develop\n║                                                        ║\n║  test-pre-merge 是丢弃的测试沙箱，不参与合并链             ║\n╚══════════════════════════════════════════════════════════╝\nMSG\n\n  case "$prefix" in\n    fix)\n      cat <<REMINDER\n\n┌─ 下一步 ──────────────────────────────────────────────┐\n│  请遵循 skill:${skill_name} 开展工作                        │\n│                                                          │\n│  进入 ${prefix} 工位开发:                                  │\n│    cd $fix_target                                        │\n│  测试时进入 test-pre-merge 工位:                          │\n│    cd $tp_target                                         │\n│                                                          │\n│  请阅读 skill:${skill_name}                                 │\n│  按其规范流程的完整步骤执行。                                 │\n│  Skill 是流程的唯一权威来源——不依赖本提示的摘要。              │\n└──────────────────────────────────────────────────────────┘\nREMINDER\n      ;;\n    feature)\n      cat <<REMINDER\n\n┌─ 下一步 ──────────────────────────────────────────────┐\n│  请遵循 skill:${skill_name} 开展工作                        │\n│                                                          │\n│  进入 ${prefix} 工位开发:                                  │\n│    cd $fix_target                                        │\n│  测试时进入 test-pre-merge 工位:                          │\n│    cd $tp_target                                         │\n│                                                          │\n│  请阅读 skill:${skill_name}                                 │\n│  按其规范流程的完整步骤执行。                                 │\n│  Skill 是流程的唯一权威来源——不依赖本提示的摘要。              │\n└──────────────────────────────────────────────────────────┘\nREMINDER\n      ;;\n    *)\n      cat <<REMINDER\n\n┌─ 下一步 ───────────────────────────────────────────────┐\n│  进入工位开发:                                            │\n│    cd $fix_target                                        │\n│  测试时进入 test-pre-merge 工位:                          │\n│    cd $tp_target                                         │\n│  仔细阅读 skill: ${skill_path}                             │\n└──────────────────────────────────────────────────────────┘\nREMINDER\n      ;;\n  esac\nelse\n  # legacy 补建：仅当传入分支名是 test-pre-merge-<raw-key>-<slug> 时，\n  # 才按完整测试工位规格创建。base 必须是对应 dev 分支，绝不回退到 develop，\n  # 否则补建出的工位基于错误基线，门禁无法验证该 lane 的改动。\n  legacy_test_pre_merge=0\n  _legacy_dev_base=""\n  if [[ "$dev_branch" == test-pre-merge-* ]]; then\n    legacy_test_pre_merge=1\n    _legacy_raw_key="$(printf \'%s\\n\' "$dev_branch" | sed -E \'s/^test-pre-merge-([0-9]{8}[-T][0-9]{4,6}Z?)-.*/\\1/\')"\n    if [[ -n "$_legacy_raw_key" && "$_legacy_raw_key" != "$dev_branch" ]]; then\n      _legacy_dev_base="$(git branch --format=\'%(refname:short)\' | grep -E "^(fix|feature|hotfix)/raw-${_legacy_raw_key}-" | head -1 || true)"\n    fi\n    if [[ -z "$_legacy_dev_base" ]]; then\n      echo "拒绝补建: 找不到 raw-${_legacy_raw_key:-?} 对应的 dev 分支" >&2\n      echo "  legacy 补建必须以对应 fix/feature/hotfix 分支为 base，不会回退到 develop。" >&2\n      exit 1\n    fi\n    base="$_legacy_dev_base"\n  fi\n\n  tp_target="$(freely_wt_resolve_target_path "$dev_branch")"\n  _create_worktree "$dev_branch" "$tp_target" "$base"\n  if [[ "$legacy_test_pre_merge" -eq 1 ]]; then\n    if ! _init_test_worktree_state "$tp_target"; then\n      echo "拒绝补建: test 工位初始化失败" >&2\n      git -C "$ROOT_DIR" worktree remove "$tp_target" --force 2>/dev/null || true\n      git -C "$ROOT_DIR" branch -D "$dev_branch" 2>/dev/null || true\n      exit 1\n    fi\n  fi\n\n  cat <<MSG\nCreated worktree:\n  $tp_target\nBranch:\n  $dev_branch\nExecution base:\n  $base\n\n  wt-create 标准模式: --raw-key <key> --source platform --kind <fix|feature|hotfix> --slug <slug>\n    使用场景：从 raw issue 创建 fix|hotfix|feature + test-pre-merge 工位对，走完整 IBM 治理链路\n    可重跑恢复：Step 2 之前中断后用相同参数重跑，只补建缺失的 test 工位；双工位齐全时 no-op\n  wt-create legacy 模式: <branch>\n    使用场景：传入 test-pre-merge-<raw-key>-<slug> 分支名时补建测试工位（自动以对应 dev 分支为 base，\n              并执行 seed / .freely 状态 / test-gate.env 初始化）；纯文档修改、init develop、release 分支\nMSG\nfi\n'

