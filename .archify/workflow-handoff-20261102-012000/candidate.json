  "cards": [
    {
      "dot": "cyan",
      "title": "信封里必须有的",
      "items": [
        "工单卡 + 原始 Trigger 引用，不让接收方重新猜",
        "状态 + ≤600 字摘要 + 超长部分的读指针",
        "问题只放一个，原样转发，不改写"
      ]
    },
    {
      "dot": "amber",
      "title": "队列语义",
      "items": [
        "pending / sent / failed 三态可见，能查“投递未达”",
        "同一工单 + 同一会话内保序",
        "无空闲 slot 用 Later，不消耗失败次数"
      ]
    },
    {
      "dot": "rose",
      "title": "owner 语义",
      "items": [
        "工单自持 session，席位只当容量，不承载身份",
        "handback 只允许一次；别人还持有则返回 queued:false",
        "回执一次，避免“反复交接”变成反复确认"
      ]
    }
