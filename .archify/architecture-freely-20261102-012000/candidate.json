  "cards": [
    {
      "dot": "cyan",
      "title": "结构性优势",
      "items": [
        "门禁在宿主机：.githooks 自校验 core.hooksPath，agent 绕不过",
        "工位隔离：dev 与 test 是两条独立分支，验证不过不进 develop",
        "证据落在 git 与 PR，不靠会话记忆，换模型不失忆"
      ]
    },
    {
      "dot": "rose",
      "title": "结构性弱点",
      "items": [
        "三处真相：docs 前页 / freely.db / git，靠 raw_key 约定拼接",
        "scan 每轮全量读 open issue，没有游标与事件去重",
        "worker_01..10 是可复用席位，绑定会随会话漂移"
      ]
    },
    {
      "dot": "amber",
      "title": "交接断点（已定位）",
      "items": [
        "A2A 只写库 + 内存 SSE，断线不重放，没有 outbox 与回执",
        "_do_new 引用未定义 message，跨工具或 resume 失败必抛",
        "pgrep -f session_id 判活，误标 DEAD 后直接清会话绑定"
      ]
    },
    {
      "dot": "violet",
      "title": "一条隐含约定",
      "items": [
        "raw issue ↔ worktree 靠目录名子串匹配（raw_key in name），不是外键",
        "命名一旦漂移，scan 与派工都会找不到位置"
      ]
    }
  ]
