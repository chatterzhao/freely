#!/usr/bin/env python3
"""Compare cache hit rates across direct fresh/resume and ACP new/resume modes.
Usage: ./bin/test-cache-hit [--quick]"""
import subprocess, json, time, os, sys, tempfile

FLASH_SETTINGS = os.path.expanduser("~/.claude/settings_deepseek_flash.json")
ACP_BIN = "claude-agent-acp"
PROJECT = os.getcwd()
QUICK = "--quick" in sys.argv

PROMPT_SMALL = "Reply with exactly one word: OK"
PROMPT_CONTEXT = "You are a helpful assistant. The project is Freely, an autonomous AI development tool. It manages issues via a lifecycle system with raw-issues, B1 brainstorms, and I-* linked issues. Please reply with exactly one word: ACKNOWLEDGED"

def run_direct(prompt, mode="fresh", session_id=None):
    cmd = ["claude", "--settings", FLASH_SETTINGS, "--dangerously-skip-permissions", "-p", "--output-format", "json"]
    if mode == "resume" and session_id: cmd += ["--resume", session_id]
    elif session_id: cmd += ["--session-id", session_id]
    start = time.time()
    r = subprocess.run(cmd, input=prompt, capture_output=True, text=True, timeout=60)
    elapsed = time.time() - start
    usage = {}; sid = ""
    try:
        data = json.loads(r.stdout)
        usage = data.get("usage", {})
        sid = data.get("session_id", "")
    except: pass
    return {"mode": f"direct {mode}", "elapsed": elapsed, "session_id": sid,
            "in_tokens": usage.get("input_tokens", 0) or 0,
            "cache_read": usage.get("cache_read_input_tokens", 0) or 0,
            "cache_write": usage.get("cache_creation_input_tokens", 0) or 0,
            "out_tokens": usage.get("output_tokens", 0) or 0}

def run_acp(prompt, mode="new", session_id=None):
    with tempfile.NamedTemporaryFile(mode='w', suffix='.txt', delete=False) as f:
        f.write(prompt); pf = f.name
    cmd = ["python3", f"{PROJECT}/docs/system/workspace/scripts/runtime/run-acp-prompt.py",
           "--agent", ACP_BIN, "--cwd", PROJECT, "--prompt-file", pf, "--mode", "auto"]
    if mode == "resume" and session_id: cmd += ["--resume", session_id]
    elif session_id: cmd += ["--session-id", session_id]
    start = time.time()
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    elapsed = time.time() - start
    os.unlink(pf)
    sid = ""
    for line in r.stdout.split("\n") + r.stderr.split("\n"):
        if "session id:" in line: sid = line.split("session id:")[-1].strip().split()[0]
    return {"mode": f"ACP {mode}", "elapsed": elapsed, "session_id": sid,
            "in_tokens": 0, "cache_read": 0, "cache_write": 0, "out_tokens": len(r.stdout)}

def cost_estimate(r):
    cr = r.get("cache_read", 0)
    cw = r.get("cache_write", 0)
    inp = r.get("in_tokens", 0)
    out = r.get("out_tokens", 0)
    return (cr * 0.0028 + max(0, inp - cr) * 0.14 + out * 0.28) / 1_000_000

print("=" * 70)
print("Cache Hit Test — DeepSeek V4 Flash")
print("=" * 70)

results = []
# Test 1-2: Direct fresh + resume
r = run_direct(PROMPT_SMALL, "fresh", "cache-test-d001")
results.append(r)
if r["session_id"]:
    results.append(run_direct(PROMPT_SMALL, "resume", r["session_id"]))

if not QUICK:
    # Test 3-4: Direct context-heavy
    r = run_direct(PROMPT_CONTEXT, "fresh", "cache-test-d003")
    results.append(r)
    if r["session_id"]:
        results.append(run_direct(PROMPT_CONTEXT, "resume", r["session_id"]))

# Test 5-6: ACP new + resume
r = run_acp(PROMPT_CONTEXT if not QUICK else PROMPT_SMALL, "new", "")
results.append(r)
if r["session_id"]:
    results.append(run_acp(PROMPT_SMALL, "resume", r["session_id"]))

print(f"\n{'Mode':<22} {'Time':>6} {'InTok':>7} {'CacheR':>7} {'CacheW':>7} {'OutTok':>7}  {'Cost':>8}")
print("-" * 75)
for r in results:
    print(f"{r['mode']:<22} {r['elapsed']:>5.1f}s {r['in_tokens']:>7} {r['cache_read']:>7} {r['cache_write']:>7} {r['out_tokens']:>7}  ${cost_estimate(r):>7.5f}")

print(f"\nCache read tokens show DeepSeek prompt cache hits.")
print(f"Higher cache_read = more cost savings (~100x cheaper than cache miss).")
