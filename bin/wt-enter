#!/usr/bin/env bash
set -euo pipefail

freely_self_path() {
  if [[ -n "${BASH_SOURCE[0]:-}" ]]; then
    printf '%s\n' "${BASH_SOURCE[0]}"
    return 0
  fi
  if [[ -n "${ZSH_VERSION:-}" ]]; then
    eval 'printf "%s\n" "${(%):-%x}"'
    return 0
  fi
  return 1
}

freely_is_sourced() {
  if [[ -n "${ZSH_VERSION:-}" ]]; then
    [[ "${ZSH_EVAL_CONTEXT:-}" == *:file* ]]
    return
  fi
  [[ "${BASH_SOURCE[0]:-}" != "$0" ]]
}

SELF_PATH="$(freely_self_path)" || { echo "Unable to determine wt-enter path." >&2; return 1 2>/dev/null || exit 1; }
ROOT_DIR="$(cd "$(dirname "$SELF_PATH")/.." && pwd -P)"
# shellcheck disable=SC1091
if freely_is_sourced; then
  # shellcheck disable=SC1091
  source "$ROOT_DIR/docs/system/workspace/scripts/worktree/wt-enter" "$@"
else
  # shellcheck disable=SC1091
  "$ROOT_DIR/docs/system/workspace/scripts/worktree/wt-enter" "$@"
fi
