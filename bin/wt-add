#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<USAGE
Usage:
  source bin/wt-add [branch] -- <git-add-args>

Examples:
  source bin/wt-add feature/my-task -- -A
  source bin/wt-add -- docs/README.md

Notes:
- Git has no native pre-add hook.
- This helper performs worktree check/entry before running git add.
USAGE
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  echo "Please run with: source bin/wt-add [branch] -- <git-add-args>" >&2
  exit 1
fi

branch=""
if [[ $# -gt 0 && "$1" != "--" ]]; then
  branch="$1"
  shift
fi

[[ "${1:-}" == "--" ]] || { usage; return 1; }
shift

# shellcheck disable=SC1091
source ./bin/worktree-common.sh
freely_wt_assert_strict_root || return 1

if [[ -z "$branch" ]]; then
  branch="$(freely_wt_current_branch)"
fi

[[ -n "$branch" ]] || { echo "No branch detected." >&2; return 1; }

case "$branch" in
  main|develop|pre-develop)
    cat <<MSG >&2
Add blocked: '$branch' is protected.
Please create a feature branch from pre-develop, then run add in its worktree.

Run:
  git branch feature/<task-name> pre-develop
  source ./bin/wt-enter feature/<task-name>

The hook will auto-create the worktree and cd into that new directory.
Do not keep working in the current directory.
MSG
    return 1
    ;;
esac

freely_wt_assert_existing_in_strict_root "$branch" || return 1

if freely_wt_is_primary_worktree; then
  # shellcheck disable=SC1091
  source ./bin/wt-enter "$branch"
fi

git add "$@"
echo "git add done on branch '$branch' at $(pwd -P)"
