#!/usr/bin/env bash
# issue-sync: local docs/B1-docs/ ↔ platform (GitHub/Gitee) bridge.
#
# This is the ONLY code that touches platform APIs. AI never directly
# reads/writes GitHub or Gitee — it works on docs/B1-docs/ and this
# tool handles the local→platform sync.
#
# Issue model:
#   raw-*  kind: raw     B1_IBM input, created from chat/platform scan
#   I-*    kind: linked  B2_IBM input, promoted from candidate, on milestone
#
# Platform format:
#   raw:  [RAW-20260428-0542] <title>   labels: kind/raw, phase/proposed
#   I-*:  [I-20260426-0000-A] <title>   labels: kind/linked, phase/<state>
#
# Lifecycle:
#   chat → raw proposed → B1 promotion_started (1:N children)
#   → promotion_finalized (absorbed/open) → configured-platform close (absorbed/closed)
#
# Usage:
#   bin/issue-sync create  <local_id>     Create platform issue (idempotent)
#   bin/issue-sync update  <local_id>     Update platform issue (skips if unchanged)
#   bin/issue-sync comment <local_id>     Push unsynced comments (skips if none)
#   bin/issue-sync close   <local_id>     Close platform issue
#   bin/issue-sync promote <raw_id> <I_id>  Close raw, create I-* with cross-ref
#   bin/issue-sync status  <local_id>     Show sync status
#   bin/issue-sync batch                  Sync all changed issues since last scan
#   bin/issue-sync scan                   Show which issues changed since last scan
#
# Layout (#4166): this file only resolves paths, guards the branch and
# dispatches. Every command and helper lives in bin/issue-sync.d/*.sh, so a
# single subcommand can be sourced and tested without loading the other eight.
set -euo pipefail

# ROOT_DIR is overridable so tests can load this file against an isolated tree.
ROOT_DIR="${ROOT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
ISSUES_DIR="$ROOT_DIR/docs/B1-docs"

# ── YAML helpers — single owner: lifecycle/frontmatter_contract_cli.py ──
_FM_CLI="$ROOT_DIR/docs/system/workspace/scripts/lifecycle/frontmatter_contract_cli.py"

# ── modules ──────────────────────────────────────────────
# Resolved from this file, not from ROOT_DIR: a test fixture that copies
# bin/issue-sync and bin/issue-sync.d next to each other keeps working.
_ISSUE_SYNC_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
_ISSUE_SYNC_LIB="$_ISSUE_SYNC_HOME/issue-sync.d"

_ISSUE_SYNC_MODULES=(
  lib-frontmatter.sh
  lib-state.sh
  lib-replica.sh
  lib-content.sh
  lib-platform.sh
  cmd-create.sh
  cmd-update.sh
  cmd-comment.sh
  cmd-close.sh
  cmd-promote.sh
  cmd-promote-finalize.sh
  cmd-batch.sh
  cmd-scan.sh
  cmd-status.sh
)

_issue_sync_load_modules() {
  local module
  for module in "${_ISSUE_SYNC_MODULES[@]}"; do
    if [[ ! -f "$_ISSUE_SYNC_LIB/$module" ]]; then
      echo "[ERROR] issue-sync module missing: $_ISSUE_SYNC_LIB/$module" >&2
      echo "  bin/issue-sync.d/ must ship next to bin/issue-sync" >&2
      exit 1
    fi
    # shellcheck source=/dev/null
    source "$_ISSUE_SYNC_LIB/$module"
  done
}

# Re-derive every path that was bound from ROOT_DIR at load time. `--project`
# swaps the tree afterwards, so a stale binding would write the caller's
# scan-state into the wrong repo.
_issue_sync_rebind_paths() {
  ISSUES_DIR="$ROOT_DIR/docs/B1-docs"
  _FM_CLI="$ROOT_DIR/docs/system/workspace/scripts/lifecycle/frontmatter_contract_cli.py"
  SCAN_STATE="$ISSUES_DIR/.scan-state"
  _GUARD_SCRIPT="$ROOT_DIR/docs/system/workspace/scripts/sync/replica_guard.py"
  _ADAPTER_SCRIPT="$ROOT_DIR/docs/system/workspace/scripts/sync/platform-adapter.py"
  _ISSUE_CREATE_CONTRACT="$ROOT_DIR/docs/system/workspace/scripts/sync/issue_create_contract.py"
}

_issue_sync_load_modules

# ── main ─────────────────────────────────────────────────

main() {
  local action="" local_id="" extra=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) ROOT_DIR="$2"; _issue_sync_rebind_paths; shift 2 ;;
      create|update|comment|close|promote|promote-finalize|status|batch|scan)
        action="$1"; shift; break ;;
      *) echo "[ERROR] unknown action: $1" >&2; exit 1 ;;
    esac
  done

  local_id="${1:-}"
  extra="${2:-}"
  [[ -n "$action" ]] || { echo "Usage: issue-sync <create|update|comment|close|promote|status|batch|scan> <local_id> [extra]" >&2; exit 1; }
  if [[ "$action" != "batch" && "$action" != "scan" ]]; then
    [[ -n "$local_id" ]] || { echo "[ERROR] missing local_id" >&2; exit 1; }
  fi
  [[ -d "$ISSUES_DIR" ]] || { echo "[ERROR] $ISSUES_DIR not found" >&2; exit 1; }

  # Guard: refuse to modify files on protected branches.
  # All issue modifications must happen in worktrees (fix/* or feature/*).
  # Callers on develop must use: issue-sync --project /path/to/worktree <action> <local_id>
  _guard_branch=$(git -C "$ROOT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
  case "$_guard_branch" in
    main|develop|test-pre-merge-*)
      printf >&2 '%s\n' \
        "[ERROR] issue-sync refuses to run on protected branch: $_guard_branch" \
        "" \
        "Protected branches (main, develop, test-pre-merge-*) must not be modified directly." \
        "All code and issue changes go through worktrees:" \
        "" \
        "  Workflow:  skill:freely-workflow-guarded-execution (fix and feature share it)" \
        "" \
        "Workflow:" \
        "  1. feedback → create raw issue in docs/B1-docs/" \
        "  2. wt-create --raw-key <key> --source platform --kind <fix|feature|hotfix> --slug <slug>" \
        "  3. Fix/develop in fix/* or feature/* worktree → git commit" \
        "  4. pr-create-guarded → pull develop → 冲突处理 → dry-run gate → push → gh pr create" \
        "  5. pr-merge-guarded develop <branch> → PR gate → promotion gate → merge" \
        "  6. wt-close <branch>" \
        "" \
        "Or to invoke from a worktree directly:" \
        "  issue-sync --project /path/to/worktree <action> <local_id>"
      exit 1
      ;;
  esac

  GH_REPO="${GH_REPO:-$(_gh_repo)}"
  GITEE_REPO="${GITEE_REPO:-$(_gitee_repo)}"

  case "$action" in
    create)  cmd_create "$local_id" ;;
    update)  cmd_update "$local_id" ;;
    comment) cmd_comment "$local_id" ;;
    close)   cmd_close "$local_id" "$extra" ;;
    promote) cmd_promote "$local_id" "$extra" ;;
    promote-finalize) cmd_promote_finalize "$local_id" ;;
    status)  cmd_status "$local_id" ;;
    batch)   cmd_batch ;;
    scan)    cmd_scan ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
