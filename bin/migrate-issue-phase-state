#!/usr/bin/env python3
"""Migration: eliminate residual `status` field, ensure `phase_state` + `platform_state`.

Idempotent. Safe to run multiple times.
- raw-*: if both status + phase_state → remove status (keep phase_state)
- raw-*: if only status → rename to phase_state
- I-*: if status exists → remove it (phase_state is canonical)
- all: add platform_state if missing
"""
from pathlib import Path
import re, subprocess, sys

PROJECT = Path(sys.argv[1]) if len(sys.argv) > 1 else Path.cwd()
ISSUES_DIR = PROJECT / "docs" / "issues"


def github_state(issue_number: str) -> str:
    """Query GitHub issue state. Returns 'open', 'closed', or '' on failure."""
    try:
        r = subprocess.run(
            ["gh", "issue", "view", issue_number, "--repo", "chatterzhao/freely",
             "--json", "state"], capture_output=True, text=True, timeout=5)
        return "closed" if "CLOSED" in r.stdout else "open" if "OPEN" in r.stdout else ""
    except Exception:
        return ""


count = 0
for d in sorted(ISSUES_DIR.iterdir()):
    if not d.is_dir():
        continue
    mf = d / "issue.md"
    if not mf.is_file():
        continue
    text = mf.read_text(encoding="utf-8")
    parts = text.split("---", 2)
    if len(parts) < 3:
        continue
    fm = parts[1]
    changed = False
    name = d.name

    has_status = bool(re.search(r'^status:', fm, re.MULTILINE))
    has_phase = "phase_state:" in fm

    # 1. Eliminate status field
    if name.startswith("raw-"):
        if has_status and has_phase:
            # Both exist → remove redundant status
            fm = re.sub(r'^status:.*\n', '', fm, flags=re.MULTILINE)
            changed = True
            print(f"[migrate] {name}: removed redundant status (phase_state exists)")
        elif has_status and not has_phase:
            # Only status → rename to phase_state
            fm = re.sub(r'^status:', 'phase_state:', fm, flags=re.MULTILINE)
            changed = True
            print(f"[migrate] {name}: status → phase_state")
    elif name.startswith("I-"):
        if has_status:
            # I-* uses phase_state exclusively → remove status
            fm = re.sub(r'^status:.*\n', '', fm, flags=re.MULTILINE)
            changed = True
            print(f"[migrate] {name}: removed status (I-* uses phase_state)")

    # 2. Add platform_state if missing
    if "platform_state:" not in fm:
        m = re.search(r'issue_id:\s*["\']?(\d+)["\']?', fm)
        if m and m.group(1):
            state = github_state(m.group(1))
            fm = fm.rstrip() + f"\nplatform_state: {state}\n"
        else:
            fm = fm.rstrip() + "\nplatform_state: ''\n"
        changed = True
        print(f"[migrate] {name}: platform_state added")

    if changed:
        mf.write_text(f"---{fm}---{parts[2]}", encoding="utf-8")
        count += 1

print(f"[migrate] done: {count} files changed")
