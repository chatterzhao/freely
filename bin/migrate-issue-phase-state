#!/usr/bin/env python3
"""Audit legacy phase metadata without rewriting lifecycle state.

Historical bulk migration inferred platform state and appended fields. That is
unsafe for strict raw schema and cannot prove canonical absorption. This command
is intentionally read-only; lifecycle owners perform any required transition.
"""
from __future__ import annotations

import sys
from pathlib import Path

import yaml

PROJECT = Path(sys.argv[1]) if len(sys.argv) > 1 else Path.cwd()
ISSUES_DIR = PROJECT / "docs" / "B1-docs"
LIFECYCLE_DIR = PROJECT / "docs" / "system" / "workspace" / "scripts" / "lifecycle"
sys.path.insert(0, str(LIFECYCLE_DIR))

from raw_metadata_contract import MetadataValidationError, normalize, validate


def read_frontmatter(path: Path) -> dict:
    parts = path.read_text(encoding="utf-8").split("---", 2)
    if len(parts) < 3:
        return {}
    value = yaml.safe_load(parts[1]) or {}
    return value if isinstance(value, dict) else {}


def main() -> int:
    findings: list[str] = []
    if not ISSUES_DIR.is_dir():
        print(f"[phase-audit] issue directory not found: {ISSUES_DIR}", file=sys.stderr)
        return 1

    for issue_file in sorted(ISSUES_DIR.glob("*/issue.md")):
        name = issue_file.parent.name
        metadata = read_frontmatter(issue_file)
        if not metadata:
            continue
        if name.startswith("raw-"):
            view = normalize(metadata)
            if view["strict_schema"]:
                try:
                    validate(metadata, base_dir=PROJECT)
                except MetadataValidationError as error:
                    findings.append(f"{name}: invalid strict metadata: {error}")
            elif "status" in metadata or "platform_state" not in metadata:
                findings.append(
                    f"{name}: legacy metadata requires explicit lifecycle review; no automatic migration"
                )
        elif name.startswith("I-") and "status" in metadata:
            findings.append(f"{name}: linked legacy status requires its owner workflow")

    for finding in findings:
        print(f"[phase-audit] {finding}")
    print(f"[phase-audit] read-only: {len(findings)} finding(s), 0 files changed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
