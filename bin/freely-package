#!/usr/bin/env bash
set -euo pipefail

# freely-package: 从当前项目打包 Freely 版本
#
# 用法:
#   ./bin/freely-package --version <ver> [--output <dir>]
#
# 版本号:
#   nightly:  YYYYMMDD-nightly
#   stable:   YYYY.MM.DD-stable
#
# 示例:
#   ./bin/freely-package --version 20260501-nightly
#   ./bin/freely-package --version 2026.05.01-stable --output ~/.freely/versions/2026.05.01-stable

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
ALLOWLIST="$ROOT_DIR/docs/system/workspace/package-allowlist.txt"
VERSION=""
OUTPUT=""

usage() {
  cat <<'EOF'
Usage: freely-package --version <ver> [--output <dir>]

  --version <ver>  版本号 (YYYYMMDD-nightly 或 YYYY.MM.DD-stable)
  --output <dir>   输出目录 (默认: ~/.freely/versions/<ver>)
EOF
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --version) VERSION="${2:-}"; shift 2 ;;
    --output) OUTPUT="${2:-}"; shift 2 ;;
    *) usage ;;
  esac
done

[[ -n "$VERSION" ]] || { echo "[ERROR] --version is required" >&2; usage; }
[[ -f "$ALLOWLIST" ]] || { echo "[ERROR] allowlist not found: $ALLOWLIST" >&2; exit 1; }

if [[ -z "$OUTPUT" ]]; then
  OUTPUT="$HOME/.freely/versions/$VERSION"
fi

echo "[package] version: $VERSION"
echo "[package] output: $OUTPUT"

# 清理旧输出
rm -rf "$OUTPUT"
mkdir -p "$OUTPUT"

# 按 allowlist 复制文件
copied=0
while IFS= read -r line; do
  # 跳过空行和注释
  [[ -n "$line" ]] || continue
  [[ "$line" != "#"* ]] || continue

  src="$ROOT_DIR/$line"

  if [[ "$line" == */ ]]; then
    # 目录：递归复制
    if [[ -d "$src" ]]; then
      dst="$OUTPUT/$line"
      mkdir -p "$(dirname "$dst")"
      cp -R "$src" "$dst"
      count=$(find "$src" -type f | wc -l | tr -d ' ')
      copied=$((copied + count))
      echo "  dir  $line ($count files)"
    else
      echo "  [WARN] missing dir: $line"
    fi
  else
    # 文件
    if [[ -f "$src" ]]; then
      dst="$OUTPUT/$line"
      mkdir -p "$(dirname "$dst")"
      cp "$src" "$dst"
      copied=$((copied + 1))
    else
      echo "  [WARN] missing file: $line"
    fi
  fi
done < "$ALLOWLIST"

# 写入版本文件
echo "FREELY_VERSION=$VERSION" > "$OUTPUT/.freely_version"
echo "FREELY_PACKAGED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$OUTPUT/.freely_version"
echo "FREELY_PACKAGED_FROM=$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || echo 'unknown')" >> "$OUTPUT/.freely_version"

echo "[package] done: $copied files → $OUTPUT"
echo "[package] version: $VERSION"
