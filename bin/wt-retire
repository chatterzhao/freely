#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<USAGE
Usage:
  ./bin/wt-retire <branch> [--into <target-branch>] [--delete-remote] [--force-unmerged]

Behavior:
- checks whether <branch> is merged into <target-branch>
- removes branch worktree if present
- deletes local branch
- optionally deletes remote branch (origin)

Safety:
- if branch is NOT merged, deletion is blocked by default
- unmerged deletion requires explicit flag: --force-unmerged
USAGE
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" || $# -lt 1 ]]; then
  usage
  exit 0
fi

branch="$1"
shift

target_branch=""
delete_remote=0
force_unmerged=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --into)
      target_branch="${2:-}"
      [[ -n "$target_branch" ]] || { echo "Missing value for --into" >&2; exit 1; }
      shift 2
      ;;
    --delete-remote)
      delete_remote=1
      shift
      ;;
    --force-unmerged)
      force_unmerged=1
      shift
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

[[ -f "./bin/worktree-common.sh" ]] || { echo "Run from repo root." >&2; exit 1; }
# shellcheck disable=SC1091
source ./bin/worktree-common.sh

case "$branch" in
  main|develop|pre-develop)
    echo "Refusing to retire protected branch: $branch" >&2
    exit 1
    ;;
esac

git show-ref --verify --quiet "refs/heads/$branch" || {
  echo "Branch not found: $branch" >&2
  exit 1
}

if [[ -z "$target_branch" ]]; then
  case "$branch" in
    feature/*)
      if git show-ref --verify --quiet refs/heads/pre-develop; then
        target_branch="pre-develop"
      elif git show-ref --verify --quiet refs/heads/develop; then
        target_branch="develop"
      else
        target_branch="main"
      fi
      ;;
    release/*)
      target_branch="main"
      ;;
    hotfix/*)
      if git show-ref --verify --quiet refs/heads/main; then
        target_branch="main"
      else
        target_branch="develop"
      fi
      ;;
    *)
      if git show-ref --verify --quiet refs/heads/pre-develop; then
        target_branch="pre-develop"
      elif git show-ref --verify --quiet refs/heads/develop; then
        target_branch="develop"
      else
        target_branch="main"
      fi
      ;;
  esac
fi

git show-ref --verify --quiet "refs/heads/$target_branch" || {
  echo "Target branch not found: $target_branch" >&2
  exit 1
}

is_merged=0
if git merge-base --is-ancestor "$branch" "$target_branch"; then
  is_merged=1
fi

if [[ $is_merged -eq 0 && $force_unmerged -ne 1 ]]; then
  cat >&2 <<MSG
Retire blocked: '$branch' is not merged into '$target_branch'.
If this branch is confirmed unnecessary, re-run with explicit force:
  ./bin/wt-retire $branch --into $target_branch --force-unmerged
MSG
  exit 1
fi

existing_wt="$(freely_wt_existing_for_branch "$branch")"
if [[ -n "$existing_wt" ]]; then
  current_path="$(pwd -P)"
  if [[ "$current_path" == "$existing_wt" ]]; then
    cat >&2 <<MSG
Retire blocked: you are inside the target worktree.
Current: $current_path
Please run from another worktree (for example pre-develop) and retry.
MSG
    exit 1
  fi

  echo "Removing worktree: $existing_wt"
  git worktree remove "$existing_wt"
fi

if [[ $is_merged -eq 1 ]]; then
  echo "Deleting local branch (merged): $branch"
  git branch -d "$branch"
else
  echo "Deleting local branch (force, unmerged): $branch"
  git branch -D "$branch"
fi

if [[ $delete_remote -eq 1 ]]; then
  if git remote get-url origin >/dev/null 2>&1; then
    echo "Deleting remote branch: origin/$branch"
    git push origin --delete "$branch"
  else
    echo "Skip remote deletion: origin not configured"
  fi
fi

echo "Retire done: branch=$branch merged_into=$target_branch force_unmerged=$force_unmerged delete_remote=$delete_remote"
