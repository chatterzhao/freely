#!/usr/bin/env bash
# deploy-agents: deploy Freely agent definitions to AI tool agent directories
set -euo pipefail

usage() {
  cat <<USAGE
Usage: ./bin/deploy-agents [--tools <name,...>] [--dry-run]

Deploy agent definitions from docs/system/workspace/agents/freely-*.md
to AI tool agent directories so tools can load them as subagents.

Options:
  --tools <tools>  Comma-separated tool names (default: from FREELY_TOOLS or "claude")
  --dry-run        Show what would be deployed without writing.

Supported tools:
  claude  → ~/.claude/agents/
  codex   → ~/.codex/agents/

Examples:
  ./bin/deploy-agents --tools claude,codex
  ./bin/deploy-agents --tools claude --dry-run
USAGE
}

dry_run=0
tools=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --tools)
      tools="${2:-}"
      [[ -n "$tools" ]] || { echo "Missing value for --tools" >&2; exit 1; }
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --help|-h)
      usage; exit 0
      ;;
    *)
      echo "Unknown: $1" >&2; usage; exit 1
      ;;
  esac
done

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SRC="$ROOT_DIR/docs/system/workspace/agents"
[[ -d "$SRC" ]] || { echo "Agent source directory not found: $SRC" >&2; exit 1; }

# Resolve default tools
if [[ -z "$tools" ]]; then
  tools="${FREELY_TOOLS:-}"
fi
if [[ -z "$tools" ]]; then
  for config in "${HOME}/.freely/config.env" "${HOME}/.config/freely/config.env"; do
    if [[ -f "$config" ]]; then
      tools=$(grep "^FREELY_TOOLS=" "$config" 2>/dev/null | cut -d= -f2 | tr -d '"' | tr -d "'" || true)
      [[ -n "$tools" ]] && break
    fi
  done
fi
[[ -z "$tools" ]] && tools="claude"

tool_dir() {
  case "$1" in
    claude) echo "${HOME}/.claude/agents" ;;
    codex)  echo "${HOME}/.codex/agents" ;;
    *)      echo "" ;;
  esac
}

deploy_to() {
  local tool_name="$1" dst="$2"
  local deployed=0 updated=0

  echo "=== $tool_name → $dst ==="

  for agent_file in "$SRC"/freely-*.md; do
    [[ -f "$agent_file" ]] || continue

    name="$(basename "$agent_file" .md)"
    dst_file="$dst/$name.md"

    if [[ "$dry_run" -eq 1 ]]; then
      if [[ -f "$dst_file" ]]; then
        if ! diff -q "$agent_file" "$dst_file" >/dev/null 2>&1; then
          echo "  UPDATE  $name"
        else
          echo "  OK     $name"
        fi
      else
        echo "  CREATE  $name"
      fi
      deployed=$((deployed + 1))
      continue
    fi

    mkdir -p "$dst"
    if [[ -f "$dst_file" ]]; then
      if ! diff -q "$agent_file" "$dst_file" >/dev/null 2>&1; then
        cp "$agent_file" "$dst_file"
        echo "  UPDATE  $name"
        updated=$((updated + 1))
      fi
    else
      cp "$agent_file" "$dst_file"
      echo "  CREATE  $name"
    fi
    deployed=$((deployed + 1))
  done

  echo "  deployed=$deployed  updated=$updated"
  echo ""
}

IFS=',' read -ra TOOL_LIST <<< "$tools"
for t in "${TOOL_LIST[@]}"; do
  t=$(echo "$t" | xargs)
  d=$(tool_dir "$t")
  if [[ -z "$d" ]]; then
    echo "SKIP unsupported tool: $t" >&2
    continue
  fi
  deploy_to "$t" "$d"
done
