#!/usr/bin/env bash
set -euo pipefail

# freely-review — unified Reviewer entry point for both Worker and Manager.
#
# Worker caller (ACP sync):
#   bin/freely-review --caller worker --agent-id worker_03 --raw-key <key>
#   Pre-check: test worktree EXISTS + clean + sync
#
# Manager caller (A2A async):
#   bin/freely-review --caller manager --agent-id worker_03 --raw-key <key>
#   Pre-check: test worktree MUST NOT exist (wt-close complete)

ROOT_DIR=""
if _dev_wt=$(git worktree list --porcelain 2>/dev/null | awk '$1=="worktree"{wt=$2} $1=="branch"&&$2=="refs/heads/develop"{print wt;exit}'); then
  ROOT_DIR="$_dev_wt"
fi
[[ -z "$ROOT_DIR" ]] && ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$ROOT_DIR" ]] || { echo "ERROR: not in a git repository" >&2; exit 1; }

AGENT_TABLE="$ROOT_DIR/.freely/agent-table.toml"
AGENT_QUERY="$ROOT_DIR/bin/agent-table-query"
ACP_CLIENT="$ROOT_DIR/docs/system/workspace/scripts/runtime/run-acp-prompt.py"
MAX_ROUNDS=3

caller=""
agent_id=""
raw_key=""
reviewer_slot="${REVIEWER_AGENT_SLOT:-}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --caller) caller="${2:-}"; shift 2 ;;
    --agent-id) agent_id="${2:-}"; shift 2 ;;
    --raw-key) raw_key="${2:-}"; shift 2 ;;
    --slot) reviewer_slot="${2:-}"; shift 2 ;;
    *) echo "Unknown: $1" >&2; exit 1 ;;
  esac
done

[[ -n "$caller" && -n "$agent_id" && -n "$raw_key" ]] || {
  echo "Usage: freely-review --caller worker|manager --agent-id <id> --raw-key <key>" >&2
  exit 1
}

# ── Resolve reviewer from agent-table ──
if [[ -x "$AGENT_QUERY" ]]; then
  _rev_info=$("$AGENT_QUERY" --get-reviewer "$agent_id" 2>/dev/null || true)
  if [[ -n "$_rev_info" ]]; then
    _rev_id=$(echo "$_rev_info" | python3 -c "import json,sys; print(json.load(sys.stdin).get('id',''))" 2>/dev/null || true)
    [[ -z "$reviewer_slot" ]] && reviewer_slot=$(echo "$_rev_info" | python3 -c "import json,sys; print(json.load(sys.stdin).get('slot',''))" 2>/dev/null || true)
    echo "freely-review: caller=$caller worker=$agent_id reviewer=$_rev_id slot=$reviewer_slot"
  fi
fi
# agent-table is the source of truth for reviewer_slot.
# AGENT_AI_TOOL is resolved from agent-table at load_config time.
# AGENT_AI_TOOL must be set by agent-table — no fallback.
[[ -z "$reviewer_slot" ]] && reviewer_slot="${AGENT_AI_TOOL:-claude}"

# ── Pre-checks ──
cd "$ROOT_DIR" || { echo "Error: cannot cd to $ROOT_DIR" >&2; exit 1; }

_test_wt=$(git worktree list --porcelain 2>/dev/null | awk -v k="test-pre-merge-$raw_key" '
  $1=="worktree" { wt=$2 }
  $1=="branch" && $2 ~ k { print wt; exit }
')

if [[ "$caller" == "worker" ]]; then
  # Worker caller: test worktree MUST exist
  if [[ -z "$_test_wt" || ! -d "$_test_wt" ]]; then
    echo "ERROR: test-pre-merge worktree not found for $raw_key" >&2
    exit 1
  fi
  # Check clean
  if git -C "$_test_wt" status --short 2>/dev/null | grep -q .; then
    echo "ERROR: test worktree is dirty, commit first" >&2
    exit 1
  fi
  echo "freely-review: worker pre-check passed (test worktree exists + clean)"

elif [[ "$caller" == "manager" ]]; then
  # Manager caller: test worktree MUST NOT exist (wt-close should have removed it)
  if [[ -n "$_test_wt" && -d "$_test_wt" ]]; then
    echo "ERROR: test worktree $_test_wt still exists! wt-close may have failed." >&2
    exit 1
  fi
  _dev_wt=$(git worktree list --porcelain 2>/dev/null | awk -v k="raw-$raw_key" '
    $1=="worktree" { wt=$2 }
    $1=="branch" && $2 ~ k { print wt; exit }
  ')
  if [[ -n "$_dev_wt" && -d "$_dev_wt" ]]; then
    echo "ERROR: dev worktree $_dev_wt still exists! wt-close may have failed." >&2
    exit 1
  fi
  echo "freely-review: manager pre-check passed (worktrees properly removed)"
else
  echo "ERROR: invalid caller '$caller'" >&2
  exit 1
fi

# ── Launch Reviewer ──
if [[ "$caller" == "worker" ]]; then
  # ACP sync: launch in test worktree
  _acp_sock=""
  for _s in /tmp/freely-acp-*.sock; do
    [[ -S "$_s" ]] && { _acp_sock="$_s"; break; }
  done

  if [[ -n "$_acp_sock" && -x "$ACP_CLIENT" ]]; then
	    _raw_issue_file="docs/B1-docs/raw-${raw_key}/issue.md"
	    _raw_issue_text=""
	    [[ -f "$_raw_issue_file" ]] && _raw_issue_text="$(head -80 "$_raw_issue_file" 2>/dev/null || true)"
	    _pre_tests_text=""
	    # New structure: docs/B2-docs/{epic}/{story}/raw-{raw_key}/verification/pre-tests.md
	    for _pt in docs/B2-docs/*/*/raw-${raw_key}/verification/pre-tests.md; do
	      [[ -f "$_pt" ]] && _pre_tests_text="$(cat "$_pt" 2>/dev/null || true)" && break
	    done
	    if [[ -z "$_pre_tests_text" ]]; then
	      for _pt in docs/B2-docs/*/*/raw-*/verification/pre-tests.md; do
	        [[ -f "$_pt" ]] && _pre_tests_text="$(cat "$_pt" 2>/dev/null || true)" && break
	      done
	    fi
	    _diff_summary="$(git diff --stat develop..HEAD 2>/dev/null | head -30 || true)"
		    _issue_id="I-${raw_key}-A"
		    _epic_dir=""
		    # Search I-* issue under new structure: docs/B2-docs/{epic}/{story}/raw-{raw_key}/issues/
		    _i_issue_file=$(find docs/B2-docs -path "*/raw-${raw_key}/issues/${_issue_id}.md" -print -quit 2>/dev/null || true)
		    if [[ -z "$_i_issue_file" ]]; then
		      _i_issue_file=$(find docs/B2-docs -path "*/issues/${_issue_id}.md" -print -quit 2>/dev/null || true)
		    fi
		    if [[ -n "$_i_issue_file" && -f "$_i_issue_file" ]]; then
		      _verification_dir=$(grep "verification_artifact_dir:" "$_i_issue_file" 2>/dev/null | sed "s/.*: *'*\([^']*\)'*/\1/" | head -1 || true)
		      [[ -n "$_verification_dir" && -d "$_verification_dir" ]] && _epic_dir="$_verification_dir"
		    fi
		    [[ -z "$_epic_dir" ]] && _epic_dir="docs/B2-docs/gate/code-reviews"
		    _review_file="$_epic_dir/pr-review-raw-${raw_key}.md"
		    mkdir -p "$(dirname "$_review_file")"
			rm -f /tmp/freely-review-prompt-*.md 2>/dev/null; _pf=$(mktemp /tmp/freely-review-prompt-XXXXXXXX.md)
	    cat > "$_pf" << PROMPT
You are the Freely TDD Reviewer. Load and follow skill:freely-tdd-review.

Review is NOT a gate — examine content quality, not file existence.

## Raw Issue Context
$_raw_issue_text

## Pre-tests.md (the test plan)
$_pre_tests_text

## Git Diff Summary
$_diff_summary

## Instructions — skill:freely-tdd-review 五层 IBM 链路审查
1. Raw Issue 问题质量 — 是否是好issue？fix真有问题？feature有价值？
2. Raw→B1 质量+完整度+安全 — 方案最优？周边全覆盖？无安全隐患？
3. B1→B2 设计质量 — 产物可追溯？设计可执行？
4. B2→实现 fidelity+TDD — 代码忠实？覆盖率达标？
5. 实现→测试 执行完成度 — 全GREEN？evidence真实？tasks收尾？

Output JSON with specific findings in each dimension.
PROMPT
    _output=$(python3 "$ACP_CLIENT" --bridge-socket "$_acp_sock" --prompt-file "$_pf" \
      --launch-kind fresh --session-id "review-$raw_key" --model "$reviewer_slot" 2>&1) || true
    _verdict=$(echo "$_output" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('verdict','fail'))" 2>/dev/null || echo "fail")
    echo "freely-review: ACP verdict=$_verdict"
    [[ "$_verdict" == "pass" ]] && exit 0 || exit 1
  else
	    cat >&2 <<ACP_DOWN
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  [REVIEW] ACP bridge 不可用 — 审查被阻塞                  ║
╠══════════════════════════════════════════════════════════════╣
║  ACP bridge 是 Reviewer agent 的通信通道。                    ║
║  没有 ACP bridge，无法启动独立的 Reviewer session 进行审查。   ║
║                                                              ║
║  两种处理方式:                                                 ║
║                                                              ║
║  ① 启动 ACP bridge 后重试:                                    ║
║     检查 daemon 是否在运行: freely live-status                ║
║     启动 daemon: freely daemon start --task-mode auto         ║
║     重试: freely pr-review-guarded <branch>                   ║
║                                                              ║
║  ② 人工审查（ACP 不可用时的降级方案）:                          ║
║     skill:freely-tdd-review                                  ║
║     审查结论写入 code-reviews/pr-review-raw-{key}.md           ║
║     git add + git commit -m "review: manual review verdict=pass" ║
║                                                              ║
║  不推荐跳过审查直接合并——未审查的代码可能包含质量问题。         ║
╚══════════════════════════════════════════════════════════════╝
ACP_DOWN
	    exit 1
  fi

elif [[ "$caller" == "manager" ]]; then
  # A2A async: create review task for Manager's reviewer
  _a2a="$ROOT_DIR/docs/system/workspace/scripts/runtime/a2a_task.py"
  if [[ -f "$_a2a" ]]; then
    python3 "$_a2a" insert --role reviewer --raw-key "$raw_key" \
      --message "Review completed work for worker=$agent_id raw_key=$raw_key. Verify merged code on develop." \
      --agent-id "reviewer_manager_01" 2>/dev/null || true
    echo "freely-review: A2A review task created for reviewer_manager_01"
  fi
  exit 0
fi
