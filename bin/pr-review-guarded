#!/usr/bin/env bash
set -euo pipefail

# pr-review-guarded: ACP-based TDD review gate between pr-create and pr-merge.
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd -P)"
source "$ROOT_DIR/docs/system/workspace/scripts/worktree/worktree-common.sh" 2>/dev/null || true
review_branch=""
#
# Launches an independent Reviewer agent (separate ACP session, same worktree)
# that performs TDD four-question review: RED → GREEN → ADEQUACY → REFACTOR.
# Loop until pass, or escalate to Manager after 3 rounds.
#
# Usage:
#   freely pr-review-guarded <branch> [--reviewer <name>] [--verdict pass|fail|needs_changes] [--reason <text>]
#
# --reason gate: when --verdict pass overrides failing review, --reason is required.

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$ROOT_DIR" ]] || { echo "ERROR: not in a git repository" >&2; exit 1; }

# ── Config ────────────────────────────────────────────────

ACP_PROMPT_CLIENT="$ROOT_DIR/docs/system/workspace/scripts/runtime/run-acp-prompt.py"
REVIEW_STATE_DIR="$ROOT_DIR/.freely/run"
REVIEW_SESSION_FILE="$REVIEW_STATE_DIR/review-session.env"
REVIEW_PROMPT_FILE="$REVIEW_STATE_DIR/review-prompt.txt"
MAX_ROUNDS=3
REVIEWER_SKILL="freely-tdd-review"
# Slot for Reviewer agent — reads from agent-table reviewer_slot.
REVIEWER_SLOT="${REVIEWER_AGENT_SLOT:-}"
_agent_query="$ROOT_DIR/bin/agent-table-query"
_aw_py="$ROOT_DIR/docs/system/workspace/scripts/runtime/agent_working.py"

# Parse arguments FIRST — branch/raw key must be known before agent_working queries.
review_branch=""
reviewer="tdd-agent"
verdict_override=""
verdict_reason=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --reviewer) reviewer="${2:-tdd-agent}"; shift 2 ;;
    --verdict) verdict_override="${2:-}"; shift 2 ;;
    --reason) verdict_reason="${2:-}"; shift 2 ;;
    --slot) REVIEWER_SLOT="${2:-}"; shift 2 ;;
    --help|-h)
      cat >&2 <<'HELPMSG'
Usage: freely pr-review-guarded <branch> [--reviewer <name>] [--slot <slot>] [--verdict pass|fail] [--reason <text>]

Launches TDD Reviewer via ACP for independent four-question review.
Loops until pass (with Worker fixes between rounds) or escalates after 3 rounds.

Options:
  --slot <name>     Reviewer AI slot (default: from agent-table reviewer_slot)
  --verdict <value> Override verdict (pass|fail)
  --reason <text>   REQUIRED when overriding
HELPMSG
      exit 0 ;;
    -*) echo "Unknown: $1" >&2; exit 1 ;;
    *) review_branch="$1"; shift ;;
  esac
done

if [[ -z "$review_branch" ]]; then
  echo "ERROR: branch argument required." >&2
  echo "Usage: freely pr-review-guarded <branch>" >&2
  exit 1
fi

# Resolve reviewer slot from agent_working after branch is known (canonical raw key).
if [[ -z "$REVIEWER_SLOT" ]]; then
  if [[ -f "$_aw_py" ]]; then
    _my_worker_id=$(python3 -c "
import sys
sys.path.insert(0, '$ROOT_DIR/docs/system/workspace/scripts/runtime')
from raw_key_canon import try_canonicalize_raw_key
from agent_working import agent_list_by_raw_key, AgentWorkingError
from agent_identity_value import first_agent_id
rk = try_canonicalize_raw_key('$review_branch')
if not rk:
    raise SystemExit(0)
try:
    row = agent_list_by_raw_key('$ROOT_DIR', rk)
except AgentWorkingError as e:
    print(f'ERROR: agent_working unavailable: {e}', file=sys.stderr)
    raise SystemExit(2)
if row:
    wid = first_agent_id(row.get('worker_id', ''))
    if wid:
        print(wid)
" 2>/dev/null || true)
    if [[ -n "$_my_worker_id" && -x "$_agent_query" ]]; then
      _rev_info=$("$_agent_query" --get-reviewer "$_my_worker_id" 2>/dev/null || true)
      if [[ -n "$_rev_info" ]]; then
        _rev_slot=$(echo "$_rev_info" | python3 -c "import json,sys; print(json.load(sys.stdin).get('slot',''))" 2>/dev/null || true)
        [[ -n "$_rev_slot" ]] && REVIEWER_SLOT="$_rev_slot"
      fi
    fi
  fi
fi

base="develop"
pr_number=""
echo "=== pr-review-guarded: $review_branch → $base ==="
echo ""

# ── Step 0: Worktree cleanliness check (入口闸门) ──
_dirty_files=$(git -C "$ROOT_DIR" status --porcelain 2>/dev/null | grep -v '^?' | head -20 || true)
_untracked=$(git -C "$ROOT_DIR" ls-files --others --exclude-standard 2>/dev/null | head -20 || true)
if [[ -n "$_dirty_files" ]] || [[ -n "$_untracked" ]]; then
  cat >&2 <<DIRTY
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  [PR-REVIEW] 工位有未提交的文件 — 审查前请先处理          ║
╠══════════════════════════════════════════════════════════════╣
║  带着未提交的修改做审查，审查的代码可能和最终合并的不一致。     ║
║                                                              ║
║  未提交的修改 (tracked):                                       ║
$(printf "%s\n" "$_dirty_files" | sed 's/^/║    /')
║                                                              ║
║  未跟踪的文件 (untracked):                                     ║
$(printf "%s\n" "$_untracked" | sed 's/^/║    /')
║                                                              ║
║  请检查以上文件，判断是遗漏提交还是无需提交:                     ║
║    遗漏了 → git add <files> && git commit -m "..."           ║
║    暂不用 → git stash                (保存稍后恢复)           ║
║    不追踪 → echo <pattern> >> .gitignore  (明确忽略)          ║
║                                                              ║
║  ❌ 不要用 git reset --hard 或 git clean -f 直接丢弃          ║
╚══════════════════════════════════════════════════════════════╝
DIRTY
  exit 1
fi
echo "Step 0/5: worktree clean ✓"

# ── Step 1: Find PR number ──
if command -v gh &>/dev/null; then
  pr_number=$(gh pr list --head "$review_branch" --state open --json number -q '.[0].number' 2>/dev/null || true)
fi
if [[ -z "$pr_number" ]]; then
  pr_number="local"
fi
echo "PR: #$pr_number"

# ── Dev↔Test consistency check ──
_raw_key=$(echo "$review_branch" | grep -oE '[0-9]{8}T[0-9]{6}Z' | head -1 || true)
if [[ -n "$_raw_key" ]]; then
  freely_wt_assert_dev_test_consistent "$_raw_key" || {
    echo ""
    echo "  同步后重跑 test-GREEN（skill:freely-test-execution），全部 green 后重新 pr-review。"
    exit 1
  }
fi

# ── Step 2: Find review paths ──
_raw_key=$(echo "$review_branch" | grep -oE '[0-9]{8}T[0-9]{6}Z' | head -1 || true)

# Resolve fix worktree path FIRST (needed for path search even when run from develop)
_wt_path=$(git worktree list --porcelain 2>/dev/null | awk -v br="refs/heads/$review_branch" '
  $1=="worktree" { wt=$2 }
  $1=="branch" && $2==br { print wt; exit }
')
_wt_path="${_wt_path:-$ROOT_DIR}"
if [[ -n "$_raw_key" ]]; then
  freely_wt_assert_raw_reconciled_readonly "$_raw_key" "$_wt_path" || {
    echo "[PR-REVIEW] raw replicas are inconsistent; resolve explicitly, then retry." >&2
    exit 1
  }
fi

# An absorbed continuation has no own I-* node. Its B1 frontmatter names the
# canonical parent issue, which owns the B2 verification and review contract.
_search_roots=("$_wt_path" "$ROOT_DIR")
_absorbed_issue_id=""
for _sr in "${_search_roots[@]}"; do
  _b1_issue_file="$_sr/docs/B1-docs/raw-${_raw_key}/issue.md"
  [[ -f "$_b1_issue_file" ]] || continue
  _absorbed_issue_id=$(grep -E '^absorbed_into:[[:space:]]*I-[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9_-]+[[:space:]]*$' "$_b1_issue_file" | head -1 | sed -E 's/^absorbed_into:[[:space:]]*//' || true)
  [[ -n "$_absorbed_issue_id" ]] && break
done

# Find all I-* issues under this raw key when this is a standalone issue.
_all_issues=()
_raw_issues_dir=""
if [[ -z "$_absorbed_issue_id" ]]; then
  for _sr in "${_search_roots[@]}"; do
    [[ -d "$_sr" ]] || continue
    _raw_i_glob="$_sr/docs/B2-docs/*/*/raw-${_raw_key}/issues/I-${_raw_key#raw-}-*.md"
    for _f in $_raw_i_glob; do
      [[ -f "$_f" ]] || continue
      _raw_issues_dir="$(dirname "$_f")"
      _bn=$(basename "$_f" .md)
      _all_issues+=("$_bn")
    done
    [[ ${#_all_issues[@]} -gt 0 ]] && break
  done
  # Fallback: broad search in fix worktree then current
  if [[ ${#_all_issues[@]} -eq 0 ]]; then
    for _sr in "${_search_roots[@]}"; do
      [[ -d "$_sr" ]] || continue
      while IFS= read -r _f; do
        _bn=$(basename "$_f" .md)
        [[ "$_bn" = I-${_raw_key#raw-}-* ]] && _all_issues+=("$_bn")
      done < <(find "$_sr/docs/B2-docs" -path "*/raw-*/issues/I-*.md" -print 2>/dev/null | head -5)
      [[ ${#_all_issues[@]} -gt 0 ]] && break
    done
  fi
fi
_issue_id="${_absorbed_issue_id:-${_all_issues[0]:-I-${_raw_key#raw-}-A}}"
_epic_dir=""
# Search canonical I-* issue under the fix worktree before the current tree.
_i_issue_file=""
for _sr in "${_search_roots[@]}"; do
  [[ -d "$_sr" ]] || continue
  _i_issue_file=$(find "$_sr/docs/B2-docs" -path "*/issues/${_issue_id}.md" -print -quit 2>/dev/null || true)
  [[ -n "$_i_issue_file" ]] && break
done
if [[ -z "$_i_issue_file" || ! -f "$_i_issue_file" ]]; then
  echo >&2 "[pr-review-guarded] ERROR: I-* issue file not found for issue ${_issue_id}"
  echo >&2 "  Expected: docs/B2-docs/{epic-name}/{story-name}/raw-*/issues/${_issue_id}.md"
  exit 1
fi
	# Quote-optional value extraction: accept bare, 'single', "double", or `backtick`
	# wrapped values (pretests-gate historically demanded bare while this sed
	# demanded single quotes — both parsers now accept all four).
	_verification_dir=$(grep "verification_artifact_dir:" "$_i_issue_file" 2>/dev/null | head -1 | sed -e 's/^[^:]*:[[:space:]]*//' -e $'s/^[\'"`]//' -e $'s/[\'"`][[:space:]]*$//' || true)
	if [[ -z "$_verification_dir" ]]; then
	  echo >&2 "[pr-review-guarded] ERROR: verification_artifact_dir missing in $_i_issue_file"
	  echo >&2 "  Add: verification_artifact_dir: docs/B2-docs/{epic-name}/{story-name}/raw-${_raw_key}/code-reviews"
	  exit 1
	fi
	if ! echo "$_verification_dir" | grep -qE "^docs/B2-docs/[^/]+/[^/]+/raw-[^/]+/code-reviews$"; then
	  echo >&2 "[pr-review-guarded] ERROR: verification_artifact_dir path does not match canonical format"
	  echo >&2 "  Got:      $_verification_dir"
	  echo >&2 "  Expected: docs/B2-docs/{epic-name}/{story-name}/raw-${_raw_key}/code-reviews"
	  echo >&2 "  Required: 4 levels under docs/B2-docs/ — epic/story/raw-{key}/code-reviews"
	  exit 1
	fi
	_epic_dir="$_verification_dir"
	mkdir -p "$_epic_dir"
	review_file="$_epic_dir/pr-review-raw-${_raw_key}.md"

mkdir -p "$REVIEW_STATE_DIR"
echo "Review document: $review_file"
echo ""

# ── Step 3: ACP availability check ──
# Check BEFORE calling any ACP-dependent tool (freely-review or raw ACP client).
_acp_available=0
_acp_unavailable_reason=""
_acp_bridge_socket=""

_freely_pid=$(pgrep -f 'freely.*daemon\|freely.*start\|freely.*ensure' 2>/dev/null | head -1 || true)
if [[ -z "$_freely_pid" ]]; then
  _acp_unavailable_reason="freely daemon 未运行"
else
  for _sock in /tmp/freely-acp-*.sock; do
    if [[ -S "$_sock" ]]; then
      _acp_bridge_socket="$_sock"
      break
    fi
  done
  if [[ -z "$_acp_bridge_socket" ]]; then
    _acp_unavailable_reason="freely daemon 运行中（PID $_freely_pid）但 ACP socket 不存在"
  elif [[ ! -x "$ACP_PROMPT_CLIENT" ]]; then
    _acp_unavailable_reason="ACP socket 存在但 run-acp-prompt.py 不可执行"
  else
    _acp_available=1
  fi
fi

# ── Step 3.5: Call Reviewer (ACP or manual fallback) ──
_my_worker_id=""
# agent_working only — no file-based identity fallback
if [[ -f "$_aw_py" ]]; then
  _my_worker_id=$(python3 -c "
import sys
sys.path.insert(0, '$ROOT_DIR/docs/system/workspace/scripts/runtime')
from raw_key_canon import try_canonicalize_raw_key
from agent_working import agent_list_by_raw_key, AgentWorkingError
from agent_identity_value import first_agent_id
rk = try_canonicalize_raw_key('$review_branch')
if not rk:
    raise SystemExit(0)
try:
    row = agent_list_by_raw_key('$ROOT_DIR', rk)
except AgentWorkingError:
    raise SystemExit(0)
if row:
    wid = first_agent_id(row.get('worker_id', ''))
    if wid:
        print(wid)
" 2>/dev/null || true)
fi
_identity_kind="worker"
if [[ -z "$_my_worker_id" ]]; then
  # Owner lane: an owner-operated worktree has no delegated worker binding.
  # Fall back to the project manager so the guarded closeout stays reachable;
  # the review itself runs in manual mode because there is no worker session.
  _owner_id=$("$ROOT_DIR/bin/agent-table-query" --project "$ROOT_DIR" --list manager 2>/dev/null | head -1 || true)
  if [[ -n "$_owner_id" ]]; then
    _my_worker_id="$_owner_id"
    _identity_kind="owner"
  fi
fi
if [[ -z "$_my_worker_id" ]]; then
  echo "ERROR: cannot resolve reviewer identity from agent_working or agent-table for branch $review_branch (fail-closed)" >&2
  exit 1
fi

if [[ "$_identity_kind" == "owner" ]]; then
  # No delegated worker session exists; do not call freely-review as a worker.
  _acp_available=0
  _acp_unavailable_reason="owner lane: no delegated worker session"
fi

# Only try freely-review or raw ACP if bridge is actually available
if [[ "$_acp_available" == "1" ]]; then
  echo "ACP bridge: $_acp_bridge_socket (freely PID $_freely_pid)"

  if [[ -x "$ROOT_DIR/bin/freely-review" ]]; then
    # freely-review launches reviewer agent with full context.
    if [[ "$verdict_override" == "pass" && -n "$verdict_reason" ]]; then
      _review_verdict="pass"
    else
      _review_output=$("$ROOT_DIR/bin/freely-review" --caller worker --agent-id "$_my_worker_id" --raw-key "$_raw_key" 2>&1) || _freely_rc=$?
      _review_verdict="pass"
      if [[ "${_freely_rc:-0}" -ne 0 ]]; then
        _review_verdict="fail"
      fi
      if echo "$_review_output" | grep -qi "verdict.*fail"; then
        _review_verdict="fail"
      fi
    fi
    if [[ "$_review_verdict" == "pass" ]]; then
      echo "Review PASSED"
      # Update I-* phase_state → completed (before commit, so it flows into merge)
      _update_issue_phase_state "$_raw_key"
      if [[ -f "$ROOT_DIR/$review_file" ]]; then
        git -C "$ROOT_DIR" add "$review_file" 2>/dev/null || true
        if ! git -C "$ROOT_DIR" diff --cached --quiet 2>/dev/null; then
          git -C "$ROOT_DIR" commit -m "review: pr-review-guarded verdict=pass for $review_branch
Co-Authored-By: Claude <noreply@anthropic.com>" 2>/dev/null || true
          for platform in $(_platform_configs); do
            remote=$(_platform_remote_name "$platform")
            git -C "$ROOT_DIR" push "$remote" "$review_branch" 2>&1 || true
          done
        fi
      fi
      exit 0
    else
      echo "Review FAILED — freely-review exited with error"
      echo "  _freely_rc=${_freely_rc:-1}"
      echo "  _review_output=$_review_output"
      echo ""
      echo "  ACP review failed.  Try manual review:"
      echo "    skill:freely-tdd-review"
      echo "  Review output → $review_file"
      exit 1
    fi
  fi
  # else: ACP available but freely-review not found — fall through to raw ACP client below
else
  echo "[INFO] ACP 不可用 — $_acp_unavailable_reason"
  echo "[INFO] 回退到人工审查"
  echo ""
  echo "  请加载 skill:freely-tdd-review 进行人工审查。"
  echo "  审查结论写入: $review_file"
  echo ""
fi

# ── Manual fallback (ACP unavailable OR freely-review not found) ──
if [[ -z "$REVIEWER_SLOT" ]]; then
  REVIEWER_SLOT="$("$ROOT_DIR/bin/agent-table-query" --get-slot reviewer_01 2>/dev/null || echo "")"
fi

# Collect review context — search fix worktree first, then current
_pre_tests_file=""
for _sr in "$_wt_path" "$ROOT_DIR"; do
  [[ -d "$_sr" ]] || continue
  for _d in "$_sr"/docs/B2-docs/*/*/raw-${_raw_key}/verification/; do
    if [[ -f "${_d}pre-tests.md" ]]; then
      _pre_tests_file="${_d}pre-tests.md"
      break 2
    fi
  done
done

_diff_file="$REVIEW_STATE_DIR/review-diff.txt"
git diff "$base..$review_branch" > "$_diff_file" 2>/dev/null || true

_issue_file=""
for _sr in "$_wt_path" "$ROOT_DIR"; do
  [[ -d "$_sr" ]] || continue
  if [[ -n "$_raw_key" ]] && [[ -f "$_sr/docs/B1-docs/$_raw_key/issue.md" ]]; then
    _issue_file="$_sr/docs/B1-docs/$_raw_key/issue.md"
    break
  fi
done

# Determine session state
_review_round=1
_review_session_id=""
if [[ -f "$REVIEW_SESSION_FILE" ]]; then
  _review_session_id=$(grep "SESSION_ID=" "$REVIEW_SESSION_FILE" 2>/dev/null | cut -d= -f2 || true)
  _review_round=$(grep "ROUND=" "$REVIEW_SESSION_FILE" 2>/dev/null | cut -d= -f2 || echo "1")
  _review_round=$((_review_round + 1))
fi

echo "Review round: $_review_round / $MAX_ROUNDS"
echo "Reviewer slot: $REVIEWER_SLOT"
echo ""

# Check if we've exceeded max rounds
if [[ "$_review_round" -gt "$MAX_ROUNDS" ]]; then
  cat >&2 <<ESCALATE
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  TDD Review 超过 $MAX_ROUNDS 轮仍未通过                        ║
║                                                              ║
║  Worker 和 Reviewer 对测试方案是否充分存在分歧。                  ║
║  需要 Manager 介入裁定。                                      ║
║                                                              ║
║  请将以下信息提交给 Manager:                                    ║
║    Branch: $review_branch                                     ║
║    PR: #$pr_number                                            ║
║    Review rounds: $_review_round                              ║
║                                                              ║
║  Manager 命令:                                                ║
║    1. 审查 review 历史记录                                     ║
║    2. 判定: 同意 Reviewer 继续完善 / 同意 Worker 放行            ║
║    3. 写入裁定理由                                             ║
╚══════════════════════════════════════════════════════════════╝
ESCALATE
  # Mark as needs_manager input
  echo "ROUND=$_review_round" > "$REVIEW_SESSION_FILE"
  echo "SESSION_ID=$_review_session_id" >> "$REVIEW_SESSION_FILE"
  exit 2  # Exit code 2 = escalate to manager
fi

# Build review prompt
cat > "$REVIEW_PROMPT_FILE" << PROMPT
You are the Freely TDD Reviewer. Follow skill:freely-tdd-review (TDD four-question review).

## Context
- Raw issue: $_issue_file
- Pre-tests: $_pre_tests_file
- Git diff: $_diff_file (already generated at $_diff_file)
- Review round: $_review_round of $MAX_ROUNDS

$(if [[ "$_review_round" -gt 1 ]]; then echo "## Previous Review
You reviewed this PR in round $((_review_round - 1)) and found issues.
Focus on whether the issues from YOUR previous review have been fixed."; fi)

## Instructions
Read the pre-tests.md and git diff, then output a JSON verdict:

{
  "verdict": "pass" | "fail",
  "round": $_review_round,
  "dimensions": {
    "red": {"status": "pass"|"fail", "note": "..."},
    "green": {"status": "pass"|"fail", "note": "..."},
    "adequacy": {"status": "pass"|"fail", "note": "..."},
    "refactor": {"status": "pass"|"fail"|"warn", "note": "..."}
  },
  "summary": "...",
  "required_fixes": ["..."]
}

Review the following files for evidence:
$([[ -n "$_pre_tests_file" ]] && echo "Pre-tests: $(cat "$_pre_tests_file" 2>/dev/null || echo 'not found')")
$([[ -f "$_diff_file" ]] && echo "Git diff (summary): $(head -100 "$_diff_file")")
PROMPT

# Determine ACP launch kind
_acp_launch_kind="fresh"
_acp_session_arg=""
if [[ -n "$_review_session_id" ]]; then
  _acp_launch_kind="prompt"
  _acp_session_arg="--session-id $_review_session_id"
fi

# Call Reviewer via ACP
echo "--- TDD Review (ACP $_acp_launch_kind) ---"
echo ""

_review_output=""
_review_rc=0

# Raw ACP client: only reachable if freely-review not found but ACP is available
if [[ "$_acp_available" == "1" && ! -x "$ROOT_DIR/bin/freely-review" ]]; then
  echo "--- TDD Review (raw ACP $_acp_launch_kind) ---"

  _review_output=$(python3 "$ACP_PROMPT_CLIENT" \
    --bridge-socket "$_acp_bridge_socket" \
    --prompt-file "$REVIEW_PROMPT_FILE" \
    --launch-kind "$_acp_launch_kind" \
    --session-id "${_review_session_id:-review-$pr_number}" \
    --model "$REVIEWER_SLOT" 2>&1) || _review_rc=$?

  _new_session_id=$(echo "$_review_output" | grep "session id:" | head -1 | sed 's/.*session id: //' | tr -d '[:space:]')
  [[ -n "$_new_session_id" ]] && _review_session_id="$_new_session_id"
  _acp_used=1
elif [[ "$_acp_available" == "0" ]]; then
  # ACP unavailable — manual fallback (already printed message in Step 3)
  _review_verdict="manual_required"
  _acp_used=0
  _review_json="{}"
fi

# Parse verdict from Reviewer output (only when ACP was actually used)
if [[ "${_acp_used:-1}" != "0" ]]; then
  _review_verdict="fail"
  _review_json=""
  if echo "$_review_output" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('verdict','fail'))" 2>/dev/null; then
    _review_verdict=$(echo "$_review_output" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('verdict','fail'))" 2>/dev/null || echo "fail")
    _review_json=$(echo "$_review_output" | python3 -c "import json,sys; print(json.dumps(json.load(sys.stdin),indent=2))" 2>/dev/null || echo "")
  else
    # Try to find JSON block in output
    _json_block=$(echo "$_review_output" | grep -A100 '{' | grep -B100 '}' | head -50 || true)
    if [[ -n "$_json_block" ]]; then
      _review_verdict=$(echo "$_json_block" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('verdict','fail'))" 2>/dev/null || echo "fail")
      _review_json="$_json_block"
    fi
  fi
fi  # End _acp_used guard

echo ""
echo "Reviewer verdict: $_review_verdict"

# Save session state
echo "ROUND=$_review_round" > "$REVIEW_SESSION_FILE"
echo "SESSION_ID=$_review_session_id" >> "$REVIEW_SESSION_FILE"
echo "LAST_VERDICT=$_review_verdict" >> "$REVIEW_SESSION_FILE"

# ── Step 4: Handle result ──
if [[ "$_review_verdict" == "pass" ]]; then
  echo "✅ TDD Review PASSED (round $_review_round)"

  # Write review document
  _now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  _review_summary=$(echo "$_review_json" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('summary','TDD review passed'))" 2>/dev/null || echo "TDD review passed")

  cat > "$review_file" << REVIEWDOC
# PR Review: #$pr_number
- pr_number: $pr_number
- branch: $review_branch
- base: $base
- reviewer: $reviewer (ACP TDD, slot=$REVIEWER_SLOT)
- review_date: $_now
- verdict: pass
- rounds: $_review_round
- issue_id: $_issue_id

## TDD Review ($_review_round rounds)
- verdict: pass
- summary: $_review_summary

$_review_json

## Overall Verdict
- verdict: pass
- notes: Ready for pr-merge-guarded
REVIEWDOC

  echo "Review document: $review_file"

  # Clean up session state on pass
  rm -f "$REVIEW_SESSION_FILE" "$REVIEW_PROMPT_FILE"

  # Auto-commit and push
  _update_issue_phase_state "$_raw_key"
  git add "$review_file" 2>/dev/null || true
  if ! git diff --cached --quiet 2>/dev/null; then
    git commit -m "review: pr-review-guarded verdict=pass for PR #$pr_number (TDD rounds=$_review_round)

Co-Authored-By: Claude <noreply@anthropic.com>" 2>/dev/null || true
    echo "Review document committed to branch."


_platform_configs() {
  if [[ -n "${FREELY_REPO_PLATFORMS:-}" ]]; then
    echo "${FREELY_REPO_PLATFORMS//,/ }"
    return
  fi
  local found_github=0 found_gitee=0
  while IFS= read -r remote; do
    [[ -z "$remote" || "$remote" == "all" ]] && continue
    case "$(git remote get-url "$remote" 2>/dev/null || true)" in
      *github.com*|*github-*|*github*) found_github=1 ;;
      *gitee.com*|*gitee-*|*gitee*)   found_gitee=1 ;;
    esac
  done < <(git remote)
  [[ "$found_github" == "1" ]] && echo "github"
  [[ "$found_gitee" == "1" ]] && echo "gitee"
}

_platform_remote_name() {
  case "$1" in
    gitee) git remote | grep -q '^gitee$' && echo "gitee" || echo "origin" ;;
    *)     echo "$1" ;;
  esac
}


    for platform in $(_platform_configs); do
      remote=$(_platform_remote_name "$platform")
      echo "  [$platform] pushing review commit..."
      git push "$remote" "$review_branch" 2>&1 || echo "  [$platform] push FAILED (non-fatal)" >&2
    done
  fi

  echo ""
  echo "Next steps:"
  echo "  freely pr-merge-guarded $base $review_branch"

  # ── Step 5: Post-commit cleanliness check (出口闸门) ──
  _dirty_files=$(git -C "$ROOT_DIR" status --porcelain 2>/dev/null | grep -v '^?' | head -20 || true)
  _untracked=$(git -C "$ROOT_DIR" ls-files --others --exclude-standard 2>/dev/null | head -20 || true)
  if [[ -n "$_dirty_files" ]] || [[ -n "$_untracked" ]]; then
    cat >&2 <<DIRTY
╔══════════════════════════════════════════════════════════════╗
║  ⚠️  [PR-REVIEW] Review 完成后仍有未提交的文件                ║
╠══════════════════════════════════════════════════════════════╣
║  Review 文档已自动提交，但工位仍有其他未提交的修改。            ║
║  这些文件可能是 review 过程中产生的，不提交会在合并时丢失。     ║
║                                                              ║
║  未提交的修改 (tracked):                                       ║
$(printf "%s\n" "$_dirty_files" | sed 's/^/║    /')
║                                                              ║
║  未跟踪的文件 (untracked):                                     ║
$(printf "%s\n" "$_untracked" | sed 's/^/║    /')
║                                                              ║
║  请检查以上文件，判断是遗漏提交还是无需提交:                     ║
║    遗漏了 → git add <files> && git commit -m "review: ..."   ║
║    暂不用 → git stash                                         ║
║    不追踪 → echo <pattern> >> .gitignore                       ║
║                                                              ║
║  提交后重新运行:                                               ║
║    freely pr-merge-guarded $base $review_branch              ║
╚══════════════════════════════════════════════════════════════╝
DIRTY
    exit 1
  fi
  echo "Step 5/5: post-review worktree clean ✓"

  exit 0

elif [[ "$_review_verdict" == "manual_required" ]]; then
  echo "📋 人工审查 — ACP bridge 不可用，需按 skill:freely-tdd-review 手动审查"
  echo ""
  echo "  审查指南: skill:freely-tdd-review"
  echo "  审查结论写入: $review_file"
  echo ""
  echo "  审查步骤:"
  echo "    1. 加载 skill:freely-tdd-review"
  echo "    2. 从 raw issue 开始，逐级向下审查"
  echo "    3. 每级检查：下层是否忠实消化了上层？"
  echo "    4. 审查结论写入 $review_file"
  echo "    5. git add $review_file && git commit -m 'review: manual review verdict=pass'"
  echo "    6. 重新运行 freely pr-merge-guarded $base $review_branch"
  exit 1
else
  echo "❌ TDD Review FAILED (round $_review_round)"

  if [[ -n "$_review_json" ]]; then
    echo ""
    echo "Review feedback:"
    echo "$_review_json" | python3 -c "
import json,sys
d=json.load(sys.stdin)
dims=d.get('dimensions',{})
for k,v in dims.items():
    if v.get('status')=='fail':
        print(f'  [{k}] {v.get(\"note\",\"\")}')
fixes=d.get('required_fixes',[])
if fixes:
    print()
    print('Required fixes:')
    for f in fixes:
        print(f'  - {f}')
" 2>/dev/null || echo "$_review_json"
  fi

  echo ""
  echo "Fix the issues above, commit changes, and re-run:"
  echo "  freely pr-review-guarded $review_branch"
  echo ""
  echo "Rounds remaining: $((MAX_ROUNDS - _review_round))"

  exit 1
fi

# ── Helper functions ────────────────────────────────────────

# Update I-* issue phase_state to completed when review passes.
# Called before git add/commit so the state update flows into develop via merge.
_update_issue_phase_state() {
  local _raw_key="$1"
  [[ -n "$_raw_key" ]] || return 0
  local _i_file
  _i_file=$(find "$ROOT_DIR/docs/B2-docs" -name "I-${_raw_key}*.md" 2>/dev/null | head -1)
  if [[ -n "$_i_file" && -f "$_i_file" ]]; then
    if grep -q "phase_state: done_b2_ibm" "$_i_file" 2>/dev/null; then
      sed -i '' 's/phase_state: done_b2_ibm/phase_state: completed/' "$_i_file"
      git -C "$ROOT_DIR" add "${_i_file#$ROOT_DIR/}" 2>/dev/null || true
      echo "Updated phase_state → completed in ${_i_file#$ROOT_DIR/}"
    fi
  fi
}

