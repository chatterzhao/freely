#!/usr/bin/env bash
# check-file-size: lint file line counts, configurable limits, skip markers.
# Config (in .freely/config.env):
#   FILE_SIZE_WARN=500      # warn: getting too long (default 500)
#   FILE_SIZE_DANGER=750    # danger: approaching limit, plan split (default 750)
#   FILE_SIZE_ERROR=1000    # error: must split (default 1000)
# Skip markers anywhere in file:
#   # file-size: skip       (shell/python)
#   file_size_check: skip   (markdown frontmatter)
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

WARN="${FILE_SIZE_WARN:-500}"
DANGER="${FILE_SIZE_DANGER:-750}"
ERROR="${FILE_SIZE_ERROR:-1000}"
STAGED_ONLY=0
for _arg in "$@"; do
  case "$_arg" in
    --staged-only) STAGED_ONLY=1 ;;
    *) echo "[check-file-size] unknown arg: $_arg" >&2; exit 2 ;;
  esac
done

warnings=0
dangers=0
errors=0
skips=0

should_skip() {
  local file="$1"
  grep -qiE "file.size:\s*skip|file_size_check:\s*skip" "$file" 2>/dev/null && return 0
  return 1
}

check_file() {
  local file="$1"
  local lines
  if should_skip "$file"; then
    echo "[SKIP]   $file"
    skips=$((skips + 1))
    return 0
  fi
  lines=$(wc -l <"$file" | tr -d ' ')
  if (( lines > ERROR )); then
    echo "[ERROR]  $file: $lines lines (limit: $ERROR)"
    errors=$((errors + 1))
  elif (( lines > DANGER )); then
    echo "[DANGER] $file: $lines lines (limit: $DANGER)"
    dangers=$((dangers + 1))
  elif (( lines > WARN )); then
    echo "[WARN]   $file: $lines lines (limit: $WARN)"
    warnings=$((warnings + 1))
  fi
}

if [[ "$STAGED_ONLY" -eq 1 ]]; then
  # Incremental gate: inspect only files staged in THIS commit, then exit.
  # Historic oversized files remain visible in a full run but must not
  # permanently block every future commit.
  if ! git -C "$ROOT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "[check-file-size] ERROR: not a git worktree (environment unusable)" >&2
    exit 2
  fi
  while IFS= read -r -d '' rel; do
    [[ -n "$rel" ]] || continue
    f="$ROOT_DIR/$rel"
    [[ -f "$f" ]] || continue
    # A file that was ALREADY oversized in HEAD is historic debt, not a new
    # violation introduced by this commit. Blocking it would lock every
    # future commit that merely touches milestones.md / other legacy files.
    if git -C "$ROOT_DIR" cat-file -e "HEAD:$rel" 2>/dev/null; then
      _old_lines="$(git -C "$ROOT_DIR" show "HEAD:$rel" 2>/dev/null | wc -l | tr -d ' ')"
      if (( _old_lines > ERROR )); then
        echo "[HISTORIC] $rel: already over $ERROR lines in HEAD (not a new violation)"
        continue
      fi
    fi
    check_file "$f"
  done < <(git -C "$ROOT_DIR" diff --cached --name-only -z --diff-filter=ACMR 2>/dev/null)
  echo ""
  echo "Limits: warn=$WARN danger=$DANGER error=$ERROR | staged-only | Warnings: $warnings Dangers: $dangers Errors: $errors Skips: $skips"
  exit $(( errors > 0 ? 1 : 0 ))
fi

# Code files (full run)
while IFS= read -r -d '' f; do
  check_file "$f"
done < <(find "$ROOT_DIR/docs/system/workspace/scripts" "$ROOT_DIR/bin" \
  \( -name "*.sh" -o -name "*.py" \) -print0 2>/dev/null)

# Extensionless executable scripts (e.g. scripts/runtime/freely, 26k+ lines)
# were invisible to the *.sh/*.py scan. Cover them in full runs.
while IFS= read -r -d '' f; do
  check_file "$f"
done < <(find "$ROOT_DIR/docs/system/workspace/scripts/runtime" \
  "$ROOT_DIR/docs/system/workspace/scripts/sync" \
  "$ROOT_DIR/docs/system/workspace/scripts/quality" \
  "$ROOT_DIR/docs/system/workspace/scripts/worktree" \
  "$ROOT_DIR/docs/system/workspace/scripts/lifecycle" "$ROOT_DIR/bin" \
  -maxdepth 1 -type f ! -name "*.*" -print0 2>/dev/null)

# Active governance docs
while IFS= read -r -d '' f; do
  check_file "$f"
done < <(find "$ROOT_DIR/AGENTS.md" "$ROOT_DIR/docs/CONSTITUTION.md" \
  "$ROOT_DIR/docs/LAWS.md" "$ROOT_DIR/docs/PROJECT_INTENT.md" \
  "$ROOT_DIR/docs/milestones.md" "$ROOT_DIR/docs/progress" \
  "$ROOT_DIR/docs/system/workspace" \
  -name "*.md" -print0 2>/dev/null)

echo ""
echo "Limits: warn=$WARN danger=$DANGER error=$ERROR | Warnings: $warnings Dangers: $dangers Errors: $errors Skips: $skips"
exit $(( errors > 0 ? 1 : 0 ))
