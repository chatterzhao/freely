#!/usr/bin/env bash
# check-file-size: lint for file line count limits
# Code: 500 warn, 1000 error. Docs: 500 warn, 1000 warn (keep, not block).
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

CODE_WARN=500
CODE_ERROR=1000
DOC_WARN=500
DOC_ERROR=1000

warnings=0
errors=0

check_file() {
  local file="$1" kind="$2" warn="$3" error="$4"
  local lines
  lines=$(wc -l <"$file" | tr -d ' ')
  if (( lines > error )); then
    echo "[ERROR] $file: $lines lines (limit: $error)"
    errors=$((errors + 1))
  elif (( lines > warn )); then
    echo "[WARN]  $file: $lines lines (limit: $warn)"
    warnings=$((warnings + 1))
  fi
}

# Code files
while IFS= read -r -d '' f; do
  case "$f" in
    */freely) check_file "$f" code $CODE_WARN $CODE_ERROR ;; # legacy: allow warning only
    *) check_file "$f" code $CODE_WARN $CODE_ERROR ;;
  esac
done < <(find "$ROOT_DIR/docs/system/workspace/scripts" "$ROOT_DIR/bin" -name "*.sh" -o -name "*.py" -print0 2>/dev/null)

# Doc files (warn only)
while IFS= read -r -d '' f; do
  check_file "$f" doc $DOC_WARN 999999
done < <(find "$ROOT_DIR/docs" -name "*.md" -not -path "*/pre-brainstorms/*" -not -path "*/epics/*" -print0 2>/dev/null)

echo ""
echo "Warnings: $warnings, Errors: $errors"
exit $(( errors > 0 ? 1 : 0 ))
