#!/usr/bin/env python3
"""Report raw closeout drift without producing lifecycle facts.

Platform closure cannot prove absorption or select a canonical I-* owner. This
historical batch entry therefore remains read-only. Use the command that owns
the missing fact (`issue-sync promote-finalize`, drop, or platform close) after
reviewing each reported raw.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def main() -> int:
    parser = argparse.ArgumentParser(description="Audit raw closeout drift")
    parser.add_argument("--dry-run", action="store_true", help="Retained compatibility flag; audit is always read-only")
    parser.parse_args()

    scan_path = ROOT / ".freely" / "run" / "manager-task-source-scan-latest.json"
    if not scan_path.is_file():
        print("[closeout-audit] scan JSON not found", file=sys.stderr)
        return 1

    scan = json.loads(scan_path.read_text(encoding="utf-8"))
    items = [
        item
        for item in scan.get("items", [])
        if item.get("stage") in {"local_needs_closeout", "close_local", "merged_develop"}
    ]

    for item in items:
        key = item.get("key", "<unknown>")
        phase = item.get("phase_state", "")
        print(
            f"[closeout-audit] {key}: phase={phase or '<missing>'}; "
            "review canonical relation and use its owning lifecycle command"
        )
    print(f"[closeout-audit] read-only: {len(items)} finding(s), 0 files changed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
