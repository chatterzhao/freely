#!/usr/bin/env bash
# raw-issue-pull: pull a raw issue from platform (GitHub/Gitee) to local docs/B1-docs/
set -euo pipefail

usage() {
  cat <<USAGE
Usage:
  freely raw-issue-pull --raw-key <key> [--target <dir>] [--platform <github|gitee>]

Pull a raw issue from platform by matching raw-{key} in OPEN issue titles.
Materializes to docs/B1-docs/raw-{key}/issue.md with proper platform_ids.

Options:
  --raw-key  <key>    Raw issue key (YYYYMMDDTHHMMSSZ format)
  --target   <dir>    Target directory (default: docs/B1-docs/raw-{key}/)
  --platform <name>   Pin the read source (github|gitee). Default: first
                      READABLE configured platform; an unreadable platform is
                      recorded as sync debt instead of blocking.

Exit codes:
  0  all configured platforms readable, materialized
  3  partial success: materialized from a fallback platform, one or more
     platforms unreadable (sync debt recorded) — worktree creation continues
  1  failure: nothing readable, or explicitly requested platform unreadable

Example:
  freely raw-issue-pull --raw-key 20260506T100035Z --platform gitee
USAGE
}

raw_key=""
target=""
platform=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --raw-key)  raw_key="${2:-}"; shift 2 ;;
    --target)   target="${2:-}"; shift 2 ;;
    --platform) platform="${2:-}"; shift 2 ;;
    --help|-h)  usage; exit 0 ;;
    *) echo "Unknown: $1" >&2; usage; exit 1 ;;
  esac
done

[[ -n "$raw_key" ]] || { echo "Missing --raw-key" >&2; usage; exit 1; }
case "$platform" in
  ""|github|gitee) ;;
  *) echo "Invalid --platform '$platform' (expected github|gitee)" >&2; exit 1 ;;
esac

ROOT_DIR="${PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
[[ -z "$target" ]] && target="$(pwd)/docs/B1-docs/raw-${raw_key}"

# The CALLER's repo root, not the script's physical location. wt-create cd's into
# the dev worktree before invoking us, but $ROOT_DIR still points at the main repo
# (that is where bin/ lives). issue-sync derives its own ROOT_DIR from its script
# path too, so without --project its protected-branch guard always sees the main
# repo's develop and refuses — skipping platform title normalization entirely.
# See issue-sync's own guard comment: "Callers on develop must use --project".
caller_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"

# ── Worktree / branch interception ─────────────────────────
# Only allow pull from fix/* or feature/* worktree whose branch contains the raw-key.
current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

case "$current_branch" in
  develop|main)
    echo "拒绝: 不能在受保护分支 '$current_branch' 上执行 raw-issue-pull。" >&2
    echo "请先切换到包含 raw-${raw_key} 的 fix/feature 工位分支。" >&2
    exit 1
    ;;
  fix/*|feature/*)
    ;;
  *)
    echo "拒绝: raw-issue-pull 只能在 fix/* 或 feature/* 工位中执行。" >&2
    echo "当前分支: '$current_branch'" >&2
    exit 1
    ;;
esac

if [[ "$current_branch" != *"$raw_key"* ]]; then
  echo "拒绝: 当前分支 '$current_branch' 不包含 raw-key '$raw_key'。" >&2
  echo "raw-issue-pull 只能在包含该 raw-key 的工位分支中执行。" >&2
  exit 1
fi

# STDOUT must remain exactly ONE JSON document: wt-create parses it to verify
# the materialized identity. Keep the adapter output in a temp file so we can
# both forward it and inspect degraded platforms; all diagnostics go to STDERR.
_pull_json="$(mktemp -t freely-pull-json.XXXXXX)"
_pull_err="$(mktemp -t freely-pull-err.XXXXXX)"
_pull_rc=0
python3 "$ROOT_DIR/docs/system/workspace/scripts/sync/platform-adapter.py" \
  pull "$raw_key" "$target" "$platform" > "$_pull_json" 2> "$_pull_err" || _pull_rc=$?
if [[ -s "$_pull_err" ]]; then cat "$_pull_err" >&2; fi
cat "$_pull_json"

if [[ "$_pull_rc" -ne 0 && "$_pull_rc" -ne 3 ]]; then
  rm -f "$_pull_json" "$_pull_err"
  exit "$_pull_rc"
fi

# Partial success: record each unreadable platform in the EXISTING sync-debt
# ledger (lifecycle/sync-debt.py) so issue-sync reconcile can settle it later.
# Uncertainty is debt, not a fact — it must not block worktree creation.
if [[ "$_pull_rc" -eq 3 ]]; then
  _debt_script="$ROOT_DIR/docs/system/workspace/scripts/lifecycle/sync-debt.py"
  if [[ -f "$_debt_script" ]]; then
    while IFS= read -r _plat; do
      [[ -n "$_plat" ]] || continue
      python3 "$_debt_script" --root "$ROOT_DIR" record \
        --raw-key "$raw_key" --platform "$_plat" \
        --reason "raw-issue-pull: platform unreadable, materialized from fallback" \
        >/dev/null 2>&1 || true
    done < <(python3 - "$_pull_json" <<'PY'
import json, sys
try:
    data = json.load(open(sys.argv[1]))
    for item in data.get("degraded_platforms") or []:
        print(str(item))
except Exception:
    pass
PY
)
    echo "[WARN] raw-issue-pull: partial success — unreadable platform(s) recorded as sync debt (sync-debt list)" >&2
  else
    echo "[WARN] raw-issue-pull: sync-debt.py missing; unreadable platform(s) not recorded" >&2
  fi
fi
rm -f "$_pull_json" "$_pull_err"

# After pull: sync to all configured platforms (fill missing platform_ids,
# and let issue-sync's _platform_title() normalize the platform title).
# Never swallow a failure silently — the caller (wt-create) must be able to
# diagnose an identity/title mismatch instead of reporting a false success.
local_id="raw-${raw_key}"
if [[ -f "$target/issue.md" ]]; then
  if [[ -x "$ROOT_DIR/bin/issue-sync" ]]; then
    # STDOUT must remain exactly one JSON document: wt-create parses it to
    # verify the materialized identity. Route every diagnostic to STDERR.
    if ! "$ROOT_DIR/bin/issue-sync" --project "$caller_root" create "$local_id" >&2; then
      echo "[WARN] raw-issue-pull: issue-sync create failed for $local_id (platform title normalization may be incomplete)" >&2
    fi
  else
    echo "[WARN] raw-issue-pull: $ROOT_DIR/bin/issue-sync missing; skipped title normalization for $local_id" >&2
  fi
else
  echo "[WARN] raw-issue-pull: expected $target/issue.md missing; skipped issue-sync create for $local_id" >&2
fi

# Preserve the partial-success code so callers can distinguish it from a hard
# failure. wt-create treats 3 as "continue" (it is not a blocking condition).
exit "$_pull_rc"
