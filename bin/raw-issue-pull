#!/usr/bin/env bash
# raw-issue-pull: pull a raw issue from platform (GitHub/Gitee) to local docs/B1-docs/
set -euo pipefail

usage() {
  cat <<USAGE
Usage:
  freely raw-issue-pull --raw-key <key> [--target <dir>]

Pull a raw issue from platform by matching raw-{key} in OPEN issue titles.
Materializes to docs/B1-docs/raw-{key}/issue.md with proper platform_ids.

Options:
  --raw-key <key>   Raw issue key (YYYYMMDDTHHMMSSZ format)
  --target  <dir>   Target directory (default: docs/B1-docs/raw-{key}/)

Example:
  freely raw-issue-pull --raw-key 20260506T100035Z
USAGE
}

raw_key=""
target=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --raw-key) raw_key="${2:-}"; shift 2 ;;
    --target)  target="${2:-}"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Unknown: $1" >&2; usage; exit 1 ;;
  esac
done

[[ -n "$raw_key" ]] || { echo "Missing --raw-key" >&2; usage; exit 1; }

ROOT_DIR="${PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)}"
[[ -z "$target" ]] && target="$(pwd)/docs/B1-docs/raw-${raw_key}"

# ── Worktree / branch interception ─────────────────────────
# Only allow pull from fix/* or feature/* worktree whose branch contains the raw-key.
current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

case "$current_branch" in
  develop|main)
    echo "拒绝: 不能在受保护分支 '$current_branch' 上执行 raw-issue-pull。" >&2
    echo "请先切换到包含 raw-${raw_key} 的 fix/feature 工位分支。" >&2
    exit 1
    ;;
  fix/*|feature/*)
    ;;
  *)
    echo "拒绝: raw-issue-pull 只能在 fix/* 或 feature/* 工位中执行。" >&2
    echo "当前分支: '$current_branch'" >&2
    exit 1
    ;;
esac

if [[ "$current_branch" != *"$raw_key"* ]]; then
  echo "拒绝: 当前分支 '$current_branch' 不包含 raw-key '$raw_key'。" >&2
  echo "raw-issue-pull 只能在包含该 raw-key 的工位分支中执行。" >&2
  exit 1
fi

python3 "$ROOT_DIR/docs/system/workspace/scripts/sync/platform-adapter.py" pull "$raw_key" "$target"

# After pull: sync to all configured platforms (fill missing platform_ids,
# and let issue-sync's _platform_title() normalize the platform title).
# Never swallow a failure silently — the caller (wt-create) must be able to
# diagnose an identity/title mismatch instead of reporting a false success.
local_id="raw-${raw_key}"
if [[ -f "$target/issue.md" ]]; then
  if [[ -x "$ROOT_DIR/bin/issue-sync" ]]; then
    # STDOUT must remain exactly one JSON document: wt-create parses it to
    # verify the materialized identity. Route every diagnostic to STDERR.
    if ! "$ROOT_DIR/bin/issue-sync" create "$local_id" >&2; then
      echo "[WARN] raw-issue-pull: issue-sync create failed for $local_id (platform title normalization may be incomplete)" >&2
    fi
  else
    echo "[WARN] raw-issue-pull: $ROOT_DIR/bin/issue-sync missing; skipped title normalization for $local_id" >&2
  fi
else
  echo "[WARN] raw-issue-pull: expected $target/issue.md missing; skipped issue-sync create for $local_id" >&2
fi
