#!/usr/bin/env bash
set -euo pipefail

required_files=(
  "docs/brainstorm/BRAINSTORM.md"
  "docs/PRD.md"
  "docs/EPIC.md"
  "docs/STORY.md"
  "docs/PROGRESS.md"
  "docs/RECOVERY.md"
)

errors=0

fail() {
  echo "[FAIL] $*"
  errors=$((errors + 1))
}

check_file_exists() {
  local file="$1"
  [[ -f "$file" ]] || fail "missing file: $file"
}

check_no_tbd() {
  local file="$1"
  if rg -n "<TBD>" "$file" >/dev/null 2>&1; then
    fail "placeholder <TBD> found in $file"
  fi
}

check_pattern() {
  local file="$1"
  local pattern="$2"
  local message="$3"
  if ! rg -n "$pattern" "$file" >/dev/null 2>&1; then
    fail "$message ($file)"
  fi
}

for file in "${required_files[@]}"; do
  check_file_exists "$file"
done

for file in "${required_files[@]}"; do
  check_no_tbd "$file"
done

check_pattern "docs/brainstorm/BRAINSTORM.md" "^## (决策|Decision)" "brainstorm decision section missing"
check_pattern "docs/PRD.md" "^## (目标|Goals)" "PRD goals section missing"
check_pattern "docs/EPIC.md" "^## (映射关系|Mapping)" "EPIC mapping section missing"
check_pattern "docs/STORY.md" "^## STORY-[0-9]+" "STORY id section missing"
check_pattern "docs/STORY.md" "Intent -> PRD -> EPIC -> STORY -> Code/Test|Traceability|可追踪|追踪" "traceability statement missing in STORY"
check_pattern "docs/PROGRESS.md" "^## Latest Cycle" "PROGRESS latest cycle section missing"
check_pattern "docs/RECOVERY.md" "^## Latest Checkpoint" "RECOVERY latest checkpoint section missing"

if [[ "$errors" -gt 0 ]]; then
  echo
  echo "BMAD check failed with $errors issue(s)."
  exit 1
fi

echo "BMAD check passed."
