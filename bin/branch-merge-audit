#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  ./bin/branch-merge-audit [--all] [--only-unmerged]

Behavior:
  - audits local branches for merge-back status
  - prints branch type, inferred source branch, required targets, and merge status
  - returns 0 when all audited branches satisfy required targets
  - returns 2 when any audited branch is still unmerged to required targets

Options:
  --all           include protected branches in output
  --only-unmerged show only branches with pending required targets
USAGE
}

include_all=0
only_unmerged=0

for arg in "$@"; do
  case "$arg" in
    --all) include_all=1 ;;
    --only-unmerged) only_unmerged=1 ;;
    -h|--help) usage; exit 0 ;;
    *)
      echo "Unknown option: $arg" >&2
      usage >&2
      exit 1
      ;;
  esac
done

has_branch() {
  git show-ref --verify --quiet "refs/heads/$1"
}

infer_source_branch() {
  local b="$1"

  case "$b" in
    feature/*|feature/premerge-*)
      echo "pre-develop|rule"
      return 0
      ;;
    release/*)
      echo "develop|rule"
      return 0
      ;;
    hotfix/*)
      if has_branch "main"; then
        echo "main|rule"
      else
        echo "unknown|rule"
      fi
      return 0
      ;;
  esac

  local best="unknown"
  local best_ts=0
  local c anc ts
  for c in pre-develop develop main; do
    has_branch "$c" || continue
    anc="$(git merge-base "$b" "$c" || true)"
    [[ -n "$anc" ]] || continue
    ts="$(git show -s --format=%ct "$anc")"
    if (( ts > best_ts )); then
      best_ts="$ts"
      best="$c"
    fi
  done

  echo "${best}|inferred"
}

required_targets() {
  local b="$1"
  local src="$2"

  case "$b" in
    feature/premerge-*) echo "pre-develop" ;;
    feature/*) echo "pre-develop" ;;
    hotfix/*) echo "main develop pre-develop" ;;
    release/*) echo "main develop" ;;
    main|develop|pre-develop) echo "" ;;
    *)
      if [[ "$src" == "unknown" ]]; then
        echo ""
      else
        echo "$src"
      fi
      ;;
  esac
}

branches="$(git for-each-ref --format='%(refname:short)' refs/heads | sort)"

printf "%-8s | %-45s | %-10s | %-18s | %s\n" "STATUS" "BRANCH" "TYPE" "SOURCE(base)" "TARGETS"
printf "%s\n" "------------------------------------------------------------------------------------------------------------------------------"

pending_count=0
shown_count=0

while IFS= read -r b; do
  [[ -n "$b" ]] || continue

  if (( include_all == 0 )); then
    case "$b" in
      main|develop|pre-develop) continue ;;
    esac
  fi

  src_info="$(infer_source_branch "$b")"
  src="${src_info%%|*}"
  src_kind="${src_info##*|}"

  targets="$(required_targets "$b" "$src")"

  case "$b" in
    feature/premerge-*) btype="feature/premerge" ;;
    feature/*) btype="feature" ;;
    hotfix/*) btype="hotfix" ;;
    release/*) btype="release" ;;
    main|develop|pre-develop) btype="protected" ;;
    *) btype="other" ;;
  esac

  target_report=""
  missing=""

  if [[ -z "$targets" ]]; then
    status="INFO"
    target_report="-"
  else
    status="OK"
    for t in $targets; do
      if ! has_branch "$t"; then
        target_report+="${t}:N/A "
        missing+="${t} "
        status="PENDING"
        continue
      fi

      if git merge-base --is-ancestor "$b" "$t"; then
        target_report+="${t}:Y "
      else
        target_report+="${t}:N "
        missing+="${t} "
        status="PENDING"
      fi
    done
  fi

  if (( only_unmerged == 1 )) && [[ "$status" != "PENDING" ]]; then
    continue
  fi

  shown_count=$((shown_count + 1))
  if [[ "$status" == "PENDING" ]]; then
    pending_count=$((pending_count + 1))
  fi

  printf "%-8s | %-45s | %-10s | %-18s | %s\n" \
    "$status" "$b" "$btype" "${src}(${src_kind})" "${target_report% }"
done <<< "$branches"

echo "---"
echo "Summary: shown=${shown_count}, pending=${pending_count}"
echo "Legend: target Y=merged, N=not merged, N/A=target branch missing"

if (( pending_count > 0 )); then
  exit 2
fi

