#!/usr/bin/env bash
# bin/test-gate — extracted from scripts/runtime/freely (#4160).
#
# `freely test-gate run|record` used to live inline in the 27k-line monolith.
# The bodies moved here unchanged; the monolith now keeps a three-line
# projection (`exec bash "$SELF_ROOT/bin/test-gate" ...`), so the behaviour is
# identical while the monolith shrinks.
#
# The gate itself: evidence belongs to the test-pre-merge-* worktree, so both
# subcommands refuse any other branch instead of writing evidence for the wrong
# commit.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=/dev/null
source "$ROOT_DIR/docs/system/workspace/scripts/runtime/lib/common.sh"

_test_gate_file() {
  echo "$(run_dir_for_project "$1")/test-gate.env"
}

_test_gate_write() {
  local project="$1" status="$2" tested_commit="${3:-}"
  local gate_file tmp
  gate_file="$(_test_gate_file "$project")"
  mkdir -p "$(dirname "$gate_file")"
  tmp="$(mktemp "$(dirname "$gate_file")/.test-gate.XXXXXX")"
  {
    printf 'TEST_STATUS="%s"\n' "$status"
    printf 'LAST_TESTED_AT="%s"\n' "$(current_timestamp_utc_for_machine)"
    printf 'LAST_TESTED_COMMIT="%s"\n' "$tested_commit"
  } >"$tmp"
  mv "$tmp" "$gate_file"
}

cmd_run() {
  local target="" command=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --worktree|--project) target="${2:-}"; shift 2 || true ;;
      --command) command="${2:-}"; shift 2 || true ;;
      --) shift; command="$*"; break ;;
      -h|--help)
        printf '%s\n' "Usage: freely test-gate run --worktree <test worktree> --command <shell cmd> | -- <cmd...>"
        return 0
        ;;
      *) log_error "test-gate run: unknown argument: $1"; return 2 ;;
    esac
  done
  [[ -n "$target" && -n "$command" ]] || {
    log_error "test-gate run: --worktree and --command are required"; return 2; }
  [[ -d "$target" ]] || { log_error "test-gate run: no such worktree: $target"; return 2; }
  local branch
  branch="$(git -C "$target" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  [[ "$branch" == test-pre-merge-* ]] || {
    log_error "test-gate run: '$target' is not a test-pre-merge-* worktree"; return 2; }
  local helper="$ROOT_DIR/docs/system/workspace/scripts/quality/test-evidence.py"
  [[ -f "$helper" ]] || { log_error "test-gate run: missing $helper"; return 2; }

  local evidence="$target/.freely/run/test-evidence.log" rc=0 head status="completed"
  mkdir -p "$(dirname "$evidence")"
  ( cd "$target" && bash -c "$command" ) > "$evidence" 2>&1 || rc=$?
  head="$(git -C "$target" rev-parse HEAD 2>/dev/null || true)"
  [[ "$rc" -eq 0 ]] || status="failed"
  python3 "$helper" write --gate "$(_test_gate_file "$target")" \
    --status "$status" --command "$command" --exit-code "$rc" \
    --evidence "$evidence" --head "$head" >/dev/null || return 1
  echo "[test-gate] run: rc=$rc status=$status command=$command"
  echo "[test-gate] evidence: $evidence"
  return "$rc"
}

cmd_record() {
  local target="" status="" commit=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --worktree|--project) target="${2:-}"; shift 2 || true ;;
      --status) status="${2:-}"; shift 2 || true ;;
      --commit) commit="${2:-}"; shift 2 || true ;;
      -h|--help)
        printf '%s\n' "Usage: freely test-gate record --worktree <test worktree> --status started|completed|failed [--commit <sha>]"
        return 0
        ;;
      *) log_error "test-gate record: unknown argument: $1"; return 2 ;;
    esac
  done
  case "$status" in
    started|completed|failed) ;;
    *) log_error "test-gate record: --status must be one of started|completed|failed"; return 2 ;;
  esac
  target="${target:-$PWD}"
  [[ -d "$target" ]] || { log_error "test-gate record: no such worktree: $target"; return 2; }
  local branch
  branch="$(git -C "$target" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  if [[ "$branch" != test-pre-merge-* ]]; then
    log_error "test-gate record: '$target' is on branch '${branch:-<detached>}', not a test-pre-merge-* worktree"
    log_error "  test evidence belongs to the test worktree; pass --worktree <test worktree>"
    return 2
  fi
  if [[ "$status" == "completed" ]]; then
    if [[ -n "$commit" ]]; then
      if ! git -C "$target" rev-parse --verify --quiet "${commit}^{commit}" >/dev/null 2>&1; then
        log_error "test-gate record: --commit '$commit' is not a commit of $target"
        return 2
      fi
      commit="$(git -C "$target" rev-parse "${commit}^{commit}")"
    else
      commit="$(git -C "$target" rev-parse HEAD)"
    fi
  fi
  _test_gate_write "$target" "$status" "$commit"
  echo "[test-gate] $target: TEST_STATUS=$status LAST_TESTED_COMMIT=${commit:-<none>}"
}

main() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    run) cmd_run "$@" ;;
    record) cmd_record "$@" ;;
    -h|--help|"")
      printf '%s\n' "Usage: bin/test-gate run|record <args...>"
      [[ -n "$sub" ]] || exit 1
      ;;
    *) log_error "unknown test-gate subcommand: $sub"; exit 1 ;;
  esac
}

main "$@"
