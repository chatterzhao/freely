#!/usr/bin/env bash
set -euo pipefail

TOOL_NAME="freely"
STATE_DIR_NAME=".freely"
SELF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

log_info() { echo "[INFO] $*"; }
log_warn() { echo "[WARN] $*"; }
log_error() { echo "[ERROR] $*" >&2; }

usage() {
  cat <<'EOF'
Usage:
  freely init --project <abs_path> --intent <abs_file> --constitution <abs_file> --ai <tool[:model][:mode]>
  freely doctor --project <abs_path>
  freely start --project <abs_path>
  freely status --project <abs_path>
  freely stop --project <abs_path>

AI mode:
  auto  -> non-interactive, auto-approve (where supported)
  step  -> interactive/approval mode
EOF
}

check_doc_gate_or_fail() {
  local project="$1"
  local failed=0
  local required=(
    "docs/PROJECT_INTENT.md"
    "docs/CONSTITUTION.md"
    "docs/brainstorms/BRAINSTORM.md"
    "docs/planning/PRD.md"
    "docs/planning/EPIC.md"
    "docs/planning/STORY.md"
    "docs/validation/PRE_TEST.md"
    "docs/continuity/PROGRESS.md"
    "docs/continuity/RECOVERY.md"
  )

  for rel in "${required[@]}"; do
    if [[ ! -f "$project/$rel" ]]; then
      log_error "doc gate failed: missing $project/$rel"
      failed=1
    fi
  done

  if [[ -f "$project/docs/validation/PRE_TEST.md" ]]; then
    if ! grep -Eq 'CASE-[0-9]+' "$project/docs/validation/PRE_TEST.md"; then
      log_error "doc gate failed: docs/validation/PRE_TEST.md must include at least one CASE-* test case"
      failed=1
    fi
  fi

  if [[ "$failed" -ne 0 ]]; then
    return 1
  fi

  log_info "doc gate PASS"
}

abs_path_or_fail() {
  local p="$1"
  if [[ "$p" != /* ]]; then
    log_error "path must be absolute: $p"
    exit 1
  fi
  echo "$p"
}

parse_ai_spec() {
  local spec="$1"
  local tool="" model="" mode="auto"

  IFS=':' read -r tool model mode <<<"$spec"
  [[ -n "${tool:-}" ]] || { log_error "invalid --ai spec: $spec"; exit 1; }
  [[ -n "${mode:-}" ]] || mode="auto"
  [[ "$mode" == "auto" || "$mode" == "step" ]] || {
    log_error "unsupported mode: $mode (supported: auto, step)"
    exit 1
  }

  case "$tool" in
    codex|kiro-cli|iflow) ;;
    *)
      log_error "unsupported tool: $tool (supported: codex, kiro-cli, iflow)"
      exit 1
      ;;
  esac

  echo "$tool|$model|$mode"
}

state_dir() {
  local project="$1"
  echo "$project/$STATE_DIR_NAME"
}

config_file() {
  local project="$1"
  echo "$(state_dir "$project")/config.env"
}

load_config() {
  local project="$1"
  local cfg
  cfg="$(config_file "$project")"
  [[ -f "$cfg" ]] || { log_error "missing config: $cfg"; exit 1; }
  # shellcheck disable=SC1090
  source "$cfg"
}

write_config() {
  local project="$1" intent="$2" constitution="$3" tool="$4" model="$5" mode="$6"
  local sdir cfg
  sdir="$(state_dir "$project")"
  cfg="$(config_file "$project")"
  mkdir -p "$sdir/logs" "$sdir/run"

  cat >"$cfg" <<EOF
PROJECT_ROOT="$project"
INTENT_FILE="$intent"
CONSTITUTION_FILE="$constitution"
AI_TOOL="$tool"
AI_MODEL="$model"
AI_MODE="$mode"
CHECK_INTERVAL=10
RESTART_DELAY=2
MAX_RESTARTS=0
IFLOW_MAX_TURNS=100
EOF
}

workspace_root_for_project() {
  local project="$1"
  if [[ -d "$project/docs/system/workspace" ]]; then
    echo "$project/docs/system/workspace"
  else
    echo "$SELF_ROOT/docs/system/workspace"
  fi
}

build_prompt() {
  local workspace_root
  workspace_root="$(workspace_root_for_project "$PROJECT_ROOT")"
  bash "$workspace_root/scripts/start-lead-agent.sh" \
    --project "$PROJECT_ROOT" \
    --intent "$INTENT_FILE" \
    --constitution "$CONSTITUTION_FILE" \
    --ai "${AI_TOOL}:${AI_MODEL:-}:${AI_MODE}"
}

cmd_init() {
  local project="" intent="" constitution="" ai_spec=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --intent) intent="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --constitution) constitution="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      --ai) ai_spec="${2:-}"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done

  [[ -n "$project" && -n "$intent" && -n "$constitution" && -n "$ai_spec" ]] || {
    usage
    exit 1
  }
  [[ -d "$project" ]] || { log_error "project not found: $project"; exit 1; }
  [[ -f "$intent" ]] || { log_error "intent file not found: $intent"; exit 1; }
  [[ -f "$constitution" ]] || { log_error "constitution file not found: $constitution"; exit 1; }

  local parsed tool model mode
  parsed="$(parse_ai_spec "$ai_spec")"
  IFS='|' read -r tool model mode <<<"$parsed"

  write_config "$project" "$intent" "$constitution" "$tool" "$model" "$mode"
  log_info "initialized: $(config_file "$project")"
}

cmd_start() {
  local project=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  [[ -n "$project" ]] || { usage; exit 1; }
  load_config "$project"
  check_doc_gate_or_fail "$PROJECT_ROOT" || {
    log_error "start blocked by doc gate"
    exit 1
  }

  local sdir run_dir logs_dir sup_pid_file child_pid_file loop_log
  local stop_requested=0
  sdir="$(state_dir "$project")"
  run_dir="$sdir/run"
  logs_dir="$sdir/logs"
  sup_pid_file="$run_dir/supervisor.pid"
  child_pid_file="$run_dir/ai.pid"
  loop_log="$logs_dir/loop.log"
  mkdir -p "$run_dir" "$logs_dir"

  if [[ -f "$sup_pid_file" ]]; then
    local old_pid
    old_pid="$(cat "$sup_pid_file" 2>/dev/null || true)"
    if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
      log_error "already running (supervisor pid=$old_pid)"
      exit 1
    fi
  fi

  request_stop() {
    stop_requested=1
    if [[ -f "$child_pid_file" ]]; then
      local active_child
      active_child="$(cat "$child_pid_file" 2>/dev/null || true)"
      [[ -n "$active_child" ]] && kill "$active_child" 2>/dev/null || true
    fi
  }

  echo "$$" >"$sup_pid_file"
  trap "rm -f '$sup_pid_file' '$child_pid_file'" EXIT
  trap request_stop INT TERM

  local restart_count=0
  local first_round=true
  while true; do
    local ts prompt_file cycle_log mode_name
    ts="$(date '+%Y%m%d-%H%M%S')"
    prompt_file="$run_dir/prompt-$ts.txt"
    cycle_log="$logs_dir/cycle-$ts.log"
    build_prompt >"$prompt_file"

    if [[ "$first_round" == true ]]; then
      mode_name="fresh"
    else
      mode_name="resume"
    fi

    log_info "launching $AI_TOOL ($mode_name mode, ai_mode=$AI_MODE)"
    set +e
    {
      echo "===== $(date '+%F %T') mode=$mode_name tool=$AI_TOOL ai_mode=$AI_MODE ====="
      local workspace_root
      workspace_root="$(workspace_root_for_project "$PROJECT_ROOT")"
      bash "$workspace_root/scripts/monitor-ai-cli.sh" \
        --project "$PROJECT_ROOT" \
        --tool "$AI_TOOL" \
        --model "${AI_MODEL:-}" \
        --mode "$AI_MODE" \
        --prompt-file "$prompt_file" \
        --pid-file "$child_pid_file" \
        --log-file "$cycle_log" \
        --launch-kind "$mode_name"
    } >>"$loop_log" 2>&1
    local rc=$?
    set -e
    local child_pid
    child_pid="$(cat "$child_pid_file" 2>/dev/null || true)"
    log_warn "ai process exited rc=$rc (pid=${child_pid:-unknown})"

    if [[ "$stop_requested" -eq 1 ]]; then
      log_info "received stop signal, exiting supervisor"
      exit 0
    fi

    first_round=false
    restart_count=$((restart_count + 1))
    if [[ "${MAX_RESTARTS:-0}" -gt 0 && "$restart_count" -gt "${MAX_RESTARTS:-0}" ]]; then
      log_error "reached MAX_RESTARTS=${MAX_RESTARTS}, stopping"
      exit 1
    fi
    sleep "${RESTART_DELAY:-2}"
  done
}

cmd_doctor() {
  local project=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  [[ -n "$project" ]] || { usage; exit 1; }
  check_doc_gate_or_fail "$project"
}

cmd_status() {
  local project=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  [[ -n "$project" ]] || { usage; exit 1; }
  load_config "$project"
  local sdir run_dir
  sdir="$(state_dir "$project")"
  run_dir="$sdir/run"

  echo "project: $PROJECT_ROOT"
  echo "intent: $INTENT_FILE"
  echo "constitution: $CONSTITUTION_FILE"
  echo "ai: ${AI_TOOL}:${AI_MODEL:-default}:${AI_MODE}"
  echo "state_dir: $sdir"
  if [[ -f "$run_dir/supervisor.pid" ]]; then
    local sp
    sp="$(cat "$run_dir/supervisor.pid" 2>/dev/null || true)"
    echo "supervisor_pid: ${sp:-none}"
  else
    echo "supervisor_pid: none"
  fi
  if [[ -f "$run_dir/ai.pid" ]]; then
    local ap
    ap="$(cat "$run_dir/ai.pid" 2>/dev/null || true)"
    echo "ai_pid: ${ap:-none}"
  else
    echo "ai_pid: none"
  fi
}

cmd_stop() {
  local project=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$(abs_path_or_fail "${2:-}")"; shift 2 ;;
      *) log_error "unknown arg: $1"; usage; exit 1 ;;
    esac
  done
  [[ -n "$project" ]] || { usage; exit 1; }
  local sdir run_dir
  sdir="$(state_dir "$project")"
  run_dir="$sdir/run"

  if [[ -f "$run_dir/ai.pid" ]]; then
    local ap
    ap="$(cat "$run_dir/ai.pid" 2>/dev/null || true)"
    [[ -n "$ap" ]] && kill "$ap" 2>/dev/null || true
    rm -f "$run_dir/ai.pid"
  fi
  if [[ -f "$run_dir/supervisor.pid" ]]; then
    local sp
    sp="$(cat "$run_dir/supervisor.pid" 2>/dev/null || true)"
    [[ -n "$sp" ]] && kill "$sp" 2>/dev/null || true
    rm -f "$run_dir/supervisor.pid"
  fi
  log_info "stopped (if running)"
}

main() {
  local cmd="${1:-}"
  [[ -n "$cmd" ]] || { usage; exit 1; }
  shift || true
  case "$cmd" in
    init) cmd_init "$@" ;;
    doctor) cmd_doctor "$@" ;;
    start) cmd_start "$@" ;;
    status) cmd_status "$@" ;;
    stop) cmd_stop "$@" ;;
    *) log_error "unknown command: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"
