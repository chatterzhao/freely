# ───────────────────────────────────────────────────────────────────
# Freely 项目配置文件 (config.toml)
# ───────────────────────────────────────────────────────────────────
#
# 此文件由 freely init 自动创建和更新:
#   - 首次 init: 从 config.toml.example 复制
#   - 后续 init: 只补充缺失字段，不动已有值
#   - --reset:   备份(时间戳)后重新从 example 复制，再更新
#
# 格式: TOML
#   - 字符串: key = "value"
#   - 布尔:   key = true / false (不加引号)
#   - 整数:   key = 10
#   - 浮点:   key = 0.70
#
# 标记说明:
#   [init代填]  freely init 时自动填入
#   [用户必填]  必须根据项目实际情况修改
#   [可选]      有默认值，可按需修改
#   ⚠️          留空或删除此字段的后果


# ══════════════════════════════════════════════════════════════════════
# 一、项目基础
# ══════════════════════════════════════════════════════════════════════

# [init代填] 项目根目录的绝对路径。freely 所有 git/worktree/文件操作以此为基准。
# init 时自动填入当前 git 仓库根目录 (`git rev-parse --show-toplevel`)。
# ⚠️ 留空 = freely 完全无法工作
PROJECT_ROOT = ""

# [init代填] 项目意图文件 (PROJECT_INTENT.md)，描述项目目标和核心需求。
# Manager 将此文件内容注入 AI 提示作为行为约束。
# init 时自动检测 $PROJECT_ROOT/docs/PROJECT_INTENT.md。
# ⚠️ 留空 = AI 缺少目标约束
INTENT_FILE = ""

# [init代填] 项目宪法文件 (CONSTITUTION.md)，定义不可违背的架构和开发约束。
# Manager 将此文件内容注入 AI 提示作为硬性边界。
# init 时自动检测 $PROJECT_ROOT/docs/CONSTITUTION.md。
# ⚠️ 留空 = AI 缺少硬性边界约束
CONSTITUTION_FILE = ""

# [init代填] Freely 安装根目录。用于定位模板、脚本、skill 等资源文件。
# init 时自动填入当前 freely 执行路径。
# ⚠️ 留空 = 部分模板和脚本功能不可用
FREELY_HOME = ""


# ══════════════════════════════════════════════════════════════════════
# 二、AI 工具配置
# ══════════════════════════════════════════════════════════════════════

# [已废弃] 运行时不再使用此字段。AI 工具改为通过 agent-table.toml 的 slot 配置决定。
# 保留仅用于无 agent-table 时的回退兼容。
# 如需修改 AI 工具，请编辑 .freely/agent-table.toml 中的 manager_slot / worker_slot。
AI_TOOL = ""

# [用户必填] AI 模型名称。通过 ACP binary 的 --model 标志传递给 AI CLI。
# 不同工具支持的模型不同，详见对应工具文档。
# 示例: claude-sonnet-4-6 / claude-opus-4-8 / gpt-5.5
# ⚠️ 留空 = 使用工具默认模型
AI_MODEL = ""

# [可选] 运行模式。控制 freely 的自主程度和交互行为。
# 合法值:
#   auto — 全自主模式。自动执行、自动批准。
#   step — 交互模式。每次执行前等待确认。
#   wait — 监听模式。不主动执行，只响应人类插话。
# 默认值: "auto"
# ⚠️ 留空 = 默认 auto
AI_MODE = "auto"

# [可选] 推理深度。通过 ACP binary 的 --effort 标志传递给 AI CLI。
# 合法值: low(快速) | medium(均衡) | high(深度推理)
# 默认值: "medium"
# ⚠️ 留空 = 默认 medium
AI_REASONING_EFFORT = "medium"


# ══════════════════════════════════════════════════════════════════════
# 三、AI 工具适配器
# ══════════════════════════════════════════════════════════════════════

# [可选] AI 通信协议。
# 合法值:
#   acp    — Agent Client Protocol。通过 ACP bridge 通信，支持 session/resume/fork。
#   direct — 直接调用 AI CLI (已废弃)。
# 默认值: "acp"
# ⚠️ 留空 = 默认 acp
AI_TOOL_ADAPTER = "acp"

# [可选] 适配器策略。
# 合法值: direct(透传) | acp(强制ACP) | prefer_acp_fallback_direct(ACP优先)
# 默认值: "acp"
AI_TOOL_ADAPTER_POLICY = "acp"

# [可选] 自定义 AI 能力列表（逗号分隔）。留空使用工具默认能力。
AI_TOOL_CAPABILITIES = ""

# [可选] 全局 AI 策略。留空使用工具默认策略。
AI_TOOL_POLICY = ""


# ══════════════════════════════════════════════════════════════════════
# 四、Codex 特定 (仅 AI_TOOL=codex 时生效)
# ══════════════════════════════════════════════════════════════════════

# [可选] Codex 使用的模型。留空使用 AI_MODEL 的值。
AI_CAPABILITY_CODEX_MODEL = ""

# [可选] Codex 沙箱模式。
# 合法值: read-only(只读) | workspace-write(可写工作区) | danger-full-access(全权限)
# 默认值: "project-bootstrap-managed"
# ⚠️ 留空 = 默认 project-bootstrap-managed
AI_CAPABILITY_CODEX_SANDBOX = "project-bootstrap-managed"

# [可选] Codex 批准策略。
# 合法值: never(自动批准) | on-failure(失败时) | on-request(请求时) | always(每次)
# 默认值: "project-bootstrap-managed"
# ⚠️ 留空 = 默认 project-bootstrap-managed
AI_CAPABILITY_CODEX_APPROVAL_POLICY = "project-bootstrap-managed"

# [可选] Codex 工作目录模式。
# 合法值: project(项目根目录) | auto(Codex 决定)
# 默认值: "project-root"
# ⚠️ 留空 = 默认 project-root
AI_CAPABILITY_CODEX_CWD_MODE = "project-root"


# ══════════════════════════════════════════════════════════════════════
# 五、自动切换
# ══════════════════════════════════════════════════════════════════════

# [可选] Slot 自动切换。当前 slot 限流/失效时自动换备用。
# 默认值: true
AUTO_SWITCH_SLOT = true

# [可选] 跨工具自动回退。当前工具不可用时按 AI_FALLBACK_TOOLS 顺序尝试。
# 默认值: false
AUTO_SWITCH_TOOL = false

# [可选] 网络失败后自动修复代理配置。
# 默认值: true
AUTO_SETUP_FREELY_PROXY = true


# ══════════════════════════════════════════════════════════════════════
# 六、回退工具
# ══════════════════════════════════════════════════════════════════════

# [可选] 备选 AI 工具列表。当主工具不可用时按此顺序尝试。
# 格式: 逗号分隔的工具名 (如 "codex,opencode,cline")
# 工具名需与 tool-registry.toml 中的 section 名一致。
# 默认值: "" (不启用跨工具回退)
# ⚠️ 留空 = 不自动回退，daemon 停止等待人工干预
AI_FALLBACK_TOOLS = ""


# ══════════════════════════════════════════════════════════════════════
# 七、循环控制
# ══════════════════════════════════════════════════════════════════════

# [可选] Manager 主循环检查间隔 (秒)。越小响应越快但 CPU 消耗越大。
# 默认值: 10
CHECK_INTERVAL = 10

# [可选] 异常退出后等待此秒数再重启。
# 默认值: 2
RESTART_DELAY = 2

# [可选] 最大连续重启次数。0 = 不限制。达到后停止自动重启。
# 默认值: 0 (不限制)
MAX_RESTARTS = 0


# ══════════════════════════════════════════════════════════════════════
# 八、流控
# ══════════════════════════════════════════════════════════════════════

# [可选] 最大连续恢复次数。超过后强制轮转 session。
# 默认值: 24
MAX_RESUME_STREAK = 24

# [可选] 最大连续仅路由 handoff 次数。超过后强制轮转。
# 默认值: 1
MAX_ROUTE_ONLY_STREAK = 1

# [可选] 上下文压缩后是否轮转 session。1=轮转, 0=不轮转。
# 默认值: 1
ROTATE_ON_CONTEXT_COMPACTED = 1

# [可选] Handoff 传递的前次会话日志尾部行数。
# 默认值: 80
SESSION_HANDOFF_TAIL_LINES = 80


# ══════════════════════════════════════════════════════════════════════
# 九、上下文管理
# ══════════════════════════════════════════════════════════════════════

# [可选] 上下文使用警告阈值 (占最大 context 的比例, 0-1)。
# 达到此值时 Manager 发出警告但继续运行。
# 默认值: 0.70 (70%)
CONTEXT_WARN_RATIO = 0.70

# [可选] 上下文强制轮转阈值 (占最大 context 的比例, 0-1)。
# 达到此值时 Manager 强制轮转 session。必须 >= CONTEXT_WARN_RATIO。
# 默认值: 0.70
# 注意: init 会写入 0.85，但运行时空值回退为 0.70。如需更早轮转，手动设为 0.85。
CONTEXT_ROTATE_RATIO = 0.70


# ══════════════════════════════════════════════════════════════════════
# 十、Checkpoint
# ══════════════════════════════════════════════════════════════════════

CHECKPOINT_WARN_DIRTY_ENTRIES = 40     # 脏文件警告阈值 (个)
CHECKPOINT_BLOCK_DIRTY_ENTRIES = 120   # 脏文件阻塞阈值 (个)
CHECKPOINT_DRIFT_STREAK_THRESHOLD = 2  # 漂移检测阈值 (连续次数)


# ══════════════════════════════════════════════════════════════════════
# 十一、风暴保护
# ══════════════════════════════════════════════════════════════════════

# [可选] 风暴检测时间窗口 (秒)。窗口内重启超过阈值次数触发保护。
# 触发后暂停自动重启，等待人工介入。
# 默认值: 30
RESTART_STORM_WINDOW_SECS = 30

# [可选] 风暴检测阈值 (次)。窗口内重启超过此次数触发保护。
# 默认值: 4
RESTART_STORM_COUNT = 4

# [可选] 进程抖动峰值。并发进程超过此值触发保护。
# 默认值: 3
PROCESS_CHURN_PEAK = 3

# [可选] 风暴触发后观察延迟 (秒)。
# 默认值: 30
RESTART_STORM_OBSERVE_DELAY_SECS = 30


# ══════════════════════════════════════════════════════════════════════
# 十二、网络代理
# ══════════════════════════════════════════════════════════════════════

# [可选] 代理模式。
# 合法值:
#   inherit  — 继承系统环境变量 (HTTP_PROXY, HTTPS_PROXY 等)
#   disabled — 直连，不使用任何代理
#   explicit — 使用下面自定义的代理地址
# 默认值: "inherit"
FREELY_NETWORK_PROXY_MODE = "inherit"

# 以下仅在 mode=explicit 时需要填写
FREELY_NETWORK_PROXY_URL = ""   # 通用代理 (http://host:port 或 socks5://)
FREELY_HTTP_PROXY = ""          # HTTP 代理
FREELY_HTTPS_PROXY = ""         # HTTPS 代理
FREELY_ALL_PROXY = ""           # 全局代理 (覆盖上述)
FREELY_NO_PROXY = ""            # 不走代理的地址 (逗号分隔)


# ══════════════════════════════════════════════════════════════════════
# 十三、仓库平台
# ══════════════════════════════════════════════════════════════════════

# [用户必填] Freely 扫描 Issues/PRs 的代码托管平台。
# 合法值: 逗号分隔 "github" / "gitee"
# 示例: "github,gitee" 或 "github"
# 需要对应 CLI: github→gh, gitee→gitee
# ⚠️ 留空 = 不扫描任何平台，Manager 不会自动发现 Issues/PRs
FREELY_REPO_PLATFORMS = ""


# ══════════════════════════════════════════════════════════════════════
# 十四、安全审查
# ══════════════════════════════════════════════════════════════════════

# [可选] 安全审查策略。
# 合法值:
#   advisory-on-high-risk-or-uncertainty — 高风险或不确定时建议审查 (推荐)
#   always                               — 每次都审查
#   never                                — 不审查
FREELY_SECURITY_REVIEW_POLICY = "advisory-on-high-risk-or-uncertainty"

# [可选] 安全审查范围。
# 合法值:
#   execution-boundary-and-reviewer-support — 执行边界 + 审查者支持 (推荐)
#   full-boundary-audit                     — 全边界审计
FREELY_SECURITY_REVIEW_SCOPE = "execution-boundary-and-reviewer-support"


# ══════════════════════════════════════════════════════════════════════
# 十五、自治与安全姿态 (init 时自动设置)
# ══════════════════════════════════════════════════════════════════════

# [init代填] 自治级别。由 AI_MODE 推导: auto→autonomous-default, step→supervised。
FREELY_AUTONOMY_PROFILE = "autonomous-default"

# [init代填] 交互姿态。由 AI_MODE 推导: auto→non-interactive, step→interactive。
FREELY_INTERACTION_POSTURE = "non-interactive"

# [init代填] 批准姿态。由 AI_MODE 推导: auto→automatic-where-supported, step→explicit。
FREELY_APPROVAL_POSTURE = "automatic-where-supported"

# [init代填] 防护引导: recommended-nonblocking(建议不阻塞) | strict-blocking(严格阻塞)
FREELY_SAFEGUARD_GUIDANCE_POSTURE = "recommended-nonblocking"

# [init代填] 运行时决策: internal-ai-escalation-before-stop(AI内部升级后停止) | operator-decide(操作者决定)
FREELY_RUNTIME_DECISION_POSTURE = "internal-ai-escalation-before-stop"

# [init代填] 最小风险姿态 (固定值，不可修改)
FREELY_MINIMAL_RISK_POSTURE = "last-resort-safe-stop"

# ── 激活同意 (init 时自动设置) ──

# [init代填] auto 模式需要激活同意
FREELY_ACTIVATION_CONSENT_REQUIRED = "true"

# [init代填] 同意状态: accepted(已同意) | pending(待同意) | not-required(不需要)
FREELY_ACTIVATION_CONSENT_STATUS = "accepted"

# [init代填] 激活同意记录时间 (ISO 8601 UTC, init 时自动填入)
FREELY_ACTIVATION_CONSENT_RECORDED_AT = ""

# [init代填] 激活同意记录方式 (flag / interactive / freely-init)
FREELY_ACTIVATION_CONSENT_RECORDED_VIA = ""


# ══════════════════════════════════════════════════════════════════════
# 十六、ACP Binary 路径 (init 自动发现/下载后填入)
# ══════════════════════════════════════════════════════════════════════

# [init代填] 各工具 ACP binary 的绝对路径。
# freely init 会自动搜索系统 (PATH、npm 全局安装、缓存目录)，找到后填入。
# 未找到则提示下载 (--auto 自动确认)。
# 留空 = 使用该工具的 agent 无法启动 ACP bridge。

FREELY_ACP_CLAUDE_BIN = ""
FREELY_ACP_CODEX_BIN = ""
FREELY_ACP_OPENCODE_BIN = ""
FREELY_ACP_CLINE_BIN = ""
