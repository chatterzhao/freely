# Freely Agent Table — multi-agent instance registry
# =============================================================================
# This file is THE single source of truth for all agent slots.
# AI_TOOL is deprecated — agent-table replaces it entirely.
#
# Setup:
#   1. Create slot folders under ~/.ai-auth/<tool>-apikey-<name>/
#      (e.g. ~/.ai-auth/claude-apikey-ds-pro-auto/)
#   2. Configure credentials in that folder (settings.json, config.toml, etc.)
#   3. Fill in the slot fields below with your folder names
#   4. Test: bin/agent-table-query --get-slot manager_01
#
# Fields per [[agents]]:
#   role         — agent role: manager, worker, reviewer
#   {role}_id    — agent identifier (e.g. manager_01, worker_01, reviewer_01)
#   {role}_slot  — AI CLI tool slot name (maps to ~/.ai-auth/ subfolder)
#   pool         — max concurrent instances
#
# Reviewer pool=99: reviewers don't modify code, many can work per worktree.
# =============================================================================

[[agents]]
role = "manager"
manager_id = "manager_01"
manager_slot = "<ai cli tool>-apikey|account-custom-others"  # 如 "claude-apikey-ds-pro"
pool = 1

[[agents]]
role = "worker"
worker_id = "worker_01"
worker_slot = "<ai cli tool>-apikey|account-custom-others"  # 如 "codex-account-myaccount"
pool = 10

[[agents]]
role = "reviewer"
reviewer_id = "reviewer_01"
reviewer_slot = "<ai cli tool>-apikey|account-custom-others"  # 如 "opencode-apikey-glm-5.1-auto"
pool = 99
