# Freely Agent Table — multi-agent instance registry
# =============================================================================
# This file defines agent identities and their AI CLI tool slots.
# Runtime reads this to know which agents exist and what tools they use.
#
# Setup:
#   1. Create slot folders under ~/.ai-auth/<tool>-apikey-<name>/
#   2. Fill in the slot fields below with your folder names
#   3. freely init auto-generates this file from this template
#
# Fields:
#   role      — agent role: manager, worker, reviewer
#   agent_id  — unique ID, pool=N auto-generates agent_id_01..agent_id_N
#   slot      — which AI CLI tool slot to use
#   pool      — how many concurrent instances (1 for manager, N for worker/reviewer)
#
# Reviewer pool=99: reviewers don't modify code, can have many per worktree.
# =============================================================================

[[agents]]
role = "manager"
agent_id = "manager"
slot = "claude-apikey-ds-pro-auto"
pool = 1

[[agents]]
role = "worker"
agent_id = "worker"
slot = "claude-apikey-ds-pro-auto"
pool = 10

[[agents]]
role = "reviewer"
agent_id = "reviewer"
slot = "claude-apikey-ds-pro-auto"
pool = 99
