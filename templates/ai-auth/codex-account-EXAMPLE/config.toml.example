# =============================================
# Freely ~/.ai-auth/ slot config template
# Naming convention: {tool}-{type}-{name}
#   tool = codex  type = account  name = EXAMPLE
# =============================================
# codex account mode uses API key-based auth
# via CODEX_API_KEY env var or --api-key flag.
#
# Replace "your-apikey" with your actual key.
# Do NOT commit this file with real keys.
# =============================================

model = "claude-sonnet-4-20250514"
sandbox = false
approval_policy = "auto"
auto_approve = true
api_key = "your-apikey"

[writable_roots]
  "." = true
