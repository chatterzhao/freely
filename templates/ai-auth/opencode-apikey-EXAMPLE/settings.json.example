{
  "model": "deepseek-v4-flash-free",
  "providerConfig": {
    "type": "opencode",
    "apiKeyEnvVar": "OPENCODE_API_KEY",
    "apiKeyHelper": {
      "enabled": true,
      "storage": "keychain"
    }
  },
  "env": {
    "OPENCODE_DEFAULT_MODEL": "deepseek-v4-flash-free"
  },
  "permissionMode": "bypassPermissions",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(git *)",
      "Read(*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~/*)"
    ]
  },
  "theme": "dark",
  "editor": "vim"
}
