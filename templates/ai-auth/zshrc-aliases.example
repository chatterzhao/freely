# ===================================================
# Freely ai-auth slot zshrc aliases example
# Naming convention: {tool}-{type}-{name}
# ===================================================
# Add these lines to your ~/.zshrc to create
# convenient aliases for your auth slots.
#
# The alias name MUST match the slot directory name.
# ===================================================

# Claude API key mode
alias claude-apikey-personal="claude"

# Codex account mode
alias codex-account-work="codex"

# OpenCode API key mode (API key from env)
alias opencode-apikey-default="opencode"
