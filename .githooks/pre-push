#!/usr/bin/env bash
set -euo pipefail

CONSTITUTION_PATH="./docs/CONSTITUTION.md"
CONSTITUTION_ANCHOR="#2-branch-and-worktree-policy-hard-requirement"

# 获取当前分支名
current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue

  local_branch="${local_ref#refs/heads/}"
  remote_branch="${remote_ref#refs/heads/}"

  # 允许 main, develop, pre-develop 直接 push
  case "$local_branch" in
    main|develop|pre-develop)
      continue
      ;;
  esac

  # feature/* 分支只能 push 到同名分支
  if [[ "$local_branch" == feature/* ]]; then
    # 允许 push 到同名 feature 分支
    if [[ "$remote_branch" == "$local_branch" ]]; then
      continue
    fi
    
    cat >&2 <<MSG
[HOOK] Push blocked: feature branch '$local_branch' can only push to:
- Same branch on remote (refs/heads/$local_branch)

Attempted to push to: $remote_ref

To merge feature into pre-develop, use:
  git checkout pre-develop && git merge $local_branch
MSG
    exit 1
  fi

  # hotfix/* 分支
  if [[ "$local_branch" == hotfix/* ]]; then
    # 允许 push 到同名 hotfix 分支
    if [[ "$remote_branch" == "$local_branch" ]]; then
      continue
    fi
    
    cat >&2 <<MSG
[HOOK] Push blocked: hotfix branch '$local_branch' can only push to:
- Same branch on remote (refs/heads/$local_branch)

To merge hotfix into main/develop, checkout target branch and merge.
MSG
    exit 1
  fi

  # release/* 分支
  if [[ "$local_branch" == release/* ]]; then
    # 允许 push 到同名 release 分支
    if [[ "$remote_branch" == "$local_branch" ]]; then
      continue
    fi
    
    cat >&2 <<MSG
[HOOK] Push blocked: release branch '$local_branch' can only push to:
- Same branch on remote (refs/heads/$local_branch)

To merge release into main, checkout main and merge.
MSG
    exit 1
  fi
done

exit 0