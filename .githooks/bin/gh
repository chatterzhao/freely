#!/usr/bin/env bash
# gh wrapper: intercept dangerous gh commands → direct to freely equivalents
case "$*" in
  *"pr create"*|*"pr new"*)
    cat >&2 <<'MSG'
[BLOCKED] gh pr create is not allowed directly.
  Use the canonical command: freely pr-create-guarded
  This ensures: pull develop → dry-run gate → push → create PR.
MSG
    exit 1
    ;;
  *"pr merge"*)
    cat >&2 <<'MSG'
[BLOCKED] gh pr merge is not allowed.  Even --admin.
  Use the canonical command: freely pr-merge-guarded develop <branch>
  This runs all governance gates, merges, and pushes to develop.
MSG
    exit 1
    ;;
  *"issue close"*|*"issue reopen"*)
    cat >&2 <<'MSG'
[BLOCKED] gh issue close/reopen is not allowed directly.
  Use the canonical command: freely wt-close --raw-key <key> --platform-only
  This ensures BOTH platforms (GitHub + Gitee) are synced.
MSG
    exit 1
    ;;
  *)
    exec /opt/homebrew/bin/gh "$@"
    ;;
esac
