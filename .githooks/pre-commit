#!/usr/bin/env bash
set -euo pipefail

[[ -f "./bin/worktree-common.sh" ]] || exit 0
# shellcheck disable=SC1091
source ./bin/worktree-common.sh

branch="$(freely_wt_current_branch)"
[[ -n "$branch" ]] || exit 0

# main, develop, pre-test-merge 禁止直接 add/commit
case "$branch" in
  main|develop|pre-test-merge)
    cat <<MSG
[HOOK] Commit blocked: direct development on '$branch' is forbidden.
This repo enforces worktree mode for feature development.
Use the standard git worktree flow from the project root:

Run:
  cd <your-project-path>
  ./bin/wt-create feature/<task-name> [--base <base-branch>]
  cd ../<your-project-worktrees>/<branch-dir>

Where:
  feature/<task-name> without date -> <branch-dir>=feature-<task-name>
  feature/<task-name>-YYYYMMDD-HHMM -> <branch-dir>=YYYYMMDD-HHMM-feature-<task-name>

Omit `--base` for the default `develop`; use `--base <parent-feature>` only when the issue depends on unmerged parent changes.

When the work is finished and merged, clean up with:
  git worktree remove ../<your-project-worktrees>/<branch-dir>
  git branch -d feature/<task-name>

If you skip this workflow, hooks will create the worktree when possible and print guidance.
Do not keep committing in the current directory.
MSG
    exit 1
    ;;
esac

if ! freely_wt_is_primary_worktree; then
  exit 0
fi

if ! freely_wt_validate_branch_base "$branch"; then
  cat <<MSG
[HOOK] Commit blocked: branch '$branch' base check failed.
Expected:
  feature/* from develop (or from dependent feature when the issue explicitly depends on unmerged parent changes)
  feature/premerge-* from pre-test-merge (or develop when pre-test-merge is not active)
  release/* from develop
  hotfix/* from main
MSG
  exit 1
fi

existing_for_branch="$(freely_wt_existing_for_branch "$branch")"
if [[ -n "$existing_for_branch" ]]; then
  rel_target="$(freely_wt_relative_target_for_branch "$branch")"
  cat <<MSG
[HOOK] Commit blocked in primary worktree.
Branch '$branch' has dedicated worktree:
  $existing_for_branch

Start work in worktree:
  cd "$existing_for_branch"

Standard cleanup after merge:
  git worktree remove ${rel_target}
  git branch -d "$branch"
MSG
  git worktree list
  exit 1
fi

rel_target="$(freely_wt_relative_target_for_branch "$branch")"
cat <<MSG
[HOOK] Commit blocked in primary worktree.
No worktree found for '$branch'.

Create it from the project root with the standard command:
  cd <your-project-path>
  ./bin/wt-create "$branch"
  cd ../<your-project-worktrees>/<branch-dir>

Use the same derived naming rule as auto-created worktrees:
  no date in branch -> sanitize branch name
  date in branch -> move the date prefix to the front of <branch-dir>

When the work is finished and merged:
  git worktree remove ${rel_target}
  git branch -d "$branch"
MSG
exit 1
