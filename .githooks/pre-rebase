#!/usr/bin/env bash
# .githooks/pre-rebase — delegates to docs/system/workspace/hooks/pre-rebase.sh
set -euo pipefail
ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || { cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P; })"
HOOK_SCRIPT="$ROOT_DIR/docs/system/workspace/hooks/pre-rebase.sh"
if [[ -x "$HOOK_SCRIPT" ]]; then
  exec bash "$HOOK_SCRIPT" "$@"
fi
exit 0
