#!/usr/bin/env bash
set -euo pipefail

CONSTITUTION_PATH="./docs/CONSTITUTION.md"
CONSTITUTION_ANCHOR="#2-branch-and-worktree-policy-hard-requirement"

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
[[ -n "$branch" ]] || exit 0

if [[ ! -f ".git/MERGE_HEAD" ]]; then
  exit 0
fi

merge_head="$(cat .git/MERGE_HEAD 2>/dev/null || echo "")"
merge_candidates="$(git for-each-ref --format='%(refname:short)' --contains "$merge_head" refs/heads 2>/dev/null || true)"

pick_source_branch() {
  local target="$1"
  local candidates="$2"
  local c

  case "$target" in
    pre-develop)
      while IFS= read -r c; do
        [[ "$c" == feature/* ]] && { echo "$c"; return 0; }
      done <<< "$candidates"
      while IFS= read -r c; do
        [[ "$c" == hotfix/* ]] && { echo "$c"; return 0; }
      done <<< "$candidates"
      ;;
    develop)
      while IFS= read -r c; do
        [[ "$c" == "pre-develop" ]] && { echo "$c"; return 0; }
      done <<< "$candidates"
      while IFS= read -r c; do
        [[ "$c" == hotfix/* ]] && { echo "$c"; return 0; }
      done <<< "$candidates"
      ;;
    main)
      while IFS= read -r c; do
        [[ "$c" == release/* ]] && { echo "$c"; return 0; }
      done <<< "$candidates"
      while IFS= read -r c; do
        [[ "$c" == hotfix/* ]] && { echo "$c"; return 0; }
      done <<< "$candidates"
      ;;
  esac

  while IFS= read -r c; do
    [[ -n "$c" ]] && { echo "$c"; return 0; }
  done <<< "$candidates"

  echo ""
}

merge_branch="$(pick_source_branch "$branch" "$merge_candidates")"

if [[ -z "$merge_branch" ]]; then
  cat <<MSG
[HOOK] Merge blocked: unable to determine source branch from MERGE_HEAD.
Target branch: $branch

Policy source:
  ${CONSTITUTION_PATH}${CONSTITUTION_ANCHOR}
MSG
  exit 1
fi

case "$branch" in
  pre-develop)
    case "$merge_branch" in
      feature/*|hotfix/*) exit 0 ;;
      *)
        cat <<MSG
[HOOK] Merge blocked: pre-develop can only receive merges from feature/* or hotfix/*.
Attempted source: $merge_branch
Target branch: $branch

Allowed:
  feature/* -> pre-develop
  hotfix/* -> pre-develop (sync required after hotfix release)

Policy source:
  ${CONSTITUTION_PATH}${CONSTITUTION_ANCHOR}
MSG
        exit 1
        ;;
    esac
    ;;
  develop)
    if [[ "$merge_branch" == "pre-develop" ]]; then
      exit 0
    fi
    if [[ "${FREELY_ALLOW_MERGE:-0}" == "1" && "$merge_branch" == hotfix/* ]]; then
      echo "[HOOK] Merge allowed on develop via hotfix bypass (FREELY_ALLOW_MERGE=1): $merge_branch"
      exit 0
    fi
    cat <<MSG
[HOOK] Merge blocked: develop can only receive merges from pre-develop.
Attempted source: $merge_branch
Target branch: $branch

Allowed:
  pre-develop -> develop
  hotfix/* -> develop (only with FREELY_ALLOW_MERGE=1)

Policy source:
  ${CONSTITUTION_PATH}${CONSTITUTION_ANCHOR}
MSG
    exit 1
    ;;
  main)
    case "$merge_branch" in
      release/*) exit 0 ;;
      hotfix/*)
        if [[ "${FREELY_ALLOW_MERGE:-0}" == "1" ]]; then
          echo "[HOOK] Merge allowed on main via hotfix bypass (FREELY_ALLOW_MERGE=1): $merge_branch"
          exit 0
        fi
        ;;
    esac
    cat <<MSG
[HOOK] Merge blocked: main can only receive merges from release/*.
Attempted source: $merge_branch
Target branch: $branch

Allowed:
  release/* -> main
  hotfix/* -> main (only with FREELY_ALLOW_MERGE=1)

Policy source:
  ${CONSTITUTION_PATH}${CONSTITUTION_ANCHOR}
MSG
    exit 1
    ;;
  *)
    cat <<MSG
[HOOK] Merge blocked: '$branch' is not an allowed merge target.
Attempted source: $merge_branch

Allowed merge targets:
  pre-develop, develop, main

Policy source:
  ${CONSTITUTION_PATH}${CONSTITUTION_ANCHOR}
MSG
    exit 1
    ;;
esac
