#!/usr/bin/env bash
set -euo pipefail

# Strong merge-path guard:
# git merge writes merge commit message before finalizing commit.
# Validate policy here to stop invalid merge early and non-interactively.
if [[ -f ".git/MERGE_HEAD" ]]; then
  if [[ -x "./.githooks/pre-merge-commit" ]]; then
    ./.githooks/pre-merge-commit
    exit $?
  fi
fi

exit 0

